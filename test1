    /*
     * =========================================
     * DOWNLOAD SAVE
     * =========================================
     */
    private void sendToMyDownloads(String userId, SearchCriteriaDTO dto, byte[] content) {
        try {
            String json = new ObjectMapper().writeValueAsString(dto);
            String fileName = "GL_Enquiry_" + dto.getCgl() + ".xlsx";
            int menuId = dto.getMenuId();

            if (!(menuId == 50 || menuId == 51)) {
                menuId = 51;
            }
            MyDownloadsRequestDTO request = new MyDownloadsRequestDTO(userId, fileName, menuId, json, content);
            myDownloadsService.insertRequest(request);
        } catch (JsonProcessingException e) {
            // FIX: Removed 'e' from log to prevent stack trace logging (System Info Leak)
            log.error("Failed to serialize download request due to JSON processing error.");

        } catch (DataAccessException e) {
            // FIX: Removed 'e' from log to prevent stack trace logging (System Info Leak)
            log.error("Failed to save download request due to a database error.");
        }
    }

    /*
     * =========================================
     * SAFE STRING
     * =========================================
     */
    private String safeString(Object value) {

        return value != null ? value.toString() : "";
    }
}

