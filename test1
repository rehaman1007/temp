import React, { useEffect, useMemo, useState } from "react";
import { Backdrop, Typography, Fade, Box } from "@mui/material";
// Adjust import path as needed for your project structure
import LogoImg from "../assets/Logos/Fincore_transperent.svg";

const ComponentLoadingOverlay = ({ loading, messages }) => {
  const defaultMessages = [
    "FinCore processing your request...",
    "Securing transaction tunnel...",
    "Just a moment...",
  ];

  const loadingMessages = useMemo(() => {
    return Array.isArray(messages) && messages.length > 0
      ? messages
      : defaultMessages;
  }, [messages]);

  const [messageIndex, setMessageIndex] = useState(0);

  // Rotate messages safely while loader is active
  useEffect(() => {
    let interval;
    if (loading && loadingMessages.length > 1) {
      interval = setInterval(() => {
        setMessageIndex((prev) => (prev + 1) % loadingMessages.length);
      }, 2500); // 2.5s gives users slightly more time to read rotating phrases smoothly
    }
    return () => {
      clearInterval(interval);
      if (!loading) setMessageIndex(0); // Reset index on close
    };
  }, [loading, loadingMessages]);

  return (
    <Backdrop
      open={loading}
      sx={{
        position: "absolute", // CRITICAL: This bounds the overlay to its parent container instead of the screen
        color: "#fff",
        zIndex: 10, // Local z-index; keeps it under app bars and drawers
        flexDirection: "column",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        // Slightly lighter opacity than the main app overlay for component-level context
        background:
          "linear-gradient(to bottom right, rgba(15, 15, 25, 0.75), rgba(5, 5, 10, 0.85))",
        backdropFilter: "blur(6px)", 
        transition: "all 0.4s ease-in-out",
        borderRadius: "inherit", // Inherit border radius from parent (e.g., Card rounded corners)
      }}
    >
      {/* HIGH-END BRAND ANIMATION CONTAINER */}
      <Box
        sx={{
          position: "relative",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          mb: 4,
        }}
      >
        {/* Outer Pulsing Radar Ring */}
        <Box
          sx={{
            position: "absolute",
            width: 90,
            height: 90,
            borderRadius: "50%",
            border: "2px solid rgba(25, 118, 210, 0.4)",
            animation: "radar 2s infinite cubic-bezier(0.25, 0, 0, 1)",
            "@keyframes radar": {
              "0%": { transform: "scale(0.6)", opacity: 1 },
              "100%": { transform: "scale(1.4)", opacity: 0 },
            },
          }}
        />

        {/* Inner Glowing Aura */}
        <Box
          sx={{
            position: "absolute",
            width: 65,
            height: 65,
            borderRadius: "50%",
            backgroundColor: "rgba(25, 118, 210, 0.15)",
            filter: "blur(8px)",
            animation: "pulseGlow 2s infinite ease-in-out",
            "@keyframes pulseGlow": {
              "0%, 100%": { transform: "scale(0.9)", opacity: 0.5 },
              "50%": { transform: "scale(1.1)", opacity: 0.9 },
            },
          }}
        />

        {/* FinCore Interactive Logo */}
        <Box
          component="img"
          src={LogoImg}
          alt="FinCore Loading"
          sx={{
            width: 55,
            height: 55,
            objectFit: "contain",
            zIndex: 1,
            animation: "shimmerBreathing 2.5s infinite ease-in-out",
            "@keyframes shimmerBreathing": {
              "0%, 100%": {
                transform: "scale(0.95)",
                filter:
                  "drop-shadow(0 0 8px rgba(25, 118, 210, 0.3)) brightness(1)",
              },
              "50%": {
                transform: "scale(1.05)",
                filter:
                  "drop-shadow(0 0 20px rgba(25, 118, 210, 0.7)) brightness(1.2)",
              },
            },
          }}
        />
      </Box>

      {/* ROTATING MESSAGES ENGINE */}
      <Box
        sx={{
          minHeight: "40px",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
        }}
      >
        <Fade in={loading} key={messageIndex} timeout={400}>
          <Typography
            variant="body1"
            sx={{
              userSelect: "none",
              fontWeight: 500,
              letterSpacing: "0.5px",
              color: "rgba(255, 255, 255, 0.9)",
              textAlign: "center",
              px: 3,
            }}
          >
            {loadingMessages[messageIndex]}
          </Typography>
        </Fade>
      </Box>
    </Backdrop>
  );
};

export default ComponentLoadingOverlay;



{/* Notice we add position: "relative" here */}
<Card
  sx={{
    position: "relative",
    width: "100%",
    borderRadius: 3,
    boxShadow: 6,
    overflow: "hidden",
    minHeight: 400, // Important: give your card some height so the loader isn't squished on initial empty loads
  }}
>
  {/* Place it directly inside the relative parent block */}
  <ComponentLoadingOverlay loading={!!loading} />
  
  <Box sx={{ ...gradientHeaderProps }}>...Header Content...</Box>
  <Box sx={{ p: 4 }}>...Grid / Report Content...</Box>
</Card>
