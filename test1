import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Card,
  Container,
  Grid, // Using standard Grid or Grid2 depending on MUI v6 setup
  Grow,
  Paper,
  Stack,
  IconButton,
  Tooltip,
  Chip,
  Skeleton, 
} from "@mui/material";
import { DescriptionRounded, ArrowForwardRounded } from "@mui/icons-material";
import { motion } from "framer-motion";
import dayjs from "dayjs";

// MUI Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import EventBusyIcon from "@mui/icons-material/EventBusy";
import DescriptionIcon from "@mui/icons-material/Description";
import DownloadRoundedIcon from "@mui/icons-material/DownloadRounded";

// Custom Hooks (Ensure paths match your project)
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import LoadingOverlay from "../../utils/LoadingOverlay";
import AdhocReportsDialog from "./components/AdhocReportsDialog";
import downloadFile from "../../utils/DownloadUtils";
import AdhocReportsPreview from "./components/AdhocReportsPreview";
import AdhocReportsCard from "./components/AdhocReportsCard";

// --- Date Utility ---
const isLastDayOfMonth = (dateString) => {
  if (!dateString) return false;
  const [day, month, year] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return date.getDate() === lastDayOfMonth;
};

// --- Main Screen ---
export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // All states strictly initialized to null
  const [etlDate, setEtlDate] = useState(null);
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(null);
  const [reports, setReports] = useState(null);
  const [loading, setLoading] = useState(null);
  const [isDownloading, setIsDownloading] = useState(null);

  // Preview handling states
  const [reportPreviewData, setReportPreviewData] = useState(null);
  const [previewReportDetails, setPreviewReportDetails] = useState(null);
  const [selectedReport, setSelectedReport] = useState(null);

  const fetchData = async () => {
    setReportPreviewData(null);
    setPreviewReportDetails(null);
    setSelectedReport(null);
    setLoading(true);
    try {
      const etlDetails = await callApi(
        "/PS/process/waiting-for-approval",
        {},
        "GET",
      );
      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.inWaitingState || true;

      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(availableFlag);

      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/adhoc-types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        setReports(reportsData);
      } else {
        setReports([]);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar(
        "Failed to load report data. Kindly try again after sometime.",
        "error",
      );
      // Fallback: If API fails, default to today's date
      setEtlDate(dayjs().format("DD-MM-YYYY"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = async (reportId, formatType) => {
    setIsDownloading(true);

    try {
      const fileName = `${selectedReport.fileName}_${etlDate}`;
      const payload = {
        reportId: selectedReport.fileName || "nwsa_report",
        variantCode: "DATE_WISE",
        params: { balanceDate: "2026-03-30" },
      };

      const REPORT_DOWNLOAD_BASE_URL = "/RB/report-builder/view";
      let endpoint = `${REPORT_DOWNLOAD_BASE_URL}/pdf`; // default fallback

      if (formatType === "excel") endpoint = `${REPORT_DOWNLOAD_BASE_URL}/xlsx`;
      if (formatType === "test" || formatType === "psv")
        endpoint = `${REPORT_DOWNLOAD_BASE_URL}/txt`;

      const response = await callApi(endpoint, payload, "POST", "arraybuffer");
      const blobData = response?.data || response;

      if (formatType === "view") {
        setReportPreviewData(blobData);
        setPreviewReportDetails(selectedReport); // Preserve details for the inline viewer
        setSelectedReport(null); // Closes the dialog instantly

        // Smooth scroll to the PDF viewer container
        setTimeout(() => {
          document
            .getElementById("inline-pdf-viewer")
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 300);
      } else {
        downloadFile(blobData, formatType, fileName);
        setSelectedReport(null);
        showSnackBar(`${fileName} downloaded successfully!`, "success");
      }
    } catch (error) {
      console.error("Download Error:", error);
      showSnackBar("Failed to download the report. Please try again.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  return (
    <>
      <LoadingOverlay loading={!!isDownloading} />

      <AdhocReportsDialog
        selectedReport={selectedReport}
        setSelectedReport={setSelectedReport}
        handleDownload={handleDownload}
        isAvailableToDownload={!!isAvailableToDownload}
      />

      <Grow in timeout={500}>
        <Stack spacing={4}>
          <Box sx={{ width: "100%", p: { xs: 2, sm: 3, md: 4 } }}>
            <Stack
              spacing={4}
              direction="column"
              alignItems="center"
              justifyContent="center"
            >
              <Card
                sx={{
                  width: "100%",
                  borderRadius: 3,
                  boxShadow: 6,
                  overflow: "hidden",
                }}
              >
                <Box
                  sx={{
                    display: "flex",
                    flexDirection: { xs: "column", md: "row" },
                    alignItems: { xs: "flex-start", md: "center" },
                    justifyContent: "space-between",
                    gap: 3,
                    px: { xs: 3, md: 4 },
                    py: { xs: 3, md: 3 },
                    background:
                      "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 100%)",
                    color: "white",
                  }}
                >
                  <Box
                    sx={{
                      display: "flex",
                      alignItems: "center",
                      gap: 2,
                      flex: 1,
                    }}
                  >
                    <Box
                      sx={{
                        borderRadius: "50%",
                        p: 1.5,
                        bgcolor: "rgba(255,255,255,0.15)",
                        display: "flex",
                      }}
                    >
                      <DescriptionIcon
                        sx={{
                          width: { xs: 35, md: 45 },
                          height: { xs: 35, md: 45 },
                        }}
                      />
                    </Box>
                    <Box>
                      <Typography variant="h5" fontWeight="bold">
                        Adhoc Reports Generation
                      </Typography>
                      <Typography
                        variant="body2"
                        sx={{ opacity: 0.9, mt: 0.5 }}
                      >
                        View and download monthly reports as soon as month-end
                        ETL processing is done and before EOD approval.
                      </Typography>
                    </Box>
                  </Box>

                  <Box
                    sx={{
                      bgcolor: "rgba(0,0,0,0.2)",
                      borderRadius: 3,
                      p: 2,
                      display: "flex",
                      flexDirection: "column",
                      alignItems: { xs: "flex-start", md: "flex-end" },
                      gap: 1,
                      minWidth: "fit-content",
                    }}
                  >
                    <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                      <CalendarMonthIcon
                        fontSize="small"
                        sx={{ opacity: 0.8 }}
                      />
                      <Typography
                        variant="caption"
                        fontWeight="bold"
                        sx={{ 
                          opacity: 0.9, 
                          letterSpacing: 0.5, 
                          display: "flex", 
                          alignItems: "center", 
                          gap: 0.5 
                        }}
                      >
                        <span>Fincore ETL Date :</span>
                        {/* 1. SKELETON DISPLAY WHILE LOADING */}
                        {loading ? (
                          <Skeleton 
                            variant="text" 
                            width={75} 
                            sx={{ bgcolor: 'rgba(255, 255, 255, 0.4)' }} 
                          />
                        ) : (
                          /* 2. SHOWS ACTUAL DATE OR FALLBACK (N/A) */
                          <span>{etlDate || "N/A"}</span>
                        )}
                      </Typography>
                    </Box>
                  </Box>
                </Box>

                <Box sx={{ p: { xs: 2, md: 4 } }}>
                  {loading ? (
                    /* SKELETON LOADING STATE FOR CARDS */
                    <Grid container spacing={3}>
                      {[1, 2, 3, 4, 5, 6].map((item) => (
                        <Grid size={{ xs: 12, sm: 6, md: 4 }} key={item}>
                          <Paper
                            elevation={0}
                            sx={{
                              p: 3,
                              borderRadius: 3,
                              height: "100%",
                              display: "flex",
                              flexDirection: "column",
                              border: "1px solid",
                              borderColor: "grey.100",
                              boxShadow: "0 4px 6px -1px rgba(0, 0, 0, 0.02)",
                            }}
                          >
                            <Box
                              sx={{
                                display: "flex",
                                justifyContent: "space-between",
                                mb: 2,
                              }}
                            >
                              <Skeleton
                                variant="rounded"
                                width={44}
                                height={44}
                                sx={{ borderRadius: 2.5 }}
                              />
                              <Skeleton
                                variant="circular"
                                width={30}
                                height={30}
                              />
                            </Box>
                            <Box sx={{ flexGrow: 1, mb: 2 }}>
                              <Skeleton
                                variant="text"
                                width="70%"
                                height={28}
                                sx={{ mb: 1 }}
                              />
                              <Skeleton variant="text" width="100%" />
                              <Skeleton variant="text" width="95%" />
                              <Skeleton variant="text" width="80%" />
                            </Box>
                            <Box
                              sx={{
                                display: "flex",
                                justifyContent: "space-between",
                                pt: 1.5,
                              }}
                            >
                              <Skeleton
                                variant="rounded"
                                width={60}
                                height={24}
                                sx={{ borderRadius: 1 }}
                              />
                              <Skeleton
                                variant="circular"
                                width={20}
                                height={20}
                              />
                            </Box>
                          </Paper>
                        </Grid>
                      ))}
                    </Grid>
                  ) : etlDate && !isLastDayOfMonth(etlDate) ? (
                    /* NOT MONTH END STATE */
                    <Container maxWidth="sm" sx={{ py: 6 }}>
                      <motion.div
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.5 }}
                      >
                        <Paper
                          elevation={0}
                          sx={{
                            p: 6,
                            borderRadius: 4,
                            textAlign: "center",
                            border: "1px solid",
                            borderColor: "divider",
                            bgcolor: "white",
                            boxShadow: "0 4px 20px rgba(0,0,0,0.03)",
                          }}
                        >
                          <motion.div
                            initial={{ scale: 0 }}
                            animate={{ scale: 1 }}
                            transition={{
                              delay: 0.2,
                              type: "spring",
                              stiffness: 150,
                            }}
                          >
                            <EventBusyIcon
                              sx={{
                                fontSize: 80,
                                color: "text.secondary",
                                mb: 3,
                                opacity: 0.3,
                              }}
                            />
                          </motion.div>
                          <Typography
                            variant="h5"
                            fontWeight="bold"
                            gutterBottom
                            color="text.primary"
                          >
                            Not a Month-End Cycle
                          </Typography>
                          <Typography
                            variant="body1"
                            color="text.secondary"
                            sx={{ mb: 1 }}
                          >
                            Adhoc Reports are strictly generated as part of the
                            month-end activity.
                          </Typography>
                          <Typography
                            variant="body1"
                            color="text.secondary"
                            sx={{ mb: 1 }}
                          >
                            The current ETL Date processed is{" "}
                            <strong>{etlDate}</strong>.
                          </Typography>
                          <Typography variant="body1" color="text.secondary">
                            Please check back during the month-end processing
                            cycle.
                          </Typography>
                        </Paper>
                      </motion.div>
                    </Container>
                  ) : (
                    /* ACTUAL REPORTS STATE */
                    <>
                      <Grid container spacing={3}>
                        {reports?.map((report, index) => (
                          <Grid
                            size={{ xs: 12, sm: 6, md: 4 }}
                            key={report.id || index}
                          >
                            <motion.div
                              initial={{ opacity: 0, y: 30 }}
                              animate={{ opacity: 1, y: 0 }}
                              transition={{ duration: 0.4, delay: index * 0.1 }}
                              style={{ height: "100%" }}
                            >
                              <AdhocReportsCard
                                report={report}
                                onClick={() => setSelectedReport(report)}
                              />
                            </motion.div>
                          </Grid>
                        ))}

                        {reports?.length === 0 && (
                          <Grid size={{ xs: 12 }}>
                            <Typography
                              align="center"
                              color="text.secondary"
                              sx={{ py: 8 }}
                            >
                              No reports configured for this date.
                            </Typography>
                          </Grid>
                        )}
                      </Grid>

                      {/* Inline PDF Preview Component below Reports */}
                      {reportPreviewData && previewReportDetails && (
                        <Box sx={{ p: 1, mt: 3, pt: 2 }}>
                          <AdhocReportsPreview
                            selectedReport={previewReportDetails}
                            data={reportPreviewData}
                            onClose={() => {
                              setReportPreviewData(null);
                              setPreviewReportDetails(null);
                            }}
                            etlDate={etlDate}
                          />
                        </Box>
                      )}
                    </>
                  )}
                </Box>
              </Card>
            </Stack>
          </Box>
        </Stack>
      </Grow>
    </>
  );
}
