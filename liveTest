import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  Box,
  Button,
  Paper,
  Stack,
  Tab,
  Tabs,
  Typography,
  useTheme,
} from "@mui/material";
import { History, Refresh, Storage, Terminal, UploadFile } from "@mui/icons-material";
import { useMutation } from "@tanstack/react-query";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import CommandPanel from "./components/CommandPanel";
import UploadScript from "./components/UploadScript";
import ResultGrid from "./components/ResultGrid";
import LogsPanel from "./components/LogsPanel";
import ConfirmDialog from "./components/ConfirmDialog";
import JobHistory from "./components/JobHistory"; // <-- New Component

const AdminSupport = () => {
  const theme = useTheme();
  const { callApi } = useApi();
  const showSnackbar = useCustomSnackbar();

  const [mainTab, setMainTab] = useState(0);
  const [outputTab, setOutputTab] = useState(0);
  
  const [query, setQuery] = useState("SELECT * FROM ADMIN_SUPPORT_LOG");
  const [lastExecutedQuery, setLastExecutedQuery] = useState(""); // <-- Fix for keystroke bug

  const [selectedFile, setSelectedFile] = useState(null);
  const [jobId, setJobId] = useState(null);
  const [jobStatus, setJobStatus] = useState(null);
  const [lastResponse, setLastResponse] = useState(null);
  const [confirmOpen, setConfirmOpen] = useState(false);

  const [results, setResults] = useState({
    rows: [],
    columns: [],
    total: 0,
  });

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 10,
  });

  const isSelect = useMemo(() => {
    const q = query.trim().toUpperCase();
    return q.startsWith("SELECT") || q.startsWith("WITH");
  }, [query]);

  const resetScreen = () => {
    setQuery("");
    setLastExecutedQuery("");
    setSelectedFile(null);
    setJobId(null);
    setJobStatus(null);
    setLastResponse(null);
    setResults({ rows: [], columns: [], total: 0 });
    setPaginationModel({ page: 0, pageSize: 10 });
    setOutputTab(0);
    showSnackbar("Workspace reset completed", "success");
  };

  const { mutate: executeSql, isPending } = useMutation({
    mutationFn: async ({ sql, page, size }) => {
      return await callApi("/TS/admin-support/admin-execute", { sql, page, size }, "POST");
    },
    onSuccess: (data) => {
      setLastResponse(data);
      if (data?.error) {
        setOutputTab(1);
        return;
      }
      if (isSelect) {
        const columns = (data?.columns || []).map((col) => ({
          field: col.name,
          headerName: col.name,
          flex: 1,
          minWidth: 180,
        }));
        setResults({
          rows: data?.rows || [],
          columns,
          total: data?.total || 0,
        });
        setOutputTab(0);
      } else {
        setOutputTab(1);
      }
    },
    onError: (e) => {
      setLastResponse({ error: true, message: e?.message || "Execution failed" });
      setOutputTab(1);
    },
  });

  const handleExecute = useCallback((reset = false) => {
    if (!query.trim()) {
      showSnackbar("Enter SQL query", "warning");
      return;
    }
    
    // Save the exact query text being executed
    setLastExecutedQuery(query);
    setSelectedFile(null);
    setJobId(null);
    setJobStatus(null);
    setLastResponse(null);

    const page = reset ? 0 : paginationModel.page;
    if (reset) setPaginationModel((p) => ({ ...p, page: 0 }));

    executeSql({ sql: query, page, size: paginationModel.pageSize });
  }, [executeSql, paginationModel.page, paginationModel.pageSize, query, showSnackbar]);

  // FIX: Handle pagination directly instead of using a dangerous useEffect
  const handlePaginationChange = (newModel) => {
    setPaginationModel(newModel);
    
    // Only fetch if we have already executed a query and it was a SELECT
    const q = lastExecutedQuery.trim().toUpperCase();
    if (lastExecutedQuery && (q.startsWith("SELECT") || q.startsWith("WITH"))) {
      executeSql({
        sql: lastExecutedQuery,
        page: newModel.page,
        size: newModel.pageSize,
      });
    }
  };

  const handleUpload = async (file) => {
    try {
      if (!file) {
        showSnackbar("Choose SQL file", "warning");
        return;
      }
      const formData = new FormData();
      formData.append("file", file);
      const data = await callApi(
        "/TS/admin-support/upload-script", formData, "POST", "json", "multipart/form-data"
      );
      if (data?.error) {
        showSnackbar(data.message, "error");
        return;
      }
      setJobId(data.jobId);
      setOutputTab(1);
      showSnackbar("Execution started", "success");
    } catch (e) {
      showSnackbar(e?.message || "Upload failed", "error");
    }
  };

  useEffect(() => {
    if (!jobId) return;
    const interval = setInterval(async () => {
      try {
        const data = await callApi(`/TS/admin-support/job-status/${jobId}`, {}, "GET");
        setJobStatus(data);
        if (data.status === "COMPLETED" || data.status === "FAILED") {
          clearInterval(interval);
        }
      } catch (e) {
        console.error(e);
      }
    }, 5000);
    return () => clearInterval(interval);
  }, [callApi, jobId]);

  useEffect(() => {
    const active = jobStatus?.status === "RUNNING";
    const beforeUnload = (e) => {
      if (!active) return;
      e.preventDefault();
      e.returnValue = "SQL execution is still running.";
    };
    window.addEventListener("beforeunload", beforeUnload);
    return () => window.removeEventListener("beforeunload", beforeUnload);
  }, [jobStatus]);

  return (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column", overflow: "hidden", p: 2, gap: 1.5 }}>
      <Paper elevation={0} sx={{ px: 3, py: 1, borderBottom: `1px solid ${theme.palette.divider}`, display: "flex", alignItems: "center", justifyContent: "space-between", borderRadius: 1 }}>
        <Stack direction="row" spacing={2} alignItems="center">
          <Storage color="primary" />
          <Box>
            <Typography variant="subtitle2" fontWeight={800} sx={{ letterSpacing: 0.5 }}>FINCORE ADMIN SUPPORT</Typography>
            <Typography variant="caption" color="text.secondary">Advanced SQL Console & Script Executor</Typography>
          </Box>
        </Stack>
        <Stack direction="row" spacing={2} flexWrap="wrap">
          <Button variant="outlined" startIcon={<Refresh />} onClick={resetScreen}>Reset Workspace</Button>
        </Stack>
      </Paper>

      <Paper elevation={0} sx={{ borderRadius: 1, overflow: "hidden", border: `1px solid ${theme.palette.divider}` }}>
        <Tabs value={mainTab} onChange={(e, v) => setMainTab(v)} variant="fullWidth">
          <Tab icon={<Terminal />} label="SQL Console" />
          <Tab icon={<UploadFile />} label="Script Upload" />
          <Tab icon={<History />} label="Job History" />
        </Tabs>
      </Paper>

      {mainTab === 0 && (
        <CommandPanel query={query} setQuery={setQuery} onExecute={handleExecute} loading={isPending} onDangerousExecute={() => setConfirmOpen(true)} />
      )}

      {mainTab === 1 && (
        <UploadScript onUpload={handleUpload} loading={false} showSnackbar={showSnackbar} />
      )}

      {mainTab === 2 && (
        <JobHistory callApi={callApi} />
      )}

      {mainTab !== 2 && (
        <Paper elevation={0} sx={{ flex: 1, borderRadius: 1, overflow: "hidden", border: `1px solid ${theme.palette.divider}`, display: 'flex', flexDirection: 'column' }}>
          <Tabs value={outputTab} onChange={(e, v) => setOutputTab(v)}>
            <Tab label="Data Grid" />
            <Tab label="Live Logs" />
          </Tabs>

          {outputTab === 0 && (
            <ResultGrid results={results} loading={isPending} paginationModel={paginationModel} setPaginationModel={handlePaginationChange} />
          )}

          {outputTab === 1 && (
            <LogsPanel lastResponse={lastResponse} jobStatus={jobStatus} />
          )}
        </Paper>
      )}

      <ConfirmDialog open={confirmOpen} onClose={() => setConfirmOpen(false)} onConfirm={() => { setConfirmOpen(false); handleExecute(true); }} />
    </Box>
  );
};

export default AdminSupport;

import React, { useEffect, useState, useCallback } from "react";
import { Box, Chip, Paper, Stack, Typography, useTheme, IconButton, Tooltip } from "@mui/material";
import { Refresh, History as HistoryIcon, Download } from "@mui/icons-material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";

const JobHistory = ({ callApi }) => {
  const theme = useTheme();
  
  const [rows, setRows] = useState([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(false);
  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 25,
  });

  const fetchHistory = useCallback(async () => {
    setLoading(true);
    try {
      // Assuming a new API endpoint specifically for fetching history with pagination
      const response = await callApi(
        `/TS/admin-support/job-history?page=${paginationModel.page}&size=${paginationModel.pageSize}`, 
        {}, 
        "GET"
      );
      
      setRows(response?.content || []);
      setTotal(response?.totalElements || 0);
    } catch (error) {
      console.error("Failed to fetch job history:", error);
    } finally {
      setLoading(false);
    }
  }, [callApi, paginationModel.page, paginationModel.pageSize]);

  useEffect(() => {
    fetchHistory();
  }, [fetchHistory]);

  const columns = [
    { field: "jobId", headerName: "Job ID", width: 300 },
    { 
      field: "executionType", 
      headerName: "Type", 
      width: 130,
      renderCell: (params) => (
        <Chip 
          size="small" 
          label={params.value} 
          color={params.value === 'FILE' ? 'primary' : 'default'} 
          variant="outlined" 
        />
      )
    },
    { 
      field: "status", 
      headerName: "Status", 
      width: 140,
      renderCell: (params) => {
        const color = params.value === 'SUCCESS' || params.value === 'COMPLETED' ? 'success' : 
                      params.value === 'FAILED' ? 'error' : 'warning';
        return <Chip size="small" label={params.value} color={color} sx={{ fontWeight: 'bold' }} />;
      }
    },
    { field: "fileName", headerName: "File Name / HDFS", width: 250 },
    { 
      field: "executedCount", 
      headerName: "Executed / Total", 
      width: 180,
      renderCell: (params) => (
        `${params.row.executedCount || 0} / ${params.row.totalStatements || 0}`
      )
    },
    { field: "elapsedSeconds", headerName: "Duration (sec)", width: 150 },
    { field: "createdAt", headerName: "Execution Date", width: 220 },
  ];

  return (
    <Paper elevation={0} sx={{ height: "calc(100vh - 200px)", borderRadius: 1, overflow: "hidden", border: `1px solid ${theme.palette.divider}`, display: "flex", flexDirection: "column" }}>
      <Box sx={{ px: 2.5, py: 1.5, background: "linear-gradient(135deg,#111827,#1f2937)", color: "white" }}>
        <Stack direction="row" justifyContent="space-between" alignItems="center">
          <Stack direction="row" spacing={1.5} alignItems="center">
            <HistoryIcon fontSize="small" />
            <Typography fontWeight={800}>Execution Log History</Typography>
          </Stack>
          <Tooltip title="Refresh History">
            <IconButton size="small" onClick={fetchHistory} sx={{ color: "white" }}>
              <Refresh />
            </IconButton>
          </Tooltip>
        </Stack>
      </Box>

      <Box sx={{ flex: 1, bgcolor: "#ffffff" }}>
        <DataGrid
          rows={rows}
          columns={columns}
          rowCount={total}
          loading={loading}
          disableRowSelectionOnClick
          paginationMode="server"
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[25, 50, 100]}
          slots={{ toolbar: GridToolbar }}
          getRowId={(row) => row.id}
          sx={{
            border: "none",
            "& .MuiDataGrid-columnHeaders": { bgcolor: "#f8fafc", borderBottom: "1px solid #e5e7eb" },
            "& .MuiDataGrid-cell": { borderBottom: "1px solid #f1f5f9" },
            "& .MuiDataGrid-footerContainer": { bgcolor: "#fafafa" }
          }}
        />
      </Box>
    </Paper>
  );
};

export default JobHistory;