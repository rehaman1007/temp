import React, { useMemo } from "react";
import {
  Box,
  Button,
  Chip,
  CircularProgress,
  Divider,
  IconButton,
  Stack,
  TextField,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CleaningServices,
  ContentCopy,
  PlayArrow,
  Terminal,
  Timer,
} from "@mui/icons-material";
import CustomChip from "../../../utils/CustomChip";

const quickCommands = [
  "SELECT * FROM USERS",
  "SELECT * FROM ADMIN_SUPPORT_LOG",
  "SELECT SYSDATE FROM DUAL",
  "COMMIT",
  "ROLLBACK",
  "SELECT COUNT(*) FROM USERS",
];

const CommandPanel = ({
  query,
  setQuery,
  onExecute,
  loading,
  onDangerousExecute,
}) => {
  const theme = useTheme();

  /**
   * QUERY TYPE
   */
  const isSelect = useMemo(() => {
    const q = query.trim().toUpperCase();

    return q.startsWith("SELECT") || q.startsWith("WITH");
  }, [query]);

  const isDangerous = useMemo(() => {
    const q = query.trim().toUpperCase();

    return ["DELETE", "DROP", "TRUNCATE", "ALTER"].some((x) => q.startsWith(x));
  }, [query]);

  /**
   * SHORTCUT
   */
  const handleKeyDown = (e) => {
    if (e.ctrlKey && e.key === "Enter") {
      e.preventDefault();

      if (isDangerous) {
        onDangerousExecute?.();
      } else {
        onExecute?.();
      }
    }
  };

  /**
   * COPY
   */
  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(query);
    } catch (e) {
      console.error(e);
    }
  };

  return (
    <Box
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        bgcolor: "#0b1120",
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          px: 2,
          py: 1.2,
          bgcolor: "#111827",
          color: "white",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          {/* LEFT */}
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Box
              sx={{
                width: 10,
                height: 10,
                borderRadius: "50%",
                bgcolor: "#22c55e",
                boxShadow: "0 0 12px #22c55e",
                animation: "pulse 1.5s infinite",
                "@keyframes pulse": {
                  "0%": { opacity: 0.5 },
                  "50%": { opacity: 1 },
                  "100%": { opacity: 0.5 },
                },
              }}
            />
            <Terminal fontSize="small" />
            <Typography fontWeight={800}>SQL Worksheet</Typography>
            <Typography
              variant="caption"
              sx={{
                opacity: 0.7,
              }}
            >
              Ctrl + Enter to Execute
            </Typography>
          </Stack>

          {/* RIGHT */}
          <Stack direction="row" spacing={1} alignItems="center">
            <Tooltip title="Copy SQL">
              <IconButton size="small" onClick={handleCopy}>
                <ContentCopy
                  sx={{
                    color: "white",
                  }}
                />
              </IconButton>
            </Tooltip>

            <Divider
              orientation="vertical"
              flexItem
              sx={{
                borderColor: "rgba(255,255,255,0.08)",
              }}
            />

            <Tooltip title="Clear">
              <IconButton size="small" onClick={() => setQuery("")}>
                <CleaningServices
                  sx={{
                    color: "white",
                  }}
                />
              </IconButton>
            </Tooltip>

            <Divider
              orientation="vertical"
              flexItem
              sx={{
                borderColor: "rgba(255,255,255,0.08)",
              }}
            />

            <Button
              variant="contained"
              disableElevation
              startIcon={
                loading ? (
                  <CircularProgress size={16} color="inherit" />
                ) : (
                  <PlayArrow />
                )
              }
              onClick={() =>
                isDangerous ? onDangerousExecute?.() : onExecute?.()
              }
              sx={{
                borderRadius: 3,
                px: 3,
                fontWeight: 700,

                background: isDangerous
                  ? "linear-gradient(135deg,#dc2626,#ef4444)"
                  : "linear-gradient(135deg,#2563eb,#3b82f6)",

                boxShadow: isDangerous
                  ? "0 8px 30px rgba(239,68,68,0.35)"
                  : "0 8px 30px rgba(37,99,235,0.35)",

                "&:hover": {
                  transform: "translateY(-1px)",
                },

                transition: "all .25s ease",
              }}
            >
              {loading ? "Executing..." : "Execute"}
            </Button>
          </Stack>
        </Stack>
      </Box>

      {/* QUICK COMMANDS */}
      <Box
        sx={{
          px: 2,
          py: 1,
          bgcolor: "#0f172a",
          borderBottom: "1px solid rgba(255,255,255,0.05)",
        }}
      >
        <Stack direction="row" spacing={1} flexWrap="wrap">
          {quickCommands.map((cmd) => (
            <Chip
              key={cmd}
              label={cmd}
              clickable
              onClick={() => setQuery(cmd)}
              sx={{
                bgcolor: "rgba(255,255,255,0.06)",
                color: "white",

                "&:hover": {
                  bgcolor: "rgba(255,255,255,0.12)",
                },
              }}
            />
          ))}
        </Stack>
      </Box>

      {/* EDITOR */}
      <TextField
        multiline
        fullWidth
        minRows={14}
        value={query}
        onKeyDown={handleKeyDown}
        onChange={(e) => setQuery(e.target.value)}
        variant="standard"
        placeholder="Write SQL query here..."
        InputProps={{
          disableUnderline: true,

          sx: {
            p: 3,
            bgcolor: "#0d1117",
            color: "#d4d4d4",
            fontFamily: "'Fira Code', monospace",
            fontSize: 14,
            lineHeight: 1.7,
          },
        }}
      />

      {/* FOOTER STATUS */}
      <Box
        sx={{
          px: 2,
          py: 1,
          borderTop: "1px solid rgba(255,255,255,0.06)",
          bgcolor: "#111827",
        }}
      >
        <Stack direction="row" spacing={1} alignItems="center" flexWrap="wrap">
          <CustomChip
            size="small"
            variant="outlined"
            label={isSelect ? "Read Only" : "Write Mode"}
            color={isSelect ? "success" : "warning"}
          />

          {isDangerous && <Chip size="small" label="DANGEROUS" color="error" />}

          <CustomChip
            size="small"
            variant="outlined"
            label={`${query.length} chars`}
            sx={{
              color: "white",
              borderColor: "rgba(255,255,255,0.2)",
            }}
          />

          <CustomChip
            size="small"
            variant="outlined"
            label={`${query.split(";").filter(Boolean).length} statements`}
            sx={{
              color: "white",
              borderColor: "rgba(255,255,255,0.2)",
            }}
          />

          <CustomChip
            size="small"
            variant="outlined"
            icon={<Timer />}
            label={loading ? "Executing..." : "Ready"}
            color={loading ? "warning" : "success"}
          />
        </Stack>
      </Box>
    </Box>
  );
};

export default CommandPanel;
