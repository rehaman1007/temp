import React, { useState } from "react";
import {
  Alert,
  AlertTitle,
  alpha,
  Box,
  Button,
  CircularProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import { CloudUpload, FilePresent, UploadFile } from "@mui/icons-material";

const UploadScript = ({ onUpload, loading, showSnackbar }) => {
  const theme = useTheme();

  /**
   * STATES
   */
  const [selectedFile, setSelectedFile] = useState(null);

  const [dragging, setDragging] = useState(false);

  /**
   * VALIDATE FILE
   */
  const validateFile = (file) => {
    if (!file) return;

    const fileName = file.name?.toLowerCase() || "";

    if (!fileName.endsWith(".sql")) {
      showSnackbar?.("Only .sql files are supported", "error");

      return;
    }

    setSelectedFile(file);
  };

  /**
   * UPLOAD
   */
  const handleUpload = () => {
    if (!selectedFile) {
      showSnackbar?.("Please select SQL file", "warning");

      return;
    }

    onUpload?.(selectedFile);
  };

  /**
   * RESET FILE
   */
  const resetFile = () => {
    setSelectedFile(null);
  };

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          px: 3,
          py: 2,
          background: "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
        }}
      >
        <Stack direction="row" spacing={1.5} alignItems="center">
          <UploadFile />

          <Box>
            <Typography fontWeight={800}>SQL Script Upload</Typography>

            <Typography
              variant="caption"
              sx={{
                opacity: 0.75,
              }}
            >
              Upload and execute huge SQL files with live monitoring
            </Typography>
          </Box>
        </Stack>
      </Box>

      {/* DROP ZONE */}
      <Box
        onDragOver={(e) => {
          e.preventDefault();
          setDragging(true);
        }}
        onDragLeave={() => {
          setDragging(false);
        }}
        onDrop={(e) => {
          e.preventDefault();
          setDragging(false);
          validateFile(e.dataTransfer.files?.[0]);
        }}
        sx={{
          m: 3,
          p: 6,
          borderRadius: 4,
          border: `2px dashed ${
            dragging ? theme.palette.primary.main : theme.palette.divider
          }`,
          bgcolor: dragging
            ? alpha(theme.palette.primary.main, 0.08)
            : alpha(theme.palette.primary.main, 0.02),
          transition: "all .25s ease",
          textAlign: "center",
        }}
      >
        <CloudUpload
          sx={{
            fontSize: 80,
            color: theme.palette.primary.main,

            filter: "drop-shadow(0 0 20px rgba(59,130,246,0.35))",
          }}
        />

        <Typography variant="h6" fontWeight={800} mt={2}>
          Drag & Drop SQL Script
        </Typography>

        <Typography variant="body2" color="text.secondary" mt={1}>
          Supports large SQL files with async execution tracking
        </Typography>

        <Button
          component="label"
          variant="contained"
          disableElevation
          sx={{
            mt: 4,
            borderRadius: 3,
            px: 4,
            py: 1.2,
            background: "linear-gradient(135deg,#2563eb,#3b82f6)",
            boxShadow: "0 8px 30px rgba(37,99,235,0.35)",
            "&:hover": {
              transform: "translateY(-1px)",
            },
          }}
        >
          Browse SQL File
          <input
            hidden
            type="file"
            accept=".sql"
            onChange={(e) => validateFile(e.target.files?.[0])}
          />
        </Button>
      </Box>

      {/* FILE CARD */}
      {selectedFile && (
        <Box px={3}>
          <Alert
            severity="info"
            icon={<FilePresent />}
            sx={{
              borderRadius: 3,
            }}
          >
            <AlertTitle>Selected SQL File</AlertTitle>

            <Stack
              direction="row"
              justifyContent="space-between"
              alignItems="center"
              flexWrap="wrap"
              gap={2}
            >
              <Box>
                <Typography fontWeight={700}>{selectedFile.name}</Typography>

                <Typography variant="body2" color="text.secondary">
                  Size : {(selectedFile.size / 1024 / 1024).toFixed(2)} MB
                </Typography>
              </Box>

              <Button size="small" color="error" onClick={resetFile}>
                Remove
              </Button>
            </Stack>
          </Alert>
        </Box>
      )}

      {/* ACTIONS */}
      <Stack direction="row" justifyContent="flex-end" spacing={2} p={3}>
        <Button
          variant="outlined"
          onClick={resetFile}
          disabled={!selectedFile || loading}
          sx={{
            borderRadius: 3,
            px: 3,
          }}
        >
          Reset
        </Button>

        <Button
          variant="contained"
          disableElevation
          startIcon={
            loading ? (
              <CircularProgress size={16} color="inherit" />
            ) : (
              <UploadFile />
            )
          }
          onClick={handleUpload}
          disabled={!selectedFile || loading}
          sx={{
            borderRadius: 3,
            px: 4,
            py: 1.1,
            background: "linear-gradient(135deg,#2563eb,#3b82f6)",
            boxShadow: "0 8px 30px rgba(37,99,235,0.35)",
            "&:hover": {
              transform: "translateY(-1px)",
            },
          }}
        >
          {loading ? "Uploading..." : "Start Execution"}
        </Button>
      </Stack>
    </Paper>
  );
};

export default UploadScript;
