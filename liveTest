import React, { useEffect, useState } from "react";

import {
  Alert,
  AlertTitle,
  alpha,
  Box,
  Chip,
  Divider,
  LinearProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";

import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";

import CustomChip from "../../../utils/CustomChip";

const LogsPanel = ({ lastResponse, jobStatus }) => {
  const theme = useTheme();
  const [elapsed, setElapsed] = useState(0);

  useEffect(() => {
    if (!jobStatus?.startedAt) return;

    /** COMPLETED / FAILED */
    if (jobStatus.status === "COMPLETED" || jobStatus.status === "FAILED") {
      setElapsed(Number(jobStatus?.elapsedSeconds || 0));
      return;
    }

    /** LIVE TIMER */
    const updateElapsed = () => {
      const seconds = Math.floor(
        (Date.now() - Number(jobStatus.startedAt)) / 1000,
      );

      setElapsed(seconds > 0 ? seconds : 0);
    };

    updateElapsed();

    const interval = setInterval(updateElapsed, 1000);

    return () => clearInterval(interval);
  }, [
    jobStatus?.startedAt,
    jobStatus?.completedAt,
    jobStatus?.status,
    jobStatus?.elapsedSeconds,
  ]);

  /** EMPTY STATE */
  if (!lastResponse && !jobStatus) {
    return (
      <Paper
        elevation={0}
        sx={{
          borderRadius: 1,
          border: `1px solid ${theme.palette.divider}`,
          overflow: "hidden",
        }}
      >
        <Box
          sx={{
            px: 2.5,
            py: 1.5,
            background: "linear-gradient(135deg,#111827,#1f2937)",
            color: "white",
          }}
        >
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>
        </Box>

        <Box p={3}>
          <Alert
            severity="info"
            icon={<Info />}
            sx={{
              borderRadius: 3,
            }}
          >
            <AlertTitle>Waiting for execution</AlertTitle>
            Execute SQL query or upload script to view logs.
          </Alert>
        </Box>
      </Paper>
    );
  }

  const processed = Number(jobStatus?.processedCount || 0);
  const executed = Number(jobStatus?.executedCount || 0);
  const total = Number(jobStatus?.totalStatements || 0);
  const progress = Number(jobStatus?.progress || 0);
  const pending = Math.max(total - processed, 0);

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 1,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          px: 2.5,
          py: 1.5,
          background: "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>

          {jobStatus?.status && (
            <Chip
              size="small"
              label={jobStatus.status}
              color={
                jobStatus.status === "COMPLETED"
                  ? "success"
                  : jobStatus.status === "FAILED"
                    ? "error"
                    : "warning"
              }
            />
          )}
        </Stack>
      </Box>

      {/* BODY */}
      <Box
        sx={{
          p: 2.5,
          bgcolor: "#020617",
          color: "#e2e8f0",
          fontFamily: "monospace",
          flex: 1,
          overflow: "auto",
          minHeight: 400,
        }}
      >
        {/* LIVE PROGRESS */}
        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#38bdf8",
                mb: 1,
              }}
            >
              {">"} LIVE EXECUTION STATUS
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,
                borderRadius: 2,
                bgcolor: "rgba(255,255,255,0.03)",
                border: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack spacing={1.5}>
                <Typography>STATUS : {jobStatus.status}</Typography>

                <Typography>JOB ID : {jobStatus.jobId}</Typography>

                <Typography>
                  PROCESSED : {processed.toLocaleString()}
                </Typography>

                <Typography>EXECUTED : {executed.toLocaleString()}</Typography>

                <Typography>TOTAL : {total.toLocaleString()}</Typography>

                <Typography>PENDING : {pending.toLocaleString()}</Typography>

                <Typography>
                  SPEED : {jobStatus.executionSpeed || 0} stmt/sec
                </Typography>

                <Typography>ETA : {jobStatus.etaSeconds || 0} sec</Typography>

                <Typography>ELAPSED : {elapsed} sec</Typography>

                <Typography>
                  CURRENT LINE : {jobStatus.currentLine || 0}
                </Typography>

                <Box mt={1}>
                  <LinearProgress
                    variant="determinate"
                    value={progress}
                    sx={{
                      height: 10,
                      borderRadius: 10,

                      "& .MuiLinearProgress-bar": {
                        background: "linear-gradient(90deg,#2563eb,#7c3aed)",
                      },
                    }}
                  />

                  <Typography
                    variant="caption"
                    sx={{
                      mt: 1,
                      display: "block",
                    }}
                  >
                    {progress}%
                  </Typography>
                </Box>
              </Stack>
            </Box>
          </>
        )}

        {/* ERROR */}
        {(lastResponse?.error || jobStatus?.status === "FAILED") && (
          <>
            <Typography
              sx={{
                color: "#f87171",
                mb: 1,
              }}
            >
              {">"} ERROR LOG
            </Typography>

            <Alert
              severity="error"
              icon={<ErrorOutline />}
              sx={{
                mb: 3,
                borderRadius: 3,
              }}
            >
              <AlertTitle>Execution Failed</AlertTitle>

              {lastResponse?.message || jobStatus?.message || "Unknown error"}

              {jobStatus?.failedLine && (
                <>
                  <Divider sx={{ my: 1 }} />
                  Failed Line : {jobStatus.failedLine}
                </>
              )}
            </Alert>
          </>
        )}

        {/* FAILED SQL */}
        {jobStatus?.failedSql && (
          <>
            <Typography
              sx={{
                color: "#fb7185",
                mb: 1,
              }}
            >
              {">"} FAILED SQL
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,
                borderRadius: 2,
                bgcolor: "#111827",
                border: "1px solid rgba(248,113,113,0.2)",
                overflowX: "auto",
              }}
            >
              <Typography
                sx={{
                  whiteSpace: "pre-wrap",
                  color: "#fca5a5",
                  fontSize: 13,
                  lineHeight: 1.8,
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          </>
        )}

        {/* SUCCESS */}
        {lastResponse && !lastResponse.error && (
          <>
            <Typography
              sx={{
                color: "#4ade80",
                mb: 1,
              }}
            >
              {">"} EXECUTION SUCCESS
            </Typography>

            <Alert
              severity="success"
              icon={<CheckCircle sx={{ color: "white" }} />}
              sx={{
                mb: 3,
                borderRadius: 3,
              }}
            >
              <AlertTitle color="white">SQL Executed Successfully</AlertTitle>

              <Typography color="white">
                {lastResponse?.rows?.[0]?.RESULT ||
                  "Execution completed successfully"}
              </Typography>
            </Alert>
          </>
        )}

        {/* SUMMARY */}
        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#c084fc",
                mb: 1,
              }}
            >
              {">"} EXECUTION SUMMARY
            </Typography>

            <Box
              sx={{
                p: 2,
                borderRadius: 2,
                bgcolor: alpha(theme.palette.primary.main, 0.08),
                border: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
                <CustomChip
                  variant="outlined"
                  label={`INSERT : ${jobStatus.insertCount || 0}`}
                  color="success"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`UPDATE : ${jobStatus.updateCount || 0}`}
                  color="warning"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`DELETE : ${jobStatus.deleteCount || 0}`}
                  color="error"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`OTHERS : ${jobStatus.otherCount || 0}`}
                  color="info"
                  size="small"
                />
              </Stack>
            </Box>
          </>
        )}

        {/* RUNNING */}

        {jobStatus?.status === "RUNNING" && (
          <Alert
            severity="warning"
            icon={<WarningAmber />}
            sx={{
              mt: 3,
              borderRadius: 3,
            }}
          >
            <AlertTitle>Execution In Progress</AlertTitle>
            Pending statements : {pending.toLocaleString()}
          </Alert>
        )}
      </Box>
    </Paper>
  );
};

export default LogsPanel;
