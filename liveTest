/**
 * Dynamically generate proxy config for Vite
 */
const generateProxyConfig = (services) => {
  const proxyConfig = {};
  Object.values(services).forEach(({ alias, host, port }) => {
    proxyConfig[alias] = {
      target: `${host}:${port}`,
      changeOrigin: true,
      secure: false,
      rewrite: (path) => path.replace(new RegExp(`^${alias}`), ""),
    };
  });
  return proxyConfig;
};

// Export Vite config
export default defineConfig({
