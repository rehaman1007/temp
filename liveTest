  const performLogout = useCallback(
    async (reason = "USER_INITIATED") => {
      clearAllTimers();
      setSessionReason(reason);
      setSessionDialogOpen(true);

      try {
        await api.post(`${resolveConfig("/LS")}/auth/logout`);
      } catch (e) {
        console.error(e);
      } finally {
        // 1. Clear menus
        dispatch(clearMenus());
        
        // 2. Clear auth state
        dispatch(logoutSuccess());
        
        // 3. Purge storage BEFORE navigating to the login screen
        try {
          await persistor.purge();
        } catch (error) {
          console.error("Error while purging persisted store:", error);
        }
        
        setWarningOpen(false);
      }
    },
    [dispatch, clearAllTimers]
