import react from "@vitejs/plugin-react";
import fs from "fs";
import { defineConfig } from "vite";

/* ======================================================
   1. TEAM LOCAL IPs
====================================================== */
const LOCAL_USERS = {
  rehaman: "http://10.0.19.203",
  rugved: "http://10.0.26.102",
  anandi: "http://10.0.19.100",
  tejas: "http://10.0.242.165",
  sampath: "http://10.0.19.123",
  abhilash: "http://10.0.17.76",
  lokesh: "http://10.0.26.221",
  shubhankar: "http://10.0.17.242",
  jailabdin: "http://10.0.19.48",
  arbendu: "http://10.0.26.152",
};

/* ======================================================
   2. NON-LOCAL GATEWAYS
====================================================== */
const HOSTS = {
  DEV: "https://10.177.107.138",
  UAT: "https://10.0.26.102",
};

/* ======================================================
   3. DEFAULT ENV & DEFAULT LOCAL USER
====================================================== */
const DEFAULT_ENV = "LOCAL";            // LOCAL | DEV | UAT
const DEFAULT_LOCAL_USER = "rehaman";

/* ======================================================
   4. SERVICE DEFINITIONS (ORIGINAL PORTS)
====================================================== */
const SERVICES = {
  LoginService: { alias: "/LS", port: 443 },
  UserService: { alias: "/UM", port: 8087 },
  CommonRequestService: { alias: "/CR", port: 9000 },
  CommonMasterService: { alias: "/CM", port: 2000 },
  ReportsService: { alias: "/RS", port: 9005 },
  NotificationService: { alias: "/NS", port: 9010 },
};

/* ======================================================
   5. SERVICE ROUTING CONFIG (🔥 CORE)
====================================================== */
const SERVICE_ROUTING = {
  LoginService: {
    env: "DEV", // ignores local user
  },

  UserService: {
    env: "LOCAL",
    localUser: "shubhankar",
  },

  CommonRequestService: {
    env: "LOCAL",
    localUser: "rehaman",
  },

  CommonMasterService: {
    env: "UAT",
  },

  ReportsService: {
    env: "LOCAL",
    localUser: "jailabdin",
  },

  NotificationService: {
    env: "LOCAL", // uses default local user
  },
};

/* ======================================================
   6. RESOLVE TARGET (ENV + USER + PORT)
====================================================== */
const resolveTarget = (serviceName, localPort) => {
  const routing = SERVICE_ROUTING[serviceName] || {};

  const env = routing.env || DEFAULT_ENV;

  // 🔹 LOCAL
  if (env === "LOCAL") {
    const user =
      routing.localUser || DEFAULT_LOCAL_USER;

    const host = LOCAL_USERS[user];
    if (!host) {
      throw new Error(
        `Unknown LOCAL user "${user}" for ${serviceName}`
      );
    }

    return `${host}:${localPort}`;
  }

  // 🔹 DEV / UAT → always 443
  return `${HOSTS[env]}:443`;
};

/* ======================================================
   7. GENERATE PROXY CONFIG
====================================================== */
const generateProxyConfig = () => {
  const proxy = {};

  Object.entries(SERVICES).forEach(
    ([serviceName, { alias, port }]) => {
      const target = resolveTarget(serviceName, port);

      proxy[alias] = {
        target,
        changeOrigin: true,
        secure: false,
        rewrite: (path) =>
          path.replace(new RegExp(`^${alias}`), ""),
      };

      console.log(
        `[PROXY] ${alias} → ${target}`
      );
    }
  );

  return proxy;
};

/* ======================================================
   8. EXPORT VITE CONFIG
====================================================== */
export default defineConfig({
  plugins: [react()],
  server: {
    host: true,
    port: 1000,
    https: {
      key: fs.readFileSync("./localhost-key.pem"),
      cert: fs.readFileSync("./localhost.pem"),
    },
    proxy: generateProxyConfig(),
  },
});