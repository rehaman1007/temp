package com.example;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.Statement;
import javax.naming.InitialContext;
import javax.naming.Context;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.sql.DataSource;

@WebServlet("/report")
public class ReportDownload extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request,
                         HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/plain");
        PrintWriter out = response.getWriter();

        try {
            Context ctx = new InitialContext();
            DataSource ds = (DataSource) ctx.lookup("jdbc/DigiGOVNonXAPooledDS");

            // Explicitly defining all columns for the query
            String query = "SELECT Date, Total_no_of_file_generated_in_Digigov, " +
                           "Total_Transaction_Amount, Transaction_Generation_for_SBI_Account, " +
                           "Transaction_Generation_for_non_SBI_Account, Extract_Received_for_SBI_Account, " +
                           "Extract_not_Received_for_SBI_Account, Extract_Received_for_non_SBI_Account, " +
                           "Extract_not_Received_for_non_SBI_Account, Total_Amount_for_SBI_Account, " +
                           "Total_Amount_for_SBI_non_Account " +
                           "FROM [dbo].[RSK_PAYMENT_REPORT]";

            try (Connection con = ds.getConnection();
                 Statement stmt = con.createStatement();
                 ResultSet rs = stmt.executeQuery(query)) {

                // Fetching data by column name makes the code robust against DB changes
                while (rs.next()) {
                    out.println(
                            rs.getString("Date") + ", " +
                            rs.getString("Total_no_of_file_generated_in_Digigov") + ", " +
                            rs.getString("Total_Transaction_Amount") + ", " +
                            rs.getString("Transaction_Generation_for_SBI_Account") + ", " +
                            rs.getString("Transaction_Generation_for_non_SBI_Account") + ", " +
                            rs.getString("Extract_Received_for_SBI_Account") + ", " +
                            rs.getString("Extract_not_Received_for_SBI_Account") + ", " +
                            rs.getString("Extract_Received_for_non_SBI_Account") + ", " +
                            rs.getString("Extract_not_Received_for_non_SBI_Account") + ", " +
                            rs.getString("Total_Amount_for_SBI_Account") + ", " +
                            rs.getString("Total_Amount_for_SBI_non_Account")
                    );
                }
            }
        } catch (Exception e) {
            e.printStackTrace(out);
        }
    }
}
