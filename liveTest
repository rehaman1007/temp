
/*
=========================================================
1. LOGIN API
POST /api/auth/login
=========================================================
*/

// SCENARIO 1: MFA DISABLED OR MFA SKIPPED DUE TO PROVIDER FAILURE
// HTTP 200 OK
// Frontend: Establish session directly and navigate to dashboard.

{
  "success": true,
  "message": "Login successful.",
  "data": {
    "accessToken": "<access-token>",
    "refreshToken": "<refresh-token>",
    "user": {},
    "roleData": {
      "root_menus": []
    }
  }
}

// Response header:
// X-Payload-Key: <encrypted-payload-key>


// SCENARIO 2: MFA ENABLED AND OTP SENT SUCCESSFULLY
// HTTP 202 ACCEPTED
// Frontend: Navigate to OTP screen.
// Display the backend message exactly as received.

{
  "success": true,
  "message": "Code sent to ***1234 and a***o@sbi.co.in",
  "data": {
    "transactionId": "uuid-tx-string",
    "maskedMobile": "***1234",
    "maskedEmail": "a***o@sbi.co.in",
    "expiresInSeconds": 300,
    "resendCooldownSeconds": 60,
    "resendsRemaining": 3,
    "otpConfig": {
      "otpLength": 6,
      "expirySeconds": 300,
      "resendCooldownSeconds": 60,
      "maxResends": 3,
      "resendWindowSeconds": 600,
      "maxVerificationAttempts": 5,
      "inactivityTimeoutSeconds": 900
    }
  }
}


// SCENARIO 3: NO REGISTERED MOBILE NUMBER OR EMAIL
// Suggested HTTP 422 UNPROCESSABLE ENTITY
// Frontend: Display error on login screen. Do not navigate to OTP.

{
  "success": false,
  "message": "Code cannot be sent: No valid mobile number or email address is mapped with User ID.",
  "data": null
}


// SCENARIO 4: SMS/EMAIL PROVIDER FAILURE
// If MFA is skipped as permitted by business rules and login succeeds:
// HTTP 200 with the normal authenticated login response (Scenario 1).
//
// If login cannot proceed:
// Suggested HTTP 503 SERVICE UNAVAILABLE.

{
  "success": false,
  "message": "Unable to reach the SMS/email provider. Please try again after some time.",
  "data": null
}


/*
=========================================================
2. VERIFY OTP API
POST /api/auth/verify-otp
=========================================================*/

// REQUEST BODY FOR ALL VERIFICATION SCENARIOS:

{
  "transactionId": "uuid-tx-string",
  "otp": "123456"
}


// SCENARIO 5: OTP VERIFIED SUCCESSFULLY
// HTTP 200 OK
// Frontend: Establish authenticated session and navigate to dashboard.

{
  "success": true,
  "message": "OTP verified successfully.",
  "data": {
    "accessToken": "<access-token>",
    "refreshToken": "<refresh-token>",
    "user": {},
    "roleData": {
      "root_menus": []
    }
  }
}

// Response header:
// X-Payload-Key: <encrypted-payload-key>


// SCENARIO 6: INVALID OTP FORMAT
// HTTP 400 BAD REQUEST
// Frontend: Display exact message, clear all six inputs,
// and focus the first input.

{
  "success": false,
  "message": "Please enter a valid 6-digit numeric code.",
  "data": null
}


// SCENARIO 7: FIRST INCORRECT OTP ATTEMPT
// HTTP 401 UNAUTHORIZED
// Frontend: Display message inline, clear OTP and refocus.

{
  "success": false,
  "message": "Invalid code. 4 attempts remaining.",
  "data": {
    "attemptsRemaining": 4
  }
}


// SCENARIO 8: SECOND INCORRECT OTP ATTEMPT
// HTTP 401 UNAUTHORIZED

{
  "success": false,
  "message": "Invalid code. 3 attempts remaining.",
  "data": {
    "attemptsRemaining": 3
  }
}


// SCENARIO 9: THIRD INCORRECT OTP ATTEMPT
// HTTP 401 UNAUTHORIZED

{
  "success": false,
  "message": "Invalid code. 2 attempts remaining.",
  "data": {
    "attemptsRemaining": 2
  }
}


// SCENARIO 10: FOURTH INCORRECT OTP ATTEMPT
// HTTP 401 UNAUTHORIZED

{
  "success": false,
  "message": "Invalid code. 1 attempts remaining.",
  "data": {
    "attemptsRemaining": 1
  }
}


// SCENARIO 11: FIFTH INCORRECT OTP ATTEMPT
// HTTP 401 UNAUTHORIZED
// Frontend:
// - Keep user on OTP screen.
// - Clear and disable OTP inputs.
// - Display backend message.
// - Keep Resend OTP enabled when cooldown permits.
// - Do NOT redirect to login screen.

{
  "success": false,
  "message": "Too many incorrect attempts. The code has been expired. Please request a new code.",
  "data": {
    "attemptsRemaining": 0,
    "otpExpired": true,
    "resendAllowed": true
  }
}


// SCENARIO 12: OTP EXPIRED (5-MINUTE VALIDITY EXCEEDED)
// HTTP 401 UNAUTHORIZED
// Frontend: Return user to sign-in screen with an error message.
// User must enter User ID and password again.

{
  "success": false,
  "message": "The code is invalid or has expired. Please request a new code.",
  "data": {
    "otpExpired": true
  }
}


// SCENARIO 13: OTP TRANSACTION DOES NOT EXIST OR IS INVALID
// HTTP 401 UNAUTHORIZED

{
  "success": false,
  "message": "The code is invalid or has expired. Please request a new code.",
  "data": {
    "otpExpired": true
  }
}


// SCENARIO 14: OTP SESSION IDLE TIMEOUT (15 MINUTES)
// HTTP 401 UNAUTHORIZED
// Frontend: Return to sign-in screen.
// User must enter credentials again.

{
  "success": false,
  "message": "Your session has timed out. Please log in again.",
  "data": {
    "sessionExpired": true
  }
}


/*
=========================================================
3. RESEND OTP API
POST /api/auth/resend-otp
=========================================================*/

// REQUEST BODY:

{
  "transactionId": "uuid-tx-string"
}


// SCENARIO 15: RESEND OTP SUCCESSFUL
// HTTP 200 OK
// Frontend:
// - Update transactionId and timer values.
// - Update remaining resend count.
// - Clear all OTP inputs.
// - Focus first OTP input.
// - Display backend success message.

{
  "success": true,
  "message": "New Code sent to ***1234 and a***o@sbi.co.in",
  "data": {
    "transactionId": "new-uuid-tx-string",
    "maskedMobile": "***1234",
    "maskedEmail": "a***o@sbi.co.in",
    "expiresInSeconds": 300,
    "resendCooldownSeconds": 60,
    "resendsRemaining": 2
  }
}


// SCENARIO 16: RESEND REQUESTED BEFORE 60-SECOND COOLDOWN
// HTTP 429 TOO MANY REQUESTS
// Frontend: Display exact backend message.
// Update cooldown using retryAfterSeconds if returned.

{
  "success": false,
  "message": "Please wait 35 seconds before requesting another code.",
  "data": {
    "retryAfterSeconds": 35,
    "resendsRemaining": 2
  }
}


// SCENARIO 17: MAXIMUM RESEND LIMIT REACHED
// HTTP 429 TOO MANY REQUESTS
// Frontend: Disable Resend OTP and display backend message.

{
  "success": false,
  "message": "Maximum resend limit reached. Kindly Wait.",
  "data": {
    "resendsRemaining": 0,
    "resendWindowSeconds": 600
  }
}


// SCENARIO 18: RESEND REQUEST AFTER SESSION TIMEOUT
// HTTP 401 UNAUTHORIZED
// Frontend: Return to sign-in screen.

{
  "success": false,
  "message": "Your session has timed out. Please log in again.",
  "data": {
    "sessionExpired": true
  }
}


// SCENARIO 19: RESEND REQUEST FOR EXPIRED TRANSACTION
// HTTP 401 UNAUTHORIZED
// Frontend: Return to sign-in screen and request fresh login.

{
  "success": false,
  "message": "The code is invalid or has expired. Please request a new code.",
  "data": {
    "otpExpired": true
  }
}


// SCENARIO 20: SMS/EMAIL PROVIDER FAILURE DURING RESEND
// Suggested HTTP 503 SERVICE UNAVAILABLE
// Frontend: Keep user on OTP screen and display backend message.

{
  "success": false,
  "message": "Unable to reach the SMS/email provider. Please try again after some time.",
  "data": null
}


