import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Tooltip,
  Typography,
  CircularProgress,
  Stack,
} from "@mui/material";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import ProcessStatusChip from "./ProcessStatusChip";
import { StageStatus } from "../util/StageStatus";

const Action = ({ title, icon, disabled, onClick }) => (
  <Tooltip title={title}>
    <span>
      <IconButton disabled={disabled} onClick={onClick}>
        {icon}
      </IconButton>
    </span>
  </Tooltip>
);

const ProcessStatusTable = ({ processes, actions, loading }) => {
  return (
    <TableContainer component={Paper}>
      <Table size="small">
        <TableHead>
          <TableRow>
            <TableCell>Process</TableCell>
            <TableCell align="center">Status</TableCell>
            <TableCell align="center">Stage</TableCell>
            <TableCell align="center">Started</TableCell>
            <TableCell align="center">Ended</TableCell>
            <TableCell align="center">Actions</TableCell>
          </TableRow>
        </TableHead>

        <TableBody>
          {loading && (
            <TableRow>
              <TableCell colSpan={6} align="center">
                <CircularProgress size={20} />
                <Typography variant="caption" ml={1}>
                  Loading processes please wait...
                </Typography>
              </TableCell>
            </TableRow>
          )}

          {!loading &&
            processes.map((p) => {
              const lastStage = p.stageDetails[p.stageDetails.length - 1];
              if (!lastStage) return null;

              return (
                <TableRow
                  key={p.processType}
                  sx={{
                    bgcolor:
                      lastStage.status === StageStatus.STARTED
                        ? "action.hover"
                        : "inherit",
                  }}
                >
                  <TableCell>{p.processType}</TableCell>
                  <TableCell align="center">
                    <ProcessStatusChip status={lastStage.status} />
                  </TableCell>
                  <TableCell align="center">{lastStage.stage.title}</TableCell>
                  <TableCell align="center">{lastStage.startTime}</TableCell>
                  <TableCell align="center">{lastStage.endTime}</TableCell>
                  <TableCell align="center">
                    <Action
                      title="Stop"
                      icon={<StopIcon />}
                      disabled={lastStage.status !== StageStatus.STARTED}
                      onClick={actions.onStop}
                    />
                    <Action
                      title="Restart"
                      icon={<RestartAltIcon />}
                      disabled={lastStage.status !== StageStatus.ERROR}
                      onClick={actions.onRestart}
                    />
                    <Action
                      title="View"
                      icon={<VisibilityIcon />}
                      onClick={() => actions.onView(p)}
                    />
                  </TableCell>
                </TableRow>
              );
            })}

          {!loading && processes.length === 0 && (
            <TableRow>
              <TableCell colSpan={6} align="center">
                <Typography color="error.light">
                  Processes Not Available
                </Typography>
              </TableCell>
            </TableRow>
          )}
        </TableBody>
      </Table>
    </TableContainer>
  );
};

export default ProcessStatusTable;
