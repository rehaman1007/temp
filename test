              },
            }}
          >
            <Typography
              variant="h6"
              fontWeight={800}
              sx={{
                color: "#1a1a1a",
                letterSpacing: "-0.5px",
              }}
            >
              Balance Ledger
            </Typography>

            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString("en-IN")} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
                width: {
                  xs: "fit-content",
                  sm: "auto",
                },
              }}
            />
          </Box>
          <Button
            variant="contained"
            // size="small"
            size={isMobile ? "medium" : "small"}
            startIcon={
              exporting ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={!rowCount || loading || exporting}
            sx={{
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              "&:hover": { bgcolor: "#45357a" },
            }}
          >
            {exporting ? "Preparing..." : "Export"}
          </Button>
        </Stack>

        {/* DATA GRID SECTION */}
        <Box
          sx={{
            width: "100%",
            overflowX: "auto",
            height: {
              xs: "65vh",
              sm: "70vh",
              md: 600,
            },
          }}
        >
          <DataGrid
            rows={rows}
            columns={balanceColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) => row.id}
            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"
            pageSizeOptions={[10, 20, 50, 100]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            sortModel={sortModel}
            onSortModelChange={setSortModel}
            filterModel={filterModel}
            onFilterModelChange={setFilterModel}
            rowHeight={50}
            disableRowSelectionOnClick
            slots={{ noRowsOverlay: CustomNoRowsOverlay }}
            // showToolbar={rowCount > 0}
            // slotProps={{
            //   toolbar: {
            //     showQuickFilter: false,
            //     csvOptions: { disableToolbarButton: true }, // Hides CSV export
            //     printOptions: { disableToolbarButton: true }, // Hides Print option
            //   },
            // }}

            initialState={{
              columns: {
                columnVisibilityModel,
              },
            }}
            sx={{
              borderRadius: "20px",
              backgroundColor: "rgba(255,255,255,0.4)",
              border: "1px solid rgba(255,255,255,0.3)",

              "& .MuiDataGrid-columnHeaders": {
                bgcolor: "#f8f9fa",
                fontWeight: 700,
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default BalanceLedgerDataGrid;
