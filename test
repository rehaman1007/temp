onSuccess: async (response, variables) => {
  console.log("Blob Response", response);
  console.log("Variables", variables);

  const exportType =
    variables.exportType?.toUpperCase();

  /**
   * CLIPBOARD EXPORT
   */
  if (exportType === "CLIPBOARD") {
    try {
      const text = await response.text();

      if (!text?.trim()) {
        showSnackbar(
          "No data available to copy",
          "warning",
        );
        return;
      }

      // Optional safety limit (10 MB)
      if (text.length > 10_000_000) {
        showSnackbar(
          "Clipboard content is too large. Use INSERT export instead.",
          "warning",
        );
        return;
      }

      await navigator.clipboard.writeText(
        text,
      );

      showSnackbar(
        "INSERT statements copied to clipboard",
        "success",
      );

      return;
    } catch (err) {
      console.error(err);

      showSnackbar(
        "Failed to copy to clipboard",
        "error",
      );

      return;
    }
  }

  /**
   * FILE EXPORT
   */
  let format = "csv";

  switch (exportType) {
    case "EXCEL":
      format = "xlsx";
      break;

    case "JSON":
      format = "json";
      break;

    case "INSERT":
      format = "sql";
      break;

    case "CSV":
    default:
      format = "csv";
      break;
  }

  downloadFile(
    response,
    format,
    `export_${Date.now()}`,
  );

  showSnackbar(
    "Export completed successfully",
    "success",
  );
},

const handleExport = (
  exportParams,
) => {
  const sql = lastExecutedQuery;

  const exportType =
    exportParams.exportType;

  const tableName =
    exportParams.tableName;

  if (!lastExecutedQuery) {
    showSnackbar(
      "Execute a SELECT query first",
      "warning",
    );
    return;
  }

  if (
    ["INSERT", "CLIPBOARD"].includes(
      exportType,
    ) &&
    !tableName?.trim()
  ) {
    showSnackbar(
      "Table name required",
      "warning",
    );
    return;
  }

  exportData({
    sql,

    /**
     * Reuse existing INSERT backend export
     */
    exportType:
      exportType === "CLIPBOARD"
        ? "INSERT"
        : exportType,

    tableName,
  });
};