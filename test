import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";
import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex((s) => s.status === StageStatus.STARTED);
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.status === StageStatus.ERROR);
  if (error !== -1) return error;

  const completedIndexes = stages
    .map((s, i) => (s.status === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  if (completedIndexes.length > 0) {
    return completedIndexes[completedIndexes.length - 1];
  }

  return 0;
};

const ProcessDetailsDialog = ({ process, onClose }) => {
  const stages = useMemo(() => process?.stageDetails || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    if (stages.length) {
      setActiveStep(resolveInitialActiveStep(stages));
    }
  }, [stages]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.status;

  return (
    <Dialog open={!!process} fullWidth maxWidth="md" onClose={onClose}>
      <DialogTitle>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        <Stack direction="row" gap={1}>
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />

          <StageDetails stages={stages} activeStep={activeStep} />
        </Stack>
      </DialogContent>

      <DialogActions>
        <Button
          startIcon={<StopIcon />}
          disabled={lastStatus !== StageStatus.STARTED}
        >
          Stop
        </Button>
        <Button
          startIcon={<RestartAltIcon />}
          disabled={lastStatus !== StageStatus.ERROR}
        >
          Restart
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ProcessDetailsDialog;


import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  Button,
} from "@mui/material";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted = !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
      ? "Started"
      : error
        ? "Failed"
        : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">{stage.stage.title}</Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button size="small" variant="contained" onClick={onClick}>
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  return (
    <Stepper orientation="vertical" sx={{ minWidth: 260 }}>
      {stageDetails.map((stage, index) => {
        const active = index === activeStep;

        return (
          <Step
            key={index}
            active
            data-step={index}
            sx={(theme) =>
              active
                ? {
                    backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                    position: "relative",
                    "&::after": {
                      content: '""',
                      position: "absolute",
                      right: -8,
                      top: 0,
                      width: 8,
                      height: "100%",
                      backgroundColor: theme.palette.divider,
                    },
                  }
                : {}
            }
          >
            <Box
              sx={(theme) =>
                active
                  ? {
                      backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                      position: "relative",
                      "&::after": {
                        content: '""',
                        position: "absolute",
                        right: -8,
                        top: 0,
                        width: 8,
                        height: "100%",
                        backgroundColor: theme.palette.divider,
                      },
                    }
                  : {}
              }
            >
              <ProcessStepContent
                stage={stage}
                active={active}
                onClick={() => onStageClick(index)}
              />
            </Box>
          </Step>
        );
      })}
    </Stepper>
  );
};

export default ProgressStepper;


import { Stack, Grid, Typography, Box, Chip, Divider } from "@mui/material";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import PlayCircleOutlineIcon from "@mui/icons-material/PlayCircleOutline";
import StopCircleOutlinedIcon from "@mui/icons-material/StopCircleOutlined";
import PersonOutlineIcon from "@mui/icons-material/PersonOutline";
import TimerOutlinedIcon from "@mui/icons-material/TimerOutlined";
import NotesOutlinedIcon from "@mui/icons-material/NotesOutlined";
import { toPascalKebabCase } from "../../../utils/CommonUtilities";

/* ================= TIME FORMAT ================= */
const formatDuration = (start, end) => {
  if (!start || !end) return null;

  const startMs = new Date(start).getTime();
  const endMs = new Date(end).getTime();
  if (isNaN(startMs) || isNaN(endMs) || endMs < startMs) return null;

  const diff = endMs - startMs;
  const s = Math.floor(diff / 1000) % 60;
  const m = Math.floor(diff / (1000 * 60)) % 60;
  const h = Math.floor(diff / (1000 * 60 * 60));

  return [h && `${h} hr`, m && `${m} min`, s && `${s} sec`]
    .filter(Boolean)
    .join(" ");
};

/* ================= REUSABLE INFO ITEM ================= */
const InfoItem = ({ icon, label, value }) =>
  value ? (
    <Stack
      direction="row"
      spacing={1.5}
      alignItems="flex-start"
      sx={{
        p: 2,
        borderRadius: 2,
        bgcolor: "background.paper",
        boxShadow: 1,
        height: "100%",
      }}
    >
      <Box sx={{ mt: "2px", color: "text.secondary" }}>{icon}</Box>
      <Stack spacing={0.3}>
        <Typography variant="caption" color="text.secondary">
          {label}
        </Typography>
        <Typography fontWeight={500}>{value}</Typography>
      </Stack>
    </Stack>
  ) : null;

/* ================= MAIN COMPONENT ================= */
const StageDetails = ({ stages = [], activeStep }) => {
  const stage = stages[activeStep];
  if (!stage) return null;

  return (
    <Stack
      flex={2}
      p={3}
      spacing={3}
      sx={(theme) => ({
        backgroundColor: theme.palette.action.hover,
        borderLeft: `1px solid ${theme.palette.divider}`,
      })}
    >
      {/* ================= STAGE HEADER ================= */}
      <Stack direction="row" spacing={2} alignItems="center">
        <Box
          sx={{
            p: 1.5,
            borderRadius: "50%",
            bgcolor: "primary.main",
            color: "primary.contrastText",
          }}
        >
          {stage.stage?.icon ? (
            <Box component="span">
              {/* icon already handled in stepper */}
              <AccessTimeIcon />
            </Box>
          ) : (
            <AccessTimeIcon />
          )}
        </Box>

        <Stack>
          <Typography variant="subtitle2" color="text.secondary">
            Stage
          </Typography>
          <Typography variant="h6" fontWeight={600}>
            {stage.stage?.title}
          </Typography>
        </Stack>
      </Stack>

      <Divider />

      {/* ================= ROW 2: START / END ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PlayCircleOutlineIcon fontSize="small" />}
            label="Start Time"
            value={stage.startTime}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<StopCircleOutlinedIcon fontSize="small" />}
            label="End Time"
            value={stage.endTime}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 3: TRIGGERED / DURATION ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PersonOutlineIcon fontSize="small" />}
            label="Triggered By"
            value={toPascalKebabCase(stage.triggeredBy) || "N/A"}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<TimerOutlinedIcon fontSize="small" />}
            label="Time Taken"
            value={formatDuration(stage._START_TIME_RAW, stage._END_TIME_RAW)}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 4: REMARKS ================= */}
      {stage.remarks && (
        <Stack
          spacing={1}
          sx={{
            p: 2.5,
            borderRadius: 2,
            bgcolor: "background.paper",
            boxShadow: 1,
          }}
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <NotesOutlinedIcon fontSize="small" color="action" />
            <Typography variant="subtitle2" color="text.secondary">
              Remarks
            </Typography>
          </Stack>

          <Typography>{stage.remarks}</Typography>
        </Stack>
      )}
    </Stack>
  );
};

export default StageDetails;
