import React, { useMemo } from "react";
import {
  Box,
  Typography,
  Card,
  Stack,
  Divider,
  Chip,
  useTheme,
} from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
} from "recharts";

// Gradient colors (matching your screenshot)
const COLORS = [
  "#6a5acd", // violet-blue
  "#d87093", // pink
  "#6495ed", // cornflower blue
  "#20b2aa", // teal
];

const RequestAnalytics = ({ data = [] }) => {
  const theme = useTheme();
  console.log(data);
  // ----- Compute Pie Chart Data -----
  const pieData = useMemo(() => {
    const counts = {
      total: 0,
      add: 0,
      modify: 0,
      delete: 0,
    };

    data.forEach((item) => {
      counts.total++;
      if (item.changeType === "ADD") counts.add++;
      if (item.changeType === "UPDATE") counts.modify++;
      if (item.changeType === "DELETE") counts.delete++;
    });

    return [
      { name: "Total Pending", value: counts.total },
      { name: "Add Requests", value: counts.add },
      { name: "Modify Requests", value: counts.modify },
      { name: "Delete Requests", value: counts.delete },
    ];
  }, [data]);

  // ----- Compute Histogram Data (requests per date) -----
  const histogramData = useMemo(() => {
    const map = {};
    data.forEach((item) => {
      if (item.reqDate) {
        const date = new Date(item.reqDate).toLocaleDateString("en-GB");
        map[date] = (map[date] || 0) + 1;
      }
    });
    return Object.keys(map)
      .sort(
        (a, b) =>
          new Date(a.split("/").reverse().join("-")) -
          new Date(b.split("/").reverse().join("-"))
      )
      .map((date) => ({ date, count: map[date] }));
  }, [data]);

  return (
    <Card
      sx={{
        bgcolor: "#1e1e2f",
        color: "white",
        p: 3,
        borderRadius: 4,
        boxShadow: "0px 4px 20px rgba(0,0,0,0.5)",
        mb: 4,
      }}
    >
      {/* Header */}
      <Typography variant="h6" sx={{ mb: 1 }}>
        Request Analytics Overview
      </Typography>
      <Typography variant="body2" sx={{ color: "gray", mb: 2 }}>
        Requests compared by type and activity frequency
      </Typography>

      <Divider sx={{ borderColor: "rgba(255,255,255,0.1)", mb: 2 }} />

      {/* Pie Chart + Legend */}
      <Box
        sx={{
          display: "flex",
          flexDirection: { xs: "column", md: "row" },
          justifyContent: "space-between",
          alignItems: "center",
        }}
      >
        <Box sx={{ width: { xs: "100%", md: "50%" }, height: 250 }}>
          <ResponsiveContainer>
            <PieChart>
              <defs>
                {COLORS.map((color, index) => (
                  <linearGradient
                    key={index}
                    id={`gradient-${index}`}
                    x1="0"
                    y1="0"
                    x2="1"
                    y2="1"
                  >
                    <stop offset="0%" stopColor={color} stopOpacity={0.9} />
                    <stop offset="100%" stopColor={color} stopOpacity={0.5} />
                  </linearGradient>
                ))}
              </defs>
              <Pie
                data={pieData}
                cx="50%"
                cy="50%"
                innerRadius={60}
                outerRadius={90}
                paddingAngle={5}
                dataKey="value"
              >
                {pieData.map((entry, index) => (
                  <Cell
                    key={`cell-${index}`}
                    fill={`url(#gradient-${index})`}
                    stroke="none"
                  />
                ))}
              </Pie>
              <Tooltip
                contentStyle={{
                  backgroundColor: "#2a2a3a",
                  borderRadius: 10,
                  border: "none",
                  color: "#fff",
                }}
              />
            </PieChart>
          </ResponsiveContainer>
        </Box>

        {/* Legends */}
        <Box sx={{ width: { xs: "100%", md: "45%" }, mt: { xs: 2, md: 0 } }}>
          <Typography variant="subtitle2" sx={{ mb: 1 }}>
            Request Breakdown
          </Typography>
          {pieData.map((item, i) => (
            <Stack
              direction="row"
              alignItems="center"
              justifyContent="space-between"
              sx={{
                bgcolor: "rgba(255,255,255,0.05)",
                borderRadius: 2,
                p: 1.2,
                mb: 1,
              }}
              key={item.name}
            >
              <Stack direction="row" alignItems="center" spacing={1.5}>
                <Box
                  sx={{
                    width: 14,
                    height: 14,
                    borderRadius: "50%",
                    bgcolor: COLORS[i],
                  }}
                />
                <Typography variant="body2">{item.name}</Typography>
              </Stack>
              <Chip
                label={item.value}
                size="small"
                sx={{
                  bgcolor: COLORS[i],
                  color: "white",
                  fontWeight: "bold",
                }}
              />
            </Stack>
          ))}
        </Box>
      </Box>

      <Divider sx={{ borderColor: "rgba(255,255,255,0.1)", my: 3 }} />

      {/* Histogram */}
      <Typography variant="subtitle2" sx={{ mb: 1 }}>
        Request Frequency by Date
      </Typography>
      <Box sx={{ width: "100%", height: 250 }}>
        <ResponsiveContainer>
          <BarChart data={histogramData}>
            <CartesianGrid
              strokeDasharray="3 3"
              stroke="rgba(255,255,255,0.1)"
            />
            <XAxis dataKey="date" stroke="white" />
            <YAxis stroke="white" />
            <Tooltip
              contentStyle={{
                backgroundColor: "#2a2a3a",
                borderRadius: 10,
                border: "none",
                color: "#fff",
              }}
            />
            <Bar
              dataKey="count"
              fill="url(#gradient-0)"
              radius={[6, 6, 0, 0]}
            />
          </BarChart>
        </ResponsiveContainer>
      </Box>
    </Card>
  );
};

export default RequestAnalytics;
