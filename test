 @GetMapping("/user-details")
    public ResponseEntity getUserDetails(@RequestHeader("Authorization") String token, @RequestParam Map<String, String> request) {
     String userId = jwtUtil.getUserIdFromToken(token);
     String role = String.valueOf(jwtUtil.getUserRoleFromToken(token));
        log.info("Received request to fetch all user details for the user : {} and role {}", userId, role);
        Map<String,String> params = new HashMap<>();
        params.put("id", userId);
        params.put("roleId", role);
        return userRequestService.getUserDetails(request);
    }
 
