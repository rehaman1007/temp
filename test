/* =====================================================
   ROWS TRANSFORMATION
===================================================== */

const rows = useMemo(() => {
  return processes.map((p) => {
    const lastStage = p.stages?.at(-1);

    const runId = Number(p.runId) || 1;
    const latestRunId = latestRunMap.get(p.processType);

    const isLatestRun = runId === latestRunId;

    const hasSummary =
      p.processType?.toUpperCase() === "DIFFERENCE" &&
      p.stages?.some(
        (s) =>
          s.stageStatus === StageStatus.COMPLETED &&
          SUMMARY_STAGES.has(s.stageId),
      );

    return {
      id: `${p.processType}_${p.processId}_${runId}`, // UNIQUE KEY

      processId: p.processId,
      processRunId: p.processRunId,
      processType: p.processType,

      runId,
      isLatestRun,

      status: p.status,

      stageTitle: lastStage?.stageTitle ?? "N/A",
      stageIcon: lastStage?.stageIcon,

      startTime: p.processStartTime,
      endTime: p.processEndTime,

      hasSummary,

      raw: p,
    };
  });
}, [processes, latestRunMap]);

renderCell: (params) => {
  const row = params.row.raw;

  const isLatestRun = params.row.isLatestRun;

  const showRestart =
    isLatestRun &&
    row?.status !== StageStatus.STARTED;

  const showStop =
    isLatestRun &&
    row?.status === StageStatus.STARTED;

  return (
    <Stack direction="row" spacing={1}>

      {(permissions.restart || permissions.start) && showRestart && (
        <Tooltip title="Restart">
          <IconButton onClick={() => actions.onStart(row)}>
            <RestartAltIcon />
          </IconButton>
        </Tooltip>
      )}

      {permissions.stop && showStop && (
        <Tooltip title="Stop">
          <IconButton onClick={() => actions.onStop(row)}>
            <StopIcon />
          </IconButton>
        </Tooltip>
      )}

      {permissions.view && (
        <Tooltip title="View">
          <IconButton onClick={() => actions.onView(row)}>
            <VisibilityIcon />
          </IconButton>
        </Tooltip>
      )}

      {permissions.view && params.row.hasSummary && (
        <Tooltip title="Summary">
          <IconButton onClick={() => actions.onSummary(row)}>
            <SummarizeOutlinedIcon />
          </IconButton>
        </Tooltip>
      )}

    </Stack>
  );
}

/* =====================================================
   FIND LATEST RUN PER PROCESS TYPE
===================================================== */

const latestRunMap = useMemo(() => {
  const map = new Map();

  processes.forEach((p) => {
    const type = p.processType;
    const runId = Number(p.runId) || 0;

    if (!map.has(type) || runId > map.get(type)) {
      map.set(type, runId);
    }
  });

  return map;
}, [processes]);

{
  field: "processType",
  headerName: "Process Name",
  flex: 1,

  renderHeader: () => (
    <Box sx={{ display: "flex", alignItems: "center" }}>
      <MemoryIcon sx={{ mr: 1 }} />
      <Typography variant="subtitle1">Process Name</Typography>
    </Box>
  ),

  renderCell: (params) => {
    const name = params.row.processType;
    const runId = params.row.runId;

    /* ordinal helper */
    const getOrdinal = (n) => {
      const s = ["th", "st", "nd", "rd"];
      const v = n % 100;
      return n + (s[(v - 20) % 10] || s[v] || s[0]);
    };

    return (
      <Typography variant="body1">
        {runId > 1 ? `${name} (${getOrdinal(runId)} run)` : name}
      </Typography>
    );
  },
}