SELECT
    prs.PROCESS_RUN_STAGE_ID            AS ID,
    pr.PROCESS_ID,
    pm.PROCESS_NAME                     AS PROCESS_TYPE,
    prs.STAGE_ID                        AS PROCESS_STAGE,
    prs.EVENT_TIME                      AS START_TIME,
    pr.END_TIME,
    prs.STATUS,
    prs.REMARKS                         AS EXECUTION_REMARKS,
    pr.TRIGGERED_BY,
    pr.ETL_DATE,
    prs.SUMMARY                         AS DIFFERENCE_SUMMARY,
    pr.AIRFLOW_RUN_ID,
    pm.PROCESS_DAG_ID                   AS DAG_ID,
    psm.TITLE                           AS STAGE_TITLE,
    psm.ICON                            AS STAGE_ICON
FROM FINCORE.PROCESS_RUN_STAGE prs
JOIN FINCORE.PROCESS_RUN pr
      ON pr.PROCESS_RUN_ID = prs.PROCESS_RUN_ID
JOIN FINCORE.PROCESS_MASTER pm
      ON pm.PROCESS_ID = pr.PROCESS_ID
LEFT JOIN FINCORE.PROCESS_STAGE_MASTER psm
      ON psm.STAGE_ID = prs.STAGE_ID
WHERE pr.ETL_DATE = :P_ETL_DATE
ORDER BY
    pr.ETL_DATE DESC,
    pr.PROCESS_ID,
    prs.EVENT_TIME;