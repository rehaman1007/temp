import { useEffect, useState, useCallback } from "react";
import {
  Box,
  Button,
  Stack,
  Typography,
  Paper,
  Autocomplete,
  TextField,
  Grid,
  Radio,
  RadioGroup,
  FormControlLabel,
} from "@mui/material";
import SearchIcon from "@mui/icons-material/Search";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import dayjs from "dayjs";
import { useSelector } from "react-redux";
import useApi from "../../hooks/useApi";
import { getPermissions } from "../../utils/CommonUtilities";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const AsciiReport = ({ isNumeric }) => {
  const { callApi } = useApi();
  // 1. Set default date to 30-03-2026
  const [reportDate, setReportDate] = useState(dayjs("2026-03-30"));
  const [asciiId, setAsciiId] = useState("");
  const [searchBy, setSearchBy] = useState("bank");
  const [branchInput, setBranchInput] = useState("");
  const [selectedBranchCode, setSelectedBranchCode] = useState("");

  const [asciiOptions, setAsciiOptions] = useState([]);
  const [branchOptions, setBranchOptions] = useState([]);

  const [plainTextData, setPlainTextData] = useState("");
  const [loading, setLoading] = useState(false);
  const [fieldloading, setFieldLoading] = useState({
    ascii: false,
    branch: false,
  });
  const [error, setError] = useState("");

  const user = useSelector((state) => state.auth.user);
  const selectedMenu = useSelector((state) => state.menus.selectedMenuItem);
  const permissions = getPermissions(selectedMenu);
  const showSnackBar = useCustomSnackbar();

  useEffect(() => {
    let isMounted = true;
    const fetchInitialData = async () => {
      try {
        const fileTypesRes = await callApi("/RS/ascii/file-types", null, "GET");
        if (isMounted && fileTypesRes && Array.isArray(fileTypesRes.data)) {
          setAsciiOptions(fileTypesRes.data);
          
          // 2. Set the first ASCII option as default
          if (fileTypesRes.data.length > 0) {
            setAsciiId(String(fileTypesRes.data[0].id));
          }
        } else if (isMounted) {
          setAsciiOptions([]);
        }
      } catch (err) {
        console.error("Error loading data", err);
      }
    };
    fetchInitialData();

    return () => {
      isMounted = false;
    };
  }, [callApi]);

  const fetchSearchData = useCallback(
    async (type, term) => {
      try {
        setFieldLoading((prev) => ({ ...prev, [type]: true }));

        let circleValue = "";
        if (user?.isCircle === "Y" || permissions?.circle) {
          circleValue = user?.circleCode;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
                term
              )}&circleCode=${circleValue || ""}`
            : "";

        if (!url) return;

        const result = await callApi(url, null, "GET");

        if (result?.data?.length > 0) {
          if (type === "branch") {
            const normalized = result.data.map((b) => ({
              branchCode: b.code,
              branchName: b.name,
            }));
            setBranchOptions(normalized);
          }
        } else {
          if (type === "branch") setBranchOptions([]);
          showSnackBar("Data is not available");
        }
      } catch (e) {
        console.error(e);
      } finally {
        setFieldLoading((prev) => ({ ...prev, [type]: false }));
      }
    },
    [callApi, user, permissions, showSnackBar]
  );

  const handleSearchChange = (value, reason, type) => {
    setFieldLoading((prev) => ({ ...prev, [type]: true }));
    if (reason === "input") {
      if (value && value?.length >= 3) {
        fetchSearchData(type, value);
      }
    } else if (reason === "clear") {
      if (type === "branch") {
        setBranchOptions([]);
        setSelectedBranchCode("");
      } else {
        setAsciiId("");
      }
      showSnackBar("Data is not available");
    }
    setFieldLoading((prev) => ({ ...prev, [type]: false }));
  };

  const buildPayload = () => {
    const basePayload = {
      id: Number(asciiId),
      reportDate: reportDate ? reportDate.format("DD-MM-YYYY") : "",
      searchBy: searchBy,
    };
    if (searchBy === "branch") {
      basePayload.branchCode = selectedBranchCode || branchInput;
    }
    return basePayload;
  };

  const handleSearchFetch = async (e) => {
    e.preventDefault();
    
    if (!reportDate || !asciiId) {
      showSnackBar("Please select both Date and ASCII report type.", "error");
      return;
    }
    
    if (searchBy === "branch" && !branchInput) {
      showSnackBar("Please select or enter branch code.", "error");
      return;
    }

    try {
      setLoading(true);
      setError("");
      setPlainTextData("");

      const payload = buildPayload();
      const response = await callApi("/RS/ascii/view", payload, "POST");

      if (response?.data?.content || response?.content) {
        setPlainTextData(response.data?.content || response.content);
        showSnackBar("Report Fetched Successfully", "success");
      } else {
        showSnackBar("Report content is empty or invalid.", "error");
      }
    } catch (err) {
      showSnackBar("ASCII file not found", "error");
    } finally {
      setLoading(false);
    }
  };

  const handleDownload = async () => {
    try {
      setLoading(true);
      const payload = buildPayload();
      
      const response = await callApi(
        "/RS/ascii/download",
        payload,
        "POST",
        "text",
        "application/json",
        { responseType: "text" },
        false
      );

      const contentDisposition = response?.headers?.["content-disposition"];
      const actualData = response.data;
      let fileName = "";

      if (contentDisposition) {
        const match = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
        if (match) {
          fileName = match[1].replace(/['"\\]/g, "").trim();
        }
      }

      if (!fileName) {
        const formattedDate = reportDate ? reportDate.format("YYYYMMDD") : "data";
        fileName = `${asciiId || "data"}.${formattedDate}.txt`;
      }

      const blob = new Blob([actualData], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
      showSnackBar("File Download Successfully", "success");
    } catch (err) {
      showSnackBar("ASCII file not found", "error");
    } finally {
      setLoading(false);
    }
  };

  const handleBranchChange = (e) => {
    const val = e.target.value;
    setBranchInput(val);

    const matchedBranch = branchOptions.find(
      (b) => b.branchCode === val || `${b.branchCode} - ${b.branchName}` === val
    );
    
    if (matchedBranch) setSelectedBranchCode(matchedBranch.branchCode);
  };

  const handleReset = () => {
    setPlainTextData("");
    setError("");
    setAsciiId("");
    // 3. Reset to our default date as well
    setReportDate(dayjs("2026-03-30"));
    setBranchInput("");
    setSelectedBranchCode("");
    setSearchBy("bank");
    
    if (asciiOptions.length > 0) {
      setAsciiId(String(asciiOptions[0].id));
    }
  };

  return (
    <Box>
      <Paper
        sx={{
          padding: "2%",
          mb: 3,
          bgcolor: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(4px)",
          border: "1px solid",
          borderColor: "divider",
          borderRadius: 1,
        }}
      >
        <Box
          sx={{
            mb: 3,
            p: 2,
            borderRadius: 2,
            bgcolor: "background.paper",
            boxShadow: 2,
            borderLeft: "6px solid",
            borderColor: "primary.main",
          }}
        >
          <Box>
            <Typography variant="h6" fontWeight={700} lineHeight={1.2}>
              Search ASCII Report
            </Typography>
            <Typography variant="body2" color="text.secondary" sx={{ mt: 0.5 }}>
              Enter the required details below to retrieve and view ASCII report records.
            </Typography>
          </Box>
        </Box>
        
        {/* Changed HTML form to Box with form styling */}
        <Box component="form" onSubmit={handleSearchFetch}>
          <Grid container spacing={3} alignItems="flex-start">
            
            {/* Date Field */}
            <Grid item xs={12} md={3}>
              <Typography variant="body2" mb={1}>Date</Typography>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <DatePicker
                  value={reportDate}
                  onChange={(newValue) => setReportDate(newValue)}
                  format="DD-MM-YYYY"
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      sx: {
                        "& .MuiInputBase-input": { caretColor: "transparent" },
                      },
                    },
                  }}
                />
              </LocalizationProvider>
            </Grid>

            {/* ASCII Selection Field */}
            <Grid item xs={12} md={3}>
              <Typography variant="body2" mb={1}>Name of ASCII</Typography>
              <Autocomplete
                options={asciiOptions || []}
                getOptionLabel={(option) =>
                  option ? `${option.id || ""} ${option.asciiName || ""}` : ""
                }
                value={
                  asciiOptions.find((o) => String(o.id) === String(asciiId)) || null
                }
                onChange={(event, newValue) => {
                  setAsciiId(newValue ? String(newValue.id) : "");
                }}
                onInputChange={(event, newInputValue, reason) => {
                  handleSearchChange(newInputValue, reason, "ascii");
                }}
                renderInput={(params) => (
                  <TextField {...params} placeholder="Please select ASCII" />
                )}
              />
            </Grid>

            {/* Search By Radios & Branch selection */}
            <Grid item xs={12} md={4}>
              <Typography variant="body2" mb={1}>Search By</Typography>
              <Box display="flex" gap={2} alignItems="center" flexWrap="wrap">
                
                {/* MUI Native Radios */}
                <RadioGroup
                  row
                  value={searchBy}
                  onChange={(e) => setSearchBy(e.target.value)}
                >
                  <FormControlLabel value="bank" control={<Radio />} label="Bank" />
                  <FormControlLabel
                    value="branch"
                    control={<Radio />}
                    label="Branch"
                    disabled={!!plainTextData}
                  />
                </RadioGroup>

                {searchBy === "branch" && (
                  <Autocomplete
                    sx={{ width: 220 }}
                    options={branchOptions || []}
                    getOptionLabel={(option) =>
                      option ? `${option.branchName || ""} - ${option.branchCode || ""}` : ""
                    }
                    value={
                      branchOptions.find((b) => b.branchCode === selectedBranchCode) || null
                    }
                    disabled={
                      !permissions?.wholebank &&
                      (user?.isCircle === "N" || permissions?.branch)
                    }
                    onInputChange={(e, newInputValue, reason) => {
                      setBranchInput(newInputValue);
                      handleSearchChange(newInputValue, reason, "branch");
                    }}
                    onChange={(e, selectedOption) => {
                      if (selectedOption) {
                        setSelectedBranchCode(selectedOption.branchCode);
                        setBranchInput(selectedOption.branchName);
                      } else {
                        setSelectedBranchCode("");
                        setBranchInput("");
                      }
                    }}
                    renderInput={(params) => (
                      <TextField
                        {...params}
                        placeholder="Search branch..."
                        required
                        onChange={handleBranchChange}
                        slotProps={{
                          htmlInput: {
                            ...params.inputProps,
                            maxLength: isNumeric ? 5 : 15,
                          },
                        }}
                      />
                    )}
                  />
                )}
              </Box>
            </Grid>

            {/* Action Buttons */}
            <Grid item xs={12} md={2} display="flex" justifyContent="flex-end" sx={{ mt: 3 }}>
              <Stack direction="row" spacing={2}>
                <Button
                  type="submit"
                  variant="contained"
                  disabled={loading}
                >
                  {loading ? "Fetching..." : "Search"}
                </Button>
                <Button
                  variant="outlined"
                  onClick={handleReset}
                  disabled={loading}
                >
                  Reset
                </Button>
              </Stack>
            </Grid>

          </Grid>
        </Box>
      </Paper>

      {/* Results View */}
      <Paper
        sx={{
          p: "1% 2%",
          mb: 2,
          bgcolor: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(4px)",
          border: "1px solid",
          borderColor: "divider",
          borderRadius: 1,
        }}
      >
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            mb: 2,
            pb: 1,
            borderBottom: "1px solid",
            borderColor: "divider",
          }}
        >
          <Typography variant="h6" fontWeight={700} lineHeight={1.2}>
            View ASCII Report data
          </Typography>
          {plainTextData && (
            <Button
              onClick={handleDownload}
              variant="contained"
            >
              Download ASCII Report
            </Button>
          )}
        </Box>

        <Box
          sx={{
            height: "40vh",
            overflow: "auto",
            mt: 2,
            display: "flex",
            flexDirection: "column",
            justifyContent: plainTextData ? "flex-start" : "center",
            alignItems: plainTextData ? "flex-start" : "center",
          }}
        >
          {plainTextData ? (
            <Box component="pre" sx={{ whiteSpace: "pre-wrap", wordBreak: "break-all" }}>
              {plainTextData}
            </Box>
          ) : (
            <Stack alignItems="center" spacing={2} color="text.secondary">
              <SearchIcon sx={{ fontSize: "3rem" }} />
              <Typography variant="body1" textAlign="center">
                {loading
                  ? "Retrieving report content..."
                  : "No data fetched yet. Fill the form parameters and click search."}
              </Typography>
            </Stack>
          )}
        </Box>
      </Paper>
    </Box>
  );
};

export default AsciiReport;
