        private void createReportHeader(
                        Workbook workbook,
                        Sheet sheet,
                        String title,
                        LedgerWiseBalanceRequest dto,
                        String[] columns,
                        int lastColumn) {

                Font titleFont = workbook.createFont();
                titleFont.setBold(true);
                titleFont.setFontHeightInPoints((short) 14);

                CellStyle titleStyle = workbook.createCellStyle();
                titleStyle.setFont(titleFont);

                titleStyle.setAlignment(HorizontalAlignment.CENTER);

                Font metaFont = workbook.createFont();
                metaFont.setBold(true);

                CellStyle metaStyle = workbook.createCellStyle();
                metaStyle.setFont(metaFont);
                metaStyle.setAlignment(HorizontalAlignment.CENTER);

                Font headerFont = workbook.createFont();
                headerFont.setBold(true);

                CellStyle headerStyle = workbook.createCellStyle();
                headerStyle.setFont(headerFont);

                Row titleRow = sheet.createRow(0);

                Cell titleCell = titleRow.createCell(0);
                titleCell.setCellValue(title);
                titleCell.setCellStyle(titleStyle);

                Row metaRow = sheet.createRow(1);

                Cell metaCell = metaRow.createCell(0);

                metaCell.setCellValue(
                                "Circle : " + dto.getCircle()
                                                + " | CGL : " + String.join(", ", dto.getCgls())
                                                + " | Currency : " + String.join(", ", dto.getCurrencies())
                                                + " | Date : " + dto.getBalanceDate());

                metaCell.setCellStyle(metaStyle);

                titleStyle.setVerticalAlignment(VerticalAlignment.CENTER);
                metaStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                sheet.addMergedRegion(
                                new CellRangeAddress(
                                                0,
                                                0,
                                                0,
                                                lastColumn));

                titleRow.setHeightInPoints(24);

                sheet.addMergedRegion(
                                new CellRangeAddress(
                                                1,
                                                1,
                                                0,
                                                lastColumn));

                metaRow.setHeightInPoints(20);
                sheet.createRow(2);

                Row header = sheet.createRow(3);

                for (int i = 0; i < columns.length; i++) {

                        Cell cell = header.createCell(i);

                        cell.setCellValue(columns[i]);

                        cell.setCellStyle(headerStyle);
                }
        }

