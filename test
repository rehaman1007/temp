package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;

import java.io.BufferedReader;
import java.nio.file.Files;
import java.nio.file.Path;

import java.sql.Connection;
import java.sql.Statement;

import java.util.Map;
import java.util.HashMap;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    /**
     * BATCH CONFIG
     */
    private static final int BATCH_SIZE = 1000;

    /**
     * JOB STATUS STORE
     */
    private final Map<String, Map<String, Object>> jobStatusMap =
            new ConcurrentHashMap<>();

    @Autowired
    private DataSource dataSource;

    /**
     * EXECUTE HUGE SQL SCRIPT
     */
    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path path,
            String jobId
    ) {

        long startTime = System.currentTimeMillis();

        Connection connection = null;

        BufferedReader reader = null;

        Statement statement = null;

        int totalStatements = 0;

        /**
         * PRE COUNT STATEMENTS
         */
        try (BufferedReader counter =
                     Files.newBufferedReader(path)) {

            String line;

            while ((line = counter.readLine()) != null) {

                String trimmed = line.trim();

                if (
                        trimmed.isBlank()
                                || trimmed.startsWith("--")
                ) {
                    continue;
                }

                if (trimmed.endsWith(";")) {
                    totalStatements++;
                }
            }

        } catch (Exception e) {

            log.error(
                    "Failed to count statements",
                    e
            );
        }

        /**
         * INITIAL STATUS
         */
        updateJobStatus(
                jobId,
                "RUNNING",
                0,
                totalStatements,
                totalStatements,
                0,
                startTime,
                "",
                0,
                ""
        );

        log.info(
                "SQL Execution Started | JobId={} | Total Statements={}",
                jobId,
                totalStatements
        );

        try {

            connection = dataSource.getConnection();

            connection.setAutoCommit(false);

            statement = connection.createStatement();

            reader = Files.newBufferedReader(path);

            StringBuilder sqlBuilder =
                    new StringBuilder();

            String line;

            int executedCount = 0;

            int batchCounter = 0;

            while ((line = reader.readLine()) != null) {

                String trimmed = line.trim();

                /**
                 * SKIP COMMENTS
                 */
                if (
                        trimmed.isBlank()
                                || trimmed.startsWith("--")
                ) {
                    continue;
                }

                sqlBuilder.append(line)
                        .append("\n");

                /**
                 * SQL COMPLETED
                 */
                if (trimmed.endsWith(";")) {

                    String sql =
                            sqlBuilder.toString().trim();

                    sql =
                            sql.substring(
                                    0,
                                    sql.length() - 1
                            );

                    validateDangerousSql(sql);

                    String upper =
                            sql.trim().toUpperCase();

                    /**
                     * BATCHABLE
                     */
                    if (
                            upper.startsWith("INSERT")
                                    || upper.startsWith("UPDATE")
                                    || upper.startsWith("DELETE")
                    ) {

                        statement.addBatch(sql);

                        batchCounter++;

                    } else {

                        /**
                         * FLUSH EXISTING BATCH
                         */
                        if (batchCounter > 0) {

                            statement.executeBatch();

                            connection.commit();

                            batchCounter = 0;
                        }

                        statement.execute(sql);

                        connection.commit();
                    }

                    executedCount++;

                    sqlBuilder.setLength(0);

                    /**
                     * EXECUTE BATCH
                     */
                    if (batchCounter >= BATCH_SIZE) {

                        statement.executeBatch();

                        connection.commit();

                        batchCounter = 0;

                        /**
                         * ETA CALCULATION
                         */
                        long elapsedMs =
                                System.currentTimeMillis()
                                        - startTime;

                        double avgPerStatement =
                                executedCount == 0
                                        ? 0
                                        : (double) elapsedMs
                                        / executedCount;

                        int remaining =
                                totalStatements
                                        - executedCount;

                        long etaSeconds =
                                avgPerStatement <= 0
                                        ? 0
                                        : (long) (
                                        (remaining
                                                * avgPerStatement)
                                                / 1000
                                );

                        long speed =
                                elapsedMs > 0
                                        ? (executedCount
                                        * 1000L)
                                        / elapsedMs
                                        : 0;

                        updateJobStatus(
                                jobId,
                                "RUNNING",
                                executedCount,
                                totalStatements,
                                remaining,
                                etaSeconds,
                                startTime,
                                "",
                                0,
                                ""
                        );

                        /**
                         * EXTRA INFO
                         */
                        jobStatusMap.get(jobId)
                                .put(
                                        "elapsedSeconds",
                                        elapsedMs / 1000
                                );

                        jobStatusMap.get(jobId)
                                .put(
                                        "executionSpeedPerSecond",
                                        speed
                                );

                        jobStatusMap.get(jobId)
                                .put(
                                        "batchSize",
                                        BATCH_SIZE
                                );

                        log.info(
                                """
                                Batch Executed
                                JobId={}
                                Executed={}
                                Remaining={}
                                ETA={} sec
                                Speed={}/sec
                                """,
                                jobId,
                                executedCount,
                                remaining,
                                etaSeconds,
                                speed
                        );
                    }
                }
            }

            /**
             * FINAL FLUSH
             */
            if (batchCounter > 0) {

                statement.executeBatch();

                connection.commit();
            }

            long totalTime =
                    (System.currentTimeMillis()
                            - startTime)
                            / 1000;

            Map<String, Object> completed =
                    new ConcurrentHashMap<>();

            completed.put("status", "COMPLETED");

            completed.put(
                    "executedCount",
                    executedCount
            );

            completed.put(
                    "totalStatements",
                    totalStatements
            );

            completed.put(
                    "remainingStatements",
                    0
            );

            completed.put(
                    "estimatedRemainingSeconds",
                    0
            );

            completed.put(
                    "elapsedSeconds",
                    totalTime
            );

            completed.put(
                    "executionSpeedPerSecond",
                    totalTime > 0
                            ? executedCount / totalTime
                            : executedCount
            );

            completed.put(
                    "startedAt",
                    startTime
            );

            completed.put(
                    "completedAt",
                    System.currentTimeMillis()
            );

            completed.put(
                    "message",
                    "Execution completed successfully"
            );

            completed.put(
                    "batchSize",
                    BATCH_SIZE
            );

            jobStatusMap.put(
                    jobId,
                    completed
            );

            log.info(
                    """
                    SQL EXECUTION COMPLETED
                    JobId={}
                    Total Statements={}
                    Total Time={} sec
                    Avg Speed={}/sec
                    """,
                    jobId,
                    executedCount,
                    totalTime,
                    totalTime > 0
                            ? executedCount / totalTime
                            : executedCount
            );

        } catch (Exception e) {

            log.error(
                    "SQL EXECUTION FAILED | JobId={}",
                    jobId,
                    e
            );

            try {

                if (connection != null) {

                    connection.rollback();

                    log.error(
                            "Rollback completed"
                    );
                }

            } catch (Exception rollbackEx) {

                log.error(
                        "Rollback failed",
                        rollbackEx
                );
            }

            Map<String, Object> failed =
                    new ConcurrentHashMap<>();

            failed.put("status", "FAILED");

            failed.put(
                    "message",
                    e.getMessage()
            );

            failed.put(
                    "failedSql",
                    extractSqlError(e)
            );

            failed.put(
                    "failedAt",
                    System.currentTimeMillis()
            );

            failed.put(
                    "elapsedSeconds",
                    (
                            System.currentTimeMillis()
                                    - startTime
                    ) / 1000
            );

            jobStatusMap.put(
                    jobId,
                    failed
            );

        } finally {

            try {

                if (reader != null) {
                    reader.close();
                }

                if (statement != null) {
                    statement.close();
                }

                if (connection != null) {
                    connection.close();
                }

            } catch (Exception e) {

                log.error(
                        "Cleanup failed",
                        e
                );
            }
        }
    }

    /**
     * STATUS UPDATE
     */
    private void updateJobStatus(
            String jobId,
            String status,
            int executed,
            int total,
            int remaining,
            long eta,
            long startTime,
            String failedSql,
            int failedLine,
            String message
    ) {

        Map<String, Object> map =
                new ConcurrentHashMap<>();

        map.put("status", status);

        map.put("executedCount", executed);

        map.put("totalStatements", total);

        map.put(
                "remainingStatements",
                remaining
        );

        map.put(
                "estimatedRemainingSeconds",
                eta
        );

        map.put(
                "startedAt",
                startTime
        );

        map.put(
                "elapsedSeconds",
                (
                        System.currentTimeMillis()
                                - startTime
                ) / 1000
        );

        map.put("failedSql", failedSql);

        map.put(
                "failedStatementNumber",
                failedLine
        );

        map.put("message", message);

        jobStatusMap.put(jobId, map);
    }

    /**
     * BLOCK DANGEROUS SQL
     */
    private void validateDangerousSql(
            String sql
    ) {

        String upper =
                sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        || upper.contains("ALTER SYSTEM")
                        || upper.contains("SHUTDOWN")
                        || upper.contains("CREATE USER")
                        || upper.contains("DROP USER")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL Blocked"
            );
        }
    }

    /**
     * EXTRACT FAILED SQL
     */
    private String extractSqlError(
            Exception e
    ) {

        try {

            String msg = e.getMessage();

            if (msg == null) {
                return "";
            }

            return msg.length() > 2000
                    ? msg.substring(0, 2000)
                    : msg;

        } catch (Exception ex) {

            return "";
        }
    }

    /**
     * GET JOB STATUS
     */
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStatusMap.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }
}