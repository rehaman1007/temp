/*==========================================================
  9) UI TIMELINE QUERY
==========================================================*/

SELECT
 r.RUN_ID,
 pm.PROCESS_TYPE,
 d.DAG_NAME,
 sm.STAGE_ID,
 sm.TITLE,
 sm.ICON,
 s.STATUS,
 s.START_TIME,
 s.END_TIME,
 s.EXECUTION_REMARKS
FROM FINCORE.PROCESS_RUN r
JOIN FINCORE.PROCESS_MASTER pm ON pm.PROCESS_ID=r.PROCESS_ID
JOIN FINCORE.PROCESS_DAG_MASTER d ON d.DAG_ID=pm.DAG_ID
JOIN FINCORE.PROCESS_RUN_STAGE s ON s.RUN_ID=r.RUN_ID
JOIN FINCORE.PROCESS_STAGE_MASTER sm ON sm.STAGE_ID=s.STAGE_ID
WHERE r.RUN_ID=1
ORDER BY sm.STAGE_ID;

/*==========================================================
  10) DASHBOARD SUMMARY
==========================================================*/

SELECT
 pm.PROCESS_TYPE,
 d.DAG_NAME,
 SUM(CASE WHEN r.STATUS=1 THEN 1 ELSE 0 END) RUNNING,
 SUM(CASE WHEN r.STATUS=2 THEN 1 ELSE 0 END) SUCCESS,
 SUM(CASE WHEN r.STATUS=3 THEN 1 ELSE 0 END) FAILED
FROM FINCORE.PROCESS_RUN r
JOIN FINCORE.PROCESS_MASTER pm ON pm.PROCESS_ID=r.PROCESS_ID
JOIN FINCORE.PROCESS_DAG_MASTER d ON d.DAG_ID=pm.DAG_ID
GROUP BY pm.PROCESS_TYPE, d.DAG_NAME;