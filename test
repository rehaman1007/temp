import React, { useCallback, useMemo, useState, memo } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  Tooltip,
  Stack,
  Chip,
  Collapse,
} from "@mui/material";

import {
  Close,
  DoneAll,
  NotificationsNone,
  ExpandMore,
  ExpandLess,
} from "@mui/icons-material";

import ListAltIcon from "@mui/icons-material/ListAlt";
import MarkEmailUnreadIcon from "@mui/icons-material/MarkEmailUnread";
import MarkEmailReadIcon from "@mui/icons-material/MarkEmailRead";

import { motion, AnimatePresence } from "framer-motion";

import { formatRelativeTime } from "../utils/CommonUtilities";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { styles } from "./NotificationStyles";
import { getIconComponent } from "../utils/IconUtils";

const MotionPaper = motion.create(Paper);

/** * OPTIMIZATION: Extracted to a memoized component.
 * This prevents the entire list from re-rendering when you expand a single item.
 */
const NotificationItem = memo(
  ({ n, isExpanded, menuItems, onMessageClick, onToggleExpand }) => {
    const isRead = n?.read || false;
    const menu = menuItems.find((m) => m.route === n.linkUrl);
    const menuTitle = menu?.title || "General";
    const IconComponent = getIconComponent(menu?.icon || "NotificationsNone");

    return (
      <MotionPaper
        layout
        whileInView={{ opacity: [0, 1], y: [200, 0] }}
        viewport={{ once: false, amount: 0.3 }}
        transition={{ duration: 0.2 }}
        sx={{
          ...styles.notificationPaper(isRead),
          borderRadius: 1,
          border: "none",
          p: 1,
        }}
      >
        <Stack direction="row" spacing={2}>
          <IconComponent sx={{ fontSize: 24, opacity: 0.8 }} />

          <Box sx={{ flex: 1 }}>
            {isExpanded && (
              <Box>
                <Typography
                  variant="subtitle2"
                  onClick={() => onMessageClick(n)}
                  sx={{ fontWeight: 600, cursor: "pointer", mb: 0.5 }}
                >
                  {menuTitle}
                </Typography>
              </Box>
            )}

            {!isExpanded && (
              <Box onClick={() => onMessageClick(n)} sx={{ cursor: "pointer" }}>
                <Typography
                  component="div"
                  variant="body1"
                  sx={{ mb: 1, color: "text.primary" }}
                >
                  {n.message.length > 50
                    ? n.message.substring(0, 50) + "..."
                    : n.message}
                </Typography>

                <Typography variant="body2" sx={{ color: "text.secondary" }}>
                  {menuTitle}
                  <Typography
                    variant="caption"
                    component="span"
                    sx={{ ml: 2, color: "text.secondary", float: "right" }}
                  >
                    {formatRelativeTime(n.createdAt)}
                  </Typography>
                </Typography>
              </Box>
            )}

            <Collapse in={isExpanded}>
              <Typography variant="body2">{n.message}</Typography>
              <Typography variant="caption" color="text.primary">
                {formatRelativeTime(n.createdAt)}
              </Typography>
            </Collapse>
          </Box>

          <IconButton
            sx={{
              background: "none",
              "&:hover": { backgroundColor: "transparent" },
            }}
            onClick={() => onToggleExpand(n)}
          >
            {isExpanded ? <ExpandLess /> : <ExpandMore />}
          </IconButton>
        </Stack>
      </MotionPaper>
    );
  },
);

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
  markAsRead,
  markAllAsRead,
  loadMore,
  hasMore,
}) => {
  const { navigateToPage } = useNavigateToPage();
  const menuItems = useSelector((state) => state.menus.menus);

  const [filter, setFilter] = useState("all");
  const [expandedId, setExpandedId] = useState(null);

  const sorted = useMemo(() => {
    return [...notifications].sort(
      (a, b) => new Date(b.createdAt) - new Date(a.createdAt),
    );
  }, [notifications]);

  const filteredList = useMemo(() => {
    if (filter === "read") return sorted.filter((n) => n.read);
    if (filter === "unread") return sorted.filter((n) => !n.read);
    return sorted;
  }, [filter, sorted]);

  const handleMessageClick = useCallback(
    (row) => {
      markAsRead(row.id);
      const menu = menuItems.find((m) => m.route === row.linkUrl);
      if (menu) {
        navigateToPage(menu);
        setNotificationDrawerOpen(false);
      }
    },
    [markAsRead, menuItems, navigateToPage, setNotificationDrawerOpen],
  );

  const handleToggleExpand = useCallback(
    (row) => {
      setExpandedId((prev) => (prev === row.id ? null : row.id));
      markAsRead(row.id);
    },
    [markAsRead],
  );

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          p: 3,
          borderBottom: "1px solid #E2E8F0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography variant="h6" sx={{ fontWeight: 700 }}>
          Notifications
        </Typography>
        <Stack direction="row" spacing={1}>
          <Tooltip title="Mark all as read">
            <IconButton size="small" onClick={markAllAsRead}>
              <DoneAll color="text.primary" />
            </IconButton>
          </Tooltip>
          <IconButton
            size="small"
            onClick={() => setNotificationDrawerOpen(false)}
          >
            <Close />
          </IconButton>
        </Stack>
      </Box>

      {/* FILTER CHIPS */}
      <Box sx={{ display: "flex", gap: 2, m: 2 }}>
        <Chip
          label="All"
          icon={<ListAltIcon />}
          variant={filter === "all" ? "filled" : "outlined"}
          onClick={() => setFilter("all")}
          sx={{ flex: 1 }}
        />
        <Chip
          label="Unread"
          icon={<MarkEmailUnreadIcon />}
          color="text.primary"
          variant={filter === "unread" ? "filled" : "outlined"}
          onClick={() => setFilter("unread")}
          sx={{ flex: 1 }}
        />
        <Chip
          label="Read"
          icon={<MarkEmailReadIcon />}
          color="success"
          variant={filter === "read" ? "filled" : "outlined"}
          onClick={() => setFilter("read")}
          sx={{ flex: 1 }}
        />
      </Box>

      {/* EMPTY */}
      {filteredList.length === 0 && (
        <Box sx={{ textAlign: "center", mt: 4, opacity: 0.6 }}>
          <NotificationsNone sx={{ fontSize: 50 }} />
          <Typography>No notifications yet</Typography>
        </Box>
      )}

      {/* LIST */}
      <Box sx={{ flex: 1, overflowY: "auto" }}>
        <AnimatePresence initial={false}>
          {filteredList.map((n) => (
            <NotificationItem
              key={n.id}
              n={n}
              isExpanded={expandedId === n.id}
              menuItems={menuItems}
              onMessageClick={handleMessageClick}
              onToggleExpand={handleToggleExpand}
            />
          ))}
        </AnimatePresence>
      </Box>

      {/* FOOTER */}
      {filteredList.length > 0 && (
        <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
          {hasMore ? (
            <Button
              color="primary"
              fullWidth
              variant="contained"
              onClick={loadMore}
            >
              Show More
            </Button>
          ) : (
            <Typography
              variant="body2"
              color="text.secondary"
              align="center"
              sx={{ py: 1 }}
            >
              No more notifications
            </Typography>
          )}
        </Box>
      )}
    </Drawer>
  );
};

export default NotificationDrawer;
