package com.fincore.transactions_service.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

@Configuration
@EnableAsync
@Slf4j
public class AsyncConfig {

    @Bean(name = "sqlTaskExecutor")
    public Executor sqlTaskExecutor() {

        log.info("""
                
                ==================================================
                INITIALIZING SQL TASK EXECUTOR
                ==================================================
                corePoolSize=5
                maxPoolSize=10
                queueCapacity=500
                ==================================================
                """);

        ThreadPoolTaskExecutor executor =
                new ThreadPoolTaskExecutor();

        executor.setCorePoolSize(5);

        executor.setMaxPoolSize(10);

        executor.setQueueCapacity(500);

        executor.setThreadNamePrefix("SQL-EXECUTOR-");

        executor.initialize();

        return executor;
    }
}


package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportExecutor {

    private final JdbcTemplate jdbcTemplate;

    /**
     * LIVE JOB STATUS CACHE
     */
    public static final Map<String, Map<String, Object>> JOB_STATUS =
            new ConcurrentHashMap<>();

    /**
     * BATCH COMMIT SIZE
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * ASYNC SQL EXECUTION
     */
    @Async("sqlTaskExecutor")
    public void executeScriptAsync(
            File sqlFile,
            String jobId,
            String userId,
            String clientIp
    ) {

        Instant start = Instant.now();

        long startedAt = System.currentTimeMillis();

        int totalStatements = 0;

        int executedCount = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int otherCount = 0;

        String failedSql = null;

        int failedLine = 0;

        try {

            log.info("""

                    ==================================================
                    SQL SCRIPT EXECUTION STARTED
                    ==================================================
                    jobId={}
                    userId={}
                    clientIp={}
                    file={}
                    batchCommitSize={}
                    ==================================================
                    """,
                    jobId,
                    userId,
                    clientIp,
                    sqlFile.getAbsolutePath(),
                    COMMIT_BATCH_SIZE
            );

            /**
             * INIT STATUS
             */
            Map<String, Object> status = new ConcurrentHashMap<>();

            status.put("jobId", jobId);
            status.put("status", "RUNNING");
            status.put("progress", 0);
            status.put("executedCount", 0);
            status.put("insertCount", 0);
            status.put("updateCount", 0);
            status.put("deleteCount", 0);
            status.put("otherCount", 0);
            status.put("message", "Execution started");
            status.put("startedAt", startedAt);

            JOB_STATUS.put(jobId, status);

            /**
             * COUNT TOTAL STATEMENTS
             */
            try (
                    BufferedReader counterReader =
                            new BufferedReader(new FileReader(sqlFile))
            ) {

                String line;

                while ((line = counterReader.readLine()) != null) {

                    line = line.trim();

                    if (!line.isEmpty()
                            && !line.startsWith("--")
                            && line.endsWith(";")) {

                        totalStatements++;
                    }
                }
            }

            JOB_STATUS.get(jobId)
                    .put("totalStatements", totalStatements);

            log.info("""

                    ==================================================
                    SQL STATEMENT COUNT COMPLETED
                    ==================================================
                    jobId={}
                    totalStatements={}
                    ==================================================
                    """,
                    jobId,
                    totalStatements
            );

            /**
             * EXECUTION
             */
            try (
                    Connection connection =
                            jdbcTemplate.getDataSource().getConnection();

                    BufferedReader reader =
                            new BufferedReader(new FileReader(sqlFile))
            ) {

                connection.setAutoCommit(false);

                Statement statement = connection.createStatement();

                StringBuilder sqlBuilder = new StringBuilder();

                String line;

                int lineNumber = 0;

                while ((line = reader.readLine()) != null) {

                    lineNumber++;

                    line = line.trim();

                    /**
                     * SKIP COMMENTS
                     */
                    if (line.isEmpty()
                            || line.startsWith("--")) {

                        continue;
                    }

                    sqlBuilder.append(line).append(" ");

                    /**
                     * STATEMENT END
                     */
                    if (line.endsWith(";")) {

                        String sql =
                                sqlBuilder.toString()
                                        .replaceAll(";$", "")
                                        .trim();

                        sqlBuilder.setLength(0);

                        failedSql = sql;

                        failedLine = lineNumber;

                        long queryStart = System.currentTimeMillis();

                        statement.execute(sql);

                        long queryEnd = System.currentTimeMillis();

                        executedCount++;

                        /**
                         * TYPE COUNTS
                         */
                        String upperSql = sql.toUpperCase();

                        if (upperSql.startsWith("INSERT")) {

                            insertCount++;

                        } else if (upperSql.startsWith("UPDATE")) {

                            updateCount++;

                        } else if (upperSql.startsWith("DELETE")) {

                            deleteCount++;

                        } else {

                            otherCount++;
                        }

                        /**
                         * COMMIT
                         */
                        if (executedCount % COMMIT_BATCH_SIZE == 0) {

                            connection.commit();

                            log.info("""

                                    ==================================================
                                    BATCH COMMIT SUCCESS
                                    ==================================================
                                    jobId={}
                                    executedCount={}
                                    elapsed={} sec
                                    ==================================================
                                    """,
                                    jobId,
                                    executedCount,
                                    Duration.between(start, Instant.now()).toSeconds()
                            );
                        }

                        /**
                         * ETA
                         */
                        long elapsedSeconds =
                                Duration.between(start, Instant.now())
                                        .toSeconds();

                        long avgPerStatement =
                                executedCount == 0
                                        ? 0
                                        : elapsedSeconds / executedCount;

                        long remaining =
                                totalStatements - executedCount;

                        long eta =
                                avgPerStatement * remaining;

                        int progress =
                                totalStatements == 0
                                        ? 0
                                        : (executedCount * 100) / totalStatements;

                        /**
                         * UPDATE CACHE
                         */
                        status.put("status", "RUNNING");
                        status.put("progress", progress);
                        status.put("executedCount", executedCount);
                        status.put("insertCount", insertCount);
                        status.put("updateCount", updateCount);
                        status.put("deleteCount", deleteCount);
                        status.put("otherCount", otherCount);
                        status.put("elapsedSeconds", elapsedSeconds);
                        status.put("etaSeconds", eta);
                        status.put("currentLine", lineNumber);

                        /**
                         * LIVE LOG
                         */
                        if (executedCount % 100 == 0) {

                            log.info("""

                                    ==================================================
                                    LIVE EXECUTION STATUS
                                    ==================================================
                                    jobId={}
                                    progress={}%
                                    executed={}
                                    inserts={}
                                    updates={}
                                    deletes={}
                                    others={}
                                    currentLine={}
                                    eta={} sec
                                    lastQueryTime={} ms
                                    ==================================================
                                    """,
                                    jobId,
                                    progress,
                                    executedCount,
                                    insertCount,
                                    updateCount,
                                    deleteCount,
                                    otherCount,
                                    lineNumber,
                                    eta,
                                    (queryEnd - queryStart)
                            );
                        }
                    }
                }

                /**
                 * FINAL COMMIT
                 */
                connection.commit();

                long totalSeconds =
                        Duration.between(start, Instant.now())
                                .toSeconds();

                long executionSpeed =
                        totalSeconds == 0
                                ? executedCount
                                : executedCount / totalSeconds;

                status.put("status", "COMPLETED");
                status.put("progress", 100);
                status.put("completed", true);
                status.put("executedCount", executedCount);
                status.put("insertCount", insertCount);
                status.put("updateCount", updateCount);
                status.put("deleteCount", deleteCount);
                status.put("otherCount", otherCount);
                status.put("elapsedSeconds", totalSeconds);
                status.put("executionSpeed", executionSpeed);

                log.info("""

                        ==================================================
                        SQL SCRIPT EXECUTION COMPLETED
                        ==================================================
                        jobId={}
                        totalStatements={}
                        executed={}
                        inserts={}
                        updates={}
                        deletes={}
                        others={}
                        elapsed={} sec
                        executionSpeed={} stmt/sec
                        ==================================================
                        """,
                        jobId,
                        totalStatements,
                        executedCount,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        totalSeconds,
                        executionSpeed
                );

            }

        } catch (Exception e) {

            long elapsed =
                    Duration.between(start, Instant.now())
                            .toSeconds();

            Map<String, Object> failedStatus =
                    JOB_STATUS.get(jobId);

            if (failedStatus != null) {

                failedStatus.put("status", "FAILED");
                failedStatus.put("message", e.getMessage());
                failedStatus.put("failedLine", failedLine);
                failedStatus.put("failedSql", failedSql);
                failedStatus.put("executedCount", executedCount);
                failedStatus.put("insertCount", insertCount);
                failedStatus.put("updateCount", updateCount);
                failedStatus.put("deleteCount", deleteCount);
                failedStatus.put("otherCount", otherCount);
                failedStatus.put("elapsedSeconds", elapsed);
            }

            log.error("""

                    ==================================================
                    SQL EXECUTION FAILED
                    ==================================================
                    jobId={}
                    failedLine={}
                    failedSql={}
                    executedCount={}
                    elapsed={} sec
                    exception={}
                    ==================================================
                    """,
                    jobId,
                    failedLine,
                    failedSql,
                    executedCount,
                    elapsed,
                    e.getMessage(),
                    e
            );
        } finally {

            /**
             * DELETE TEMP FILE
             */
            try {

                if (sqlFile != null && sqlFile.exists()) {

                    boolean deleted = sqlFile.delete();

                    log.info("""

                            ==================================================
                            TEMP FILE CLEANUP
                            ==================================================
                            file={}
                            deleted={}
                            ==================================================
                            """,
                            sqlFile.getAbsolutePath(),
                            deleted
                    );
                }

            } catch (Exception ex) {

                log.error("FAILED TO DELETE TEMP FILE", ex);
            }
        }
    }
}