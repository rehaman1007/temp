<DatePicker
  value={filters.fromDate}
  format="DD/MM/YYYY"
  minDate={minLimit}
  maxDate={maxLimit}
  views={["year", "month", "day"]}
  onChange={(value) => {
    onFilterChange("fromDate", value);

    if (
      value &&
      filters.toDate &&
      value.isValid() &&
      filters.toDate.isValid()
    ) {
      if (value.isAfter(filters.toDate, "day")) {
        setFromDateError("fromGreaterThanTo");
        setToDateError("toLessThanFrom");
      } else {
        setFromDateError(null);
        setToDateError(null);
      }
    } else {
      setFromDateError(null);
    }
  }}
  onError={(error) => {
    if (error) {
      setFromDateError(error);
    } else if (
      filters.fromDate &&
      filters.toDate &&
      filters.fromDate.isAfter(filters.toDate, "day")
    ) {
      setFromDateError("fromGreaterThanTo");
    } else {
      setFromDateError(null);
    }
  }}
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",
      error: !!fromDateError,
      helperText: getDateErrorMessage(fromDateError),
      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>

<DatePicker
  value={filters.toDate}
  format="DD/MM/YYYY"
  minDate={minLimit}
  maxDate={maxLimit}
  views={["year", "month", "day"]}
  onChange={(value) => {
    onFilterChange("toDate", value);

    if (
      filters.fromDate &&
      value &&
      filters.fromDate.isValid() &&
      value.isValid()
    ) {
      if (value.isBefore(filters.fromDate, "day")) {
        setToDateError("toLessThanFrom");
        setFromDateError("fromGreaterThanTo");
      } else {
        setToDateError(null);
        setFromDateError(null);
      }
    } else {
      setToDateError(null);
    }
  }}
  onError={(error) => {
    if (error) {
      setToDateError(error);
    } else if (
      filters.fromDate &&
      filters.toDate &&
      filters.toDate.isBefore(filters.fromDate, "day")
    ) {
      setToDateError("toLessThanFrom");
    } else {
      setToDateError(null);
    }
  }}
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",
      error: !!toDateError,
      helperText: getDateErrorMessage(toDateError),
      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>