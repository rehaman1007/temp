/**
 * =========================================================
 * SAFE ORACLE VALUE EXTRACTOR
 * =========================================================
 */
private Object getSafeValue(ResultSet rs, int index) throws SQLException {

    ResultSetMetaData meta = rs.getMetaData();

    int jdbcType = meta.getColumnType(index);
    String typeName = meta.getColumnTypeName(index);

    /*
     * =====================================================
     * CLOB / NCLOB
     * =====================================================
     *
     * IMPORTANT:
     * Check the metadata BEFORE calling getObject().
     *
     * Oracle may return oracle.sql.CLOB / oracle.jdbc.OracleClob
     * from getObject(), and calling toString() on that object
     * can produce:
     *
     * oracle.sql.CLOB@677nhv886
     *
     * We directly request the String instead.
     */
    if (jdbcType == java.sql.Types.CLOB
            || jdbcType == java.sql.Types.NCLOB
            || "CLOB".equalsIgnoreCase(typeName)
            || "NCLOB".equalsIgnoreCase(typeName)) {

        String value = rs.getString(index);

        return value;
    }

    /*
     * =====================================================
     * LONG VARCHAR
     * =====================================================
     */
    if (jdbcType == java.sql.Types.LONGVARCHAR
            || jdbcType == java.sql.Types.LONGNVARCHAR) {

        return rs.getString(index);
    }

    /*
     * =====================================================
     * Normal values
     * =====================================================
     */
    Object value = rs.getObject(index);

    if (value == null) {
        return null;
    }

    /*
     * =====================================================
     * Extra protection if Oracle still returns a CLOB
     * =====================================================
     */
    if (value instanceof java.sql.Clob clob) {

        String clobValue = clob.getSubString(
                1,
                Math.toIntExact(clob.length())
        );

        return clobValue;
    }

    /*
     * =====================================================
     * Oracle-specific fallback
     * =====================================================
     */
    String className = value.getClass().getName();

    if (className.toUpperCase(Locale.ROOT).contains("CLOB")) {

        try {
            return rs.getString(index);
        } catch (Exception e) {
            log.warn(
                    "Failed to convert Oracle CLOB. column={}, type={}, class={}",
                    index,
                    typeName,
                    className,
                    e
            );
        }
    }

    return value;
}