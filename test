export default function AcceptRejectSegments() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [remarks, setRemarks] = useState("");
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      console.log("Fetching Data");
      const payload = {};
      const response = await callApi("/CR/pending-requests", payload, "GET");
      console.log("response ::", response);
      if (response) {
        setRows(response);
      } else {
        showSnackBar("No pending requests found to take action", "warning");
      }
    } catch (error) {
      console.log(error);
      showSnackBar(
        "Something went wrong while fetching data, Kindly try again later",
        "error"
      );
    }
  };

  const handleConfirm = async () => {
    try {
      if (confirmDialog.type === "reject" && !remarks.trim()) {
        alert("Please provide remarks before rejecting.");
        return;
      }
      const payload = {
        requestId: confirmDialog.rowId,
        status: confirmDialog.type === "reject" ? "REJECTED" : "ACCEPTED",
        remarks:
          confirmDialog.type === "reject" ? remarks.trim() : "No Remarks",
      };
      const response = await callApi("/CR/patch-request", payload, "PATCH");
      console.log("response ::", response);
      if (response) {
        if (confirmDialog.type === "accept") {
          console.log("Accepted row:", confirmDialog.rowId);
          showSnackBar("Request Accepted Successfully", "success");
        } else if (confirmDialog.type === "reject") {
          showSnackBar("Request Rejected Successfully", "success");
        }
      } else {
        showSnackBar(
          "Failed to process the actoin on your request, Kindly try again",
          "warning"
        );
      }
    } catch (error) {
      console.log(error);
      showSnackBar(
        "Something went wrong while fetching data, Kindly try again later",
        "error"
      );
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  const columns = useMemo(
    () => [
      {
        field: "segmentCode",
        headerName: "Segment Code",
        flex: 0.5,
        sortable: true,
        align: "left",
        headerAlign: "left",
      },
      {
        field: "description",
        headerName: "Segment Description",
        flex: 1.2,
        sortable: true,
      },

      {
        field: "changeType",
        headerName: "Request type",
        flex: 0.5,
        sortable: true,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => {
          const value = params.value;
          return (
            <Box>
              {value === "A" ? (
                <Chip icon={<AddBoxIcon />} label={"Added"} size="small" />
              ) : value === "D" ? (
                <Chip
                  icon={<AutoDeleteIcon />}
                  label={"Deleted"}
                  size="small"
                />
              ) : (
                <Chip
                  icon={<EditDocumentIcon />}
                  label={"Modified"}
                  size="small"
                />
              )}
            </Box>
          );
        },
      },
      {
        field: "creatorId",
        headerName: "Creator ID",
        flex: 0.5,
        sortable: true,
        align: "left",
        headerAlign: "left",
        renderCell: (params) => {
          const value = params.value;
          return (
            <Box>
              <Chip icon={<AccountCircleIcon />} label={value} size="small" />
            </Box>
          );
        },
      },
      {
        field: "reqDate",
        headerName: "Requested Date",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => {
          const isoString = params.value;

          if (!isoString) {
            return null; // Handle cases where the date is not available
          }

          try {
            const date = new Date(isoString);
            const options = {
              year: "numeric",
              month: "long",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
              second: "2-digit",
              hour12: true, // Use 12-hour format with AM/PM
              timeZone: "Asia/Calcutta",
            };

            const formattedDateTime = date.toLocaleString("en-US", options);
            return <Box>{formattedDateTime}</Box>;
          } catch (error) {
            console.error("Invalid date format:", error);
            return <Box>{isoString}</Box>;
          }
        },
      },
      {
        field: "actions",
        headerName: "Actions",
        sortable: false,
        flex: 0.5,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => (
          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
            justifyContent="center"
          >
            <Tooltip title="Approve">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("accept", params.row.id)}
                color="success"
              >
                <CheckIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
            <Tooltip title="Reject">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("reject", params.row.id)}
