// store/downloadSlice.js
import { createSlice, createAsyncThunk } from "@reduxjs/toolkit";
import axios from "axios";

export const startDownload = createAsyncThunk(
  "download/start",
  async (
    { url, payload, headers = {}, fileName },
    { dispatch }
  ) => {
    const downloadId = `${fileName}_${Date.now()}`;

    dispatch(downloadStarted({ downloadId, fileName }));

    const response = await axios({
      method: "POST",
      url,
      data: payload,
      responseType: "blob",
      headers,
      onDownloadProgress: (event) => {
        dispatch(
          downloadProgress({
            downloadId,
            loaded: event.loaded || 0,
          })
        );
      },
    });

    dispatch(downloadCompleted({ downloadId }));

    // trigger browser download
    const blobUrl = window.URL.createObjectURL(response.data);
    const a = document.createElement("a");
    a.href = blobUrl;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    a.remove();
    window.URL.revokeObjectURL(blobUrl);

    return downloadId;
  }
);

const downloadSlice = createSlice({
  name: "download",
  initialState: {
    active: {}, // { [downloadId]: { fileName, loaded, status } }
  },
  reducers: {
    downloadStarted: (state, action) => {
      const { downloadId, fileName } = action.payload;
      state.active[downloadId] = {
        fileName,
        loaded: 0,
        status: "DOWNLOADING",
      };
    },
    downloadProgress: (state, action) => {
      const { downloadId, loaded } = action.payload;
      if (state.active[downloadId]) {
        state.active[downloadId].loaded = loaded;
      }
    },
    downloadCompleted: (state, action) => {
      const { downloadId } = action.payload;
      if (state.active[downloadId]) {
        state.active[downloadId].status = "COMPLETED";
      }
    },
    clearDownload: (state, action) => {
      delete state.active[action.payload];
    },
  },
});

export const {
  downloadStarted,
  downloadProgress,
  downloadCompleted,
  clearDownload,
} = downloadSlice.actions;

export default downloadSlice.reducer;

// layouts/CommonLayout.jsx
import { useSelector, useDispatch } from "react-redux";
import { Box, LinearProgress, Typography, Fade } from "@mui/material";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";
import { clearDownload } from "../store/downloadSlice";

export default function CommonLayout({ children }) {
  const downloads = useSelector((s) => s.download.active);
  const dispatch = useDispatch();

  const activeDownloads = Object.entries(downloads);

  return (
    <>
      {children}

      <Fade in={activeDownloads.length > 0}>
        <Box
          sx={{
            position: "fixed",
            bottom: 16,
            right: 16,
            width: 360,
            p: 2,
            borderRadius: 2,
            bgcolor: "background.paper",
            boxShadow: 6,
            zIndex: 1300,
          }}
        >
          {activeDownloads.map(([id, d]) => {
            const mb = (d.loaded / (1024 * 1024)).toFixed(2);

            return (
              <Box key={id} sx={{ mb: 2 }}>
                <Box sx={{ display: "flex", gap: 1, alignItems: "center" }}>
                  <CloudDownloadTwoToneIcon fontSize="small" />
                  <Typography variant="body2" fontWeight={600}>
                    {d.fileName}
                  </Typography>
                </Box>

                <Typography variant="caption" color="text.secondary">
                  {d.status === "DOWNLOADING"
                    ? `Downloading… ${mb} MB`
                    : "Download completed"}
                </Typography>

                <LinearProgress
                  variant="indeterminate"
                  sx={{
                    mt: 1,
                    height: 6,
                    borderRadius: 999,
                  }}
                />

                {d.status === "COMPLETED" && (
                  <Typography
                    variant="caption"
                    sx={{ cursor: "pointer", mt: 0.5 }}
                    onClick={() => dispatch(clearDownload(id))}
                  >
                    Dismiss
                  </Typography>
                )}
              </Box>
            );
          })}
        </Box>
      </Fade>
    </>
  );
}

