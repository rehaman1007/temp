import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Box,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";

import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

/* ------------------ INITIAL STEP RESOLVER ------------------ */
const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex((s) => s.status === StageStatus.STARTED);
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.status === StageStatus.ERROR);
  if (error !== -1) return error;

  const completed = stages
    .map((s, i) => (s.status === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  return completed.length ? completed[completed.length - 1] : 0;
};

/* ------------------ MAIN DIALOG ------------------ */
const ProcessDetailsDialog = ({
  process,
  onClose,
  onStart,
  onStop,
  permissions = {},
}) => {
  const stages = useMemo(() => process?.stageDetails || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    setActiveStep(resolveInitialActiveStep(stages));
  }, [stages]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.status;

  return (
    <Dialog
      open={!!process}
      onClose={onClose}
      fullWidth
      maxWidth="lg"
      PaperProps={{
        sx: { height: "90vh" },
      }}
    >
      {/* ---------- HEADER ---------- */}
      <DialogTitle sx={{ pr: 6 }}>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      {/* ---------- BODY ---------- */}
      <DialogContent
        dividers
        sx={{
          p: 0,
          display: "grid",
          gridTemplateColumns: "280px 1fr",
          height: "100%",
        }}
      >
        {/* LEFT – SCROLLABLE STEPPER */}
        <Box
          sx={{
            borderRight: "1px solid",
            borderColor: "divider",
            overflowY: "auto",
            px: 2,
            py: 1,
          }}
        >
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />
        </Box>

        {/* RIGHT – FIXED CONTENT */}
        <Box sx={{ p: 3 }}>
          <StageDetails stage={stages[activeStep]} />
        </Box>
      </DialogContent>

      {/* ---------- FOOTER ---------- */}
      {(permissions.start || permissions.stop) && (
        <DialogActions>
          {permissions.start && lastStatus !== StageStatus.STARTED && (
            <Button
              startIcon={<RestartAltIcon />}
              onClick={() => onStart(process)}
            >
              Restart
            </Button>
          )}

          {permissions.stop && lastStatus === StageStatus.STARTED && (
            <Button
              color="error"
              startIcon={<StopIcon />}
              onClick={() => onStop(process)}
            >
              Stop
            </Button>
          )}
        </DialogActions>
      )}
    </Dialog>
  );
};

export default ProcessDetailsDialog;

import {
  Stepper,
  Step,
  StepLabel,
  Typography,
  Box,
} from "@mui/material";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

/* ------------------ STEPPER ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  return (
    <Stepper orientation="vertical" nonLinear>
      {stageDetails.map((stage, index) => {
        const isActive = index === activeStep;
        const isError = stage.status === StageStatus.ERROR;
        const isCompleted = stage.status === StageStatus.COMPLETED;

        return (
          <Step key={index} active>
            <StepLabel
              error={isError}
              onClick={() => onStageClick(index)}
              sx={{
                cursor: "pointer",
                backgroundColor: isActive ? "action.hover" : "transparent",
                borderRadius: 1,
                px: 1,
                py: 0.5,
              }}
              icon={
                <Box
                  component={getIconComponent(stage.stage.icon)}
                  sx={(theme) => ({
                    color: isError
                      ? theme.palette.error.main
                      : isCompleted
                        ? theme.palette.success.main
                        : theme.palette.text.secondary,
                  })}
                />
              }
              optional={
                <Typography variant="caption">
                  {stage.status === StageStatus.STARTED
                    ? "In Progress"
                    : stage.status === StageStatus.COMPLETED
                      ? "Completed"
                      : stage.status === StageStatus.ERROR
                        ? "Failed"
                        : "Not Started"}
                </Typography>
              }
            >
              <Typography variant="subtitle2">
                {stage.stage.title}
              </Typography>
            </StepLabel>
          </Step>
        );
      })}
    </Stepper>
  );
};

export default ProgressStepper;

import {
  Box,
  Typography,
  Grid,
  Paper,
  Chip,
  Divider,
} from "@mui/material";
import { StageStatus } from "../util/StageStatus";

const StageDetails = ({ stage }) => {
  if (!stage) {
    return (
      <Typography color="text.secondary">
        Select a stage to view details
      </Typography>
    );
  }

  const statusMap = {
    [StageStatus.STARTED]: { label: "In Progress", color: "info" },
    [StageStatus.COMPLETED]: { label: "Completed", color: "success" },
    [StageStatus.ERROR]: { label: "Failed", color: "error" },
  };

  const status = statusMap[stage.status] || {
    label: "Not Started",
    color: "default",
  };

  return (
    <Paper variant="outlined" sx={{ p: 3, height: "100%" }}>
      <Typography variant="h6" fontWeight={600}>
        {stage.stage.title}
      </Typography>

      <Chip
        label={status.label}
        color={status.color}
        variant="outlined"
        sx={{ mt: 1, mb: 2 }}
      />

      <Divider sx={{ mb: 2 }} />

      <Grid container spacing={2}>
        <Grid item xs={6}>
          <Typography variant="caption">Start Time</Typography>
          <Typography>{stage.startTime || "—"}</Typography>
        </Grid>

        <Grid item xs={6}>
          <Typography variant="caption">End Time</Typography>
          <Typography>{stage.endTime || "—"}</Typography>
        </Grid>

        {stage.status === StageStatus.ERROR && (
          <Grid item xs={12}>
            <Typography variant="caption" color="error">
              Error
            </Typography>
            <Typography>{stage.errorMessage || "—"}</Typography>
          </Grid>
        )}
      </Grid>
    </Paper>
  );
};

export default StageDetails;