import React, {
  createContext,
  useState,
  useEffect,
  useRef,
  useCallback,
} from "react";
import axios from "axios";
import SessionDialog from "../components/SessionDialog";

export const AuthContext = createContext();

/** CONFIG */
const LOGIN_GRACE_PERIOD = 2000; // 2 sec
const INACTIVITY_TIMEOUT = 5 * 60 * 1000; // 5 min

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [sessionError, setSessionError] = useState("");

  const loginTimeRef = useRef(0);
  const logoutInProgressRef = useRef(false);
  const inactivityTimerRef = useRef(null);

  /* -------------------- Restore user -------------------- */
  useEffect(() => {
    const savedUser = localStorage.getItem("user");
    if (savedUser) setUser(JSON.parse(savedUser));
  }, []);

  /* -------------------- Clear inactivity timer -------------------- */
  const clearInactivityTimer = () => {
    clearTimeout(inactivityTimerRef.current);
  };

  /* -------------------- Start inactivity timer -------------------- */
  const startInactivityTimer = useCallback(() => {
    clearInactivityTimer();

    inactivityTimerRef.current = setTimeout(() => {
      triggerSessionDialog("SESSION_EXPIRED");
    }, INACTIVITY_TIMEOUT);
  }, []);

  /* -------------------- Login -------------------- */
  const login = (userData, tokens) => {
    localStorage.setItem("accessToken", tokens.accessToken);
    localStorage.setItem("refreshToken", tokens.refreshToken);
    localStorage.setItem("user", JSON.stringify(userData));

    loginTimeRef.current = Date.now();
    logoutInProgressRef.current = false;

    setUser(userData);
    startInactivityTimer();
  };

  /* -------------------- Logout API -------------------- */
  const logout = useCallback(async () => {
    if (logoutInProgressRef.current) return;
    logoutInProgressRef.current = true;

    clearInactivityTimer();

    try {
      await axios.post("/auth/logout", {}, { withCredentials: true });
    } catch {}

    localStorage.clear();
    setUser(null);
    setDialogOpen(false);

    window.location.replace("/");
  }, []);

  /* -------------------- Trigger session dialog -------------------- */
  const triggerSessionDialog = useCallback(
    (reason) => {
      // prevent false trigger just after login
      if (Date.now() - loginTimeRef.current < LOGIN_GRACE_PERIOD) return;
      if (logoutInProgressRef.current) return;

      logoutInProgressRef.current = true;
      clearInactivityTimer();
      setSessionError(reason);
      setDialogOpen(true);
    },
    []
  );

  /* -------------------- Track user activity -------------------- */
  useEffect(() => {
    if (!user) return;

    const handleActivity = () => startInactivityTimer();
    const events = ["mousemove", "keydown", "click", "scroll", "touchstart"];

    events.forEach((e) => window.addEventListener(e, handleActivity));

    return () => {
      events.forEach((e) =>
        window.removeEventListener(e, handleActivity)
      );
      clearInactivityTimer();
    };
  }, [user, startInactivityTimer]);

  return (
    <AuthContext.Provider
      value={{
        user,
        login,
        logout,
        triggerSessionDialog,
      }}
    >
      {children}

      <SessionDialog
        open={dialogOpen}
        reason={sessionError}
        onConfirm={logout}
      />
    </AuthContext.Provider>
  );
};