import { useEffect, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Box,
  Accordion,
  AccordionSummary,
  AccordionDetails,
  Typography,
  IconButton,
  Autocomplete,
  TextField,
  Chip,
} from "@mui/material";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import CloseIcon from "@mui/icons-material/Close";
import AddIcon from "@mui/icons-material/Add";
import DeleteIcon from "@mui/icons-material/Delete";

import { useTableConfig } from "../../hooks/useTableConfig";
import { FilterBuilder } from "../FilterBuilder";

const EMPTY_TABLE_FILTER = {
  tableName: "",
  filters: {},
};

export const ColumnTableFiltersDialog = ({
  open,
  value = [],
  onClose,
  onSave,
}) => {
  const { tableConfigs } = useTableConfig();

  const [tables, setTables] = useState([]);

  useEffect(() => {
    setTables(value?.length ? value : []);
  }, [value, open]);

  const addTable = () => {
    setTables((p) => [...p, { ...EMPTY_TABLE_FILTER }]);
  };

  const updateTable = (index, key, val) => {
    const copy = [...tables];
    copy[index] = { ...copy[index], [key]: val };
    setTables(copy);
  };

  const removeTable = (index) => {
    setTables((p) => p.filter((_, i) => i !== index));
  };

  const valid =
    tables.length > 0 &&
    tables.every((t) => t.tableName);

  return (
    <Dialog open={open} maxWidth="md" fullWidth>
      <DialogTitle>
        Column Filters
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>

        <Box display="flex" justifyContent="flex-end" mb={2}>
          <Button
            startIcon={<AddIcon />}
            size="small"
            onClick={addTable}
            variant="outlined"
          >
            Add Table
          </Button>
        </Box>

        {tables.length === 0 && (
          <Typography color="text.secondary" align="center">
            No tables added yet.
          </Typography>
        )}

        {tables.map((tbl, index) => (
          <Accordion key={index} defaultExpanded>
            <AccordionSummary expandIcon={<ExpandMoreIcon />}>
              <Box
                display="flex"
                alignItems="center"
                gap={1}
                width="100%"
              >
                <Typography fontWeight={600}>
                  {tbl.tableName || "Select Table"}
                </Typography>

                <Box flexGrow={1} />

                <Chip
                  size="small"
                  label={`${Object.keys(tbl.filters || {}).length} columns`}
                />

                <IconButton
                  size="small"
                  onClick={(e) => {
                    e.stopPropagation();
                    removeTable(index);
                  }}
                >
                  <DeleteIcon fontSize="small" />
                </IconButton>
              </Box>
            </AccordionSummary>

            <AccordionDetails>
              <Box display="flex" flexDirection="column" gap={2}>

                <Autocomplete
                  options={tableConfigs || []}
                  getOptionLabel={(o) =>
                    o?.label || o?.tableName || ""
                  }
                  value={
                    tableConfigs.find(
                      (t) => t.tableName === tbl.tableName,
                    ) || null
                  }
                  onChange={(_, v) =>
                    updateTable(
                      index,
                      "tableName",
                      v?.tableName || "",
                    )
                  }
                  renderInput={(p) => (
                    <TextField {...p} label="Table" />
                  )}
                />

                {tbl.tableName && (
                  <FilterBuilder
                    tableName={tbl.tableName}
                    filters={tbl.filters}
                    onFiltersChange={(f) =>
                      updateTable(index, "filters", f)
                    }
                  />
                )}

              </Box>
            </AccordionDetails>
          </Accordion>
        ))}
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          variant="contained"
          disabled={!valid}
          onClick={() => onSave(tables)}
        >
          Save
        </Button>
      </DialogActions>
    </Dialog>
  );
};