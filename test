import React, { useState, useRef, useEffect } from "react";
import { useDispatch } from "react-redux";
import { useNavigate } from "react-router-dom";
import { Box } from "@mui/material";

import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";

import { loginSuccess } from "../../../store/slices/authSlice";
import {
  setMenus,
  setSelectedMenuItem,
} from "../../../store/slices/menuSlice";
import { setTabId } from "../../../store/slices/tabSlice";

import { parseJwt } from "../../../utils/EncryptionUtilities";

import {
  StyledTextField,
  PrimaryButton,
} from "./LoginStyles";

const OtpVerification = ({
  userId,
  otpTxnId,
  loginResult,
  openLoginErrorDialog,
}) => {
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);

  const otpRef = useRef(null);

  const dispatch = useDispatch();
  const navigate = useNavigate();

  useEffect(() => {
    otpRef.current?.focus();
  }, []);

  const completeLogin = (result) => {
    try {
      const user = parseJwt(result.accessToken);

      const tabId = crypto.randomUUID();

      dispatch(
        loginSuccess({
          token: result.accessToken,
          user,
        })
      );

      localStorage.setItem(
        "payloadEncryptionKey",
        result.payloadEncryptionKey
      );

      dispatch(setTabId(tabId));

      dispatch(setMenus(result.roleData.root_menus));

      dispatch(
        setSelectedMenuItem(
          result.roleData.root_menus[0]
        )
      );

      const bc = new BroadcastChannel("auth");

      setTimeout(() => {
        bc.postMessage({
          type: "USER_LOGGED_IN",
          tabId,
          userId: user.userId,
        });
      }, 1000);

      const firstMenu = result.roleData.root_menus?.[0];

      if (firstMenu?.route) {
        if (firstMenu.hasChildren) {
          navigate("/choose-option" + firstMenu.route);
        } else {
          navigate(firstMenu.route);
        }
      }
    } catch (err) {
      console.error("Complete login error:", err);

      openLoginErrorDialog(
        "Login Failed",
        "Unable to complete login."
      );
    }
  };

  const verifyOtp = async () => {
    if (!otp || otp.trim() === "") {
      openLoginErrorDialog(
        "Validation Error",
        "Please enter OTP."
      );
      otpRef.current?.focus();
      return;
    }

    try {
      setLoading(true);

      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/validate-otp`,
        {
          userId,
          otp: otp.trim(),
          otpTxnId,
        }
      );

      const result = response?.data?.data || {};

      if (result.success === true) {
        completeLogin(loginResult);
      } else {
        openLoginErrorDialog(
          "OTP Verification Failed",
          result.message || "Invalid OTP."
        );
      }
    } catch (e) {
      console.error("OTP Verification Error:", e);

      openLoginErrorDialog(
        "OTP Verification Failed",
        e?.response?.data?.message ||
          "Unable to validate OTP."
      );
    } finally {
      setLoading(false);
    }
  };

  const resendOtp = async () => {
    try {
      await api.post(
        `${resolveConfig("/LS") || ""}/auth/send-otp`,
        {
          userId,
        }
      );

      openLoginErrorDialog(
        "OTP Sent",
        "A new OTP has been sent successfully."
      );
    } catch (e) {
      console.error("Resend OTP Error:", e);

      openLoginErrorDialog(
        "Error",
        e?.response?.data?.message ||
          "Failed to resend OTP."
      );
    }
  };

  const handleOtpKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      e.stopPropagation();

      if (!loading) {
        verifyOtp();
      }
    }
  };

  return (
    <Box>
      <StyledTextField
        fullWidth
        label="Enter OTP"
        inputRef={otpRef}
        value={otp}
        onChange={(e) => {
          const value = e.target.value.replace(/\D/g, "");
          if (value.length <= 6) {
            setOtp(value);
          }
        }}
        onKeyDown={handleOtpKeyDown}
        margin="normal"
        inputProps={{
          maxLength: 6,
        }}
        helperText="Enter the OTP sent to your registered mobile/email."
      />

      <PrimaryButton
        fullWidth
        variant="contained"
        onClick={verifyOtp}
        disabled={loading}
        sx={{ mt: 1 }}
      >
        {loading ? "Verifying OTP..." : "Verify OTP"}
      </PrimaryButton>

      <PrimaryButton
        fullWidth
        variant="outlined"
        onClick={resendOtp}
        disabled={loading}
        sx={{ mt: 1 }}
      >
        Resend OTP
      </PrimaryButton>
    </Box>
  );
};

export default OtpVerification;


import React, { useEffect, useState, useRef } from "react";
import { InputAdornment, IconButton } from "@mui/material";
import LockIcon from "@mui/icons-material/Lock";
import Visibility from "@mui/icons-material/Visibility";
import VisibilityOff from "@mui/icons-material/VisibilityOff";

import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import JSEncrypt from "jsencrypt";

import { StyledTextField, PrimaryButton } from "./LoginStyles";

const LoginWithPassword = ({
  userId,
  publicKey,
  openLoginErrorDialog,
  onBackToHome,
  onOtpRequired,
}) => {
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [passwordInvalidMessage, setPasswordInvalidMessage] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const passwordInputRef = useRef(null);

  useEffect(() => {
    passwordInputRef.current?.focus();
  }, []);

  const validateUserCredentials = async () => {
    if (!password || password.trim() === "") {
      setPasswordInvalidMessage("Password cannot be empty.");
      passwordInputRef.current?.focus();
      return;
    }

    setPasswordInvalidMessage("");
    setIsLoading(true);

    try {
      if (!publicKey) {
        throw new Error("Could not retrieve encryption key.");
      }

      const encryptor = new JSEncrypt();
      encryptor.setPublicKey(publicKey);

      const encryptedPassword = encryptor.encrypt(password);

      if (!encryptedPassword) {
        throw new Error("Encryption failed.");
      }

      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/login`,
        {
          userId,
          password: encryptedPassword,
        }
      );

      const result = response?.data?.data || {};

      if (result.validCredentials === true) {
        if (
          !result?.roleData?.root_menus ||
          result.roleData.root_menus.length === 0
        ) {
          openLoginErrorDialog(
            "Access Denied",
            "You don't have enough permissions to access this application. Kindly contact support."
          );
          return;
        }

        // SAMPLE OTP SEND API
        // Replace with actual API later
        const otpResponse = await api.post(
          `${resolveConfig("/LS") || ""}/auth/send-otp`,
          {
            userId,
          }
        );

        const otpResult = otpResponse?.data?.data || {};

        onOtpRequired?.({
          otpTxnId: otpResult?.otpTxnId,
          loginResult: result,
        });

        return;
      }

      if (
        result.userStatus === "ACTIVE" &&
        result.loginMethod === "P"
      ) {
        if (result.attemptsLeft > 0) {
          setPasswordInvalidMessage(
            `Invalid credentials. ${result.attemptsLeft} attempts left.`
          );

          openLoginErrorDialog(
            "Invalid Password",
            "Password incorrect."
          );
        } else {
          openLoginErrorDialog(
            "Account Locked",
            "Your account has been locked."
          );
        }
      } else {
        openLoginErrorDialog(
          "Login Failed",
          result.message || "Invalid credentials."
        );
      }
    } catch (e) {
      console.error("Login Error:", e);

      const msg =
        e?.response?.data?.message ||
        e?.message ||
        "Failed to log into FinCore";

      openLoginErrorDialog(
        "Login Failed",
        msg
      );
    } finally {
      setIsLoading(false);
    }
  };

  const handlePasswordKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      e.stopPropagation();

      if (!isLoading) {
        validateUserCredentials();
      }
    }
  };

  return (
    <>
      <StyledTextField
        fullWidth
        inputRef={passwordInputRef}
        label="Password"
        type={showPassword ? "text" : "password"}
        value={password}
        onChange={(e) => {
          setPassword(e.target.value);

          if (passwordInvalidMessage) {
            setPasswordInvalidMessage("");
          }
        }}
        onKeyDown={handlePasswordKeyDown}
        variant="outlined"
        margin="normal"
        autoComplete="current-password"
        error={!!passwordInvalidMessage}
        helperText={passwordInvalidMessage}
        InputProps={{
          startAdornment: (
            <InputAdornment position="start">
              <LockIcon />
            </InputAdornment>
          ),
          endAdornment: (
            <InputAdornment position="end">
              <IconButton
                edge="end"
                onClick={() => setShowPassword((prev) => !prev)}
              >
                {showPassword ? (
                  <Visibility />
                ) : (
                  <VisibilityOff />
                )}
              </IconButton>
            </InputAdornment>
          ),
        }}
      />

      <PrimaryButton
        fullWidth
        variant="contained"
        onClick={validateUserCredentials}
        disabled={!userId || isLoading}
      >
        {isLoading ? "Validating..." : "Continue"}
      </PrimaryButton>
    </>
  );
};

export default LoginWithPassword;


