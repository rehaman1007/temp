import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Card,
  Container,
  Grid,
  Grow,
  Paper,
  Stack,
  IconButton,
  Tooltip,
  Chip,
  Divider,
} from "@mui/material";
import { motion } from "framer-motion";
import dayjs from "dayjs";

// MUI Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import PictureAsPdfIcon from "@mui/icons-material/PictureAsPdf";
import TableChartIcon from "@mui/icons-material/TableChart";
import ArticleIcon from "@mui/icons-material/Article";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import SyncIcon from "@mui/icons-material/Sync";
import EventBusyIcon from "@mui/icons-material/EventBusy";
import DescriptionIcon from "@mui/icons-material/Description";

// Custom Hooks (Ensure paths match your project)
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import LoadingOverlay from "../../utils/LoadingOverlay";
import CustomChip from "../../utils/CustomChip";

// --- Date Utility ---
const isLastDayOfMonth = (dateString) => {
  if (!dateString) return false;
  const [day, month, year] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return date.getDate() === lastDayOfMonth;
};

// --- Sub-Components ---
const DownloadActions = ({ isAvailable, onDownload }) => {
  const formats = [
    { id: "PDF", label: "PDF", icon: <PictureAsPdfIcon />, color: "#d32f2f" },
    { id: "EXCEL", label: "Excel", icon: <TableChartIcon />, color: "#1b5e20" },
    { id: "TEXT", label: "Text", icon: <ArticleIcon />, color: "#424242" },
  ];

  return (
    <Box sx={{ display: "flex", gap: 2, mt: 3, justifyContent: "center" }}>
      {formats.map((format, index) => (
        <Tooltip
          title={
            !isAvailable
              ? "ETL job is running. Downloads unavailable."
              : `Download ${format.label}`
          }
          key={format.id}
          arrow
        >
          <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: index * 0.1 }}
            whileHover={isAvailable ? { scale: 1.15, y: -3 } : {}}
            whileTap={isAvailable ? { scale: 0.95 } : {}}
          >
            <IconButton
              disabled={!isAvailable}
              onClick={() => onDownload(format.id)}
              sx={{
                bgcolor: !isAvailable
                  ? "action.disabledBackground"
                  : `${format.color}15`,
                color: !isAvailable ? "action.disabled" : format.color,
                "&:hover": {
                  bgcolor: !isAvailable
                    ? "action.disabledBackground"
                    : `${format.color}25`,
                },
              }}
            >
              {format.icon}
            </IconButton>
          </motion.div>
        </Tooltip>
      ))}
    </Box>
  );
};

const ReportCard = ({ report, isAvailable, onDownloadReport }) => {
  return (
    <Paper
      elevation={0}
      sx={{
        p: 4,
        borderRadius: 3,
        border: "1px solid",
        borderColor: "divider",
        background: "linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%)",
        height: "100%",
        display: "flex",
        flexDirection: "column",
        justifyContent: "space-between",
      }}
    >
      <Box sx={{ textAlign: "center", mb: 2 }}>
        <Typography
          variant="h5"
          fontWeight="700"
          color="primary.main"
          gutterBottom
        >
          {report.reportName}
        </Typography>
        <Typography variant="body2" color="text.secondary">
          {report.reportDescription || "Random Description"}
        </Typography>
      </Box>

      <Divider sx={{ my: 2 }} />

      <Box sx={{ textAlign: "center" }}>
        <Typography variant="subtitle2" color="text.secondary">
          Available Formats
        </Typography>
        <DownloadActions
          isAvailable={isAvailable}
          onDownload={(formatType) => onDownloadReport(report.id, formatType)}
        />
      </Box>
    </Paper>
  );
};

// --- Main Screen ---

export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [etlDate, setEtlDate] = useState("");
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(false);
  const [reports, setReports] = useState([]);

  const [loading, setLoading] = useState(true);
  const [isDownloading, setIsDownloading] = useState(false);

  const fetchData = async () => {
    setLoading(true);
    try {
      // 1. Fetch Metadata (ETL Date & Availability Flag)
      const etlDetails = await callApi("/PS/file/fincore-date", {}, "GET");
      console.log(etlDetails);

      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.isAvailableToDownload || true;

      console.log(etlRaw);

      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(true);

      // 2. Fetch Dynamic Reports List
      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/adhoc-types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        console.log(reportsData);
        setReports(reportsData);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar(
        "Failed to load report data. Kindly try again after sometime.",
        "error",
      );
      setEtlDate(dayjs().format("DD-MM-YYYY"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = async (reportId, formatType) => {
    setIsDownloading(true);
    showSnackBar(
      `Generating fresh ${formatType} data for ${reportId}...`,
      "info",
    );

    try {
      // Setup file extensions
      const extensions = {
        PDF: ".pdf",
        EXCEL: ".xlsx",
        TEXT: ".txt",
      };
      const fileExtension = extensions[formatType] || ".txt";
      const fileName = `${reportId}_${etlDate}${fileExtension}`;

      // Call API for download (Make sure responseType: "blob" is supported in your useApi hook if using Axios)
      const response = await callApi(
        `/RS/reports/download?reportId=${reportId}&format=${formatType}`,
        {},
        "GET",
        { responseType: "blob" },
      );

      // Process Blob Data
      const blobData = response?.data || response;
      const blob = new Blob([blobData], { type: "application/octet-stream" });

      // Create a temporary URL and trigger browser download
      const downloadUrl = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = downloadUrl;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();

      // Clean up DOM and URL object
      link.parentNode.removeChild(link);
      window.URL.revokeObjectURL(downloadUrl);

      showSnackBar(`${fileName} downloaded successfully!`, "success");
    } catch (error) {
      console.error("Download Error:", error);
      showSnackBar("Failed to download the report. Please try again.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  return (
    <>
      <LoadingOverlay loading={loading || isDownloading} />

      <Grow in timeout={500}>
        <Stack spacing={4}>
          <Box
            sx={{
              width: "100%",
              p: { xs: 2, sm: 3, md: 4 },
            }}
            elevation={10}
          >
            <Stack
              spacing={3}
              direction={"column"}
              alignItems="center"
              justifyContent="center"
            >
              <Card
                sx={{
                  width: "100%",
                  borderRadius: 3,
                  boxShadow: 6,
                  overflow: "hidden",
                }}
              >
                <Box
                  sx={{
                    display: "flex",
                    flexDirection: { xs: "column", sm: "row" },
                    alignItems: "center",
                    gap: 2,
                    px: { xs: 2, md: 3 },
                    py: { xs: 2, md: 2.5 },
                    background:
                      "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 50%)",
                    color: "white",
                  }}
                >
                  <Box
                    sx={{
                      borderRadius: "50%",
                      p: 1.5,
                      bgcolor: "rgba(255,255,255,0.12)",
                      display: "flex",
                    }}
                  >
                    <DescriptionIcon
                      sx={{
                        width: { xs: 40, sm: 50, md: 60 },
                        height: { xs: 40, sm: 50, md: 60 },
                      }}
                    />
                  </Box>
                  <Box
                    sx={{
                      flex: 1,
                    }}
                  >
                    <Typography variant="h5" fontWeight="bold">
                      Adhoc Reports Generation
                    </Typography>
                    <Typography variant="body2">
                      View and download your monthly reports. Data is generated
                      freshly upon request when the month-end ETL processing has
                      completed successfully.
                    </Typography>
                  </Box>
                </Box>

                <Box
                  sx={{
                    p: 2,
                  }}
                >
                  {/* We keep LoadingOverlay here in case they try to navigate or if data is still fetching initially */}
                  {!loading && etlDate && !isLastDayOfMonth(etlDate) ? (
                    <Container maxWidth="sm" sx={{ py: 12 }}>
                      <motion.div
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.5 }}
                      >
                        <Paper
                          elevation={0}
                          sx={{
                            p: 6,
                            borderRadius: 4,
                            textAlign: "center",
                            border: "1px solid",
                            borderColor: "divider",
                            bgcolor: "#fafafa",
                          }}
                        >
                          <motion.div
                            initial={{ scale: 0 }}
                            animate={{ scale: 1 }}
                            transition={{
                              delay: 0.2,
                              type: "spring",
                              stiffness: 150,
                            }}
                          >
                            <EventBusyIcon
                              sx={{
                                fontSize: 80,
                                color: "text.secondary",
                                mb: 3,
                                opacity: 0.5,
                              }}
                            />
                          </motion.div>
                          <Typography
                            variant="h5"
                            fontWeight="bold"
                            gutterBottom
                            color="text.primary"
                          >
                            Not a Month-End Cycle
                          </Typography>
                          <Typography variant="body1" color="text.secondary">
                            Adhoc Reports are strictly generated as part of the
                            month-end activity.
                          </Typography>
                          <Typography variant="body1" color="text.secondary">
                            The current ETL Date processed is{" "}
                            <strong>{etlDate}</strong>.
                          </Typography>
                          <Typography variant="body1" color="text.secondary">
                            Please check back during the month-end processing
                            cycle.
                          </Typography>
                        </Paper>
                      </motion.div>
                    </Container>
                  ) : (
                    <Container maxWidth="lg" sx={{ py: 6 }}>
                      {/* Global Status Panel */}
                      <motion.div
                        initial={{ y: 20, opacity: 0 }}
                        animate={{ y: 0, opacity: 1 }}
                        transition={{ duration: 0.5, delay: 0.1 }}
                      >
                        <Paper
                          elevation={0}
                          sx={{
                            p: 3,
                            mb: 5,
                            borderRadius: 3,
                            bgcolor: "background.paper",
                            border: "1px solid",
                            borderColor: "divider",
                            boxShadow: "0 4px 20px rgba(0, 0, 0, 0.03)",
                          }}
                        >
                          <Box
                            sx={{
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "space-between",
                              flexWrap: "wrap",
                              gap: 2,
                            }}
                          >
                            <Box
                              sx={{
                                display: "flex",
                                alignItems: "center",
                                gap: 2,
                              }}
                            >
                              <Box
                                sx={{
                                  p: 1.5,
                                  bgcolor: "primary.50",
                                  color: "primary.main",
                                  borderRadius: 2,
                                  display: "flex",
                                }}
                              >
                                <CalendarMonthIcon fontSize="medium" />
                              </Box>
                              <Box>
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  fontWeight="bold"
                                  sx={{ display: "block" }}
                                >
                                  ACTIVE ETL DATE
                                </Typography>
                                <Typography variant="h6" fontWeight="600">
                                  {etlDate}
                                </Typography>
                              </Box>
                            </Box>

                            {/* Global Availability Status Indicator */}
                            <Chip
                              icon={
                                isAvailableToDownload ? (
                                  <CheckCircleIcon />
                                ) : (
                                  <SyncIcon
                                    sx={{
                                      animation: "spin 2s linear infinite",
                                      "@keyframes spin": {
                                        "0%": { transform: "rotate(0deg)" },
                                        "100%": { transform: "rotate(360deg)" },
                                      },
                                    }}
                                  />
                                )
                              }
                              label={
                                isAvailableToDownload
                                  ? "Ready for Download"
                                  : "ETL Job Running..."
                              }
                              color={
                                isAvailableToDownload ? "success" : "warning"
                              }
                              variant="outlined"
                              sx={{ fontWeight: "bold", px: 1 }}
                            />
                          </Box>
                        </Paper>
                      </motion.div>

                      {/* Dynamic Reports Grid */}
                      <Grid container spacing={4}>
                        {reports.map((report, index) => (
                          <Grid item xs={12} md={6} key={report.id || index}>
                            <motion.div
                              initial={{ opacity: 0, y: 30 }}
                              animate={{ opacity: 1, y: 0 }}
                              transition={{
                                duration: 0.5,
                                delay: 0.2 + index * 0.1,
                              }}
                              style={{ height: "100%" }}
                            >
                              <ReportCard
                                report={report}
                                isAvailable={isAvailableToDownload}
                                onDownloadReport={handleDownload}
                              />
                            </motion.div>
                          </Grid>
                        ))}

                        {reports.length === 0 && (
                          <Grid item xs={12}>
                            <Typography
                              align="center"
                              color="text.secondary"
                              sx={{ py: 4 }}
                            >
                              No reports configured for this date.
                            </Typography>
                          </Grid>
                        )}
                      </Grid>
                    </Container>
                  )}
                </Box>
              </Card>
            </Stack>
          </Box>
        </Stack>
      </Grow>
    </>
  );
}
