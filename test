import React, { useEffect, useRef, useState } from "react";
import * as pdfjsLib from "pdfjs-dist";
import {
  Box,
  CircularProgress,
  Typography,
  IconButton,
  Toolbar as MuiToolbar,
} from "@mui/material";
import ArrowBackIosNewIcon from "@mui/icons-material/ArrowBackIosNew";
import ArrowForwardIosIcon from "@mui/icons-material/ArrowForwardIos";
import ZoomInIcon from "@mui/icons-material/ZoomIn";
import ZoomOutIcon from "@mui/icons-material/ZoomOut";

// Configure worker to use CDN (simplest for v6) or local file
pdfjsLib.GlobalWorkerOptions.workerSrc = `//unpkg.com/pdfjs-dist@${pdfjsLib.version}/build/pdf.worker.min.mjs`;

const PDFView = ({ data = null }) => {
  console.log("pdfjsLib.version >>", pdfjsLib.version);
  const canvasRef = useRef(null);
  const [pdfDoc, setPdfDoc] = useState(null);
  const [pageNumber, setPageNumber] = useState(1);
  const [scale, setScale] = useState(1.5);
  const [loading, setLoading] = useState(true);

  // Load PDF from Blob
  useEffect(() => {
    if (data) {
      let blob;
      if (data instanceof Blob) {
        blob = data;
      } else {
        blob = new Blob([data], { type: "application/pdf" });
      }

      const url = URL.createObjectURL(blob);

      const loadPDF = async () => {
        try {
          setLoading(true);
          const loadingTask = pdfjsLib.getDocument(url);
          const pdf = await loadingTask.promise;
          setPdfDoc(pdf);
          setPageNumber(1);
        } catch (error) {
          console.error("Error loading PDF:", error);
        } finally {
          setLoading(false);
          URL.revokeObjectURL(url);
        }
      };

      loadPDF();

      return () => {
        setPdfDoc(null);
      };
    } else {
      setPdfDoc(null);
    }
  }, [data]);

  // Render page when pdfDoc, pageNumber, or scale changes
  useEffect(() => {
    if (data) {
      let blob;
      if (data instanceof Blob) {
        blob = data;
      } else {
        blob = new Blob([data], { type: "application/pdf" });
      }

      const url = URL.createObjectURL(blob);
      let isCancelled = false;

      const loadPDF = async () => {
        try {
          setLoading(true);
          const loadingTask = pdfjsLib.getDocument({ url }); // ✅ Fixed
          const pdf = await loadingTask.promise;
          if (!isCancelled) {
            setPdfDoc(pdf);
            setPageNumber(1);
          }
        } catch (error) {
          console.error("Error loading PDF:", error);
        } finally {
          if (!isCancelled) {
            setLoading(false);
          }
        }
      };

      loadPDF();

      return () => {
        isCancelled = true;
        setPdfDoc(null);
        URL.revokeObjectURL(url);
      };
    } else {
      setPdfDoc(null);
    }
  }, [data]);

  if (loading) {
    return (
      <Box
        sx={{
          height: "100%",
          width: "100%",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
          flexDirection: "column",
        }}
      >
        <CircularProgress size={40} sx={{ mb: 2 }} />
        <Typography color="text.secondary">Loading PDF...</Typography>
      </Box>
    );
  }

  if (!pdfDoc) {
    return (
      <Box
        sx={{
          height: "100%",
          width: "100%",
          display: "flex",
          justifyContent: "center",
          alignItems: "center",
        }}
      >
        <Typography color="text.secondary">No PDF loaded</Typography>
      </Box>
    );
  }

  return (
    <Box
      sx={{
        height: "100%",
        width: "100%",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        overflow: "auto",
        bgcolor: "#f5f5f5",
      }}
    >
      {/* Custom Toolbar */}
      <MuiToolbar
        sx={{
          bgcolor: "white",
          boxShadow: 1,
          width: "100%",
          justifyContent: "center",
          gap: 2,
          mb: 2,
        }}
      >
        <IconButton
          onClick={() => setPageNumber((prev) => Math.max(1, prev - 1))}
          disabled={pageNumber <= 1}
          size="small"
        >
          <ArrowBackIosNewIcon fontSize="small" />
        </IconButton>

        <Typography variant="body2">
          Page {pageNumber} of {pdfDoc.numPages}
        </Typography>

        <IconButton
          onClick={() =>
            setPageNumber((prev) => Math.min(pdfDoc.numPages, prev + 1))
          }
          disabled={pageNumber >= pdfDoc.numPages}
          size="small"
        >
          <ArrowForwardIosIcon fontSize="small" />
        </IconButton>

        <IconButton
          onClick={() => setScale((prev) => Math.max(0.5, prev - 0.1))}
          size="small"
        >
          <ZoomOutIcon fontSize="small" />
        </IconButton>

        <Typography variant="body2">{Math.round(scale * 100)}%</Typography>

        <IconButton
          onClick={() => setScale((prev) => Math.min(3.0, prev + 0.1))}
          size="small"
        >
          <ZoomInIcon fontSize="small" />
        </IconButton>
      </MuiToolbar>

      {/* PDF Canvas */}
      <Box sx={{ marginBottom: 2, boxShadow: 1, bgcolor: "white" }}>
        <canvas ref={canvasRef} style={{ display: "block" }} />
      </Box>
    </Box>
  );
};

export default PDFView;
