import React, { useEffect, useState } from “react”;
import {
Alert,
AlertTitle,
Box,
Chip,
Divider,
LinearProgress,
Paper,
Stack,
Typography,
useTheme,
} from “@mui/material”;

import {
CheckCircle,
ErrorOutline,
Info,
Terminal,
WarningAmber,
} from “@mui/icons-material”;

const LogsPanel = ({ lastResponse, jobStatus }) => {
const theme = useTheme();
const [elapsed, setElapsed] = useState(0);

useEffect(() => {
if (!jobStatus?.startedAt) return;

if (
  jobStatus.status === "COMPLETED" ||
  jobStatus.status === "FAILED"
) {
  setElapsed(Number(jobStatus?.elapsedSeconds || 0));
  return;
}
const updateElapsed = () => {
  const seconds = Math.floor(
    (Date.now() - Number(jobStatus.startedAt)) / 1000,
  );
  setElapsed(seconds > 0 ? seconds : 0);
};
updateElapsed();
const interval = setInterval(updateElapsed, 1000);
return () => clearInterval(interval);

}, [
jobStatus?.startedAt,
jobStatus?.completedAt,
jobStatus?.status,
jobStatus?.elapsedSeconds,
]);

const SectionTitle = ({ title }) => (
<Typography
variant=“subtitle2”
sx={{
fontWeight: 700,
mb: 1.5,
color: “text.primary”,
borderLeft: 4px solid ${theme.palette.primary.main},
pl: 1.2,
}}
>
{title}
);

const InfoRow = ({ label, value }) => (
{label}
  <Typography
    variant="body2"
    fontWeight={600}
    textAlign="right"
  >
    {value}
  </Typography>
</Stack>

);

if (!lastResponse && !jobStatus) {
return (
<Paper
elevation={0}
sx={{
borderRadius: 1,
border: 1px solid ${theme.palette.divider},
overflow: “hidden”,
}}
>
<Box
sx={{
px: 2.5,
py: 1.5,
background:
“linear-gradient(135deg,#111827,#1f2937)”,
color: “white”,
}}
>
        <Typography fontWeight={800}>
          Execution Logs
        </Typography>
      </Stack>
    </Box>
    <Box p={3}>
      <Alert
        severity="info"
        icon={<Info />}
        sx={{
          borderRadius: 2,
        }}
      >
        <AlertTitle>
          Waiting for execution
        </AlertTitle>
        Execute SQL query or upload
        script to view logs.
      </Alert>
    </Box>
  </Paper>
);

}

const processed = Number(
jobStatus?.processedCount || 0,
);

const executed = Number(
jobStatus?.executedCount || 0,
);

const total = Number(
jobStatus?.totalStatements || 0,
);

const progress = Number(
jobStatus?.progress || 0,
);

const pending = Math.max(
total - executed,
0,
);

const currentSpeed = Number(
jobStatus?.executionSpeed || 0,
);

return (
<Paper
elevation={0}
sx={{
borderRadius: 1,
overflow: “hidden”,
border: 1px solid ${theme.palette.divider},
display: “flex”,
flexDirection: “column”,
}}
>
{/* HEADER */}
<Box
sx={{
px: 2.5,
py: 1.5,
background:
“linear-gradient(135deg,#111827,#1f2937)”,
color: “white”,
borderBottom:
“1px solid rgba(255,255,255,0.06)”,
}}
>
        <Typography fontWeight={800}>
          Execution Logs
        </Typography>
      </Stack>
      {jobStatus?.status && (
        <Chip
          size="small"
          label={jobStatus.status}
          color={
            jobStatus.status ===
            "COMPLETED"
              ? "success"
              : jobStatus.status ===
                  "FAILED"
                ? "error"
                : "warning"
          }
        />
      )}
    </Stack>
  </Box>
  {/* BODY */}
  <Box
    sx={{
      p: 3,
      bgcolor:
        theme.palette.background.default,
      color:
        theme.palette.text.primary,
      flex: 1,
      overflow: "auto",
      minHeight: 400,
    }}
  >
    {/* STATUS */}
    {jobStatus && (
      <>
        <SectionTitle title="Live Execution Status" />
        <Box
          sx={{
            mb: 3,
            p: 2.5,
            borderRadius: 2,
            bgcolor:
              theme.palette.background.paper,
            border: `1px solid ${theme.palette.divider}`,
          }}
        >
          <Stack spacing={1.2}>
            <InfoRow
              label="Status"
              value={jobStatus.status}
            />
            <InfoRow
              label="Job ID"
              value={
                jobStatus.jobId || "-"
              }
            />
            <InfoRow
              label="Processed"
              value={processed.toLocaleString()}
            />
            <InfoRow
              label="Executed"
              value={executed.toLocaleString()}
            />
            <InfoRow
              label="Total Statements"
              value={total.toLocaleString()}
            />
            <InfoRow
              label="Pending"
              value={pending.toLocaleString()}
            />
            <InfoRow
              label="Execution Speed"
              value={`${currentSpeed.toLocaleString()} stmt/sec`}
            />
            <InfoRow
              label="ETA"
              value={
                jobStatus.status ===
                "COMPLETED"
                  ? "0 sec"
                  : currentSpeed > 0
                    ? `${jobStatus.etaSeconds} sec`
                    : "Calculating..."
              }
            />
            <InfoRow
              label="Elapsed Time"
              value={`${elapsed} sec`}
            />
            <InfoRow
              label="Current Line"
              value={
                jobStatus.currentLine ||
                0
              }
            />
            <Box mt={2}>
              <LinearProgress
                variant="determinate"
                value={progress}
                sx={{
                  height: 10,
                  borderRadius: 10,
                }}
              />
              <Stack
                direction="row"
                justifyContent="space-between"
                mt={1}
              >
                <Typography
                  variant="caption"
                  color="text.secondary"
                >
                  Progress
                </Typography>
                <Typography
                  variant="caption"
                  fontWeight={700}
                >
                  {progress}%
                </Typography>
              </Stack>
            </Box>
          </Stack>
        </Box>
      </>
    )}
    {/* ERROR */}
    {(lastResponse?.error ||
      jobStatus?.status ===
        "FAILED") && (
      <>
        <SectionTitle title="Error Log" />
        <Alert
          severity="error"
          variant="outlined"
          icon={<ErrorOutline />}
          sx={{
            mb: 3,
            borderRadius: 2,
          }}
        >
          <AlertTitle>
            Execution Failed
          </AlertTitle>
          {lastResponse?.message ||
            jobStatus?.message ||
            "Unknown error"}
          {jobStatus?.failedLine && (
            <>
              <Divider sx={{ my: 1 }} />
              Failed Line :
              {" "}
              {jobStatus.failedLine}
            </>
          )}
        </Alert>
      </>
    )}
    {/* FAILED SQL */}
    {jobStatus?.failedSql && (
      <>
        <SectionTitle title="Failed SQL Statement" />
        <Box
          sx={{
            mb: 3,
            p: 2,
            borderRadius: 2,
            bgcolor:
              theme.palette.grey[100],
            border: `1px solid ${theme.palette.error.light}`,
            overflowX: "auto",
          }}
        >
          <Typography
            sx={{
              whiteSpace:
                "pre-wrap",
              fontFamily:
                "Consolas, monospace",
              fontSize: 13,
              lineHeight: 1.7,
              color:
                theme.palette.error.main,
            }}
          >
            {jobStatus.failedSql}
          </Typography>
        </Box>
      </>
    )}
    {/* SUCCESS */}
    {lastResponse &&
      !lastResponse.error && (
        <>
          <SectionTitle title="Execution Result" />
          <Alert
            severity="success"
            variant="outlined"
            icon={<CheckCircle />}
            sx={{
              mb: 3,
              borderRadius: 2,
            }}
          >
            <AlertTitle>
              SQL Executed Successfully
            </AlertTitle>
            {lastResponse?.rows?.[0]
              ?.RESULT ||
              "Execution completed successfully"}
          </Alert>
        </>
      )}
    {/* SUMMARY */}
    {jobStatus && (
      <>
        <SectionTitle title="Execution Summary" />
        <Box
          sx={{
            p: 2,
            borderRadius: 2,
            bgcolor:
              theme.palette.background.paper,
            border: `1px solid ${theme.palette.divider}`,
          }}
        >
          <Stack
            direction="row"
            spacing={1}
            flexWrap="wrap"
            useFlexGap
          >
            <Chip
              color="success"
              label={`INSERT ${
                jobStatus.insertCount ||
                0
              }`}
            />
            <Chip
              color="warning"
              label={`UPDATE ${
                jobStatus.updateCount ||
                0
              }`}
            />
            <Chip
              color="error"
              label={`DELETE ${
                jobStatus.deleteCount ||
                0
              }`}
            />
            <Chip
              color="info"
              label={`OTHERS ${
                jobStatus.otherCount ||
                0
              }`}
            />
          </Stack>
        </Box>
      </>
    )}
    {/* RUNNING */}
    {jobStatus?.status ===
      "RUNNING" && (
      <Alert
        severity="warning"
        variant="outlined"
        icon={<WarningAmber />}
        sx={{
          mt: 3,
          borderRadius: 2,
        }}
      >
        <AlertTitle>
          Execution In Progress
        </AlertTitle>
        Pending statements :
        {" "}
        {pending.toLocaleString()}
      </Alert>
    )}
  </Box>
</Paper>

);
};

export default LogsPanel;