import { DataGrid } from "@mui/x-data-grid";
import {
  Box,
  IconButton,
  Stack,
  Tooltip,
  Typography,
  Card,
  Divider,
  TablePagination,
  useTheme,
  useMediaQuery,
  Grid,
} from "@mui/material";
import InfoIcon from "@mui/icons-material/Info";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";
import MemoryIcon from "@mui/icons-material/Memory";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import ApprovalIcon from "@mui/icons-material/Approval";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import AppRegistrationIcon from "@mui/icons-material/AppRegistration";
import { StageStatus, StageStatusConfig } from "../util/StageStatus";
import { useEffect, useMemo, useState } from "react";
import { timeStampFormatter } from "../../../utils/CommonUtilities";
import CustomChip from "../../../utils/CustomChip";
import { getIconComponent } from "../../../utils/IconUtils";

/* =====================================================
   HELPER FUNCTIONS
===================================================== */
const getOrdinal = (n) => {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};

/* =====================================================
   MAIN COMPONENT
===================================================== */

const ProcessStatusTable = ({
  processes = [],
  isCurrentDate,
  actions,
  loading,
  permissions = {},
}) => {
  const theme = useTheme();
  // 'md' is typically 900px. Below this, we trigger the mobile card view.
  const isDesktop = useMediaQuery(theme.breakpoints.up("md"));

  const SUMMARY_STAGES = new Set([
    "cntr_summary_calculated",
    "intr_summary_calculated",
    "balance_Compare_generated",
  ]);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 5,
  });

  /* =====================================================
     FIND LATEST RUN FOR EACH PROCESS
  ===================================================== */

  const latestRunMap = useMemo(() => {
    const map = new Map();

    processes.forEach((p) => {
      const type = p.processType;
      const runId = Number(p.runId) || 0;

      if (!map.has(type) || runId > map.get(type)) {
        map.set(type, runId);
      }
    });

    return map;
  }, [processes]);

  /* =====================================================
     ROWS
  ===================================================== */

  const rows = useMemo(() => {
    return processes
      .map((p) => {
        const lastStage = p.stages?.at(-1);

        const runId = Number(p.runId) || 1;
        const latestRunId = latestRunMap.get(p.processType);

        const isLatestRun = runId === latestRunId;

        const hasSummary =
          p.processType?.toUpperCase() === "DIFFERENCE" &&
          p.stages?.some(
            (s) =>
              s.stageStatus === StageStatus.COMPLETED &&
              SUMMARY_STAGES.has(s.stageId),
          );

        return {
          id: `${p.processType}_${p.processId}_${runId}`, // UNIQUE KEY

          processId: p.processId,
          processRunId: p.processRunId,
          processType: p.processType,

          runId,
          isLatestRun,

          status: p.status,

          stageTitle: lastStage?.stageTitle ?? "Unknown",
          stageIcon: lastStage?.stageIcon ?? "AccessTime",

          startTime: p.processStartTime,
          endTime: p.processEndTime,

          hasSummary,

          raw: p,
        };
      })
      .sort((a, b) => {
        const dateA = new Date(a.startTime);
        const dateB = new Date(b.startTime);
        return dateB - dateA;
      });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [processes, latestRunMap]);

  const statusOptions = Object.entries(StageStatusConfig).map(
    ([value, details]) => ({
      value: Number(value),
      label: details.label,
    }),
  );

  /* =====================================================
     COLUMNS (DESKTOP)
  ===================================================== */

  const columns = useMemo(
    () => [
      {
        field: "processType",
        flex: 1.5,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <MemoryIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Process Name</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const name = params.row.processType;
          const runId = params.row.runId;

          return (
            <Typography variant="body1" component="span">
              {runId > 1 ? `${name} (${getOrdinal(runId)} run)` : name}
            </Typography>
          );
        },
      },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        headerAlign: "center",
        align: "center",
        type: "singleSelect",
        valueOptions: statusOptions,
        sortComparator: (v1, v2) => {
          const label1 = StageStatusConfig[v1]?.label || "";
          const label2 = StageStatusConfig[v2]?.label || "";
          return label1.localeCompare(label2);
        },
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AnalyticsIcon sx={{ mr: 0.5, fontSize: "1.1rem" }} />
            <Typography variant="subtitle2" fontWeight="600">
              Status
            </Typography>
          </Box>
        ),
        renderCell: (params) => {
          const config = StageStatusConfig[params.value];
          if (!config) return null;
          const Icon = getIconComponent(config.icon);
          return (
            <CustomChip
              icon={<Icon />}
              label={config.label}
              color={config.color}
              variant="contained"
              sx={{ maxWidth: "100%" }}
            />
          );
        },
      },
      {
        field: "stageTitle",
        headerName: "Stage",
        flex: 1.5,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <ApprovalIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Stage</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const Icon = getIconComponent(params.row?.stageIcon);
          return (
            <CustomChip
              label={params.row?.stageTitle}
              icon={<Icon />}
              variant="outlined"
              sx={{
                maxWidth: "100%",
                overflow: "hidden",
                textOverFlow: "ellipsis",
              }}
            />
          );
        },
      },
      {
        field: "startTime",
        headerName: "Started",
        flex: 1,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Started</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography variant="body1" component="span" sx={{ fontSize: "0.9rem" }}>
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },
      {
        field: "endTime",
        headerName: "Ended",
        flex: 1,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Ended</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography variant="body1" component="span" sx={{ fontSize: "0.9rem" }}>
            {timeStampFormatter(p.value) || "-"}
          </Typography>
        ),
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.8,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AppRegistrationIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Actions</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const row = params.row.raw;
          const isLatest = params.row.isLatestRun;
          const showRestart = isLatest && row.status !== StageStatus.STARTED;
          const showStop = isLatest && row.status === StageStatus.STARTED;
          const nonActionableProcess = row.processId == 7 || row.processId == 12;

          return (
            <Stack
              direction="row"
              spacing={0.5}
              alignItems="center"
              justifyContent="center"
              sx={{ height: "100%", width: "100%" }}
            >
              {(permissions.restart || permissions.start) &&
                isCurrentDate &&
                showRestart &&
                !nonActionableProcess && (
                  <Tooltip title="Restart">
                    <IconButton size="small" onClick={() => actions.onStart(row)}>
                      <RestartAltIcon />
                    </IconButton>
                  </Tooltip>
                )}

              {permissions.stop &&
                isCurrentDate &&
                showStop &&
                !nonActionableProcess && (
                  <Tooltip title="Stop">
                    <IconButton size="small" onClick={() => actions.onStop(row)}>
                      <StopIcon />
                    </IconButton>
                  </Tooltip>
                )}

              {permissions.view && (
                <Tooltip title="View">
                  <IconButton size="small" onClick={() => actions.onView(row)}>
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view && params.row.hasSummary && (
                <Tooltip title="Summary">
                  <IconButton size="small" onClick={() => actions.onSummary(row)}>
                    <SummarizeOutlinedIcon />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [
      actions,
      isCurrentDate,
      permissions.restart,
      permissions.start,
      permissions.stop,
      permissions.view,
      statusOptions,
    ],
  );

  const filteredColumns = useMemo(() => {
    if (
      permissions.start ||
      permissions.stop ||
      permissions.restart ||
      permissions.view
    ) {
      return columns;
    }
    return columns.filter((c) => c.field !== "actions");
  }, [columns, permissions]);

  // Reset to page 0 whenever loading changes
  useEffect(() => {
    if (loading) {
      setPaginationModel((prev) => ({
        ...prev,
        page: 0,
      }));
    }
  }, [processes, loading]);

  /* =====================================================
     MOBILE HELPER DATA
  ===================================================== */
  
  // Calculate sliced rows for manual mobile pagination
  const paginatedRows = useMemo(() => {
    const startIndex = paginationModel.page * paginationModel.pageSize;
    return rows.slice(startIndex, startIndex + paginationModel.pageSize);
  }, [rows, paginationModel]);

  const NoRowsOverlay = () => (
    <Stack height="100%" alignItems="center" justifyContent="center" spacing={1} py={6}>
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary" }} />
      <Typography variant="h6">No processes available</Typography>
      <Typography variant="body2">
        Processes not found for the ETL date.
      </Typography>
    </Stack>
  );

  /* =====================================================
     FINAL RENDER
  ===================================================== */

  return (
    <Box sx={{ width: "100%" }}>
      {isDesktop ? (
        /* --- DESKTOP VIEW: DataGrid --- */
        <Box
          sx={{
            width: "100%",
            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#b4a7d6",
              fontWeight: 600,
            },
            "& .MuiDataGrid-row:hover": {
              backgroundColor: "action.hover",
            },
          }}
        >
          <DataGrid
            rows={rows}
            columns={filteredColumns}
            pageSizeOptions={[5, 10, 25, 50]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            loading={loading}
            getRowId={(p) => p.id}
            disableRowSelectionOnClick
            autoHeight // Helps layout blend cleanly
            slots={{
              noRowsOverlay: NoRowsOverlay,
            }}
          />
        </Box>
      ) : (
        /* --- MOBILE & IPAD VIEW: Card List --- */
        <Box>
          {loading ? (
             <Box py={4} textAlign="center"><Typography>Loading...</Typography></Box>
          ) : rows.length === 0 ? (
            <NoRowsOverlay />
          ) : (
            <Stack spacing={2} sx={{ pb: 2 }}>
              {paginatedRows.map((row) => {
                const config = StageStatusConfig[row.status];
                const StatusIcon = config ? getIconComponent(config.icon) : null;
                const StageIcon = getIconComponent(row.stageIcon);
                
                const showRestart = row.isLatestRun && row.status !== StageStatus.STARTED;
                const showStop = row.isLatestRun && row.status === StageStatus.STARTED;
                const nonActionableProcess = row.processId == 7 || row.processId == 12;

                return (
                  <Card key={row.id} variant="outlined" sx={{ borderRadius: 2, boxShadow: 1 }}>
                    <Box sx={{ p: 2 }}>
                      {/* Card Header */}
                      <Stack direction="row" alignItems="center" justifyContent="space-between" mb={1.5}>
                        <Stack direction="row" alignItems="center" spacing={1}>
                          <MemoryIcon color="primary" />
                          <Typography variant="subtitle1" fontWeight="bold">
                            {row.runId > 1 ? `${row.processType} (${getOrdinal(row.runId)} run)` : row.processType}
                          </Typography>
                        </Stack>
                      </Stack>

                      {/* Status & Stage Chips */}
                      <Grid container spacing={1} mb={2}>
                        <Grid item xs={12} sm={6}>
                          {config && (
                            <CustomChip
                              icon={<StatusIcon />}
                              label={config.label}
                              color={config.color}
                              variant="contained"
                              sx={{ width: "100%", justifyContent: "flex-start" }}
                            />
                          )}
                        </Grid>
                        <Grid item xs={12} sm={6}>
                          <CustomChip
                            label={row.stageTitle}
                            icon={<StageIcon />}
                            variant="outlined"
                            sx={{ width: "100%", justifyContent: "flex-start" }}
                          />
                        </Grid>
                      </Grid>

                      {/* Timestamps */}
                      <Stack spacing={1} mb={2}>
                        <Stack direction="row" spacing={1} alignItems="center">
                          <CalendarMonthIcon fontSize="small" color="action" />
                          <Typography variant="body2" color="text.secondary">
                            <strong>Started:</strong> {timeStampFormatter(row.startTime)}
                          </Typography>
                        </Stack>
                        <Stack direction="row" spacing={1} alignItems="center">
                          <CalendarMonthIcon fontSize="small" color="action" />
                          <Typography variant="body2" color="text.secondary">
                            <strong>Ended:</strong> {timeStampFormatter(row.endTime) || "-"}
                          </Typography>
                        </Stack>
                      </Stack>
                    </Box>

                    <Divider />

                    {/* Actions Footer */}
                    <Box sx={{ p: 1, bgcolor: "action.hover", display: "flex", justifyContent: "flex-end", gap: 1 }}>
                      {(permissions.restart || permissions.start) && isCurrentDate && showRestart && !nonActionableProcess && (
                        <ButtonWithIcon icon={<RestartAltIcon />} label="Restart" onClick={() => actions.onStart(row.raw)} />
                      )}
                      
                      {permissions.stop && isCurrentDate && showStop && !nonActionableProcess && (
                        <ButtonWithIcon icon={<StopIcon />} color="error.main" label="Stop" onClick={() => actions.onStop(row.raw)} />
                      )}

                      {permissions.view && (
                        <ButtonWithIcon icon={<VisibilityIcon />} label="View" onClick={() => actions.onView(row.raw)} />
                      )}

                      {permissions.view && row.hasSummary && (
                        <ButtonWithIcon icon={<SummarizeOutlinedIcon />} label="Summary" onClick={() => actions.onSummary(row.raw)} />
                      )}
                    </Box>
                  </Card>
                );
              })}
            </Stack>
          )}

          {/* Manual Pagination for Mobile View */}
          {rows.length > 0 && (
            <TablePagination
              component="div"
              count={rows.length}
              page={paginationModel.page}
              onPageChange={(event, newPage) =>
                setPaginationModel((prev) => ({ ...prev, page: newPage }))
              }
              rowsPerPage={paginationModel.pageSize}
              onRowsPerPageChange={(event) =>
                setPaginationModel({
                  page: 0,
                  pageSize: parseInt(event.target.value, 10),
                })
              }
              rowsPerPageOptions={[5, 10, 25, 50]}
            />
          )}
        </Box>
      )}
    </Box>
  );
};

/* --- Small helper component to keep the mobile action buttons neat --- */
const ButtonWithIcon = ({ icon, label, onClick, color = "primary.main" }) => (
  <Tooltip title={label}>
    <IconButton onClick={onClick} sx={{ color, border: '1px solid', borderColor: 'divider', bgcolor: 'background.paper' }}>
      {icon}
    </IconButton>
  </Tooltip>
);

export default ProcessStatusTable;
