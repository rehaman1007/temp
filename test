package com.fincore.enquiry_service.model;

import java.util.Date;
import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;
import org.hibernate.annotations.Formula; // Import Formula

@Data
@NoArgsConstructor
@AllArgsConstructor
@Builder
@Table(name = "GL_BALANCE")
@Entity
public class GLBalance {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "ID")
    private Integer id;

    @Column(name = "BRANCH_CODE", nullable = false)
    private String branch;

    // Hibernate will run this subquery to fetch the branch name
    @Formula("(SELECT b.NAME FROM BRANCH_MASTER b WHERE b.CODE = BRANCH_CODE)")
    private String branchName;

    @Column(name = "CGL", nullable = false)
    private String cgl;

    // Hibernate will run this subquery to fetch the CGL description
    @Formula("(SELECT d.DESCRIPTION FROM CGL_MASTER d WHERE d.CGL_NUMBER = CGL)")
    private String cglDescription;

    @Column(name = "CURRENCY", nullable = false)
    private String currency;

    @Column(name = "BALANCE", nullable = false)
    private Double balance;

    @Temporal(TemporalType.DATE)
    @Column(name = "BALANCE_DATE", nullable = false)
    private Date date;
}
