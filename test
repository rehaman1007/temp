import React, { useMemo } from "react";
import { Box, Typography, Card, Stack, Chip } from "@mui/material";

import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Legend,
} from "recharts";

import { analyticsStyles as s } from "./RequestAnalyticsStyles";

/** COLORS — KEEP SIMPLE & CONSISTENT */
const COLORS = {
  ADD: "#20b2aa",
  UPDATE: "#6a5acd",
};

const RequestAnalytics = ({ data = [] }) => {
  /* ---------------- PIE DATA (ADD vs MODIFY) ---------------- */
  const { total, pieData } = useMemo(() => {
    const counts = { ADD: 0, UPDATE: 0 };

    data.forEach((d) => {
      if (d.changeType === "ADD") counts.ADD++;
      if (d.changeType === "UPDATE") counts.UPDATE++;
    });

    return {
      total: data.length,
      pieData: [
        { name: "Add Requests", value: counts.ADD },
        { name: "Modify Requests", value: counts.UPDATE },
      ],
    };
  }, [data]);

  /* ---------------- BAR DATA (ONE BAR PER DAY → STACKED) ---------------- */
  const histogramData = useMemo(() => {
    const map = {};

    data.forEach((item) => {
      if (!item.reqDate) return;

      const date = new Date(item.reqDate).toLocaleDateString("en-GB");

      if (!map[date]) {
        map[date] = {
          date,
          ADD: 0,
          UPDATE: 0,
        };
      }

      if (item.changeType === "ADD") map[date].ADD++;
      if (item.changeType === "UPDATE") map[date].UPDATE++;
    });

    return Object.values(map);
  }, [data]);

  return (
    <Card sx={s.card}>
      <Typography sx={s.headerTitle}>
        Request Analytics Overview
      </Typography>

      <Typography variant="caption" sx={s.headerSubtitle}>
        Request distribution by type and daily activity
      </Typography>

      {total > 0 ? (
        <Box sx={s.wrapper}>
          {/* ---------------- PIE SECTION ---------------- */}
          <Box sx={s.pieWrapper}>
            <Typography variant="subtitle2" sx={s.chartCaption}>
              Request Type Distribution (Add vs Modify)
            </Typography>

            <Box sx={s.pieChartBox}>
              <ResponsiveContainer>
                <PieChart>
                  <Pie
                    data={pieData}
                    cx="50%"
                    cy="50%"
                    innerRadius={55}
                    outerRadius={80}
                    paddingAngle={3}
                    dataKey="value"
                  >
                    {pieData.map((_, i) => (
                      <Cell
                        key={i}
                        fill={i === 0 ? COLORS.ADD : COLORS.UPDATE}
                      />
                    ))}
                  </Pie>
                  <Tooltip />
                </PieChart>
              </ResponsiveContainer>

              {/* CENTER LABEL */}
              <Box sx={s.pieCenterBox}>
                <Typography variant="caption" sx={s.pieCenterSubtitle}>
                  Total Requests
                </Typography>
                <Typography sx={s.pieCenterValue}>{total}</Typography>
              </Box>
            </Box>

            {/* LEGEND */}
            <Stack direction="row" spacing={1.5} sx={s.legendRow}>
              {pieData.map((p, i) => (
                <Stack
                  key={p.name}
                  direction="row"
                  alignItems="center"
                  spacing={0.5}
                  sx={s.legendChipBox}
                >
                  <Box
                    sx={s.legendColorDot(
                      i === 0 ? COLORS.ADD : COLORS.UPDATE
                    )}
                  />
                  <Typography variant="caption">{p.name}</Typography>
                  <Chip
                    label={p.value}
                    size="small"
                    sx={{
                      bgcolor: i === 0 ? COLORS.ADD : COLORS.UPDATE,
                      color: "white",
                    }}
                  />
                </Stack>
              ))}
            </Stack>
          </Box>

          {/* ---------------- BAR SECTION ---------------- */}
          <Box sx={s.barChartArea}>
            <Typography variant="subtitle2" sx={s.chartCaption}>
              Daily Requests Breakdown (Add & Modify per day)
            </Typography>

            <ResponsiveContainer>
              <BarChart data={histogramData}>
                <CartesianGrid
                  strokeDasharray="3 3"
                  stroke="rgba(255,255,255,0.3)"
                />
                <XAxis
                  dataKey="date"
                  fontSize={10}
                  tickMargin={4}
                />
                <YAxis fontSize={10} />
                <Tooltip />
                <Legend />

                {/* STACKED BARS — ONE BAR PER DAY */}
                <Bar
                  dataKey="ADD"
                  stackId="daily"
                  fill={COLORS.ADD}
                  radius={[4, 4, 0, 0]}
                />
                <Bar
                  dataKey="UPDATE"
                  stackId="daily"
                  fill={COLORS.UPDATE}
                  radius={[4, 4, 0, 0]}
                />
              </BarChart>
            </ResponsiveContainer>
          </Box>
        </Box>
      ) : (
        <Typography>No data to display</Typography>
      )}
    </Card>
  );
};

export default RequestAnalytics;