import React from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  List,
  ListItem,
  ListItemText,
  Divider,
} from "@mui/material";
import HistoryIcon from "@mui/icons-material/History";
import CustomChip from "../../../utils/CustomChip";
export const DashboardRecentActivity = ({ recentActivity = [] }) => {
  return (
    <>
      <Card variant="outlined" sx={{ borderRadius: 3 }}>
        <CardContent>
          <Stack direction="row" spacing={1} alignItems="center" mb={1}>
            <Box
              sx={{
                width: 44,
                height: 44,
                borderRadius: 2,
                bgcolor: "rgba(0,0,0,0.06)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <HistoryIcon />
            </Box>

            <Typography variant="subtitle1" fontWeight={700}>
              Recent Activity
            </Typography>
          </Stack>

          <List
            dense
            sx={{
              minHeight: 320,
              maxHeight: 320,
              width: "100%",
              overflow: "auto",
            }}
          >
            {(recentActivity || []).slice(0, 20).map((r, idx) => (
              <Box key={r.timestamp + idx}>
                {idx > 0 && <Divider component="li" />}
                <ListItem alignItems="flex-start">
                  <ListItemText
                    primary={
                      <Stack
                        direction="row"
                        spacing={12}
                        gap={12}
                        alignItems="center"
                      >
                        <Typography variant="body2" fontWeight={600}>
                          {r.action}
                        </Typography>
                        <CustomChip
                          label={r.status}
                          size="small"
                          color={
                            r.status === "PENDING"
                              ? "warning"
                              : r.status === "REJECTED"
                              ? "error"
                              : "success"
                          }
                          variant="outlined"
                        />
                      </Stack>
                    }
                    secondary={
                      <>
                        <Typography
                          component="span"
                          variant="caption"
                          color="text.secondary"
                          display="block"
                        >
                          {r.displayTime}
                        </Typography>
                        <Typography variant="body2">{r.details}</Typography>
                      </>
                    }
                  />
                </ListItem>
              </Box>
            ))}
            {(!recentActivity || recentActivity.length === 0) && (
              <EmptyState text="No activity" />
            )}
          </List>
        </CardContent>
      </Card>
    </>
  );
};
