import {
  Dialog,
  DialogContent,
  Button,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
  Stack,
  IconButton,
  Tooltip,
  RadioGroup,
  FormControlLabel,
  Radio,
  LinearProgress,
  Fade,
  useTheme,
} from "@mui/material";

import GppBadIcon from "@mui/icons-material/GppBad";
import GppGoodIcon from "@mui/icons-material/GppGood";
import CloseIcon from "@mui/icons-material/Close";
import PictureAsPdfOutlinedIcon from "@mui/icons-material/PictureAsPdfOutlined";
import ImageOutlinedIcon from "@mui/icons-material/ImageOutlined";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";

import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import { toPng } from "html-to-image";
import { useRef, useState, useEffect, useMemo } from "react";

import GlifReportsStyles from "../../glifReports/GlifReportsStyles";
import CustomChip from "../../../utils/CustomChip";

/* ================= FORMAT ================= */

const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : "—";

/* ================= SUMMARY → FILE MAP ================= */

const SUMMARY_FILE_MAP = {
  BALANCE: "balance_compare_report",
  SIBA: "intr_report",
  SUSPENSE: "cntr_report",
};

/* ====================================================== */

const ProcessSummaryDialog = ({
  open,
  data,
  onClose,
  onAccept,
  onReject,
  onDownload,
  downloadProgress,
  permissions = {},
}) => {
  const reportRef = useRef(null);
  const copyTimeoutRef = useRef(null);

  const [copied, setCopied] = useState(false);
  const [summaryType, setSummaryType] = useState("BALANCE");

  const theme = useTheme();
  const styles = GlifReportsStyles(theme);

  if (!data) return null;

  /* ================= DATA ================= */

  const {
    RECON_RUN_DATE,
    summary = [],
    differenceSummary = [],
    sibaSummary = [],
    suspenseSummary = [],
    stages = [],
  } = data;

  /* ================= STAGE CHECK ================= */

  const balanceDone = stages.some(
    (s) => s.stageId === "balance_Compare_generated" && s.stageStatus === 2,
  );

  const sibaDone = stages.some(
    (s) => s.stageId === "INTR_Report_generated" && s.stageStatus === 2,
  );

  const suspenseDone = stages.some(
    (s) => s.stageId === "CNTR_Report_generated" && s.stageStatus === 2,
  );

  const stageWaiting = stages.some(
    (s) => s.stageId === "waiting_for_approval" && s.stageStatus === 1,
  );

  /* ================= AVAILABLE TYPES ================= */

  const availableSummaryTypes = useMemo(() => {
    const arr = [];

    if (balanceDone) arr.push("BALANCE");
    if (sibaDone) arr.push("SIBA");
    if (suspenseDone) arr.push("SUSPENSE");

    return arr;
  }, [balanceDone, sibaDone, suspenseDone]);

  /* ================= AUTO FIX SELECTED TYPE ================= */

  useEffect(() => {
    if (!availableSummaryTypes.includes(summaryType)) {
      setSummaryType(availableSummaryTypes[0] || "BALANCE");
    }
  }, [availableSummaryTypes]);

  /* ================= ACTIVE SUMMARY ================= */

  const activeSummary = useMemo(() => {
    switch (summaryType) {
      case "BALANCE":
        return differenceSummary?.length ? differenceSummary : summary;

      case "SIBA":
        return sibaSummary || [];

      case "SUSPENSE":
        return suspenseSummary || [];

      default:
        return [];
    }
  }, [summaryType, differenceSummary, summary, sibaSummary, suspenseSummary]);

  /* ================= TOTALS ================= */

  const totalEntries = useMemo(
    () =>
      activeSummary.reduce(
        (sum, r) => sum + (r.Total_no_of_entries || 0),
        0,
      ),
    [activeSummary],
  );

  const totalNewEntries = useMemo(
    () =>
      activeSummary.reduce(
        (sum, r) => sum + (r["new entry"] || 0),
        0,
      ),
    [activeSummary],
  );

  /* ================= EXPORT PDF ================= */

  const exportPDF = () => {
    const doc = new jsPDF("p", "pt");

    doc.setFontSize(14);
    doc.text(`${summaryType} Summary Report`, 40, 40);

    doc.setFontSize(10);
    doc.text(`Reconciliation Date: ${RECON_RUN_DATE}`, 40, 58);

    autoTable(doc, {
      startY: 80,
      head: [["HEAD", "TOTAL ENTRIES", "NEW ENTRIES"]],
      body: [
        ...activeSummary.map((r) => [
          r.HEAD,
          formatAmount(r.Total_no_of_entries),
          formatAmount(r["new entry"]),
        ]),
        ["TOTAL", formatAmount(totalEntries), formatAmount(totalNewEntries)],
      ],
      styles: { halign: "right", fontSize: 9 },
      headStyles: { fillColor: [33, 150, 243] },
      columnStyles: { 0: { halign: "left" } },
      didParseCell: (d) => {
        if (d.row.index === activeSummary.length) {
          d.cell.styles.fontStyle = "bold";
        }
      },
    });

    doc.save(`${summaryType}_Summary_${RECON_RUN_DATE}.pdf`);
  };

  /* ================= COPY PNG ================= */

  const copyPNGToClipboard = async () => {
    if (!reportRef.current) return;

    try {
      const dataUrl = await toPng(reportRef.current, {
        cacheBust: true,
        backgroundColor: "#ffffff",
        pixelRatio: 2,
      });

      const blob = await (await fetch(dataUrl)).blob();

      await navigator.clipboard.write([
        new ClipboardItem({ "image/png": blob }),
      ]);

      setCopied(true);

      clearTimeout(copyTimeoutRef.current);

      copyTimeoutRef.current = setTimeout(
        () => setCopied(false),
        2000,
      );
    } catch (err) {
      console.error(err);
    }
  };

  const downloadedMB =
    downloadProgress?.loadedBytes > 0
      ? (downloadProgress.loadedBytes / (1024 * 1024)).toFixed(2)
      : null;

  /* ====================================================== */

  return (
    <Dialog open={open} fullWidth maxWidth="md">
      {/* HEADER */}

      <Box sx={styles.header}>
        <Box>
          <Typography variant="h6" fontWeight={700}>
            {summaryType} Summary Report
          </Typography>

          <Typography variant="body2" color="text.secondary">
            Reconciliation Date: {RECON_RUN_DATE}
          </Typography>
        </Box>

        <Stack direction="row">
          <Tooltip title="Export PDF">
            <IconButton onClick={exportPDF}>
              <PictureAsPdfOutlinedIcon />
            </IconButton>
          </Tooltip>

          <Tooltip title="Copy as Image">
            <IconButton onClick={copyPNGToClipboard}>
              {copied ? (
                <CheckCircleOutlineIcon color="success" />
              ) : (
                <ImageOutlinedIcon />
              )}
            </IconButton>
          </Tooltip>

          <IconButton onClick={onClose}>
            <CloseIcon />
          </IconButton>
        </Stack>
      </Box>

      {/* BODY */}

      <DialogContent>
        {/* RADIO */}

        {permissions.download && availableSummaryTypes.length > 0 && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Stack direction="row" justifyContent="space-between">
              <RadioGroup
                row
                value={summaryType}
                onChange={(e) => setSummaryType(e.target.value)}
              >
                {availableSummaryTypes.includes("BALANCE") && (
                  <FormControlLabel
                    value="BALANCE"
                    control={<Radio />}
                    label="Balance Compare"
                  />
                )}

                {availableSummaryTypes.includes("SIBA") && (
                  <FormControlLabel
                    value="SIBA"
                    control={<Radio />}
                    label="SIBA"
                  />
                )}

                {availableSummaryTypes.includes("SUSPENSE") && (
                  <FormControlLabel
                    value="SUSPENSE"
                    control={<Radio />}
                    label="Suspense"
                  />
                )}
              </RadioGroup>

              <Button
                startIcon={<CloudDownloadTwoToneIcon />}
                variant="contained"
                onClick={() =>
                  onDownload(
                    SUMMARY_FILE_MAP[summaryType],
                    RECON_RUN_DATE,
                  )
                }
                disabled={downloadProgress?.inProgress}
              >
                Download Full Report
              </Button>
            </Stack>

            <Fade in={downloadProgress?.inProgress}>
              <Box sx={{ mt: 2 }}>
                <Typography variant="body2">
                  Downloading {SUMMARY_FILE_MAP[summaryType]}{" "}
                  {downloadedMB && `(${downloadedMB} MB)`}
                </Typography>

                <LinearProgress />
              </Box>
            </Fade>
          </Paper>
        )}

        {/* TABLE */}

        <TableContainer component={Paper} ref={reportRef}>
          <Table stickyHeader size="small">
            <TableHead>
              <TableRow>
                <TableCell sx={{ fontWeight: 600 }}>HEAD</TableCell>

                <TableCell align="right" sx={{ fontWeight: 600 }}>
                  TOTAL ENTRIES
                </TableCell>

                <TableCell align="right" sx={{ fontWeight: 600 }}>
                  NEW ENTRIES
                </TableCell>
              </TableRow>
            </TableHead>

            <TableBody>
              {activeSummary.map((row, i) => (
                <TableRow key={i}>
                  <TableCell>{row.HEAD}</TableCell>

                  <TableCell align="right">
                    {formatAmount(row.Total_no_of_entries)}
                  </TableCell>

                  <TableCell align="right">
                    {formatAmount(row["new entry"])}
                  </TableCell>
                </TableRow>
              ))}

              <TableRow sx={{ bgcolor: "#f5f5f5" }}>
                <TableCell sx={{ fontWeight: 700 }}>TOTAL</TableCell>

                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalEntries)}
                </TableCell>

                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalNewEntries)}
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </TableContainer>
      </DialogContent>

      {/* FOOTER */}

      {stageWaiting && (
        <Box sx={styles.footer}>
          <Button
            color="error"
            variant="outlined"
            startIcon={<GppBadIcon />}
            onClick={() => onReject(summaryType)}
          >
            Reject
          </Button>

          <Button
            color="success"
            variant="contained"
            startIcon={<GppGoodIcon />}
            onClick={() => onAccept(summaryType)}
          >
            Accept
          </Button>
        </Box>
      )}
    </Dialog>
  );
};

export default ProcessSummaryDialog;