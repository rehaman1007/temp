import React, { useCallback, useMemo, useState } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  Tooltip,
  Stack,
  Chip,
} from "@mui/material";
import { Close, DoneAll, NotificationsNone } from "@mui/icons-material";
import { formatRelativeTime } from "../utils/CommonUtilities";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { useNavigate } from "react-router-dom";
import { styles } from "./NotificationDrawer.styles";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
  markAsRead,
  loadMore,
  hasMore,
}) => {
  const { navigateToPage } = useNavigateToPage();
  const navigate = useNavigate();
  const menuItems = useSelector((state) => state.menus.menus);

  // FILTER STATE
  const [filter, setFilter] = useState("all"); // all | unread | read

  // FIND MATCHED MENU (for header icon & title)
  const firstMatchedMenu = useMemo(() => {
    if (!notifications.length) return null;

    const n = notifications[0];
    return menuItems.find((m) => m.route === n.linkUrl) || null;
  }, [notifications, menuItems]);

  const headerTitle = firstMatchedMenu?.title || "Notifications";
  const HeaderIcon = firstMatchedMenu?.icon || NotificationsNone;

  // APPLY FILTER + SORT
  const filteredList = useMemo(() => {
    const list =
      filter === "read"
        ? notifications.filter((n) => n.read)
        : filter === "unread"
        ? notifications.filter((n) => !n.read)
        : notifications;

    return [...list].sort(
      (a, b) => new Date(b.createdAt) - new Date(a.createdAt)
    );
  }, [filter, notifications]);

  const handleMarkAllAsRead = () => {
    console.log("Marking all notifications as read (placeholder)");
  };

  const handleMessageClick = useCallback(
    (row) => {
      markAsRead(row.id);

      const foundMenu = menuItems.find((m) => m.route === row.linkUrl);
      if (foundMenu) {
        navigateToPage(foundMenu);
        setNotificationDrawerOpen(false);
      }
    },
    [markAsRead, navigate, menuItems]
  );

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": styles.drawerPaper,
      }}
    >
      {/* Header */}
      <Box sx={styles.header}>
        <Stack direction="row" alignItems="center" spacing={1}>
          <HeaderIcon sx={{ opacity: 0.7 }} />
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            {headerTitle}
          </Typography>
        </Stack>

        <Stack direction="row" alignItems="center" spacing={1}>
          {!!notifications.length && (
            <Tooltip title="Mark all as read">
              <IconButton size="small" onClick={handleMarkAllAsRead}>
                <DoneAll color="primary" />
              </IconButton>
            </Tooltip>
          )}

          <IconButton
            size="small"
            onClick={() => setNotificationDrawerOpen(false)}
          >
            <Close />
          </IconButton>
        </Stack>
      </Box>

      {/* Filters */}
      <Box sx={{ px: 3 }}>
        <Stack sx={styles.chipContainer}>
          <Chip
            label="All"
            variant={filter === "all" ? "filled" : "outlined"}
            onClick={() => setFilter("all")}
          />
          <Chip
            label="Unread"
            color="primary"
            variant={filter === "unread" ? "filled" : "outlined"}
            onClick={() => setFilter("unread")}
          />
          <Chip
            label="Read"
            color="success"
            variant={filter === "read" ? "filled" : "outlined"}
            onClick={() => setFilter("read")}
          />
        </Stack>
      </Box>

      {/* Notification List */}
      {!filteredList.length ? (
        <Box sx={styles.emptyWrapper}>
          <NotificationsNone sx={{ fontSize: 50, mb: 1, opacity: 0.6 }} />
          <Typography>No notifications</Typography>
        </Box>
      ) : (
        <Box sx={styles.notificationList}>
          {filteredList.map((n) => {
            const isRead = n.read;

            return (
              <Paper
                key={n.id}
                sx={styles.notificationPaper(isRead)}
                onClick={() => handleMessageClick(n)}
              >
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: isRead ? 500 : 600,
                    color: isRead ? "text.primary" : "#2E2E2E",
                  }}
                >
                  {n.message}
                </Typography>

                <Stack direction="row" spacing={2} alignItems="center">
                  <Box
                    sx={{
                      width: 8,
                      height: 8,
                      borderRadius: "50%",
                      backgroundColor: !isRead ? "#10B981" : "#F59E0B",
                      mt: 1,
                    }}
                  />
                  <Typography
                    variant="caption"
                    sx={{ color: "text.secondary", mt: 0.5 }}
                  >
                    {formatRelativeTime(n.createdAt)}
                  </Typography>
                </Stack>
              </Paper>
            );
          })}
        </Box>
      )}

      {/* Footer */}
      {notifications.length > 0 && (
        <Box sx={styles.footer}>
          {hasMore ? (
            <Button fullWidth variant="outlined" onClick={loadMore}>
              Show More
            </Button>
          ) : (
            <Typography
              variant="body2"
              color="text.secondary"
              align="center"
              sx={{ py: 1 }}
            >
              No more notifications
            </Typography>
          )}
        </Box>
      )}
    </Drawer>
  );
};

export default NotificationDrawer;

// NotificationDrawer.styles.js
import { alpha } from "@mui/material";

export const styles = {
  drawerPaper: {
    width: 400,
    p: 0,
    display: "flex",
    flexDirection: "column",
  },

  header: {
    p: 3,
    borderBottom: "1px solid #E2E8F0",
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between",
    gap: 1,
  },

  notificationList: {
    flex: 1,
    overflowY: "auto",
    p: 2,
    display: "flex",
    flexDirection: "column",
    gap: 1.6,
  },

  emptyWrapper: {
    flex: 1,
    textAlign: "center",
    mt: 4,
    color: "text.secondary",
  },

  footer: {
    p: 2,
    borderTop: "1px solid #E2E8F0",
  },

  chipContainer: {
    display: "flex",
    gap: 1,
    mt: 1,
  },

  notificationPaper: (isRead) => ({
    p: 2,
    borderRadius: 2,
    border: isRead ? "1px solid #E2E8F0" : "1px solid #5D3FD3",
    backgroundColor: isRead ? alpha("#5D3FD3", 0.06) : "#FFFFFF",
    transition: "all 0.25s ease",
    cursor: "pointer",
    "&:hover": {
      backgroundColor: isRead
        ? alpha("#5D3FD3", 0.1)
        : alpha("#A28DF0", 0.15),
      transform: "translateY(-2px)",
    },
  }),
};