  // HANDLE EXECUTE
  const handleExecute = useCallback(
    (reset = false, customSql = null) => {
      // Use customSql if provided (Single Statement), otherwise fallback to the full editor query (Script)
      const targetSql = customSql !== null ? customSql : query;

      if (!targetSql.trim()) {
        showSnackbar("Enter SQL query to execute", "warning");
        return;
      }

      setLastExecutedQuery(targetSql);
      setSelectedFile(null);
      setJobId(null);
      setJobStatus(null);
      setLastResponse(null);

      const page = reset ? 0 : paginationModel.page;

      if (reset) {
        setPaginationModel((p) => ({
          ...p,
          page: 0,
        }));
      }

      executeSql({
        sql: targetSql,
        page,
        size: paginationModel.pageSize,
      });
    },
    [
      executeSql,
      paginationModel.page,
      paginationModel.pageSize,
      query,
      showSnackbar,
    ]
  );

