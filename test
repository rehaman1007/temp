<!-- FIXED MAIN QUERY -->
<queryString language="SQL">
<![CDATA[
SELECT
    CM.CIRCLE_NAME,
    T1.BRANCH_CODE,
    T1.CURRENCY,
    T1.CGL,
    COALESCE(T1.BALANCE,0) AS TODAY_BALANCE,
    COALESCE(T2.BALANCE,0) AS YESTERDAY_BALANCE,
    COALESCE(T1.BALANCE,0) - COALESCE(T2.BALANCE,0) AS DIFFERENCE,
    BM.NAME AS BRANCH_NAME
FROM GL_BALANCE T1
JOIN BRANCH_MASTER BM ON T1.BRANCH_CODE = BM.CODE
LEFT JOIN CIRCLE_MASTER CM ON BM.CIRCLE_CODE = CM.CIRCLE_CODE
LEFT JOIN GL_BALANCE T2
 ON T1.BRANCH_CODE = T2.BRANCH_CODE
 AND T1.CURRENCY = T2.CURRENCY
 AND T1.CGL = T2.CGL
 AND T2.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy') - 1
WHERE
 T1.BALANCE_DATE = TO_DATE($P{date}, 'dd/MM/yyyy')
ORDER BY
 CM.CIRCLE_NAME,
 T1.CGL,
 T1.BRANCH_CODE,
 T1.CURRENCY
]]>
</queryString>

