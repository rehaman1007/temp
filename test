  <Button
    startIcon={<PlayArrowIcon />}
    disabled={lastStatus === StageStatus.STARTED}
    onClick={() => onStart(process)}
  >
    Start
  </Button>

  <Button
    startIcon={<StopIcon />}
    disabled={lastStatus !== StageStatus.STARTED}
    onClick={() => onStop(process)}
  >
    Stop
  </Button>
</DialogActions>