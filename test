import React from "react";

import {
  Alert,
  AlertTitle,
  alpha,
  Box,
  Chip,
  Divider,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";

import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";

const LogsPanel = ({
  lastResponse,
  jobStatus,
}) => {
  const theme = useTheme();

  /**
   * =========================================
   * EMPTY STATE
   * =========================================
   */
  if (!lastResponse && !jobStatus) {
    return (
      <Paper
        elevation={0}
        sx={{
          borderRadius: 3,
          border: `1px solid ${theme.palette.divider}`,
          overflow: "hidden",
        }}
      >
        <Box
          sx={{
            px: 2.5,
            py: 1.5,

            background:
              "linear-gradient(135deg,#111827,#1f2937)",

            color: "white",
          }}
        >
          <Stack
            direction="row"
            spacing={1.5}
            alignItems="center"
          >
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>
              Execution Logs
            </Typography>
          </Stack>
        </Box>

        <Box p={3}>
          <Alert
            severity="info"
            icon={<Info />}
            sx={{
              borderRadius: 3,
            }}
          >
            <AlertTitle>
              Waiting for execution
            </AlertTitle>

            Execute SQL query or upload script
            to view logs.
          </Alert>
        </Box>
      </Paper>
    );
  }

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* ================================================= */}
      {/* HEADER */}
      {/* ================================================= */}

      <Box
        sx={{
          px: 2.5,
          py: 1.5,

          background:
            "linear-gradient(135deg,#111827,#1f2937)",

          color: "white",

          borderBottom:
            "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          {/* LEFT */}

          <Stack
            direction="row"
            spacing={1.5}
            alignItems="center"
          >
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>
              Execution Logs
            </Typography>
          </Stack>

          {/* STATUS */}

          {jobStatus?.status && (
            <Chip
              size="small"
              label={jobStatus.status}
              color={
                jobStatus.status ===
                "COMPLETED"
                  ? "success"
                  : jobStatus.status ===
                      "FAILED"
                    ? "error"
                    : "warning"
              }
            />
          )}
        </Stack>
      </Box>

      {/* ================================================= */}
      {/* TERMINAL BODY */}
      {/* ================================================= */}

      <Box
        sx={{
          p: 2.5,

          bgcolor: "#020617",

          color: "#e2e8f0",

          fontFamily: "monospace",

          flex: 1,

          overflow: "auto",

          minHeight: 400,
        }}
      >
        {/* ============================================= */}
        {/* JOB STATUS */}
        {/* ============================================= */}

        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#38bdf8",
                mb: 1,
              }}
            >
              {">"} JOB STATUS
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,
                borderRadius: 2,

                bgcolor:
                  "rgba(255,255,255,0.03)",

                border:
                  "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack spacing={1}>
                <Typography>
                  STATUS :{" "}
                  {jobStatus.status}
                </Typography>

                <Typography>
                  JOB ID :{" "}
                  {jobStatus.jobId}
                </Typography>

                <Typography>
                  EXECUTED :{" "}
                  {jobStatus.executedCount ||
                    0}
                </Typography>

                <Typography>
                  TOTAL :{" "}
                  {jobStatus.totalStatements ||
                    0}
                </Typography>

                <Typography>
                  ELAPSED :{" "}
                  {jobStatus.elapsedSeconds ||
                    0}{" "}
                  sec
                </Typography>

                <Typography>
                  PROGRESS :{" "}
                  {jobStatus.progress || 0}
                  %
                </Typography>
              </Stack>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* ERROR */}
        {/* ============================================= */}

        {(lastResponse?.error ||
          jobStatus?.status ===
            "FAILED") && (
          <>
            <Typography
              sx={{
                color: "#f87171",
                mb: 1,
              }}
            >
              {">"} ERROR LOG
            </Typography>

            <Alert
              severity="error"
              icon={<ErrorOutline />}
              sx={{
                mb: 3,
                borderRadius: 3,
              }}
            >
              <AlertTitle>
                Execution Failed
              </AlertTitle>

              {lastResponse?.message ||
                jobStatus?.message ||
                "Unknown error"}

              {jobStatus?.failedLine && (
                <>
                  <Divider
                    sx={{
                      my: 1,
                    }}
                  />

                  Failed Line :{" "}
                  {jobStatus.failedLine}
                </>
              )}
            </Alert>
          </>
        )}

        {/* ============================================= */}
        {/* FAILED SQL */}
        {/* ============================================= */}

        {jobStatus?.failedSql && (
          <>
            <Typography
              sx={{
                color: "#fb7185",
                mb: 1,
              }}
            >
              {">"} FAILED SQL
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,

                borderRadius: 2,

                bgcolor: "#111827",

                border:
                  "1px solid rgba(248,113,113,0.2)",

                overflowX: "auto",
              }}
            >
              <Typography
                sx={{
                  whiteSpace: "pre-wrap",
                  color: "#fca5a5",
                  fontSize: 13,
                  lineHeight: 1.8,
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* SUCCESS */}
        {/* ============================================= */}

        {lastResponse &&
          !lastResponse.error && (
            <>
              <Typography
                sx={{
                  color: "#4ade80",
                  mb: 1,
                }}
              >
                {">"} EXECUTION SUCCESS
              </Typography>

              <Alert
                severity="success"
                icon={<CheckCircle />}
                sx={{
                  mb: 3,
                  borderRadius: 3,
                }}
              >
                <AlertTitle>
                  SQL Executed Successfully
                </AlertTitle>

                {lastResponse?.rows?.[0]
                  ?.RESULT ||
                  "Execution completed successfully"}
              </Alert>
            </>
          )}

        {/* ============================================= */}
        {/* SUMMARY */}
        {/* ============================================= */}

        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#c084fc",
                mb: 1,
              }}
            >
              {">"} EXECUTION SUMMARY
            </Typography>

            <Box
              sx={{
                p: 2,

                borderRadius: 2,

                bgcolor: alpha(
                  theme.palette.primary.main,
                  0.08,
                ),

                border:
                  "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack
                direction="row"
                spacing={1}
                flexWrap="wrap"
                useFlexGap
              >
                <Chip
                  label={`INSERT : ${
                    jobStatus.insertCount ||
                    0
                  }`}
                  color="success"
                  size="small"
                />

                <Chip
                  label={`UPDATE : ${
                    jobStatus.updateCount ||
                    0
                  }`}
                  color="warning"
                  size="small"
                />

                <Chip
                  label={`DELETE : ${
                    jobStatus.deleteCount ||
                    0
                  }`}
                  color="error"
                  size="small"
                />

                <Chip
                  label={`OTHERS : ${
                    jobStatus.otherCount ||
                    0
                  }`}
                  color="primary"
                  size="small"
                />
              </Stack>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* RUNNING */}
        {/* ============================================= */}

        {jobStatus?.status ===
          "RUNNING" && (
          <Alert
            severity="warning"
            icon={<WarningAmber />}
            sx={{
              mt: 3,
              borderRadius: 3,
            }}
          >
            Execution still in progress...
          </Alert>
        )}
      </Box>
    </Paper>
  );
};

export default LogsPanel;