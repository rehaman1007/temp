import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";

export default function AcceptRejectCGL() {
  const transformData = (data) => {
    return data.map((row) => {
      const parsed = row.payload ? JSON.parse(row.payload) : {};
      return {
        ...row,
        description: parsed.description || "",
        cglCode: `${parsed.comp1 || ""} ${parsed.segmentCode || ""} ${parsed.comp2 || ""}`
      };
    });
  };

  const columns = [
    { field: "cglCode", headerName: "CGL Code", flex: 0.5 },
    { field: "description", headerName: "CGL Description", flex: 1.3 },
    {
      field: "changeType",
      headerName: "Request Type",
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const val = params.value;
        return (
          <Box>
            {val === "A" ? <Chip icon={<AddBoxIcon />} label="Added" size="small" /> :
             val === "D" ? <Chip icon={<AutoDeleteIcon />} label="Deleted" size="small" /> :
             <Chip icon={<EditDocumentIcon />} label="Modified" size="small" />}
          </Box>
        );
      }
    },
    {
      field: "creatorId",
      headerName: "Creator ID",
      flex: 0.8,
      renderCell: (params) => <Chip icon={<AccountCircleIcon />} label={params.value} size="small" />
    },
    { field: "reqDate", headerName: "Requested Date", flex: 1 }
  ];

  return (
    <CommonRequestScreen
      apiUrl="/CR/pending-requests"
      patchUrl="/CR/patch-request"
      columns={columns}
      transformData={transformData}
      defaultSort={{ field: "reqDate", sort: "desc" }}
    />
  );
}