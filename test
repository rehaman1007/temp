<Autocomplete
            multiple
            autoHighlight // Added autoHighlight as requested
            options={allPermissions}
            value={selectedPermissions}
            inputValue={permissionSearch}
            clearOnBlur={false}
            disableClearable
            filterSelectedOptions={false}
            disableCloseOnSelect
            onInputChange={(event, newInputValue, reason) => {
              if (reason === "input") {
                setPermissionSearch(newInputValue);
              }
            }}
            onChange={handlePermissionsSelect}
            isOptionEqualToValue={(opt, val) => opt.id === val.id}
            getOptionLabel={(option) =>
              option.menuSubmenu
                ? `${option.title} ${option.menuSubmenu}`
                : option.title
            }
            renderOption={(props, option, { selected }) => {
              const isRestricted = option.isRestricted === "Y";
              const actions = option.menuAction
                ? option.menuAction.split("|").filter(Boolean)
                : [];

              return (
                <li
                  {...props}
                  key={option.id}
                  style={{
                    alignItems: "flex-start",
                    paddingTop: 8,
                    paddingBottom: 8,
                    borderBottom: "1px solid #f0f0f0",
                  }}
                >
                  <Checkbox
                    checked={selected}
                    sx={{ mr: 1, p: 0.5, mt: -0.5 }}
                  />
                  <Box
                    display="flex"
                    flexDirection="column"
                    gap={0.5}
                    width="100%"
                  >
                    {/* Top Row: Title, Submenu Chip, Restricted Badge */}
                    <Box
                      display="flex"
                      alignItems="center"
                      gap={1}
                      flexWrap="wrap"
                    >
                      <ListItemIcon
                        sx={{
                          minWidth: "auto",
                          color: isRestricted ? "warning.main" : "primary.main",
                        }}
                      >
                        {renderIcon(option.icon)}
                      </ListItemIcon>

                      <Typography
                        variant="body2"
                        fontWeight={selected ? 600 : 400}
                      >
                        {option.menuSubmenu ? option.menuSubmenu : option.title}
                      </Typography>

                      {option.menuSubmenu && (
                        <Chip
                          label={option.title}
                          size="small"
                          sx={{
                            height: 20,
                            fontSize: "0.65rem",
                            bgcolor: "rgba(0,0,0,0.06)",
                          }}
                        />
                      )}

                      {isRestricted && (
                        <Chip
                          icon={
                            <LockOutlinedIcon
                              sx={{ fontSize: "14px !important" }}
                            />
                          }
                          label="Restricted"
                          size="small"
                          color="warning"
                          variant="outlined"
                          sx={{
                            height: 20,
                            fontSize: "0.65rem",
                            "& .MuiChip-icon": { ml: 0.5 },
                          }}
                        />
                      )}
                    </Box>

                    {/* Bottom Row: Actions */}
                    {actions.length > 0 && (
                      <Stack
                        direction="row"
                        spacing={0.5}
                        flexWrap="wrap"
                        sx={{ ml: 4 }}
                      >
                        {actions.map((act, idx) => (
                          <Chip
                            key={idx}
                            label={act.charAt(0).toUpperCase() + act.slice(1)}
                            size="small"
                            sx={{
                              height: 18,
                              fontSize: "0.65rem",
                              bgcolor: "action.selected",
                              border: "1px solid",
                              borderColor: "divider",
                            }}
                          />
                        ))}
                      </Stack>
                    )}
                  </Box>
                </li>
              );
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                label="Role Permissions *"
                helperText="A role must include one or more permissions"
                fullWidth
              />
            )}
            renderTags={() => null}
          />
