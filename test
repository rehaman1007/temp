package com.fincore.transactions_service.service;

import java.io.IOException;
import java.sql.ResultSetMetaData;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import com.fincore.transactions_service.dto.GetPayloadDTO;
import com.fincore.transactions_service.dto.GetResponseDTO;
import com.fincore.transactions_service.model.GLBalance;
import com.fincore.transactions_service.model.GlTransactions;
import com.fincore.transactions_service.repository.GLBalanceRepository;
import com.fincore.transactions_service.repository.GlTransactionsRepository;
import com.fincore.transactions_service.service.utils.TransactionsExcelGenerator;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@Service("TransactionsService")
@RequiredArgsConstructor
public class TransactionsServiceImpl implements TransactionsService {

	private final JdbcTemplate jdbcTemplate;

	private final GlTransactionsRepository glTransactionsRepository;
	private final GLBalanceRepository glBalanceRepository;

	private static final int TRANSACTIONS_THRESHOLD = 2000;

	@Override
	public Map<String, Object> getTransactionsData(GetPayloadDTO getPayloadDTO) {
		log.info("GetPayloadDTO>>>>" + getPayloadDTO);

		String branch = getPayloadDTO.getBranch();
		String currency = getPayloadDTO.getCurrency();
		String cgl = getPayloadDTO.getCgl();
		String fromDate = getPayloadDTO.getFromDate();
		String toDate = getPayloadDTO.getToDate();

		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

		LocalDate formattedFromDate = LocalDate.parse(fromDate, formatter);
		LocalDate formattedToDate = LocalDate.parse(toDate, formatter);

		LocalDate fromMinusOneDay = formattedFromDate.minusDays(1);

		GLBalance openingGLBalance = glBalanceRepository.getGlBalanceData(fromMinusOneDay.format(formatter), branch,
				currency, cgl);
		GLBalance closingGLBalance = glBalanceRepository.getGlBalanceData(formattedToDate.format(formatter), branch,
				currency, cgl);

		List<GetResponseDTO> responseList = new ArrayList<>();
		Map<String, Object> finalMap = new HashMap<>();

		if (openingGLBalance != null && closingGLBalance != null) {

			finalMap = new HashMap<>();
			finalMap.put("openingBalance", openingGLBalance.getBalance());
			finalMap.put("closingBalance", closingGLBalance.getBalance());

			Long count = glTransactionsRepository.getDataCount(branch, currency, cgl, fromDate, toDate);

			if (count <= TRANSACTIONS_THRESHOLD) {

				List<GlTransactions> transactionsList = glTransactionsRepository.getData(branch, currency, cgl,
						fromDate, toDate);

				double runningBalance = openingGLBalance.getBalance();

				for (GlTransactions individualTransaction : transactionsList) {
					GetResponseDTO transactionDTO = new GetResponseDTO();

					double transactionAmount = individualTransaction.getDebitAmount()
							+ individualTransaction.getCreditAmount();

					runningBalance += transactionAmount;

					transactionDTO.setDate(formatter.format(individualTransaction.getTransactionDate()));
					transactionDTO.setJournalNumber(individualTransaction.getJournalId());
					transactionDTO.setParticulars(individualTransaction.getNarration());
					transactionDTO.setCreditAmount(individualTransaction.getCreditAmount());
					transactionDTO.setDebitAmount(individualTransaction.getDebitAmount());
					transactionDTO.setBalance(runningBalance);

					responseList.add(transactionDTO);
				}
				finalMap.put("transactions", responseList);
			} else {
				finalMap.put("count", count);
			}
		}
		return finalMap;
	}

	@Override
	public byte[] getTransactionsFile(GetPayloadDTO getPayloadDTO) throws IOException {
		log.info("GetPayloadDTO>>>>" + getPayloadDTO);

		String branch = getPayloadDTO.getBranch();
		String currency = getPayloadDTO.getCurrency();
		String cgl = getPayloadDTO.getCgl();
		String fromDate = getPayloadDTO.getFromDate();
		String toDate = getPayloadDTO.getToDate();

		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

		LocalDate formattedFromDate = LocalDate.parse(fromDate, formatter);

		LocalDate fromMinusOneDay = formattedFromDate.minusDays(1);

		GLBalance openingGLBalance = glBalanceRepository.getGlBalanceData(fromMinusOneDay.format(formatter), branch,
				currency, cgl);

		if (openingGLBalance == null) {
			return null;
		}

		List<GlTransactions> transactionsList = glTransactionsRepository.getData(branch, currency, cgl, fromDate,
				toDate);

		return TransactionsExcelGenerator.getFileContents(branch, currency, cgl, fromDate, toDate, transactionsList,
				openingGLBalance.getBalance());
	}

	@Override
	public Map<String, Object> executeAdminSql(GetPayloadDTO getPayloadDTO) {
		String sql = getPayloadDTO.getSql().trim();
		log.info("Executing Admin SQL with Pagination: {}", sql);

		// Default pagination values if not provided by FE
		int page = (getPayloadDTO.getPage() != null) ? getPayloadDTO.getPage() : 0;
		int size = (getPayloadDTO.getSize() != null) ? getPayloadDTO.getSize() : 50;

		// 1. Syntax Validation using EXPLAIN PLAN (Does not execute the actual query)
		try {
			jdbcTemplate.execute("EXPLAIN PLAN FOR " + sql);
		} catch (DataAccessException e) {
			log.error("SQL Syntax Error: {}", e.getMostSpecificCause().getMessage());
			return Map.of(
					"error", true,
					"message", "Oracle Syntax Error: " + e.getMostSpecificCause().getMessage()
			);
		}

		boolean isSelect = sql.toUpperCase().startsWith("SELECT");

		if (isSelect) {
			// 2. Server-Side Pagination (Oracle 12c+ Syntax)
			String paginatedSql = String.format("%s OFFSET %d ROWS FETCH NEXT %d ROWS ONLY",
					sql, (page * size), size);

			return jdbcTemplate.query(paginatedSql, rs -> {
				ResultSetMetaData metaData = rs.getMetaData();
				int columnCount = metaData.getColumnCount();

				// Prepare Columns
				List<Map<String, String>> columns = new ArrayList<>();
				for (int i = 1; i <= columnCount; i++) {
					Map<String, String> col = new HashMap<>();
					col.put("name", metaData.getColumnLabel(i));
					columns.add(col);
				}

				// Prepare Rows
				List<Map<String, Object>> rows = new ArrayList<>();
				while (rs.next()) {
					Map<String, Object> row = new HashMap<>();
					for (int i = 1; i <= columnCount; i++) {
						Object value = rs.getObject(i);

						// Serialization & BLOB Safety
						if (value instanceof java.io.InputStream) {
							value = "[BINARY/BLOB DATA]";
						} else if (value != null && value.getClass().getName().startsWith("oracle.sql.")) {
							value = value.toString();
						}

						row.put(metaData.getColumnLabel(i), value);
					}
					rows.add(row);
				}

				Map<String, Object> result = new HashMap<>();
				result.put("columns", columns);
				result.put("rows", rows);
				result.put("page", page);
				result.put("size", size);
				result.put("error", false);
				return result;
			});
		} else {
			// For DELETE/TRUNCATE/UPDATE
			int affectedRows = jdbcTemplate.update(sql);

			List<Map<String, String>> columns = List.of(Map.of("name", "RESULT"));
			List<Map<String, Object>> rows = List.of(Map.of("RESULT", "Success: " + affectedRows + " rows affected"));

			Map<String, Object> result = new HashMap<>();
			result.put("columns", columns);
			result.put("rows", rows);
			result.put("error", false);
			return result;
		}
	}
}

