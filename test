switch (operator) {

    case "contains" ->
            predicates.add(cb.like(expression, "%" + value + "%"));

    case "startsWith" ->
            predicates.add(cb.like(expression, value + "%"));

    case "endsWith" ->
            predicates.add(cb.like(expression, "%" + value));

    case "equals" ->
            predicates.add(cb.equal(expression, value));

    case "is" ->
            predicates.add(cb.equal(expression, value));

    case "=" ->
            predicates.add(cb.equal(expression, value));

    case "not" ->
            predicates.add(cb.notEqual(expression, value));

    case "isAnyOf" -> {
        if (filter.getValue() instanceof List<?> values) {

            List<String> lowerValues = values.stream()
                    .map(Object::toString)
                    .map(String::toLowerCase)
                    .toList();

            predicates.add(expression.in(lowerValues));
        } else {

            predicates.add(cb.equal(
                    expression,
                    filter.getValue().toString().toLowerCase()
            ));
        }
    }

    case "isEmpty" ->
            predicates.add(cb.or(
                    cb.isNull(path),
                    cb.equal(expression, "")
            ));

    case "isNotEmpty" ->
            predicates.add(cb.and(
                    cb.isNotNull(path),
                    cb.notEqual(expression, "")
            ));
}

default -> throw new IllegalArgumentException(
        "Unsupported filter field : " + field
);
