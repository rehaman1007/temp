        private static final String FOREIGN_CIRCLE = "021";

        private static final long MAX_EXPORT_LIMIT = 1_000_000L;

        private static final int FETCH_SIZE = 20_000;

        private final JdbcTemplate jdbcTemplate;

        private final MyDownloadsService myDownloadsService;

        public byte[] export(
                        LedgerWiseBalanceRequest dto,
                        String userId) {

                if (dto.getEnquiryType() == ReportType.CONSOLIDATED) {
                        return exportConsolidated(dto, userId);
                }

                return exportCollation(dto, userId);
        }

        private byte[] exportCollation(
                        LedgerWiseBalanceRequest dto,
                        String userId) {

                validateCollationLimit(dto);

                try {

                        StringBuilder sql = new StringBuilder("""
                                        SELECT
                                            g.ID,
                                            g.BALANCE_DATE,

                                            b.CODE BRANCH_CODE,
                                            b.NAME BRANCH_NAME,

                                            c.CIRCLE_CODE,
                                            c.CIRCLE_NAME,

                                            g.CURRENCY,
                                            cu.CURRENCY_NAME,

                                            g.CGL,
                                            cg.DESCRIPTION,

                                            g.BALANCE,
                                            g.INR_BALANCE

                                        FROM GL_BALANCE g

                                        JOIN BRANCH_MASTER b
                                            ON g.BRANCH_CODE = b.CODE

                                        LEFT JOIN CIRCLE_MASTER c
                                            ON b.CIRCLE_CODE = c.CIRCLE_CODE

                                        LEFT JOIN CURRENCY_MASTER cu
                                            ON cu.CURRENCY_CODE = g.CURRENCY

                                        LEFT JOIN CGL_MASTER cg
                                            ON cg.CGL_NUMBER = g.CGL

                                        WHERE 1 = 1
                                        """);

                        List<Object> params = new ArrayList<>();

                        sql.append("""
                                        AND g.BALANCE_DATE =
                                            TO_DATE(?,'DD/MM/YYYY')
                                        """);

                        params.add(dto.getBalanceDate());

                        if (!dto.getCgls().contains("ALL")) {

                                sql.append(" AND g.CGL IN (");

                                sql.append(dto.getCgls()
                                                .stream()
                                                .map(v -> "?")
                                                .collect(Collectors.joining(",")));

                                sql.append(")");

                                params.addAll(dto.getCgls());
                        }

                        // Currency
                        if (!dto.getCurrencies().contains("ALL")) {

                                sql.append(" AND g.CURRENCY IN (");

                                sql.append(dto.getCurrencies()
                                                .stream()
                                                .map(v -> "?")
                                                .collect(Collectors.joining(",")));

                                sql.append(")");

                                params.addAll(dto.getCurrencies().stream().map(String::trim).toList());
                        }

                        // Circle

                        if ("DOMESTIC".equalsIgnoreCase(dto.getCircle())) {

                                sql.append(" AND c.CIRCLE_CODE <> ? ");

                                params.add(FOREIGN_CIRCLE);

                        } else if ("FOREIGN".equalsIgnoreCase(dto.getCircle())) {

                                sql.append(" AND c.CIRCLE_CODE = ? ");

                                params.add(FOREIGN_CIRCLE);

                        } else if (!"ALL".equalsIgnoreCase(dto.getCircle())) {

                                sql.append(" AND c.CIRCLE_CODE = ? ");

                                params.add(dto.getCircle());
                        }

                        // Branch

                        if (dto.getBranches() != null
                                        && !dto.getBranches().contains("ALL")
                                        && !dto.getBranches().isEmpty()) {

                                sql.append(" AND g.BRANCH_CODE IN (");

                                sql.append(dto.getBranches()
                                                .stream()
                                                .map(v -> "?")
                                                .collect(Collectors.joining(",")));

                                sql.append(")");

                                params.addAll(dto.getBranches());
                        }

                        // Only Non Zero

                        sql.append("""
                                        AND (
                                            NVL(g.BALANCE,0) <> 0
                                            OR NVL(g.INR_BALANCE,0) <> 0
                                        )
                                        """);

                        sql.append("""
                                        ORDER BY
                                            cg.CGL_NUMBER
                                        """);

                        log.info("Collation Export Started");

                        long start = System.currentTimeMillis();

                        try (SXSSFWorkbook workbook = new SXSSFWorkbook(1000);
                                        ByteArrayOutputStream out = new ByteArrayOutputStream()) {

                                workbook.setCompressTempFiles(true);

                                SXSSFSheet sheet = workbook.createSheet("Collation");

                                createCollationHeader(
                                                workbook,
                                                sheet,
                                                dto);

                                AtomicInteger rowNum = new AtomicInteger(4);

                                jdbcTemplate.setFetchSize(FETCH_SIZE);

                                jdbcTemplate.query(connection -> {

                                        PreparedStatement ps = connection.prepareStatement(sql.toString());

                                        ps.setFetchSize(FETCH_SIZE);

                                        for (int i = 0; i < params.size(); i++) {
                                                ps.setObject(i + 1, params.get(i));
                                        }

                                        return ps;

                                }, rs -> {

                                        Row row = sheet.createRow(rowNum.getAndIncrement());

                                        int col = 0;

                                        row.createCell(col++)
                                                        .setCellValue(rs.getLong("ID"));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("BALANCE_DATE")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("CIRCLE_CODE")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("CIRCLE_NAME")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("BRANCH_CODE")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("BRANCH_NAME")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("CURRENCY")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("CURRENCY_NAME")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("CGL")));

                                        row.createCell(col++)
                                                        .setCellValue(safeString(rs.getString("DESCRIPTION")));

                                        row.createCell(col++)
                                                        .setCellValue(
                                                                        rs.getBigDecimal("BALANCE") == null
                                                                                        ? 0
                                                                                        : rs.getBigDecimal("BALANCE")
                                                                                                        .doubleValue());

                                        row.createCell(col++)
                                                        .setCellValue(
                                                                        rs.getBigDecimal("INR_BALANCE") == null
                                                                                        ? 0
                                                                                        : rs.getBigDecimal(
                                                                                                        "INR_BALANCE")
                                                                                                        .doubleValue());

                                        if (rowNum.get() % 5000 == 0) {

                                                try {
                                                        sheet.flushRows(500);
                                                } catch (IOException e) {
                                                        throw new RuntimeException(e);
                                                }

                                                log.info(
                                                                "Processed {} rows",
                                                                rowNum.get());
                                        }

                                });

                                sheet.flushRows();

                                setColumnWidths(sheet);

                                workbook.write(out);

                                byte[] bytes = out.toByteArray();

                                workbook.dispose();

                                SearchCriteriaDTO search = new SearchCriteriaDTO();

                                search.setCircle(dto.getCircle());
                                search.setBranch(String.join(", ", dto.getBranches()));
                                search.setCurrency(String.join(", ", dto.getCurrencies()));
                                search.setCgl(String.join(", ", dto.getCgls()));
                                search.setBalanceDate(dto.getBalanceDate());

                                sendToMyDownloads(
                                                userId,
                                                dto,
                                                search,
                                                bytes);

                                log.info(
                                                "Collation Export Completed in {} sec",
                                                (System.currentTimeMillis() - start) / 1000);

                                return bytes;
                        }

                } catch (IOException e) {
                        log.error("Colation Export Failed", e);
                        throw new RuntimeException("Failed to generate Excel", e);
                } catch (DataAccessException e) {
                        log.error("DataBase error during export", e);
                        throw new RuntimeException("Database error during export", e);
                }
        }

