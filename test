if (!fromDate?.isValid?.() || !toDate?.isValid?.()) {
      showSnackBar("Invalid date selected", "warning");
      return;
    }

    if (fromDate.isBefore(MIN_ALLOWED_DATE, "day")) {
      showSnackBar(
        `From date cannot be earlier than ${MIN_ALLOWED_DATE.format(
          DATE_FORMAT,
        )}`,
        "warning",
      );
      return;
    }

    if (toDate.isBefore(MIN_ALLOWED_DATE, "day")) {
      showSnackBar(
        `To date cannot be earlier than ${MIN_ALLOWED_DATE.format(
          DATE_FORMAT,
        )}`,
        "warning",
      );
      return;
    }

    if (fromDate.isAfter(toDate, "day")) {
      showSnackBar("From date cannot be greater than To date", "warning");
      return;
    }

    if (toDate.isAfter(fromDate.add(1, "year"), "day")) {
      showSnackBar("Date range cannot exceed 12 months", "warning");
      return;
    }

    if (etlDate?.isValid?.() && toDate.isAfter(etlDate, "day")) {
      showSnackBar(
        `To date cannot exceed ETL date ${etlDate.format(DATE_FORMAT)}`,
        "warning",
      );
      return;
    }
