import { Dialog, DialogActions, DialogContent, Button } from "@mui/material";
import { Add, Edit } from "@mui/icons-material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import { useEffect, useRef, useState } from "react";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { DialogTitleStyle } from "./BranchMasterStyle";

/* ================= INITIAL FORM ================= */

const emailDomain = "@sbi.co.in";

const getInitialForm = () => ({
  code: "",
  name: "",
  circleCode: "",
  state: "",
  city: "",
  address: "",
  pinCode: "",
  phoneNumber: "",
  emailId: emailDomain,
  nmrCode: "",
  status: "Active",
  openDate: dayjs(),
  closeDate: null,
  mergeDate: null,
  mergedWithBranch: "",
  cpcFlag: false,
  foodCreditFlag: false,
  currChestFlag: false,
  branchType: "A",
});

/* ================= COMPONENT ================= */

export default function BranchFormDialog({
  open,
  onClose,
  editingRow,
  onSuccess,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [form, setForm] = useState(getInitialForm());
  const originalRef = useRef(null);

  /* ===== LOAD EDIT DATA ===== */

  useEffect(() => {
    if (editingRow) {
      const mapped = {
        ...editingRow,
        status: editingRow.status ? "Active" : "InActive",
      };
      setForm(mapped);
      originalRef.current = mapped;
    } else {
      setForm(getInitialForm());
      originalRef.current = null;
    }
  }, [editingRow]);

  /* ===== AUTO BRANCH TYPE RULE ===== */

  useEffect(() => {
    const isManual =
      form.status !== "Active" ||
      form.closeDate ||
      form.mergeDate ||
      form.mergedWithBranch;

    setForm((p) => ({ ...p, branchType: isManual ? "M" : "A" }));
  }, [form.status, form.closeDate, form.mergeDate, form.mergedWithBranch]);

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (
      editingRow &&
      JSON.stringify(form) === JSON.stringify(originalRef.current)
    ) {
      snackbar("No changes detected", "warning");
      return;
    }

    try {
      const payload = {
        requestType: "BRANCH",
        changeType: editingRow ? "UPDATE" : "ADD",
        targetId: form.code,
        payload: {
          ...form,
          status: form.status === "Active",
          openDate: dayjs(form.openDate).format("DD/MM/YYYY"),
          closeDate: form.closeDate
            ? dayjs(form.closeDate).format("DD/MM/YYYY")
            : null,
          mergeDate: form.mergeDate
            ? dayjs(form.mergeDate).format("DD/MM/YYYY")
            : null,
        },
      };

      await callApi("/CR/create-request", payload, "POST");
      snackbar(editingRow ? "Branch updated" : "Branch created", "success");
      onClose();
      onSuccess();
    } catch (err) {
      snackbar("Request failed", "error");
    }
  };

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Dialog
        open={open}
        onClose={onClose}
        maxWidth="md"
        fullWidth
        component="form"
        onSubmit={handleSubmit}
      >
        <DialogTitleStyle>
          {editingRow ? "Edit Branch" : "Add Branch"}
        </DialogTitleStyle>

        <DialogContent dividers>
          {/* 👉 Paste your FULL existing form JSX here unchanged */}
          <Stack direction={"column"} spacing={2}>
            <Stack direction={"row"} spacing={1}>
              <TextFieldStyle
                fullWidth
                label="Branch Code *"
                name="code"
                value={branchData.code}
                onChange={handleChange}
                disabled={!!editingId}
                error={!!errors.code}
                helperText={errors.code || "Exactly 5 digits"}
                inputProps={{ maxLength: 5, inputMode: "numeric" }}
              />

              <TextFieldStyle
                fullWidth
                label="Branch Name *"
                name="name"
                value={branchData.name}
                onChange={handleChange}
                error={!!errors.name}
                inputProps={{ maxLength: 50 }}
                helperText={
                  errors.name || "Allowed: letters, numbers, spaces, /&()-,."
                }
              />

              <TextFieldStyle
                fullWidth
                select
                label="Circle Code *"
                name="circleCode"
                value={branchData.circleCode}
                onChange={handleChange}
                error={!!errors.circleCode}
                helperText={errors.circleCode || ""}
                inputProps={{ maxLength: 5, inputMode: "numeric" }}
              >
                {circles.map((circles) => (
                  <MenuItem key={circles.circleCode} value={circles.circleCode}>
                    {circles.circleCode} - {circles.circleName}
                  </MenuItem>
                ))}
              </TextFieldStyle>
            </Stack>

            <Stack direction={"row"} spacing={1}>
              <TextFieldStyle
                fullWidth
                select
                label="State *"
                name="state"
                value={branchData.state}
                onChange={handleChange}
                error={!!errors.state}
                inputProps={{ maxLength: 50 }}
                helperText={errors.state || ""}
              >
                {states.map((states) => (
                  <MenuItem key={states.stateCode} value={states.stateCode}>
                    {states.stateCode} - {states.stateName}
                  </MenuItem>
                ))}
              </TextFieldStyle>

              <TextFieldStyle
                fullWidth
                label="City *"
                name="city"
                value={branchData.city}
                onChange={handleChange}
                error={!!errors.city}
                inputProps={{ maxLength: 30 }}
                helperText={errors.city || "Allowed 3-30 characters"}
              />

              <TextFieldStyle
                fullWidth
                label="Pin Code *"
                name="pinCode"
                value={branchData.pinCode}
                onChange={handleChange}
                error={!!errors.pinCode}
                helperText={errors.pinCode || "Exactly 6 digits"}
                inputProps={{ maxLength: 6, inputMode: "numeric" }}
              />
            </Stack>

            <Stack direction={"row"} spacing={1}>
              <TextField
                fullWidth
                label="Address *"
                name="address"
                value={branchData.address}
                onChange={handleChange}
                error={!!errors.address}
                inputProps={{ maxLength: 50 }}
                helperText={
                  errors.address ||
                  "Allowed 5-50 characters (A-Z, 0-9, spaces,/,&,(,),- )"
                }
                multiline
                maxRows={2}
              />
            </Stack>

            <Stack direction={"row"} spacing={1}>
              <TextField1Style
                fullWidth
                label="Phone Number *"
                name="phoneNumber"
                value={branchData.phoneNumber}
                onChange={handleChange}
                error={!!errors.phoneNumber}
                helperText={errors.phoneNumber || "Exactly 12 digits"}
                inputProps={{ maxLength: 12, inputMode: "numeric" }}
              />
              <TextField1Style
                fullWidth
                name="emailId"
                label="Email ID *"
                value={branchData.emailId || emailDomain}
                onChange={handleChange}
                onClick={(e) => {
                  const i = e.target;
                  const p = branchData.emailId.indexOf("@");
                  i.setSelectionRange(p, p);
                }}
                onKeyDown={(e) => {
                  const p = e.target.selectionStart;
                  const a = branchData.emailId.indexOf("@");
                  if (e.key === "Delete" && p >= a) {
                    e.preventDefault();
                    return;
                  }
                  if (p > a) {
                    e.preventDefault();
                    e.target.setSelectionRange(a, a);
                  }
                }}
                onBlur={handleChange} // Re-validate on blur
                error={!!errors.emailId}
                helperText={
                  errors.emailId || "Maximum 50 characters allowed before @"
                }
                inputProps={{ maxLength: emailPrefix + emailDomain.length }}
              />
            </Stack>
            <Stack direction={"row"} spacing={1}>
              <TextFieldStyle
                fullWidth
                name="nmrCode"
                label="N-M-R Code *"
                value={branchData.nmrCode}
                onChange={handleChange}
                onBlur={handleChange} // Re-validate on blur
                error={!!errors.nmrCode}
                helperText={errors.nmrCode || "Exactly 9 digits"}
                inputProps={{ maxLength: 9, inputMode: "numeric" }}
              />
              <TextFieldStyle
                select
                fullWidth
                label="Branch Status as per CBS*"
                name="status"
                value={
                  !branchData.status || branchData.status === "InActive"
                    ? "InActive"
                    : "Active"
                }
                onChange={handleChange}
                error={!!errors.status}
                helperText={errors.status}
              >
                <MenuItem value="">Select Branch Status</MenuItem>
                <MenuItem key={"Live"} value={"Active"}>
                  Live
                </MenuItem>
                <MenuItem key={"Closed"} value={"InActive"}>
                  Closed
                </MenuItem>
              </TextFieldStyle>
              <DatePickerStyle
                label="Open Date *"
                format="DD/MM/YYYY"
                name="openDate"
                disabled={!!editingId}
                value={
                  branchData.openDate
                    ? dayjs(branchData.openDate, "DD/MM/YYYY")
                    : null
                }
                onChange={(newValue) => {
                  handleChange({
                    target: {
                      name: "openDate",
                      value: newValue,
                    },
                  });
                }}
                slotProps={{
                  textField: {
                    fullWidth: true,
                    variant: "outlined",
                  },
                }}
              />
            </Stack>

            <Stack direction={"row"} spacing={1}>
              {editingId && (
                <DatePicker1Style
                  label="Close Date"
                  format="DD/MM/YYYY"
                  name="closeDate"
                  required={branchData.status === "InActive"}
                  value={
                    branchData.closeDate
                      ? dayjs(branchData.closeDate, "DD/MM/YYYY")
                      : null
                  }
                  onChange={(newValue) => {
                    handleChange({
                      target: {
                        name: "closeDate",
                        value: newValue,
                      },
                    });
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      variant: "outlined", // Pass props to the internal TextField
                      error:
                        branchData.status === "Closed" && branchData.closeDate,
                      helperText:
                        branchData.status === "Closed" && branchData.closeDate
                          ? "Close Date is required when status is Closed"
                          : "",
                    },
                  }}
                />
              )}

              {/* Conditionally render closeDate field only if editingId exists */}
              {editingId && (
                <DatePicker1Style
                  label="Merge Date"
                  format="DD/MM/YYYY"
                  name="mergeDate"
                  required={editingId && branchData.mergedWithBranch}
                  value={
                    branchData.mergeDate
                      ? dayjs(branchData.mergeDate, "DD/MM/YYYY")
                      : null
                  }
                  onChange={(newValue) => {
                    handleChange({
                      target: {
                        name: "mergeDate",
                        value: newValue,
                      },
                    });
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      variant: "outlined", // Pass props to the internal TextField
                      error: !!errors.closeDate,
                      helperText: errors.closeDate,
                    },
                  }}
                />
              )}

              {editingId && (
                <CustomAutoComplete
                  options={mwb || []}
                  loading={mwbLoading}
                  value={
                    typeof branchData?.mergedWithBranch === "object"
                      ? branchData?.mergedWithBranch
                      : {
                          code: branchData?.mergedWithBranch,
                          name: "",
                        }
                  }
                  onChange={handleMergedWithBranchAutoCompleteChange}
                  onInputChange={debounceQuery}
                  renderOption={(option) =>
                    typeof option === "string"
                      ? option
                      : !option || !option?.code || !option?.name
                      ? ""
                      : `${option.code} (${option.name})`
                  }
                  uniqueElementKey={"code"}
                  label={"Merged with Branch"}
                  name={"mergedWithBranch"}
                  error={errors?.mergedWithBranch}
                />
              )}
            </Stack>

            <Stack direction={"row"} spacing={1}>
              <TextFieldStyle
                fullWidth
                select
                label="CPC Flag"
                name="cpcFlag"
                value={branchData.cpcFlag}
                onChange={handleChange}
                error={!!errors.state}
                inputProps={{ maxLength: 50 }}
                helperText={errors.cpcFlag}
              >
                <MenuItem key={true} value={true}>
                  Allowed
                </MenuItem>
                <MenuItem key={false} value={false}>
                  Not Allowed
                </MenuItem>
              </TextFieldStyle>

              <TextFieldStyle
                fullWidth
                select
                label="Food Credit Flag *"
                name="foodCreditFlag"
                value={branchData.foodCreditFlag}
                onChange={handleChange}
                error={!!errors.foodCreditFlag}
                inputProps={{ maxLength: 50 }}
                helperText={errors.foodCreditFlag}
              >
                <MenuItem key={true} value={true}>
                  Allowed
                </MenuItem>
                <MenuItem key={false} value={false}>
                  Not Allowed
                </MenuItem>
              </TextFieldStyle>

              <TextFieldStyle
                fullWidth
                select
                label="Curr Chest Flag *"
                name="currChestFlag"
                value={branchData.currChestFlag}
                onChange={handleChange}
                error={!!errors.currChestFlag}
                inputProps={{ maxLength: 50 }}
                helperText={errors.currChestFlag}
              >
                <MenuItem key={true} value={true}>
                  Allowed
                </MenuItem>
                <MenuItem key={false} value={false}>
                  Not Allowed
                </MenuItem>
              </TextFieldStyle>

              <TextFieldStyle
                select
                fullWidth
                label="Branch Type *"
                name="branchType"
                value={branchData.branchType}
                onChange={handleChange}
                // disabled={
                //   editingId &&
                //  // branchData.status==="Closed" &&
                //   (branchData.closeDate||
                //   branchData.mergeDate||
                //   branchData.mergedWithBranch)
                // }
                error={!!errors.branchType}
                helperText={errors.branchType}
              >
                {branchType.map((option) => (
                  <MenuItem key={option.value} value={option.value}>
                    {option.label}
                  </MenuItem>
                ))}
              </TextFieldStyle>
            </Stack>
          </Stack>
        </DialogContent>

        <DialogActions>
          <Button
            type="submit"
            variant="contained"
            startIcon={editingRow ? <Edit /> : <Add />}
          >
            {editingRow ? "Update" : "Add"}
          </Button>
        </DialogActions>
      </Dialog>
    </LocalizationProvider>
  );
}
