import {
  Box,
  Drawer,
  LinearProgress,
  Stack,
  Typography,
  IconButton,
  Collapse,
} from "@mui/material";
import {
  Close,
  AccessTime,
  CheckCircleOutline,
  ErrorOutline,
  Help,
} from "@mui/icons-material";
import { useState, useMemo } from "react";
import CustomChip from "../utils/CustomChip";
import { toPascalKebabCase } from "../utils/CommonUtilities";

const statusColor = {
  PROCESSING: "warning",
  COMPLETED: "success",
  FAILED: "error",
};

const statusIcon = {
  PROCESSING: <AccessTime fontSize="small" />,
  COMPLETED: <CheckCircleOutline fontSize="small" />,
  FAILED: <ErrorOutline fontSize="small" />,
  default: <Help fontSize="small" />,
};

// OPTIMIZATION: Extracted the task calculations to keep the render clean
const calculateTaskMetrics = (task) => {
  const isDone = task.percentage === 100;
  
  const elapsed = task.startedAt
    ? Math.floor((Date.now() - task.startedAt) / 1000)
    : null;

  const speed =
    task.lastUpdated && task.startedAt && elapsed > 0
      ? task.percentage / elapsed
      : null;

  const eta =
    speed && task.percentage < 100
      ? Math.ceil((100 - task.percentage) / speed)
      : null;

  // Format taskId to Title Case string
  const formattedTaskId = task.taskId
    ?.replace(/_/g, " ")
    .toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase());

  const statusKey = task.status?.toUpperCase() || "DEFAULT";

  return { isDone, elapsed, eta, formattedTaskId, statusKey };
};

const TaskProgressDrawer = ({ open, onClose, tasks }) => {
  const [expanded, setExpanded] = useState(null);

  // OPTIMIZATION: Memoize the task list object values so we don't recalculate on every render
  const taskList = useMemo(() => Object.values(tasks), [tasks]);

  return (
    <Drawer
      anchor="right"
      open={open}
      onClose={onClose}
      sx={{
        "& .MuiDrawer-paper": {
          // FIXED: Responsive width (Full width on mobile, 380px fixed on desktop)
          width: { xs: "100%", sm: 380 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          p: { xs: 2, sm: 3 }, // FIXED: Responsive padding
          borderBottom: "1px solid #E2E8F0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography variant="h6" fontWeight={700}>
          Running Tasks
        </Typography>
        <IconButton size="small" onClick={onClose} sx={{ ml: 1 }}>
          <Close />
        </IconButton>
      </Box>

      {/* CONTENT */}
      {/* FIXED: Removed fixed width, enabled vertical scroll, hid horizontal scroll */}
      <Box sx={{ flex: 1, overflowY: "auto", overflowX: "hidden", p: { xs: 2, sm: 3 } }}>
        <Stack spacing={2}>
          {taskList.length === 0 ? (
             <Box sx={{ textAlign: "center", mt: 4, opacity: 0.6 }}>
               <Typography>No active tasks</Typography>
             </Box>
          ) : (
            taskList.map((task) => {
              const { isDone, elapsed, eta, formattedTaskId, statusKey } = calculateTaskMetrics(task);

              return (
                <Box
                  key={task.taskId}
                  sx={{
                    p: 2,
                    borderRadius: 2,
                    bgcolor: "background.paper",
                    boxShadow: 1,
                    cursor: "pointer",
                    transition: "box-shadow 0.2s",
                    "&:hover": {
                      boxShadow: 3,
                    }
                  }}
                  onClick={() =>
                    setExpanded(expanded === task.taskId ? null : task.taskId)
                  }
                >
                  {/* HEADER ROW */}
                  <Stack
                    direction="row"
                    justifyContent="space-between"
                    alignItems="flex-start"
                    spacing={1}
                  >
                    <Typography
                      variant="body2"
                      fontWeight={600}
                      sx={{
                        flex: 1,
                        minWidth: 0,
                        wordBreak: "break-word",
                        overflowWrap: "anywhere",
                        pr: 1, // Add slight padding right to separate from chip
                      }}
                    >
                      {formattedTaskId}
                    </Typography>

                    {/* FIXED: Wrapped chip in Box with shrink 0 so it never squishes on mobile */}
                    <Box sx={{ flexShrink: 0 }}>
                      <CustomChip
                        size="sm"
                        variant="outlined"
                        color={statusColor[statusKey] || "default"}
                        label={toPascalKebabCase(task.status)}
                        icon={statusIcon[statusKey] || statusIcon.default}
                      />
                    </Box>
                  </Stack>

                  {/* META / PROGRESS BAR */}
                  <Stack direction="row" alignItems="center" spacing={2} mt={1.5}>
                    <Box sx={{ flexGrow: 1 }}>
                      <LinearProgress
                        variant="determinate"
                        value={task.percentage}
                        sx={{
                          height: 8.5,
                          borderRadius: 5,
                          transition: "all 0.4s ease",
                        }}
                        color={isDone ? "success" : "primary"}
                      />
                    </Box>

                    <Typography variant="caption" sx={{ minWidth: "35px", textAlign: "right" }}>
                      {task.percentage}%
                    </Typography>
                  </Stack>

                  <Box>
                    {eta && (
                      <Typography variant="caption" color="text.secondary">
                        ETA: ~{eta}s
                      </Typography>
                    )}
                  </Box>

                  {/* DETAILS */}
                  <Collapse in={expanded === task.taskId}>
                    <Box mt={1} sx={{ p: 1, bgcolor: "action.hover", borderRadius: 1 }}>
                      <Typography variant="caption" color="text.secondary" sx={{ display: "block", wordBreak: "break-word" }}>
                        {task.message}
                      </Typography>
                      {elapsed !== null && (
                        <Typography variant="caption" display="block" color="text.secondary" mt={0.5}>
                          Elapsed Time: {elapsed}s
                        </Typography>
                      )}
                    </Box>
                  </Collapse>
                </Box>
              );
            })
          )}
        </Stack>
      </Box>
    </Drawer>
  );
};

export default TaskProgressDrawer;
