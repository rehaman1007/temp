import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  Grid,
  TextField,
  Typography,
} from "@mui/material";
import useApi from "../../hooks/useApi";

export default function CglView() {
  const { callApi } = useApi();

  const [searchText, setSearchText] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- API Trigger when typing ----
  useEffect(() => {
    const text = searchText.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    let cancel = false;

    const fetchData = async () => {
      try {
        setLoading(true);

        const res = await callApi(
          "/CM/cglWithSegment",
          {
            cglNumb: text, // your API expects this param
            cglDesc: text, // works for both description or number
          },
          "GET"
        );

        const list = res?.data?.data || [];
        if (!cancel) setOptions(list);
      } catch (err) {
        if (!cancel) {
          setOptions([]);
          setSelected(null);
        }
      } finally {
        if (!cancel) setLoading(false);
      }
    };

    fetchData();

    return () => (cancel = true);
  }, [searchText, callApi]);

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* Single Search Field */}
      <Autocomplete
        fullWidth
        value={selected}
        options={options}
        loading={loading}
        onChange={(_, value) => setSelected(value)}
        getOptionLabel={(opt) =>
          opt ? `${opt.cglNumber} - ${opt.description}` : ""
        }
        noOptionsText={
          searchText.length < 3
            ? "Type at least 3 characters..."
            : "No matching records"
        }
        renderInput={(params) => (
          <TextField
            {...params}
            label="Search by CGL Number or Description"
            placeholder="Start typing..."
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
            InputProps={{
              ...params.InputProps,
              endAdornment: (
                <>
                  {loading && <CircularProgress size={18} />}
                  {params.InputProps.endAdornment}
                </>
              ),
            }}
          />
        )}
        sx={{ mb: 3 }}
      />

      {/* Details Display */}
      <Card sx={{ p: 3 }}>
        {!selected ? (
          <Typography sx={{ color: "gray" }}>No CGL Selected</Typography>
        ) : (
          <Grid container spacing={2}>
            <Grid item xs={6}>
              <Typography fontWeight={600}>CGL Number</Typography>
              <Typography>{selected.cglNumber}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Description</Typography>
              <Typography>{selected.description}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Comp1</Typography>
              <Typography>{selected.comp1}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Comp2</Typography>
              <Typography>{selected.comp2}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Segment Code</Typography>
              <Typography>{selected.segmentCode}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Segment Description</Typography>
              <Typography>{selected.segmentDescription || "-"}</Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Balance Compare</Typography>
              <Typography>
                {selected.balcompare === 1 ? "Include" : "Exclude"}
              </Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Manual Posting</Typography>
              <Typography>
                {selected.manualPosting === 1 ? "Allowed" : "Not Allowed"}
              </Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Balance Forward</Typography>
              <Typography>{selected.balFwd === 1 ? "Yes" : "No"}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Open Date</Typography>
              <Typography>{selected.openDate || "-"}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Close Date</Typography>
              <Typography>{selected.closeDate || "-"}</Typography>
            </Grid>
          </Grid>
        )}
      </Card>
    </Box>
  );
}