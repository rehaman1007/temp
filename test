CREATE OR REPLACE EDITIONABLE PROCEDURE "PROCESS_JOURNAL_BATCH" (
    p_batch_id      IN VARCHAR2,
    p_executor_id   IN VARCHAR2,
    p_remarks       IN VARCHAR2,
    p_status        IN VARCHAR2,
    o_cursor        OUT SYS_REFCURSOR
) AS
    v_missing_rates NUMBER;
    v_txn_count     NUMBER; 
    v_users_date    DATE; 
BEGIN
    SELECT USERS_DATE INTO v_users_date FROM FINCORE_DATE WHERE ROWNUM = 1;

    SELECT COUNT(*) INTO v_missing_rates
    FROM (
        SELECT DISTINCT REQ_CURRENCY FROM voucher_posting_data
        WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P'
    ) req
    LEFT JOIN CURRENCY_MASTER cm ON req.REQ_CURRENCY = cm.CURRENCY_CODE AND cm.FLAG = 1
    WHERE req.REQ_CURRENCY <> 'INR'
      AND (cm.CURRENCY_RATE IS NULL OR cm.CURRENCY_RATE <= 0);

    IF v_missing_rates > 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'EXCHANGE_RATE_MISSING');
    END IF;

    SELECT COUNT(*) INTO v_txn_count
    FROM voucher_posting_data
    WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P';

    INSERT /*+ PARALLEL(GL_TRANSACTIONS, 8) */ INTO GL_TRANSACTIONS (
        TRANSACTION_ID, BATCH_ID, JOURNAL_ID, TRANSACTION_DATE, POST_DATE,
        BRANCH_CODE, CURRENCY, CGL, NARRATION, DEBIT_AMOUNT, CREDIT_AMOUNT, SOURCE_FLAG, TRANSACTION_COUNT
    )
    SELECT /*+ PARALLEL(voucher_posting_data, 8) */
        GL_TRANSACTIONS_SEQ.nextval, BATCH_ID, JOURNAL_ID, v_users_date,
        CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Kolkata', REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_NARRATION,
        CASE WHEN REQ_AMOUNT > 0 THEN (REQ_AMOUNT * -1) ELSE 0 END,
        CASE WHEN REQ_AMOUNT < 0 THEN ABS(REQ_AMOUNT) ELSE 0 END,
        'J', '1' 
    FROM voucher_posting_data
    WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P';

    MERGE INTO GL_BALANCE target
    USING (
        SELECT j.REQ_BRANCH_CODE, j.REQ_CURRENCY, j.REQ_CGL, v_users_date as BAL_DATE,
               SUM(j.REQ_AMOUNT) as TXN_AMOUNT,
               CASE WHEN j.REQ_CURRENCY = 'INR' THEN 1 ELSE MAX(c.CURRENCY_RATE) END as EXCH_RATE
        FROM voucher_posting_data j
        LEFT JOIN CURRENCY_MASTER c ON j.REQ_CURRENCY = c.CURRENCY_CODE AND c.FLAG = 1
        WHERE j.BATCH_ID = p_batch_id AND j.REQ_STATUS = 'P'
        GROUP BY j.REQ_BRANCH_CODE, j.REQ_CURRENCY, j.REQ_CGL
    ) source
    ON (target.BRANCH_CODE = source.REQ_BRANCH_CODE
        AND target.CURRENCY = source.REQ_CURRENCY
        AND target.CGL = source.REQ_CGL
        AND target.BALANCE_DATE = source.BAL_DATE)
    WHEN MATCHED THEN
        UPDATE SET
            target.BALANCE = target.BALANCE + source.TXN_AMOUNT,
            target.INR_BALANCE = NVL(target.INR_BALANCE, 0) + (source.TXN_AMOUNT * source.EXCH_RATE)
    WHEN NOT MATCHED THEN
        INSERT (ID, BALANCE_DATE, BRANCH_CODE, CURRENCY, CGL, BALANCE, INR_BALANCE)
        VALUES (GL_BALANCE_SEQ.nextval, source.BAL_DATE, source.REQ_BRANCH_CODE,
                source.REQ_CURRENCY, source.REQ_CGL, source.TXN_AMOUNT,
                (source.TXN_AMOUNT * source.EXCH_RATE));

    OPEN o_cursor FOR
    SELECT
        j.REQ_BRANCH_CODE AS BRANCH, j.REQ_CURRENCY AS CURRENCY, j.REQ_CGL AS CGL,
        v_users_date AS BAL_DATE,
        g.BALANCE AS NEW_BALANCE, g.INR_BALANCE AS NEW_INR_BALANCE
    FROM (
        SELECT DISTINCT REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL
        FROM voucher_posting_data WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P'
    ) j
    JOIN GL_BALANCE g
        ON g.BRANCH_CODE = j.REQ_BRANCH_CODE
        AND g.CURRENCY = j.REQ_CURRENCY
        AND g.CGL = j.REQ_CGL
        AND g.BALANCE_DATE = v_users_date;

    UPDATE voucher_posting_data
    SET REQ_STATUS = p_status,
        EXECUTION_DATE = CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Kolkata'
    WHERE BATCH_ID = p_batch_id AND REQ_STATUS = 'P';

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END;
/

CREATE OR REPLACE EDITIONABLE PROCEDURE "PURGE_JOURNAL_BATCH" (
    p_batch_id IN VARCHAR2,
    p_user_id  IN VARCHAR2
) AS
    v_status VARCHAR2(20);
BEGIN
    SELECT BATCH_STATUS INTO v_status
    FROM VOUCHER_POSTING
    WHERE BATCH_ID = p_batch_id 
      AND UPPER(TRIM(CREATED_BY)) = UPPER(TRIM(p_user_id));

    IF v_status NOT IN ('P') THEN
        RAISE_APPLICATION_ERROR(-20002, 'Cannot delete batch. Status is ' || v_status);
    END IF;

    DELETE FROM VOUCHER_WORKFLOW WHERE BATCH_ID_FK = p_batch_id;
    DELETE FROM VOUCHER_POSTING_DATA WHERE BATCH_ID = p_batch_id;
    DELETE FROM VOUCHER_POSTING WHERE BATCH_ID = p_batch_id;
END;
/

CREATE OR REPLACE EDITIONABLE PROCEDURE "VD_VALIDATE_VOUCHER_DATA" (
    in_batch_id IN VARCHAR2
) AS
    c_batch_size CONSTANT NUMBER := 25000;
 
    CURSOR c_staging_data IS
    SELECT 
        s.rowid,
        CASE WHEN bm.code IS NULL AND s.req_branch_code IS NOT NULL THEN 'N' ELSE 'Y' END AS is_branch_code_valid,
        CASE WHEN cm.currency_code IS NULL AND s.req_currency IS NOT NULL THEN 'N' ELSE 'Y' END AS is_currency_code_valid,
        CASE WHEN cgm.cgl_number IS NULL AND s.req_cgl IS NOT NULL THEN 'N' ELSE 'Y' END AS is_cgl_valid
    FROM voucher_posting_data s
    LEFT JOIN branch_master bm ON (s.req_branch_code = bm.code AND bm.status = 1)
    LEFT JOIN currency_master cm ON (s.req_currency = cm.currency_code AND cm.flag = 1) 
    LEFT JOIN cgl_master cgm ON (s.req_cgl = cgm.cgl_number AND cgm.status = 1)
    WHERE s.is_validated = 'N' 
      AND s.batch_id = in_batch_id
      AND (
          (bm.code IS NULL AND s.req_branch_code IS NOT NULL) OR
          (cm.currency_code IS NULL AND s.req_currency IS NOT NULL) OR
          (cgm.cgl_number IS NULL AND s.req_cgl IS NOT NULL)
      );

    TYPE t_staging_rec is RECORD (
        rid ROWID,
        is_branch_code_valid varchar(1),
        is_currency_code_valid varchar(1),
        is_cgl_valid varchar(1)
    );

    TYPE t_staging_tab IS TABLE OF t_staging_rec;
    l_batch_data t_staging_tab;

BEGIN
    OPEN c_staging_data;
 
    LOOP
        FETCH c_staging_data BULK COLLECT INTO l_batch_data LIMIT c_batch_size;
        EXIT WHEN l_batch_data.COUNT = 0;
        
        FORALL i IN 1..l_batch_data.COUNT
        UPDATE voucher_posting_data 
        SET is_branch_valid = l_batch_data(i).is_branch_code_valid, 
            is_currency_valid = l_batch_data(i).is_currency_code_valid, 
            is_cgl_valid = l_batch_data(i).is_cgl_valid,
            is_validated = 'Y' 
        WHERE rowid = l_batch_data(i).rid;
    END LOOP;
    CLOSE c_staging_data;

    UPDATE voucher_posting_data 
    SET is_branch_valid = 'Y', 
        is_currency_valid = 'Y', 
        is_cgl_valid = 'Y', 
        is_validated = 'Y' 
    WHERE is_validated = 'N' AND batch_id = in_batch_id;
END;
/

