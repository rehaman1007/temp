/**
 * -------------------------------------------------------------
 * Common Request Screen Configurations
 * -------------------------------------------------------------
 *
 * Backend sends only `screenId`.
 * This file resolves:
 *
 * screenId -> screenName -> screenConfig
 *
 * Developers only maintain configs using readable screen names.
 *
 * Example:
 *
 * const config = COMMON_REQ_SCREEN_CONFIGS[screenId];
 *
 * Internally:
 *
 * 10 -> BRANCH -> branchConfig
 *
 * -------------------------------------------------------------
 */

import { currencyFormatterWith6Decimals } from "../../utils/NumberFormat";

/**
 * -------------------------------------------------------------
 * SCREEN ID → SCREEN NAME MAP
 * -------------------------------------------------------------
 *
 * Maps backend screen IDs to readable screen names.
 */

export const SCREEN_ID_NAME_MAP = {
  1: "CIRCLE",
  2: "CIRCLE",

  5: "CGL_CODE",
  6: "CGL_CODE",
  37: "CGL_CODE",

  7: "SEGMENT_CODE",
  8: "SEGMENT_CODE",

  9: "BRANCH",
  10: "BRANCH",

  12: "USER_MANAGEMENT",
  13: "USER_MANAGEMENT",
  24: "USER_MANAGEMENT",

  14: "CALENDER",
  15: "CALENDER",

  16: "STATE",
  17: "STATE",

  18: "CURRENCY",
  19: "CURRENCY",

  20: "CURRENCY_RATE_CHANGE",
  21: "CURRENCY_RATE_CHANGE",

  22: "ROLE_MANAGEMENT",
  23: "ROLE_MANAGEMENT",

  30: "JOURNAL_AUTH",
  31: "JOURNAL_AUTH",
  32: "JOURNAL_AUTH",
  36: "JOURNAL_AUTH",

  40: "FILE_TYPE_MASTER",
  41: "FILE_TYPE_MASTER",

  42: "LHO_TRANSFER",
  43: "LHO_TRANSFER",

  44: "MAIN_DATA_PARAMETERS",
  45: "MAIN_DATA_PARAMETERS",

  101: "RB_REPORT_TEMPLATE",
  121: "RB_REPORT_TEMPLATE",

  103: "MONITORING",
};

/**
 * -------------------------------------------------------------
 * SCREEN CONFIGS (DEFINED USING SCREEN NAMES)
 * -------------------------------------------------------------
 */

export const SCREEN_CONFIGS_BY_NAME = {
  /**
   * -------------------------------------------------------------
   * CIRCLE SCREEN
   * -------------------------------------------------------------
   */
  CIRCLE: {
    columns: [
      { field: "circleCode", headerName: "Circle Code", flex: 0.5 },
      { field: "circleName", headerName: "Circle Name", flex: 1.2 },
      { field: "zoneDescription", headerName: "Zone", flex: 0.8 },
    ],

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      return {
        ...data,
        payload: {
          circleCode: data.circleCode,
          circleName: data.circleName,
          zone: data.zoneDescription,
        },
      };
    },
  },

  /**
   * -------------------------------------------------------------
   * CGL CODE SCREEN
   * -------------------------------------------------------------
   */
  CGL_CODE: {
    columns: [
      { field: "cglCode", headerName: "CGL Code", flex: 0.5 },
      { field: "description", headerName: "CGL Description", flex: 1.3 },
    ],

    transformData: (data) =>
      data.map((row) => {
        const parsed = row.payload || {};

        return {
          ...row,
          ...parsed,
          cglCode: `${parsed.comp1 || ""}${parsed.segmentCode || ""}${parsed.comp2 || ""}`,
        };
      }),

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      const {
        comp1 = "",
        segmentCode = "",
        comp2 = "",
        description = "",
        acClassification = "",
        balFwd = "",
        balCompare = "",
        manualPosting = "",
      } = data;

      const accountClassificationLabel =
        ACCOUNT_CLASSIFICATIONS.find((x) => x.value === acClassification)?.label || "N/A";

      const yesNo = (val) => (val == "1" ? "Yes" : "No");
      const includeExclude = (val) => (val == "1" ? "Include" : "Exclude");

      return {
        ...data,
        payload: {
          comp1,
          segmentCode,
          comp2,
          "Cgl Code": [comp1, segmentCode, comp2].filter(Boolean).join(""),
          Description: description || "-",
          "Account Classification": accountClassificationLabel,
          "Balance Carry Forward": yesNo(balFwd),
          "Balance Compare": includeExclude(balCompare),
          "Manual Posting Allowed": yesNo(manualPosting),
        },
      };
    },

    processSummaryData: (data) => data,
  },

  /**
   * -------------------------------------------------------------
   * SEGMENT CODE
   * -------------------------------------------------------------
   */
  SEGMENT_CODE: {
    columns: [
      { field: "segmentCode", headerName: "Segment Code", flex: 0.5 },
      { field: "description", headerName: "Segment Description", flex: 1.2 },
    ],
  },

  /**
   * -------------------------------------------------------------
   * BRANCH
   * -------------------------------------------------------------
   */
  BRANCH: {
    columns: [
      { field: "code", headerName: "Branch Code", flex: 0.5 },
      { field: "name", headerName: "Branch Name", flex: 1.2 },
    ],

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      const {
        code = "",
        name = "",
        circleCode = "",
        circleName = "",
        stateName = "",
        city = "",
        address = "",
        pinCode = "",
        phoneNumber = "",
        emailId = "",
        nmrCode = "",
        status = "",
        openDate = "",
        closeDate = "",
        mergeDate = "",
        mergedWithBranch = "",
        cpcFlag = "",
        foodCreditFlag = "",
        currChestFlag = "",
        branchType = "",
      } = data;

      return {
        ...data,
        payload: {
          branchCode: code,
          branchName: name,
          circle: `${circleCode} - ${circleName}`,
          state: stateName,
          city,
          address,
          pinCode,
          phoneNumber,
          emailId,
          networkModuleRegion: nmrCode,
          BranchStatusAsPerCBS: status ? "Live" : "Closed",
          openDate,
          closeDate,
          mergeDate,
          mergedWithBranch,
          "CPC (centralized processing cell)": cpcFlag ? "Allowed" : "Not Allowed",
          foodCredit: foodCreditFlag ? "Allowed" : "Not Allowed",
          currencyChest: currChestFlag ? "Allowed" : "Not Allowed",
          branchType: branchType === "A" ? "Automated" : "Manual",
        },
      };
    },

    processSummaryData: (data) => data,
  },

  /**
   * -------------------------------------------------------------
   * STATE
   * -------------------------------------------------------------
   */
  STATE: {
    columns: [
      { field: "stateCode", headerName: "State Code", flex: 0.5 },
      { field: "stateName", headerName: "State Name", flex: 1.2 },
    ],
  },

  /**
   * -------------------------------------------------------------
   * CURRENCY
   * -------------------------------------------------------------
   */
  CURRENCY: {
    columns: [
      { field: "currencyCode", headerName: "Currency Code", flex: 0.5 },
      { field: "currencyName", headerName: "Currency Name", flex: 1 },
      {
        field: "currencyRate",
        headerName: "Currency Rate",
        flex: 1,
        align: "right",
        headerAlign: "right",
        sortable: true,
        renderCell: (params) =>
          currencyFormatterWith6Decimals("INR").format(params.value),
      },
    ],

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      return {
        ...data,
        payload: {
          currencyCode: data.currencyCode,
          currencyName: data.currencyName,
          currencyRate:
            data.currencyRate !== null && data.currencyRate !== undefined
              ? Number(data.currencyRate).toFixed(6)
              : "",
        },
      };
    },
  },

  /**
   * -------------------------------------------------------------
   * CURRENCY RATE CHANGE
   * -------------------------------------------------------------
   */
  CURRENCY_RATE_CHANGE: {
    columns: [
      { field: "currencyCode", headerName: "Currency Code", flex: 0.5 },
      { field: "currencyRate", headerName: "Currency Rate", flex: 0.5 },
    ],

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      return {
        ...data,
        payload: {
          currencyCode: data.currencyCode,
          updatedCurrencyRate: data.currencyRate,
        },
      };
    },
  },

  /**
   * -------------------------------------------------------------
   * CALENDER
   * -------------------------------------------------------------
   */
  CALENDER: {
    columns: [
      { field: "yearStartDate", headerName: "Year Start Date", flex: 0.5 },
      { field: "yearEndDate", headerName: "Year End Date", flex: 0.5 },
      { field: "remarks", headerName: "Remarks", flex: 0.8 },
    ],
  },

  /**
   * -------------------------------------------------------------
   * FILE TYPE MASTER
   * -------------------------------------------------------------
   */
  FILE_TYPE_MASTER: {
    columns: [
      { field: "type", headerName: "File Type", flex: 0.5 },
      { field: "filePattern", headerName: "File Name", flex: 0.5 },
      { field: "includeFile", headerName: "Include", flex: 0.8 },
    ],

    transformData: (data) =>
      data.map((row) => {
        const parsed = row.payload || {};
        return {
          ...row,
          ...parsed,
          includeFile: parsed.includeFile === "Y" ? "YES" : "NO",
        };
      }),
  },

  /**
   * -------------------------------------------------------------
   * LHO TRANSFER
   * -------------------------------------------------------------
   */
  LHO_TRANSFER: {
    patchUrl: "/CR/update-request",

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      const {
        processId = "",
        processRunId = "",
        processDate = "",
        totalAmount = "",
        totalRecordCount = "",
        circleWiseDetails = [],
      } = data;

      return {
        ...data,
        payload: {
          processRunId,
          processId,
          processDate,
          totalAmount,
          totalRecordCount,
          ShowCustomTable: true,
          summaryData: { data: circleWiseDetails },
        },
      };
    },
  },

  /**
   * -------------------------------------------------------------
   * MAIN DATA PARAMETERS
   * -------------------------------------------------------------
   */
  MAIN_DATA_PARAMETERS: {
    columns: [
      { field: "fileType", headerName: "File Type", flex: 0.6 },
      { field: "rowCount", headerName: "Rows", flex: 0.4 },
    ],

    transformData: (data) =>
      data.map((row) => {
        const parsed = row.payload || {};
        const rows = parsed.rows || [];

        return {
          ...row,
          ...parsed,
          fileType: parsed.fileType || row.targetId,
          rowCount: rows.length,
        };
      }),
  },
};

/**
 * -------------------------------------------------------------
 * MAIN EXPORT
 * -------------------------------------------------------------
 *
 * Automatically resolves:
 *
 * screenId -> screenName -> config
 */

export const COMMON_REQ_SCREEN_CONFIGS = new Proxy(
  {},
  {
    get(_, screenId) {
      const screenName = SCREEN_ID_NAME_MAP[screenId];
      return SCREEN_CONFIGS_BY_NAME[screenName] || {};
    },
  }
);

/**
 * -------------------------------------------------------------
 * LOOKUP CONSTANTS
 * -------------------------------------------------------------
 */

const ACCOUNT_CLASSIFICATIONS = [
  { value: "A", label: "Asset" },
  { value: "L", label: "Liability" },
  { value: "I", label: "Income" },
  { value: "E", label: "Expense" },
  { value: "M", label: "Memo A/c" },
];