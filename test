import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  SmartScreen,
  Link,
} from "@mui/icons-material";
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  Divider,
  Drawer,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  useTheme,
  useMediaQuery,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { userAvatarCreator } from "../utils/userUtilities";
import { useContext, useEffect } from "react";
import { AuthContext } from "../context/AuthContext";

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);

  // ADDED: Theme and media query to detect mobile and iPad devices
  const theme = useTheme();
  // 'md' breakpoint covers typical tablets (iPad portrait) and mobile phones
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));

  // Helper to handle padding and "N/A" cases
  const formatCode = (code, length) => {
    if (code === undefined || code === null || code === "") return "N/A";
    return String(code).padStart(length, "0");
  };

  const branchDisplay = user?.branchName
    ? `${user.branchName} (${formatCode(user.branch, 5)})`
    : "N/A";

  const circleDisplay = user?.circleName
    ? `${user.circleName} (${formatCode(user.circleCode, 3)})`
    : "N/A";

  // --- Keyboard Shortcut Logic ---
  useEffect(() => {
    const handleKeyDown = (event) => {
      // FIXED: Only trigger Alt + L shortcut if NOT on mobile/tablet
      if (
        !isMobileOrTablet &&
        event.altKey &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();
        logout();
      }

      if (event.key === "Escape" && profileDrawerOpen) {
        setProfileDrawerOpen(false);
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, setProfileDrawerOpen, isMobileOrTablet]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={() => setProfileDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          // FIXED: Responsive width (100% on mobile, fixed 380px on larger screens)
          width: { xs: "85vw", sm: 380 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          p: 0,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: { xs: 2, sm: 3 }, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* FIXED: Added overflowY auto to make content scrollable on small screens */}
      <Box
        sx={{
          p: { xs: 2, sm: 3 },
          overflowY: "auto",
          overflowX: "hidden",
          flex: 1,
        }}
      >
        {/* User Identity Section */}
        <Box sx={{ textAlign: "center", mb: 3 }}>
          <Avatar
            sx={{
              width: 80,
              height: 80,
              mx: "auto",
              mb: 2,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "2rem",
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Typography variant="h6" sx={{ fontWeight: 600, mb: 0.5 }}>
            {`${user.firstName} ${user.middleName ? user.middleName + " " : ""}${user.lastName}`}
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
            User ID: {user.userId}
          </Typography>
          <Chip
            label={user.roleName}
            size="small"
            sx={{
              backgroundColor: "#10B981",
              color: "white",
              fontWeight: 500,
            }}
          />
        </Box>

        {/* Organizational Information */}
        <Card sx={{ mb: 2 }}>
          <CardContent>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                mb: 1,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              Service Information
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={2}>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <Business
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Branch
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {branchDisplay}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <AccountTree
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Circle
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {circleDisplay}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <SmartScreen
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Access
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {user.isCircle ? "Circle Level" : "Branch Level"}
                  </Typography>
                </Box>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        {/* Contact Information */}
        <Card sx={{ mb: 3 }}>
          <CardContent>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                mb: 1,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              Contact Information
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={2}>
              <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                <Email sx={{ color: "text.secondary" }} />
                <Box sx={{ minWidth: 0 }}>
                  <Typography variant="body2" color="text.secondary">
                    Email
                  </Typography>
                  <Typography variant="body2" sx={{ wordBreak: "break-all" }}>
                    {user.email}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                <Phone sx={{ color: "text.secondary" }} />
                <Box>
                  <Typography variant="body2" color="text.secondary">
                    Contact No
                  </Typography>
                  <Typography variant="body2">{user.phoneNumber}</Typography>
                </Box>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        {/* Footer Actions */}
        <List sx={{ p: 0 }}>
          <ListItem disablePadding>
            <ListItemButton onClick={() => navigate("/help")}>
              <ListItemIcon>
                <Help />
              </ListItemIcon>
              <ListItemText primary="Help & Support" />
            </ListItemButton>
          </ListItem>

          <ListItem disablePadding sx={{ mt: 1, px: 1 }}>
            <ListItemButton
              onClick={logout}
              sx={{
                borderRadius: "12px",
                py: 1.5,
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                position: "relative",
                overflow: "hidden",
                color: "primary.main",
                "&:hover": {
                  backgroundColor: "primary",
                  borderLeftColor: "primary.main",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.05)",
                  "& .logout-icon": {
                    transform: "translateX(5px)",
                    color: "error.dark",
                  },
                },
              }}
            >
              <ListItemIcon
                className="connect-icon"
                sx={{
                  color: "primary.light",
                  minWidth: "40px",
                  transition: "transform 0.3s ease",
                }}
              >
                <Link fontSize="small" />
              </ListItemIcon>

              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: 700, letterSpacing: "0.3px" }}
                  >
                    Connect to SCORE
                  </Typography>
                }
              />
            </ListItemButton>
          </ListItem>

          <Divider sx={{ my: 1 }} />

          <ListItem disablePadding sx={{ mt: 1, px: 1 }}>
            <ListItemButton
              onClick={logout}
              sx={{
                borderRadius: "12px",
                py: 1.5,
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                position: "relative",
                overflow: "hidden",
                color: "error.main",
                "&:hover": {
                  backgroundColor: "rgba(211, 47, 47, 0.04)",
                  borderLeftColor: "error.main",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.05)",
                  "& .logout-icon": {
                    transform: "translateX(5px)",
                    color: "error.dark",
                  },
                  "& .shortcut-hint": {
                    opacity: 1,
                    transform: "scale(1.05)",
                    backgroundColor: "error.main",
                    color: "white",
                  },
                },
              }}
            >
              <ListItemIcon
                className="logout-icon"
                sx={{
                  color: "error.light",
                  minWidth: "40px",
                  transition: "transform 0.3s ease",
                }}
              >
                <Logout fontSize="small" />
              </ListItemIcon>

              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: 700, letterSpacing: "0.3px" }}
                  >
                    Sign Out
                  </Typography>
                }
              />

              {/* FIXED: Conditionally render the UI hint based on screen size */}
              {!isMobileOrTablet && (
                <Box
                  className="shortcut-hint"
                  sx={{
                    fontSize: "9px",
                    fontWeight: 800,
                    px: 1,
                    py: 0.3,
                    borderRadius: "6px",
                    border: "1px solid",
                    borderColor: "divider",
                    opacity: 0.6,
                    transition: "all 0.3s ease",
                    textTransform: "uppercase",
                  }}
                >
                  Alt + L
                </Box>
              )}
            </ListItemButton>
          </ListItem>
        </List>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
