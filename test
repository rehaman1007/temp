import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Box,
  Typography,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";

import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

/* ------------------ INITIAL STEP RESOLVER ------------------ */
const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex(
    (s) => s.stageStatus === StageStatus.STARTED,
  );
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.stageStatus === StageStatus.ERROR);
  if (error !== -1) return error;

  const completed = stages
    .map((s, i) => (s.stageStatus === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  return completed.length ? completed[completed.length - 1] : 0;
};

/* ------------------ MAIN DIALOG ------------------ */
const ProcessDetailsDialog = ({
  process,
  isCurrentDate,
  onClose,
  onStart,
  onStop,
  permissions = {},
}) => {
  const stages = useMemo(() => process?.stages || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    setActiveStep(resolveInitialActiveStep(stages));
  }, [stages]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.stageStatus;

  const nonActionableProcess =
    process.processId == 7 || process.processId == 12;

  return (
    <Dialog
      open={!!process}
      onClose={onClose}
      fullWidth
      maxWidth="lg"
      PaperProps={{
        sx: { height: "74vh" },
      }}
    >
      {/* ---------- HEADER ---------- */}
      <DialogTitle sx={{ pr: 6 }}>
        <Box>
          {/* Main Title */}
          <Typography variant="h6" component="div">
            {process.type} – Process Details
          </Typography>

          {/* Remarks Sub-header */}
          {process.remarks && (
            <Typography
              variant="caption"
              display="block"
              sx={{ color: "text.secondary", fontWeight: 400, mt: 0.5 }}
            >
              Remarks: {process.remarks}
            </Typography>
          )}
        </Box>

        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 12 }} // Adjusted top slightly for better centering
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      {/* ---------- BODY ---------- */}
      <DialogContent
        dividers
        sx={{
          p: 0,
          display: "grid",
          gridTemplateColumns: "280px 1fr",
          height: "100%",
        }}
      >
        {/* LEFT – SCROLLABLE STEPPER */}
        <Box
          sx={{
            borderRight: "1px solid",
            borderColor: "divider",
            overflowY: "auto",
            px: 2,
            py: 1,
          }}
        >
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />
        </Box>

        {/* RIGHT – FIXED CONTENT */}
        <Box sx={{ p: 3 }}>
          <StageDetails stage={stages[activeStep]} />
        </Box>
      </DialogContent>

      {/* ---------- FOOTER ---------- */}
      {isCurrentDate && (permissions.start || permissions.stop) && (
        <DialogActions>
          {permissions.start &&
            lastStatus !== StageStatus.STARTED &&
            !nonActionableProcess && (
              <Button
                startIcon={<RestartAltIcon />}
                onClick={() => onStart(process)}
              >
                Restart
              </Button>
            )}

          {permissions.stop &&
            lastStatus === StageStatus.STARTED &&
            !(
              nonActionableProcess ||
              (process.processId == 3 &&
                process.status == StageStatus.WAITING_FOR_APPROVAL)
            ) && (
              <Button
                color="error"
                startIcon={<StopIcon />}
                onClick={() => onStop(process)}
              >
                Stop
              </Button>
            )}

          {!(
            (permissions.start &&
              lastStatus !== StageStatus.STARTED &&
              !nonActionableProcess) ||
            (permissions.stop &&
              lastStatus === StageStatus.STARTED &&
              !(
                nonActionableProcess ||
                (process.processId == 3 &&
                  process.status == StageStatus.WAITING_FOR_APPROVAL)
              ))
          ) && <Button onClick={onClose}>Close</Button>}
        </DialogActions>
      )}
    </Dialog>
  );
};

export default ProcessDetailsDialog;
