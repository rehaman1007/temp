import { DataGrid } from "@mui/x-data-grid";
import {
  Box,
  IconButton,
  Stack,
  Tooltip,
  Typography,
} from "@mui/material";

import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";

import { StageStatus } from "../util/StageStatus";
import ProcessStatusChip from "./ProcessStatusChip";

/* ================= NO ROWS OVERLAY ================= */
const NoRowsOverlay = () => (
  <Stack height="100%" alignItems="center" justifyContent="center">
    <Typography color="text.secondary">
      No processes available
    </Typography>
  </Stack>
);

/* ================= MAIN COMPONENT ================= */
const ProcessStatusTable = ({ processes = [], actions, loading }) => {

  const rows = processes.map((p, i) => {
    const lastStage = p.stageDetails.at(-1);

    const hasSummary =
      p.type === "DIFFERENCE" &&
      p.stageDetails.some(
        (s) => s.processStage === 6 && s.status === StageStatus.COMPLETED
      );

    return {
      id: p.processId || `${p.type}-${i}`,
      processId: p.processId,
      type: p.type,
      status: lastStage.status,
      stage: lastStage.stage?.title,
      startTime: lastStage.startTime,
      endTime: lastStage.endTime,
      raw: p,
      hasSummary,
    };
  });

  const columns = [
    {
      field: "processId",
      headerName: "Process ID",
      width: 130,
    },
    {
      field: "type",
      headerName: "Process",
      flex: 1,
    },
    {
      field: "status",
      headerName: "Status",
      width: 140,
      renderCell: (p) => (
        <ProcessStatusChip status={p.value} />
      ),
    },
    {
      field: "stage",
      headerName: "Stage",
      flex: 1,
    },
    {
      field: "startTime",
      headerName: "Started",
      width: 180,
    },
    {
      field: "endTime",
      headerName: "Ended",
      width: 180,
    },
    {
      field: "actions",
      headerName: "Actions",
      width: 200,
      sortable: false,
      renderCell: (params) => {
        const row = params.row.raw;
        const lastStage = row.stageDetails.at(-1);

        const showRestart =
          lastStage.status !== StageStatus.STARTED;

        const showStop =
          lastStage.status === StageStatus.STARTED;

        return (
          <Stack direction="row" spacing={1}>
            {showRestart && (
              <Tooltip title="Restart">
                <IconButton
                  size="small"
                  onClick={() => actions.onStart(row)}
                >
                  <RestartAltIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}

            {showStop && (
              <Tooltip title="Stop">
                <IconButton
                  size="small"
                  onClick={() => actions.onStop(row)}
                >
                  <StopIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}

            <Tooltip title="View">
              <IconButton
                size="small"
                onClick={() =>
                  actions.onView(row.type)
                }
              >
                <VisibilityIcon fontSize="small" />
              </IconButton>
            </Tooltip>

            {params.row.hasSummary && (
              <Tooltip title="Summary">
                <IconButton
                  size="small"
                  onClick={() =>
                    actions.onSummary(row)
                  }
                >
                  <SummarizeOutlinedIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        );
      },
    },
  ];

  return (
    <Box sx={{ height: 500 }}>
      <DataGrid
        rows={rows}
        columns={columns}
        pageSizeOptions={[5, 10, 25]}
        initialState={{
          pagination: {
            paginationModel: {
              pageSize: 5,
              page: 0,
            },
          },
        }}
        loading={loading}
        disableRowSelectionOnClick
        slots={{
          noRowsOverlay: NoRowsOverlay,
        }}
      />
    </Box>
  );
};

export default ProcessStatusTable;