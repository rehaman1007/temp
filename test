package com.fincore.transactions_service.controller;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import com.fincore.transactions_service.service.AdminSupportService;

import jakarta.validation.Valid;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.http.MediaType;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.Map;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/admin-support")
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    /**
     * COMMAND PANEL EXECUTION
     */
    @PostMapping("/admin-execute")
    public Map<String, Object> executeAdminSql(
            @RequestBody
            @Valid
            AdminSupportDTO dto
    ) {

        log.info(
                "Admin SQL request received"
        );

        return adminSupportService
                .executeAdminSql(dto);
    }

    /**
     * SQL FILE UPLOAD
     */
    @PostMapping(
            value = "/upload-script",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public Map<String, Object> uploadScript(
            @RequestParam("file")
            MultipartFile file
    ) {

        log.info(
                "SQL Upload Received : {}",
                file.getOriginalFilename()
        );

        return adminSupportService
                .uploadSqlFile(file);
    }

    /**
     * JOB STATUS
     */
    @GetMapping("/job-status/{jobId}")
    public Map<String, Object> getJobStatus(
            @PathVariable
            String jobId
    ) {

        return adminSupportService
                .getJobStatus(jobId);
    }
}


