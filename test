processViewData: (data) => {
  if (!data || typeof data !== "object") {
    return data;
  }

  const {
    comp1 = "",
    segmentCode = "",
    comp2 = "",
    description = "",
    acClassification = "",
    balFwd = "",
    defBalType = "",
    status = "",
    balCompare = "",
    manualPosting = "",
  } = data;

  /* ---------- Lookups & Mappings ---------- */

  const accountClassificationLabel =
    ACCOUNT_CLASSIFICATIONS.find(
      (x) => x.value === acClassification
    )?.label || "N/A";

  const yesNo = (val) => (val === "1" ? "Yes" : "No");

  const defaultBalanceTypeMap = {
    C: "Credit",
    D: "Debit",
    M: "Memo",
  };

  const statusMap = {
    1: "Active",
    0: "Inactive",
  };

  const includeExclude = (val) => (val === "1" ? "Include" : "Exclude");

  /* ---------- View Payload ---------- */

  const viewPayload = {
    "CGL Code": [comp1, segmentCode, comp2].filter(Boolean).join(" "),
    Description: description || "-",
    "Account Classification": accountClassificationLabel,
    "Balance Carry Forward": yesNo(balFwd),
    "Default Balance Type":
      defaultBalanceTypeMap[defBalType] || "N/A",
    Status: statusMap[status] || "Unknown",
    "Balance Compare": includeExclude(balCompare),
    "Manual Posting Allowed": yesNo(manualPosting),
  };

  /* ---------- Final Return ---------- */

  return {
    ...data,
    payload: viewPayload,
  };
},