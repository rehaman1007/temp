package com.fincore.enquiry_service.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.enquiry_service.dto.*;
import com.fincore.enquiry_service.model.LedgerTransaction;
import com.fincore.enquiry_service.repository.LedgerWiseRepository;
import com.fincore.enquiry_service.specification.LedgerSpecification;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.ss.util.CellRangeAddress;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;

import org.springframework.data.domain.*;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.util.List;

@Slf4j
@RequiredArgsConstructor
@Service("LedgerEnquiryService")
public class LedgerEnquiryServiceImpl implements LedgerEnquiryService {

    /*
     * =========================================
     * EXPORT CONFIG
     * =========================================
     */
    private static final int SXSSF_WINDOW_SIZE = 20000;

    /*
     * MAX EXPORT LIMIT
     */
    private static final long MAX_EXPORT_RECORDS = 1_000_000;

    private final LedgerWiseRepository ledgerTransactionRepository;
    private final MyDownloadsService myDownloadsService;

    @Override
    public Page<LedgerEnquiryResponse> search(
            LedgerEnquiryRequest dto
    ) {

        Sort.Direction direction =
                "asc".equalsIgnoreCase(dto.getSortOrder())
                        ? Sort.Direction.ASC
                        : Sort.Direction.DESC;

        Pageable pageable =
                PageRequest.of(
                        dto.getPage(),
                        dto.getSize(),
                        Sort.by(
                                direction,
                                getSortField(dto.getSortField())
                        )
                );

        Page<LedgerTransaction> page =
                ledgerTransactionRepository.findAll(
                        LedgerSpecification.build(dto),
                        pageable
                );

        return page.map(this::mapToDto);
    }

    @Override
    public byte[] excelExport(
            LedgerEnquiryRequest dto,
            String userId
    ) {

        long totalRecords =
                ledgerTransactionRepository.count(
                        LedgerSpecification.build(dto)
                );

        /*
         * HUGE DATA PROTECTION
         */
        if (totalRecords > MAX_EXPORT_RECORDS) {

            throw new RuntimeException(
                    "Excel cannot be exported for more than "
                            + MAX_EXPORT_RECORDS
                            + " records."
            );
        }

        log.info(
                "Starting Ledger Export | Total Records : {}",
                totalRecords
        );

        long start = System.currentTimeMillis();

        try (

                /*
                 * FASTEST SXSSF CONFIG
                 */
                SXSSFWorkbook workbook =
                        new SXSSFWorkbook(
                                null,
                                SXSSF_WINDOW_SIZE,
                                true,
                                true
                        );

                ByteArrayOutputStream out =
                        new ByteArrayOutputStream()

        ) {

            workbook.setCompressTempFiles(true);

            Sheet sheet =
                    workbook.createSheet("Ledger Report");

            /*
             * =========================
             * STYLES
             * =========================
             */

            Font headerFont =
                    workbook.createFont();

            headerFont.setBold(true);

            CellStyle headerStyle =
                    workbook.createCellStyle();

            headerStyle.setFont(headerFont);
            headerStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            Font titleFont =
                    workbook.createFont();

            titleFont.setBold(true);
            titleFont.setFontHeightInPoints(
                    (short) 14
            );

            CellStyle titleStyle =
                    workbook.createCellStyle();

            titleStyle.setFont(titleFont);
            titleStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            /*
             * =========================
             * TITLES
             * =========================
             */

            Row title1 = sheet.createRow(0);

            Cell titleCell1 =
                    title1.createCell(0);

            titleCell1.setCellValue(
                    "Ledger-Wise Enquiry"
            );

            titleCell1.setCellStyle(titleStyle);

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            0,
                            0,
                            0,
                            17
                    )
            );

            Row title2 = sheet.createRow(1);

            Cell titleCell2 =
                    title2.createCell(0);

            titleCell2.setCellValue(
                    "CGL : "
                            + dto.getCgl()
                            + " - "
                            + dto.getCglName()
            );

            titleCell2.setCellStyle(titleStyle);

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            1,
                            1,
                            0,
                            17
                    )
            );

            Row title3 = sheet.createRow(2);

            Cell titleCell3 =
                    title3.createCell(0);

            titleCell3.setCellValue(
                    "From "
                            + dto.getFromDate()
                            + " To "
                            + dto.getToDate()
            );

            titleCell3.setCellStyle(titleStyle);

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            2,
                            2,
                            0,
                            17
                    )
            );

            /*
             * =========================
             * HEADER
             * =========================
             */

            String[] headers = {
                    "TRANSACTION ID",
                    "BATCH ID",
                    "JOURNAL ID",
                    "TRANSACTION DATE",
                    "POST DATE",
                    "BRANCH CODE",
                    "BRANCH NAME",
                    "CIRCLE CODE",
                    "CIRCLE NAME",
                    "CURRENCY",
                    "CURRENCY NAME",
                    "CGL",
                    "DESCRIPTION",
                    "NARRATION",
                    "DEBIT AMOUNT",
                    "CREDIT AMOUNT",
                    "TRANSACTION COUNT",
                    "SOURCE NAME"
            };

            Row headerRow =
                    sheet.createRow(3);

            for (
                    int i = 0;
                    i < headers.length;
                    i++
            ) {

                Cell cell =
                        headerRow.createCell(i);

                cell.setCellValue(headers[i]);
                cell.setCellStyle(headerStyle);
            }

            /*
             * =========================
             * FIXED WIDTHS
             * =========================
             */

            sheet.setColumnWidth(0, 5000);
            sheet.setColumnWidth(1, 5000);
            sheet.setColumnWidth(2, 5000);
            sheet.setColumnWidth(3, 5000);
            sheet.setColumnWidth(4, 5000);
            sheet.setColumnWidth(5, 5000);
            sheet.setColumnWidth(6, 9000);
            sheet.setColumnWidth(7, 5000);
            sheet.setColumnWidth(8, 9000);
            sheet.setColumnWidth(9, 5000);
            sheet.setColumnWidth(10, 9000);
            sheet.setColumnWidth(11, 5000);
            sheet.setColumnWidth(12, 12000);
            sheet.setColumnWidth(13, 15000);
            sheet.setColumnWidth(14, 6000);
            sheet.setColumnWidth(15, 6000);
            sheet.setColumnWidth(16, 6000);
            sheet.setColumnWidth(17, 10000);

            /*
             * =========================
             * PAGED STREAMING
             * =========================
             */

            int excelRow = 4;

            int page = 0;

            int chunkSize = 20000;

            while (true) {

                Pageable pageable =
                        PageRequest.of(
                                page,
                                chunkSize,
                                Sort.by(
                                        Sort.Direction.ASC,
                                        "transactionDate"
                                )
                        );

                Page<LedgerTransaction> chunk =
                        ledgerTransactionRepository.findAll(
                                LedgerSpecification.build(dto),
                                pageable
                        );

                if (!chunk.hasContent()) {
                    break;
                }

                for (
                        LedgerTransaction entity
                                : chunk.getContent()
                ) {

                    LedgerEnquiryResponse rowDto =
                            mapToDto(entity);

                    Row row =
                            sheet.createRow(excelRow++);

                    row.createCell(0)
                            .setCellValue(
                                    safeString(
                                            rowDto.getTransactionId()
                                    )
                            );

                    row.createCell(1)
                            .setCellValue(
                                    safeString(
                                            rowDto.getBatchId()
                                    )
                            );

                    row.createCell(2)
                            .setCellValue(
                                    safeString(
                                            rowDto.getJournalId()
                                    )
                            );

                    row.createCell(3)
                            .setCellValue(
                                    safeString(
                                            rowDto.getTransactionDate()
                                    )
                            );

                    row.createCell(4)
                            .setCellValue(
                                    safeString(
                                            rowDto.getPostDate()
                                    )
                            );

                    row.createCell(5)
                            .setCellValue(
                                    safeString(
                                            rowDto.getBranchCode()
                                    )
                            );

                    row.createCell(6)
                            .setCellValue(
                                    safeString(
                                            rowDto.getBranchName()
                                    )
                            );

                    row.createCell(7)
                            .setCellValue(
                                    safeString(
                                            rowDto.getCircleCode()
                                    )
                            );

                    row.createCell(8)
                            .setCellValue(
                                    safeString(
                                            rowDto.getCircleName()
                                    )
                            );

                    row.createCell(9)
                            .setCellValue(
                                    safeString(
                                            rowDto.getCurrency()
                                    )
                            );

                    row.createCell(10)
                            .setCellValue(
                                    safeString(
                                            rowDto.getCurrencyName()
                                    )
                            );

                    row.createCell(11)
                            .setCellValue(
                                    safeString(
                                            rowDto.getCgl()
                                    )
                            );

                    row.createCell(12)
                            .setCellValue(
                                    safeString(
                                            rowDto.getDescription()
                                    )
                            );

                    row.createCell(13)
                            .setCellValue(
                                    safeString(
                                            rowDto.getNarration()
                                    )
                            );

                    row.createCell(14)
                            .setCellValue(
                                    rowDto.getDebitAmount() != null
                                            ? rowDto.getDebitAmount().doubleValue()
                                            : 0
                            );

                    row.createCell(15)
                            .setCellValue(
                                    rowDto.getCreditAmount() != null
                                            ? rowDto.getCreditAmount().doubleValue()
                                            : 0
                            );

                    row.createCell(16)
                            .setCellValue(
                                    rowDto.getTransactionCount() != null
                                            ? rowDto.getTransactionCount()
                                            : 0
                            );

                    row.createCell(17)
                            .setCellValue(
                                    safeString(
                                            rowDto.getSourceName()
                                    )
                            );
                }

                log.info(
                        "Processed Page : {}",
                        page
                );

                page++;

                sheet.flushRows(500);
            }

            workbook.write(out);

            workbook.dispose();

            byte[] bytes =
                    out.toByteArray();

            try {

                String json =
                        new ObjectMapper()
                                .writeValueAsString(dto);

                sendToMyDownloads(
                        userId,
                        json,
                        bytes
                );

            } catch (Exception e) {

                log.error(
                        "MyDownloads Failed",
                        e
                );
            }

            long end =
                    System.currentTimeMillis();

            log.info(
                    "Export Completed In {} Seconds",
                    (end - start) / 1000
            );

            return bytes;

        } catch (IOException e) {

            throw new RuntimeException(
                    "Failed to generate excel",
                    e
            );
        }
    }

    /*
     * =========================================
     * DTO MAPPING
     * =========================================
     */

    private LedgerEnquiryResponse mapToDto(
            LedgerTransaction entity
    ) {

        String branchCode = null;
        String branchName = null;
        String circleCode = null;
        String circleName = null;

        try {

            if (entity.getBranch() != null) {

                branchCode =
                        entity.getBranch().getCode();

                branchName =
                        entity.getBranch().getName();

                if (
                        entity.getBranch().getCircle()
                                != null
                ) {

                    circleCode =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleCode();

                    circleName =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleName();
                }
            }

        } catch (Exception e) {

            log.warn(
                    "Branch Mapping Failed : {}",
                    entity.getTransactionId()
            );
        }

        return new LedgerEnquiryResponse(

                entity.getTransactionId(),
                entity.getBatchId(),
                entity.getJournalId(),
                entity.getTransactionDate(),
                entity.getPostDate(),

                branchCode,
                branchName,

                circleCode,
                circleName,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyCode()
                        : null,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyName()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getCglNumber()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getDescription()
                        : null,

                entity.getNarration(),
                entity.getDebitAmount(),
                entity.getCreditAmount(),
                entity.getTransactionCount(),

                entity.getSourceFlag(),

                entity.getSourceFlagMaster() != null
                        ? entity.getSourceFlagMaster()
                        .getFlagName()
                        : null
        );
    }

    private void sendToMyDownloads(
            String userId,
            String criteria,
            byte[] content
    ) {

        try {

            MyDownloadsRequestDTO request =
                    new MyDownloadsRequestDTO(
                            userId,
                            "LedgerWiseEnquiry.xlsx",
                            51,
                            criteria,
                            content
                    );

            myDownloadsService.insertRequest(
                    request
            );

        } catch (Exception e) {

            log.error(
                    "Download Save Failed",
                    e
            );
        }
    }

    private String safeString(
            Object value
    ) {

        return value != null
                ? value.toString()
                : "";
    }

    private String getSortField(
            String field
    ) {

        return switch (field) {

            case "transactionId" -> "transactionId";
            case "batchId" -> "batchId";
            case "journalId" -> "journalId";
            case "transactionDate" -> "transactionDate";
            case "postDate" -> "postDate";
            case "narration" -> "narration";
            case "debitAmount" -> "debitAmount";
            case "creditAmount" -> "creditAmount";
            case "transactionCount" -> "transactionCount";
            case "sourceFlag" -> "sourceFlag";

            case "branchCode" -> "branch.code";
            case "branchName" -> "branch.name";

            case "circleCode" -> "branch.circle.circleCode";
            case "circleName" -> "branch.circle.circleName";

            case "currency" -> "currencyMaster.currencyCode";
            case "currencyName" -> "currencyMaster.currencyName";

            case "cgl" -> "cglMaster.cglNumber";
            case "description" -> "cglMaster.description";

            default -> "transactionDate";
        };
    }
}