// src/hooks/useStreamApi.js
import { useEffect, useRef, useState, useCallback } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const useStreamApi = () => {
  const token = useSelector((state) => state.auth.token);
  const snackbar = useCustomSnackbar();

  const controllerRef = useRef(null);
  const [connected, setConnected] = useState(false);
  const [lastMessage, setLastMessage] = useState(null);

  const startStream = useCallback(
    (url, { onMessage, onOpen, onError } = {}) => {
      if (!token) return console.warn("No token, cannot start SSE stream");

      // Cancel any existing connection
      if (controllerRef.current) controllerRef.current.abort();

      const controller = new AbortController();
      controllerRef.current = controller;

      fetchEventSource(url, {
        method: "GET",
        headers: { Authorization: `Bearer ${token}` },
        signal: controller.signal,

        onopen(response) {
          if (response.ok && response.status === 200) {
            console.log("✅ SSE Connection established");
            setConnected(true);
            onOpen?.(response);
          } else {
            console.error("❌ SSE Connection failed:", response.status);
            snackbar(`SSE Connection failed (${response.status})`, "error");
          }
        },

        onmessage(event) {
          if (event.event === "connected") {
            console.log("📡 Server connected:", event.data);
            return;
          }
          if (event.event === "new_notification") {
            try {
              const data = JSON.parse(event.data);
              setLastMessage(data);
              onMessage?.(data);
            } catch (err) {
              console.error("SSE message parse error:", err);
            }
          }
        },

        onerror(err) {
          console.error("SSE Error:", err);
          setConnected(false);
          onError?.(err);
        },
      });
    },
    [token, snackbar]
  );

  const stopStream = useCallback(() => {
    if (controllerRef.current) {
      controllerRef.current.abort();
      controllerRef.current = null;
      setConnected(false);
      console.log("🛑 SSE connection stopped.");
    }
  }, []);

  useEffect(() => stopStream, [stopStream]);

  return { connected, lastMessage, startStream, stopStream };
};

export default useStreamApi;


// src/hooks/useNotifications.js
import { useState, useEffect, useCallback } from "react";
import useApi from "./useApi";
import useStreamApi from "./useStreamApi";

const BASE_URL = "http://localhost:9010"; // Replace with your gateway or env var

const useNotifications = () => {
  const { callApi } = useApi();
  const { startStream, stopStream, lastMessage, connected } = useStreamApi();

  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);

  // Fetch initial unread count
  const fetchUnreadCount = useCallback(async () => {
    try {
      const data = await callApi(`${BASE_URL}/notifications/unread-count`);
      if (data?.count !== undefined) setUnreadCount(data.count);
    } catch (err) {
      console.error("Failed to fetch unread count:", err);
    }
  }, [callApi]);

  // Fetch notification history (page 0)
  const fetchHistory = useCallback(async () => {
    try {
      const data = await callApi(`${BASE_URL}/notifications?page=0&size=20`);
      setNotifications(data?.content || []);
    } catch (err) {
      console.error("Failed to fetch notifications:", err);
    }
  }, [callApi]);

  // Mark as read
  const markAsRead = useCallback(
    async (id) => {
      try {
        await callApi(`${BASE_URL}/notifications/${id}/read`, {}, "POST");
        setNotifications((prev) =>
          prev.map((n) => (n.id === id ? { ...n, isRead: true } : n))
        );
        setUnreadCount((prev) => Math.max(0, prev - 1));
      } catch (err) {
        console.error("Failed to mark notification as read:", err);
      }
    },
    [callApi]
  );

  // Start SSE stream
  useEffect(() => {
    fetchUnreadCount();
    fetchHistory();

    startStream(`${BASE_URL}/notifications/stream`, {
      onMessage: (newNotification) => {
        setNotifications((prev) => [newNotification, ...prev]);
        setUnreadCount((prev) => prev + 1);
      },
    });

    return () => stopStream();
  }, [fetchUnreadCount, fetchHistory, startStream, stopStream]);

  // When SSE lastMessage updates externally
  useEffect(() => {
    if (lastMessage) {
      setNotifications((prev) => [lastMessage, ...prev]);
      setUnreadCount((prev) => prev + 1);
    }
  }, [lastMessage]);

  return {
    connected,
    notifications,
    unreadCount,
    fetchUnreadCount,
    fetchHistory,
    markAsRead,
    stopStream,
  };
};

export default useNotifications;

import React from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
} from "@mui/material";
import { Close } from "@mui/icons-material";
import useNotifications from "../hooks/useNotifications";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
}) => {
  const { notifications, connected, markAsRead } = useNotifications();

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{ "& .MuiDrawer-paper": { width: 400, p: 0 } }}
    >
      <Box sx={{ p: 3, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Notifications {connected ? "(Live)" : ""}
          </Typography>
          <IconButton onClick={() => setNotificationDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      <Box sx={{ p: 2 }}>
        {notifications.map((n) => (
          <Paper
            key={n.id}
            sx={{
              p: 2,
              mb: 2,
              border: n.isRead ? "1px solid #E2E8F0" : "1px solid #1565C0",
              backgroundColor: n.isRead ? "white" : "#F0F9FF",
              cursor: "pointer",
              "&:hover": { backgroundColor: "#F8FAFC" },
            }}
            onClick={() => markAsRead(n.id)}
          >
            <Typography variant="subtitle2" sx={{ fontWeight: 600, mb: 0.5 }}>
              {n.message}
            </Typography>
            <Typography variant="caption" sx={{ color: "text.secondary" }}>
              {new Date(n.createdAt).toLocaleString()}
            </Typography>
          </Paper>
        ))}
      </Box>

      <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
        <Button fullWidth variant="outlined">
          View All Notifications
        </Button>
      </Box>
    </Drawer>
  );
};

export default NotificationDrawer;