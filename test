package com.fincore.transactions_service.controller;

import com.fincore.transactions_service.service.AdminSupportService;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;

import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.util.Map;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/admin-support")
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    @PostMapping(
            value = "/upload-script",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public ResponseEntity<?> uploadScript(
            @RequestParam("file") MultipartFile file
    ) {

        log.info(
                "SQL Upload Received : {} | Size : {} bytes",
                file.getOriginalFilename(),
                file.getSize()
        );

        return ResponseEntity.ok(
                adminSupportService.uploadSqlFile(file)
        );
    }

    @GetMapping("/job-status/{jobId}")
    public ResponseEntity<?> getJobStatus(
            @PathVariable String jobId
    ) {

        return ResponseEntity.ok(
                adminSupportService.getJobStatus(jobId)
        );
    }
}


package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.stereotype.Service;

import org.springframework.web.multipart.MultipartFile;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;

import java.util.Map;
import java.util.UUID;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final AdminSupportExecutor adminSupportExecutor;

    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file
    ) {

        try {

            String jobId = UUID.randomUUID().toString();

            Path tempFile = Files.createTempFile(
                    "sql-upload-",
                    ".sql"
            );

            Files.copy(
                    file.getInputStream(),
                    tempFile,
                    StandardCopyOption.REPLACE_EXISTING
            );

            log.info(
                    "Temporary SQL file created : {}",
                    tempFile
            );

            adminSupportExecutor.executeScriptAsync(
                    tempFile,
                    jobId
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId,
                    "message", "SQL execution started"
            );

        } catch (Exception e) {

            log.error(
                    "Failed to start SQL execution",
                    e
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return adminSupportExecutor.getJobStatus(
                jobId
        );
    }
}

package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;

import java.io.BufferedReader;

import java.nio.file.Files;
import java.nio.file.Path;

import java.sql.Connection;
import java.sql.Statement;

import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    private final DataSource dataSource;

    private final Map<String, Map<String, Object>>
            jobStatusMap = new ConcurrentHashMap<>();

    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path path,
            String jobId
    ) {

        Connection connection = null;

        BufferedReader reader = null;

        int count = 0;

        try {

            log.info(
                    "SQL execution started | JobId : {}",
                    jobId
            );

            jobStatusMap.put(
                    jobId,
                    Map.of(
                            "status", "RUNNING",
                            "executedCount", 0
                    )
            );

            connection = dataSource.getConnection();

            connection.setAutoCommit(false);

            Statement statement =
                    connection.createStatement();

            /**
             * VERY IMPORTANT
             */
            statement.setQueryTimeout(0);

            reader = Files.newBufferedReader(path);

            StringBuilder sqlBuilder =
                    new StringBuilder();

            String line;

            while ((line = reader.readLine()) != null) {

                String trimmed = line.trim();

                if (trimmed.isBlank()) {
                    continue;
                }

                if (trimmed.startsWith("--")) {
                    continue;
                }

                sqlBuilder.append(line).append("\n");

                if (trimmed.endsWith(";")) {

                    String sql =
                            sqlBuilder.toString();

                    sql = sql.substring(
                            0,
                            sql.lastIndexOf(";")
                    );

                    validateDangerousSql(sql);

                    long start =
                            System.currentTimeMillis();

                    statement.execute(sql);

                    long end =
                            System.currentTimeMillis();

                    count++;

                    /**
                     * COMMIT EVERY 500
                     */
                    if (count % 500 == 0) {

                        connection.commit();

                        log.info(
                                "Batch committed | Count : {}",
                                count
                        );
                    }

                    if (count % 100 == 0) {

                        log.info(
                                "Executed : {} | Time : {} ms",
                                count,
                                (end - start)
                        );
                    }

                    jobStatusMap.put(
                            jobId,
                            Map.of(
                                    "status", "RUNNING",
                                    "executedCount", count
                            )
                    );

                    sqlBuilder.setLength(0);
                }
            }

            connection.commit();

            log.info(
                    "SQL execution completed | Total : {}",
                    count
            );

            jobStatusMap.put(
                    jobId,
                    Map.of(
                            "status", "COMPLETED",
                            "executedCount", count
                    )
            );

            /**
             * CLEANUP
             */
            Files.deleteIfExists(path);

        } catch (Exception e) {

            log.error(
                    "SQL execution failed at count : {}",
                    count,
                    e
            );

            try {

                if (connection != null &&
                        !connection.isClosed()) {

                    connection.rollback();

                    log.error(
                            "Transaction rollback completed"
                    );
                }

            } catch (Exception rollbackEx) {

                log.error(
                        "Rollback failed",
                        rollbackEx
                );
            }

            jobStatusMap.put(
                    jobId,
                    Map.of(
                            "status", "FAILED",
                            "executedCount", count,
                            "message", e.getMessage()
                    )
            );
        }

        finally {

            try {

                if (reader != null) {
                    reader.close();
                }

                if (connection != null &&
                        !connection.isClosed()) {

                    connection.close();
                }

            } catch (Exception e) {

                log.error(
                        "Cleanup failed",
                        e
                );
            }
        }
    }

    private void validateDangerousSql(
            String sql
    ) {

        String upper =
                sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        || upper.contains("ALTER SYSTEM")
                        || upper.contains("SHUTDOWN")
                        || upper.contains("CREATE USER")
                        || upper.contains("DROP USER")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL blocked"
            );
        }
    }

    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStatusMap.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }
}

package com.fincore.transactions_service.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import org.springframework.scheduling.annotation.EnableAsync;

import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

@Configuration
@EnableAsync
public class AsyncConfig {

    @Bean("sqlExecutor")
    public Executor sqlExecutor() {

        ThreadPoolTaskExecutor executor =
                new ThreadPoolTaskExecutor();

        executor.setCorePoolSize(2);

        executor.setMaxPoolSize(2);

        executor.setQueueCapacity(10);

        executor.setThreadNamePrefix(
                "SQL-EXECUTOR-"
        );

        executor.initialize();

        return executor;
    }
}