                sx={{
                  flex: 1,

                  minHeight: 0,

                  display: "flex",
                  flexDirection: "column",

                  backgroundColor:
                    "#17191f",

                  borderRadius: 2,

                  overflow: "hidden",

                  border:
                    "1px solid #2b2e36",

                  boxShadow:
                    "inset 0 0 0 1px rgba(255,255,255,0.02)",
                }}
              >
                {/* TERMINAL HEADER */}

                <Box
                  sx={{
                    height: {
                      xs: 34,
                      sm: 38,
                    },

                    flexShrink: 0,

                    display: "flex",
                    alignItems: "center",
                    justifyContent:
                      "space-between",

                    px: {
                      xs: 1.2,
                      sm: 1.5,
                    },

                    backgroundColor:
                      "#22252c",

                    borderBottom:
                      "1px solid #30333b",
                  }}
                >
                  <Box
                    sx={{
                      display: "flex",
                      alignItems: "center",
                    }}
                  >
                    <TerminalIcon
                      sx={{
                        fontSize: 16,

                        color:
                          "#9da5b4",

                        mr: 0.7,
                      }}
                    />

                    <Typography
                      sx={{
                        color: "#d4d7de",

                        fontSize: {
                          xs: "0.62rem",
                          sm: "0.68rem",
                        },

                        fontWeight: 700,

                        letterSpacing:
                          "0.4px",
                      }}
                    >
                      OUTPUT TERMINAL
                    </Typography>
                  </Box>

                  <Tooltip
                    title="Copy result"
                    arrow
                  >
                    <span>
                      <IconButton
                        size="small"
                        disabled={
                          !outputData
                        }
                        onClick={() =>
                          handleCopy(
                            outputData,
                            "Result copied to clipboard!"
                          )
                        }
                        sx={{
                          color:
                            "#9da5b4",

                          "&:hover": {
                            color: "#fff",
                          },

                          "&.Mui-disabled": {
                            color:
                              "#4d515b",
                          },
                        }}
                      >
                        <ContentCopyIcon
                          sx={{
                            fontSize: 15,
                          }}
                        />
                      </IconButton>
                    </span>
                  </Tooltip>
                </Box>

                {/* =================================================
                    TERMINAL OUTPUT CONTENT
                ================================================== */}

                <Box
                  sx={{
                    flex: 1,

                    minHeight: 0,

                    overflowY: "auto",
                    overflowX: "auto",

                    p: {
                      xs: 1.2,
                      sm: 1.5,
                      md: 2,
                    },

                    textAlign: "left",

                    "&::-webkit-scrollbar": {
                      width: 7,
                      height: 7,
                    },

                    "&::-webkit-scrollbar-track": {
                      background:
                        "#1a1c21",
                    },

                    "&::-webkit-scrollbar-thumb": {
                      background:
                        "#454952",

                      borderRadius: 10,
                    },

                    "&::-webkit-scrollbar-thumb:hover": {
                      background:
                        "#5b606b",
                    },
                  }}
                >
                  {outputData ? (
                    <pre
                      style={{
                        margin: 0,

                        color: "#61d68a",

                        fontFamily:
                          '"Fira Code", "Roboto Mono", monospace',

                        fontSize:
                          "clamp(10px, 0.72vw, 13px)",

                        lineHeight: 1.55,

                        whiteSpace:
                          "pre-wrap",

                        overflowWrap:
                          "anywhere",

                        wordBreak:
                          "break-word",
                      }}
                    >
                      {outputData}
                    </pre>
                  ) : (
                    <Box
                      sx={{
                        height: "100%",

                        minHeight: 80,

                        display: "flex",
                        alignItems: "center",
                        justifyContent:
                          "center",

                        flexDirection:
                          "column",

                        gap: 0.7,
                      }}
                    >
                      <TerminalIcon
                        sx={{
                          fontSize: 28,

                          color:
                            "#41454e",
                        }}
                      />

                      <Typography
                        sx={{
                          color:
                            "#666b76",

                          fontSize: {
                            xs: "0.68rem",
                            sm: "0.72rem",
                          },

                          fontStyle:
                            "italic",
                        }}
                      >
                        Awaiting execution...
                      </Typography>
                    </Box>
                  )}
                </Box>
              </Box>
            </Box>
          </Paper>
        </Box>
      </Box>

      {/* =====================================================
          GLOBAL SNACKBAR
      ====================================================== */}

      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={
          handleCloseSnackbar
        }
        anchorOrigin={{
          vertical: "bottom",
          horizontal: "center",
        }}
      >
        <Alert
          onClose={
            handleCloseSnackbar
          }
          severity={
            snackbar.severity
          }
          variant="filled"
          sx={{
            width: "100%",
            boxShadow: 4,
          }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}