private LedgerEnquiryResponse mapEntityToDto(
        GlTransactions entity
) {

    return new LedgerEnquiryResponse(

            entity.getTransactionId(),

            entity.getBatchId(),

            entity.getJournalId(),

            entity.getTransactionDate(),

            entity.getPostDate(),

            entity.getBranchCode(),

            entity.getBranch() != null
                    ? entity.getBranch().getName()
                    : null,

            entity.getBranch() != null
                    ? entity.getBranch()
                        .getCircleCode()
                    : null,

            entity.getBranch() != null &&
            entity.getBranch().getCircle() != null
                    ? entity.getBranch()
                        .getCircle()
                        .getCircleName()
                    : null,

            entity.getCurrency(),

            entity.getCurrencyMaster() != null
                    ? entity.getCurrencyMaster()
                        .getCurrencyName()
                    : null,

            entity.getCgl(),

            entity.getCglMaster() != null
                    ? entity.getCglMaster()
                        .getDescription()
                    : null,

            entity.getNarration(),

            entity.getDebitAmount(),

            entity.getCreditAmount(),

            entity.getTransactionCount(),

            entity.getSourceFlag()
    );
}


@ManyToOne(fetch = FetchType.LAZY)
@JoinColumn(
    name = "BRANCH_CODE",
    referencedColumnName = "CODE",
    insertable = false,
    updatable = false
)
private BranchMaster branch;

@ManyToOne(fetch = FetchType.LAZY)
@JoinColumn(
    name = "CURRENCY",
    referencedColumnName = "CURRENCY_CODE",
    insertable = false,
    updatable = false
)
private CurrencyMaster currencyMaster;

@ManyToOne(fetch = FetchType.LAZY)
@JoinColumn(
    name = "CGL",
    referencedColumnName = "CGL_NUMBER",
    insertable = false,
    updatable = false
)
private CglMaster cglMaster;

@ManyToOne(fetch = FetchType.LAZY)
@JoinColumn(
    name = "CIRCLE_CODE",
    referencedColumnName = "CIRCLE_CODE",
    insertable = false,
    updatable = false
)
private CircleMaster circle;