SELECT 
    cm.CURRENCY_CODE,
    cm.CURRENCY_NAME,
    cm.CURRENCY_RATE,
    cm.UPDATED_AT,
    CASE
        WHEN crc.rate_change_date IS NULL AND p.REQ_STATUS IS NULL THEN 'U'
        WHEN p.REQ_STATUS = 'P' THEN 'P'
        ELSE 'A'
    END AS CHANGE_STATUS
FROM 
    currency_master cm
LEFT JOIN 
    currency_rate_change crc 
    ON cm.currency_code = crc.currency_code
    AND crc.rate_change_date BETWEEN SYSDATE - 7 AND SYSDATE + 7
LEFT JOIN 
    COMMON_REQ p 
    ON cm.currency_code = p.TARGET_ID
    AND p.REQ_TYPE = 'CURRENCY_RATE_CHANGE'
    AND p.REQ_DATE BETWEEN SYSDATE - 7 AND SYSDATE + 7
    AND p.REQ_STATUS = 'P';   
