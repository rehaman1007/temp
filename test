package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportExecutor {

    /**
     * =================================================
     * LIVE JOB STATUS CACHE
     * =================================================
     */
    public static final Map<String, Map<String, Object>> JOB_STATUS =
            new ConcurrentHashMap<>();

    /**
     * =================================================
     * PERFORMANCE CONFIG
     * =================================================
     */
    private static final int BATCH_SIZE = 10000;

    /**
     * STATUS UPDATE FREQUENCY
     */
    private static final int STATUS_UPDATE_INTERVAL = 1;

    /**
     * LOGGING FREQUENCY
     */
    private static final int LOG_INTERVAL = 10000;

    private final JdbcTemplate jdbcTemplate;

    /**
     * =================================================
     * CLEAN ORACLE TYPES
     * =================================================
     */
    public List<Map<String, Object>> cleanOracleRows(
            List<Map<String, Object>> rawRows
    ) {

        List<Map<String, Object>> rows = new ArrayList<>();

        for (Map<String, Object> rawRow : rawRows) {

            Map<String, Object> cleanRow =
                    new LinkedHashMap<>();

            for (Map.Entry<String, Object> entry :
                    rawRow.entrySet()) {

                Object value = entry.getValue();

                try {

                    if (value instanceof oracle.sql.TIMESTAMP ts) {

                        cleanRow.put(
                                entry.getKey(),
                                ts.timestampValue().toString()
                        );

                    } else if (value instanceof java.sql.Timestamp ts) {

                        cleanRow.put(
                                entry.getKey(),
                                ts.toLocalDateTime().toString()
                        );

                    } else if (value instanceof java.sql.Clob clob) {

                        cleanRow.put(
                                entry.getKey(),
                                clob.getSubString(
                                        1,
                                        (int) clob.length()
                                )
                        );

                    } else if (value instanceof java.io.InputStream) {

                        cleanRow.put(
                                entry.getKey(),
                                "[BLOB DATA]"
                        );

                    } else if (
                            value != null
                                    &&
                                    value.getClass()
                                            .getName()
                                            .startsWith("oracle.sql.")
                    ) {

                        cleanRow.put(
                                entry.getKey(),
                                value.toString()
                        );

                    } else {

                        cleanRow.put(
                                entry.getKey(),
                                value
                        );
                    }

                } catch (Exception e) {

                    cleanRow.put(
                            entry.getKey(),
                            "[UNSUPPORTED]"
                    );
                }
            }

            rows.add(cleanRow);
        }

        return rows;
    }

    /**
     * =================================================
     * INSERT EXECUTION LOG
     * =================================================
     */
    public void insertExecutionLog(
            String jobId,
            String userId,
            String clientIp,
            String fileName,
            String executionType,
            String status,
            int totalStatements,
            int executedCount,
            int insertCount,
            int updateCount,
            int deleteCount,
            int otherCount,
            Integer failedStatementNumber,
            String failedSql,
            String exceptionType,
            String exceptionMessage,
            long executionSpeed,
            long elapsedSeconds,
            String sqlText
    ) {

        try {

            jdbcTemplate.update("""
                    INSERT INTO ADMIN_SUPPORT_LOG
                    (
                        ID,
                        JOB_ID,
                        USER_ID,
                        CLIENT_IP,
                        FILE_NAME,
                        EXECUTION_TYPE,
                        STATUS,
                        TOTAL_STATEMENTS,
                        EXECUTED_COUNT,
                        INSERT_COUNT,
                        UPDATE_COUNT,
                        DELETE_COUNT,
                        OTHER_COUNT,
                        FAILED_STATEMENT_NUMBER,
                        FAILED_SQL,
                        EXCEPTION_TYPE,
                        EXCEPTION_MESSAGE,
                        EXECUTION_SPEED,
                        ELAPSED_SECONDS,
                        SQL_TEXT,
                        CREATED_AT
                    )
                    VALUES
                    (
                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
                        ?, ?, ?, ?, ?, ?, ?, SYSTIMESTAMP
                    )
                    """,
                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    executionType,
                    status,
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedStatementNumber,
                    failedSql,
                    exceptionType,
                    exceptionMessage,
                    executionSpeed,
                    elapsedSeconds,
                    sqlText
            );

        } catch (Exception e) {

            log.error(
                    "FAILED TO INSERT LOG",
                    e
            );
        }
    }

    /**
     * =================================================
     * EXECUTE SCRIPT ASYNC
     * =================================================
     */
    @Async("sqlTaskExecutor")
    public void executeScriptAsync(
            File sqlFile,
            String jobId,
            String userId,
            String clientIp
    ) {

        Instant start = Instant.now();

        long startedAt = System.currentTimeMillis();

        int totalStatements = 0;

        int executedCount = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int otherCount = 0;

        int failedLine = 0;

        String failedSql = null;

        try {

            log.info("""
                    
                    ==================================================
                    SQL SCRIPT EXECUTION STARTED
                    ==================================================
                    jobId={}
                    userId={}
                    clientIp={}
                    file={}
                    batchSize={}
                    ==================================================
                    """,
                    jobId,
                    userId,
                    clientIp,
                    sqlFile.getAbsolutePath(),
                    BATCH_SIZE
            );

            /**
             * =================================================
             * INITIAL STATUS
             * =================================================
             */
            Map<String, Object> initialStatus =
                    new ConcurrentHashMap<>();

            initialStatus.put("jobId", jobId);

            initialStatus.put("status", "RUNNING");

            initialStatus.put("progress", 0);

            initialStatus.put("executedCount", 0);

            initialStatus.put("insertCount", 0);

            initialStatus.put("updateCount", 0);

            initialStatus.put("deleteCount", 0);

            initialStatus.put("otherCount", 0);

            initialStatus.put("startedAt", startedAt);

            initialStatus.put("message", "Execution started");

            JOB_STATUS.put(
                    jobId,
                    initialStatus
            );

            /**
             * =================================================
             * COUNT STATEMENTS
             * =================================================
             */
            try (
                    BufferedReader counterReader =
                            new BufferedReader(
                                    new FileReader(sqlFile)
                            )
            ) {

                String line;

                while (
                        (line = counterReader.readLine()) != null
                ) {

                    line = line.trim();

                    if (
                            line.isEmpty()
                                    ||
                                    line.startsWith("--")
                    ) {

                        continue;
                    }

                    if (line.endsWith(";")) {

                        totalStatements++;
                    }
                }
            }

            /**
             * =================================================
             * EXECUTION
             * =================================================
             */
            try (
                    Connection connection =
                            jdbcTemplate
                                    .getDataSource()
                                    .getConnection();

                    BufferedReader reader =
                            new BufferedReader(
                                    new FileReader(sqlFile)
                            )
            ) {

                connection.setAutoCommit(false);

                Statement statement =
                        connection.createStatement();

                StringBuilder sqlBuilder =
                        new StringBuilder();

                String line;

                int lineNumber = 0;

                int batchCounter = 0;

                while (
                        (line = reader.readLine()) != null
                ) {

                    lineNumber++;

                    line = line.trim();

                    /**
                     * SKIP EMPTY/COMMENT
                     */
                    if (
                            line.isEmpty()
                                    ||
                                    line.startsWith("--")
                    ) {

                        continue;
                    }

                    sqlBuilder
                            .append(line)
                            .append(" ");

                    /**
                     * SQL END
                     */
                    if (line.endsWith(";")) {

                        String sql =
                                sqlBuilder.toString().trim();

                        while (sql.endsWith(";")) {

                            sql =
                                    sql.substring(
                                            0,
                                            sql.length() - 1
                                    ).trim();
                        }

                        sqlBuilder.setLength(0);

                        failedSql = sql;

                        failedLine = lineNumber;

                        String upperSql =
                                sql.toUpperCase();

                        boolean isDDL =
                                upperSql.startsWith("CREATE")
                                        ||
                                        upperSql.startsWith("ALTER")
                                        ||
                                        upperSql.startsWith("DROP")
                                        ||
                                        upperSql.startsWith("TRUNCATE");

                        /**
                         * =================================================
                         * DDL
                         * =================================================
                         */
                        if (isDDL) {

                            statement.execute(sql);

                            connection.commit();

                        } else {

                            /**
                             * =================================================
                             * BATCH DML
                             * =================================================
                             */
                            statement.addBatch(sql);

                            batchCounter++;

                            if (
                                    batchCounter >= BATCH_SIZE
                            ) {

                                long batchStart =
                                        System.currentTimeMillis();

                                statement.executeBatch();

                                connection.commit();

                                statement.clearBatch();

                                long batchEnd =
                                        System.currentTimeMillis();

                                batchCounter = 0;

                                log.info("""
                                        
                                        ==================================================
                                        BATCH EXECUTED
                                        ==================================================
                                        jobId={}
                                        executedCount={}
                                        batchSize={}
                                        batchExecutionTime={} ms
                                        ==================================================
                                        """,
                                        jobId,
                                        executedCount,
                                        BATCH_SIZE,
                                        (batchEnd - batchStart)
                                );
                            }
                        }

                        executedCount++;

                        /**
                         * =================================================
                         * QUERY TYPE COUNTS
                         * =================================================
                         */
                        if (
                                upperSql.startsWith("INSERT")
                        ) {

                            insertCount++;

                        } else if (
                                upperSql.startsWith("UPDATE")
                        ) {

                            updateCount++;

                        } else if (
                                upperSql.startsWith("DELETE")
                        ) {

                            deleteCount++;

                        } else {

                            otherCount++;
                        }

                        /**
                         * =================================================
                         * STATUS UPDATE
                         * =================================================
                         */
                        if (
                                executedCount
                                        %
                                        STATUS_UPDATE_INTERVAL
                                        ==
                                        0
                        ) {

                            long elapsedSeconds =
                                    Duration.between(
                                            start,
                                            Instant.now()
                                    ).toSeconds();

                            int progress =
                                    totalStatements == 0
                                            ? 0
                                            : Math.min(
                                                    99,
                                                    (
                                                            executedCount
                                                                    *
                                                                    100
                                                    )
                                                            /
                                                            totalStatements
                                            );

                            long avgPerStatement =
                                    executedCount == 0
                                            ? 0
                                            : Math.max(
                                                    1,
                                                    elapsedSeconds
                                                            /
                                                            executedCount
                                            );

                            long remainingStatements =
                                    totalStatements
                                            -
                                            executedCount;

                            long etaSeconds =
                                    avgPerStatement
                                            *
                                            remainingStatements;

                            long executionSpeed =
                                    elapsedSeconds == 0
                                            ? executedCount
                                            : executedCount
                                                    /
                                                    elapsedSeconds;

                            /**
                             * IMPORTANT
                             * CREATE NEW MAP
                             */
                            Map<String, Object> runningStatus =
                                    new ConcurrentHashMap<>();

                            runningStatus.put(
                                    "jobId",
                                    jobId
                            );

                            runningStatus.put(
                                    "status",
                                    "RUNNING"
                            );

                            runningStatus.put(
                                    "progress",
                                    progress
                            );

                            runningStatus.put(
                                    "executedCount",
                                    executedCount
                            );

                            runningStatus.put(
                                    "insertCount",
                                    insertCount
                            );

                            runningStatus.put(
                                    "updateCount",
                                    updateCount
                            );

                            runningStatus.put(
                                    "deleteCount",
                                    deleteCount
                            );

                            runningStatus.put(
                                    "otherCount",
                                    otherCount
                            );

                            runningStatus.put(
                                    "totalStatements",
                                    totalStatements
                            );

                            runningStatus.put(
                                    "elapsedSeconds",
                                    elapsedSeconds
                            );

                            runningStatus.put(
                                    "etaSeconds",
                                    etaSeconds
                            );

                            runningStatus.put(
                                    "executionSpeed",
                                    executionSpeed
                            );

                            runningStatus.put(
                                    "currentLine",
                                    lineNumber
                            );

                            runningStatus.put(
                                    "startedAt",
                                    startedAt
                            );

                            runningStatus.put(
                                    "message",
                                    "Execution running"
                            );

                            /**
                             * IMPORTANT
                             * REPLACE ENTIRE OBJECT
                             */
                            JOB_STATUS.put(
                                    jobId,
                                    runningStatus
                            );
                        }

                        /**
                         * =================================================
                         * PERIODIC LOGGING
                         * =================================================
                         */
                        if (
                                executedCount % LOG_INTERVAL == 0
                        ) {

                            log.info("""
                                    
                                    ==================================================
                                    LIVE EXECUTION STATUS
                                    ==================================================
                                    jobId={}
                                    progress={}%
                                    executed={}
                                    inserts={}
                                    updates={}
                                    deletes={}
                                    others={}
                                    currentLine={}
                                    ==================================================
                                    """,
                                    jobId,
                                    totalStatements == 0
                                            ? 0
                                            : (
                                                    executedCount
                                                            *
                                                            100
                                            )
                                                    /
                                                    totalStatements,
                                    executedCount,
                                    insertCount,
                                    updateCount,
                                    deleteCount,
                                    otherCount,
                                    lineNumber
                            );
                        }
                    }
                }

                /**
                 * =================================================
                 * FINAL BATCH EXECUTION
                 * =================================================
                 */
                if (batchCounter > 0) {

                    statement.executeBatch();

                    connection.commit();

                    statement.clearBatch();
                }

                long totalElapsedSeconds =
                        Duration.between(
                                start,
                                Instant.now()
                        ).toSeconds();

                long executionSpeed =
                        totalElapsedSeconds == 0
                                ? executedCount
                                : executedCount
                                        /
                                        totalElapsedSeconds;

                /**
                 * =================================================
                 * FINAL STATUS
                 * =================================================
                 */
                Map<String, Object> completedStatus =
                        new ConcurrentHashMap<>();

                completedStatus.put(
                        "jobId",
                        jobId
                );

                completedStatus.put(
                        "status",
                        "COMPLETED"
                );

                completedStatus.put(
                        "progress",
                        100
                );

                completedStatus.put(
                        "executedCount",
                        executedCount
                );

                completedStatus.put(
                        "insertCount",
                        insertCount
                );

                completedStatus.put(
                        "updateCount",
                        updateCount
                );

                completedStatus.put(
                        "deleteCount",
                        deleteCount
                );

                completedStatus.put(
                        "otherCount",
                        otherCount
                );

                completedStatus.put(
                        "totalStatements",
                        totalStatements
                );

                completedStatus.put(
                        "elapsedSeconds",
                        totalElapsedSeconds
                );

                completedStatus.put(
                        "etaSeconds",
                        0
                );

                completedStatus.put(
                        "executionSpeed",
                        executionSpeed
                );

                completedStatus.put(
                        "currentLine",
                        lineNumber
                );

                completedStatus.put(
                        "startedAt",
                        startedAt
                );

                completedStatus.put(
                        "completed",
                        true
                );

                completedStatus.put(
                        "message",
                        "Execution completed"
                );

                JOB_STATUS.put(
                        jobId,
                        completedStatus
                );

                /**
                 * =================================================
                 * INSERT SUCCESS LOG
                 * =================================================
                 */
                insertExecutionLog(
                        jobId,
                        userId,
                        clientIp,
                        sqlFile.getName(),
                        "FILE",
                        "SUCCESS",
                        totalStatements,
                        executedCount,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        null,
                        null,
                        null,
                        null,
                        executionSpeed,
                        totalElapsedSeconds,
                        null
                );

                log.info("""
                        
                        ==================================================
                        SQL SCRIPT EXECUTION COMPLETED
                        ==================================================
                        jobId={}
                        totalStatements={}
                        executed={}
                        inserts={}
                        updates={}
                        deletes={}
                        others={}
                        elapsed={} sec
                        executionSpeed={} stmt/sec
                        ==================================================
                        """,
                        jobId,
                        totalStatements,
                        executedCount,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        totalElapsedSeconds,
                        executionSpeed
                );
            }

        } catch (Exception e) {

            long elapsedSeconds =
                    Duration.between(
                            start,
                            Instant.now()
                    ).toSeconds();

            /**
             * =================================================
             * FAILED STATUS
             * =================================================
             */
            Map<String, Object> failedStatus =
                    new ConcurrentHashMap<>();

            failedStatus.put(
                    "jobId",
                    jobId
            );

            failedStatus.put(
                    "status",
                    "FAILED"
            );

            failedStatus.put(
                    "message",
                    e.getMessage()
            );

            failedStatus.put(
                    "failedLine",
                    failedLine
            );

            failedStatus.put(
                    "failedSql",
                    failedSql
            );

            failedStatus.put(
                    "executedCount",
                    executedCount
            );

            failedStatus.put(
                    "insertCount",
                    insertCount
            );

            failedStatus.put(
                    "updateCount",
                    updateCount
            );

            failedStatus.put(
                    "deleteCount",
                    deleteCount
            );

            failedStatus.put(
                    "otherCount",
                    otherCount
            );

            failedStatus.put(
                    "totalStatements",
                    totalStatements
            );

            failedStatus.put(
                    "elapsedSeconds",
                    elapsedSeconds
            );

            failedStatus.put(
                    "progress",
                    100
            );

            JOB_STATUS.put(
                    jobId,
                    failedStatus
            );

            /**
             * =================================================
             * INSERT FAILURE LOG
             * =================================================
             */
            insertExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    sqlFile.getName(),
                    "FILE",
                    "FAILED",
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedLine,
                    failedSql,
                    e.getClass().getSimpleName(),
                    e.getMessage(),
                    0,
                    elapsedSeconds,
                    null
            );

            log.error("""
                    
                    ==================================================
                    SQL EXECUTION FAILED
                    ==================================================
                    jobId={}
                    failedLine={}
                    failedSql={}
                    executedCount={}
                    elapsed={} sec
                    exception={}
                    ==================================================
                    """,
                    jobId,
                    failedLine,
                    failedSql,
                    executedCount,
                    elapsedSeconds,
                    e.getMessage(),
                    e
            );

        } finally {

            /**
             * =================================================
             * DELETE TEMP FILE
             * =================================================
             */
            try {

                if (
                        sqlFile != null
                                &&
                                sqlFile.exists()
                ) {

                    boolean deleted =
                            sqlFile.delete();

                    log.info("""
                            
                            ==================================================
                            TEMP FILE CLEANUP
                            ==================================================
                            file={}
                            deleted={}
                            ==================================================
                            """,
                            sqlFile.getAbsolutePath(),
                            deleted
                    );
                }

            } catch (Exception ex) {

                log.error(
                        "FAILED TO DELETE TEMP FILE",
                        ex
                );
            }
        }
    }
}