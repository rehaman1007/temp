import React, { useEffect, useMemo, useState } from "react";
import { Backdrop, Typography, Fade, Box } from "@mui/material";
import LogoImg from "../assets/Logos/Fincore_transperent.svg";

const ComponentLoadingOverlay = ({ loading, messages }) => {
  const defaultMessages = [
    "FinCore processing data...",
    "Just a moment...",
  ];

  const loadingMessages = useMemo(() => {
    return Array.isArray(messages) && messages.length > 0
      ? messages
      : defaultMessages;
  }, [messages]);

  const [messageIndex, setMessageIndex] = useState(0);

  useEffect(() => {
    let interval;
    if (loading && loadingMessages.length > 1) {
      interval = setInterval(() => {
        setMessageIndex((prev) => (prev + 1) % loadingMessages.length);
      }, 2500);
    }
    return () => {
      clearInterval(interval);
      if (!loading) setMessageIndex(0);
    };
  }, [loading, loadingMessages]);

  return (
    <Backdrop
      open={loading}
      sx={{
        position: "absolute", 
        inset: 0,
        zIndex: 10, 
        flexDirection: "column",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        background: "linear-gradient(to bottom right, rgba(15, 15, 25, 0.75), rgba(5, 5, 10, 0.85))",
        backdropFilter: "blur(6px)", 
        transition: "all 0.3s ease-in-out",
      }}
    >
      <Box sx={{ position: "relative", display: "flex", justifyContent: "center", alignItems: "center", mb: 3 }}>
        <Box
          sx={{
            position: "absolute",
            width: 70,
            height: 70,
            borderRadius: "50%",
            border: "2px solid rgba(25, 118, 210, 0.4)",
            animation: "radar 2s infinite cubic-bezier(0.25, 0, 0, 1)",
            "@keyframes radar": {
              "0%": { transform: "scale(0.6)", opacity: 1 },
              "100%": { transform: "scale(1.4)", opacity: 0 }
            }
          }}
        />
        <Box
          component="img"
          src={LogoImg}
          alt="Loading Content"
          sx={{
            width: 45, 
            height: 45,
            objectFit: "contain",
            zIndex: 1,
            animation: "shimmerBreathing 2.5s infinite ease-in-out",
            "@keyframes shimmerBreathing": {
              "0%, 100%": { 
                transform: "scale(0.95)",
                filter: "drop-shadow(0 0 6px rgba(25, 118, 210, 0.3))" 
              },
              "50%": { 
                transform: "scale(1.05)", 
                filter: "drop-shadow(0 0 15px rgba(25, 118, 210, 0.6))" 
              }
            }
          }}
        />
      </Box>

      <Box sx={{ minHeight: "30px", display: "flex", justifyContent: "center", alignItems: "center" }}>
        <Fade in={loading} key={messageIndex} timeout={400}>
          <Typography
            variant="body2"
            sx={{
              userSelect: "none",
              fontWeight: 500,
              color: "rgba(255, 255, 255, 0.9)",
              textAlign: "center",
              px: 2,
            }}
          >
            {loadingMessages[messageIndex]}
          </Typography>
        </Fade>
      </Box>
    </Backdrop>
  );
};

export default ComponentLoadingOverlay;
