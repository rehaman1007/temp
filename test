            )}
          </Grid>

          {/* Action Buttons */}
          <Box
            sx={{
              mt: 2,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={handleLocalReset}
              sx={{ borderRadius: 2, textTransform: "none", fontWeight: 700 }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.cgl ||
                !filters.fromDate ||
                !filters.toDate ||
                fromDateError ||
                toDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: 4,
                textTransform: "none",
                fontWeight: 800,
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

