import React, {
  createContext,
  useContext,
  useState,
  useEffect,
  useCallback,
  useRef,
} from "react";
import axios from "axios";
import useStreamApi from "../hooks/useStreamApi";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const NotificationContext = createContext();
const BASE_URL = "/NS/notifications";
const PAGE_SIZE = 10;

export const NotificationProvider = ({ children }) => {
  const { showSnackbar } = useCustomSnackbar();
  const { startStream, stopStream, lastMessage, connected } = useStreamApi();

  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [pageNumber, setPageNumber] = useState(0);
  const [hasMore, setHasMore] = useState(true);
  const [popupNotification, setPopupNotification] = useState(null);
  const popupTimer = useRef(null);

  // Axios instance
  const api = axios.create({
    baseURL: BASE_URL,
    headers: {
      "Content-Type": "application/json",
    },
  });

  // ✅ Helper: format relative timestamps
  const formatRelativeTime = (timestamp) => {
    if (!timestamp) return "";
    const diff = Math.floor((Date.now() - new Date(timestamp)) / 1000);
    if (diff < 5) return "just now";
    if (diff < 60) return `${diff} sec ago`;
    if (diff < 3600) return `${Math.floor(diff / 60)} min ago`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} hr ago`;
    if (diff < 604800) return `${Math.floor(diff / 86400)} day ago`;
    if (diff < 2419200) return `${Math.floor(diff / 604800)} week ago`;
    return new Date(timestamp).toLocaleDateString();
  };

  // ✅ Fetch unread count
  const fetchUnreadCount = useCallback(async () => {
    try {
      const { data } = await api.get(`/unread-count`);
      if (data?.count !== undefined) setUnreadCount(data.count);
    } catch (err) {
      console.error("Failed to fetch unread count:", err);
    }
  }, []);

  // ✅ Fetch paginated notifications
  const fetchHistory = useCallback(
    async (page = 0) => {
      try {
        const { data } = await api.get(`?page=${page}&size=${PAGE_SIZE}`);
        const newItems = data?.content || [];

        setNotifications((prev) => {
          const existingIds = new Set(prev.map((n) => n.id));
          const filtered = newItems.filter((n) => !existingIds.has(n.id));
          return [...prev, ...filtered].sort(
            (a, b) => new Date(b.timestamp) - new Date(a.timestamp)
          );
        });

        setHasMore(!data?.last);
        setPageNumber(page);
      } catch (err) {
        console.error("Failed to fetch notifications:", err);
        showSnackbar("Failed to load notifications", "error");
      }
    },
    [showSnackbar]
  );

  // ✅ Mark a notification as read
  const markAsRead = useCallback(
    async (id) => {
      try {
        await api.post(`/${id}/read`);
        setNotifications((prev) =>
          prev.map((n) => (n.id === id ? { ...n, isRead: true } : n))
        );
        setUnreadCount((prev) => Math.max(prev - 1, 0));
      } catch (err) {
        console.error("Mark as read failed:", err);
        showSnackbar("Failed to mark as read", "error");
      }
    },
    [showSnackbar]
  );

  // ✅ Mark all notifications as read
  const markAllAsRead = useCallback(async () => {
    try {
      await api.post(`/mark-all-read`);
      setNotifications((prev) => prev.map((n) => ({ ...n, isRead: true })));
      setUnreadCount(0);
      showSnackbar("All notifications marked as read", "success");
    } catch (err) {
      console.error("Failed to mark all as read:", err);
      showSnackbar("Failed to mark all notifications as read", "error");
    }
  }, [showSnackbar]);

  // ✅ Load next page
  const loadMore = useCallback(() => {
    if (hasMore) fetchHistory(pageNumber + 1);
  }, [hasMore, fetchHistory, pageNumber]);

  // ✅ Popup for 2 seconds when new notification arrives
  const showPopup = (notification) => {
    setPopupNotification(notification);
    if (popupTimer.current) clearTimeout(popupTimer.current);
    popupTimer.current = setTimeout(() => setPopupNotification(null), 2500);
  };

  // ✅ Initial fetch + SSE setup
  useEffect(() => {
    fetchUnreadCount();
    fetchHistory(0);

    startStream(`${BASE_URL}/stream`, {
      onMessage: (newNotification) => {
        setNotifications((prev) => [newNotification, ...prev]);
        setUnreadCount((prev) => prev + 1);
        showPopup(newNotification);
      },
    });

    return () => {
      stopStream();
      if (popupTimer.current) clearTimeout(popupTimer.current);
    };
  }, [fetchUnreadCount, fetchHistory, startStream, stopStream]);

  // ✅ Handle new messages via stream
  useEffect(() => {
    if (lastMessage) {
      setNotifications((prev) => [lastMessage, ...prev]);
      setUnreadCount((prev) => prev + 1);
      showPopup(lastMessage);
    }
  }, [lastMessage]);

  // ✅ Context Value
  const value = {
    connected,
    notifications,
    unreadCount,
    hasMore,
    loadMore,
    markAsRead,
    markAllAsRead,
    fetchUnreadCount,
    fetchHistory,
    popupNotification,
    formatRelativeTime,
  };

  return (
    <NotificationContext.Provider value={value}>
      {children}
    </NotificationContext.Provider>
  );
};

// ✅ Custom hook
export const useNotificationContext = () => {
  const context = useContext(NotificationContext);
  if (!context)
    throw new Error(
      "useNotificationContext must be used within a NotificationProvider"
    );
  return context;
};