import React, {
  useState,
  useMemo,
  useEffect,
} from "react";

import {
  Box,
  Paper,
  TextField,
  Button,
  Typography,
  Divider,
  IconButton,
  Tooltip,
  Stack,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Chip,
  LinearProgress,
  useTheme,
  alpha,
  Alert,
  AlertTitle,
  Tab,
  Tabs,
} from "@mui/material";

import {
  PlayArrow,
  CleaningServices,
  ContentCopy,
  AssessmentOutlined,
  CheckCircleOutline,
  ErrorOutline,
  ListAlt,
  TableChart,
  UploadFile,
} from "@mui/icons-material";

import {
  DataGrid,
  GridToolbar,
} from "@mui/x-data-grid";

import {
  useMutation,
} from "@tanstack/react-query";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const AdminSupport = () => {

  const theme = useTheme();

  const showSnackbar =
    useCustomSnackbar();

  const { callApi } = useApi();

  /**
   * SQL editor state
   */
  const [query, setQuery] =
    useState(
      "SELECT * FROM USERS"
    );

  /**
   * Grid state
   */
  const [results, setResults] =
    useState({
      rows: [],
      columns: [],
      total: 0,
    });

  /**
   * Pagination
   */
  const [
    paginationModel,
    setPaginationModel,
  ] = useState({
    page: 0,
    pageSize: 5,
  });

  /**
   * Confirm dialog
   */
  const [
    confirmOpen,
    setConfirmOpen,
  ] = useState(false);

  /**
   * Logs
   */
  const [
    lastResponse,
    setLastResponse,
  ] = useState(null);

  /**
   * Tabs
   */
  const [activeTab, setActiveTab] =
    useState(0);

  /**
   * Upload job tracking
   */
  const [jobId, setJobId] =
    useState(null);

  const [
    jobStatus,
    setJobStatus,
  ] = useState(null);

  /**
   * Select query checker
   */
  const isSelect = useMemo(() => {

    const q =
      query.trim().toUpperCase();

    return (
      q.startsWith("SELECT") ||
      q.startsWith("WITH")
    );

  }, [query]);

  /**
   * Destructive query checker
   */
  const isDestructive =
    useMemo(() => {

      const q =
        query.trim().toUpperCase();

      return [
        "UPDATE",
        "DELETE",
        "DROP",
        "TRUNCATE",
        "ALTER",
      ].some((k) =>
        q.startsWith(k)
      );

    }, [query]);

  /**
   * Execute command panel query
   */
  const {
    mutate: executeSql,
    isPending,
  } = useMutation({

    mutationFn: async ({
      sql,
      page,
      size,
    }) => {

      return await callApi(
        "/api/admin-support/admin-execute",
        {
          sql,
          page,
          size,
        },
        "POST"
      );
    },

    onSuccess: (data) => {

      setLastResponse(data);

      if (data?.error) {

        setResults({
          rows: [],
          columns: [],
          total: 0,
        });

        setActiveTab(1);

        return;
      }

      /**
       * SELECT results
       */
      if (isSelect) {

        const formattedCols =
          (
            data?.columns || []
          ).map((col) => ({
            field: col.name,
            headerName: col.name,
            flex: 1,
            minWidth: 150,
          }));

        setResults({
          rows:
            data?.rows || [],
          columns:
            formattedCols,
          total:
            data?.total || 0,
        });

        setActiveTab(0);

      } else {

        /**
         * DML logs
         */
        setResults({
          rows: [],
          columns: [],
          total: 0,
        });

        setActiveTab(1);
      }
    },

    onError: (err) => {

      setLastResponse({
        error: true,
        message:
          err?.message ||
          "Internal Server Error",
      });

      setActiveTab(1);
    },
  });

  /**
   * Execute command panel
   */
  const handleRun = (
    resetPage = false
  ) => {

    const trimmedQuery =
      query.trim();

    if (!trimmedQuery) {

      showSnackbar(
        "Please enter query",
        "warning"
      );

      return;
    }

    setLastResponse(null);

    const targetPage =
      resetPage
        ? 0
        : paginationModel.page;

    if (resetPage) {

      setPaginationModel(
        (p) => ({
          ...p,
          page: 0,
        })
      );
    }

    executeSql({
      sql: query,
      page: targetPage,
      size:
        paginationModel.pageSize,
    });
  };

  /**
   * Server pagination
   */
  useEffect(() => {

    if (
      results.columns.length >
        0 &&
      isSelect
    ) {

      handleRun();
    }

  }, [
    paginationModel.page,
    paginationModel.pageSize,
  ]);

  /**
   * Upload huge SQL file
   */
  const handleFileUpload =
    async (e) => {

      try {

        const file =
          e.target.files[0];

        if (!file) return;

        if (
          !file.name.endsWith(
            ".sql"
          )
        ) {

          showSnackbar(
            "Only .sql files allowed",
            "error"
          );

          return;
        }

        const formData =
          new FormData();

        formData.append(
          "file",
          file
        );

        const response =
          await fetch(
            "/api/admin-support/upload-script",
            {
              method: "POST",
              body: formData,
            }
          );

        const data =
          await response.json();

        if (data.error) {

          showSnackbar(
            data.message,
            "error"
          );

          return;
        }

        setJobId(data.jobId);

        showSnackbar(
          "SQL upload started",
          "success"
        );

        setActiveTab(1);

      } catch (e) {

        showSnackbar(
          "Upload failed",
          "error"
        );
      }
    };

  /**
   * Poll execution status
   */
  useEffect(() => {

    if (!jobId) return;

    const interval =
      setInterval(
        async () => {

          try {

            const res =
              await fetch(
                `/api/admin-support/job-status/${jobId}`
              );

            const data =
              await res.json();

            setJobStatus(data);

            if (
              data.status ===
                "COMPLETED" ||
              data.status ===
                "FAILED"
            ) {

              clearInterval(
                interval
              );
            }

          } catch (e) {

            console.error(e);
          }
        },
        2000
      );

    return () =>
      clearInterval(interval);

  }, [jobId]);

  /**
   * Keyboard shortcuts
   */
  const handleKeyDown = (
    e
  ) => {

    /**
     * CTRL + ENTER
     */
    if (
      e.ctrlKey &&
      e.key === "Enter"
    ) {

      e.preventDefault();

      handleRun(true);
    }
  };

  return (

    <Box
      sx={{
        display: "flex",
        flexDirection:
          "column",
        height: "100%",
        overflow: "hidden",
        p: 1,
      }}
    >

      {/* HEADER */}
      <Paper
        elevation={0}
        sx={{
          px: 3,
          py: 1,
          borderRadius: 1,
          display: "flex",
          alignItems:
            "center",
          justifyContent:
            "space-between",
        }}
      >

        <Stack
          direction="row"
          spacing={2}
          alignItems="center"
        >

          <AssessmentOutlined
            color="primary"
          />

          <Box>

            <Typography
              variant="subtitle2"
              fontWeight={800}
            >
              FINCORE ADMIN SUPPORT
            </Typography>

            <Typography
              variant="caption"
              color="text.secondary"
            >
              Connected and ready
            </Typography>

          </Box>

        </Stack>

        {/* ACTIONS */}
        <Stack
          direction="row"
          spacing={1}
        >

          {/* FILE UPLOAD */}
          <Button
            component="label"
            variant="outlined"
            startIcon={
              <UploadFile />
            }
          >
            Upload SQL

            <input
              hidden
              type="file"
              accept=".sql"
              onChange={
                handleFileUpload
              }
            />
          </Button>

          {/* CLEAR */}
          <Tooltip title="Clear">
            <IconButton
              onClick={() =>
                setQuery("")
              }
            >
              <CleaningServices />
            </IconButton>
          </Tooltip>

          {/* COPY */}
          <Tooltip title="Copy">
            <IconButton
              onClick={() =>
                navigator.clipboard.writeText(
                  query
                )
              }
            >
              <ContentCopy />
            </IconButton>
          </Tooltip>

          {/* EXECUTE */}
          <Button
            variant="contained"
            disableElevation
            color={
              isDestructive
                ? "error"
                : "primary"
            }
            startIcon={
              <PlayArrow />
            }
            disabled={
              isPending
            }
            onClick={() =>
              isDestructive
                ? setConfirmOpen(
                    true
                  )
                : handleRun(
                    true
                  )
            }
          >
            Execute
          </Button>

        </Stack>
      </Paper>

      {/* SQL EDITOR */}
      <Box
        sx={{
          mt: 2,
          border:
            "1px solid #2d2d2d",
          borderRadius: 1,
          overflow: "hidden",
          bgcolor: "#1e1e1e",
        }}
      >

        {/* TERMINAL HEADER */}
        <Box
          sx={{
            px: 2,
            py: 1,
            bgcolor: "#2d2d2d",
            borderBottom:
              "1px solid #444",
            display: "flex",
            justifyContent:
              "space-between",
            alignItems:
              "center",
          }}
        >

          <Typography
            variant="caption"
            sx={{
              color: "#aaa",
              fontFamily:
                "monospace",
            }}
          >
            SQL Worksheet
          </Typography>

          <Chip
            label="CTRL + ENTER"
            size="small"
          />

        </Box>

        {/* SQL TEXT AREA */}
        <TextField
          multiline
          minRows={10}
          maxRows={20}
          fullWidth
          value={query}
          onChange={(e) =>
            setQuery(
              e.target.value
            )
          }
          onKeyDown={
            handleKeyDown
          }
          variant="standard"
          InputProps={{
            disableUnderline: true,
            sx: {
              p: 2,
              color: "#d4d4d4",
              fontFamily:
                "'Fira Code', monospace",
              fontSize: 14,
            },
          }}
          sx={{
            "& textarea": {
              overflow:
                "auto !important",
            },
          }}
        />

      </Box>

      {/* LOADER */}
      {isPending && (
        <LinearProgress
          sx={{ mt: 1 }}
        />
      )}

      {/* FILE EXECUTION STATUS */}
      {jobStatus && (

        <Paper
          sx={{
            mt: 1,
            p: 2,
          }}
        >

          <Typography
            fontWeight={700}
          >
            Uploaded Script Status
          </Typography>

          <Typography
            variant="body2"
          >
            Status:
            {" "}
            {
              jobStatus.status
            }
          </Typography>

          <Typography
            variant="body2"
          >
            Executed Statements:
            {" "}
            {
              jobStatus.executedCount ||
              0
            }
          </Typography>

          <LinearProgress
            sx={{ mt: 1 }}
          />

        </Paper>
      )}

      {/* OUTPUT */}
      <Box
        sx={{
          flex: 1,
          mt: 1,
          overflow: "hidden",
          bgcolor:
            theme.palette
              .background.paper,
        }}
      >

        {/* TABS */}
        <Tabs
          value={activeTab}
          onChange={(
            e,
            v
          ) =>
            setActiveTab(v)
          }
        >

          <Tab
            icon={
              <TableChart />
            }
            label="Data Grid"
          />

          <Tab
            icon={<ListAlt />}
            label="Messages"
          />

        </Tabs>

        {/* GRID */}
        {activeTab === 0 && (

          <DataGrid
            rows={results.rows}
            columns={
              results.columns
            }
            rowCount={
              results.total
            }
            loading={isPending}
            paginationMode="server"
            paginationModel={
              paginationModel
            }
            onPaginationModelChange={
              setPaginationModel
            }
            disableRowSelectionOnClick
            pageSizeOptions={[
              5,
              10,
              25,
              50,
            ]}
            slots={{
              toolbar:
                GridToolbar,
            }}
            getRowId={(
              row
            ) =>
              row.ID ||
              row.id ||
              Math.random()
            }
            sx={{
              height: 500,
              border: "none",
              "& .MuiDataGrid-columnHeaders":
                {
                  bgcolor:
                    alpha(
                      theme
                        .palette
                        .action
                        .hover,
                      0.4
                    ),
                },
            }}
          />

        )}

        {/* LOGS */}
        {activeTab === 1 && (

          <Box
            sx={{ p: 2 }}
          >

            {!lastResponse &&
              !jobStatus && (

                <Typography
                  color="text.secondary"
                >
                  Waiting for execution...
                </Typography>

              )}

            {lastResponse
              ?.error && (

              <Alert severity="error">

                <AlertTitle>
                  Error
                </AlertTitle>

                {
                  lastResponse.message
                }

              </Alert>

            )}

            {lastResponse &&
              !lastResponse
                ?.error && (

                <Alert severity="success">

                  <AlertTitle>
                    Execution Log
                  </AlertTitle>

                  {lastResponse
                    ?.rows?.[0]
                    ?.RESULT ||
                    "Completed successfully"}

                </Alert>

              )}

            {jobStatus
              ?.status ===
              "FAILED" && (

              <Alert
                severity="error"
                sx={{ mt: 2 }}
              >

                <AlertTitle>
                  Upload Failed
                </AlertTitle>

                {
                  jobStatus.message
                }

              </Alert>

            )}

            {jobStatus
              ?.status ===
              "COMPLETED" && (

              <Alert
                severity="success"
                sx={{ mt: 2 }}
              >

                <AlertTitle>
                  Upload Completed
                </AlertTitle>

                Total Executed:
                {" "}
                {
                  jobStatus.executedCount
                }

              </Alert>

            )}

          </Box>

        )}

      </Box>

      {/* CONFIRM DIALOG */}
      <Dialog
        open={confirmOpen}
        onClose={() =>
          setConfirmOpen(
            false
          )
        }
      >

        <DialogTitle>
          Confirm Execution
        </DialogTitle>

        <DialogContent>

          <Typography>
            Are you sure you
            want to execute
            this destructive
            query?
          </Typography>

        </DialogContent>

        <DialogActions>

          <Button
            onClick={() =>
              setConfirmOpen(
                false
              )
            }
          >
            Cancel
          </Button>

          <Button
            variant="contained"
            color="error"
            onClick={() => {

              setConfirmOpen(
                false
              );

              handleRun(true);
            }}
          >
            Execute
          </Button>

        </DialogActions>

      </Dialog>

    </Box>
  );
};

export default AdminSupport;