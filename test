import { useCallback, useEffect, useMemo, useState } from "react";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import { Box, Fab, Paper } from "@mui/material";
import RolesTable from "../components/RolesTable";
import RolesDialog from "../components/RolesDialog";
import AddIcon from "@mui/icons-material/Add";

export default function RoleManagement() {
  const { callApi, loading, error: apiError } = useApi();
  const snackbar = useCustomSnackbar();

  const emptyForm = {
    roleId: "",
    roleName: "",
    description: "",
    status: "",
  };

  const [rows, setRows] = useState([]);
  const [uiError, setUiError] = useState("");

  const [form, setForm] = useState(emptyForm);

  const [dialogOpen, setDialogOpen] = useState(false);

  const fetchRoles = useCallback(async () => {
    setUiError("");
    try {
      const data = await callApi("/UM/role/get-roles", {}, "GET");
      const roles = data?.result?.roles ?? [];
      console.log("roles :: ", roles);
      setRows(roles);
    } catch (e) {
      console.error(e);
      setRows([]);
      setUiError(
        "Failed to fetch roles. Check network, CORS, or API availability."
      );
    }
  }, [callApi]);

  useEffect(() => {
    fetchRoles();
  }, [fetchRoles]);

  const effectiveError =
    apiError?.response?.data?.message || apiError?.message || uiError || "";

  if (effectiveError !== "") {
    snackbar(
      apiError?.response?.data?.message || apiError?.message || uiError,
      "error"
    );
  }

  const canSave =
    (form.roleName || "").trim() && (form.description || "").trim();

  return (
    <>
      <Box sx={{ p: { xs: 2, md: 3 } }}>
        <Paper variant="outlined" sx={{ mt: 2 }}>
          {/* Grid */}
          <RolesTable
            rows={rows}
            loading={loading}
            onEditRow={(row) => {
              console.log(row);
              setForm({
                ...row,
              });
              setDialogOpen(true);
            }}
            errorText={effectiveError}
          />
        </Paper>
        <RolesDialog
          open={dialogOpen}
          onClose={() => setDialogOpen(false)}
          form={form}
          setForm={setForm}
          canSave={canSave}
          fetchRoles={fetchRoles}
        />
        <Fab
          onClick={(row) => {
            setForm({
              ...row,
            });
            setDialogOpen(true);
          }}
          color="primary"
          variant="extended"
          sx={{
            position: "fixed",
            borderRadius: 1,
            fontSize: "15px",
            bottom: (theme) => theme.spacing(8),
            right: (theme) => theme.spacing(4),
          }}
        >
          <AddIcon sx={{ mr: 1 }} />
          Create Role
        </Fab>
      </Box>
    </>
  );
}

import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  Checkbox,
  Chip,
  Autocomplete,
  Divider,
} from "@mui/material";
import { useState } from "react";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import { validations } from "../../../utils/Validations";

export default function RolesDialog({ open, onClose, form, setForm, canSave }) {
  const [selectedPermissions, setSelectedPermissions] = useState([]);

  // Dummy permissions
  const allPermissions = Array.from({ length: 50 }).map((_, i) => ({
    id: i + 1,
    title: `Permission ${i + 1}`,
  }));

  const handleChange = (data, key, e, type) => {
    const result = validations(type, e.target.value);
    if (result === "") setForm({ ...data, [key]: e.target.value });
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>{form.roleId ? "Edit Role" : "Add New Role"}</DialogTitle>

      {form.roleId && (
        <IconButton
          aria-label="role status"
          sx={{ position: "absolute", right: 10, top: 8, color: "grey.500" }}
          onClick={() => {}}
        >
          {form.status === "ACTIVE" ? (
            <LockOutlineIcon color="error" />
          ) : (
            <LockOpenIcon color="success" />
          )}
          <Typography variant="caption">
            {form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK"}
          </Typography>
        </IconButton>
      )}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {/* First row: Role Name + Description */}
          <Grid container spacing={2} alignItems="center">
            <Grid item xs={12} md={4}>
              <TextField
                key="roleName"
                label="Role Name *"
                value={form.roleName || ""}
                onChange={(e) =>
                  handleChange(form, "roleName", e, "inputValue")
                }
                fullWidth
                size="medium"
              />
            </Grid>
            <Grid item xs={12} md={8}>
              <TextField
                key="description"
                label="Description *"
                value={form.description || ""}
                onChange={(e) =>
                  handleChange(form, "description", e, "certainSpecialChars")
                }
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          <Divider sx={{ my: 1 }} />

          {/* Second row: Autocomplete */}
          <Grid>
            <Grid item xs={12}>
              <Autocomplete
                multiple
                key="permissions"
                options={allPermissions}
                disableCloseOnSelect
                getOptionLabel={(option) => option.title}
                value={selectedPermissions}
                onChange={(e, newValue) => setSelectedPermissions(newValue)}
                isOptionEqualToValue={(option, value) => option.id === value.id}
                renderOption={(props, option, { selected }) => (
                  <li {...props} key={option.id}>
                    <Checkbox checked={selected} sx={{ mr: 1 }} />
                    {option.title}
                  </li>
                )}
                renderInput={(params) => (
                  <TextField {...params} label="Role Permissions" fullWidth />
                )}
                renderTags={() => null} // Don't render inside input
              />
            </Grid>
          </Grid>

          {/* Third row: Chips */}
          <Stack
            direction="row"
            spacing={1}
            rowGap={1.5}
            sx={{ mt: 1, flexWrap: "wrap" }}
          >
            {selectedPermissions.map((p) => (
              <Chip
                sx={{ mt: 10 }}
                key={p.id}
                label={p.title}
                size="small"
                onDelete={() =>
                  setSelectedPermissions(
                    selectedPermissions.filter((perm) => perm.id !== p.id)
                  )
                }
              />
            ))}
          </Stack>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" disabled={!canSave} onClick={() => {}}>
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}


