import React, { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Typography,
  Box,
  Grid,
  Paper,
  Tabs,
  Tab,
  CircularProgress,
} from "@mui/material";
import {
  Close,
  DescriptionRounded,
  PictureAsPdfRounded,
  TableChartRounded,
  InsertDriveFileRounded,
  DownloadRounded,
  ArticleRounded,
  VisibilityRounded,
} from "@mui/icons-material";

const getFormatIcon = (format) => {
  switch (format?.toLowerCase()) {
    case "pdf":
      return <PictureAsPdfRounded fontSize="large" color="error" />;
    case "excel":
    case "xlsx":
      return <TableChartRounded fontSize="large" color="success" />;
    case "csv":
    case "test":
    case "text":
      return <ArticleRounded fontSize="large" color="info" />;
    default:
      return <InsertDriveFileRounded fontSize="large" color="action" />;
  }
};

const AdhocReportsDownloadDialog = ({
  selectedReport,
  setSelectedReport,
  isAvailableToDownload,
  handleDownload, // Can be repurposed or split into fetchPreview / download
  callApi,        // Passed down to fetch the ArrayBuffer for viewing
  showSnackBar,
  etlDate,
}) => {
  const [selectedFormat, setSelectedFormat] = useState(null);
  const [activeTab, setActiveTab] = useState(0); // 0: Options, 1: View Preview
  const [previewUrl, setPreviewUrl] = useState(null);
  const [previewLoading, setPreviewLoading] = useState(false);

  useEffect(() => {
    if (selectedReport) {
      setSelectedFormat(null);
      setActiveTab(0);
      setPreviewUrl(null);
    }
    // Cleanup Object URLs to avoid memory leaks
    return () => {
      if (previewUrl) window.URL.revokeObjectURL(previewUrl);
    };
  }, [selectedReport]);

  const formatOptions = [
    { id: "pdf", label: "PDF Document", ext: ".pdf", mime: "application/pdf" },
    { id: "excel", label: "Excel Spreadsheet", ext: ".xlsx", mime: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
    { id: "test", label: "Text Data", ext: ".txt", mime: "text/plain" },
  ];

  // Function to fetch ArrayBuffer and generate an Object URL for viewing
  const handleViewPreview = async (formatId) => {
    setSelectedFormat(formatId);
    setActiveTab(1); // Switch to View Tab
    setPreviewLoading(true);

    try {
      const payload = {
        reportId: selectedReport.fileName || "nwsa_report",
        variantCode: "DATE_WISE",
        params: { balanceDate: "2026-03-30" },
      };

      const REPORT_DOWNLOAD_BASE_URL = "/RB/report-builder/view";
      let endpoint = formatId === "excel" ? `${REPORT_DOWNLOAD_BASE_URL}/xlsx` : formatId === "test" ? `${REPORT_DOWNLOAD_BASE_URL}/txt` : `${REPORT_DOWNLOAD_BASE_URL}/pdf`;

      // Call API expecting ArrayBuffer
      const response = await callApi(endpoint, payload, "POST", "arraybuffer");
      const blobData = response?.data || response;
      
      const matchedFormat = formatOptions.find(f => f.id === formatId);
      const blob = new Blob([blobData], { type: matchedFormat?.mime || "application/octet-stream" });
      
      if (previewUrl) window.URL.revokeObjectURL(previewUrl);
      const url = window.URL.createObjectURL(blob);
      setPreviewUrl(url);
    } catch (error) {
      console.error("Preview Error:", error);
      showSnackBar("Failed to load document preview.", "error");
      setActiveTab(0); // Fallback to options tab
    } finally {
      setPreviewLoading(false);
    }
  };

  return (
    <AnimatePresence>
      {selectedReport && (
        <Dialog
          open={Boolean(selectedReport)}
          onClose={() => setSelectedReport(null)}
          maxWidth="md"
          fullWidth
          PaperProps={{
            component: motion.div,
            initial: { opacity: 0, scale: 0.95, y: 10 },
            animate: { opacity: 1, scale: 1, y: 0 },
            exit: { opacity: 0, scale: 0.95, y: 10 },
            transition: { duration: 0.2 },
            sx: {
              borderRadius: 3,
              overflow: "hidden",
              boxShadow: "0 20px 60px rgba(0,0,0,0.15)",
              height: activeTab === 1 ? "80vh" : "auto",
            },
          }}
        >
          {/* Header */}
          <Box sx={{ p: 2.5, pb: 1, display: "flex", justifyContent: "space-between", alignItems: "flex-start", bgcolor: "background.paper" }}>
            <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
              <Box sx={{ p: 1.5, borderRadius: 2, bgcolor: "primary.50", color: "primary.main", display: "flex" }}>
                <DescriptionRounded fontSize="large" />
              </Box>
              <Box>
                <Typography variant="h6" fontWeight="700" lineHeight={1.2}>
                  {selectedReport.reportName}
                </Typography>
                <Typography variant="body2" color="text.secondary" noWrap>
                  {selectedReport?.reportDescription || "Adhoc Report Details"}
                </Typography>
              </Box>
            </Box>
            <IconButton onClick={() => setSelectedReport(null)} size="small" sx={{ color: "text.secondary" }}>
              <Close />
            </IconButton>
          </Box>

          {/* Navigation Tabs (Export Options vs View Preview) */}
          <Tabs 
            value={activeTab} 
            onChange={(e, val) => setActiveTab(val)} 
            sx={{ px: 3, borderBottom: 1, borderColor: "divider" }}
          >
            <Tab label="Export Options" />
            <Tab label="Live View Preview" disabled={!selectedFormat} />
          </Tabs>

          <DialogContent sx={{ pt: 3, pb: 3, height: "100%", display: "flex", flexDirection: "column" }}>
            {activeTab === 0 ? (
              <>
                <Typography variant="body1" mb={3} color="text.secondary">
                  Choose a file format to generate fresh data. You can choose to download directly or view the preview first.
                </Typography>

                <Grid container spacing={2}>
                  {formatOptions.map((option) => (
                    <Grid item xs={12} sm={4} key={option.id}>
                      <Paper
                        onClick={() => setSelectedFormat(option.id)}
                        sx={{
                          p: 2.5,
                          height: "100%",
                          display: "flex",
                          flexDirection: "column",
                          alignItems: "center",
                          justifyContent: "center",
                          gap: 1.5,
                          cursor: "pointer",
                          border: "2px solid",
                          borderColor: selectedFormat === option.id ? "primary.main" : "divider",
                          bgcolor: selectedFormat === option.id ? "primary.50" : "background.paper",
                          transition: "all 0.2s ease",
                          "&:hover": { borderColor: "primary.light", bgcolor: "primary.50" },
                        }}
                      >
                        {getFormatIcon(option.id)}
                        <Box textAlign="center">
                          <Typography variant="subtitle2" fontWeight="700">
                            {option.ext.toUpperCase()}
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            {option.label}
                          </Typography>
                        </Box>
                      </Paper>
                    </Grid>
                  ))}
                </Grid>

                {selectedFormat && (
                  <Box sx={{ mt: 4, display: "flex", justifyContent: "center", gap: 2 }}>
                    <Button
                      variant="outlined"
                      startIcon={<VisibilityRounded />}
                      onClick={() => handleViewPreview(selectedFormat)}
                    >
                      Preview {selectedFormat.toUpperCase()} in View
                    </Button>
                  </Box>
                )}
              </>
            ) : (
              /* View Tab Container */
              <Box sx={{ flexGrow: 1, width: "100%", height: "100%", display: "flex", justifyContent: "center", alignItems: "center", bgcolor: "grey.100", borderRadius: 2, overflow: "hidden" }}>
                {previewLoading ? (
                  <CircularProgress />
                ) : previewUrl ? (
                  selectedFormat === "pdf" || selectedFormat === "test" ? (
                    <iframe
                      src={previewUrl}
                      title="Report Preview"
                      width="100%"
                      height="100%"
                      style={{ border: "none" }}
                    />
                  ) : (
                    <Box sx={{ textAlign: "center", p: 4 }}>
                      <TableChartRounded sx={{ fontSize: 60, color: "success.main", mb: 2 }} />
                      <Typography variant="h6" fontWeight="bold">Spreadsheet Preview Ready</Typography>
                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Excel spreadsheets cannot be rendered inline safely. Please click download to view it fully in Excel.
                      </Typography>
                    </Box>
                  )
                ) : (
                  <Typography color="text.secondary">No preview data found.</Typography>
                )}
              </Box>
            )}
          </DialogContent>

          <DialogActions sx={{ p: 2.5, bgcolor: "background.paper", borderTop: "1px solid", borderColor: "divider" }}>
            {activeTab === 1 && (
              <Button onClick={() => setActiveTab(0)} color="inherit">
                Back to Options
              </Button>
            )}
            <Button onClick={() => setSelectedReport(null)} variant="outlined" color="inherit">
              Close
            </Button>
            <Button
              variant="contained"
              disabled={!selectedFormat || !isAvailableToDownload}
              onClick={() => handleDownload(selectedReport.id, selectedFormat)}
              startIcon={<DownloadRounded />}
              sx={{ px: 3 }}
            >
              Download {selectedFormat ? selectedFormat.toUpperCase() : ""}
            </Button>
          </DialogActions>
        </Dialog>
      )}
    </AnimatePresence>
  );
};

export default AdhocReportsDownloadDialog;
