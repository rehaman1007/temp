export const GlobalVariableDailog = ({
  open,
  globalVariable,
  onClose,
  onSave,
}) => {
  const { tableConfigs, getSelectableColumns, getAllowedAggFuncs } =
    useTableConfig();
  console.log(tableConfigs);
  console.log(getSelectableColumns);
  console.log(getAllowedAggFuncs);
  const [editedGlobalVariable, setEditedGlobalVariable] = useState({
    variable: "",
    variableName: "",
    variableDescription: "",
  });

  useEffect(() => {
    if (globalVariable) {
      setEditedGlobalVariable({ ...globalVariable });
    } else {
      setEditedGlobalVariable({
        variable: "",
        variableName: "",
        variableDescription: "",
        params: [],
        filterRules: [],
      });
    }
  }, [globalVariable, open]);

  const updateField = (field, value) => {
    setEditedGlobalVariable({ ...editedGlobalVariable, [field]: value });
  };

  const handleSave = () => {
    onSave(editedGlobalVariable);
    onClose();
  };

  const isValid =
    editedGlobalVariable.variable.trim() &&
    editedGlobalVariable.variableName.trim();

  return (
    <Dialog open={open} onClose={onClose} maxWidth="md" fullWidth>
      <DialogTitle>
        <IconButton
          onClick={onClose}
          sx={{
            width: 30,
            height: 30,
            position: "absolute",
            right: 16,
            top: 10,
          }}
        >
          <CloseIcon />
        </IconButton>
        <Typography>
          {globalVariable ? "Edit Variable" : "Add New Variable"}
        </Typography>
      </DialogTitle>
      <DialogContent dividers>
        <Box sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
          {/* Basic Info */}
          <Box sx={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 2 }}>
            <TextField
              label="Variable"
              value={editedGlobalVariable.variable}
              onChange={(e) =>
                updateField(
                  "variable",
                  e.target.value.replace(/\s/g, "_").toUpperCase(),
                )
              }
              size="small"
              required
              helperText="Unique identifier (no spaces)"
            />
            <TextField
              label="Variable Name"
              value={editedGlobalVariable.variableName}
              onChange={(e) => updateField("variableName", e.target.value)}
              size="small"
              required
            />
          </Box>
          <TextField
            label="Variable Description"
            value={editedGlobalVariable.variableDescription}
            onChange={(e) => updateField("variableDescription", e.target.value)}
            size="small"
            multiline
            rows={2}
            fullWidth
          />
        </Box>
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button onClick={handleSave} variant="contained" disabled={!isValid}>
          {globalVariable ? "Save Changes" : "Add Variable"}
        </Button>
      </DialogActions>
    </Dialog>
  );
};
