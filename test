import React, { useState } from "react";
import {
  Autocomplete,
  Box,
  MenuItem,
  Radio,
  RadioGroup,
  FormControlLabel,
  Select,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import {
  StyledFormBox,
  StyledFormControl,
  StyledStack,
  StyledButton,
  ButtonBox,
} from "./BalanceStyles";
import dayjs from "dayjs";
import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
// import { maxLength } from "zod";

export default function BalanceFilters({
  branch,
  setBranch,
  currency,
  setCurrency,
  cgl,
  setCgl,
  start,
  setStart,
  end,
  setEnd,
  currencies,
  branches,
  cgls,
  loading,
  handleSearchChange,
  fetchCurrencies,
  handleSubmit,
  resetState,
  isNumeric,
  req,
  user,
  permissions,
  etlDate,
  glcc,
  setGlcc,
  glccValidated,
  setGlccValidated,
  validateGlcc,
  glccLoading,
}) {
  const [branchInput, setBranchInput] = useState("");
  const [cglInput, setCglInput] = useState("");

  const [fromDateError, setFromDateError] = useState(null);
  const [toDateError, setToDateError] = useState(null);

  const MIN_ALLOWED_DATE = dayjs("2026-03-31");

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "invalidDate":
        return `Please enter a valid ${field}`;

      case "minDate":
        return `${field} cannot be earlier than ${MIN_ALLOWED_DATE.format(
          "DD-MM-YYYY",
        )}`;

      case "maxDate":
        return `${field} cannot exceed ${etlDate?.format("DD-MM-YYYY")}`;

      case "fromGreaterThanTo":
        return "From Date cannot be greater than To Date";

      case "toLessThanFrom":
        return "To Date cannot be less than From Date";

      case "rangeExceeds12Months":
        return "Date range cannot exceed 12 months";

      case "afterEtlDate":
        return `To Date cannot exceed ETL Date ${etlDate?.format(
          "DD-MM-YYYY",
        )}`;

      default:
        return "";
    }
  };

  const validateDateRange = (fromDate, toDate) => {
    setFromDateError(null);
    setToDateError(null);

    if (!fromDate?.isValid?.() || !toDate?.isValid?.()) {
      return;
    }

    if (fromDate.isAfter(toDate, "day")) {
      setFromDateError("fromGreaterThanTo");
      setToDateError("toLessThanFrom");
      return;
    }

    if (toDate.isAfter(fromDate.add(1, "year"), "day")) {
      setToDateError("rangeExceeds12Months");
      return;
    }

    if (etlDate?.isValid?.() && toDate.isAfter(etlDate, "day")) {
      setToDateError("afterEtlDate");
    }
  };

  const validationMessages = [
    fromDateError && getDateErrorMessage("From Date", fromDateError),

    toDateError && getDateErrorMessage("To Date", toDateError),
  ].filter(Boolean);

  const handleReset = () => {
    setFromDateError(null);
    setToDateError(null);
    resetState();
  };

  return (
    <>
      {/* <StyledStack direction="row"> */}

      <Box>
        {/* Row 1 */}
        <Stack
          direction={{ xs: "column", lg: "row" }}
          spacing={2}
          sx={{ width: "100%" }}
        >
          {permissions?.wholebank && (
            <StyledFormBox sx={{ flex: 1 }}>
              <TextField
                label="GLCC(optional)"
                fullWidth
                value={glcc}
                placeholder="18 Digit GLCC"
                InputLabelProps={{ shrink: true }}
                inputProps={{
                  maxLength: 18,
                }}
                onChange={(e) => {
                  const value = e.target.value.toUpperCase();

                  setGlcc(value);

                  // User modified GLCC → old validated data becomes invalid
                  setGlccValidated(false);

                  // Clear populated fields immediately
                  setBranch("");
                  setCurrency("");
                  setCgl("");

                  if (!value) {
                    return;
                  }

                  if (value.length === 18) {
                    validateGlcc(value);
                  }
                }}
              />
              <Typography
                variant="caption"
                color="text.secondary"
                sx={{ mt: 0.5, display: "block" }}
              >
                Enter GLCC to auto-populate Branch, Currency and CGL
              </Typography>
            </StyledFormBox>
          )}

          <Box
            sx={{
              flex: 1,
              width: "100%",
            }}
          >
            <Box
              sx={{
                display: "grid",
                gridTemplateColumns: {
                  xs: "1fr",
                  md: "repeat(3, 1fr)",
                },
                gap: 2,
                width: "100%",
              }}
            >
              <StyledFormBox
                sx={{
                  p: 0,
                  width: { xs: "100%", md: "auto" },
                  minWidth: { xs: "100%", md: "18%" },
                }}
              >
                <Autocomplete
                  disabled={
                    glccValidated ||
                    (!permissions?.wholebank &&
                      (user?.isCircle === false || permissions?.branch))
                  }
                  value={branch}
                  forcePopupIcon={false}
                  clearIcon={branchInput ? undefined : null}
                  options={branches || []}
                  noOptionsText={
                    req.branch
                      ? "Please enter at least 3 characters"
                      : "No Options"
                  }
                  inputValue={branchInput}
                  loading={!req.branch && loading.branch}
                  onInputChange={(e, value, reason) => {
                    setBranchInput(value);
                    handleSearchChange(value, reason, "branch");
                  }}
                  // noOptionsText={
                  //   branchInput.length < 3
                  //     ? "Please enter at least 3 characters"
                  //     : "No Options"
                  // }
                  onChange={(e, value) => setBranch(value)}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Branch Code or Branch Name*"
                      InputLabelProps={{ shrink: true }}
                      placeholder="eg. 12345 or ABC"
                      slotProps={{
                        htmlInput: {
                          ...params.inputProps,
                          maxLength: isNumeric(params.inputProps.value)
                            ? 5
                            : 15,
                        },
                      }}
                    />
                  )}
                />
              </StyledFormBox>

              <StyledFormBox
                sx={{
                  p: 0,
                  width: { xs: "100%", md: "auto" },
                  minWidth: { xs: "100%", md: "18%" },
                }}
              >
                <Autocomplete
                  disabled={glccValidated}
                  options={currencies || []}
                  // Value Mapping (Find the object that matches your string state)
                  value={
                    currencies?.find((c) => c.currencyCode === currency) || null
                  }
                  // show in the text box and list
                  getOptionLabel={(option) =>
                    option
                      ? `${option.currencyCode} - ${option.currencyName}`
                      : ""
                  }
                  // Update state with just the Code
                  onChange={(event, newValue) => {
                    setCurrency(newValue ? newValue.currencyCode : "");
                  }}
                  // Fetch data on click
                  onOpen={fetchCurrencies}
                  // Handle the UI
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Currency*"
                      InputLabelProps={{ shrink: true }}
                      placeholder={!currency ? "Please select Currency" : ""}
                      sx={{
                        "& .MuiOutlinedInput-root": {
                          backgroundColor: "transparent",
                        },
                      }}
                    />
                  )}
                />
              </StyledFormBox>

              <StyledFormBox
                sx={{
                  p: 0,
                  width: { xs: "100%", md: "auto" },
                  minWidth: { xs: "100%", md: "18%" },
                }}
              >
                <Autocomplete
                  disabled={glccValidated}
                  forcePopupIcon={false}
                  autoHighlight
                  value={cgl}
                  options={cgls}
                  inputValue={cglInput}
                  clearIcon={cglInput || cgl ? undefined : null}
                  noOptionsText={
                    cglInput.length < 3
                      ? "Please enter at least 3 characters"
                      : "No Options"
                  }
                  loading={!req.cgl && loading.cgl}
                  onInputChange={(e, value, reason) => {
                    setCglInput(value);
                    handleSearchChange(value, reason, "cgl");
                  }}
                  onChange={(e, value) => setCgl(value)}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="CGL*"
                      InputLabelProps={{ shrink: true }}
                      placeholder="eg. 9999999999"
                      slotProps={{
                        htmlInput: {
                          ...params.inputProps,
                          maxLength: isNumeric(params.inputProps.value)
                            ? 10
                            : 30,
                        },
                      }}
                    />
                  )}
                  loadingText="Searching Cgls..."
                />
              </StyledFormBox>
            </Box>
          </Box>
        </Stack>

        {/* Row 2 */}

        <LocalizationProvider dateAdapter={AdapterDayjs}>
          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: {
                xs: "1fr",
                md: "repeat(3, 1fr)",
              },
              gap: 2,
              width: "100%",
            }}
          >
            <StyledFormControl
              sx={{
                width: { xs: "100%", md: 180 },
                minWidth: { xs: "100%", md: 200 },
                maxWidth: { xs: "100%", md: 250 },
              }}
            >
              <DatePicker
                value={start}
                format="DD-MM-YYYY"
                minDate={MIN_ALLOWED_DATE}
                maxDate={etlDate}
                views={["year", "month", "day"]}
                disableHighlightToday
                onChange={(value) => {
                  setStart(value);

                  if (end) {
                    validateDateRange(value, end);
                  }
                }}
                onError={(error) => {
                  if (error) {
                    setFromDateError(error);
                  } else {
                    setFromDateError(null);
                  }
                }}
                slotProps={{
                  textField: {
                    label: "From Date*",
                    InputLabelProps: { shrink: true },
                    placeholder: "DD-MM-YYYY",
                    error: !!fromDateError,
                    helperText: "",
                    fullWidth: true,
                  },

                  day: {
                    sx: {
                      fontWeight: 600,
                      "&.MuiPickersDay-root": {
                        color: "#111",
                      },
                      "&.MuiPickersDay-today": {
                        border: "2px solid #58469f",
                        fontWeight: 800,
                      },
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                        fontWeight: 800,
                      },
                      "&:hover": {
                        backgroundColor: "rgba(88,70,159,0.08)",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        backgroundColor: "rgba(0,0,0,0.04)",
                        opacity: 0.45,
                        textDecoration: "line-through",
                      },
                    },
                  },

                  monthButton: {
                    sx: {
                      fontWeight: 700,
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        opacity: 0.45,
                        textDecoration: "line-through",
                        backgroundColor: "rgba(0,0,0,0.04)",
                      },
                    },
                  },

                  yearButton: {
                    sx: {
                      fontWeight: 700,
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        opacity: 0.45,
                        textDecoration: "line-through",
                        backgroundColor: "rgba(0,0,0,0.04)",
                      },
                    },
                  },
                }}
              />
            </StyledFormControl>

            <StyledFormControl
              sx={{
                width: { xs: "100%", md: 180 },
                minWidth: { xs: "100%", md: 200 },
                maxWidth: { xs: "100%", md: 250 },
              }}
            >
              <DatePicker
                value={end}
                format="DD-MM-YYYY"
                minDate={start || MIN_ALLOWED_DATE}
                maxDate={etlDate}
                disableHighlightToday
                disabled={!start}
                onChange={(value) => {
                  setEnd(value);

                  if (start) {
                    validateDateRange(start, value);
                  }
                }}
                onError={(error) => {
                  if (error) {
                    setToDateError(error);
                  } else {
                    setToDateError(null);
                  }
                }}
                slotProps={{
                  textField: {
                    label: "To Date*",
                    InputLabelProps: { shrink: true },
                    placeholder: "DD-MM-YYYY",
                    error: !!toDateError,
                    helperText: "",
                    fullWidth: true,
                  },

                  day: {
                    sx: {
                      fontWeight: 600,
                      "&.MuiPickersDay-root": {
                        color: "#111",
                      },
                      "&.MuiPickersDay-today": {
                        border: "2px solid #58469f",
                        fontWeight: 800,
                      },
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                        fontWeight: 800,
                      },
                      "&:hover": {
                        backgroundColor: "rgba(88,70,159,0.08)",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        backgroundColor: "rgba(0,0,0,0.04)",
                        opacity: 0.45,
                        textDecoration: "line-through",
                      },
                    },
                  },

                  monthButton: {
                    sx: {
                      fontWeight: 700,
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        opacity: 0.45,
                        textDecoration: "line-through",
                        backgroundColor: "rgba(0,0,0,0.04)",
                      },
                    },
                  },

                  yearButton: {
                    sx: {
                      fontWeight: 700,
                      "&.Mui-selected": {
                        backgroundColor: "#58469f !important",
                        color: "#fff !important",
                      },
                      "&.Mui-disabled": {
                        color: "rgba(0,0,0,0.25) !important",
                        opacity: 0.45,
                        textDecoration: "line-through",
                        backgroundColor: "rgba(0,0,0,0.04)",
                      },
                    },
                  },
                }}
              />
            </StyledFormControl>
            <Box
              sx={{
                width: { xs: "100%", md: "auto" },
                display: "flex",
                justifyContent: {
                  xs: "center",
                  md: "flex-end",
                },
                alignItems: "center",
                gap: 1,
              }}
            >
              <StyledButton
                variant="contained"
                startIcon={<RestartAltIcon />}
                onClick={handleReset}
                size="small"
              >
                Reset
              </StyledButton>
              <StyledButton
                variant="contained"
                startIcon={<SearchIcon />}
                size="small"
                disabled={
                  !(cgl && currency && branch && start && end) ||
                  fromDateError ||
                  toDateError
                }
                onClick={handleSubmit}
              >
                Search
              </StyledButton>
            </Box>
          </Box>
        </LocalizationProvider>
      </Box>
      {/* </StyledStack> */}
      {validationMessages.length > 0 && (
        <Box
          sx={{
            mt: 2,
            mb: 1,
            p: 1.5,
            borderRadius: 2,
            border: "1px solid #ff4d4f",
            bgcolor: "#fff1f0",
          }}
        >
          <Stack spacing={0.5}>
            {validationMessages.map((msg, index) => (
              <Typography
                key={index}
                variant="body2"
                sx={{
                  color: "#d32f2f",
                  fontWeight: 600,
                }}
              >
                • {msg}
              </Typography>
            ))}
          </Stack>
        </Box>
      )}
    </>
  );
}
