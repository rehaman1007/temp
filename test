import React, { useState, useEffect, useCallback } from "react";
import {
  Box,
  Grid,
  Card,
  CardContent,
  Typography,
  Chip,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  LinearProgress,
  IconButton,
  Container,
  Stack,
  Avatar,
  useTheme,
} from "@mui/material";
import {
  Storage,
  Speed,
  SettingsInputComponent,
  Psychology,
  Refresh,
  PlayArrow,
  CheckCircle,
  ErrorOutline,
  Info,
} from "@mui/icons-material";
import { PieChart } from "@mui/x-charts/PieChart";
import useApi from "../../hooks/useApi";

const HEALTH_URL = "/PS/airflow/health";
const PIPELINE_URL = "/PS/process/all-pipelines";
const DAGS_URL = "/PS/airflow/running-dags";

const AirflowDashboard = () => {
  const theme = useTheme();
  const [health, setHealth] = useState(null);
  const [pipelines, setPipelines] = useState([]);
  const [runningDags, setRunningDags] = useState([]);
  const [loading, setLoading] = useState(true);
  const { callApi } = useApi();

  const fetchData = useCallback(async () => {
    try {
      const [healthRes, pipeRes, runsRes] = await Promise.all([
        callApi(HEALTH_URL, null, "GET"),
        callApi(PIPELINE_URL, null, "GET"),
        callApi(DAGS_URL, null, "GET"),
      ]);
      console.log(healthRes, pipeRes, runsRes);
      setHealth(healthRes.data);
      setPipelines(pipeRes.data);
      setRunningDags(runsRes.data.dag_runs || []);
    } catch (error) {
      console.error("Dashboard Sync Error:", error);
    } finally {
      setLoading(false);
    }
  }, [callApi]);

  useEffect(() => {
    fetchData();
    const interval = setInterval(fetchData, 30000); // 30s polling
    return () => clearInterval(interval);
  }, [fetchData]);

  if (loading) return <LinearProgress />;

  // Helper to map components to MUI Icons
  const getComponentIcon = (name) => {
    switch (name) {
      case "metadatabase":
        return <Storage />;
      case "scheduler":
        return <Speed />;
      case "triggerer":
        return <SettingsInputComponent />;
      case "dag_processor":
        return <Psychology />;
      default:
        return <Info />;
    }
  };

  // Prepare Data for MUI X PieChart
  const pieData = health
    ? Object.entries(health).map(([key, val], index) => ({
        id: index,
        value: 1,
        label: key.replace("_", " ").toUpperCase(),
        color:
          val.status === "healthy"
            ? theme.palette.success.main
            : theme.palette.error.main,
      }))
    : [];

  return (
    <Container maxWidth="xl" sx={{ mt: 4, mb: 4 }}>
      {/* Dashboard Header */}
      <Stack
        direction="row"
        justifyContent="space-between"
        alignItems="center"
        mb={4}
      >
        <Box>
          <Typography variant="h4" fontWeight="bold">
            Airflow Health Ops
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Systems Monitoring & DAG Orchestration
          </Typography>
        </Box>
        <IconButton
          onClick={fetchData}
          color="primary"
          sx={{ border: "1px solid", borderColor: "divider" }}
        >
          <Refresh />
        </IconButton>
      </Stack>

      <Grid container spacing={3}>
        {/* Component Status Cards */}
        {health &&
          Object.entries(health).map(([key, value]) => (
            <Grid size={{ xs: 12, sm: 6, md: 3 }} key={key}>
              <Card variant="outlined" sx={{ borderRadius: 2 }}>
                <CardContent>
                  <Stack direction="row" spacing={2} alignItems="center">
                    <Avatar
                      sx={{
                        bgcolor:
                          value.status === "healthy"
                            ? "success.light"
                            : "error.light",
                        color:
                          value.status === "healthy"
                            ? "success.dark"
                            : "error.dark",
                      }}
                    >
                      {getComponentIcon(key)}
                    </Avatar>
                    <Box>
                      <Typography
                        variant="caption"
                        color="text.secondary"
                        display="block"
                      >
                        {key.toUpperCase()}
                      </Typography>
                      <Typography variant="h6" sx={{ fontWeight: 600 }}>
                        {value.status.toUpperCase()}
                      </Typography>
                    </Box>
                  </Stack>
                </CardContent>
              </Card>
            </Grid>
          ))}

        {/* Live Running DAGs Table */}
        <Grid size={{ xs: 12, md: 8 }}>
          <Card variant="outlined" sx={{ height: "100%", borderRadius: 2 }}>
            <Box
              p={2}
              sx={{
                borderBottom: "1px solid",
                borderColor: "divider",
                display: "flex",
                justifyContent: "space-between",
              }}
            >
              <Typography variant="h6" fontWeight="bold">
                Active DAG Runs
              </Typography>
              <Chip
                size="small"
                label={`${runningDags.length} Active`}
                color={runningDags.length > 0 ? "info" : "default"}
              />
            </Box>
            <TableContainer sx={{ maxHeight: 400 }}>
              <Table stickyHeader>
                <TableHead>
                  <TableRow>
                    <TableCell>DAG ID</TableCell>
                    <TableCell>Status</TableCell>
                    <TableCell>Start Time</TableCell>
                    <TableCell>Trigger</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {runningDags.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={4} align="center" sx={{ py: 8 }}>
                        <Info sx={{ color: "text.disabled", mb: 1 }} />
                        <Typography variant="body2" color="text.secondary">
                          No Active DAGs Found
                        </Typography>
                      </TableCell>
                    </TableRow>
                  ) : (
                    runningDags.map((run) => (
                      <TableRow key={run.dag_run_id} hover>
                        <TableCell sx={{ fontWeight: 500 }}>
                          {run.dag_id}
                        </TableCell>
                        <TableCell>
                          <Chip
                            icon={
                              <PlayArrow sx={{ fontSize: "14px !important" }} />
                            }
                            label={run.state}
                            size="small"
                            color="info"
                            variant="outlined"
                          />
                        </TableCell>
                        <TableCell>
                          {new Date(run.start_date).toLocaleTimeString()}
                        </TableCell>
                        <TableCell>{run.triggered_by}</TableCell>
                      </TableRow>
                    ))
                  )}
                </TableBody>
              </Table>
            </TableContainer>
          </Card>
        </Grid>

        {/* System Health Pie Chart (MUI X Charts) */}
        <Grid size={{ xs: 12, md: 4 }}>
          <Card variant="outlined" sx={{ height: "100%", borderRadius: 2 }}>
            <CardContent>
              <Typography variant="h6" fontWeight="bold" gutterBottom>
                Health Distribution
              </Typography>
              <Box
                sx={{ height: 300, display: "flex", justifyContent: "center" }}
              >
                <PieChart
                  series={[
                    {
                      data: pieData,
                      innerRadius: 70,
                      outerRadius: 100,
                      paddingAngle: 5,
                      cornerRadius: 5,
                    },
                  ]}
                  height={300}
                />
              </Box>
            </CardContent>
          </Card>
        </Grid>

        {/* Pipeline Registry Grid */}
        <Grid size={{ xs: 12 }}>
          <Typography variant="h6" fontWeight="bold" mb={2}>
            Pipeline Registry
          </Typography>
          <Grid container spacing={2}>
            {pipelines.map((pipe) => (
              <Grid size={{ xs: 12, sm: 6, md: 4 }} key={pipe.processId}>
                <Paper
                  variant="outlined"
                  sx={{
                    p: 2,
                    display: "flex",
                    gap: 2,
                    alignItems: "center",
                    borderRadius: 2,
                  }}
                >
                  <Avatar sx={{ bgcolor: "primary.main" }}>
                    {pipe.processFlag === "Y" ? (
                      <CheckCircle />
                    ) : (
                      <ErrorOutline />
                    )}
                  </Avatar>
                  <Box>
                    <Typography variant="subtitle2" sx={{ fontWeight: 700 }}>
                      {pipe.processName}
                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      {pipe.dagId}
                    </Typography>
                    <Typography
                      variant="body2"
                      sx={{ fontSize: "0.75rem", mt: 0.5 }}
                    >
                      {pipe.processDescription}
                    </Typography>
                  </Box>
                </Paper>
              </Grid>
            ))}
          </Grid>
        </Grid>
      </Grid>
    </Container>
  );
};

export default AirflowDashboard;
