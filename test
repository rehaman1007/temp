import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  Checkbox,
  Chip,
  Autocomplete,
} from "@mui/material";
import { useEffect, useState } from "react";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import { validations } from "../../../utils/Validations";

export default function RolesDialog({ open, onClose, form, setForm, canSave, fetchRoles }) {
  const user = JSON.parse(sessionStorage.getItem("user"));
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [allPermissions, setAllPermissions] = useState([]);
  const [selectedPermissions, setSelectedPermissions] = useState([]);

  useEffect(() => {
    if (open) {
      (async () => {
        const res = await callApi("/UM/permissions/list", {}, "GET");
        if (res?.result?.status) setAllPermissions(res.result.data || []);
        else setAllPermissions([]);

        // Initialize selected permissions on edit
        if (form.roleId && form.permissions) {
          setSelectedPermissions(form.permissions);
        } else {
          setSelectedPermissions([]);
        }
      })();
    }
  }, [open, form.permissions, form.roleId]);

  const onSave = async (type) => {
    if (!form.roleName || !form.description) {
      snackbar("Kindly fill all the required fields.", "error");
      return;
    }

    const subDialog = {
      roleId: form.roleId,
      roleName: form.roleName,
      description: form.description,
      permissions: selectedPermissions.map((p) => p.id), // send selected permission IDs
    };

    const payload = {
      requestType: type,
      targetRoleId: form.roleId,
      requestorUserId: user.userId,
      requestPayload: JSON.stringify(subDialog),
    };

    const res = await callApi("/UM/role/create-role-request", payload, "POST");
    if (res?.result?.status) {
      snackbar(res?.result?.message, "success");
      onClose();
      fetchRoles();
    }
  };

  const handleChange = (data, key, e, type) => {
    const result = validations(type, e.target.value);
    if (result === "") setForm({ ...data, [key]: e.target.value });
    else snackbar(result, "error");
  };

  return (
    <Dialog
      open={open}
      onClose={onClose}
      fullWidth
      maxWidth="md"
      PaperProps={{ sx: { minWidth: 800, maxWidth: "45vw" } }}
    >
      <DialogTitle>{form.roleId ? "Edit Role" : "Add New Role"}</DialogTitle>

      {form.roleId && (
        <IconButton
          aria-label="role status"
          sx={(theme) => ({
            position: "absolute",
            right: 10,
            top: 8,
            color: theme.palette.grey[500],
          })}
          onClick={() => onSave(form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK")}
        >
          {form.status === "ACTIVE" ? (
            <LockOutlineIcon color="error" />
          ) : (
            <LockOpenIcon color="success" />
          )}
          <Typography variant="caption">
            {form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK"}
          </Typography>
        </IconButton>
      )}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {/* Role Name & Description */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={4}>
              <TextField
                label="Role Name *"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.roleName}
                onChange={(e) => handleChange(form, "roleName", e, "inputValue")}
                fullWidth
                size="medium"
              />
            </Grid>
            <Grid item xs={12} md={8}>
              <TextField
                label="Description *"
                slotProps={{ htmlInput: { maxLength: 100 } }}
                value={form.description}
                onChange={(e) => handleChange(form, "description", e, "certainSpecialChars")}
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          {/* Permissions Multi-select */}
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12} md={8}>
              <Autocomplete
                multiple
                options={allPermissions}
                disableCloseOnSelect
                getOptionLabel={(option) => option.title}
                value={selectedPermissions}
                onChange={(e, newValue) => setSelectedPermissions(newValue)}
                renderOption={(props, option, { selected }) => (
                  <li {...props}>
                    <Checkbox checked={selected} sx={{ mr: 1 }} />
                    {option.title}
                  </li>
                )}
                renderInput={(params) => <TextField {...params} label="Permissions" />}
              />

              {/* Render selected permissions outside input */}
              <Stack direction="row" spacing={1} sx={{ mt: 1, flexWrap: "wrap" }}>
                {selectedPermissions.map((p) => (
                  <Chip
                    key={p.id}
                    label={p.title}
                    size="small"
                    onDelete={() =>
                      setSelectedPermissions(selectedPermissions.filter((perm) => perm.id !== p.id))
                    }
                  />
                ))}
              </Stack>
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          variant="contained"
          disabled={!canSave}
          onClick={() => onSave(form.roleId ? "MODIFY" : "CREATE")}
        >
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}