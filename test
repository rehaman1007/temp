import React, { useEffect, useState } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  Chip,
  List,
  ListItem,
  ListItemText,
  Divider
} from "@mui/material";
import Grid from "@mui/material/Unstable_Grid2";

import {
  PieChart,
  Pie,
  Cell,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  Legend
} from "recharts";

import { buildDashboardConfig } from "../utils/buildDashboardConfig";
import useApi from "../hooks/useApi";

const COLORS = ["#8884d8", "#82ca9d", "#ffc658", "#ff7f50", "#00bcd4"];

function getSeverityColor(severity) {
  switch (severity) {
    case "WARN":
      return "warning";
    case "ERROR":
      return "error";
    case "INFO":
    default:
      return "info";
  }
}

function getUserContext() {
  try {
    const raw = sessionStorage.getItem("fincoreUserContext");
    return raw ? JSON.parse(raw) : {};
  } catch (e) {
    console.warn("Failed to parse fincoreUserContext from sessionStorage", e);
    return {};
  }
}

const DashboardPage = () => {
  const api = useApi();
  const [rawData, setRawData] = useState(null);
  const [config, setConfig] = useState({ sections: [] });
  const [loading, setLoading] = useState(false);

  const userCtx = getUserContext();
  const fy = userCtx.financialYear || {};

  useEffect(() => {
    const load = async () => {
      setLoading(true);
      try {
        const res = await api.get("/dashboard"); // adjust URL
        if (res.data && res.data.success) {
          setRawData(res.data.data);
          setConfig(buildDashboardConfig(res.data.data));
        }
      } catch (e) {
        console.error("Failed to load dashboard", e);
      } finally {
        setLoading(false);
      }
    };
    load();
  }, [api]);

  if (loading || !rawData) {
    return (
      <Box p={3}>
        <Typography variant="body1">Loading dashboard…</Typography>
      </Box>
    );
  }

  return (
    <Box p={3}>
      {/* TOP GREETING + USER CARD */}
      <Stack direction="row" justifyContent="space-between" mb={2}>
        <Typography variant="h5" fontWeight={600}>
          Welcome To FinCore
        </Typography>

        <Card
          variant="outlined"
          sx={{ borderRadius: 3, minWidth: 260, px: 2, py: 1.5 }}
        >
          <Typography variant="body2">
            Name:{" "}
            <strong>{userCtx.userName || "User (not in session)"}</strong>
          </Typography>
          <Typography variant="body2">
            Role: <strong>{userCtx.role || rawData.viewType}</strong>
          </Typography>
        </Card>
      </Stack>

      {/* INFO CARDS: Financial Year / Circle / Branch */}
      <Grid container spacing={2} mb={3}>
        {/* Current Financial Period */}
        <Grid xs={12} md={4}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Current Financial Period
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="caption" color="text.secondary">
                  Start date
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {fy.startDate || "—"}
                </Typography>
                <Typography
                  variant="caption"
                  color="text.secondary"
                  sx={{ mt: 1 }}
                >
                  End date
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {fy.endDate || "—"}
                </Typography>
              </Stack>
            </CardContent>
          </Card>
        </Grid>

        {/* Circle Information */}
        <Grid xs={12} md={4}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Circle Information
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="caption" color="text.secondary">
                  Circle Name
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {userCtx.circleName || "—"}
                </Typography>
                <Typography
                  variant="caption"
                  color="text.secondary"
                  sx={{ mt: 1 }}
                >
                  Circle Code
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {userCtx.circleCode || "—"}
                </Typography>
              </Stack>
            </CardContent>
          </Card>
        </Grid>

        {/* Branch Information */}
        <Grid xs={12} md={4}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Branch Information
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="caption" color="text.secondary">
                  Branch Name
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {userCtx.branchName || "—"}
                </Typography>
                <Typography
                  variant="caption"
                  color="text.secondary"
                  sx={{ mt: 1 }}
                >
                  Branch Code
                </Typography>
                <Typography variant="body2" fontWeight={500}>
                  {userCtx.branchCode || "—"}
                </Typography>
              </Stack>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* DYNAMIC SECTIONS WITH TITLES */}
      {config.sections.map((section) => (
        <Box key={section.id} mb={3}>
          {section.title && (
            <Typography variant="subtitle1" fontWeight={600} mb={1.5}>
              {section.title}
            </Typography>
          )}

          <Grid container spacing={2}>
            {section.widgets.map((w) => (
              <Grid
                key={w.id}
                xs={12}
                md={section.widgets.length > 1 ? 6 : 12}
                lg={
                  w.type === "stat" && section.id === "overview"
                    ? 4
                    : section.widgets.length > 1
                    ? 6
                    : 12
                }
              >
                <Card
                  variant="outlined"
                  sx={{
                    borderRadius: 3,
                    height:
                      w.type === "stat" ||
                      w.type === "list-announcements" ||
                      w.type === "list-activity"
                        ? 220
                        : 280
                  }}
                >
                  <CardContent sx={{ height: "100%" }}>
                    {w.title && (
                      <Typography
                        variant="subtitle2"
                        fontWeight={600}
                        mb={1}
                      >
                        {w.title}
                      </Typography>
                    )}
                    <Box sx={{ height: "85%" }}>{renderWidget(w)}</Box>
                  </CardContent>
                </Card>
              </Grid>
            ))}
          </Grid>
        </Box>
      ))}
    </Box>
  );
};

export default DashboardPage;

/* -------------------- Widget renderer -------------------- */

function renderWidget(widget) {
  const { type, data } = widget;

  if (type === "stat") {
    return (
      <Stack spacing={1} justifyContent="center" sx={{ height: "100%" }}>
        <Typography variant="h3">{data.value}</Typography>
        {data.secondary && data.secondary.length > 0 && (
          <Box>
            {data.secondary.map((s) => (
              <Typography
                key={s.label}
                variant="caption"
                display="block"
                color="text.secondary"
              >
                {s.label}: <strong>{s.value}</strong>
              </Typography>
            ))}
          </Box>
        )}
      </Stack>
    );
  }

  if (type === "pie") {
    if (!data || data.length === 0) return <EmptyState text="No data" />;

    return (
      <ResponsiveContainer width="100%" height="100%">
        <PieChart>
          <Pie
            data={data}
            dataKey="value"
            nameKey="label"
            outerRadius="80%"
            label
          >
            {data.map((entry, index) => (
              <Cell
                key={`cell-${index}`}
                fill={COLORS[index % COLORS.length]}
              />
            ))}
          </Pie>
          <Tooltip />
        </PieChart>
      </ResponsiveContainer>
    );
  }

  if (type === "bar") {
    if (!data || data.length === 0) return <EmptyState text="No data" />;

    return (
      <ResponsiveContainer width="100%" height="100%">
        <BarChart data={data}>
          <XAxis dataKey="module" />
          <YAxis />
          <Tooltip />
          <Legend />
          <Bar dataKey="pending" name="Pending" />
          <Bar dataKey="approved" name="Approved" />
          <Bar dataKey="rejected" name="Rejected" />
        </BarChart>
      </ResponsiveContainer>
    );
  }

  if (type === "list-announcements") {
    if (!data || data.length === 0)
      return <EmptyState text="No announcements" />;

    return (
      <List dense sx={{ maxHeight: "100%", overflow: "auto" }}>
        {data.map((a, idx) => (
          <React.Fragment key={a.id}>
            {idx > 0 && <Divider component="li" />}
            <ListItem alignItems="flex-start">
              <ListItemText
                primary={
                  <Stack direction="row" spacing={1} alignItems="center">
                    <Typography variant="body2" fontWeight={600}>
                      {a.title}
                    </Typography>
                    <Chip
                      label={a.severity}
                      size="small"
                      color={getSeverityColor(a.severity)}
                      variant="outlined"
                    />
                  </Stack>
                }
                secondary={
                  <>
                    <Typography
                      component="span"
                      variant="caption"
                      color="text.secondary"
                      display="block"
                    >
                      {a.date}
                    </Typography>
                    <Typography variant="body2">{a.message}</Typography>
                  </>
                }
              />
            </ListItem>
          </React.Fragment>
        ))}
      </List>
    );
  }

  if (type === "list-activity") {
    if (!data || data.length === 0)
      return <EmptyState text="No recent activity" />;

    return (
      <List dense sx={{ maxHeight: "100%", overflow: "auto" }}>
        {data.slice(0, 10).map((a, idx) => (
          <React.Fragment key={a.timestamp + idx}>
            {idx > 0 && <Divider component="li" />}
            <ListItem alignItems="flex-start">
              <ListItemText
                primary={
                  <Stack direction="row" spacing={1} alignItems="center">
                    <Typography variant="body2" fontWeight={600}>
                      {a.action}
                    </Typography>
                    <Chip
                      label={a.status}
                      size="small"
                      color={
                        a.status === "PENDING"
                          ? "warning"
                          : a.status === "REJECTED"
                          ? "error"
                          : "success"
                      }
                      variant="outlined"
                    />
                  </Stack>
                }
                secondary={
                  <>
                    <Typography
                      component="span"
                      variant="caption"
                      color="text.secondary"
                      display="block"
                    >
                      {a.displayTime}
                    </Typography>
                    <Typography variant="body2">{a.details}</Typography>
                  </>
                }
              />
            </ListItem>
          </React.Fragment>
        ))}
      </List>
    );
  }

  return <EmptyState text={`Unknown widget type: ${type}`} />;
}

function EmptyState({ text }) {
  return (
    <Stack
      alignItems="center"
      justifyContent="center"
      sx={{ height: "100%" }}
    >
      <Typography variant="caption" color="text.secondary">
        {text}
      </Typography>
    </Stack>
  );
}