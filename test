import React from "react";
import {
  PieChart,
  Pie,
  Cell,
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ResponsiveContainer,
} from "recharts";

const CHART_COLORS = [
  "#3b82f6", // blue
  "#8b5cf6", // purple  
  "#10b981", // green
  "#f59e0b", // amber
  "#06b6d4", // cyan
  "#ef4444", // red
];

export default function ChartsComponent({ requestData = [] }) {
  const total = requestData.length;
  const hasData = total > 0;

  // Request Type Counts
  const typeCounts = [
    { name: "Add", value: requestData.filter((r) => r.changeType === "ADD").length },
    { name: "Modify", value: requestData.filter((r) => r.changeType === "MODIFY").length },
    { name: "Delete", value: requestData.filter((r) => r.changeType === "DELETE").length },
  ];

  // Trend Data grouped by Date
  const trendData = requestData.reduce((acc, curr) => {
    const date = curr.reqDate?.split("T")[0] || "Unknown";
    const existing = acc.find((item) => item.date === date);
    if (existing) existing.requests++;
    else acc.push({ date, requests: 1 });
    return acc;
  }, []);

  const CustomTooltip = ({ active, payload, label }) => {
    if (active && payload && payload.length) {
      return (
        <div className="bg-white border border-gray-300 rounded-lg p-3 shadow-lg">
          <p className="text-gray-800 font-medium">{`${label}: ${payload[0].value}`}</p>
        </div>
      );
    }
    return null;
  };

  return (
    <div className="w-full p-6 bg-gray-50">
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* Donut Chart - Request Types */}
        <div className="bg-white rounded-lg shadow-lg p-6">
          <h3 className="text-xl font-semibold text-gray-800 mb-4">Request Types</h3>
          <div className="flex items-center justify-center">
            <div className="relative">
              <PieChart width={280} height={280}>
                <Pie
                  data={hasData ? typeCounts : [{ name: "No Data", value: 1 }]}
                  dataKey="value"
                  nameKey="name"
                  innerRadius={70}
                  outerRadius={110}
                  startAngle={90}
                  endAngle={-270}
                  paddingAngle={3}
                >
                  {(hasData ? typeCounts : [{ name: "No Data", value: 1 }]).map((_, i) => (
                    <Cell key={i} fill={hasData ? CHART_COLORS[i % CHART_COLORS.length] : "#e5e7eb"} />
                  ))}
                </Pie>
              </PieChart>

              {/* Center Text */}
              <div className="absolute inset-0 flex flex-col items-center justify-center">
                {hasData ? (
                  <>
                    <span className="text-3xl font-bold text-gray-800">{total}</span>
                    <span className="text-sm text-gray-500">Requests</span>
                  </>
                ) : (
                  <span className="text-sm text-gray-500">No Data</span>
                )}
              </div>
            </div>

            {/* Legend */}
            <div className="ml-8 space-y-3">
              {(hasData ? typeCounts : [{ name: "No Data", value: 0 }]).map((entry, index) => (
                <div key={index} className="flex items-center">
                  <div
                    className="w-4 h-4 rounded-sm mr-3"
                    style={{
                      backgroundColor: hasData ? CHART_COLORS[index % CHART_COLORS.length] : "#e5e7eb",
                    }}
                  />
                  <span className="text-sm font-medium text-gray-800">{entry.name}: {entry.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Trend Chart */}
        <div className="bg-white rounded-lg shadow-lg p-6">
          <h3 className="text-xl font-semibold text-gray-800 mb-4">Request Trends</h3>
          {hasData ? (
            <ResponsiveContainer width="100%" height={280}>
              <LineChart data={trendData}>
                <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
                <XAxis 
                  dataKey="date" 
                  stroke="#6b7280"
                  fontSize={12}
                />
                <YAxis 
                  stroke="#6b7280"
                  fontSize={12}
                />
                <Tooltip content={<CustomTooltip />} />
                <Line 
                  type="monotone" 
                  dataKey="requests" 
                  stroke="#06b6d4" 
                  strokeWidth={3}
                  dot={{ fill: "#06b6d4", strokeWidth: 2, r: 4 }}
                  activeDot={{ r: 6, fill: "#06b6d4" }}
                />
              </LineChart>
            </ResponsiveContainer>
          ) : (
            <div className="flex items-center justify-center h-70">
              <span className="text-gray-500">No Trend Data Available</span>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}



const validateRow = (row, index) => {
    const rowNumber = index + 2;
    const rowErrors = [];

    const {
      UCN: ucn,
      "Firm Registration No.": frn,
      "Firm Name": firmName,
      "PAN NO.": pan,
      "GSTIN NO.": gstin,
      "Address Line": address,
      City: city,
      "State Name": state,
      "District Name": district,
      "Pin Code": pin,
      "Primary Mobile No.": mobile,
      "Point of Contact": contactName,
      "Point of Contact's Designation": contactDesig,
      "Point of Contact Email": contactEmail,
      "Type of Establishment": establishment,
    } = row;

    /**
     * todo:
     *
     * pan is null then don't check
     * gstin is null then don't check
     * ucn is null then don't check
     * frn no : whitelist '/' char
     *
     */

    if (!isOnlyNumbers(ucn)) rowErrors.push("UCN must be numbers only");
    if (!isAlphanumeric(frn))
      rowErrors.push("Firm Registration No. must be alphanumeric");
    if (!firmName?.trim()) rowErrors.push("Firm Name is required");
    if (!isPAN(pan)) rowErrors.push("Invalid PAN (alphanumeric only)");
    if (!isGSTIN(gstin)) rowErrors.push("Invalid GSTIN (alphanumeric only)");
    if (!isAddress(address))
      rowErrors.push("Address must contain only alphabets");
    if (!isAlpha(city)) rowErrors.push("City must contain only alphabets");
    if (!isAlpha(state)) rowErrors.push("State must contain only alphabets");
    if (!isAlpha(district))
      rowErrors.push("District must contain only alphabets");
    if (!isPinCode(pin)) rowErrors.push("Pin Code must be 6 digits");
    if (!isMobile(mobile)) rowErrors.push("Mobile number must be 10 digits");
    if (!isAlpha(contactName))
      rowErrors.push("Contact Name must contain only text");
    if (!isAlpha(contactDesig))
      rowErrors.push("Designation must contain only text");
    if (!contactEmail?.trim()) rowErrors.push("Contact Email is required");

    if (
      !["partnership firm", "proprietorship firm", "other"].includes(
        establishment?.toString().toLowerCase()
      )
    ) {
      rowErrors.push("Invalid Type of Establishment");
    }

    return { rowNumber, isValid: rowErrors.length === 0, errors: rowErrors };
  };
