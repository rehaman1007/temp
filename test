import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  SmartScreen,
  Link as LinkIcon,
  ContentCopy,
  VisibilityOff,
  Badge,
  Public,
  ExpandMore,
  LocationCity,
  Map,
  Tag,
  Numbers,
  Apartment,
  ShortText,
  Key,
  PinDrop,
  Home,
  Visibility,
  Check,
} from "@mui/icons-material";
import { Accordion, AccordionSummary, AccordionDetails } from "@mui/material";
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  Divider,
  Drawer,
  Collapse,
  Button,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  useTheme,
  useMediaQuery,
  Tooltip,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { userAvatarCreator } from "../utils/userUtilities";
import { useContext, useEffect, useState } from "react";
import { AuthContext } from "../context/AuthContext";

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);

  // States
  const [expanded, setExpanded] = useState(false);
  const [showPhone, setShowPhone] = useState(false);
  const [emailCopied, setEmailCopied] = useState(false);

  const formatPhoneNumber = (phone) => {
    if (!phone) return "N/A";
    if (showPhone) return phone;
    // Mask all but the last 4 digits with X
    const visibleDigits = phone.slice(-4);
    const maskedSection = "X".repeat(Math.max(0, phone.length - 4));
    return `${maskedSection}${visibleDigits}`;
  };

  const handleCopyEmail = () => {
    if (user?.email) {
      navigator.clipboard.writeText(user.email);
      setEmailCopied(true);
      setTimeout(() => setEmailCopied(false), 2000);
    }
  };

  const theme = useTheme();
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));

  const formatCode = (code, length) => {
    if (code === undefined || code === null || code === "") return "N/A";
    return String(code).padStart(length, "0");
  };

  const branchDisplay = user?.branchName
    ? `${user.branchName} (${formatCode(user.branch, 5)})`
    : "N/A";

  const circleDisplay = user?.circleName
    ? `${user.circleName} (${formatCode(user.circleCode, 3)})`
    : "N/A";

  useEffect(() => {
    const handleKeyDown = (event) => {
      if (
        !isMobileOrTablet &&
        event.altKey &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();
        logout();
      }

      if (event.key === "Escape" && profileDrawerOpen) {
        setProfileDrawerOpen(false);
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, setProfileDrawerOpen, isMobileOrTablet]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={() => setProfileDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: { xs: "85vw", sm: 380 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          p: 0,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: { xs: 2, sm: 3 }, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Scrollable Content */}
      <Box
        sx={{
          p: { xs: 2, sm: 3 },
          overflowY: "auto",
          overflowX: "hidden",
          flex: 1,
        }}
      >
        {/* User Identity Section */}
        <Box sx={{ display: "flex", alignItems: "center", gap: 2, mb: 1.5 }}>
          <Avatar
            sx={{
              width: 72,
              height: 72,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "1.75rem",
              fontWeight: 600,
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Box sx={{ flex: 1, minWidth: 0 }}>
            <Typography
              variant="h6"
              sx={{ fontWeight: 700, lineHeight: 1.2, mb: 0.25 }}
              noWrap
            >
              {[user?.firstName, user?.middleName, user?.lastName]
                .filter(Boolean)
                .join(" ")}
            </Typography>
            <Typography
              variant="body2"
              color="text.secondary"
              sx={{ mb: 0.75 }}
              noWrap
            >
              {user?.userId}
            </Typography>
          </Box>
        </Box>

        {/* Role */}
        <Box sx={{ textAlign: "center", mb: 2 }}>
          <Chip
            label={user?.roleName}
            size="small"
            sx={{ fontWeight: 600, letterSpacing: "0.3px", color: "primary" }}
          />
          {user?.roleDescription && (
            <Typography
              variant="caption"
              color="text.secondary"
              sx={{ display: "block", mt: 0.5 }}
            >
              {user.roleDescription}
            </Typography>
          )}
        </Box>

        {/* Organizational Information */}
        <Accordion
          defaultExpanded
          disableGutters
          sx={{
            mb: 1.5,
            borderRadius: 2,
            "&.Mui-expanded": { margin: 0 },
            "& .MuiAccordionSummary-root": {
              padding: "0 16px",
              "&:hover": { backgroundColor: "transparent" },
            },
            "& .MuiAccordionDetails-root": { padding: "8px 16px 16px" },
          }}
        >
          <AccordionSummary
            expandIcon={<ExpandMore sx={{ fontSize: 20 }} />}
            sx={{ minHeight: 44 }}
          >
            <Stack spacing={2}>
              <Typography
                variant="subtitle2"
                color="primary"
                sx={{
                  fontWeight: 700,
                  fontSize: "0.7rem",
                  letterSpacing: "1px",
                }}
              >
                Service Information
              </Typography>

              <Divider />

              {/* Branch */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <Business
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Branch
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {branchDisplay}
                  </Typography>
                </Box>
              </Box>

              {/* Circle */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <AccountTree
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Circle
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {circleDisplay}
                  </Typography>
                </Box>
              </Box>

              {/* Access */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <SmartScreen
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    <strong>{user?.accessName}</strong> Level Access
                  </Typography>
                  {user?.accessDescription && (
                    <Typography variant="caption" color="text.secondary">
                      {user.accessDescription}
                    </Typography>
                  )}
                </Box>
              </Box>
            </Stack>
          </AccordionSummary>

          <AccordionDetails>
            {/* Your existing Stack content goes here */}
            <Stack spacing={2}>
              {/* Branch */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <Business
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Branch
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {branchDisplay}
                  </Typography>
                </Box>
              </Box>

              {/* Circle */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <AccountTree
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    sx={{ display: "block" }}
                  >
                    Circle
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {circleDisplay}
                  </Typography>
                </Box>
              </Box>

              {/* Access */}
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <SmartScreen
                  sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }}
                />
                <Box>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    <strong>{user?.accessName}</strong> Level Access
                  </Typography>
                  {user?.accessDescription && (
                    <Typography variant="caption" color="text.secondary">
                      {user.accessDescription}
                    </Typography>
                  )}
                </Box>
              </Box>

              {/* Expanded details */}
              {expanded && (
                <Box>
                  <Divider sx={{ my: 1.5 }} />
                  <Stack spacing={2}>
                    <Stack spacing={2}>
                      {/* City */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <LocationCity
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            City
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.city}
                          </Typography>
                        </Box>
                      </Box>

                      {/* State */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <Map
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            State
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.stateName}
                          </Typography>
                        </Box>
                      </Box>

                      {/* Zone */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <Public
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            Zone
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.zoneName}
                          </Typography>
                        </Box>
                      </Box>

                      {/* NMR Code */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <ShortText
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            NMR Code
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.nmrCode}
                          </Typography>
                        </Box>
                      </Box>

                      {/* Pincode */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <PinDrop
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            Pincode
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.pincode}
                          </Typography>
                        </Box>
                      </Box>

                      {/* Address */}
                      <Box
                        sx={{
                          display: "flex",
                          alignItems: "flex-start",
                          gap: 2,
                        }}
                      >
                        <Home
                          sx={{
                            color: "text.secondary",
                            fontSize: 20,
                            mt: 0.5,
                          }}
                        />
                        <Box>
                          <Typography
                            variant="caption"
                            color="text.secondary"
                            sx={{ display: "block" }}
                          >
                            Address
                          </Typography>
                          <Typography variant="body2" sx={{ fontWeight: 500 }}>
                            {user?.address}
                          </Typography>
                        </Box>
                      </Box>
                    </Stack>
                  </Stack>
                </Box>
              )}
            </Stack>
          </AccordionDetails>
        </Accordion>

        {/* Contact Information */}
        <Card sx={{ mb: 1.5 }}>
          <CardContent sx={{ p: 1.5, "&:last-child": { pb: 1.5 } }}>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                mb: 0.5,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              CONTACT INFORMATION
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={2}>
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  gap: 1.5,
                }}
              >
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.5,
                    overflow: "hidden",
                  }}
                >
                  <Email sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box sx={{ minWidth: 0 }}>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Email
                    </Typography>
                    <Typography variant="body2" sx={{ wordBreak: "break-all" }}>
                      {user?.email}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title={emailCopied ? "Copied!" : "Copy Email"}>
                  <IconButton
                    onClick={handleCopyEmail}
                    size="small"
                    sx={{
                      color: emailCopied ? "success.main" : "text.secondary",
                    }}
                  >
                    {emailCopied ? (
                      <Check fontSize="small" />
                    ) : (
                      <ContentCopy fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>

              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                }}
              >
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                  <Phone sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Contact No
                    </Typography>
                    <Typography
                      variant="body2"
                      sx={{
                        fontSize: "0.875rem",
                        letterSpacing: "2px",
                      }}
                    >
                      {formatPhoneNumber(user?.phoneNumber)}
                    </Typography>
                  </Box>
                </Box>
                {/* Mouse Down/Up and Touch Start/End for "Hold to reveal" */}
                <Tooltip title="Hold to reveal">
                  <IconButton
                    onMouseDown={() => setShowPhone(true)}
                    onMouseUp={() => setShowPhone(false)}
                    onMouseLeave={() => setShowPhone(false)}
                    onTouchStart={() => setShowPhone(true)}
                    onTouchEnd={() => setShowPhone(false)}
                    size="small"
                    sx={{ color: "text.secondary" }}
                  >
                    {showPhone ? (
                      <Visibility fontSize="small" />
                    ) : (
                      <VisibilityOff fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>
            </Stack>
          </CardContent>
        </Card>
        {/* Footer Actions */}
        <List sx={{ p: 0 }}>
          {/* Help & Support */}
          <ListItem disablePadding sx={{ px: 1 }}>
            <ListItemButton
              onClick={() => {
                navigate("/help");
                setProfileDrawerOpen(false); // Close drawer on navigation
              }}
              sx={{
                borderRadius: "12px",
                py: 1.5,
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                color: "primary.main",
                "&:hover": {
                  backgroundColor: "action.hover",
                  borderLeftColor: "primary.main",
                  "& .help-icon": {
                    transform: "translateX(5px)",
                  },
                },
              }}
            >
              <ListItemIcon
                className="help-icon"
                sx={{
                  color: "primary.main",
                  minWidth: "40px",
                  transition: "transform 0.3s ease",
                }}
              >
                <Help fontSize="small" />
              </ListItemIcon>
              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: 600, letterSpacing: "0.3px" }}
                  >
                    Help & Support
                  </Typography>
                }
              />
            </ListItemButton>
          </ListItem>

          {/* Connect to SCORE */}
          <ListItem disablePadding sx={{ mt: 0.5, px: 1 }}>
            <ListItemButton
              component="a" // Use the button as an anchor tag
              href="https://score.sbi/"
              target="_blank"
              rel="noopener noreferrer"
              sx={{
                borderRadius: "12px",
                py: 1.5,
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                color: "primary.main",
                "&:hover": {
                  // Standard MUI light background hover for primary color
                  backgroundColor: (theme) => `${theme.palette.primary.main}14`,
                  borderLeftColor: "primary.main",
                  "& .connect-icon": {
                    transform: "translateX(5px)",
                    color: "primary.dark",
                  },
                },
              }}
            >
              <ListItemIcon
                className="connect-icon"
                sx={{
                  color: "primary.main",
                  minWidth: "40px",
                  transition: "transform 0.3s ease",
                }}
              >
                <LinkIcon fontSize="small" />
              </ListItemIcon>
              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: 700, letterSpacing: "0.3px" }}
                  >
                    Connect to SCORE
                  </Typography>
                }
              />
            </ListItemButton>
          </ListItem>

          <Divider sx={{ my: 1 }} />

          {/* Sign Out */}
          <ListItem disablePadding sx={{ mt: 1, px: 1 }}>
            <ListItemButton
              onClick={logout}
              sx={{
                borderRadius: "12px",
                py: 1.5,
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                position: "relative",
                overflow: "hidden",
                color: "error.main",
                "&:hover": {
                  backgroundColor: (theme) => `${theme.palette.error.main}14`,
                  borderLeftColor: "error.main",
                  "& .logout-icon": {
                    transform: "translateX(5px)",
                    color: "error.dark",
                  },
                  "& .shortcut-hint": {
                    opacity: 1,
                    transform: "scale(1.05)",
                    backgroundColor: "error.main",
                    color: "white",
                  },
                },
              }}
            >
              <ListItemIcon
                className="logout-icon"
                sx={{
                  color: "error.light",
                  minWidth: "40px",
                  transition: "transform 0.3s ease",
                }}
              >
                <Logout fontSize="small" />
              </ListItemIcon>

              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: 700, letterSpacing: "0.3px" }}
                  >
                    Sign Out
                  </Typography>
                }
              />

              {!isMobileOrTablet && (
                <Box
                  className="shortcut-hint"
                  sx={{
                    fontSize: "9px",
                    fontWeight: 800,
                    px: 1,
                    py: 0.3,
                    borderRadius: "6px",
                    border: "1px solid",
                    borderColor: "divider",
                    opacity: 0.6,
                    transition: "all 0.3s ease",
                    textTransform: "uppercase",
                  }}
                >
                  Alt + L
                </Box>
              )}
            </ListItemButton>
          </ListItem>
        </List>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
