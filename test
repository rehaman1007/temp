import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  Grid,
  TextField,
  Typography,
} from "@mui/material";
import useApi from "../../hooks/useApi";

export default function CglView() {
  const { callApi } = useApi();
  const [cglCode, setCglCode] = useState("");
  const [cglDesc, setCglDesc] = useState("");

  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  const fetchData = async () => {
    try {
      setLoading(true);

      const res = await callApi(
        "/CM/cglWithSegment",
        { cglNumb: cglCode },
        "GET"
      );
      setOptions(res?.data?.data || []);
    } catch (err) {
      console.log("error >", err);
      setOptions([]);
    } finally {
      setLoading(false);
    }
  };

  const handleChange = () => {
    console.log("Inside Change", cglCode);
    if (cglCode.trim().length > 2 || cglDesc.trim().length > 2) {
      console.log("Inside Statement");
      fetchData();
    }
  };

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* Search Fields */}
      <Grid container spacing={2} sx={{ mb: 3 }}>
        <Grid item xs={12} sm={4}>
          <Autocomplete
            value={cglCode}
            autoHighlight
            loading={loading}
            options={options}
            noOptionsText={
              cglCode.trim().length > 2
                ? "Please enter at least 3 characters"
                : "No Options"
            }
            onChange={(e) => {
              setCglCode(e.target.value);
              handleChange();
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                sx={{
                  minWidth: 250,
                  "& .MuiOutlinedInput-root": {
                    backgroundColor: "transparent",
                  },
                }}
                placeholder="eg. 12365 or ABC"
                name="branch"
                slotProps={{
                  htmlInput: {
                    ...params.inputProps,
                    maxlength: 10,
                  },
                }}
              />
            )}
            loadingText="Searching CGL's..."
          />
        </Grid>

        <Grid item xs={12} sm={4}>
          <TextField
            label="CGL Description"
            fullWidth
            value={cglDesc}
            onChange={(e) => {
              setCglDesc(e.target.value);
              handleChange();
            }}
            placeholder="Enter at least 4 characters"
          />
        </Grid>

        <Grid item xs={12} sm={4}>
          <Autocomplete
            fullWidth
            loading={loading}
            options={options}
            value={selected}
            onChange={(_, value) => setSelected(value)}
            getOptionLabel={(opt) =>
              opt ? `${opt.cglNumber} - ${opt.description}` : ""
            }
            renderInput={(params) => (
              <TextField
                {...params}
                label="Search Results"
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
                    <>
                      {loading && <CircularProgress size={18} />}
                      {params.InputProps.endAdornment}
                    </>
                  ),
                }}
              />
            )}
            sx={{ minWidth: "300px" }}
          />
        </Grid>
      </Grid>

      {/* Details */}
      <Card sx={{ p: 3 }}>
        {!selected ? (
          <Typography color="gray">No CGL Selected</Typography>
        ) : (
          <Grid container spacing={2}>
            <Grid item xs={12} sm={4}>
              <TextField
                label="CGL Number"
                value={selected.cglNumber}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>
            <Grid item xs={12} sm={4}>
              <TextField
                label="Comp1"
                value={selected.comp1}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>
            <Grid item xs={12} sm={4}>
              <TextField
                label="Comp2"
                value={selected.comp2}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={6}>
              <TextField
                label="Description"
                value={selected.description}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>
            <Grid item xs={12} sm={6}>
              <TextField
                label="Segment Description"
                value={selected.segmentDescription}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={4}>
              <TextField
                label="Balance Compare"
                value={selected.balcompare === 1 ? "Include" : "Exclude"}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={4}>
              <TextField
                label="Manual Posting"
                value={selected.manualPosting === 1 ? "Allowed" : "Not Allowed"}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={4}>
              <TextField
                label="Balance Forward"
                value={selected.balFwd === 1 ? "Yes" : "No"}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={6}>
              <TextField
                label="Open Date"
                value={selected.openDate || "-"}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>

            <Grid item xs={12} sm={6}>
              <TextField
                label="Close Date"
                value={selected.closeDate || "-"}
                fullWidth
                InputProps={{ readOnly: true }}
              />
            </Grid>
          </Grid>
        )}
      </Card>
    </Box>
  );
}
