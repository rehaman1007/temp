	@Query(value = "SELECT COUNT(*) FROM GL_TRANSACTIONS WHERE BRANCH_CODE = :branch AND CURRENCY = :currency AND CGL = :cgl AND TRANSACTION_DATE BETWEEN TO_DATE(:fromDate, 'dd/MM/YYYY') AND TO_DATE(:toDate, 'dd/MM/YYYY')", nativeQuery = true)
	Long getDataCount(@Param("branch") String branch, @Param("currency") String currency, @Param("cgl") String cgl,
			@Param("fromDate") String fromDate, @Param("toDate") String toDate

	);

	@Query(value = """
			SELECT
			    c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME AS BRANCH_NAME, b.CODE AS BRANCH_CODE,
			    g.CGL, d.DESCRIPTION AS CGL_DESCRIPTION, g.NARRATION, g.TRANSACTION_DATE,
			    g.CURRENCY, SUM(g.DEBIT_AMOUNT) AS TOTAL_DEBIT, SUM(g.CREDIT_AMOUNT) AS TOTAL_CREDIT
			FROM GL_TRANSACTIONS g
			INNER JOIN BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
			LEFT JOIN CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
			LEFT JOIN CGL_MASTER d ON g.CGL = d.CGL_NUMBER
			WHERE g.TRANSACTION_DATE >= TO_DATE(:startDate,'DD/MM/YYYY')
			  AND g.TRANSACTION_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
			  AND g.CURRENCY =:currency
			  AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
			  AND (:v_branch IS NULL OR b.CODE = :v_branch)
			  AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
			GROUP BY c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, g.CGL, d.DESCRIPTION,
			         g.NARRATION, g.TRANSACTION_DATE, g.CURRENCY
			""", countQuery = """
			SELECT count(*) FROM (
			    SELECT g.CGL FROM GL_TRANSACTIONS g
			    INNER JOIN BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
			    LEFT JOIN CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
			    WHERE g.TRANSACTION_DATE >= TO_DATE(:startDate,'DD/MM/YYYY')
			      AND g.TRANSACTION_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
			      AND g.CURRENCY = :currency
			      AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
			      AND (:v_branch IS NULL OR b.CODE = :v_branch)
			      AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
			    GROUP BY c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, g.CGL,
			             g.NARRATION, g.TRANSACTION_DATE, g.CURRENCY
			)
			""", nativeQuery = true)
	Page<GlTransactionProjection> findGlTransactions(@Param("startDate") String start, @Param("endDate") String end,
			@Param("currency") String currency, @Param("v_circle") String circle, @Param("v_branch") String branch,
			@Param("v_cgl") String cgl, Pageable pageable);

	@Query(value = """
						SELECT
			            g.TRANSACTION_ID as transactionId, g.BATCH_ID as batchId, g.JOURNAL_ID as journalId,
			            g.TRANSACTION_DATE as transactionDate, g.POST_DATE as postDate,g.BRANCH_CODE as branchCode,
			            b.NAME AS branchName, b.CIRCLE_CODE as circleCode, cr.CIRCLE_NAME as circleName,
			            g.CURRENCY as currency, cu.CURRENCY_NAME as currencyName, g.CGL as cgl, c.DESCRIPTION as description,
			            g.NARRATION as narration,g.DEBIT_AMOUNT as debitAmount, g.CREDIT_AMOUNT as creditAmount,
			            g.TRANSACTION_COUNT as transactionCount, g.SOURCE_FLAG as sourceFlag
			        FROM gl_transactions g
			        JOIN branch_master b ON g.BRANCH_CODE = b.CODE
			        JOIN circle_master cr ON b.CIRCLE_CODE = cr.CIRCLE_CODE
			        LEFT JOIN cgl_master c ON c.CGL_NUMBER = g.CGL
			        LEFT JOIN currency_master cu ON g.CURRENCY = cu.CURRENCY_CODE
			        WHERE g.CGL = :cgl
			        AND (:skipSource = 1 OR g.SOURCE_FLAG IN :source)
			          AND (:currency IS NULL OR g.CURRENCY = :currency)
			          AND g.TRANSACTION_DATE BETWEEN TO_DATE(:fromDate, 'dd/MM/yyyy')
			      AND TO_DATE(:toDate, 'dd/MM/yyyy')
			      AND (:skipBranches = 1 OR g.BRANCH_CODE IN :branches)
			          AND (:circle IS NULL OR b.CIRCLE_CODE = :circle)
			""", countQuery = """
			select count(*) from gl_transactions g
			                    JOIN branch_master b ON g.BRANCH_CODE = b.CODE
			                    JOIN circle_master cr ON b.CIRCLE_CODE = cr.CIRCLE_CODE
			                    LEFT JOIN cgl_master c ON c.CGL_NUMBER = g.CGL
			                    LEFT JOIN currency_master cu ON g.CURRENCY = cu.CURRENCY_CODE
			                    WHERE g.CGL = :cgl
			                    AND (:skipSource = 1 OR g.SOURCE_FLAG IN :source)
			                      AND (:currency IS NULL OR g.CURRENCY = :currency)
			                      AND g.TRANSACTION_DATE BETWEEN TO_DATE(:fromDate, 'dd/MM/yyyy')
			                  AND TO_DATE(:toDate, 'dd/MM/yyyy')
			                  AND (:skipBranches = 1 OR g.BRANCH_CODE IN :branches)
			                      AND (:circle IS NULL OR b.CIRCLE_CODE = :circle)
			""", nativeQuery = true)
	Page<SearchProjection> getSearchList(@Param("cgl") String cgl, @Param("skipSource") int skipSource,
			@Param("source") List<String> source, @Param("currency") String currency,
			@Param("fromDate") String fromDate, @Param("toDate") String toDate, @Param("skipBranches") int skipBranches,
			@Param("branches") List<String> branches, @Param("circle") String circle, Pageable pageable);

	
	@Query(value = """
						SELECT
			            g.TRANSACTION_ID as transactionId, g.BATCH_ID as batchId, g.JOURNAL_ID as journalId,
			            g.TRANSACTION_DATE as transactionDate, g.POST_DATE as postDate,g.BRANCH_CODE as branchCode,
			            b.NAME AS branchName, b.CIRCLE_CODE as circleCode, cr.CIRCLE_NAME as circleName,
			            g.CURRENCY as currency, cu.CURRENCY_NAME as currencyName, g.CGL as cgl, c.DESCRIPTION as description,
			            g.NARRATION as narration,g.DEBIT_AMOUNT as debitAmount, g.CREDIT_AMOUNT as creditAmount,
			            nvl(g.TRANSACTION_COUNT,0) as transactionCount, g.SOURCE_FLAG as sourceFlag
			        FROM gl_transactions g
			        JOIN branch_master b ON g.BRANCH_CODE = b.CODE
			        JOIN circle_master cr ON b.CIRCLE_CODE = cr.CIRCLE_CODE
			        LEFT JOIN cgl_master c ON c.CGL_NUMBER = g.CGL
			        LEFT JOIN currency_master cu ON g.CURRENCY = cu.CURRENCY_CODE
			        WHERE g.CGL = :cgl
			        AND (:skipSource = 1 OR g.SOURCE_FLAG IN :source)
			          AND (:currency IS NULL OR g.CURRENCY = :currency)
			          AND g.TRANSACTION_DATE BETWEEN TO_DATE(:fromDate, 'dd/MM/yyyy')
			      AND TO_DATE(:toDate, 'dd/MM/yyyy')
			      AND (:skipBranches = 1 OR g.BRANCH_CODE IN :branches)
			          AND (:circle IS NULL OR b.CIRCLE_CODE = :circle)
			""", countQuery = """
			select count(*) from gl_transactions g
			                    JOIN branch_master b ON g.BRANCH_CODE = b.CODE
			                    JOIN circle_master cr ON b.CIRCLE_CODE = cr.CIRCLE_CODE
			                    LEFT JOIN cgl_master c ON c.CGL_NUMBER = g.CGL
			                    LEFT JOIN currency_master cu ON g.CURRENCY = cu.CURRENCY_CODE
			                    WHERE g.CGL = :cgl
			                    AND (:skipSource = 1 OR g.SOURCE_FLAG IN :source)
			                      AND (:currency IS NULL OR g.CURRENCY = :currency)
			                      AND g.TRANSACTION_DATE BETWEEN TO_DATE(:fromDate, 'dd/MM/yyyy')
			                  AND TO_DATE(:toDate, 'dd/MM/yyyy')
			                  AND (:skipBranches = 1 OR g.BRANCH_CODE IN :branches)
			                      AND (:circle IS NULL OR b.CIRCLE_CODE = :circle)
			""", nativeQuery = true)
	List<SearchProjection> getExportContent(@Param("cgl") String cgl, @Param("skipSource") int skipSource,
			@Param("source") List<String> source, @Param("currency") String currency,
			@Param("fromDate") String fromDate, @Param("toDate") String toDate, @Param("skipBranches") int skipBranches,
			@Param("branches") List<String> branches, @Param("circle") String circle);
}



