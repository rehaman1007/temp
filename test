import React, { useContext, useEffect, useState, useMemo } from "react";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { AuthContext } from "../context/AuthContext";
import { userAvatarCreator } from "../utils/userUtilities";

// MUI Icons
import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  Link as LinkIcon,
  ContentCopy,
  VisibilityOff,
  Home,
  Visibility,
  Check,
} from "@mui/icons-material";

// MUI Components
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Divider,
  Drawer,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  useTheme,
  useMediaQuery,
  Tooltip,
} from "@mui/material";

// --- Helper Functions ---
const formatCode = (code, length) => {
  if (code === undefined || code === null || code === "") return "N/A";
  return String(code).padStart(length, "0");
};

const maskPhoneNumber = (phone, isVisible) => {
  if (!phone) return "N/A";
  if (isVisible) return phone;
  const visibleDigits = phone.slice(-4);
  const maskedSection = "X".repeat(Math.max(0, phone.length - 4));
  return `${maskedSection}${visibleDigits}`;
};

// --- Reusable UI Component for Info Rows ---
const DetailRow = ({ icon: Icon, label, value }) => (
  <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
    <Icon sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }} />
    <Box>
      {label && (
        <Typography variant="caption" color="text.secondary" sx={{ display: "block" }}>
          {label}
        </Typography>
      )}
      <Typography variant="body2" sx={{ fontWeight: 500, lineHeight: 1.4 }}>
        {value}
      </Typography>
    </Box>
  </Box>
);

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);
  const theme = useTheme();
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));

  // States
  const [showPhone, setShowPhone] = useState(false);
  const [emailCopied, setEmailCopied] = useState(false);

  // Memoized Display Values
  const userName = useMemo(() => 
    [user?.firstName, user?.middleName, user?.lastName].filter(Boolean).join(" "),
  [user]);

  const branchDisplay = useMemo(() => 
    user?.branchName ? `${user.branchName} (${formatCode(user.branch, 5)})` : "N/A",
  [user?.branchName, user?.branch]);

  const circleDisplay = useMemo(() => 
    user?.circleName ? `${user.circleName} (${formatCode(user.circleCode, 3)})` : "N/A",
  [user?.circleName, user?.circleCode]);

  // Dynamically combine all available address fields into one string
  const combinedAddress = useMemo(() => {
    const parts = [
      user?.address,
      user?.city,
      user?.stateName,
      user?.pincode ? `PIN: ${user.pincode}` : null,
      user?.zoneName ? `(${user.zoneName} Zone)` : null,
      user?.nmrCode ? `[NMR: ${user.nmrCode}]` : null
    ].filter(Boolean); // removes any undefined/null/empty values automatically

    return parts.length > 0 ? parts.join(", ") : "N/A";
  }, [user]);

  // Handlers
  const handleCopyEmail = () => {
    if (user?.email) {
      navigator.clipboard.writeText(user.email);
      setEmailCopied(true);
      setTimeout(() => setEmailCopied(false), 2000);
    }
  };

  const closeDrawer = () => setProfileDrawerOpen(false);

  // Keyboard Shortcuts
  useEffect(() => {
    const handleKeyDown = (event) => {
      if (!isMobileOrTablet && event.altKey && event.key.toLowerCase() === "l") {
        event.preventDefault();
        logout();
      }
      if (event.key === "Escape" && profileDrawerOpen) {
        closeDrawer();
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, isMobileOrTablet]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={closeDrawer}
      sx={{
        "& .MuiDrawer-paper": {
          width: { xs: "85vw", sm: 380 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          p: 0,
          display: "flex",
          flexDirection: "column",
          backgroundColor: "#F8FAFC", 
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: { xs: 2, sm: 3 }, borderBottom: "1px solid #E2E8F0", backgroundColor: "#fff" }}>
        <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <Typography variant="h6" sx={{ fontWeight: 600 }}>Profile</Typography>
          <IconButton onClick={closeDrawer} size="small" edge="end">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Scrollable Content */}
      <Box sx={{ p: { xs: 2, sm: 3 }, overflowY: "auto", flex: 1 }}>
        
        {/* User Identity Section */}
        <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2, mb: 3 }}>
          <Avatar
            sx={{
              width: 72,
              height: 72,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "1.75rem",
              fontWeight: 600,
              boxShadow: theme.shadows[2],
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          
          <Box sx={{ flex: 1, minWidth: 0 }}>
            {/* Name & ID */}
            <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1.2, mb: 0.25 }} noWrap>
              {userName}
            </Typography>
            <Typography variant="body2" color="text.secondary" sx={{ mb: 1.5 }} noWrap>
              {user?.userId || "N/A"}
            </Typography>

            {/* Role & Access Information */}
            <Box sx={{ 
              backgroundColor: "#fff", 
              p: 1.5, 
              borderRadius: 2, 
              border: "1px solid #E2E8F0" 
            }}>
              {/* Role Info */}
              <Box sx={{ mb: 1 }}>
                <Typography variant="caption" sx={{ fontWeight: 700, color: "primary.main", display: "block" }}>
                  ROLE: {user?.roleName || "UNASSIGNED"}
                </Typography>
                {user?.roleDescription && (
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", mt: 0.25 }}>
                    {user.roleDescription}
                  </Typography>
                )}
              </Box>
              
              <Divider sx={{ my: 1 }} />
              
              {/* Access Info */}
              <Box>
                <Typography variant="caption" sx={{ fontWeight: 700, color: "secondary.main", display: "block" }}>
                  ACCESS: {user?.accessName || "UNASSIGNED"}
                </Typography>
                {user?.accessDescription && (
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", mt: 0.25 }}>
                    {user.accessDescription}
                  </Typography>
                )}
              </Box>
            </Box>
          </Box>
        </Box>

        {/* Service Information */}
        <Card sx={{ mb: 2, boxShadow: "none", border: "1px solid #E2E8F0" }}>
          <CardContent sx={{ p: 2, "&:last-child": { pb: 2 } }}>
            <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 700, mb: 2, fontSize: "0.7rem", letterSpacing: "1px" }}>
              SERVICE INFORMATION
            </Typography>
            <Stack spacing={2}>
              <DetailRow icon={Business} label="Branch" value={branchDisplay} />
              <DetailRow icon={AccountTree} label="Circle" value={circleDisplay} />
              <DetailRow icon={Home} label="Address & Location" value={combinedAddress} />
            </Stack>
          </CardContent>
        </Card>

        {/* Contact Information */}
        <Card sx={{ mb: 2, boxShadow: "none", border: "1px solid #E2E8F0" }}>
          <CardContent sx={{ p: 2, "&:last-child": { pb: 2 } }}>
            <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 700, mb: 1.5, fontSize: "0.7rem", letterSpacing: "1px" }}>
              CONTACT INFORMATION
            </Typography>
            <Stack spacing={2}>
              
              {/* Email Row */}
              <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 1.5 }}>
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5, overflow: "hidden" }}>
                  <Email sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box sx={{ minWidth: 0 }}>
                    <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>Email</Typography>
                    <Typography variant="body2" sx={{ wordBreak: "break-all" }}>{user?.email || "N/A"}</Typography>
                  </Box>
                </Box>
                <Tooltip title={emailCopied ? "Copied!" : "Copy Email"}>
                  <IconButton onClick={handleCopyEmail} size="small" sx={{ color: emailCopied ? "success.main" : "text.secondary" }}>
                    {emailCopied ? <Check fontSize="small" /> : <ContentCopy fontSize="small" />}
                  </IconButton>
                </Tooltip>
              </Box>

              {/* Phone Row */}
              <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                  <Phone sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box>
                    <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>Contact No</Typography>
                    <Typography variant="body2" sx={{ fontSize: "0.875rem", letterSpacing: "2px" }}>
                      {maskPhoneNumber(user?.phoneNumber, showPhone)}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title="Hold to reveal">
                  <IconButton
                    onMouseDown={() => setShowPhone(true)}
                    onMouseUp={() => setShowPhone(false)}
                    onMouseLeave={() => setShowPhone(false)}
                    onTouchStart={() => setShowPhone(true)}
                    onTouchEnd={() => setShowPhone(false)}
                    size="small"
                    sx={{ color: "text.secondary" }}
                  >
                    {showPhone ? <Visibility fontSize="small" /> : <VisibilityOff fontSize="small" />}
                  </IconButton>
                </Tooltip>
              </Box>

            </Stack>
          </CardContent>
        </Card>

        {/* Footer Actions */}
        <List sx={{ p: 0 }}>
          <ListItem disablePadding sx={{ mb: 0.5 }}>
            <ListItemButton
              onClick={() => { navigate("/help"); closeDrawer(); }}
              sx={{
                borderRadius: "8px",
                "&:hover": { backgroundColor: "action.hover", "& .help-icon": { transform: "translateX(5px)" } },
              }}
            >
              <ListItemIcon className="help-icon" sx={{ color: "primary.main", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <Help fontSize="small" />
              </ListItemIcon>
              <ListItemText primary={<Typography variant="body2" sx={{ fontWeight: 600 }}>Help & Support</Typography>} />
            </ListItemButton>
          </ListItem>

          <ListItem disablePadding sx={{ mb: 1 }}>
            <ListItemButton
              component="a"
              href="https://score.sbi/"
              target="_blank"
              rel="noopener noreferrer"
              sx={{
                borderRadius: "8px",
                "&:hover": { backgroundColor: (theme) => `${theme.palette.primary.main}14`, "& .connect-icon": { transform: "translateX(5px)" } },
              }}
            >
              <ListItemIcon className="connect-icon" sx={{ color: "primary.main", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <LinkIcon fontSize="small" />
              </ListItemIcon>
              <ListItemText primary={<Typography variant="body2" sx={{ fontWeight: 700 }}>Connect to SCORE</Typography>} />
            </ListItemButton>
          </ListItem>

          <Divider sx={{ my: 1 }} />

          <ListItem disablePadding sx={{ mt: 1 }}>
            <ListItemButton
              onClick={logout}
              sx={{
                borderRadius: "8px",
                color: "error.main",
                "&:hover": {
                  backgroundColor: (theme) => `${theme.palette.error.main}14`,
                  "& .logout-icon": { transform: "translateX(5px)" },
                  "& .shortcut-hint": { opacity: 1, backgroundColor: "error.main", color: "white" },
                },
              }}
            >
              <ListItemIcon className="logout-icon" sx={{ color: "error.main", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <Logout fontSize="small" />
              </ListItemIcon>
              <ListItemText primary={<Typography variant="body2" sx={{ fontWeight: 700 }}>Sign Out</Typography>} />
              {!isMobileOrTablet && (
                <Box
                  className="shortcut-hint"
                  sx={{
                    fontSize: "10px", fontWeight: 700, px: 1, py: 0.3,
                    borderRadius: "4px", border: "1px solid", borderColor: "divider",
                    opacity: 0.6, transition: "all 0.3s ease",
                  }}
                >
                  Alt + L
                </Box>
              )}
            </ListItemButton>
          </ListItem>
        </List>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
