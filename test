import { useState, useEffect, useMemo } from "react";
import {
  Box,
  Drawer,
  List,
  Typography,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Card,
  CardContent,
  Button,
  Chip,
} from "@mui/material";
import * as MuiIcons from "@mui/icons-material";
import { useNavigate, useLocation } from "react-router-dom";
import { useDispatch, useSelector } from "react-redux";
import f1Logo from "../../assets/Logos/Fincore_transperent.svg";
import { setSelectedMenuItem } from "../../app/menuSlice";

const drawerWidth = 240;

// ✅ Dynamic icon resolver
const getIconComponent = (iconName = "") => {
  if (!iconName) return <MuiIcons.HelpOutline />;

  const formattedName = iconName
    .split("_")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join("");

  const Icon = MuiIcons[formattedName];
  return Icon ? <Icon /> : <MuiIcons.HelpOutline />;
};

const SideBar = ({ onParentMenuClick }) => {
  const navigate = useNavigate();
  const location = useLocation();
  const dispatch = useDispatch();

  const menus = useSelector((state) => state.menus.items);
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);

  // ✅ Memoize menu list (prevents re-renders)
  const menuItems = useMemo(() => {
    if (!menus?.length) return [];
    return menus.filter(
      (item) =>
        !item.hasChildren ||
        (item.hasChildren && item.children && item.children.length > 0)
    );
  }, [menus]);

  // ✅ Sync selected menu with current path
  useEffect(() => {
    const matchedItem = menuItems.find(
      (item) => location.pathname === item.route
    );
    if (matchedItem) dispatch(setSelectedMenuItem(matchedItem));
  }, [location.pathname, menuItems, dispatch]);

  const navigateToPage = (item) => {
    if (item.hasChildren) {
      onParentMenuClick(item.children, item.route);
    } else {
      onParentMenuClick(null);
    }
    navigate(item.route);
    dispatch(setSelectedMenuItem(item));
  };

  return (
    <Box component="nav" sx={{ width: { md: drawerWidth }, flexShrink: { md: 0 } }}>
      <Drawer
        variant="permanent"
        sx={{
          display: { xs: "none", md: "block" },
          "& .MuiDrawer-paper": {
            width: drawerWidth,
            boxSizing: "border-box",
            backgroundColor: "#fafafa",
          },
        }}
        open
      >
        <Box sx={{ height: "100%", display: "flex", flexDirection: "column" }}>
          {/* Logo Section */}
          <Box
            sx={{
              p: 2,
              borderBottom: "1px solid #E2E8F0",
              display: "flex",
              alignItems: "center",
              gap: 2,
            }}
          >
            <img src={f1Logo} alt="Logo" width={50} height={50} />
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                FinCore
              </Typography>
              <Typography variant="caption" color="text.secondary">
                Empowering Data
              </Typography>
            </Box>
          </Box>

          {/* Menu List */}
          <List sx={{ flexGrow: 1, py: 1 }}>
            {menuItems.length ? (
              menuItems.map((item) => (
                <ListItem key={item.id} disablePadding>
                  <ListItemButton
                    selected={selectedMenuItem?.id === item.id}
                    onClick={() => navigateToPage(item)}
                  >
                    <ListItemIcon sx={{ minWidth: 40 }}>
                      {getIconComponent(item.icon)}
                    </ListItemIcon>
                    <ListItemText
                      primary={item.title}
                      primaryTypographyProps={{
                        fontWeight: selectedMenuItem?.id === item.id ? 600 : 400,
                        color:
                          selectedMenuItem?.id === item.id
                            ? "primary.main"
                            : "text.primary",
                      }}
                    />
                    {item.badge && (
                      <Chip
                        size="small"
                        label={item.badge}
                        sx={{
                          height: 20,
                          fontSize: "0.7rem",
                          backgroundColor: "secondary.main",
                          color: "white",
                        }}
                      />
                    )}
                  </ListItemButton>
                </ListItem>
              ))
            ) : (
              <Typography
                variant="body2"
                color="text.secondary"
                sx={{ textAlign: "center", mt: 3 }}
              >
                No menu available
              </Typography>
            )}
          </List>

          {/* Support Section */}
          <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
            <Card variant="outlined">
              <CardContent sx={{ p: 2 }}>
                <Typography variant="subtitle2" sx={{ fontWeight: 600, mb: 1 }}>
                  Need Help?
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                  Contact our support team
                </Typography>
                <Button size="small" variant="contained" fullWidth>
                  Connect to SCORE
                </Button>
              </CardContent>
            </Card>
          </Box>
        </Box>
      </Drawer>
    </Box>
  );
};

export default SideBar;