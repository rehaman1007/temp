                    value={details.description}
                    fullWidth
                    size="small"
                    multiline
                    minRows={2}
                    InputProps={{ readOnly: true }}
                  />
                </Grid>

                {/* Row 3 – Flags */}
                <Grid item xs={12} md={4}>
                  <Typography variant="caption" color="text.secondary">
                    Balance Compare Flag
                  </Typography>
                  <Stack direction="row" spacing={1} mt={0.5}>
                    <Chip
                      label="Include"
                      variant={
                        details.balanceCompareFlag === "INCLUDE"
                          ? "filled"
                          : "outlined"
                      }
                      color={
                        details.balanceCompareFlag === "INCLUDE"
                          ? "primary"
                          : "default"
                      }
                    />
                    <Chip
                      label="Exclude"
                      variant={
                        details.balanceCompareFlag === "EXCLUDE"
                          ? "filled"
                          : "outlined"
                      }
                      color={
                        details.balanceCompareFlag === "EXCLUDE"
                          ? "error"
                          : "default"
                      }
                    />
                  </Stack>
                </Grid>

                <Grid item xs={12} md={4}>
                  <Typography variant="caption" color="text.secondary">
                    Manual Posting Flag
                  </Typography>
                  <Stack direction="row" spacing={1} mt={0.5}>
                    <Chip
                      label="Allowed"
                      variant={
                        details.manualPostingFlag === "ALLOWED"
                          ? "filled"
                          : "outlined"
                      }
                      color={
                        details.manualPostingFlag === "ALLOWED"
                          ? "success"
                          : "default"
                      }
                    />
                    <Chip
                      label="Not Allowed"
                      variant={
                        details.manualPostingFlag === "NOT_ALLOWED"
                          ? "filled"
                          : "outlined"
                      }
                      color={
                        details.manualPostingFlag === "NOT_ALLOWED"
                          ? "error"
                          : "default"
                      }
                    />
                  </Stack>
                </Grid>

                <Grid item xs={12} md={4}>
                  <Typography variant="caption" color="text.secondary">
                    Balance Carry Forward
                  </Typography>
                  <Stack direction="row" spacing={1} mt={0.5}>
                    <Chip
                      label={details.balanceCarryForward ? "Enabled" : "Disabled"}
                      color={details.balanceCarryForward ? "primary" : "default"}
                      variant="filled"
                    />
                    <Typography variant="caption" color="text.secondary">
                      (Auto-enabled for Asset/Liability)
                    </Typography>
                  </Stack>
                </Grid>
              </Grid>
            )}
          </>
        )}
      </Card>
    </Box>
  );
}