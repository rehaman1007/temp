import {
  Stack,
  Grid,
  Typography,
  Box,
  Divider,
  Accordion,
  AccordionSummary,
  AccordionDetails,
} from "@mui/material";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import PlayCircleOutlineIcon from "@mui/icons-material/PlayCircleOutline";
import StopCircleOutlinedIcon from "@mui/icons-material/StopCircleOutlined";
import PersonOutlineIcon from "@mui/icons-material/PersonOutline";
import TimerOutlinedIcon from "@mui/icons-material/TimerOutlined";
import NotesOutlinedIcon from "@mui/icons-material/NotesOutlined";
import {
  formatDuration,
  toPascalKebabCase,
} from "../../../utils/CommonUtilities";
import { getIconComponent } from "../../../utils/IconUtils";

/* ================= REUSABLE INFO ITEM ================= */
const InfoItem = ({ icon, label, value }) =>
  value ? (
    <Stack
      direction="row"
      spacing={1.5}
      alignItems="flex-start"
      sx={{
        p: 2,
        borderRadius: 2,
        bgcolor: "background.paper",
        boxShadow: 1,
        height: "100%",
      }}
    >
      <Box sx={{ mt: "2px", color: "text.secondary" }}>{icon}</Box>
      <Stack spacing={0.3}>
        <Typography variant="caption" color="text.secondary">
          {label}
        </Typography>
        <Typography fontWeight={500}>{value}</Typography>
      </Stack>
    </Stack>
  ) : null;

/* ================= MAIN COMPONENT ================= */
const StageDetails = ({ stage }) => {
  if (!stage) return null;

  const remarks = stage.stageRemarks || "No Remarks";
  const charLimit = 100;
  const isLongRemarks = remarks.length > charLimit;

  const StageIcon = getIconComponent(stage?.stageIcon || "AccessTime");

  return (
    <Stack
      flex={2}
      p={2}
      spacing={3}
      sx={(theme) => ({
        backgroundColor: theme.palette.action.hover,
        borderLeft: `1px solid ${theme.palette.divider}`,
      })}
    >
      {/* ================= STAGE HEADER ================= */}
      <Stack direction="row" spacing={2} alignItems="center">
        <Box
          sx={{
            borderRadius: "50%",
            p: 1.5,
            bgcolor: "rgba(97, 134, 190, 0.12)",
            display: "flex",
          }}
        >
          <StageIcon
            sx={{
              height: 50,
              width: 50,
              transition: "transform 0.3s ease-in-out",
              "&:hover": {
                transform: "translateY(-5px)",
              },
            }}
          />
        </Box>

        <Stack>
          <Typography variant="subtitle2" color="text.secondary">
            Stage
          </Typography>
          <Typography variant="h6" fontWeight={600}>
            {stage.stageTitle || "Unknown"}
          </Typography>
        </Stack>
      </Stack>

      <Divider />

      {/* ================= ROW 2: START / END ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PlayCircleOutlineIcon fontSize="small" />}
            label="Start Time"
            value={stage.startTime}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<StopCircleOutlinedIcon fontSize="small" />}
            label="End Time"
            value={stage.endTime}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 3: TRIGGERED / DURATION ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PersonOutlineIcon fontSize="small" />}
            label="Triggered By"
            value={toPascalKebabCase(stage.stageSource) || "N/A"}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<TimerOutlinedIcon fontSize="small" />}
            label="Time Taken"
            value={formatDuration(stage._START_TIME_RAW, stage._END_TIME_RAW)}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 4: REMARKS ================= */}
      {isLongRemarks ? (
        <Stack>
          <Accordion
            elevation={0}
            sx={{
              p: 2.5,
              borderColor: "divider",
              borderRadius: 2,
              bgcolor: "background.paper",
              "&:before": { display: "none" },
              boxShadow: 1,
              mb: 1,
            }}
          >
            <AccordionSummary
              expandIcon={isLongRemarks ? <ExpandMoreIcon /> : null}
            >
              <Stack direction="row" spacing={1} alignItems="center">
                <NotesOutlinedIcon fontSize="small" color="action" />
                <Typography variant="subtitle2" color="text.secondary">
                  Remarks
                </Typography>
              </Stack>
            </AccordionSummary>

            <AccordionDetails>
              <Typography>{remarks}</Typography>
            </AccordionDetails>
          </Accordion>
        </Stack>
      ) : (
        <Stack
          spacing={1}
          sx={{
            p: 2.5,
            borderRadius: 2,
            bgcolor: "background.paper",
            boxShadow: 1,
          }}
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <NotesOutlinedIcon fontSize="small" color="action" />
            <Typography variant="subtitle2" color="text.secondary">
              Remarks
            </Typography>
          </Stack>

          <Typography>{stage.stageRemarks || ""}</Typography>
        </Stack>
      )}
    </Stack>
  );
};

export default StageDetails;
