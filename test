import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  TextField,
  Typography,
} from "@mui/material";
import Grid from "@mui/material/Unstable_Grid2"; // <--- Grid2
import useApi from "../../hooks/useApi";

// ICONS
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import NoteIcon from "@mui/icons-material/Note";
import CustomChip from "../../utils/CustomChip";

// Classification lookup
const ACCOUNT_CLASSIFICATIONS = {
  A: { label: "Asset", icon: <DatasetIcon fontSize="small" />, color: "primary" },
  L: { label: "Liability", icon: <AccountBalanceWalletIcon fontSize="small" />, color: "warning" },
  I: { label: "Income", icon: <TrendingUpIcon fontSize="small" />, color: "success" },
  E: { label: "Expense", icon: <TrendingDownIcon fontSize="small" />, color: "error" },
  M: { label: "Memo A/c", icon: <NoteIcon fontSize="small" />, color: "info" },
};

export default function CglView() {
  const { callApi } = useApi();

  const [searchText, setSearchText] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search ----
  useEffect(() => {
    const text = searchText.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    let cancelled = false;

    const fetch = async () => {
      try {
        setLoading(true);
        const res = await callApi(
          "/CM/cglWithSegment",
          { cglNumb: text, cglDesc: text },
          "GET"
        );
        if (!cancelled) setOptions(res?.data?.data || []);
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    fetch();
    return () => (cancelled = true);
  }, [searchText, callApi]);

  const classification = selected ? ACCOUNT_CLASSIFICATIONS[selected.acClassification] : null;

  return (
    <Box sx={{ p: 3, display: "flex", flexDirection: "column", alignItems: "center" }}>
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* SEARCH */}
      <Box sx={{ width: "75%", maxWidth: 1000, mb: 3 }}>
        <Autocomplete
          fullWidth
          value={selected}
          loading={loading}
          options={options}
          onChange={(_, v) => setSelected(v)}
          inputValue={searchText}
          onInputChange={(_, v) => setSearchText(v)}
          getOptionLabel={(o) => (o ? `${o.cglNumber} - ${o.description}` : "")}
          noOptionsText={searchText.length < 3 ? "Type at least 3 characters..." : "No results found"}
          renderInput={(params) => (
            <TextField
              {...params}
              label="Search by Number or Description"
              placeholder="Start typing..."
              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <>
                    {loading && <CircularProgress size={18} />}
                    {params.InputProps.endAdornment}
                  </>
                ),
              }}
            />
          )}
        />
      </Box>

      {/* DETAILS */}
      <Card sx={{ width: "75%", maxWidth: 1000, p: 3 }}>
        {!selected ? (
          <Typography sx={{ color: "gray" }}>No record selected</Typography>
        ) : (
          <Grid container spacing={3}>

            {/* ROW 1 */}
            <Grid size={{ xs: 12, sm: 6, md: 4 }}>
              <Typography variant="subtitle2" sx={{ fontWeight: 700, color: "text.secondary" }}>
                CGL Number
              </Typography>
              <Typography variant="h6" sx={{ fontWeight: 600 }}>{selected.cglNumber}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 5 }}>
              <Typography variant="subtitle2" sx={{ fontWeight: 700, color: "text.secondary" }}>
                CGL Description
              </Typography>
              <Typography variant="h6" sx={{ fontWeight: 600 }}>{selected.description}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 12, md: 3 }} display="flex" alignItems="center">
              {classification && (
                <CustomChip
                  label={classification.label}
                  icon={classification.icon}
                  color={classification.color}
                />
              )}
            </Grid>

            {/* ROW 2 */}
            <Grid size={{ xs: 12, sm: 6, md: 3 }}>
              <Typography fontWeight={600}>Comp1</Typography>
              <Typography>{selected.comp1}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 6 }}>
              <Typography fontWeight={600}>Segment</Typography>
              <Typography>
                {selected.segmentCode} {selected.segmentDescription ? `- ${selected.segmentDescription}` : ""}
              </Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 3 }}>
              <Typography fontWeight={600}>Comp2</Typography>
              <Typography>{selected.comp2}</Typography>
            </Grid>

            {/* ROW 3 */}
            <Grid size={{ xs: 12, sm: 6, md: 4 }}>
              <Typography fontWeight={600}>Balance Compare</Typography>
              <Typography>{selected.balcompare === 1 ? "Include" : "Exclude"}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 4 }}>
              <Typography fontWeight={600}>Manual Posting</Typography>
              <Typography>{selected.manualPosting === 1 ? "Allowed" : "Not Allowed"}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 4 }}>
              <Typography fontWeight={600}>Balance Forward</Typography>
              <Typography>{selected.balFwd === 1 ? "Yes" : "No"}</Typography>
            </Grid>

            {/* ROW 4 */}
            <Grid size={{ xs: 12, sm: 6, md: 6 }}>
              <Typography fontWeight={600}>Open Date</Typography>
              <Typography>{selected.openDate || "-"}</Typography>
            </Grid>

            <Grid size={{ xs: 12, sm: 6, md: 6 }}>
              <Typography fontWeight={600}>Close Date</Typography>
              <Typography>{selected.closeDate || "-"}</Typography>
            </Grid>
          </Grid>
        )}
      </Card>
    </Box>
  );
}