import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  TextField,
  Typography,
  Grid,
  Stack,
  Divider,
} from "@mui/material";
import useApi from "../../hooks/useApi";

// ICONS
import InfoIcon from "@mui/icons-material/Info";
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import LocalDiningIcon from "@mui/icons-material/LocalDining";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import CancelIcon from "@mui/icons-material/Cancel";
import EmailOutlinedIcon from "@mui/icons-material/EmailOutlined";
import PhoneEnabledOutlinedIcon from "@mui/icons-material/PhoneEnabledOutlined";
import FmdGoodOutlinedIcon from "@mui/icons-material/FmdGoodOutlined";
import CalendarMonthOutlinedIcon from "@mui/icons-material/CalendarMonthOutlined";
import LanOutlinedIcon from "@mui/icons-material/LanOutlined";
import ComputerOutlinedIcon from "@mui/icons-material/ComputerOutlined";
import EditNoteOutlinedIcon from "@mui/icons-material/EditNoteOutlined";

import CustomChip from "../../utils/CustomChip";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import dayjs from "dayjs";
import customParseFormat from "dayjs/plugin/customParseFormat";
import advancedFormat from "dayjs/plugin/advancedFormat";

dayjs.extend(customParseFormat);
dayjs.extend(advancedFormat);

const formatDateDayjs = (dateString) => {
  if (!dateString) return "NA";

  const dayjsObject = dayjs(dateString, "DD/MM/YYYY");
  if (!dayjsObject.isValid()) return "NA";

  return dayjsObject.format("Do MMMM, YYYY");
};

export default function CglView() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // separate UI input value vs. "search" value that triggers API
  const [inputValue, setInputValue] = useState("");
  const [searchValue, setSearchValue] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search only when user is typing (reason === 'input') ----
  useEffect(() => {
    const text = searchValue.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    const fetch = async () => {
      try {
        setLoading(true);
        const res = await callApi(
          "/CM/viewBranch",
          { branchCodeOrName: text },
          "GET"
        );
        setOptions(res?.data || []);
      } catch (error) {
        console.log("Something went wrong while fetching Branch", error);
        showSnackBar(
          "Something went wrong while fetching Branch's, Kindly try again after sometime",
          "warning"
        );
      } finally {
        setLoading(false);
      }
    };

    fetch();
  }, [searchValue, callApi, showSnackBar]);

  const handleInputChange = (_, value, reason) => {
    // always keep UI text in sync
    setInputValue(value);

    if (reason === "input") {
      // user is typing -> trigger API via searchValue
      setSearchValue(value);
    } else if (reason === "clear") {
      // cleared -> reset options and search value
      setSearchValue("");
      setOptions([]);
    }
    // IMPORTANT:
    // reason === "reset" happens when an option is selected.
    // We do NOT change searchValue in that case, so API is NOT triggered again.
  };

  const handleChange = (_, newValue) => {
    setSelected(newValue);
  };

  const formatAddressString = (selectedBranch) => {
    const parts = [];

    if (selectedBranch?.address) {
      parts.push(selectedBranch.address.trim());
    }
    if (selectedBranch?.branchCity) {
      parts.push(selectedBranch.branchCity.trim());
    }
    if (selectedBranch?.pinCode) {
      parts.push(selectedBranch.pinCode.trim());
    }
    const finalString = parts.join(", ");
    return finalString || "NA";
  };

  return (
    <Box
      sx={{
        p: 3,
        display: "flex",
        justifyContent: "center",
      }}
    >
      <Box sx={{ width: "100%", maxWidth: 1200 }}>
        {/* PAGE HEADING */}
        <Box sx={{ mb: 2 }}>
          <Typography variant="h5" sx={{ fontWeight: 700, mb: 0.5 }}>
            Branch Master Lookup
          </Typography>
          <Typography variant="body1" color="text.secondary">
            Search Branch by number or its name and view key account details in
            a clean, readable layout.
          </Typography>
        </Box>

        {/* SEARCH CARD */}
        <Card
          sx={{
            p: 2.5,
            mb: 3,
            display: "flex",
            flexDirection: "column",
            gap: 1,
          }}
        >
          <Typography
            variant="h5"
            sx={{ fontWeight: 600, color: "text.secondary", mb: 0.5 }}
          >
            Search Branch
          </Typography>
          <Autocomplete
            fullWidth
            value={selected}
            loading={loading}
            options={options}
            onChange={handleChange}
            inputValue={inputValue}
            onInputChange={handleInputChange}
            getOptionLabel={(o) =>
              o ? `${o.branchCode} - ${o.branchName}` : ""
            }
            noOptionsText={
              inputValue.trim().length < 3
                ? "Type at least 3 characters..."
                : "No Branch's found for given input"
            }
            slotProps={{
              paper: {
                elevation: 3,
              },
              popper: {
                sx: {
                  zIndex: (theme) => theme.zIndex.modal + 1,
                },
              },
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                label="Search Branch by Number or Description"
                placeholder="e.g. 12345 or abcd"
                size="small"
                // maxLength 50 for autocomplete input
                inputProps={{
                  ...params.inputProps,
                  maxLength: 50,
                }}
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
                    <>
                      {loading && <CircularProgress size={18} />}
                      {params.InputProps.endAdornment}
                    </>
                  ),
                }}
              />
            )}
          />
        </Card>

        {/* DETAILS CARD */}
        <Card sx={{ p: 3 }}>
          {!selected ? (
            <Box
              display="flex"
              alignItems="center"
              justifyContent="center"
              sx={{ minHeight: 220 }}
            >
              <Stack
                height="100%"
                alignItems="center"
                justifyContent="center"
                spacing={1.5}
              >
                <InfoIcon
                  sx={{ fontSize: 40, color: "text.secondary", mb: 0.5 }}
                />
                <Typography variant="subtitle1">
                  No Branch selected yet
                </Typography>
                <Typography
                  variant="body1"
                  color="text.secondary"
                  textAlign="center"
                >
                  Start typing in the search box above and pick a Branch to view
                  its complete details.
                </Typography>
              </Stack>
            </Box>
          ) : (
            <Box>
              <Box
                sx={{
                  mb: 2,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  flexWrap: "wrap",
                  gap: 1,
                }}
              >
                <Box>
                  <Typography
                    variant="h6"
                    sx={{ fontWeight: 700, mb: 0.5, letterSpacing: 0.2 }}
                  >
                    Branch Details
                  </Typography>
                  <Typography variant="body1" color="text.secondary">
                    {selected.branchCode} — {selected.branchName}
                  </Typography>
                </Box>

                {/* Branch Active / Inactive with icon */}
                <CustomChip
                  label={selected.status === true ? "Active" : "Inactive"}
                  variant="outlined"
                  color={selected.status === true ? "success" : "error"}
                  icon={
                    selected.status === true ? (
                      <CheckCircleIcon fontSize="small" />
                    ) : (
                      <CancelIcon fontSize="small" />
                    )
                  }
                />
              </Box>

              <Divider sx={{ mb: 2 }} />

              <Grid container spacing={3}>
                {/* ROW 1 */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Number
                  </Typography>
                  <Typography variant="body1" sx={{ fontWeight: 600 }}>
                    {selected.branchCode}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Name
                  </Typography>
                  <Typography variant="body1">{selected.branchName}</Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Circle
                  </Typography>
                  <Typography variant="body1">
                    {selected.circleCode || "—"}{" "}
                    {selected.circleName ? `- ${selected.circleName}` : ""}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch State
                  </Typography>
                  <Typography variant="body1">
                    {selected.stateCode || "—"}{" "}
                    {selected.stateName ? `- ${selected.stateName}` : ""}
                  </Typography>
                </Grid>

                {/* ROW 2 */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    NMR Code
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.nmrCode || "NA"}
                      color="default"
                      variant="outlined"
                      icon={<DatasetIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch mail
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.emailId || "NA"}
                      color="default"
                      variant="outlined"
                      icon={<EmailOutlinedIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Phone
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.phoneNumber || "NA"}
                      color="default"
                      variant="outlined"
                      icon={<PhoneEnabledOutlinedIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Status
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.status === true ? "Active" : "Inactive"}
                      color={selected.status === true ? "success" : "error"}
                      variant="outlined"
                      icon={
                        selected.status === true ? (
                          <CheckCircleIcon fontSize="small" />
                        ) : (
                          <CancelIcon fontSize="small" />
                        )
                      }
                    />
                  </Box>
                </Grid>

                {/* ROW 3 */}
                <Grid size={{ xs: 12, sm: 6, md: 12 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Address
                  </Typography>
                  <Box sx={{ mt: 0.5, display: "flex", alignItems: "center" }}>
                    <FmdGoodOutlinedIcon
                      fontSize="small"
                      sx={{ mr: 0.5, color: "text.secondary" }}
                    />
                    <Typography variant="body1">
                      {formatAddressString(selected)}
                    </Typography>
                  </Box>
                </Grid>

                {/* ROW 4 - Dates & merge info */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Open Date
                  </Typography>
                  <Box sx={{ mt: 0.5, display: "flex", alignItems: "center" }}>
                    <CalendarMonthOutlinedIcon
                      fontSize="small"
                      sx={{ mr: 0.5, color: "text.secondary" }}
                    />
                    <Typography variant="body1">
                      {formatDateDayjs(selected.openDate)}
                    </Typography>
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Close Date
                  </Typography>
                  <Box sx={{ mt: 0.5, display: "flex", alignItems: "center" }}>
                    <CalendarMonthOutlinedIcon
                      fontSize="small"
                      sx={{ mr: 0.5, color: "text.secondary" }}
                    />
                    <Typography variant="body1">
                      {formatDateDayjs(selected.closeDate)}
                    </Typography>
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Merged with
                  </Typography>
                  <Box sx={{ mt: 0.5, display: "flex", alignItems: "center" }}>
                    <LanOutlinedIcon
                      fontSize="small"
                      sx={{ mr: 0.5, color: "text.secondary" }}
                    />
                    <Typography variant="body1">
                      {selected.mergedWithBranch || "NA"}
                    </Typography>
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Merge Date
                  </Typography>
                  <Box sx={{ mt: 0.5, display: "flex", alignItems: "center" }}>
                    <CalendarMonthOutlinedIcon
                      fontSize="small"
                      sx={{ mr: 0.5, color: "text.secondary" }}
                    />
                    <Typography variant="body1">
                      {formatDateDayjs(selected.mergeDate)}
                    </Typography>
                  </Box>
                </Grid>

                {/* ROW 5 - Flags as chips with icons */}
                <Grid size={{ xs: 6, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch CPC
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.cpcFlag || "NA"}
                      color="default"
                      variant="outlined"
                      icon={<AccountBalanceWalletIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 6, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Food Credit
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.foodCreditFlag ? "Yes" : "No"}
                      color={selected.foodCreditFlag ? "success" : "default"}
                      variant="outlined"
                      icon={<LocalDiningIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch currChest
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.currChestFlag ? "Yes" : "No"}
                      color={selected.currChestFlag ? "success" : "default"}
                      variant="outlined"
                      icon={<AccountBalanceIcon fontSize="small" />}
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Type
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={
                        selected.branchType === "A" ? "Automated" : "Manual"
                      }
                      color="default"
                      variant="outlined"
                      icon={
                        selected.branchType === "A" ? (
                          <ComputerOutlinedIcon fontSize="small" />
                        ) : (
                          <EditNoteOutlinedIcon fontSize="small" />
                        )
                      }
                    />
                  </Box>
                </Grid>
              </Grid>
            </Box>
          )}
        </Card>
      </Box>
    </Box>
  );
}