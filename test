CREATE SEQUENCE ADMIN_SUPPORT_LOG_SEQ
START WITH 1
INCREMENT BY 1
NOCACHE
NOCYCLE;

CREATE TABLE ADMIN_SUPPORT_LOG (

    ID NUMBER PRIMARY KEY,

    JOB_ID VARCHAR2(200),

    USER_ID VARCHAR2(100),

    CLIENT_IP VARCHAR2(100),

    FILE_NAME VARCHAR2(1000),

    EXECUTION_TYPE VARCHAR2(100),

    STATUS VARCHAR2(50),

    TOTAL_STATEMENTS NUMBER,

    EXECUTED_COUNT NUMBER,

    INSERT_COUNT NUMBER,

    UPDATE_COUNT NUMBER,

    DELETE_COUNT NUMBER,

    OTHER_COUNT NUMBER,

    FAILED_STATEMENT_NUMBER NUMBER,

    FAILED_SQL CLOB,

    EXCEPTION_TYPE VARCHAR2(1000),

    EXCEPTION_MESSAGE CLOB,

    EXECUTION_SPEED NUMBER,

    ELAPSED_SECONDS NUMBER,

    STARTED_AT TIMESTAMP,

    COMPLETED_AT TIMESTAMP,

    CREATED_AT TIMESTAMP DEFAULT SYSTIMESTAMP
);


