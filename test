import React, {
  createContext,
  useEffect,
  useRef,
  useCallback,
  useState,
} from "react";
import { useDispatch, useSelector } from "react-redux";
import { throttle } from "lodash";
import SessionDialog from "../components/SessionDialog";
import SessionWarningDialog from "../components/SessionWarningDialog";
import { logoutSuccess } from "../store/slices/authSlice";
import api from "../config/axiosConfig";
import { resolveConfig } from "../config/EnvironmentConfig";

export const AuthContext = createContext();

// CONFIGURATION
const INACTIVITY_LIMIT_MS = 5 * 60 * 1000; // 5 Minutes total
const WARNING_DURATION_MS = 30 * 1000;     // Warning at last 30 seconds
const CHECK_INTERVAL_MS = 1000;            // Check every second

export const AuthProvider = ({ children }) => {
  const dispatch = useDispatch();
  const isAuthenticated = useSelector((state) => state.auth.isAuthenticated);

  // UI State
  const [warningOpen, setWarningOpen] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(WARNING_DURATION_MS / 1000);
  const [sessionDialogOpen, setSessionDialogOpen] = useState(false);
  const [sessionReason, setSessionReason] = useState("");

  // Refs for logic (Timestamp based to prevent drift)
  const logoutTimeRef = useRef(Date.now() + INACTIVITY_LIMIT_MS);
  const intervalIdRef = useRef(null);

  // --- 1. Core Logout Function ---
  const performLogout = useCallback(
    async (reason = "USER_INITIATED") => {
      if (intervalIdRef.current) clearInterval(intervalIdRef.current);

      if (reason !== "USER_INITIATED") {
        setSessionReason(reason);
        setSessionDialogOpen(true);
      }

      try {
        await api.post(`${resolveConfig("/LS")}/auth/logout`);
      } catch (err) {
        console.error("Logout API failed", err);
      } finally {
        localStorage.clear();
        dispatch(logoutSuccess());
        setWarningOpen(false);
      }
    },
    [dispatch]
  );

  // --- 2. The Heartbeat Timer ---
  const checkTimer = useCallback(() => {
    const now = Date.now();
    const timeRemaining = logoutTimeRef.current - now;

    // A. Time is up -> Logout
    if (timeRemaining <= 0) {
      if (intervalIdRef.current) clearInterval(intervalIdRef.current);
      setWarningOpen(false);
      performLogout("SESSION_EXPIRED");
      return;
    }

    // B. Inside Warning Zone -> Show Dialog
    if (timeRemaining <= WARNING_DURATION_MS) {
      // Ensure dialog is open
      setWarningOpen(true);
      // Update countdown UI
      setSecondsLeft(Math.ceil(timeRemaining / 1000));
    } else {
      // C. Safe Zone -> Ensure dialog is closed
      if (warningOpen) setWarningOpen(false);
    }
  }, [performLogout, warningOpen]);

  // --- 3. Start/Reset Logic ---
  // This is called by the "Continue" button to force a full reset
  const startInactivityTimer = useCallback(() => {
    if (!isAuthenticated) return;

    // Reset the target logout time to (Now + 5 mins)
    logoutTimeRef.current = Date.now() + INACTIVITY_LIMIT_MS;

    // If interval isn't running, start it
    if (!intervalIdRef.current) {
      intervalIdRef.current = setInterval(checkTimer, CHECK_INTERVAL_MS);
    }
    
    // Immediate UI update to hide warning
    setWarningOpen(false);
  }, [isAuthenticated, checkTimer]);

  // --- 4. User Activity Listener (Passive) ---
  const onActivity = useCallback(
    throttle(() => {
      if (!isAuthenticated || sessionDialogOpen) return;

      const timeLeft = logoutTimeRef.current - Date.now();
      
      // CRITICAL LOGIC CHANGE:
      // If we are currently in the "Warning Zone" (<= 30s), 
      // IGNORE mouse/keyboard events. User MUST click the button.
      if (timeLeft <= WARNING_DURATION_MS) {
        return; 
      }

      // If we are in the safe zone (e.g., 4 mins left), 
      // these events quietly reset the timer to full.
      startInactivityTimer();
    }, 1000), 
    [isAuthenticated, sessionDialogOpen, startInactivityTimer]
  );

  // --- 5. Event Binding ---
  useEffect(() => {
    if (isAuthenticated) {
      startInactivityTimer();
      const events = ["mousemove", "keydown", "click", "scroll", "touchstart"];
      events.forEach((e) => window.addEventListener(e, onActivity));

      return () => {
        events.forEach((e) => window.removeEventListener(e, onActivity));
        onActivity.cancel();
        if (intervalIdRef.current) clearInterval(intervalIdRef.current);
      };
    } else {
      if (intervalIdRef.current) clearInterval(intervalIdRef.current);
      intervalIdRef.current = null;
      setWarningOpen(false);
    }
  }, [isAuthenticated, onActivity, startInactivityTimer]);

  // --- 6. Cross-tab Logout Handler ---
  useEffect(() => {
    const handleSessionEvent = (e) => {
      performLogout(e.detail?.reason || "SESSION_EXPIRED");
    };
    window.addEventListener("auth:session-expired", handleSessionEvent);
    return () =>
      window.removeEventListener("auth:session-expired", handleSessionEvent);
  }, [performLogout]);

  return (
    <AuthContext.Provider
      value={{
        logout: () => performLogout("USER_INITIATED"),
        triggerSessionDialog: (reason) => performLogout(reason),
      }}
    >
      {children}

      <SessionWarningDialog
        open={warningOpen}
        secondsLeft={secondsLeft}
        totalWarningSeconds={WARNING_DURATION_MS / 1000}
        onContinue={startInactivityTimer}
      />

      <SessionDialog
        open={sessionDialogOpen}
        reason={sessionReason}
        onConfirm={() => setSessionDialogOpen(false)}
      />
    </AuthContext.Provider>
  );
};


import React from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  LinearProgress,
  Stack,
  Box,
} from "@mui/material";
import WarningAmberRoundedIcon from "@mui/icons-material/WarningAmberRounded";

const SessionWarningDialog = ({ 
  open, 
  secondsLeft, 
  totalWarningSeconds = 30, 
  onContinue 
}) => {
  if (!open) return null;

  const progressNormal = (secondsLeft / totalWarningSeconds) * 100;

  return (
    <Dialog
      open={open}
      fullWidth
      maxWidth="xs"
      // Prevent closing by clicking backdrop or pressing escape
      disableEscapeKeyDown
      onClose={(event, reason) => {
        if (reason !== "backdropClick") {
           // Optional: handle specific close reasons if needed
        }
      }}
      PaperProps={{
        sx: { 
          borderRadius: 3, 
          padding: 1,
          boxShadow: 24 
        },
      }}
    >
      <DialogTitle sx={{ textAlign: "center", pb: 0 }}>
        <Box
          sx={{
            display: "inline-flex",
            p: 1.5,
            borderRadius: "50%",
            bgcolor: "warning.light",
            color: "warning.dark",
            mb: 1,
          }}
        >
          <WarningAmberRoundedIcon fontSize="large" />
        </Box>
        <Typography variant="h6" component="div" fontWeight="bold">
          Session Expiring
        </Typography>
      </DialogTitle>

      <DialogContent sx={{ textAlign: "center", pb: 3 }}>
        <Typography variant="body1" color="text.secondary" sx={{ mb: 2 }}>
          You have been inactive for a while. You will be logged out automatically.
        </Typography>

        <Box sx={{ position: "relative", display: "inline-flex", mb: 2 }}>
          <Typography
            variant="h2"
            fontWeight={800}
            color="warning.main"
          >
            {secondsLeft}
          </Typography>
          <Typography 
            variant="h6" 
            component="span" 
            color="text.secondary" 
            sx={{ alignSelf: 'flex-end', mb: 1.5, ml: 0.5 }}
          >
            s
          </Typography>
        </Box>

        <Stack spacing={1} width="100%">
          <LinearProgress
            variant="determinate"
            value={Math.max(0, Math.min(progressNormal, 100))}
            color="warning"
            sx={{ 
              height: 10, 
              borderRadius: 5,
              backgroundColor: "action.hover" 
            }}
          />
          <Typography variant="caption" color="error.main" fontWeight="bold">
            Action Required: Click below to stay signed in
          </Typography>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ justifyContent: "center", pb: 2 }}>
        <Button 
          variant="contained" 
          color="warning" 
          onClick={onContinue}
          size="large"
          sx={{ borderRadius: 2, px: 4, fontWeight: "bold" }}
        >
          I'm still here
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default SessionWarningDialog;
