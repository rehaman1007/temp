/**
 * Dynamically generate proxy config for Vite
 */
const generateProxyConfig = (services) => {
  const proxyConfig = {};
  Object.values(services).forEach(({ alias, host, port }) => {
    proxyConfig[alias] = {
      target: `${host}:${port}`,
      changeOrigin: true,
      secure: false,
      rewrite: (path) => path.replace(new RegExp(`^${alias}`), ""),
      configure: (proxy) => {
        proxy.on("proxyReq", (proxyReq, req) => {
          const clientIp =
            req.headers["x-forwarded-for"] || req.socket.remoteAddress;
          if (clientIp) {
            proxyReq.setHeader("X-Forwarded-For", clientIp);
            proxyReq.setHeader("X-Real-IP", clientIp);
          }
        });
      },
    };
  });
  return proxyConfig;
};

