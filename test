import React, { useState, useRef, useEffect } from "react";
import axios from "axios";
import { Box } from "@mui/material";
import { StyledTextField, PrimaryButton } from "./LoginStyles";

const OtpVerification = ({
  userId,
  otpTxnId,
  loginPayload,
  openLoginErrorDialog,
}) => {
  const [otp, setOtp] = useState("");
  const [loading, setLoading] = useState(false);

  const otpRef = useRef(null);

  useEffect(() => {
    otpRef.current?.focus();
  }, []);

  const verifyOtp = async () => {
    if (!otp) {
      return;
    }

    try {
      setLoading(true);

      const response = await axios.post(
        "/api/auth/validate-otp",
        {
          userId,
          otp,
          otpTxnId,
        }
      );

      const result = response.data;

      if (result.success) {
        loginPayload();
      } else {
        openLoginErrorDialog(
          "OTP Verification Failed",
          "Invalid OTP"
        );
      }
    } catch (err) {
      openLoginErrorDialog(
        "OTP Verification Failed",
        "Unable to validate OTP"
      );
    } finally {
      setLoading(false);
    }
  };

  const resendOtp = async () => {
    try {
      await axios.post("/api/auth/send-otp", {
        userId,
      });

      openLoginErrorDialog(
        "OTP Sent",
        "A new OTP has been sent"
      );
    } catch (err) {
      openLoginErrorDialog(
        "Failed",
        "Unable to resend OTP"
      );
    }
  };

  return (
    <>
      <StyledTextField
        fullWidth
        label="Enter OTP"
        inputRef={otpRef}
        value={otp}
        onChange={(e) => setOtp(e.target.value)}
      />

      <PrimaryButton
        fullWidth
        onClick={verifyOtp}
        disabled={loading}
      >
        {loading ? "Verifying..." : "Verify OTP"}
      </PrimaryButton>

      <PrimaryButton
        fullWidth
        variant="outlined"
        onClick={resendOtp}
      >
        Resend OTP
      </PrimaryButton>
    </>
  );
};

export default OtpVerification;


const completeLogin = (result) => {
  const user = parseJwt(result.accessToken);

  const tabId = crypto.randomUUID();

  dispatch(
    loginSuccess({
      token: result.accessToken,
      user,
    })
  );

  localStorage.setItem(
    "payloadEncryptionKey",
    result.payloadEncryptionKey
  );

  dispatch(setTabId(tabId));
  dispatch(setMenus(result.roleData.root_menus));
  dispatch(setSelectedMenuItem(result.roleData.root_menus[0]));

  const bc = new BroadcastChannel("auth");

  setTimeout(() => {
    bc.postMessage({
      type: "USER_LOGGED_IN",
      tabId,
      userId: user.userId,
    });
  }, 1000);
};


const LoginWithPassword = ({
  userId,
