package com.fincore.enquiry_service.service.export;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.enquiry_service.dto.GetPayloadDTO;
import com.fincore.enquiry_service.dto.MyDownloadsRequestDTO;
import com.fincore.enquiry_service.dto.SearchCriteriaDTO;
import com.fincore.enquiry_service.exception.ExportGenerationException;
import com.fincore.enquiry_service.model.GLBalance;
import com.fincore.enquiry_service.service.MyDownloadsService;
import com.fincore.enquiry_service.service.utils.BaseStreamingExcelExporter;
import com.fincore.enquiry_service.service.utils.ExcelExportUtil;
import com.fincore.enquiry_service.service.utils.ExcelStyleUtil;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.ss.util.CellRangeAddress;
import org.apache.poi.xssf.streaming.SXSSFSheet;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.sql.Timestamp;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;

@Service
@RequiredArgsConstructor
@Slf4j
public class TransactionStreamingExportService
                extends BaseStreamingExcelExporter {

        private final JdbcTemplate jdbcTemplate;

        private final MyDownloadsService myDownloadsService;

        public byte[] export(
                        GetPayloadDTO dto,
                        GLBalance openingGLBalance,
                        GLBalance closingGLBalance,
                        String userId) {

                try (
                                SXSSFWorkbook workbook = new SXSSFWorkbook(100);

                                ByteArrayOutputStream out = new ByteArrayOutputStream()

                ) {

                        workbook.setCompressTempFiles(true);

                        SXSSFSheet sheet = workbook.createSheet("Transactions");

                        // ==================================================
                        // STYLES
                        // ==================================================

                        CellStyle headerStyle = ExcelStyleUtil.createHeaderStyle(workbook);

                        CellStyle titleStyle = ExcelStyleUtil.createTitleStyle(workbook);

                        CellStyle amountStyle = ExcelStyleUtil.createAmountStyle(workbook);

                        AtomicInteger rowNum = new AtomicInteger(0);

                        // ==================================================
                        // TITLE
                        // ==================================================

                        Row titleRow = sheet.createRow(rowNum.getAndIncrement());

                        Cell titleCell = titleRow.createCell(0);

                        titleCell.setCellValue("GL Transactions");

                        titleCell.setCellStyle(titleStyle);

                        sheet.addMergedRegion(
                                        new CellRangeAddress(
                                                        0,
                                                        0,
                                                        0,
                                                        8));

                        rowNum.incrementAndGet();

                        // ==================================================
                        // SUMMARY HEADER
                        // ==================================================

                        Row summaryHeader = sheet.createRow(rowNum.getAndIncrement());

                        int summaryCol = 0;

                        createHeaderCell(
                                        summaryHeader,
                                        summaryCol++,
                                        "Branch",
                                        headerStyle);

                        createHeaderCell(
                                        summaryHeader,
                                        summaryCol++,
                                        "Currency",
                                        headerStyle);

                        createHeaderCell(
                                        summaryHeader,
                                        summaryCol++,
                                        "CGL",
                                        headerStyle);

                        createHeaderCell(
                                        summaryHeader,
                                        summaryCol++,
                                        "From Date",
                                        headerStyle);

                        createHeaderCell(
                                        summaryHeader,
                                        summaryCol++,
                                        "To Date",
                                        headerStyle);

                        if (dto.getMinAmount() != null) {

                                createHeaderCell(
                                                summaryHeader,
                                                summaryCol++,
                                                "From Amount",
                                                headerStyle);
                        }

                        if (dto.getMaxAmount() != null) {

                                createHeaderCell(
                                                summaryHeader,
                                                summaryCol++,
                                                "To Amount",
                                                headerStyle);
                        }

                        // ==================================================
                        // SUMMARY VALUES
                        // ==================================================

                        Row summaryRow = sheet.createRow(rowNum.getAndIncrement());

                        int summaryValueCol = 0;

                        summaryRow.createCell(summaryValueCol++)
                                        .setCellValue(dto.getBranch());

                        summaryRow.createCell(summaryValueCol++)
                                        .setCellValue(dto.getCurrency());

                        summaryRow.createCell(summaryValueCol++)
                                        .setCellValue(dto.getCgl());

                        summaryRow.createCell(summaryValueCol++)
                                        .setCellValue(dto.getFromDate());

                        summaryRow.createCell(summaryValueCol++)
                                        .setCellValue(dto.getToDate());

                        if (dto.getMinAmount() != null) {

                                Cell cell = summaryRow.createCell(summaryValueCol++);

                                cell.setCellValue(dto.getMinAmount());

                                cell.setCellStyle(amountStyle);
                        }

                        if (dto.getMaxAmount() != null) {

                                Cell cell = summaryRow.createCell(summaryValueCol++);

                                cell.setCellValue(dto.getMaxAmount());

                                cell.setCellStyle(amountStyle);
                        }

                        rowNum.incrementAndGet();

                        // ==================================================
                        // OPENING / CLOSING
                        // ==================================================

                        Row openingRow = sheet.createRow(rowNum.getAndIncrement());

                        openingRow.createCell(0)
                                        .setCellValue("Opening Date");

                        openingRow.createCell(1)
                                        .setCellValue(dto.getFromDate());

                        openingRow.createCell(2)
                                        .setCellValue("Opening Balance");

                        Cell openBalCell = openingRow.createCell(3);

                        openBalCell.setCellValue(
                                        openingGLBalance.getBalance());

                        openBalCell.setCellStyle(amountStyle);

                        Row closingRow = sheet.createRow(rowNum.getAndIncrement());

                        closingRow.createCell(0)
                                        .setCellValue("Closing Date");

                        closingRow.createCell(1)
                                        .setCellValue(dto.getToDate());

                        closingRow.createCell(2)
                                        .setCellValue("Closing Balance");

                        Cell closeBalCell = closingRow.createCell(3);

                        closeBalCell.setCellValue(
                                        closingGLBalance.getBalance());

                        closeBalCell.setCellStyle(amountStyle);

                        rowNum.incrementAndGet();

                        // ==================================================
                        // MAIN HEADER
                        // ==================================================

                        String[] columns = {
                                        "Date",
                                        "Batch ID",
                                        "Journal Number",
                                        "Debit Amount",
                                        "Credit Amount",
                                        "Narration",
                                        "Transaction Type",
                                        "Source Flag",
                                        "Posted Date"
                        };

                        Row headerRow = sheet.createRow(rowNum.getAndIncrement());

                        for (int i = 0; i < columns.length; i++) {

                                Cell cell = headerRow.createCell(i);

                                cell.setCellValue(columns[i]);

                                cell.setCellStyle(headerStyle);
                        }

                        // ==================================================
                        // SQL
                        // ==================================================

                        String sql = """
                                        SELECT
                                            g.TRANSACTION_DATE,
                                            g.BATCH_ID,
                                            g.JOURNAL_ID,
                                            ABS(g.DEBIT_AMOUNT) AS DEBIT_AMOUNT,
                                            ABS(g.CREDIT_AMOUNT) AS CREDIT_AMOUNT,
                                            g.NARRATION,
                                            NVL(g.TRANSACTION_COUNT,0) AS TRANSACTION_COUNT,
                                            sf.FLAG_NAME AS SOURCE_NAME,
                                            g.POST_DATE
                                        FROM GL_TRANSACTIONS g

                                        LEFT JOIN SOURCE_FLAG sf
                                            ON g.SOURCE_FLAG = sf.FLAG_ID

                                        WHERE g.BRANCH_CODE = ?
                                          AND g.CURRENCY = ?
                                          AND g.CGL = ?
                                          AND g.TRANSACTION_DATE BETWEEN ? AND ?

                                        ORDER BY g.TRANSACTION_DATE
                                        """;

                        jdbcTemplate.setFetchSize(20000);

                        jdbcTemplate.query(
                                        connection -> {

                                                try {

                                                        var ps = connection.prepareStatement(sql);

                                                        ps.setFetchSize(20000);

                                                        ps.setString(
                                                                        1,
                                                                        dto.getBranch().split("-")[0]);

                                                        ps.setString(
                                                                        2,
                                                                        dto.getCurrency());

                                                        ps.setString(
                                                                        3,
                                                                        dto.getCgl().split(" -")[0]);

                                                        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");

                                                        java.util.Date fromDate = sdf.parse(dto.getFromDate());

                                                        java.util.Date toDate = sdf.parse(dto.getToDate());

                                                        ps.setTimestamp(
                                                                        4,
                                                                        new Timestamp(fromDate.getTime()));

                                                        ps.setTimestamp(
                                                                        5,
                                                                        new Timestamp(toDate.getTime()));

                                                        return ps;

                                                } catch (ParseException e) {

                                                        throw new IllegalArgumentException(
                                                                        "Invalid date format. Expected dd/MM/yyyy",
                                                                        e);
                                                }
                                        },
                                        rs -> {

                                                Row row = sheet.createRow(
                                                                rowNum.getAndIncrement());

                                                int col = 0;

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("TRANSACTION_DATE")));

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("BATCH_ID")));

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("JOURNAL_ID")));

                                                Cell debitCell = row.createCell(col++);

                                                debitCell.setCellValue(
                                                                rs.getDouble("DEBIT_AMOUNT"));

                                                debitCell.setCellStyle(amountStyle);

                                                Cell creditCell = row.createCell(col++);

                                                creditCell.setCellValue(
                                                                rs.getDouble("CREDIT_AMOUNT"));

                                                creditCell.setCellStyle(amountStyle);

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("NARRATION")));

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                rs.getLong("TRANSACTION_COUNT"));

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("SOURCE_NAME")));

                                                row.createCell(col++)
                                                                .setCellValue(
                                                                                ExcelExportUtil.safeString(
                                                                                                rs.getString("POST_DATE")));

                                                ExcelExportUtil.flushIfNeeded(
                                                                sheet,
                                                                rowNum.get());
                                        });

                        for (int i = 0; i < columns.length; i++) {

                                sheet.setColumnWidth(i, 6000);
                        }

                        workbook.write(out);

                        byte[] bytes = out.toByteArray();

                        MyDownloadsRequestDTO downloadRequest = new MyDownloadsRequestDTO();

                        downloadRequest.setUserId(userId);

                        String fileName = "GL_Transactions_" + dto.getCgl() + ".xlsx";
                        downloadRequest.setFileName(fileName);

                        downloadRequest.setMenuId(34);

                        SearchCriteriaDTO searchDto = new SearchCriteriaDTO();

                        searchDto.setBranch(dto.getBranch());
                        searchDto.setCgl(dto.getCgl());
                        searchDto.setCurrency(dto.getCurrency());
                        searchDto.setFromDate(dto.getFromDate());
                        searchDto.setToDate(dto.getToDate());

                        if (dto.getMinAmount() != null) {
                                searchDto.setMinAmount(dto.getMinAmount());
                        }

                        if (dto.getMaxAmount() != null) {
                                searchDto.setMaxAmount(dto.getMaxAmount());
                        }

                        if (dto.getSourceFlags() == null) {
                                searchDto.setSourceFlags(List.of("ALL"));
                        } else {
                                searchDto.setSourceFlags(dto.getSourceFlags());
                        }

                        String json = new ObjectMapper().writeValueAsString(searchDto);

                        downloadRequest.setSearchCriteria(json);

                        downloadRequest.setResultData(
                                        bytes);

                        myDownloadsService.insertRequest(downloadRequest);

                        return bytes;

                } catch (IOException e) {

                        throw new ExportGenerationException(
                                        "Failed to generate Transaction export",
                                        e);
                }
        }

        private void createHeaderCell(
                        Row row,
                        int column,
                        String value,
                        CellStyle style) {

                Cell cell = row.createCell(column);

                cell.setCellValue(value);

                cell.setCellStyle(style);
        }
}
