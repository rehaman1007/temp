// --- Helper Functions ---
const formatCode = (code, length) => {
  if (code === undefined || code === null || code === "") return "N/A";
  return String(code).padStart(length, "0");
};

const maskPhoneNumber = (phone, isVisible) => {
  if (!phone) return "N/A";
  if (isVisible) return phone;
  const visibleDigits = phone.slice(-4);
  const maskedSection = "X".repeat(Math.max(0, phone.length - 4));
  return `${maskedSection}${visibleDigits}`;
};

