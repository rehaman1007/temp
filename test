import React, { lazy, Suspense } from "react";
import { Routes, Route, Navigate } from "react-router-dom";
import { CircularProgress } from "@mui/material";

const AppRouter = ({ userData }) => {
  const { user, menu, defaultPage } = userData;

  return (
    <Suspense fallback={<CircularProgress />}>
      <Routes>
        {menu.map((route) => {
          const Component = lazy(() => import(`./pages/${route.component}`));
          return (
            <Route
              key={route.path}
              path={`/${user.role}/${route.path}`}
              element={<Component />}
            />
          );
        })}

        {/* Default Page */}
        <Route
          path={`/${user.role}/${defaultPage}`}
          element={lazy(() => import(`./pages/HomePage`))()}
        />

        {/* Fallback → first route or homepage */}
        <Route
          path="*"
          element={
            <Navigate
              to={
                menu.length > 0
                  ? `/${user.role}/${menu[0].path}`
                  : `/${user.role}/${defaultPage}`
              }
            />
          }
        />
      </Routes>
    </Suspense>
  );
};

export default AppRouter;