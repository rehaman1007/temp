import React from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
} from "@mui/material";
import { timeStampFormatter } from "../../utils/CommonUtilities";

// Helper function to format keys from 'segmentCode' to 'Segment Code'
const formatKeyForDisplay = (key) => {
  // Add a space before all caps and then capitalize the first letter
  const result = key.replace(/([A-Z])/g, " $1").trim();
  return result.charAt(0).toUpperCase() + result.slice(1);
};

const ViewRequestDailog = ({ open, handleClose, data }) => {
  if (!data || !data.payload) {
    return null;
  }

  const { payload } = data;
  const mainDetails = [
    { label: "Request Type", value: data.changeType },
    { label: "Status", value: data.reqStatus },
    {
      label: "Requested Date",
      value: timeStampFormatter(data.reqDate),
    },
    { label: "Creator ID", value: data.creatorId },
  ];

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="sm" fullWidth>
      <DialogTitle>Request Details (ID: {data.id})</DialogTitle>
      <DialogContent dividers>
        {/* Display main request details */}
        <Grid container spacing={2} sx={{ mb: 3 }}>
          {mainDetails.map((item) => (
            <Grid item xs={6} key={item.label}>
              <Typography variant="subtitle2" color="text.secondary">
                {item.label}
              </Typography>
              <Typography variant="body1">{item.value}</Typography>
            </Grid>
          ))}
        </Grid>

        {/* Display dynamic payload details */}
        <Typography variant="h6" gutterBottom>
          Data
        </Typography>
        <Box sx={{ borderTop: "1px solid #eee", pt: 2 }}>
          <Grid container spacing={2}>
            {Object.entries(payload).map(([key, value]) => (
              <Grid item xs={12} sm={6} key={key}>
                <Typography variant="subtitle2" color="text.secondary">
                  {formatKeyForDisplay(key)}
                </Typography>
                <Typography variant="body1">
                  {value === null || value === undefined
                    ? "N/A"
                    : String(value)}
                </Typography>
              </Grid>
            ))}
          </Grid>
        </Box>
      </DialogContent>
      <DialogActions>
        <Button onClick={handleClose} color="primary">
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ViewRequestDailog;
