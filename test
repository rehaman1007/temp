import React from "react";
import { Chip, styled } from "@mui/material";

const TOKENS = {
  palette: {
    default: { bg: "#F3F4F6", text: "#111827", border: "#E5E7EB" },
    info: { bg: "#E6F0FF", text: "#0B4DA0", border: "#BFD9FF" },
    success: { bg: "#ECFDF5", text: "#0F6A3A", border: "#C6F6E8" },
    warning: { bg: "#FFFAEB", text: "#7A4A00", border: "#FFE7A8" },
    error: { bg: "#FFF1F2", text: "#7A0B0D", border: "#FFC1C6" },
  },
};

const colorTokens = (kind) => TOKENS.palette[kind] || TOKENS.palette.default;

const StyledChip = styled(Chip, {
  shouldForwardProp: (prop) =>
    !["colorKind", "sizeKind", "variantKind"].includes(String(prop)),
})(({ colorKind, variantKind }) => {
  const pal = colorTokens(colorKind);

  const background = variantKind === "filled" ? pal.bg : "transparent";
  const border =
    variantKind === "outlined" ? `1px solid ${pal.border}` : "none";

  return {
    borderRadius: 999,
    background,
    color: pal.text,
    border,
    minWidth: 40,
    fontWeight: 500,
    "& .MuiChip-icon": {
      display: "inline-flex",
      alignItems: "center",
      justifyContent: "center",
    },
    "& .MuiChip-label": {
      display: "inline-flex",
      alignItems: "center",
    },
  };
});

const CustomChip = ({
  label,
  color = "default",
  size = "md",
  icon,
  iconPosition = "start",
  variant = "filled",
  clickable = false,
  onClick,
  title,
  sx,
  className,
  chipProps = {},
}) => {
  const startIcon = icon && iconPosition === "start" ? icon : undefined;
  const endIcon = icon && iconPosition === "end" ? icon : undefined;

  return (
    <StyledChip
      role={clickable ? "button" : "status"}
      aria-label={typeof label === "string" ? label : undefined}
      title={title}
      clickable={clickable}
      onClick={onClick}
      icon={startIcon}
      colorKind={color}
      sizeKind={size}
      variantKind={variant}
      className={className}
      sx={sx}
      {...chipProps}
      label={
        iconPosition === "end" && endIcon ? (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: TOKENS.sizes[size].gap,
            }}
          >
            {label}
            <span style={{ display: "inline-flex", alignItems: "center" }}>
              {endIcon}
            </span>
          </span>
        ) : (
          label
        )
      }
    />
  );
};

export default CustomChip;
