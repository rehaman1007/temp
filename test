import React, { useEffect, useMemo, useRef, useState } from "react";
import {
  Box,
  Button,
  Dialog,
  DialogContent,
  DialogTitle,
  Fab,
  Grid,
  IconButton,
  Stack,
  TextField,
  Typography,
  Tooltip,
  Chip,
  MenuItem,
  CircularProgress,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import {
  Edit as EditIcon,
  Add as AddIcon,
  Close as CloseIcon,
} from "@mui/icons-material";
import OnlinePredictionIcon from "@mui/icons-material/OnlinePrediction";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

export default function CircleMasterTab() {
  const [rows, setRows] = useState([]);
  const [zones, setZones] = useState([]);
  const [open, setOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [loading, setLoading] = useState(true);
  const snackbar = useCustomSnackbar();
  const { callApi } = useApi();

  const [circleData, setCircleData] = useState({
    circleCode: "",
    circleName: "",
    zoneCode: "",
    status: "Active",
  });
  const [errors, setErrors] = useState({});

  // --- debounce/snackbar control ---
  const snackGateRef = useRef(true);
  const notifyOnce = (msg, variant = "warning") => {
    if (!snackGateRef.current) return;
    snackGateRef.current = false;
    snackbar(msg, variant);
    setTimeout(() => (snackGateRef.current = true), 900);
  };

  // --- Fetch Data ---
  const fetchData = async () => {
    try {
      setLoading(true);
      const [zonesRes, circlesRes] = await Promise.all([
        callApi("/CM/zone-codes", null, "GET"),
        callApi("/CM/circle-codes", null, "GET"),
      ]);
      setZones(zonesRes?.data ?? []);
      setRows(circlesRes?.data ?? []);
    } catch (err) {
      snackbar("Failed to fetch data", "error");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // --- Validation Rules ---
  const reDigits = /^[0-9]*$/;
  const reDesc = /^[a-zA-Z0-9\s/&()-]*$/;

  const validateField = (name, value) => {
    switch (name) {
      case "circleCode":
        if (!value.trim()) return "Circle Code is required";
        if (!reDigits.test(value)) return "Only digits allowed";
        if (value.length !== 3) return "Must be 3 digits";
        break;

      case "circleName":
        if (!value.trim()) return "Circle Name is required";
        if (!reDesc.test(value)) return "Invalid characters";
        break;

      case "zoneCode":
        if (!value.trim()) return "Zone Code is required";
        if (!reDesc.test(value)) return "Only letters and digits allowed";
        break;

      default:
        return "";
    }
    return "";
  };

  const isFormValid = useMemo(
    () =>
      !validateField("circleCode", circleData.circleCode) &&
      !validateField("circleName", circleData.circleName) &&
      !validateField("zoneCode", circleData.zoneCode),
    [circleData]
  );

  const handleChange = (e) => {
    const { name, value } = e.target;
    if (name === "circleCode") {
      if (!reDigits.test(value)) {
        notifyOnce("Circle Code accepts digits only");
        return;
      }
      if (value.length > 3) {
        notifyOnce("Circle Code must be 3 digits");
        return;
      }
    } else if (name === "circleName" && !reDesc.test(value)) {
      notifyOnce("Invalid character in Circle Name");
      return;
    } else if (name === "zoneCode" && !reDesc.test(value)) {
      notifyOnce("Zone Code accepts only letters/digits");
      return;
    }

    setCircleData((prev) => ({ ...prev, [name]: value }));
    setErrors((prev) => ({ ...prev, [name]: validateField(name, value) }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const allErrors = {
      circleCode: validateField("circleCode", circleData.circleCode),
      circleName: validateField("circleName", circleData.circleName),
      zoneCode: validateField("zoneCode", circleData.zoneCode),
    };
    setErrors(allErrors);

    const valid = Object.values(allErrors).every((v) => !v);
    if (!valid) {
      notifyOnce("Please fix validation errors", "error");
      return;
    }

    const payloadData = {
      requestType: "CIRCLE",
      changeType: editingId ? "UPDATE" : "ADD",
      targetId: circleData.circleCode,
      payload: {
        circleCode: circleData.circleCode.trim(),
        circleName: circleData.circleName.trim(),
        zoneCode: circleData.zoneCode.trim(),
      },
    };

    try {
      const response = await callApi("/CR/create-request", payloadData, "POST");
      if (response) {
        snackbar(editingId ? "Circle updated" : "Circle created", "success");
        handleClose();
        fetchData();
      }
    } catch (err) {
      snackbar(err?.message || "Request failed", "error");
    }
  };

  const handleEdit = (row) => {
    setCircleData({
      circleCode: String(row.circleCode ?? ""),
      circleName: String(row.circleName ?? ""),
      zoneCode: String(row.zoneCode ?? ""),
      status: row.status || "Active",
    });
    setEditingId(row.circleCode);
    setOpen(true);
  };

  const resetForm = () => {
    setCircleData({ circleCode: "", circleName: "", zoneCode: "", status: "Active" });
    setErrors({});
    setEditingId(null);
  };

  const handleClose = () => {
    setOpen(false);
    resetForm();
  };

  // --- Columns ---
  const columns = useMemo(
    () => [
      { field: "circleCode", headerName: "Circle Code", flex: 1.2 },
      { field: "circleName", headerName: "Circle Name", flex: 2 },
      {
        field: "zoneCode",
        headerName: "Zone Description",
        flex: 2,
        valueGetter: (params) => {
          const zone = zones.find((z) => String(z.id) === String(params.value));
          return zone ? zone.description : "N/A";
        },
      },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => (
          <Chip
            icon={<OnlinePredictionIcon />}
            label={params.row.status || "Active"}
            color={params.row.status === "Active" ? "success" : "warning"}
            variant="outlined"
            sx={{ fontWeight: 500 }}
          />
        ),
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.8,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => (
          <Tooltip title="Edit">
            <IconButton color="primary" size="small" onClick={() => handleEdit(params.row)}>
              <EditIcon fontSize="small" />
            </IconButton>
          </Tooltip>
        ),
      },
    ],
    [zones]
  );

  return (
    <Box sx={{ p: 2 }}>
      {loading ? (
        <Stack alignItems="center" justifyContent="center" sx={{ height: "60vh" }}>
          <CircularProgress size={40} />
        </Stack>
      ) : (
        <DataGrid
          rows={rows}
          columns={columns}
          disableRowSelectionOnClick
          getRowId={(row) => row.circleCode}
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "circleCode", sort: "asc" }] },
          }}
          sx={{
            "& .MuiDataGrid-columnHeaders": { backgroundColor: "#f9f9f9" },
            border: "none",
            height: 500,
          }}
          localeText={{
            noRowsLabel: "No Circle Records Found",
          }}
        />
      )}

      {/* Floating Create Button */}
      <Fab
        onClick={() => setOpen(true)}
        color="primary"
        variant="extended"
        sx={{
          position: "fixed",
          borderRadius: 1,
          fontSize: "15px",
          bottom: (theme) => theme.spacing(8),
          right: (theme) => theme.spacing(4),
          zIndex: 1200,
        }}
      >
        <AddIcon sx={{ mr: 1 }} />
        Create
      </Fab>

      {/* Dialog Form */}
      <Dialog open={open} onClose={handleClose} maxWidth="sm" fullWidth>
        <Box component="form" onSubmit={handleSubmit}>
          <DialogTitle>
            <Stack direction="row" justifyContent="space-between" alignItems="center">
              <Typography variant="h6" color="primary">
                {editingId ? "Edit Circle" : "Add Circle"}
              </Typography>
              <IconButton onClick={handleClose}>
                <CloseIcon />
              </IconButton>
            </Stack>
          </DialogTitle>

          <DialogContent>
            <Grid container spacing={2} sx={{ mt: 1 }}>
              <Grid item xs={12}>
                <TextField
                  fullWidth
                  label="Circle Code"
                  name="circleCode"
                  value={circleData.circleCode}
                  onChange={handleChange}
                  disabled={!!editingId}
                  error={!!errors.circleCode}
                  helperText={errors.circleCode || "Exactly 3 digits"}
                  inputProps={{ maxLength: 3, inputMode: "numeric" }}
                />
              </Grid>

              <Grid item xs={12}>
                <TextField
                  fullWidth
                  label="Circle Name"
                  name="circleName"
                  value={circleData.circleName}
                  onChange={handleChange}
                  error={!!errors.circleName}
                  helperText={
                    errors.circleName || "Allowed: letters, digits, spaces, / & ( ) -"
                  }
                  multiline
                  rows={2}
                />
              </Grid>

              <Grid item xs={12}>
                <TextField
                  fullWidth
                  select
                  label="Zone Code"
                  name="zoneCode"
                  value={circleData.zoneCode}
                  onChange={handleChange}
                  error={!!errors.zoneCode}
                  helperText={errors.zoneCode || "Select corresponding Zone"}
                >
                  {zones.map((zone) => (
                    <MenuItem key={zone.id} value={zone.id}>
                      {zone.description}
                    </MenuItem>
                  ))}
                </TextField>
              </Grid>

              <Grid item xs={12} display="flex" justifyContent="flex-end">
                <Button
                  type="submit"
                  variant="contained"
                  startIcon={editingId ? <EditIcon /> : <AddIcon />}
                  disabled={!isFormValid}
                >
                  {editingId ? "Update" : "Add"}
                </Button>
              </Grid>
            </Grid>
          </DialogContent>
        </Box>
      </Dialog>
    </Box>
  );
}