import React, { useMemo } from "react";
import {
  Box,
  Typography,
  Button,
  CircularProgress,
  Stack,
  Chip,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import FileDownloadIcon from "@mui/icons-material/FileDownload";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import dayjs from "dayjs";

const LedgerDataGrid = ({
  rows,
  loading,
  rowCount,
  paginationModel,
  setPaginationModel,
  sortModel,
  setSortModel,
  filterModel,
  setFilterModel,
  onExcelExport,
  exporting,
  selectedCurrency,
  selectedCircle,
  sourceOptions,
  branchOptions,
  circleOptions,
  currencyOptions,
}) => {
  const transactionColumns = useMemo(() => {
    const cols = [
      {
        field: "transactionId",
        headerName: "ID",
        flex: 0.6,
        filterable: false,
      },
      {
        field: "transactionDate",
        headerName: "Date",
        flex: 0.6,
        valueFormatter: (v) => (v ? dayjs(v).format("DD/MM/YYYY") : "-"),
      },
      {
        field: "branchName",
        headerName: "Branch",
        flex: 1,
        type: "singleSelect",
        valueOptions: branchOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.branchCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.branchName}
            </Typography>
          </Box>
        ),
      },
      { field: "narration", headerName: "Narration", flex: 1.5 },
      {
        field: "debitAmount",
        headerName: "Debit",
        flex: 0.8,
        align: "right",
        headerAlign: "right",
        type: "number",
        valueFormatter: (v) =>
          new Intl.NumberFormat("en-IN", { minimumFractionDigits: 2 }).format(
            v || 0,
          ),
      },
      {
        field: "creditAmount",
        headerName: "Credit",
        flex: 0.8,
        align: "right",
        headerAlign: "right",
        type: "number",
        valueFormatter: (v) =>
          new Intl.NumberFormat("en-IN", { minimumFractionDigits: 2 }).format(
            v || 0,
          ),
      },
      {
        field: "sourceFlag",
        headerName: "Source",
        flex: 0.8,
        type: "singleSelect",

        valueOptions:
          sourceOptions?.map((flag) => ({
            value: flag.flagId,
            label: flag.flagName,
          })) || [],

        valueFormatter: (value) => {
          const matchedFlag = sourceOptions?.find(
            (flag) => flag.flagId === value,
          );

          return matchedFlag?.flagName || value || "-";
        },
      },
    ];

    if (selectedCircle === "ALL") {
      cols.splice(2, 0, {
        field: "circleCode",
        headerName: "Circle",
        flex: 1,
        type: "singleSelect",
        valueOptions: circleOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.circleCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.circleName}
            </Typography>
          </Box>
        ),
      });
    }
    if (selectedCurrency === "ALL") {
      const index = cols.length == 8 ? 7 : 6;
      cols.splice(index, 0, {
        field: "currencyName",
        headerName: "Currency",
        flex: 1,
        type: "singleSelect",
        valueOptions: currencyOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.currency}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.currencyName}
            </Typography>
          </Box>
        ),
      });
    }
    return cols;
  }, [
    branchOptions,
    sourceOptions,
    selectedCircle,
    selectedCurrency,
    circleOptions,
    currencyOptions,
  ]);

  const CustomNoRowsOverlay = () => (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        justifyContent: "center",
        alignItems: "center",
      }}
    >
      <ErrorOutlineIcon fontSize="large" color="action" />
      <Typography variant="body1" sx={{ mt: 1, color: "text.secondary" }}>
        Data is not available
      </Typography>
    </Box>
  );

  return (
    <Box sx={{ width: "100%", mt: 3 }}>
      {/* SEPARATE HEADER SECTION (Replacing Internal Toolbar) */}
      <Box
        sx={{
          p: 2.5,
          mb: 3,
          borderRadius: "20px",
          background: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255, 255, 255, 0.3)",
          boxShadow: "0 8px 32px rgba(0,0,0,0.05)",
          display: "flex",
          flexDirection: "column",
          gap: 2.5,
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
        >
          <Box sx={{ display: "flex", alignItems: "baseline", gap: 1.5 }}>
            <Typography
              variant="h6"
              fontWeight={800}
              sx={{ color: "#1a1a1a", letterSpacing: "-0.5px" }}
            >
              Transactions Ledger
            </Typography>
            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString()} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
              }}
            />
          </Box>
          <Button
            variant="contained"
            size="small"
            startIcon={
              exporting ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={!rowCount || loading || exporting}
            sx={{
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              "&:hover": { bgcolor: "#45357a" },
            }}
          >
            {exporting ? "Preparing..." : "Export"}
          </Button>
        </Stack>

        {/* DATA GRID SECTION */}
        <Box sx={{ height: 600 }}>
          <DataGrid
            rows={rows}
            columns={transactionColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) => row.transactionId}
            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"
            pageSizeOptions={[10, 20, 50, 100]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            sortModel={sortModel}
            onSortModelChange={setSortModel}
            filterModel={filterModel}
            onFilterModelChange={setFilterModel}
            rowHeight={60}
            disableRowSelectionOnClick
            slots={{ noRowsOverlay: CustomNoRowsOverlay }}
            sx={{
              borderRadius: "20px",
              backgroundColor: "rgba(255, 255, 255, 0.4)",
              border: "1px solid rgba(255, 255, 255, 0.3)",
              "& .MuiDataGrid-columnHeaders": {
                bgcolor: "#f8f9fa",
                fontWeight: 700,
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default LedgerDataGrid;
