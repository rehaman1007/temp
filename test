private void section2ErrorFile(String line, String batchId) {
    log.info("Inside writing Section2 Error File");
    String errorFilePath = MEDIA_BS_LOCAL + "/" + batchId + "/DICGC_SEC2_ERROR.txt";
    File file = new File(errorFilePath);

    try {
        // Create file if it does not exist
        if (!file.exists()) {
            if (file.createNewFile()) {
                log.info("File created for errors. FilePath ::" + errorFilePath);
                int errorFile = importBidDataDao.updateErrorFileStatus("Y", batchId, 3);
                if (errorFile == 0) {
                    log.warn("Failed to update error file status for batchId: " + batchId);
                }
            }
        } else {
            log.info("File Does Exists.");
        }

        // Use try-with-resources for safe writer handling
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(file, true))) {
            writer.write(line);
            writer.newLine();
        }

    } catch (IOException e) {
        log.error("IO Exception for writing error file :: " + e.getMessage(), e);
    }
}