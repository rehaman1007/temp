	@Override
	public Page<LedgerWiseResponse> search(
			LedgerWiseRequest dto
	) {

		Sort.Direction direction =
				"asc".equalsIgnoreCase(dto.getSortOrder())
						? Sort.Direction.ASC
						: Sort.Direction.DESC;

		Sort sort = Sort.by(
				direction,
				getSortField(dto.getSortField())
		);

		Pageable pageable = PageRequest.of(
				dto.getPage(),
				dto.getSize(),
				sort
		);

		Specification<LedgerTransaction> specification =
				(root, query, cb) -> {

					List<Predicate> predicates = new ArrayList<>();

					// CGL
					predicates.add(
							cb.equal(
									root.get("cglMaster")
											.get("cglNumber"),
									dto.getCgl()
							)
					);

					// DATE RANGE
					predicates.add(
							cb.between(
									root.get("transactionDate"),
									DateUtil.toDate(dto.getFromDate()),
									DateUtil.toDate(dto.getToDate())
							)
					);

					// CURRENCY
					if (
							dto.getCurrencies() != null &&
									!"ALL".equalsIgnoreCase(dto.getCurrencies())
					) {

						predicates.add(
								cb.equal(
										root.get("currency")
												.get("currencyCode"),
										dto.getCurrencies()
								)
						);
					}

					// CIRCLE
					if (
							dto.getCircle() != null &&
									!"ALL".equalsIgnoreCase(dto.getCircle())
					) {

						predicates.add(
								cb.equal(
										root.get("branch")
												.get("circle")
												.get("circleCode"),
										dto.getCircle()
								)
						);
					}

					// SOURCE FLAGS
					if (
							dto.getSourceFlags() != null &&
									!dto.getSourceFlags().isEmpty() &&
									!dto.getSourceFlags().contains("ALL")
					) {

						predicates.add(
								root.get("sourceFlag")
										.in(dto.getSourceFlags())
						);
					}

					// BRANCHES
					if (
							dto.getBranches() != null &&
									!dto.getBranches().isEmpty() &&
									!dto.getBranches().contains("ALL")
					) {

						predicates.add(
								root.get("branch")
										.get("code")
										.in(dto.getBranches())
						);
					}

					// GRID FILTERS
					if (
							dto.getGridFilters() != null &&
									!dto.getGridFilters().isEmpty()
					) {

						for (GridFilter filter : dto.getGridFilters()) {

							if (
									filter.getValue() == null ||
											filter.getValue().toString().trim().isEmpty()
							) {
								continue;
							}

							Path<?> path =
									getPath(root, filter.getField());

							String operator =
									filter.getOperator();

							Object value =
									filter.getValue();

							switch (operator) {

								case "contains" -> predicates.add(
										cb.like(
												cb.upper(path.as(String.class)),
												"%" + value.toString().toUpperCase() + "%"
										)
								);

								case "equals", "is" -> predicates.add(
										cb.equal(path, value)
								);

								case "startsWith" -> predicates.add(
										cb.like(
												cb.upper(path.as(String.class)),
												value.toString().toUpperCase() + "%"
										)
								);

								case "endsWith" -> predicates.add(
										cb.like(
												cb.upper(path.as(String.class)),
												"%" + value.toString().toUpperCase()
										)
								);
							}
						}
					}

					return cb.and(
							predicates.toArray(new Predicate[0])
					);
				};

		Page<LedgerTransaction> page =
				ledgerTransactionRepository.findAll(
						specification,
						pageable
				);

		return page.map(this::mapToDto);
	}

	private LedgerWiseResponse mapToDto(
			LedgerTransaction entity
	) {

		return new LedgerEnquiryResponse(

				entity.getTransactionId(),
				entity.getBatchId(),
				entity.getJournalId(),
				entity.getTransactionDate(),
				entity.getPostDate(),

				entity.getBranch() != null
						? entity.getBranch().getCode()
						: null,

				entity.getBranch() != null
						? entity.getBranch().getName()
						: null,

				entity.getBranch() != null &&
						entity.getBranch().getCircle() != null
						? entity.getBranch()
						.getCircle()
						.getCircleCode()
						: null,

				entity.getBranch() != null &&
						entity.getBranch().getCircle() != null
						? entity.getBranch()
						.getCircle()
						.getCircleName()
						: null,

				entity.getCurrencyMaster() != null
						? entity.getCurrencyMaster().getCurrencyCode()
						: null,

				entity.getCurrencyMaster() != null
						? entity.getCurrencyMaster().getCurrencyName()
						: null,

				entity.getCglMaster() != null
						? entity.getCglMaster().getCglNumber()
						: null,

				entity.getCglMaster() != null
						? entity.getCglMaster().getDescription()
						: null,

				entity.getNarration(),
				entity.getDebitAmount(),
				entity.getCreditAmount(),
				entity.getTransactionCount(),
				entity.getSourceFlag()
		);
	}

	private String getSortField(String field) {

		return switch (field) {

			// TRANSACTION
			case "transactionId" -> "transactionId";
			case "batchId" -> "batchId";
			case "journalId" -> "journalId";
			case "transactionDate" -> "transactionDate";
			case "postDate" -> "postDate";
			case "narration" -> "narration";
			case "debitAmount" -> "debitAmount";
			case "creditAmount" -> "creditAmount";
			case "transactionCount" -> "transactionCount";
			case "sourceFlag" -> "sourceFlag";

			// BRANCH
			case "branchCode" -> "branch.code";
			case "branchName" -> "branch.name";

			// CIRCLE
			case "circleCode" -> "branch.circle.circleCode";
			case "circleName" -> "branch.circle.circleName";

			// CURRENCY
			case "currency" -> "currency.currencyCode";
			case "currencyName" -> "currency.currencyName";

			// CGL
			case "cgl" -> "cglMaster.cglNumber";
			case "description" -> "cglMaster.description";

			default -> "transactionDate";
		};
	}

	private Path<?> getPath(
			Root<LedgerTransaction> root,
			String field
	) {

		return switch (field) {

			// BRANCH
			case "branchCode" ->
					root.get("branch")
							.get("code");

			case "branchName" ->
					root.get("branch")
							.get("name");

			// CIRCLE
			case "circleCode" ->
					root.get("branch")
							.get("circle")
							.get("circleCode");

			case "circleName" ->
					root.get("branch")
							.get("circle")
							.get("circleName");

			// CURRENCY
			case "currency" ->
					root.get("currency")
							.get("currencyCode");

			case "currencyName" ->
					root.get("currency")
							.get("currencyName");

			// CGL
			case "cgl" ->
					root.get("cglMaster")
							.get("cglNumber");

			case "description" ->
					root.get("cglMaster")
							.get("description");

			default ->
					root.get(field);
		};
	}
