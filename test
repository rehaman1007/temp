import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Container,
  Grid,
  Paper,
  IconButton,
  Tooltip,
  Chip,
  CircularProgress,
  Divider,
} from "@mui/material";
import { motion } from "framer-motion";
import dayjs from "dayjs";

// MUI Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import PictureAsPdfIcon from "@mui/icons-material/PictureAsPdf";
import TableChartIcon from "@mui/icons-material/TableChart";
import ArticleIcon from "@mui/icons-material/Article";
import ViewListIcon from "@mui/icons-material/ViewList";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import SyncIcon from "@mui/icons-material/Sync";
import EventBusyIcon from "@mui/icons-material/EventBusy";

// Custom Hooks (Ensure paths match your project)
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import LoadingOverlay from "../../utils/LoadingOverlay";

// --- Date Utility ---
const isLastDayOfMonth = (dateString) => {
  if (!dateString) return false;
  const [year, month, day] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return date.getDate() === lastDayOfMonth;
};

// --- Sub-Components ---
const DownloadActions = ({ isAvailable, onDownload }) => {
  const formats = [
    { id: "PDF", label: "PDF", icon: <PictureAsPdfIcon />, color: "#d32f2f" },
    { id: "EXCEL", label: "Excel", icon: <TableChartIcon />, color: "#1b5e20" },
    { id: "TEXT", label: "Text", icon: <ArticleIcon />, color: "#424242" },
  ];

  return (
    <Box sx={{ display: "flex", gap: 2, mt: 3, justifyContent: "center" }}>
      {formats.map((format, index) => (
        <Tooltip
          title={
            !isAvailable
              ? "ETL job is running. Downloads unavailable."
              : `Download ${format.label}`
          }
          key={format.id}
          arrow
        >
          <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: index * 0.1 }}
            whileHover={isAvailable ? { scale: 1.15, y: -3 } : {}}
            whileTap={isAvailable ? { scale: 0.95 } : {}}
          >
            <IconButton
              disabled={!isAvailable}
              onClick={() => onDownload(format.id)}
              sx={{
                bgcolor: !isAvailable
                  ? "action.disabledBackground"
                  : `${format.color}15`,
                color: !isAvailable ? "action.disabled" : format.color,
                "&:hover": {
                  bgcolor: !isAvailable
                    ? "action.disabledBackground"
                    : `${format.color}25`,
                },
              }}
            >
              {format.icon}
            </IconButton>
          </motion.div>
        </Tooltip>
      ))}
    </Box>
  );
};

const ReportCard = ({ report, isAvailable, onDownloadReport }) => {
  return (
    <Paper
      elevation={0}
      sx={{
        p: 4,
        borderRadius: 3,
        border: "1px solid",
        borderColor: "divider",
        background: "linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%)",
        height: "100%",
        display: "flex",
        flexDirection: "column",
        justifyContent: "space-between",
      }}
    >
      <Box sx={{ textAlign: "center", mb: 2 }}>
        <Typography
          variant="h5"
          fontWeight="700"
          color="primary.main"
          gutterBottom
        >
          {report.title}
        </Typography>
        <Typography variant="body2" color="text.secondary">
          {report.description}
        </Typography>
      </Box>

      <Divider sx={{ my: 2 }} />

      <Box sx={{ textAlign: "center" }}>
        <Typography variant="subtitle2" color="text.secondary">
          Available Formats
        </Typography>
        <DownloadActions
          isAvailable={isAvailable}
          onDownload={(formatType) => onDownloadReport(report.id, formatType)}
        />
      </Box>
    </Paper>
  );
};

// --- Main Screen ---

export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [etlDate, setEtlDate] = useState("");
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(false);
  const [reports, setReports] = useState([]);
  const [loading, setLoading] = useState(true);

  const fetchData = async () => {
    setLoading(true);
    try {
      // 1. Fetch Metadata (ETL Date & Availability Flag)
      const etlDetails = await callApi("/PS/file/fincore-date", {}, "GET");
      console.log(etlDetails);

      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.isAvailableToDownload || false;

      console.log(etlRaw);

      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(availableFlag);

      // 2. Fetch Dynamic Reports List
      // Optimization: Only fetch reports if it's a month-end date
      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        setReports(reportsData);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar(
        "Failed to load report data. Kindly try again after sometime.",
        "error",
      );
      setEtlDate(dayjs().format("YYYY-MM-DD"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = (reportId, formatType) => {
    // This function acts as your Step 4 (Download with whatever type user chooses)
    // You can wire up your file download API call here.
    showSnackBar(
      `Generating fresh ${formatType} data for ${reportId}...`,
      "info",
    );

    // Example API Call for download:
    // callApi(`/PS/process/download?report=${reportId}&type=${formatType}`, {}, "GET")
    //   .then(...)
  };

  if (loading) {
    return (
      <Box
        sx={{
          display: "flex",
          height: "100vh",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        <CircularProgress />
      </Box>
    );
  }

  // Intercept if ETL date is NOT the last day of the month
  if (etlDate && !isLastDayOfMonth(etlDate)) {
    return (
      <Container maxWidth="sm" sx={{ py: 12 }}>
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.5 }}
        >
          <Paper
            elevation={0}
            sx={{
              p: 6,
              borderRadius: 4,
              textAlign: "center",
              border: "1px solid",
              borderColor: "divider",
              bgcolor: "#fafafa",
            }}
          >
            <motion.div
              initial={{ scale: 0 }}
              animate={{ scale: 1 }}
              transition={{ delay: 0.2, type: "spring", stiffness: 150 }}
            >
              <EventBusyIcon
                sx={{
                  fontSize: 80,
                  color: "text.secondary",
                  mb: 3,
                  opacity: 0.5,
                }}
              />
            </motion.div>
            <Typography
              variant="h5"
              fontWeight="bold"
              gutterBottom
              color="text.primary"
            >
              Not a Month-End Cycle
            </Typography>
            <Typography variant="body1" color="text.secondary">
              Adhoc Reports are strictly generated as part of the month-end
              activity.
            </Typography>
            <Typography variant="body1" color="text.secondary">
              The current ETL Date processed is <strong>{etlDate}</strong>.
            </Typography>
            <Typography variant="body1" color="text.secondary">
              Please check back during the month-end processing cycle.
            </Typography>
          </Paper>
        </motion.div>
      </Container>
    );
  }

  return (
    <>
      <LoadingOverlay loading={loading} />
      <Container maxWidth="lg" sx={{ py: 6 }}>
        {/* Page Header */}
        <motion.div
          initial={{ opacity: 0, x: -20 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ duration: 0.5 }}
        >
          <Box sx={{ mb: 4 }}>
            <Typography
              variant="h4"
              fontWeight="800"
              color="text.primary"
              gutterBottom
            >
              Adhoc Reports
            </Typography>
            <Typography
              variant="body1"
              color="text.secondary"
              sx={{ maxWidth: "800px" }}
            >
              View and download your monthly reports. Data is generated freshly
              upon request when the month-end ETL processing has completed
              successfully.
            </Typography>
          </Box>
        </motion.div>

        {/* Global Status Panel */}
        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          transition={{ duration: 0.5, delay: 0.1 }}
        >
          <Paper
            elevation={0}
            sx={{
              p: 3,
              mb: 5,
              borderRadius: 3,
              bgcolor: "background.paper",
              border: "1px solid",
              borderColor: "divider",
              boxShadow: "0 4px 20px rgba(0, 0, 0, 0.03)",
            }}
          >
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "space-between",
                flexWrap: "wrap",
                gap: 2,
              }}
            >
              <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                <Box
                  sx={{
                    p: 1.5,
                    bgcolor: "primary.50",
                    color: "primary.main",
                    borderRadius: 2,
                    display: "flex",
                  }}
                >
                  <CalendarMonthIcon fontSize="medium" />
                </Box>
                <Box>
                  <Typography
                    variant="caption"
                    color="text.secondary"
                    fontWeight="bold"
                    sx={{ display: "block" }}
                  >
                    ACTIVE ETL DATE
                  </Typography>
                  <Typography variant="h6" fontWeight="600">
                    {etlDate}
                  </Typography>
                </Box>
              </Box>

              {/* Global Availability Status Indicator */}
              <Chip
                icon={
                  isAvailableToDownload ? (
                    <CheckCircleIcon />
                  ) : (
                    <SyncIcon
                      sx={{
                        animation: "spin 2s linear infinite",
                        "@keyframes spin": {
                          "0%": { transform: "rotate(0deg)" },
                          "100%": { transform: "rotate(360deg)" },
                        },
                      }}
                    />
                  )
                }
                label={
                  isAvailableToDownload
                    ? "Ready for Download"
                    : "ETL Job Running..."
                }
                color={isAvailableToDownload ? "success" : "warning"}
                variant="outlined"
                sx={{ fontWeight: "bold", px: 1 }}
              />
            </Box>
          </Paper>
        </motion.div>

        {/* Dynamic Reports Grid */}
        <Grid container spacing={4}>
          {reports.map((report, index) => (
            <Grid item xs={12} md={6} key={report.id}>
              <motion.div
                initial={{ opacity: 0, y: 30 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.5, delay: 0.2 + index * 0.1 }}
                style={{ height: "100%" }}
              >
                <ReportCard
                  report={report}
                  isAvailable={isAvailableToDownload}
                  onDownloadReport={handleDownload}
                />
              </motion.div>
            </Grid>
          ))}
          {reports.length === 0 && (
            <Grid item xs={12}>
              <Typography align="center" color="text.secondary" sx={{ py: 4 }}>
                No reports configured for this date.
              </Typography>
            </Grid>
          )}
        </Grid>
      </Container>
    </>
  );
}
