import React, {
  useState,
  useCallback,
  useEffect,
  useMemo,
} from "react";

import { useSelector } from "react-redux";

import { Box } from "@mui/material";

import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

import dayjs from "dayjs";
import debounce from "lodash/debounce";

import LedgerForm from "./components/LedgerForm";
import LedgerDataGrid from "./components/LedgerDataGrid";

import { getPermissions } from "../../utils/CommonUtilities";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";

const DEFAULT_PAGE_SIZE = 20;

const LedgerWiseEnquiry = () => {
  const { callApi } = useApi();

  const showSnackBar =
    useCustomSnackbar();

  const user = useSelector(
    (state) => state.auth.user,
  );

  const menu = useSelector(
    (state) =>
      state.menus.selectedMenuItem,
  );

  const permissions =
    getPermissions(menu);

  const MIN_ALLOWED_DATE =
    dayjs("2026-03-31");

  const DATE_FORMAT =
    "DD/MM/YYYY";

  /*
   * ACCESS
   */

  const hasWholeBank =
    !!permissions.wholebank;

  const hasCircle =
    user?.isCircle === "Y" ||
    !!permissions.circle;

  const isCircleUser =
    user?.isCircle === "Y" &&
    !hasWholeBank;

  /*
   * MASTER DATA
   */

  const [circles, setCircles] =
    useState([]);

  const [currencies, setCurrencies] =
    useState([]);

  const [
    sourceOptions,
    setSourceOptions,
  ] = useState([]);

  const [etlDate, setEtlDate] =
    useState(null);

  /*
   * GRID DATA
   */

  const [rows, setRows] =
    useState([]);

  const [rowCount, setRowCount] =
    useState(0);

  /*
   * LOADING
   */

  const [loading, setLoading] =
    useState(false);

  const [exporting, setExporting] =
    useState(false);

  /*
   * GRID CONTROLS
   */

  const [
    paginationModel,
    setPaginationModel,
  ] = useState({
    page: 0,
    pageSize: DEFAULT_PAGE_SIZE,
  });

  const [sortModel, setSortModel] =
    useState([
      {
        field: "transactionDate",
        sort: "desc",
      },
    ]);

  const [
    filterModel,
    setFilterModel,
  ] = useState({
    items: [],
  });

  /*
   * INITIAL FILTERS
   */

  const initialState = useMemo(
    () => ({
      level: hasWholeBank
        ? "BANK"
        : isCircleUser
          ? "CIRCLE"
          : "BRANCH",

      circle: hasWholeBank
        ? "ALL"
        : user?.circleCode,

      branches:
        user?.isCircle === "N" &&
        !hasWholeBank
          ? [
              `${user?.branch}-${user?.branchName}`,
            ]
          : ["ALL"],

      currencies:
        "All Currencies",

      sourceFlags: [],

      cgl:
        "1106505001 - CORE INTER BRANCH A/C",

      fromDate: dayjs(
        "2026-03-31",
      ),

      toDate: dayjs(
        "2026-04-10",
      ),
    }),
    [
      hasWholeBank,
      isCircleUser,
      user?.circleCode,
      user?.isCircle,
      user?.branch,
      user?.branchName,
    ],
  );

  const [filters, setFilters] =
    useState(initialState);

  /*
   * THIS STORES FINAL SEARCHED DATA
   * ONLY UPDATED ON FETCH BUTTON
   */

  const [searchQuery, setSearchQuery] =
    useState(null);

  /*
   * FETCH MASTERS
   */

  const fetchMasters =
    useCallback(async () => {
      try {
        const [
          dateRes,
          currRes,
          flagRes,
        ] = await Promise.all([
          callApi(
            "/PS/file/fincore-date",
            {},
            "GET",
          ),

          callApi(
            "/CM/common-master/currency-code-name-only",
            null,
            "GET",
          ),

          callApi(
            "/CM/common-master/source-flag",
            null,
            "GET",
          ),
        ]);

        /*
         * ETL DATE
         */

        if (
          dateRes?.data?.etlDate
        ) {
          setEtlDate(
            dayjs(
              dateRes.data.etlDate,
              "YYYY-MM-DD",
            ),
          );
        }

        /*
         * CURRENCIES
         */

        const formattedCurrencies =
          currRes?.data?.map(
            (c) =>
              `${c.currencyCode} (${c.currencyName})`,
          ) || [];

        setCurrencies(
          formattedCurrencies.sort(
            (a, b) =>
              a.localeCompare(b),
          ),
        );

        /*
         * SOURCE FLAGS
         */

        if (flagRes?.data) {
          setSourceOptions(
            flagRes.data,
          );

          setFilters((prev) => ({
            ...prev,
            sourceFlags:
              flagRes.data,
          }));
        }

        /*
         * CIRCLES
         */

        if (hasWholeBank) {
          const circleRes =
            await callApi(
              "/CM/common-master/circle-codes",
              null,
              "GET",
            );

          setCircles(
            circleRes?.data || [],
          );
        }
      } catch (error) {
        console.error(error);

        showSnackBar(
          "Failed to load master configuration",
          "error",
        );
      }
    }, [
      callApi,
      hasWholeBank,
      showSnackBar,
    ]);

  useEffect(() => {
    fetchMasters();
  }, [fetchMasters]);

  /*
   * FILTERED SOURCE OPTIONS
   */

  const selectedSourceOptions =
    useMemo(() => {
      if (
        !filters?.sourceFlags
          ?.length
      ) {
        return sourceOptions;
      }

      const selectedIds =
        new Set(
          filters.sourceFlags.map(
            (f) => f.flagId,
          ),
        );

      return sourceOptions.filter(
        (option) =>
          selectedIds.has(
            option.flagId,
          ),
      );
    }, [
      filters.sourceFlags,
      sourceOptions,
    ]);

  /*
   * BRANCH OPTIONS
   */

  const selectedBranchOptions =
    useMemo(() => {
      if (
        !filters.branches
          ?.length ||
        filters.branches.includes(
          "ALL",
        )
      ) {
        return [];
      }

      return filters.branches.map(
        (branch) => ({
          value:
            branch.split(
              "-",
            )[0],

          label: branch,
        }),
      );
    }, [filters.branches]);

  /*
   * CIRCLE OPTIONS
   */

  const selectedCircleOptions =
    useMemo(() => {
      if (
        !filters.circle ||
        filters.circle === "ALL"
      ) {
        return circles.map(
          (circle) => ({
            value:
              circle.circleCode,

            label: `${circle.circleCode} - ${circle.circleName}`,
          }),
        );
      }

      const matched =
        circles.find(
          (circle) =>
            circle.circleCode ===
            filters.circle,
        );

      return matched
        ? [
            {
              value:
                matched.circleCode,

              label: `${matched.circleCode} - ${matched.circleName}`,
            },
          ]
        : [];
    }, [
      filters.circle,
      circles,
    ]);

  /*
   * CURRENCY OPTIONS
   */

  const selectedCurrencyOptions =
    useMemo(() => {
      if (
        !filters.currencies ||
        filters.currencies ===
          "ALL"
      ) {
        return currencies.map(
          (currency) => ({
            value:
              currency.split(
                " (",
              )[0],

            label: currency,
          }),
        );
      }

      return [
        {
          value:
            filters.currencies.split(
              " (",
            )[0],

          label:
            filters.currencies,
        },
      ];
    }, [
      filters.currencies,
      currencies,
    ]);

  /*
   * PAYLOAD
   */

  const buildPayload =
    useCallback(() => {
      if (!searchQuery)
        return null;

      const gridFilters =
        filterModel.items
          ?.filter(
            (item) =>
              item.field &&
              item.operator &&
              item.value !==
                undefined &&
              item.value !==
                null &&
              item.value !== "",
          )
          .map((item) => ({
            field: item.field,
            operator:
              item.operator,
            value: item.value,
          })) || [];

      return {
        /*
         * MAIN FILTERS
         */

        circle:
          searchQuery.circle ===
          "ALL"
            ? "ALL"
            : searchQuery.circle,

        cgl:
          searchQuery.cgl.split(
            " - ",
          )[0],

        cglName:
          searchQuery.cgl.split(
            " - ",
          )[1],

        currencies:
          searchQuery.currencies ===
          "All Currencies"
            ? "ALL"
            : searchQuery.currencies.split(
                " (",
              )[0],

        branches:
          searchQuery.branches.includes(
            "ALL",
          )
            ? ["ALL"]
            : searchQuery.branches.map(
                (b) =>
                  b.split(
                    "-",
                  )[0],
              ),

        sourceFlags:
          searchQuery.sourceFlags?.map(
            (f) => f.flagId,
          ) || [],

        fromDate:
          dayjs(
            searchQuery.fromDate,
          ).format(
            "DD/MM/YYYY",
          ),

        toDate:
          dayjs(
            searchQuery.toDate,
          ).format(
            "DD/MM/YYYY",
          ),

        /*
         * PAGINATION
         */

        page:
          paginationModel.page,

        size:
          paginationModel.pageSize,

        /*
         * SORTING
         */

        sortField:
          sortModel?.[0]
            ?.field ||
          "transactionDate",

        sortOrder:
          sortModel?.[0]
            ?.sort ||
          "desc",

        /*
         * GRID FILTERS
         */

        gridFilters,
      };
    }, [
      searchQuery,
      paginationModel,
      sortModel,
      filterModel,
    ]);

  /*
   * FETCH ROWS
   */

  const fetchRows =
    useCallback(async () => {
      const payload =
        buildPayload();

      if (!payload) return;

      try {
        setLoading(true);

        const res =
          await callApi(
            "/ES/ledger-enquiries/search",
            payload,
            "POST",
          );

        setRows(
          res?.data?.content ||
            [],
        );

        setRowCount(
          res?.data
            ?.totalElements || 0,
        );
      } catch (error) {
        console.error(error);

        showSnackBar(
          "Enquiry failed",
          "error",
        );
      } finally {
        setLoading(false);
      }
    }, [
      callApi,
      buildPayload,
      showSnackBar,
    ]);

  /*
   * DEBOUNCED FETCH
   */

  const debouncedFetch =
    useMemo(
      () =>
        debounce(() => {
          fetchRows();
        }, 300),
      [fetchRows],
    );

  /*
   * FETCH ON:
   * PAGE
   * SORT
   * FILTER
   * SEARCH QUERY
   */

  useEffect(() => {
    if (!searchQuery)
      return;

    debouncedFetch();

    return () => {
      debouncedFetch.cancel();
    };
  }, [
    paginationModel,
    sortModel,
    filterModel,
    searchQuery,
    debouncedFetch,
  ]);

  /*
   * SEARCH
   */

  const handleSearch =
    useCallback(() => {
      const {
        cgl,
        fromDate,
        toDate,
      } = filters;

      /*
       * VALIDATIONS
       */

      if (
        !cgl ||
        !fromDate ||
        !toDate
      ) {
        showSnackBar(
          "Please fill all required fields",
          "warning",
        );

        return;
      }

      if (
        !fromDate?.isValid?.() ||
        !toDate?.isValid?.()
      ) {
        showSnackBar(
          "Invalid date selected",
          "warning",
        );

        return;
      }

      if (
        fromDate.isBefore(
          MIN_ALLOWED_DATE,
          "day",
        )
      ) {
        showSnackBar(
          `From date cannot be earlier than ${MIN_ALLOWED_DATE.format(
            DATE_FORMAT,
          )}`,
          "warning",
        );

        return;
      }

      if (
        toDate.isBefore(
          MIN_ALLOWED_DATE,
          "day",
        )
      ) {
        showSnackBar(
          `To date cannot be earlier than ${MIN_ALLOWED_DATE.format(
            DATE_FORMAT,
          )}`,
          "warning",
        );

        return;
      }

      if (
        fromDate.isAfter(
          toDate,
          "day",
        )
      ) {
        showSnackBar(
          "From date cannot be greater than To date",
          "warning",
        );

        return;
      }

      if (
        toDate.isAfter(
          fromDate.add(
            1,
            "year",
          ),
          "day",
        )
      ) {
        showSnackBar(
          "Date range cannot exceed 12 months",
          "warning",
        );

        return;
      }

      if (
        etlDate?.isValid?.() &&
        toDate.isAfter(
          etlDate,
          "day",
        )
      ) {
        showSnackBar(
          `To date cannot exceed ETL date ${etlDate.format(
            DATE_FORMAT,
          )}`,
          "warning",
        );

        return;
      }

      /*
       * RESET GRID ONLY ON FETCH
       */

      setPaginationModel({
        page: 0,
        pageSize:
          paginationModel.pageSize,
      });

      setSortModel([
        {
          field:
            "transactionDate",
          sort: "desc",
        },
      ]);

      setFilterModel({
        items: [],
      });

      /*
       * FINAL SEARCH
       */

      setSearchQuery({
        ...filters,
      });
    }, [
      filters,
      etlDate,
      MIN_ALLOWED_DATE,
      DATE_FORMAT,
      paginationModel.pageSize,
      showSnackBar,
    ]);

  /*
   * RESET
   */

  const handleReset =
    useCallback(() => {
      setFilters(initialState);

      setSearchQuery(null);

      setRows([]);

      setRowCount(0);

      setPaginationModel({
        page: 0,
        pageSize:
          DEFAULT_PAGE_SIZE,
      });

      setSortModel([
        {
          field:
            "transactionDate",
          sort: "desc",
        },
      ]);

      setFilterModel({
        items: [],
      });
    }, [initialState]);

  /*
   * EXPORT
   */

  const handleExcelExport =
    useCallback(async () => {
      const payload =
        buildPayload();

      if (!payload)
        return;

      try {
        setExporting(true);

        const response =
          await callApi(
            "/ES/ledger-enquiries/export-excel",
            payload,
            "POST",
            "arraybuffer",
          );

        const fileName = `Ledger_${
          searchQuery.cgl.split(
            " - ",
          )[0]
        }`;

        if (
          response?.byteLength
        ) {
          downloadFile(
            response,
            "excel",
            fileName,
          );
        }
      } catch (error) {
        console.error(error);

        showSnackBar(
          "Failed to export",
          "error",
        );
      } finally {
        setExporting(false);
      }
    }, [
      buildPayload,
      callApi,
      searchQuery,
      showSnackBar,
    ]);

  return (
    <LocalizationProvider
      dateAdapter={
        AdapterDayjs
      }
    >
      <Box
        sx={{
          p: 2.5,
        }}
      >
        <LedgerForm
          filters={filters}
          onFilterChange={(
            field,
            value,
          ) =>
            setFilters(
              (prev) => ({
                ...prev,
                [field]:
                  value,
              }),
            )
          }
          onReset={
            handleReset
          }
          onFetch={
            handleSearch
          }
          permissions={{
            hasWholeBank,
            hasCircle,
          }}
          user={user}
          circles={circles}
          currencies={
            currencies
          }
          sourceOptions={
            sourceOptions
          }
          etlDate={etlDate}
        />

        <LedgerDataGrid
          rows={rows}
          loading={loading}
          rowCount={rowCount}
          paginationModel={
            paginationModel
          }
          setPaginationModel={
            setPaginationModel
          }
          sortModel={
            sortModel
          }
          setSortModel={
            setSortModel
          }
          filterModel={
            filterModel
          }
          setFilterModel={
            setFilterModel
          }
          onExcelExport={
            handleExcelExport
          }
          exporting={
            exporting
          }
          selectedCurrency={
            searchQuery
              ?.currencies ||
            "ALL"
          }
          selectedCircle={
            searchQuery
              ?.circle ||
            "ALL"
          }
          sourceOptions={
            selectedSourceOptions
          }
          branchOptions={
            selectedBranchOptions
          }
          circleOptions={
            selectedCircleOptions
          }
          currencyOptions={
            selectedCurrencyOptions
          }
          searchPerformed={
            !!searchQuery
          }
        />
      </Box>
    </LocalizationProvider>
  );
};

export default React.memo(
  LedgerWiseEnquiry,
);