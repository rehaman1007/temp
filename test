const ActualTreeTableRow = memo(
  forwardRef(
    (
      {
        node,
        isExpanded,
        isLoading,
        onToggle,
        maxVisibleLevel,
        index,
        activeMetrics,
        ...props
      },
      ref,
    ) => {
      return (
        <TableRow
          ref={ref}
          hover
          sx={{
            bgcolor: isExpanded ? "#D8CCFF" : "inherit",
            borderLeft: isExpanded ? "4px solid" : "4px solid transparent",
            borderLeftColor: isExpanded ? "primary.main" : "transparent",
            // Use CSS transitions instead of Framer Motion
            transition: "background-color 0.2s ease-in-out, border-color 0.2s ease-in-out",
          }}
          {...props}
        >
          {/* Hierarchy Depth Columns */}
          {Array.from({ length: maxVisibleLevel + 1 }).map((_, colIndex) => {
            if (colIndex === node.level) {
              return (
                <TableCell
                  key={colIndex}
                  sx={{
                    borderRight: 1,
                    borderColor: "divider",
                    minWidth: 260,
                    bgcolor: "transparent",
                    p: 1,
                    verticalAlign: "middle",
                  }}
                >
                  <Box
                    sx={{
                      display: "flex",
                      alignItems: "center",
                      pl: node.level * 2.5 + 1,
                      pr: 1.5,
                      py: 0.5,
                      position: "relative",
                      width: "100%",
                      boxSizing: "border-box",
                      transition: "transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease",
                      "&:hover": {
                        transform: "scale(1.02)", // Reduced scale slightly to prevent table layout jitter
                        zIndex: 10,
                        boxShadow: "0px 4px 12px rgba(0,0,0,0.08)",
                        backgroundColor: "background.paper",
                      }
                    }}
                  >
                    {node.hasChildren ? (
                      <IconButton
                        size="small"
                        color="primary"
                        onClick={() => onToggle(node)}
                        disabled={isLoading}
                        sx={{
                          mr: 1,
                          border: 1,
                          borderColor: isExpanded ? "primary.dark" : "divider",
                          borderRadius: "50%",
                          height: 20,
                          width: 20,
                          p: 0,
                          bgcolor: "action.hover",
                          transition: "transform 0.1s ease",
                          "&:hover": {
                            transform: "scale(1.15)",
                          },
                          "&:active": {
                            transform: "scale(0.85)",
                          },
                          "&.Mui-focusVisible": {
                            bgcolor: "action.selected",
                          },
                        }}
                      >
                        {isLoading ? (
                          <CircularProgress size={12} color={isExpanded ? "primary.dark" : "inherit"} />
                        ) : isExpanded ? (
                          "-"
                        ) : (
                          "+"
                        )}
                      </IconButton>
                    ) : (
                      <Box sx={{ width: 20, mr: 1 }} />
                    )}
                    <Typography
                      variant="body2"
                      color={isExpanded ? "primary.main" : "text.primary"}
                      sx={{
                        fontWeight: isExpanded ? 700 : node.level === 0 ? 600 : 400,
                        whiteSpace: "nowrap",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                      }}
                    >
                      {node.name}
                    </Typography>
                  </Box>
                </TableCell>
              );
            }
            return (
              <TableCell
                key={colIndex}
                sx={{
                  borderRight: 1,
                  borderColor: "divider",
                  width: 80,
                  minWidth: 80,
                  bgcolor: "background.default",
                  p: 0,
                }}
              />
            );
          })}

          {/* Dynamic Metrics Columns */}
          {activeMetrics.map((metric, mIdx) => {
            const isLastColumn = mIdx === activeMetrics.length - 1;
            return (
              <TableCell
                key={metric.logicalName}
                align="right"
                sx={{
                  borderRight: 1,
                  borderColor: "divider",
                  p: 0,
                  verticalAlign: "middle",
                }}
              >
                <Box
                  sx={{
                    p: "8px 16px",
                    color: node[metric.logicalName] < 0 ? "error.main" : "success.main",
                    position: "relative",
                    fontWeight: 500,
                    transformOrigin: isLastColumn ? "right center" : "center center",
                    whiteSpace: "nowrap",
                    transition: "transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease",
                    "&:hover": {
                      transform: "scale(1.03)",
                      zIndex: 20,
                      boxShadow: "-4px 4px 15px rgba(0,0,0,0.1)",
                      backgroundColor: "background.paper",
                      borderRadius: "4px",
                    }
                  }}
                >
                  {formatCurrency(node[metric.logicalName])}
                </Box>
              </TableCell>
            );
          })}
        </TableRow>
      );
    },
  ),
);
ActualTreeTableRow.displayName = "ActualTreeTableRow";
