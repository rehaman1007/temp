import React, { useMemo, useRef, useEffect } from "react";
import {
  Box,
  Button,
  Chip,
  CircularProgress,
  Divider,
  IconButton,
  Stack,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CleaningServices,
  ContentCopy,
  PlayArrow,
  PlaylistPlay,
  Terminal,
  Timer,
} from "@mui/icons-material";
import Editor from "@monaco-editor/react";
import CustomChip from "../../../utils/CustomChip";

const quickCommands = [
  "SELECT * FROM USERS;",
  "SELECT * FROM ADMIN_SUPPORT_LOG;",
  "SELECT * FROM PERMISSIONS;",
  "SELECT * FROM ROLES;",
  "SELECT * FROM USER_ROLES;",
  "SELECT * FROM ROLE_PERMISSIONS;",
  "SELECT * FROM GL_BALANCE WHERE BALANCE_DATE = TO_DATE('01/04/2026','DD/MM/YYYY');",
  "SELECT * FROM GL_TRANSACTIONS WHERE TRANSACTION_DATE = TO_DATE('01/04/2026','DD/MM/YYYY');",
];

const CommandPanel = ({
  query,
  setQuery,
  onExecute,
  loading,
  onDangerousExecute,
}) => {
  const theme = useTheme();
  const editorRef = useRef(null);

  // Using refs for callbacks prevents stale closures inside Monaco's shortcut binders
  const executeRef = useRef(onExecute);
  const dangerousRef = useRef(onDangerousExecute);

  useEffect(() => {
    executeRef.current = onExecute;
    dangerousRef.current = onDangerousExecute;
  }, [onExecute, onDangerousExecute]);

  /**
   * MONACO MOUNT & KEYBINDS
   */
  const handleEditorDidMount = (editor, monaco) => {
    editorRef.current = editor;

    // Ctrl + Enter : Run Statement at Cursor
    editor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, () => {
      handleRunStatement();
    });

    // F5 : Run Entire Script
    editor.addCommand(monaco.KeyCode.F5, () => {
      handleRunScript();
    });
  };

  /**
   * EXTRACT STATEMENT AT CURSOR
   */
  const getStatementAtCursor = () => {
    if (!editorRef.current) return query;

    const currentSql = editorRef.current.getValue();
    const position = editorRef.current.getPosition();
    const offset = editorRef.current.getModel().getOffsetAt(position);

    const beforeCursor = currentSql.substring(0, offset);
    const afterCursor = currentSql.substring(offset);

    const startIdx = beforeCursor.lastIndexOf(";");
    const endIdx = afterCursor.indexOf(";");

    const startIndex = startIdx === -1 ? 0 : startIdx + 1;
    const endIndex = endIdx === -1 ? currentSql.length : offset + endIdx;

    const extractedStatement = currentSql.substring(startIndex, endIndex).trim();
    
    return extractedStatement || currentSql;
  };

  /**
   * EXECUTION HANDLERS
   */
  const handleRunStatement = () => {
    const statement = getStatementAtCursor();
    checkAndExecute(statement);
  };

  const handleRunScript = () => {
    if (!editorRef.current) return;
    checkAndExecute(editorRef.current.getValue());
  };

  const checkAndExecute = (sqlToRun) => {
    if (!sqlToRun.trim()) return;
    
    const q = sqlToRun.trim().toUpperCase();
    const dangerous = ["DELETE", "DROP", "TRUNCATE", "ALTER"].some((x) => q.startsWith(x));

    if (dangerous) {
      dangerousRef.current?.(sqlToRun);
    } else {
      executeRef.current?.(false, sqlToRun);
    }
  };

  /**
   * STATS CALCULATION
   */
  const isSelect = useMemo(() => {
    const q = query.trim().toUpperCase();
    return q.startsWith("SELECT") || q.startsWith("WITH");
  }, [query]);

  return (
    <Box
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        bgcolor: "#0b1120",
        display: "flex",
        flexDirection: "column",
        flex: 1,
      }}
    >
      {/* HEADER */}
      <Box sx={{ px: 2, py: 1.2, bgcolor: "#111827", color: "white", borderBottom: "1px solid rgba(255,255,255,0.06)" }}>
        <Stack direction="row" justifyContent="space-between" alignItems="center" flexWrap="wrap" gap={1}>
          
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Box
              sx={{
                width: 10, height: 10, borderRadius: "50%", bgcolor: "#22c55e",
                boxShadow: "0 0 12px #22c55e", animation: "pulse 1.5s infinite",
                "@keyframes pulse": { "0%": { opacity: 0.5 }, "50%": { opacity: 1 }, "100%": { opacity: 0.5 } }
              }}
            />
            <Terminal fontSize="small" />
            <Typography fontWeight={800}>SQL Worksheet</Typography>
            <Typography variant="caption" sx={{ opacity: 0.7, ml: 2 }}>
              Ctrl+Enter: Run Statement | F5: Run Script
            </Typography>
          </Stack>

          <Stack direction="row" spacing={1} alignItems="center">
            <Tooltip title="Copy SQL">
              <IconButton size="small" onClick={() => navigator.clipboard.writeText(query)}>
                <ContentCopy sx={{ color: "white" }} />
              </IconButton>
            </Tooltip>

            <Tooltip title="Clear">
              <IconButton size="small" onClick={() => setQuery("")}>
                <CleaningServices sx={{ color: "white" }} />
              </IconButton>
            </Tooltip>

            <Divider orientation="vertical" flexItem sx={{ borderColor: "rgba(255,255,255,0.08)", mx: 1 }} />

            <Tooltip title="Run statement at cursor (Ctrl+Enter)">
              <Button
                variant="contained"
                disableElevation
                startIcon={loading ? <CircularProgress size={16} color="inherit" /> : <PlayArrow />}
                onClick={handleRunStatement}
                sx={{
                  borderRadius: 2, px: 2, fontWeight: 700,
                  background: "linear-gradient(135deg,#10b981,#059669)",
                  boxShadow: "0 4px 15px rgba(16,185,129,0.25)",
                  "&:hover": { transform: "translateY(-1px)" },
                }}
              >
                Statement
              </Button>
            </Tooltip>

            <Tooltip title="Run entire script (F5)">
              <Button
                variant="contained"
                disableElevation
                startIcon={loading ? <CircularProgress size={16} color="inherit" /> : <PlaylistPlay />}
                onClick={handleRunScript}
                sx={{
                  borderRadius: 2, px: 2, fontWeight: 700,
                  background: "linear-gradient(135deg,#2563eb,#3b82f6)",
                  boxShadow: "0 4px 15px rgba(37,99,235,0.25)",
                  "&:hover": { transform: "translateY(-1px)" },
                }}
              >
                Script
              </Button>
            </Tooltip>

          </Stack>
        </Stack>
      </Box>

      {/* QUICK COMMANDS */}
      <Box sx={{ px: 2, py: 1, bgcolor: "#0f172a", borderBottom: "1px solid rgba(255,255,255,0.05)" }}>
        <Stack direction="row" spacing={1} flexWrap="wrap">
          {quickCommands.map((cmd) => (
            <Chip
              key={cmd}
              label={cmd}
              clickable
              onClick={() => setQuery(query ? query + "\n\n" + cmd : cmd)}
              sx={{ bgcolor: "rgba(255,255,255,0.06)", color: "white", "&:hover": { bgcolor: "rgba(255,255,255,0.12)" } }}
            />
          ))}
        </Stack>
      </Box>

      {/* MONACO EDITOR */}
      <Box sx={{ flex: 1, minHeight: 350, pt: 1, bgcolor: "#1e1e1e" }}>
        <Editor
          height="100%"
          defaultLanguage="sql"
          theme="vs-dark"
          value={query}
          onChange={(val) => setQuery(val || "")}
          onMount={handleEditorDidMount}
          options={{
            minimap: { enabled: false },
            fontSize: 14,
            fontFamily: "'Fira Code', 'Courier New', monospace",
            wordWrap: "on",
            scrollBeyondLastLine: false,
            padding: { top: 16 },
            smoothScrolling: true,
            cursorBlinking: "smooth",
          }}
        />
      </Box>

      {/* FOOTER STATUS */}
      <Box sx={{ px: 2, py: 1, borderTop: "1px solid rgba(255,255,255,0.06)", bgcolor: "#111827" }}>
        <Stack direction="row" spacing={1} alignItems="center" flexWrap="wrap">
          <CustomChip
            size="small" variant="outlined" label={isSelect ? "Read Mode" : "Mixed Mode"}
            color={isSelect ? "success" : "info"}
          />
          <CustomChip
            size="small" variant="outlined" label={`${query.length} chars`}
            sx={{ color: "white", borderColor: "rgba(255,255,255,0.2)" }}
          />
          <CustomChip
            size="small" variant="outlined" label={`${query.split(";").filter(x => x.trim() && !x.trim().startsWith("--")).length} statements`}
            sx={{ color: "white", borderColor: "rgba(255,255,255,0.2)" }}
          />
          <CustomChip
            size="small" variant="outlined" icon={<Timer />}
            label={loading ? "Executing..." : "Ready"} color={loading ? "warning" : "success"}
          />
        </Stack>
      </Box>
    </Box>
  );
};

export default CommandPanel;