import React, { useEffect, useState, useRef } from "react";
import { InputAdornment, IconButton, Button } from "@mui/material";
import LockIcon from "@mui/icons-material/Lock";
import Visibility from "@mui/icons-material/Visibility";
import VisibilityOff from "@mui/icons-material/VisibilityOff";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import JSEncrypt from "jsencrypt";
import { StyledTextField, PrimaryButton } from "./LoginStyles";

const LoginWithPassword = ({
  userId,
  publicKey,
  openLoginErrorDialog,
  onBackToHome,
  onPasswordSuccess,
}) => {
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [passwordInvalidMessage, setPasswordInvalidMessage] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const passwordInputRef = useRef(null);

  useEffect(() => {
    if (passwordInputRef.current) {
      passwordInputRef.current.focus();
    }
  }, []);

  const validateUserCredentials = async () => {
    if (!password || password.trim() === "") {
      setPasswordInvalidMessage("Password cannot be empty.");
      passwordInputRef.current?.focus();
      return;
    }

    setIsLoading(true);
    setPasswordInvalidMessage("");

    try {
      if (!publicKey) {
        throw new Error("Could not retrieve encryption key.");
      }

      const encryptor = new JSEncrypt();
      encryptor.setPublicKey(publicKey);
      const encryptedPassword = encryptor.encrypt(password);

      if (!encryptedPassword) {
        throw new Error("Encryption failed.");
      }

      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/login`,
        {
          userId: userId,
          password: encryptedPassword,
        },
      );

      const result = response?.data?.data || {};

      if (response.status === 202 && response?.data?.success) {
        // Validation passes; proceed to the OTP screen with the data payload
        onPasswordSuccess(result);
      } else {
        openLoginErrorDialog(
          "Login Failed",
          result.message || "Invalid credentials.",
        );
      }
    } catch (e) {
      console.error("Login Error:", e);
      const msg =
        e.response?.data?.message || e.message || "Failed to log into FinCore";
      openLoginErrorDialog("Login Failed", msg);
    } finally {
      setIsLoading(false);
    }
  };

  const handlePasswordKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading && password && password.trim() !== "") {
        validateUserCredentials();
      } else if (!password || password.trim() === "") {
        setPasswordInvalidMessage("Password cannot be empty.");
      }
    }
  };

  return (
    <>
      <StyledTextField
        fullWidth
        inputRef={passwordInputRef}
        label="Password"
        type={showPassword ? "text" : "password"}
        value={password}
        onChange={(e) => {
          setPassword(e.target.value);
          if (passwordInvalidMessage) setPasswordInvalidMessage("");
        }}
        onKeyDown={handlePasswordKeyDown}
        variant="outlined"
        error={!!passwordInvalidMessage}
        helperText={passwordInvalidMessage}
        margin="normal"
        autoComplete="current-password"
        InputProps={{
          startAdornment: (
            <InputAdornment position="start">
              <LockIcon />
            </InputAdornment>
          ),
          endAdornment: (
            <InputAdornment position="end">
              <IconButton
                onClick={() => setShowPassword(!showPassword)}
                edge="end"
              >
                {showPassword ? <Visibility /> : <VisibilityOff />}
              </IconButton>
            </InputAdornment>
          ),
        }}
      />
      <PrimaryButton
        fullWidth
        variant="contained"
        onClick={validateUserCredentials}
        disabled={!userId || isLoading}
      >
        {isLoading ? "Checking Password..." : "Proceed"}
      </PrimaryButton>

      <Button
        startIcon={<ArrowBackIcon />}
        onClick={onBackToHome}
        sx={{ mt: 2, textTransform: "none", color: "text.secondary" }}
        fullWidth
        variant="outlines"
      >
        Back to User ID
      </Button>
    </>
  );
};

export default LoginWithPassword;


import React, { useState, useEffect, useRef } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { Typography, Button, Box, TextField } from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import api from "../../../config/axiosConfig";
import { parseJwt } from "../../../utils/EncryptionUtilities";
import { loginSuccess } from "../../../store/slices/authSlice";
import { setMenus, setSelectedMenuItem } from "../../../store/slices/menuSlice";
import { setTabId } from "../../../store/slices/tabSlice";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  userId,
  otpData,
  openLoginErrorDialog,
  onBackToHome,
}) => {
  const showSnackbar = useCustomSnackbar();
  // Use an array to manage the 6 separate digits
  const [otpValues, setOtpValues] = useState(new Array(6).fill(""));
  const [otpError, setOtpError] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const [wrongAttempts, setWrongAttempts] = useState(0);
  const [resendCount, setResendCount] = useState(0);

  const [currentTxnId, setCurrentTxnId] = useState(
    otpData?.transactionId || "",
  );

  const navigate = useNavigate();
  const dispatch = useDispatch();
  const menus = useSelector((state) => state.menus.menus);

  // Array of refs for our 6 inputs to manage dynamic focusing
  const inputRefs = useRef([]);

  // Focus the first input box when the component mounts
  useEffect(() => {
    if (inputRefs.current[0]) {
      inputRefs.current[0].focus();
    }
  }, []);

  useEffect(() => {
    if (menus && menus.length > 0 && menus[0]?.route) {
      if (menus[0].hasChildren) {
        navigate("/choose-option" + menus[0]?.route);
      } else {
        navigate(menus[0]?.route);
      }
    }
  }, [menus, navigate]);

  // Derived state to get the full string
  const otpString = otpValues.join("");

  const forceResendOTP = async () => {
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      if (res?.data?.data?.transactionId) {
        setCurrentTxnId(res.data.data.transactionId);
      }

      setWrongAttempts(0);
      setOtpValues(new Array(6).fill("")); // Reset all boxes
      setOtpError("3rd invalid attempt: A new OTP has been forcefully sent.");
      inputRefs.current[0]?.focus(); // Re-focus first box
    } catch (err) {
      console.error("Forced OTP generation fault:", err);
      openLoginErrorDialog(
        "System Error",
        "Failed to cycle a new validation token automatically.",
      );
    }
  };

  const handleResendClick = async () => {
    if (resendCount >= 3) {
      openLoginErrorDialog(
        "Limit Reached",
        "Maximum manual resend limit reached (3 times).",
      );
      return;
    }

    setIsLoading(true);
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      if (res?.data?.data?.transactionId) {
        setCurrentTxnId(res.data.data.transactionId);
      }

      setResendCount((prev) => prev + 1);
      setWrongAttempts(0);
      setOtpValues(new Array(6).fill(""));
      setOtpError("");
      openLoginErrorDialog(
        "OTP Resent",
        `Verification code sent. (${resendCount + 1}/3 resends used)`,
      );
      inputRefs.current[0]?.focus();
    } catch (err) {
      const msg =
        err.response?.data?.message || "Failed to resend authentication code.";
      openLoginErrorDialog("Resend Failed", msg);
    } finally {
      setIsLoading(false);
    }
  };

  const handleVerifyOTP = async () => {
    if (otpString.length !== 6) {
      setOtpError("Please complete the 6-digit verification code.");
      return;
    }

    setIsLoading(true);
    setOtpError("");

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          userId,
          transactionId: currentTxnId,
          otp: otpString,
        },
      );

      const isSuccess =
        response?.data?.success === true ||
        response?.data?.data?.validOtp === true;
      const result = response?.data?.data || {};

      if (isSuccess) {
        if (result?.roleData?.root_menus?.length === 0) {
          openLoginErrorDialog(
            "Access Denied",
            "You don't have enough permissions to access this application.",
          );
          return;
        }

        const user = parseJwt(result.accessToken);
        const tabId = crypto.randomUUID();

        dispatch(loginSuccess({ token: result.accessToken, user }));
        localStorage.setItem(
          "payloadEncryptionKey",
          result.payloadEncryptionKey,
        );

        dispatch(setTabId(tabId));
        dispatch(setMenus(result.roleData.root_menus));
        dispatch(setSelectedMenuItem(result.roleData.root_menus[0]));

        const bc = new BroadcastChannel("auth");
        setTimeout(() => {
          bc.postMessage({
            type: "USER_LOGGED_IN",
            tabId,
            userId: user.userId,
          });
        }, 1000);
      } else {
        const targetFailures = wrongAttempts + 1;
        setWrongAttempts(targetFailures);

        if (targetFailures >= 3) {
          await forceResendOTP();
        } else {
          setOtpError(
            response?.data?.message ||
              `Invalid validation code. Attempt ${targetFailures} of 3 before token reset.`,
          );
        }
      }
    } catch (e) {
      console.error("OTP Verification Exception Context:", e);
      const msg =
        e.response?.data?.message ||
        "Network exception during verification layer lookup.";
      openLoginErrorDialog("Verification Failure", msg);
    } finally {
      setIsLoading(false);
    }
  };

  // === OTP INPUT LOGIC ===
  const handleOtpChange = (index, e) => {
    const val = e.target.value;
    if (/[^0-9]/.test(val)) return; // Reject non-numeric input

    const newOtpValues = [...otpValues];
    // If the user somehow typed multiple characters, grab only the last one
    newOtpValues[index] = val.substring(val.length - 1);
    setOtpValues(newOtpValues);
    if (otpError) setOtpError("");

    // Automatically shift focus to the next box
    if (val && index < 5) {
      inputRefs.current[index + 1].focus();
    }
  };

  const handleOtpKeyDown = (index, e) => {
    if (e.key === "Backspace") {
      if (!otpValues[index] && index > 0) {
        // If current box is empty, jump back one and clear it
        const newOtpValues = [...otpValues];
        newOtpValues[index - 1] = "";
        setOtpValues(newOtpValues);
        inputRefs.current[index - 1].focus();
      } else if (otpValues[index]) {
        // If current box has a value, just clear it
        const newOtpValues = [...otpValues];
        newOtpValues[index] = "";
        setOtpValues(newOtpValues);
      }
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading && otpString.length === 6) {
        handleVerifyOTP();
      }
    }
  };

  const handleOtpPaste = (e) => {
    e.preventDefault();
    const pasteData = e.clipboardData
      .getData("text/plain")
      .replace(/\D/g, "")
      .slice(0, 6);
    if (!pasteData) return;

    const newOtpValues = [...otpValues];
    for (let i = 0; i < pasteData.length; i++) {
      newOtpValues[i] = pasteData[i];
    }
    setOtpValues(newOtpValues);
    if (otpError) setOtpError("");

    // Focus the box immediately after the last pasted digit (or the last box if 6 digits pasted)
    const focusIndex = pasteData.length < 6 ? pasteData.length : 5;
    inputRefs.current[focusIndex]?.focus();
  };

  return (
    <>
      <Box
        sx={{
          mb: 3,
          p: 2,
          bgcolor: "rgba(0,0,0,0.03)",
          borderRadius: 2,
          border: "1px solid rgba(0,0,0,0.06)",
        }}
      >
        <Typography
          variant="body2"
          color="text.secondary"
          sx={{ mb: 1, fontWeight: 500 }}
        >
          Verification code sent securely to:
        </Typography>

        {otpData?.maskedMobile && (
          <Box
            sx={{ display: "flex", alignItems: "center", gap: 1.5, mb: 0.75 }}
          >
            <PhoneAndroidIcon sx={{ fontSize: 18, color: "primary.main" }} />
            <Typography variant="subtitle2" color="text.primary">
              {otpData.maskedMobile}
            </Typography>
          </Box>
        )}

        {otpData?.maskedEmail && (
          <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
            <EmailIcon sx={{ fontSize: 18, color: "primary.main" }} />
            <Typography variant="subtitle2" color="text.primary">
              {otpData.maskedEmail}
            </Typography>
          </Box>
        )}
      </Box>

      {/* STYLISH 6-BOX OTP RENDER */}
      <Box
        sx={{
          display: "flex",
          justifyContent: "space-between",
          gap: { xs: 0.5, sm: 1 },
          mb: 1,
        }}
      >
        {otpValues.map((val, idx) => (
          <TextField
            key={idx}
            inputRef={(el) => (inputRefs.current[idx] = el)}
            value={val}
            onChange={(e) => handleOtpChange(idx, e)}
            onKeyDown={(e) => handleOtpKeyDown(idx, e)}
            onPaste={handleOtpPaste}
            disabled={isLoading}
            variant="outlined"
            error={!!otpError}
            inputProps={{
              inputMode: "numeric",
              pattern: "[0-9]*",
            }}
            sx={{
              flex: 1,
              "& .MuiOutlinedInput-root": {
                borderRadius: 2,
                bgcolor: "background.paper",
                height: { xs: "50px", sm: "60px" },
              },
              "& .MuiOutlinedInput-input": {
                textAlign: "center",
                fontSize: { xs: "1.2rem", sm: "1.5rem" },
                fontWeight: 700,
                padding: 0,
                color: "text.primary",
              },
              "& .MuiOutlinedInput-root.Mui-focused .MuiOutlinedInput-notchedOutline":
                {
                  borderWidth: "2px",
                  borderColor: "primary.main",
                },
            }}
          />
        ))}
      </Box>

      {/* Error / Resend Helper Text */}
      <Box sx={{ minHeight: "24px", mb: 2, px: 1 }}>
        {otpError ? (
          <Typography
            variant="caption"
            color="error.main"
            sx={{ fontWeight: 500 }}
          >
            {otpError}
          </Typography>
        ) : (
          <Typography variant="caption" color="text.secondary">
            Resends Used: {resendCount}/3
          </Typography>
        )}
      </Box>

      <PrimaryButton
        fullWidth
        variant="contained"
        onClick={handleVerifyOTP}
        disabled={isLoading || otpString.length !== 6}
      >
        {isLoading ? "Verifying..." : "Verify & Sign In"}
      </PrimaryButton>

      <Box
        display="flex"
        justifyContent="space-between"
        alignItems="center"
        mt={3}
      >
        <Button
          startIcon={<ArrowBackIcon />}
          onClick={onBackToHome}
          sx={{ textTransform: "none", color: "text.secondary" }}
          size="small"
        >
          Restart Login
        </Button>

        <Button
          startIcon={<RefreshIcon />}
          onClick={handleResendClick}
          disabled={resendCount >= 3 || isLoading}
          sx={{ textTransform: "none" }}
          size="small"
        >
          Resend OTP
        </Button>
      </Box>
    </>
  );
};

export default LoginWithOTP;

import React, { useEffect, useRef, useState } from "react";
import axios from "axios";
import { Box, InputAdornment } from "@mui/material";
import PersonIcon from "@mui/icons-material/Person";
import LogoImg from "../../../assets/Logos/Fincore_transperent.svg";
import LoginErrorDialog from "./LoginErrorDialog";
import LoginWithPassword from "./LoginWithPassword";
import LoginWithOTP from "./LoginWithOTP";
import fTitle from "../../../assets/Logos/Fincore_title.png";
import UpdatePassword from "./UpdatePassword";
import {
  Root,
  ContainerInner,
  Content,
  LeftCol,
  RightCol,
  LogoWrap,
  BrandSub,
  BigHeading,
  SubText,
  FeatureList,
  FeatureItem,
  Bullet,
  GlassCard,
  FormTitle,
  StyledTextField,
  PrimaryButton,
  SubHeadingText,
} from "./LoginStyles";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import Copyright from "../../../components/Copyright";

export default function LoginPort() {
  const [content, setContent] = useState(null);

  useEffect(() => {
    const loadContent = async () => {
      try {
        const res = await axios.get("/loginContent.json");
        setContent(res.data);
      } catch (err) {
        console.error("Failed to load content JSON:", err);
      }
    };
    loadContent();
  }, []);

  const [userId, setUserId] = useState("");
  const [error, setError] = useState("");
  const [page, setPage] = useState("HOME"); // HOME | PASSWORD | UPDATE | OTP
  const [dialogHeading, setDialogHeading] = useState("");
  const [dialogContent, setDialogContent] = useState("");
  const [showErrorDialog, setShowErrorDialog] = useState(false);
  const [loading, setLoading] = useState(false);
  const [userIdDisabled, setUserIdDisabled] = useState(false);
  const [publicKey, setPublicKey] = useState(null);
  const [otpData, setOtpData] = useState(null);

  const userIdInputRef = useRef(null);

  useEffect(() => {
    const timer = setTimeout(() => {
      if (userIdInputRef.current) {
        userIdInputRef.current.focus();
      }
    }, 100);
    return () => clearTimeout(timer);
  }, []);

  const handleDialogClose = () => {
    setShowErrorDialog(false);
    setDialogHeading("");
    setDialogContent("");
  };

  const openLoginErrorDialog = (heading, content) => {
    setDialogHeading(heading);
    setDialogContent(content);
    setShowErrorDialog(true);
  };

  const validateId = (id) => {
    if (!id) return false;
    const v = id.trim().toLowerCase();
    const regex = /^(?:\d{7}|v\d{7}|tcs\d{7}|tcsv\d{7})$/;
    return regex.test(v);
  };

  const handleUserIdChange = (raw) => {
    if (userIdDisabled) return;
    let val = (raw || "").replace(/\s+/g, "");
    const m = val.match(/^([A-Za-z]*)(.*)$/);
    let prefixCandidate = (m && m[1]) || "";
    let rest = (m && m[2]) || "";

    const prefixLow = prefixCandidate.toLowerCase();
    const allowedPrefixList = ["", "t", "tc", "tcs", "tcsv", "v"];
    if (!allowedPrefixList.some((p) => prefixLow?.startsWith(p))) {
      prefixCandidate = "";
    }

    const prefix = prefixCandidate;
    let digitsPart = rest.replace(/\D/g, "");
    if (digitsPart.length > 7) digitsPart = digitsPart.slice(0, 7);

    const newVal = prefix + digitsPart;
    if (
      digitsPart.length < 8 &&
      allowedPrefixList.some((p) => p.startsWith(prefix?.toLowerCase()))
    ) {
      setUserId(newVal);
    }
    if (error) setError("");
  };

  const handleUserIdPaste = (e) => {
    e.preventDefault();
    const paste = (e.clipboardData || window.clipboardData).getData("text");
    handleUserIdChange(paste);
  };

  const checkUser = async () => {
    setError("");
    if (!validateId(userId)) {
      setError("Invalid User ID");
      userIdInputRef.current?.focus();
      return;
    }

    try {
      setLoading(true);
      const payloadUserId = userId.trim();
      const res = await axios.post(`${resolveConfig("/LS")}/auth/check-user`, {
        userId: payloadUserId,
      });

      const result = res?.data?.data || {};

      if (result?.userStatus === "RESTRICTED") {
        openLoginErrorDialog(
          "Access Restricted",
          "This system is restricted to use FinCore, Please contact the administrator.",
        );
        return;
      }
      if (result?.userStatus === "INVALID") {
        setError("User ID does not exist");
        return;
      }
      if (result?.passwordLoginStatus === "INACTIVE") {
        openLoginErrorDialog(
          "Password Locked!",
          "You cannot login using password currently. Please contact the administrator.",
        );
        return;
      }
      if (result?.updatePassword === true) {
        setPublicKey(result?.publicKey);
        setPage("UPDATE");
        setUserIdDisabled(true);
        return;
      }
      if (
        result?.userStatus === "ACTIVE" &&
        result?.passwordLoginStatus === "ACTIVE"
      ) {
        setPublicKey(result?.publicKey);
        setPage("PASSWORD");
        setUserIdDisabled(true);
        return;
      }

      openLoginErrorDialog(
        "Login Not Allowed",
        result?.message || "Please contact the administrator.",
      );
    } catch (err) {
      console.error("checkUser error:", err);
      openLoginErrorDialog(
        "Login Error",
        "Something went wrong, please try again later.",
      );
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (page === "HOME") checkUser();
  };

  const handlePasswordUpdateSuccess = () => {
    setPage("PASSWORD");
    setUserIdDisabled(true);
  };

  const enableEditingBackToHome = () => {
    setPage("HOME");
    setUserIdDisabled(false);
    setError("");
    setUserId("");
    setOtpData(null);
  };

  const handlePasswordSuccess = (data) => {
    setOtpData(data);
    setPage("OTP");
  };

  if (!content) return null;

  return (
    <Root sx={{ justifyContent: "space-between", padding: 0 }}>
      {/* ADDED RESPONSIVE PADDING HERE 
        px adds left/right margin on mobile so nothing touches the screen edges.
        py adds breathing room to the top and bottom.
      */}
      <Box
        sx={{
          flexGrow: 1,
          display: "flex",
          alignItems: "center",
          width: "100%",
          py: { xs: 4, md: 6 },
          px: { xs: 2.5, sm: 4, md: 6 },
        }}
      >
        <ContainerInner>
          {/* ADDED RESPONSIVE GAP HERE
            Creates vertical spacing between the left-side text and right-side card on mobile.
          */}
          <Content
            sx={{
              display: "flex",
              flexDirection: { xs: "column", md: "row" },
              gap: { xs: 5, md: 4 },
            }}
          >
            <LeftCol>
              <LogoWrap>
                <Box
                  component="img"
                  src={LogoImg}
                  alt="Logo Icon"
                  sx={{
                    width: { xs: 100, sm: 130, md: 150 },
                    height: "auto",
                    // objectFit: "contain",
                  }}
                />
                <Box sx={{ textAlign: { xs: "center", md: "left" } }}>
                  <Box
                    component="img"
                    src={fTitle}
                    alt="FinCore"
                    sx={{
                      height: { xs: 28, md: 35 },
                      width: "auto",
                      mx: { xs: "auto", md: 0 },
                      mt: { xs: 2, md: 5 },
                      mb: 1,
                    }}
                  />
                  <BrandSub>{content?.brand?.subtitle}</BrandSub>
                </Box>
              </LogoWrap>

              <Box
                sx={{
                  display: { xs: "none", md: "block" },
                  mt: 2,
                  mb: 1,
                  textAlign: { xs: "center", md: "left" },
                }}
              >
                <BigHeading>
                  {(content?.hero?.welcomeTitle || "").split(" - ")[0]}
                </BigHeading>
                {content?.hero?.welcomeTitle?.includes(" - ") && (
                  <SubHeadingText>
                    {content?.hero?.welcomeTitle.split(" - ")[1]}
                  </SubHeadingText>
                )}
              </Box>

              <SubText
                sx={{
                  display: { xs: "none", md: "block" },
                  textAlign: { xs: "center", md: "left" },
                }}
              >
                {content?.hero?.subText}
              </SubText>

              <Box sx={{ display: { xs: "none", md: "block" }, mt: 3 }}>
                <BigHeading>{content?.legal?.title}</BigHeading>
                <FeatureList sx={{ mt: 2 }}>
                  {content?.legal?.items.map((item, idx) => (
                    <FeatureItem key={idx}>
                      <Bullet /> {item}
                    </FeatureItem>
                  ))}
                </FeatureList>
              </Box>
            </LeftCol>

            <RightCol
              sx={{
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                width: "100%",
              }}
            >
              <GlassCard elevation={3} sx={{ width: "100%" }}>
                <FormTitle>
                  {page === "OTP"
                    ? "Two-Factor Verification"
                    : content?.form?.signIn}
                </FormTitle>

                <form onSubmit={handleSubmit} noValidate>
                  {page !== "OTP" && (
                    <StyledTextField
                      fullWidth
                      inputRef={userIdInputRef}
                      label="User ID"
                      placeholder={content?.form?.userIdPlaceholder}
                      margin="dense"
                      value={userId}
                      onChange={(e) => handleUserIdChange(e.target.value)}
                      onPaste={handleUserIdPaste}
                      error={Boolean(error)}
                      helperText={error || " "}
                      disabled={userIdDisabled}
                      InputProps={{
                        startAdornment: (
                          <InputAdornment position="start">
                            <PersonIcon />
                          </InputAdornment>
                        ),
                      }}
                    />
                  )}

                  {page === "HOME" && (
                    <PrimaryButton
                      type="submit"
                      variant="contained"
                      disabled={loading}
                    >
                      {loading
                        ? content?.form?.checking
                        : content?.form?.signInButton}
                    </PrimaryButton>
                  )}

                  {page === "PASSWORD" && (
                    <Box>
                      <LoginWithPassword
                        userId={userId}
                        publicKey={publicKey}
                        openLoginErrorDialog={openLoginErrorDialog}
                        onBackToHome={enableEditingBackToHome}
                        onPasswordSuccess={handlePasswordSuccess}
                      />
                    </Box>
                  )}

                  {page === "OTP" && (
                    <Box>
                      <LoginWithOTP
                        userId={userId}
                        otpData={otpData}
                        openLoginErrorDialog={openLoginErrorDialog}
                        onBackToHome={enableEditingBackToHome}
                      />
                    </Box>
                  )}

                  {page === "UPDATE" && (
                    <Box>
                      <UpdatePassword
                        userId={userId}
                        publicKey={publicKey}
                        openLoginErrorDialog={openLoginErrorDialog}
                        onUpdateSuccess={handlePasswordUpdateSuccess}
                      />
                    </Box>
                  )}
                </form>
              </GlassCard>

              <Box
                sx={{
                  display: { xs: "block", md: "none" },
                  mt: 5,
                  width: "100%",
                }}
              >
                <BigHeading
                  sx={{
                    fontSize: { xs: "1.2rem", md: "1.5rem" },
                    textAlign: "center",
                    mb: 2,
                  }}
                >
                  {content?.legal?.title}
                </BigHeading>
                <FeatureList>
                  {content?.legal?.items.map((item, idx) => (
                    <FeatureItem
                      key={idx}
                      sx={{
                        fontSize: { xs: "0.875rem", sm: "1rem" },
                      }}
                    >
                      <Bullet /> <span style={{ flex: 1 }}>{item}</span>
                    </FeatureItem>
                  ))}
                </FeatureList>
              </Box>
            </RightCol>
          </Content>
        </ContainerInner>
      </Box>

      {/* FOOTER */}
      <Box sx={{ width: "100%", zIndex: 2 }}>
        <Copyright />
      </Box>

      <LoginErrorDialog
        showErrorDialog={showErrorDialog}
        title={dialogHeading}
        content={dialogContent}
        onDialogClose={handleDialogClose}
      />
    </Root>
  );
}

