WITH filteredbranches AS (
    SELECT
        branch_code
    FROM
        bs_branch
    WHERE
        branch_circle = '002'
)
SELECT
    TO_CHAR(cd_identifier) AS id,
    SUM(TO_NUMBER(cd_amount)) AS amt
FROM
    bs_dicgc_bid_con
WHERE
        cd_date = TO_DATE('31/12/2025', 'dd/mm/yyyy')
    AND cd_branch IN (SELECT branch_code FROM filteredbranches)
    AND cd_identifier < '1000'
    AND cd_identifier NOT IN ( '220', '230', '250', '260', '280',
                               '290', '310', '320', '340', '350',
                               '360', '370', '380', '390', '400',
                               '410', '420', '430' )
GROUP BY
    TO_CHAR(cd_identifier)

UNION ALL

SELECT
    TO_CHAR(gd_identifier) AS id,
    /* We convert everything to NUMBER inside the SUM so math works */
    SUM(
        TO_NUMBER(
            CASE 
                WHEN gd_identifier = '340' THEN 
                    CASE WHEN gd_modified_flag = 'Y' THEN gd_final_amount ELSE '0' END
                ELSE gd_final_amount 
            END
        )
    ) AS amt
FROM
    bs_dicgc_bid_granular
WHERE
        gd_quarter_end_date = TO_DATE('31/12/2025', 'dd/mm/yyyy')
    AND gd_branch_no IN (SELECT branch_code FROM filteredbranches)
    AND gd_identifier IN ( '220', '230', '250', '260', '280',
                           '290', '310', '320', '340', '350',
                           '360', '370', '380', '390', '400',
                           '410', '420', '430' )
GROUP BY
    TO_CHAR(gd_identifier)
ORDER BY
    1;
    
SELECT gd_identifier, gd_modified_flag, COUNT(*) 
FROM bs_dicgc_bid_granular 
WHERE gd_quarter_end_date = TO_DATE('31/12/2025', 'dd/mm/yyyy')
GROUP BY gd_identifier, gd_modified_flag;

