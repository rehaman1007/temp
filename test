import React, { useState, useEffect, useCallback } from "react";
import { Chip, IconButton, Tooltip } from "@mui/material";
import SearchIcon from "@mui/icons-material/Search";
import SearchDialog from "./SearchDialog";

/**
 * SearchBar main component
 * 
 * @author v1018404
 */
const SearchBar = ({ navigateToPage, hideShortcut }) => {
  const [dialogOpen, setDialogOpen] = useState(false);

  const handleOpen = useCallback(() => setDialogOpen(true), []);
  const handleClose = useCallback(() => setDialogOpen(false), []);

  // Add global keyboard listener for Ctrl+K
  useEffect(() => {
    const handleKeyDown = (event) => {
      // Also supports metaKey (Cmd) for Mac users
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        handleOpen();
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => {
      window.removeEventListener("keydown", handleKeyDown);
    };
  }, [handleOpen]);

  return (
    <>
      {hideShortcut ? (
        // Renders ONLY the magnifying glass icon on mobile/tablet devices
        <Tooltip title="Search">
          <IconButton color="inherit" onClick={handleOpen}>
            <SearchIcon />
          </IconButton>
        </Tooltip>
      ) : (
        // Renders the Chip with "Ctrl+K" text on laptops/desktops
        <Chip
          sx={{
            p: 0.5,
            cursor: "pointer", // Added pointer so it feels clickable to the user
            backgroundColor: "background.paper", // Optional: makes the chip pop against the header
            "&:hover": {
               backgroundColor: "action.hover",
            }
          }}
          icon={<SearchIcon />}
          label={"Ctrl+K"}
          onClick={handleOpen}
        />
      )}
      
      {/* Forward the navigateToPage function down to your dialog logic */}
      <SearchDialog 
        open={dialogOpen} 
        handleClose={handleClose} 
        navigateToPage={navigateToPage} 
      />
    </>
  );
};

export default SearchBar;
