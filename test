import React, { useMemo } from "react";
import { Box, Grid, Typography, Divider } from "@mui/material";
import { PieChart, BarChart } from "@mui/x-charts";

export default function RequestAnalytics({ rows }) {
  const chartData = useMemo(() => {
    if (!rows || rows.length === 0) return { pie: [], bar: [], total: 0 };

    const addCount = rows.filter((r) => r.changeType === "ADD").length;
    const deleteCount = rows.filter((r) => r.changeType === "DELETE").length;
    const modifyCount = rows.filter((r) => r.changeType === "MODIFY").length;
    const total = rows.length;

    // Pie data
    const pie = [
      { id: 0, value: addCount, label: "Added" },
      { id: 1, value: deleteCount, label: "Deleted" },
      { id: 2, value: modifyCount, label: "Modified" },
    ];

    // Histogram data by date (daily frequency)
    const freqMap = {};
    rows.forEach((r) => {
      if (r.reqDate) {
        const d = new Date(r.reqDate).toLocaleDateString("en-IN", {
          day: "2-digit",
          month: "short",
        });
        freqMap[d] = (freqMap[d] || 0) + 1;
      }
    });
    const bar = Object.entries(freqMap).map(([label, value]) => ({
      label,
      value,
    }));

    return { pie, bar, total };
  }, [rows]);

  if (!rows?.length) return null;

  return (
    <Box sx={{ mb: 3 }}>
      <Typography variant="h6" sx={{ mb: 1 }}>
        📊 Request Summary
      </Typography>

      <Grid container spacing={2}>
        {/* Pie Chart */}
        <Grid item xs={12} md={4}>
          <PieChart
            series={[
              {
                data: chartData.pie,
                highlightScope: { faded: "global", highlighted: "item" },
                faded: { innerRadius: 30, additionalRadius: -30 },
              },
            ]}
            width={350}
            height={250}
          />
          <Typography align="center" variant="body2">
            Total Pending Requests: {chartData.total}
          </Typography>
        </Grid>

        {/* Histogram */}
        <Grid item xs={12} md={8}>
          <BarChart
            xAxis={[
              {
                scaleType: "band",
                data: chartData.bar.map((b) => b.label),
              },
            ]}
            series={[
              { data: chartData.bar.map((b) => b.value), label: "Requests" },
            ]}
            width={600}
            height={250}
          />
        </Grid>
      </Grid>

      <Divider sx={{ my: 3 }} />
    </Box>
  );
}