import { useEffect, useState } from "react";
import {
  Box,
  Button,
  Typography,
  Paper,
  Container,
  Divider,
  Stack,
  Tooltip,
} from "@mui/material";
import { styled } from "@mui/system";
import LogoImg from "../assets/Logos/Fincore_transperent.svg";
import fTitle from "../assets/Logos/Fincore_title.png";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import { Refresh, Home, ContentCopy, Check } from "@mui/icons-material";

const Background = styled(Box)(() => ({
  position: "absolute",
  inset: 0,
  backgroundImage: "url('/src/assets/glass-bg.jpg')",
  backgroundSize: "cover",
  backgroundPosition: "center",
  opacity: 0.15,
  zIndex: 0,
}));

const BlurOverlay = styled(Box)({
  position: "absolute",
  inset: 0,
  backdropFilter: "blur(40px)",
  zIndex: 1,
});

const Card = styled(Paper)(({ theme }) => ({
  position: "relative",
  zIndex: 2,
  maxWidth: 500,
  width: "100%",
  margin: "auto",
  padding: theme.spacing(4),
  borderRadius: theme.spacing(3),
  backdropFilter: "blur(24px)",
  backgroundColor: "rgba(255, 255, 255, 0.05)",
  border: "1px solid rgba(255,255,255,0.1)",
  textAlign: "center",
  [theme.breakpoints.up("sm")]: {
    padding: theme.spacing(6),
  },
}));

const ServerError = () => {
  const [copied, setCopied] = useState(false);

  // Generate a clean, stable short ID on mount so it doesn't change on every hover/render
  const [referenceId] = useState(
    () => `ERR-${Math.floor(100000 + Math.random() * 900000)}`,
  );

  useEffect(() => {
    console.error("500 Error: Internal server error occurred");
  }, []);

  const handleRefresh = () => {
    window.location.reload();
  };

  const handleCopyReference = async () => {
    try {
      await navigator.clipboard.writeText(referenceId);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      console.error("Failed to copy", err);
    }
  };

  return (
    <Box
      sx={{
        minHeight: "100vh",
        position: "relative",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        p: 2, // Ensures spacing on mobile screens
        background:
          "linear-gradient(to bottom right, rgba(239, 68, 68, 0.08), rgba(0,0,0,0.4))",
      }}
    >
      <Background />
      <BlurOverlay />

      <Container
        maxWidth="sm"
        sx={{ zIndex: 2, display: "flex", justifyContent: "center" }}
      >
        <Card>
          {/* BRANDING LOGO AREA */}
          <Box
            sx={{
              mb: 3,
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              gap: 1,
            }}
          >
            {/* Replace this SVG Box with your actual FinCore Logo asset if available */}
            <Box
              component="div"
              src={LogoImg}
              sx={{
                width: 32,
                height: 32,
                borderRadius: "6px",
                backgroundColor: "primary.main",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                fontWeight: "bold",
                color: "#fff",
                fontSize: "0.9rem",
              }}
            >
              FC
            </Box>
            <Typography
              variant="h6"
              sx={{ fontWeight: 700, letterSpacing: "0.5px" }}
            >
              FinCore
            </Typography>
          </Box>

          {/* ERROR ICON */}
          <Box sx={{ display: "flex", justifyContent: "center", mb: 3 }}>
            <Box
              sx={{
                p: 2,
                borderRadius: "50%",
                backgroundColor: "rgba(239, 68, 68, 0.15)",
                display: "inline-flex",
              }}
            >
              <WarningAmberIcon sx={{ fontSize: 40, color: "#EF4444" }} />
            </Box>
          </Box>

          {/* ERROR CODE & TITLE */}
          <Typography
            variant="h1"
            sx={{
              fontWeight: 800,
              mb: 1,
              background: "linear-gradient(to right, #EF4444, #F97316)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              fontSize: { xs: "2.5rem", sm: "3.5rem" },
            }}
          >
            500
          </Typography>

          <Typography variant="h5" sx={{ mb: 2, fontWeight: 600 }}>
            Internal Server Error
          </Typography>

          <Typography
            sx={{ color: "text.secondary", mb: 4, fontSize: "0.95rem" }}
          >
            Our systems are experiencing technical difficulties. Our engineering
            team has been automatically notified and is actively working to
            resolve this issue.
          </Typography>

          {/* NOTICE CONTAINER */}
          <Paper
            elevation={0}
            sx={{
              backgroundColor: "rgba(239, 68, 68, 0.04)",
              border: "1px solid rgba(239, 68, 68, 0.15)",
              borderRadius: 2,
              p: 2,
              mb: 4,
            }}
          >
            <Typography
              variant="subtitle2"
              sx={{ color: "#EF4444", fontWeight: 600, mb: 0.5 }}
            >
              Security Guarantee
            </Typography>
            <Typography
              variant="body2"
              sx={{ color: "text.secondary", fontSize: "0.85rem" }}
            >
              Your session remains securely isolated. No unauthorized access has
              occurred. Please try again or check back in a few minutes.
            </Typography>
          </Paper>

          {/* ACTION BUTTONS */}
          <Stack
            spacing={2}
            direction={{ xs: "column", sm: "row" }}
            justifyContent="center"
            mb={4}
          >
            <Button
              onClick={handleRefresh}
              variant="outlined"
              startIcon={<Refresh sx={{ fontSize: 18 }} />}
              fullWidth
              sx={{
                borderColor: "rgba(255,255,255,0.15)",
                color: "text.primary",
                "&:hover": {
                  borderColor: "rgba(255,255,255,0.3)",
                  backgroundColor: "rgba(255,255,255,0.05)",
                },
              }}
            >
              Refresh Page
            </Button>
            <Button
              variant="contained"
              startIcon={<Home sx={{ fontSize: 18 }} />}
              href="/"
              fullWidth
            >
              Return to Login
            </Button>
          </Stack>

          <Divider sx={{ borderColor: "rgba(255,255,255,0.1)", mb: 2 }} />

          {/* CLEAN, ACTIONABLE SUPPORT FOOTER */}
          <Stack
            direction={{ xs: "column", sm: "row" }}
            justifyContent="space-between"
            alignItems="center"
            spacing={1}
          >
            <Typography variant="caption" sx={{ color: "text.secondary" }}>
              FinCore Portal Support
            </Typography>

            <Tooltip
              title={copied ? "Copied!" : "Click to copy support code"}
              placement="top"
            >
              <Button
                size="small"
                variant="text"
                onClick={handleCopyReference}
                startIcon={
                  copied ? (
                    <Check sx={{ fontSize: 14 }} />
                  ) : (
                    <ContentCopy sx={{ fontSize: 14 }} />
                  )
                }
                sx={{
                  color: "text.secondary",
                  textTransform: "none",
                  fontSize: "0.75rem",
                  "&:hover": { color: "primary.main" },
                }}
              >
                Ref: {referenceId}
              </Button>
            </Tooltip>
          </Stack>
        </Card>
      </Container>
    </Box>
  );
};

export default ServerError;
