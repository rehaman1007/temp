	@Override
	public Page<LedgerEnquiryResponse> search(LedgerEnquiryRequest dto, Pageable pageable) {

		String cgl = dto.getCgl();
		List<String> sourceFlags = dto.getSourceFlags();
		String currency = (dto.getCurrencies().equalsIgnoreCase("ALL")) ? null : dto.getCurrencies();
		String fromDate = dto.getFromDate();
		String toDate = dto.getToDate();
		List<String> branches = dto.getBranches();
		String circle = (dto.getCircle().equalsIgnoreCase("ALL")) ? null : dto.getCircle();

		int skipSource = (dto.getSourceFlags().contains("ALL")) ? 1 : 0;
		int skipBranches = (dto.getBranches().contains("ALL")) ? 1 : 0;

		log.info("cgl    " + cgl);
		log.info("sourceFlags   " + sourceFlags);
		log.info("currency    " + currency);
		log.info("fromDate   " + fromDate);
		log.info("toDate   " + toDate);
		log.info("branches   " + branches);
		log.info("circle  " + circle);

		Page<SearchProjection> projectionList = glTransactionsRepository.getSearchList(cgl, skipSource, sourceFlags,
				currency, fromDate, toDate, skipBranches, branches, circle, pageable);
		return projectionList.map(this::mapToResponseDto);
	}

	private LedgerEnquiryResponse mapToResponseDto(SearchProjection searchProjection) {
		log.info("inside mappinggggggggggggggggggg");
		return new LedgerEnquiryResponse(

				searchProjection.getTransactionId(), searchProjection.getBatchId(), searchProjection.getJournalId(),
				searchProjection.getTransactionDate(), searchProjection.getPostDate(), searchProjection.getBranchCode(),
				searchProjection.getBranchName(), searchProjection.getCircleCode(), searchProjection.getCircleName(),
				searchProjection.getCurrency(), searchProjection.getCurrencyName(), searchProjection.getCgl(),
				searchProjection.getDescription(), searchProjection.getNarration(), searchProjection.getDebitAmount(),
				searchProjection.getCreditAmount(), searchProjection.getTransactionCount(),
				searchProjection.getSourceFlag());
	}
	

	@Override
	public byte[] excelExport(LedgerEnquiryRequest dto) {

		String cgl = dto.getCgl();
		List<String> sourceFlags = dto.getSourceFlags();
		String currency = (dto.getCurrencies().equalsIgnoreCase("ALL")) ? null : dto.getCurrencies();
		String fromDate = dto.getFromDate();
		String toDate = dto.getToDate();
		List<String> branches = dto.getBranches();
		String circle = (dto.getCircle().equalsIgnoreCase("ALL")) ? null : dto.getCircle();

		int skipSource = (dto.getSourceFlags().contains("ALL")) ? 1 : 0;
		int skipBranches = (dto.getBranches().contains("ALL")) ? 1 : 0;

		List<SearchProjection> exportContent = glTransactionsRepository.getExportContent(cgl, skipSource, sourceFlags,
				currency, fromDate, toDate, skipBranches, branches, circle);
