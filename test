import React, { useEffect, useRef, useState } from "react";
import axios from "axios";
import { Box, InputAdornment } from "@mui/material";
import PersonIcon from "@mui/icons-material/Person";
import LogoImg from "../../../assets/Logos/Fincore_transperent.svg";
import LoginErrorDialog from "./LoginErrorDialog";
import LoginWithPassword from "./LoginWithPassword";
import LoginWithOtp from "./LoginWithOtp"; // NEW COMPONENT
import fTitle from "../../../assets/Logos/Fincore_title.png";
import UpdatePassword from "./UpdatePassword";
import {
  Root, ContainerInner, Content, LeftCol, RightCol,
  LogoWrap, BrandSub, BigHeading, SubText, FeatureList,
  FeatureItem, Bullet, GlassCard, FormTitle, StyledTextField,
  PrimaryButton, SubHeadingText,
} from "./LoginStyles";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import Copyright from "../../../components/Copyright";

export default function LoginPort() {
  const [content, setContent] = useState(null);

  useEffect(() => {
    const loadContent = async () => {
      try {
        const res = await axios.get("/loginContent.json");
        setContent(res.data);
      } catch (err) {
        console.error("Failed to load content JSON:", err);
      }
    };
    loadContent();
  }, []);

  // === STATES ===
  const [userId, setUserId] = useState("");
  const [error, setError] = useState("");
  const [page, setPage] = useState("HOME"); // HOME | PASSWORD | OTP | UPDATE
  const [dialogHeading, setDialogHeading] = useState("");
  const [dialogContent, setDialogContent] = useState("");
  const [showErrorDialog, setShowErrorDialog] = useState(false);
  const [loading, setLoading] = useState(false);
  const [userIdDisabled, setUserIdDisabled] = useState(false);
  const [publicKey, setPublicKey] = useState(null);

  const userIdInputRef = useRef(null);

  useEffect(() => {
    const timer = setTimeout(() => {
      if (userIdInputRef.current) userIdInputRef.current.focus();
    }, 100);
    return () => clearTimeout(timer);
  }, []);

  // === DIALOG HANDLERS ===
  const handleDialogClose = () => {
    setShowErrorDialog(false);
    setDialogHeading("");
    setDialogContent("");
  };

  const openLoginErrorDialog = (heading, content) => {
    setDialogHeading(heading);
    setDialogContent(content);
    setShowErrorDialog(true);
  };

  // === VALIDATION ===
  const validateId = (id) => {
    if (!id) return false;
    const v = id.trim().toLowerCase();
    const regex = /^(?:\d{7}|v\d{7}|tcs\d{7}|tcsv\d{7})$/;
    return regex.test(v);
  };

  // === INPUT RESTRICTIONS ===
  const handleUserIdChange = (raw) => {
    if (userIdDisabled) return;
    let val = (raw || "").replace(/\s+/g, "");
    const m = val.match(/^([A-Za-z]*)(.*)$/);
    let prefixCandidate = (m && m[1]) || "";
    let rest = (m && m[2]) || "";

    const allowedPrefixList = ["", "t", "tc", "tcs", "tcsv", "v"];
    if (!allowedPrefixList.some((p) => prefixCandidate.toLowerCase().startsWith(p))) {
      prefixCandidate = "";
    }

    let digitsPart = rest.replace(/\D/g, "");
    if (digitsPart.length > 7) digitsPart = digitsPart.slice(0, 7);

    const newVal = prefixCandidate + digitsPart;
    if (digitsPart.length < 8 && allowedPrefixList.some((p) => p.startsWith(prefixCandidate?.toLowerCase()))) {
      setUserId(newVal);
    }
    if (error) setError("");
  };

  const handleUserIdPaste = (e) => {
    e.preventDefault();
    const paste = (e.clipboardData || window.clipboardData).getData("text");
    handleUserIdChange(paste);
  };

  // === API CALL: CHECK USER ===
  const checkUser = async () => {
    setError("");
    if (!validateId(userId)) {
      setError("Invalid User ID");
      userIdInputRef.current?.focus();
      return;
    }

    try {
      setLoading(true);
      const res = await axios.post(`${resolveConfig("/LS")}/auth/check-user`, {
        userId: userId.trim(),
      });
      const result = res?.data?.data || {};

      if (result?.userStatus === "RESTRICTED") {
        openLoginErrorDialog("Access Restricted", "This system is restricted. Contact admin.");
        return;
      }
      if (result?.userStatus === "INVALID") {
        setError("User ID does not exist");
        return;
      }
      if (result?.passwordLoginStatus === "INACTIVE") {
        openLoginErrorDialog("Password Locked!", "Login using password disabled. Contact admin.");
        return;
      }
      if (result?.updatePassword === true) {
        setPublicKey(result?.publicKey);
        setPage("UPDATE");
        setUserIdDisabled(true);
        return;
      }
      if (result?.userStatus === "ACTIVE" && result?.passwordLoginStatus === "ACTIVE") {
        setPublicKey(result?.publicKey);
        setPage("PASSWORD");
        setUserIdDisabled(true);
        return;
      }
      openLoginErrorDialog("Login Not Allowed", result?.message || "Contact admin.");
    } catch (err) {
      openLoginErrorDialog("Login Error", "Something went wrong, please try again later.");
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (page === "HOME") checkUser();
  };

  const enableEditingBackToHome = () => {
    setPage("HOME");
    setUserIdDisabled(false);
    setError("");
    setUserId("");
  };

  if (!content) return null;

  return (
    <Root>
      <ContainerInner>
        <Content>
          <LeftCol>
            <LogoWrap>
              <Box component="img" src={LogoImg} alt="Logo Icon" sx={{ width: 150, height: 150, objectFit: "contain" }} />
              <div>
                <Box component="img" src={fTitle} alt="FinCore" sx={{ height: 35, width: "auto", display: "block", mt: 5, mb: 1 }} />
                <BrandSub>{content?.brand?.subtitle}</BrandSub>
              </div>
            </LogoWrap>
            <Box sx={{ mb: 1 }}>
              <BigHeading>{(content?.hero?.welcomeTitle || "").split(" - ")[0]}</BigHeading>
              {content?.hero?.welcomeTitle?.includes(" - ") && (
                <SubHeadingText>{content?.hero?.welcomeTitle.split(" - ")[1]}</SubHeadingText>
              )}
            </Box>
            <SubText>{content?.hero?.subText}</SubText>
            <BigHeading>{content?.legal?.title}</BigHeading>
            <FeatureList>
              {content?.legal?.items.map((item, idx) => (
                <FeatureItem key={idx}><Bullet /> {item}</FeatureItem>
              ))}
            </FeatureList>
          </LeftCol>

          <RightCol>
            <GlassCard elevation={3}>
              <FormTitle>{content?.form?.signIn}</FormTitle>
              <form onSubmit={handleSubmit} noValidate>
                <StyledTextField
                  fullWidth
                  inputRef={userIdInputRef}
                  label="User ID"
                  placeholder={content?.form?.userIdPlaceholder}
                  margin="dense"
                  value={userId}
                  onChange={(e) => handleUserIdChange(e.target.value)}
                  onPaste={handleUserIdPaste}
                  error={Boolean(error)}
                  helperText={error || " "}
                  disabled={userIdDisabled}
                  InputProps={{
                    startAdornment: <InputAdornment position="start"><PersonIcon /></InputAdornment>,
                  }}
                />

                {page === "HOME" && (
                  <PrimaryButton type="submit" variant="contained" disabled={loading}>
                    {loading ? content?.form?.checking : content?.form?.signInButton}
                  </PrimaryButton>
                )}

                {page === "PASSWORD" && (
                  <LoginWithPassword
                    userId={userId}
                    publicKey={publicKey}
                    openLoginErrorDialog={openLoginErrorDialog}
                    onPasswordSuccess={() => setPage("OTP")}
                    onBackToHome={enableEditingBackToHome}
                  />
                )}

                {page === "OTP" && (
                  <LoginWithOtp 
                    userId={userId}
                    openLoginErrorDialog={openLoginErrorDialog}
                    onBackToHome={enableEditingBackToHome}
                  />
                )}

                {page === "UPDATE" && (
                  <UpdatePassword
                    userId={userId}
                    publicKey={publicKey}
                    openLoginErrorDialog={openLoginErrorDialog}
                    onUpdateSuccess={() => setPage("PASSWORD")}
                  />
                )}
              </form>
            </GlassCard>
          </RightCol>
        </Content>
      </ContainerInner>

      <LoginErrorDialog
        showErrorDialog={showErrorDialog}
        title={dialogHeading}
        content={dialogContent}
        onDialogClose={handleDialogClose}
      />
      <Box sx={{ position: "absolute", left: 0, bottom: 0, right: 0 }}><Copyright /></Box>
    </Root>
  );
}






import React, { useEffect, useState, useRef } from "react";
import { InputAdornment, IconButton } from "@mui/material";
import LockIcon from "@mui/icons-material/Lock";
import Visibility from "@mui/icons-material/Visibility";
import VisibilityOff from "@mui/icons-material/VisibilityOff";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import JSEncrypt from "jsencrypt";
import { StyledTextField, PrimaryButton } from "./LoginStyles";

const LoginWithPassword = ({ userId, publicKey, openLoginErrorDialog, onPasswordSuccess }) => {
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [passwordInvalidMessage, setPasswordInvalidMessage] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const passwordInputRef = useRef(null);

  useEffect(() => {
    if (passwordInputRef.current) passwordInputRef.current.focus();
  }, []);

  const validateUserCredentials = async () => {
    if (!password || password.trim() === "") {
      setPasswordInvalidMessage("Password cannot be empty.");
      passwordInputRef.current?.focus();
      return;
    }

    setIsLoading(true);
    setPasswordInvalidMessage("");

    try {
      if (!publicKey) throw new Error("Could not retrieve encryption key.");
      const encryptor = new JSEncrypt();
      encryptor.setPublicKey(publicKey);
      const encryptedPassword = encryptor.encrypt(password);
      if (!encryptedPassword) throw new Error("Encryption failed.");

      const response = await api.post(`${resolveConfig("/LS") || ""}/auth/login`, {
        userId: userId,
        password: encryptedPassword,
      });

      const result = response?.data?.data || {};

      if (result.validCredentials === true) {
        // Password is correct, move to OTP
        onPasswordSuccess();
      } else {
        if (!result.validCredentials) {
          openLoginErrorDialog("Login Failed", "Invalid credentials.");
        }
        if (result.userStatus === "ACTIVE" && result.loginMethod === "P") {
          if (result.attemptsLeft > 0) {
            setPasswordInvalidMessage(`Invalid credentials. ${result.attemptsLeft} attempts left.`);
          } else {
            openLoginErrorDialog("Account locked", "Your account has been locked.");
          }
        }
      }
    } catch (e) {
      console.error("Login Error:", e);
      const msg = e.response?.data?.message || e.message || "Failed to verify password";
      openLoginErrorDialog("Login Failed", msg);
    } finally {
      setIsLoading(false);
    }
  };

  const handlePasswordKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading && password && password.trim() !== "") {
        validateUserCredentials();
      } else if (!password || password.trim() === "") {
        setPasswordInvalidMessage("Password cannot be empty.");
      }
    }
  };

  return (
    <>
      <StyledTextField
        fullWidth
        inputRef={passwordInputRef}
        label="Password"
        type={showPassword ? "text" : "password"}
        value={password}
        onChange={(e) => {
          setPassword(e.target.value);
          if (passwordInvalidMessage) setPasswordInvalidMessage("");
        }}
        onKeyDown={handlePasswordKeyDown}
        variant="outlined"
        error={!!passwordInvalidMessage}
        helperText={passwordInvalidMessage}
        margin="normal"
        autoComplete="current-password"
        InputProps={{
          startAdornment: <InputAdornment position="start"><LockIcon /></InputAdornment>,
          endAdornment: (
            <InputAdornment position="end">
              <IconButton onClick={() => setShowPassword(!showPassword)} edge="end">
                {showPassword ? <Visibility /> : <VisibilityOff />}
              </IconButton>
            </InputAdornment>
          ),
        }}
      />
      <PrimaryButton fullWidth variant="contained" onClick={validateUserCredentials} disabled={!userId || isLoading}>
        {isLoading ? "Verifying..." : "Continue"}
      </PrimaryButton>
    </>
  );
};

export default LoginWithPassword;





import React, { useState, useEffect, useRef } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { InputAdornment, Box, Button, Typography } from "@mui/material";
import VpnKeyIcon from "@mui/icons-material/VpnKey";
import api from "../../../config/axiosConfig";
import { parseJwt } from "../../../utils/EncryptionUtilities";
import { loginSuccess } from "../../../store/slices/authSlice";
import { setMenus, setSelectedMenuItem } from "../../../store/slices/menuSlice";
import { setTabId } from "../../../store/slices/tabSlice";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { StyledTextField, PrimaryButton } from "./LoginStyles";

const LoginWithOtp = ({ userId, openLoginErrorDialog, onBackToHome }) => {
  const [otp, setOtp] = useState("");
  const [otpInvalidMessage, setOtpInvalidMessage] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [wrongAttempts, setWrongAttempts] = useState(0);
  const [resendCount, setResendCount] = useState(0);

  const navigate = useNavigate();
  const dispatch = useDispatch();
  const menus = useSelector((state) => state.menus.menus);
  const otpInputRef = useRef(null);

  useEffect(() => {
    if (otpInputRef.current) otpInputRef.current.focus();
  }, []);

  useEffect(() => {
    if (menus && menus.length > 0 && menus[0]?.route) {
      if (menus[0].hasChildren) {
        navigate("/choose-option" + menus[0]?.route);
      } else {
        navigate(menus[0]?.route);
      }
    }
  }, [menus, navigate]);

  const handleResendOtp = async (isForced = false) => {
    if (!isForced && resendCount >= 3) {
      openLoginErrorDialog("Resend Limit Reached", "You have reached the maximum number of OTP resend attempts.");
      return;
    }

    try {
      await api.post(`${resolveConfig("/LS") || ""}/auth/resend-otp`, { userId });
      setResendCount((prev) => prev + 1);
      setOtp("");
      setOtpInvalidMessage(isForced ? "Too many invalid attempts. A new OTP has been sent." : "A new OTP has been sent to your registered contact.");
    } catch (e) {
      openLoginErrorDialog("Resend Failed", "Failed to resend OTP. Please try again later.");
    }
  };

  const validateOtp = async () => {
    if (!otp || otp.trim() === "") {
      setOtpInvalidMessage("OTP cannot be empty.");
      otpInputRef.current?.focus();
      return;
    }

    setIsLoading(true);
    setOtpInvalidMessage("");

    try {
      const response = await api.post(`${resolveConfig("/LS") || ""}/auth/verify-otp`, {
        userId: userId,
        otp: otp,
      });

      const result = response?.data?.data || {};

      // If OTP logic is successful, handle the payload as requested
      if (result.validOtp === true) {
        if (result?.roleData?.root_menus?.length === 0) {
          openLoginErrorDialog("Access Denied", "You don't have enough permissions to access this application.");
          return;
        }

        const user = parseJwt(result.accessToken);
        const tabId = crypto.randomUUID();

        dispatch(loginSuccess({ token: result.accessToken, user: user }));
        localStorage.setItem("payloadEncryptionKey", result.payloadEncryptionKey);
        
        dispatch(setTabId(tabId));
        dispatch(setMenus(result.roleData.root_menus));
        dispatch(setSelectedMenuItem(result.roleData.root_menus[0]));

        const bc = new BroadcastChannel("auth");
        setTimeout(() => {
          bc.postMessage({ type: "USER_LOGGED_IN", tabId, userId: user.userId });
        }, 1000);
      } else {
        handleFailedAttempt();
      }
    } catch (e) {
      handleFailedAttempt();
    } finally {
      setIsLoading(false);
    }
  };

  const handleFailedAttempt = () => {
    const newWrongAttempts = wrongAttempts + 1;
    
    if (newWrongAttempts >= 3) {
      // Trigger 3rd invalid attempt forced resend logic
      setWrongAttempts(0); 
      handleResendOtp(true); 
    } else {
      setWrongAttempts(newWrongAttempts);
      setOtpInvalidMessage(`Invalid OTP. Attempt ${newWrongAttempts} of 3.`);
    }
  };

  const handleOtpKeyDown = (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading) validateOtp();
    }
  };

  return (
    <Box sx={{ display: "flex", flexDirection: "column", gap: 1 }}>
      <Typography variant="body2" color="text.secondary" sx={{ mt: 2, mb: 1 }}>
        Please enter the OTP sent to your registered email/phone.
      </Typography>
      <StyledTextField
        fullWidth
        inputRef={otpInputRef}
        label="Enter OTP"
        type="text"
        value={otp}
        onChange={(e) => {
          setOtp(e.target.value);
          if (otpInvalidMessage) setOtpInvalidMessage("");
        }}
        onKeyDown={handleOtpKeyDown}
        variant="outlined"
        error={!!otpInvalidMessage}
        helperText={otpInvalidMessage}
        margin="normal"
        InputProps={{
          startAdornment: <InputAdornment position="start"><VpnKeyIcon /></InputAdornment>,
        }}
      />

      <PrimaryButton fullWidth variant="contained" onClick={validateOtp} disabled={!userId || isLoading}>
        {isLoading ? "Verifying..." : "Sign In"}
      </PrimaryButton>

      <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", mt: 2 }}>
        <Button 
          onClick={() => handleResendOtp(false)} 
          disabled={resendCount >= 3 || isLoading}
          sx={{ textTransform: 'none', fontSize: '0.875rem' }}
        >
          Resend OTP {resendCount > 0 ? `(${3 - resendCount} left)` : ''}
        </Button>
        <Button 
          onClick={onBackToHome} 
          color="inherit" 
          sx={{ textTransform: 'none', fontSize: '0.875rem', color: "text.secondary" }}
        >
          Cancel
        </Button>
      </Box>
    </Box>
  );
};

export default LoginWithOtp;




