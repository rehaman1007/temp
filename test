import React, { useState, useEffect, useRef } from "react";
import { Typography, Button, Box, TextField, Stack } from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  userId,
  otpData,
  openLoginErrorDialog,
  onBackToHome,
  onSessionEstablished,
}) => {
  const showSnackbar = useCustomSnackbar();

  const [otpValues, setOtpValues] = useState(new Array(6).fill(""));
  const [isLoading, setIsLoading] = useState(false);
  const [wrongAttempts, setWrongAttempts] = useState(0);

  // --- API Driven Timers & Limits ---
  const [currentTxnId, setCurrentTxnId] = useState(
    otpData?.transactionId || "",
  );
  const [expiresIn, setExpiresIn] = useState(otpData?.expiresInSeconds || 300);
  const [cooldown, setCooldown] = useState(
    otpData?.resendCooldownSeconds || 30,
  );
  const [resendsLeft, setResendsLeft] = useState(
    otpData?.resendsRemaining ?? 5,
  );

  const inputRefs = useRef([]);

  // Auto-focus first input box
  useEffect(() => {
    if (expiresIn > 0 && inputRefs.current[0]) {
      inputRefs.current[0].focus();
    }
  }, [expiresIn]);

  // Global Countdown Timer
  useEffect(() => {
    const timer = setInterval(() => {
      setExpiresIn((prev) => (prev > 0 ? prev - 1 : 0));
      setCooldown((prev) => (prev > 0 ? prev - 1 : 0));
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const formatTime = (seconds) => {
    const m = Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0");
    const s = (seconds % 60).toString().padStart(2, "0");
    return `${m}:${s}`;
  };

  const otpString = otpValues.join("");

  const updateTimersFromResponse = (data) => {
    if (data?.transactionId) setCurrentTxnId(data.transactionId);
    if (data?.expiresInSeconds) setExpiresIn(data.expiresInSeconds);
    if (data?.resendCooldownSeconds) setCooldown(data.resendCooldownSeconds);
    if (data?.resendsRemaining !== undefined)
      setResendsLeft(data.resendsRemaining);
  };

  const forceResendOTP = async () => {
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(new Array(6).fill(""));
      showSnackbar(
        "3 invalid attempts. A new OTP has been forcefully sent.",
        "warning",
      );
      inputRefs.current[0]?.focus();
    } catch (err) {
      console.error("Forced OTP generation fault:", err);
      openLoginErrorDialog(
        "System Error",
        "Failed to cycle a new validation token automatically.",
      );
    }
  };

  const handleResendClick = async () => {
    if (resendsLeft <= 0) {
      showSnackbar("Maximum manual resend limit reached.", "error");
      return;
    }

    setIsLoading(true);
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(new Array(6).fill(""));
      showSnackbar(
        res?.data?.message || "A new OTP has been dispatched.",
        "success",
      );
      inputRefs.current[0]?.focus();
    } catch (err) {
      const msg =
        err.response?.data?.message || "Failed to resend authentication code.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  const handleVerifyOTP = async () => {
    if (otpString.length !== 6) {
      showSnackbar("Please complete the 6-digit verification code.", "warning");
      return;
    }

    setIsLoading(true);

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          userId,
          transactionId: currentTxnId,
          otp: otpString,
        },
      );

      const isSuccess = response?.data?.success === true;
      const result = response?.data?.data || {};

      if (isSuccess) {
        if (onSessionEstablished) {
          onSessionEstablished(result);
        }
      } else {
        const targetFailures = wrongAttempts + 1;
        setWrongAttempts(targetFailures);

        if (targetFailures >= 3) {
          await forceResendOTP();
        } else {
          showSnackbar(
            response?.data?.message ||
              `Invalid code. Attempt ${targetFailures} of 3.`,
            "error",
          );
        }
      }
    } catch (e) {
      console.error("OTP Verification Exception:", e);
      const msg =
        e.response?.data?.message ||
        "Network exception during verification layer lookup.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  const handleOtpChange = (index, e) => {
    const val = e.target.value;
    if (/[^0-9]/.test(val)) return;

    const newOtpValues = [...otpValues];
    newOtpValues[index] = val.substring(val.length - 1);
    setOtpValues(newOtpValues);

    if (val && index < 5) {
      inputRefs.current[index + 1].focus();
    }
  };

  const handleOtpKeyDown = (index, e) => {
    if (e.key === "Backspace") {
      if (!otpValues[index] && index > 0) {
        const newOtpValues = [...otpValues];
        newOtpValues[index - 1] = "";
        setOtpValues(newOtpValues);
        inputRefs.current[index - 1].focus();
      } else if (otpValues[index]) {
        const newOtpValues = [...otpValues];
        newOtpValues[index] = "";
        setOtpValues(newOtpValues);
      }
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading && otpString.length === 6 && expiresIn > 0) {
        handleVerifyOTP();
      }
    }
  };

  const handleOtpPaste = (e) => {
    e.preventDefault();
    const pasteData = e.clipboardData
      .getData("text/plain")
      .replace(/\D/g, "")
      .slice(0, 6);
    if (!pasteData) return;

    const newOtpValues = [...otpValues];
    for (let i = 0; i < pasteData.length; i++) {
      newOtpValues[i] = pasteData[i];
    }
    setOtpValues(newOtpValues);

    const focusIndex = pasteData.length < 6 ? pasteData.length : 5;
    inputRefs.current[focusIndex]?.focus();
  };

  const isExpired = expiresIn === 0;

  return (
    <Box sx={{ width: "100%", maxWidth: "100%" }}>
      {/* Information Header & Badge */}
      <Box
        sx={{
          mb: 3,
          p: { xs: 1.5, sm: 2 },
          bgcolor: "rgba(0,0,0,0.03)",
          borderRadius: 2,
          border: "1px solid rgba(0,0,0,0.06)",
        }}
      >
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            mb: 1.5,
          }}
        >
          <Typography
            variant="body2"
            color="text.secondary"
            sx={{ fontWeight: 500, fontSize: { xs: "0.8rem", sm: "0.875rem" } }}
          >
            {isExpired ? "Status" : "Sent securely to:"}
          </Typography>

          {/* Fixed-Width Timer to prevent layout jitter */}
          <Box
            sx={{
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              gap: 0.5,
              width: "80px",
              py: 0.4,
              px: 0.8,
              borderRadius: 1.5,
              bgcolor: isExpired
                ? "error.light"
                : expiresIn > 60
                  ? "primary.50"
                  : "warning.50",
              color: isExpired
                ? "error.dark"
                : expiresIn > 60
                  ? "primary.main"
                  : "error.main",
            }}
          >
            <AccessTimeIcon sx={{ fontSize: 15 }} />
            <Typography
              variant="caption"
              sx={{
                fontWeight: 700,
                fontVariantNumeric: "tabular-nums",
                letterSpacing: 0.5,
              }}
            >
              {formatTime(expiresIn)}
            </Typography>
          </Box>
        </Box>

        {!isExpired && (
          <Stack spacing={0.75}>
            {otpData?.maskedMobile && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1.25 }}>
                <PhoneAndroidIcon sx={{ fontSize: 18, color: "text.secondary" }} />
                <Typography
                  variant="subtitle2"
                  color="text.primary"
                  sx={{ fontSize: { xs: "0.8rem", sm: "0.875rem" } }}
                >
                  {otpData.maskedMobile}
                </Typography>
              </Box>
            )}

            {otpData?.maskedEmail && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1.25 }}>
                <EmailIcon sx={{ fontSize: 18, color: "text.secondary" }} />
                <Typography
                  variant="subtitle2"
                  color="text.primary"
                  sx={{
                    fontSize: { xs: "0.8rem", sm: "0.875rem" },
                    wordBreak: "break-all",
                  }}
                >
                  {otpData.maskedEmail}
                </Typography>
              </Box>
            )}
          </Stack>
        )}

        {isExpired && (
          <Typography
            variant="body2"
            color="error.main"
            sx={{ fontWeight: 600, fontSize: { xs: "0.825rem", sm: "0.875rem" } }}
          >
            Your verification token has timed out.
          </Typography>
        )}
      </Box>

      {/* CONDITIONAL CONTENT: Active State vs Expired State */}
      {!isExpired ? (
        <>
          {/* Responsive OTP Grid */}
          <Box
            sx={{
              display: "flex",
              justifyContent: "center",
              gap: { xs: 0.75, sm: 1.25, md: 1.5 },
              mb: 3,
            }}
          >
            {otpValues.map((val, idx) => (
              <TextField
                key={idx}
                inputRef={(el) => (inputRefs.current[idx] = el)}
                value={val}
                onChange={(e) => handleOtpChange(idx, e)}
                onKeyDown={(e) => handleOtpKeyDown(idx, e)}
                onPaste={handleOtpPaste}
                disabled={isLoading}
                variant="outlined"
                inputProps={{
                  inputMode: "numeric",
                  pattern: "[0-9]*",
                  maxLength: 1,
                }}
                sx={{
                  flex: 1,
                  maxWidth: { xs: "44px", sm: "52px", md: "56px" },
                  "& .MuiOutlinedInput-root": {
                    borderRadius: 2,
                    bgcolor: "background.paper",
                    height: { xs: "48px", sm: "54px", md: "58px" },
                    p: 0,
                  },
                  "& .MuiOutlinedInput-input": {
                    textAlign: "center",
                    fontSize: { xs: "1.1rem", sm: "1.35rem", md: "1.5rem" },
                    fontWeight: 700,
                    padding: 0,
                  },
                  "& .MuiOutlinedInput-root.Mui-focused .MuiOutlinedInput-notchedOutline":
                    {
                      borderWidth: "2px",
                      borderColor: "primary.main",
                    },
                }}
              />
            ))}
          </Box>

          <PrimaryButton
            fullWidth
            variant="contained"
            onClick={handleVerifyOTP}
            disabled={isLoading || otpString.length !== 6}
          >
            {isLoading ? "Verifying..." : "Verify & Sign In"}
          </PrimaryButton>

          {/* Action Row */}
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              mt: 3,
              gap: 1,
            }}
          >
            <Button
              startIcon={<ArrowBackIcon />}
              onClick={onBackToHome}
              sx={{
                textTransform: "none",
                color: "text.secondary",
                fontSize: { xs: "0.75rem", sm: "0.85rem" },
              }}
              size="small"
            >
              Restart Login
            </Button>

            <Button
              startIcon={<RefreshIcon />}
              onClick={handleResendClick}
              disabled={cooldown > 0 || resendsLeft <= 0 || isLoading}
              sx={{
                textTransform: "none",
                minWidth: "125px",
                fontVariantNumeric: "tabular-nums",
                fontSize: { xs: "0.75rem", sm: "0.85rem" },
              }}
              size="small"
            >
              {resendsLeft <= 0
                ? "Limit Reached"
                : cooldown > 0
                  ? `Resend in ${cooldown}s`
                  : "Resend OTP"}
            </Button>
          </Box>
        </>
      ) : (
        /* Expired Session View */
        <Box
          sx={{
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            textAlign: "center",
            py: 2,
            px: 1,
          }}
        >
          <Box
            sx={{
              width: 56,
              height: 56,
              borderRadius: "50%",
              bgcolor: "error.light",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              color: "error.main",
              mb: 2,
            }}
          >
            <WarningAmberIcon sx={{ fontSize: 32 }} />
          </Box>

          <Typography variant="h6" fontWeight={700} gutterBottom>
            Session Expired
          </Typography>

          <Typography
            variant="body2"
            color="text.secondary"
            sx={{ mb: 3, maxWidth: "320px" }}
          >
            The OTP has expired for security reasons. Please request a fresh
            verification code or return to the login page.
          </Typography>

          <Stack spacing={1.5} width="100%">
            <PrimaryButton
              fullWidth
              variant="contained"
              startIcon={<RefreshIcon />}
              onClick={handleResendClick}
              disabled={resendsLeft <= 0 || isLoading}
            >
              {isLoading
                ? "Sending New OTP..."
                : resendsLeft <= 0
                  ? "Resend Limit Reached"
                  : "Request New Code"}
            </PrimaryButton>

            <Button
              fullWidth
              startIcon={<ArrowBackIcon />}
              onClick={onBackToHome}
              variant="outlined"
              sx={{
                textTransform: "none",
                borderRadius: 2,
                py: 1,
              }}
            >
              Back to User ID
            </Button>
          </Stack>
        </Box>
      )}
    </Box>
  );
};

export default LoginWithOTP;
