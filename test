export const safeParseFloat = (value) => {
  const parsed = parseFloat(value);
  return isNaN(parsed) ? 0.0 : parsed;
};

export const formatDecimal = (value) => {
  const num = safeParseFloat(value);
  return num.toFixed(2);
};

export const convertToKebabCase = (inputValue) => {
  if (inputValue && inputValue.length) {
    return _.chain(inputValue.toString()).toLower().kebabCase().value();
  }
  return "";
};

export const kebabToPascalCase = (kebabStr) => {
  return _.startCase(kebabStr.replace(/-/g, " "));
};

export const toPascalKebabCase = (str) => {
  if (!str) return "";

  return (
    str
      // Use match to break the string into words, handling various separators and cases
      .match(
        /[A-Z]{2,}(?=[A-Z][a-z]+[0-9]*|\b)|[A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+/g,
      )
      // Capitalize the first letter of each word and lowercase the rest
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
      // Join words with hyphens
      .join(" ")
  );
};

export const getParentMenu = (item, menus = []) => {
  for (const menu of menus) {
    // 1. Check if the current menu item is the parent of the item we're looking for
    if (
      menu.children &&
      menu.children.some((child) => child?.id === item?.id)
    ) {
      return menu;
    }

    // 2. If not the parent, and it has children, recursively search within its children
    if (menu.children && menu.children.length > 0) {
      const foundParent = getParentMenu(item, menu.children);
      if (foundParent) {
        return foundParent;
      }
    }
  }

  return undefined;
};

/** Relative time formatter */
export const formatRelativeTime = (dateString) => {
  if (!dateString) return "Invalid Date";

  const date = new Date(dateString);
  const now = new Date();
  const secondsAgo = Math.floor((now - date) / 1000);
  const minutesAgo = Math.floor(secondsAgo / 60);
  const hoursAgo = Math.floor(minutesAgo / 60);
  const daysAgo = Math.floor(hoursAgo / 24);
  const monthsAgo = Math.floor(daysAgo / 30);
  const yearsAgo = Math.floor(monthsAgo / 12);

  if (secondsAgo < 10) return "just now";
  if (secondsAgo < 60) return `${secondsAgo}s ago`;
  if (minutesAgo < 60) return `${minutesAgo}m ago`;
  if (hoursAgo < 24) return `${hoursAgo}h ago`;
  if (daysAgo < 30) return `${daysAgo}d ago`;
  if (monthsAgo < 12) return `${monthsAgo}mo ago`;
  return `${yearsAgo}y ago`;
};

export const timeStampFormatter = (param) => {
  const isoString = param || "";
  if (!isoString) return null;
  let formattedDate = isoString;
  try {
    const date = new Date(isoString);
    formattedDate = date.toLocaleString("en-IN", {
      year: "numeric",
      month: "short", // for shortDate use short
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
      timeZone: "Asia/Kolkata",
    });
  } catch (error) {
    console.error("Error formatting date:", error);
  }
  return formattedDate;
};

export const formatProcessTime = (dateString) => {
  if (!dateString) return "-";

  try {
    const date = new Date(dateString);

    // Check if date is valid
    if (isNaN(date.getTime())) return dateString;

    return date.toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
      timeZone: "UTC", // Use UTC to keep the clock time exactly as it appears in  API string
    });
  } catch (error) {
    console.error("Error formatting date:", error);
    return dateString;
  }
};

export const formatKeyForDisplay = (key) => {
  const result = key.replace(/([A-Z])/g, " $1").trim();
  return result.charAt(0).toUpperCase() + result.slice(1);
};

export const getPermissions = (menu) => {
  let selectedMenu = menu;
  if (menu.hasChildren) {
    const menuID = menu.id;
    const childMenus = menu?.children || [];
    const matchedMenu = childMenus?.find((item) => item.id === menuID);
    selectedMenu = matchedMenu;
  }
  const actions =
    selectedMenu?.menuAction?.split("|").map((act) => act.trim()) || [];

  // Define the master list of all possible permissions
  const allPermissions = [
    "view",
    "create",
    "modify",
    "cancel",
    "delete",
    "download",
    "approve",
    "reject",
    "block",
    "unblock",
    "start",
    "stop",
    "terminate",
    "restart",
    "restarteod",
    "finish",
    "wholebank",
    "circle",
    "branch",
  ];

  // Create the final object by checking inclusion for each permission type
  const permissions = Object.fromEntries(
    allPermissions.map((permission) => [
      permission,
      actions.includes(permission),
    ]),
  );

  return permissions;
};

