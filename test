package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;

import jakarta.servlet.http.HttpServletRequest;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.sql.ResultSetMetaData;
import java.sql.Types;

import java.time.Duration;
import java.time.Instant;

import java.util.*;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    private final HttpServletRequest request;

    /**
     * SQL EXECUTION
     */
    @Override
    public Map<String, Object> executeAdminSql(AdminSupportDTO dto) {

        Instant start = Instant.now();

        String userId = request.getHeader("userId");

        String clientIp = getClientIp();

        String jobId = UUID.randomUUID().toString();

        String rawSql = dto.getSql().trim();

        log.info("""
                
                ADMIN SQL EXECUTION STARTED
                | jobId={}
                | userId={}
                | ip={}
                | page={}
                | size={}
                | sql={}
                """,
                jobId,
                userId,
                clientIp,
                dto.getPage(),
                dto.getSize(),
                rawSql
        );

        try {

            /**
             * CLEAN STATEMENTS
             */
            String[] statements = rawSql.split(";");

            List<String> cleanStatements = new ArrayList<>();

            for (String s : statements) {

                String clean =
                        s.replaceAll("(?m)^--.*", "")
                                .trim();

                if (!clean.isEmpty()) {

                    cleanStatements.add(clean);
                }
            }

            boolean isSingleSelect =
                    cleanStatements.size() == 1
                            &&
                            (
                                    cleanStatements.get(0)
                                            .toUpperCase()
                                            .startsWith("SELECT")

                                            ||

                                            cleanStatements.get(0)
                                                    .toUpperCase()
                                                    .startsWith("WITH")
                            );

            int page = dto.getPage() != null
                    ? dto.getPage()
                    : 0;

            int size = dto.getSize() != null
                    ? dto.getSize()
                    : 10;

            /**
             * SELECT
             */
            if (isSingleSelect) {

                String sql = cleanStatements.get(0);

                String countSql =
                        "SELECT COUNT(*) FROM (" + sql + ")";

                Integer total =
                        jdbcTemplate.queryForObject(
                                countSql,
                                Integer.class
                        );

                String paginatedSql =
                        sql
                                + " OFFSET "
                                + (page * size)
                                + " ROWS FETCH NEXT "
                                + size
                                + " ROWS ONLY";

                List<Map<String, Object>> rows =
                        jdbcTemplate.query(
                                paginatedSql,
                                (rs, rowNum) -> {

                                    ResultSetMetaData meta =
                                            rs.getMetaData();

                                    int columnCount =
                                            meta.getColumnCount();

                                    Map<String, Object> row =
                                            new LinkedHashMap<>();

                                    for (int i = 1;
                                         i <= columnCount;
                                         i++) {

                                        String column =
                                                meta.getColumnLabel(i);

                                        int type =
                                                meta.getColumnType(i);

                                        Object value;

                                        switch (type) {

                                            case Types.CLOB:

                                                value =
                                                        rs.getClob(i) != null
                                                                ?
                                                                rs.getClob(i)
                                                                        .getSubString(
                                                                                1,
                                                                                (int)
                                                                                        rs.getClob(i)
                                                                                                .length()
                                                                        )
                                                                :
                                                                null;

                                                break;

                                            default:

                                                value =
                                                        rs.getObject(i);
                                        }

                                        row.put(column, value);
                                    }

                                    return row;
                                }
                        );

                List<Map<String, String>> columns =
                        new ArrayList<>();

                if (!rows.isEmpty()) {

                    rows.get(0)
                            .keySet()
                            .forEach(col -> {

                                columns.add(
                                        Map.of(
                                                "name",
                                                col
                                        )
                                );
                            });
                }

                long timeMs =
                        Duration.between(start, Instant.now())
                                .toMillis();

                /**
                 * INSERT LOG
                 */
                insertExecutionLog(
                        jobId,
                        userId,
                        clientIp,
                        null,
                        "SELECT",
                        "SUCCESS",
                        1,
                        rows.size(),
                        0,
                        0,
                        0,
                        1,
                        null,
                        null,
                        null,
                        null,
                        calculateSpeed(rows.size(), timeMs),
                        timeMs / 1000,
                        sql
                );

                log.info("""
                        
                        SELECT EXECUTED
                        | jobId={}
                        | rows={}
                        | total={}
                        | page={}
                        | size={}
                        | timeMs={}
                        """,
                        jobId,
                        rows.size(),
                        total,
                        page,
                        size,
                        timeMs
                );

                return Map.of(
                        "error", false,
                        "rows", rows,
                        "columns", columns,
                        "total", total,
                        "page", page,
                        "size", size
                );
            }

            /**
             * SCRIPT EXECUTION
             */
            else {

                int insertCount = 0;
                int updateCount = 0;
                int deleteCount = 0;
                int otherCount = 0;

                int executed = 0;

                for (String sql : cleanStatements) {

                    String upper =
                            sql.trim().toUpperCase();

                    if (upper.startsWith("INSERT")) {

                        insertCount++;

                    } else if (upper.startsWith("UPDATE")) {

                        updateCount++;

                    } else if (upper.startsWith("DELETE")) {

                        deleteCount++;

                    } else {

                        otherCount++;
                    }

                    jdbcTemplate.execute(sql);

                    executed++;
                }

                long timeMs =
                        Duration.between(start, Instant.now())
                                .toMillis();

                /**
                 * LOG
                 */
                insertExecutionLog(
                        jobId,
                        userId,
                        clientIp,
                        null,
                        "MULTI_SQL",
                        "SUCCESS",
                        cleanStatements.size(),
                        executed,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        null,
                        null,
                        null,
                        null,
                        calculateSpeed(executed, timeMs),
                        timeMs / 1000,
                        rawSql
                );

                log.info("""
                        
                        MULTI SQL EXECUTED
                        | jobId={}
                        | total={}
                        | inserts={}
                        | updates={}
                        | deletes={}
                        | others={}
                        | timeMs={}
                        """,
                        jobId,
                        executed,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        timeMs
                );

                return Map.of(
                        "error", false,
                        "message", "Execution completed",
                        "executed", executed,
                        "insertCount", insertCount,
                        "updateCount", updateCount,
                        "deleteCount", deleteCount,
                        "otherCount", otherCount
                );
            }

        } catch (Exception e) {

            long timeMs =
                    Duration.between(start, Instant.now())
                            .toMillis();

            log.error("""
                    
                    ADMIN SQL EXECUTION FAILED
                    | jobId={}
                    | userId={}
                    | sql={}
                    """,
                    jobId,
                    userId,
                    rawSql,
                    e
            );

            insertExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    null,
                    "SQL_EXECUTION",
                    "FAILED",
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                    1,
                    rawSql,
                    e.getClass().getSimpleName(),
                    e.getMessage(),
                    0,
                    timeMs / 1000,
                    rawSql
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * FILE UPLOAD
     */
    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file
    ) {

        try {

            String jobId =
                    UUID.randomUUID().toString();

            String userId =
                    request.getHeader("userId");

            String clientIp =
                    getClientIp();

            log.info("""
                    
                    SQL UPLOAD RECEIVED
                    | jobId={}
                    | file={}
                    | size={} MB
                    | user={}
                    | ip={}
                    """,
                    jobId,
                    file.getOriginalFilename(),
                    String.format(
                            "%.2f",
                            file.getSize() / 1024.0 / 1024.0
                    ),
                    userId,
                    clientIp
            );

            /**
             * COPY FILE INTO MEMORY
             */
            byte[] bytes = file.getBytes();

            /**
             * EXECUTE ASYNC
             */
            adminSupportExecutor.executeScriptAsync(
                    bytes,
                    file.getOriginalFilename(),
                    jobId,
                    userId,
                    clientIp
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId,
                    "message", "Execution started"
            );

        } catch (Exception e) {

            log.error("UPLOAD FAILED", e);

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * JOB STATUS
     */
    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return adminSupportExecutor.getJobStatus(jobId);
    }

    /**
     * INSERT EXECUTION LOG
     */
    private void insertExecutionLog(
            String jobId,
            String userId,
            String clientIp,
            String fileName,
            String executionType,
            String status,
            int totalStatements,
            int executedCount,
            int insertCount,
            int updateCount,
            int deleteCount,
            int otherCount,
            Integer failedStatementNumber,
            String failedSql,
            String exceptionType,
            String exceptionMessage,
            double executionSpeed,
            long elapsedSeconds,
            String sqlText
    ) {

        try {

            jdbcTemplate.update("""
                    
                    INSERT INTO ADMIN_SUPPORT_LOG
                    (
                        ID,
                        JOB_ID,
                        USER_ID,
                        CLIENT_IP,
                        FILE_NAME,
                        EXECUTION_TYPE,
                        STATUS,
                        TOTAL_STATEMENTS,
                        EXECUTED_COUNT,
                        INSERT_COUNT,
                        UPDATE_COUNT,
                        DELETE_COUNT,
                        OTHER_COUNT,
                        FAILED_STATEMENT_NUMBER,
                        FAILED_SQL,
                        EXCEPTION_TYPE,
                        EXCEPTION_MESSAGE,
                        EXECUTION_SPEED,
                        ELAPSED_SECONDS,
                        SQL_TEXT,
                        STARTED_AT,
                        CREATED_AT
                    )
                    VALUES
                    (
                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        SYSTIMESTAMP,
                        SYSTIMESTAMP
                    )
                    """,

                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    executionType,
                    status,
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedStatementNumber,
                    failedSql,
                    exceptionType,
                    exceptionMessage,
                    executionSpeed,
                    elapsedSeconds,
                    sqlText
            );

        } catch (Exception e) {

            log.error("FAILED TO INSERT LOG", e);
        }
    }

    /**
     * CALCULATE SPEED
     */
    private double calculateSpeed(
            int count,
            long timeMs
    ) {

        if (timeMs <= 0) {
            return 0;
        }

        return (count * 1000.0) / timeMs;
    }

    /**
     * CLIENT IP
     */
    private String getClientIp() {

        String xfHeader =
                request.getHeader("X-Forwarded-For");

        if (xfHeader == null) {

            return request.getRemoteAddr();
        }

        return xfHeader.split(",")[0];
    }
}