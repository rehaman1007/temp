                icon={Business}
                label="Branch"
                value={branchDisplay}
                adornment={
                  isCircleBranch ? (
                    <Tooltip
                      title="Circle Branch"
                      placement="top"
                      arrow
                    >
                      <Stars
                        sx={{
                          color: "primary.main",
                          fontSize: 20,
                          cursor: "pointer",
                          animation: `${pulseGlow} 2s infinite ease-in-out`,
                          mt: 0,
                        }}
                      />
                    </Tooltip>
                  ) : null
                }
              />
              <DetailRow
                icon={AccountTree}
                label="Circle"
                value={circleDisplay}
              />
              <DetailRow
                icon={Public}
                label="Zone"
                value={user?.zoneName || "N/A"}
              />
              {/* <DetailRow
                icon={CellTower}
                label="NMR Code"
                value={user?.nmrCode || "N/A"}
              /> */}
              <DetailRow
                icon={Home}
                label="Address"
                value={combinedAddress}
              />
            </Stack>
          </CardContent>
        </Card>

        {/* Contact Information */}
        <Accordion
          disableGutters
          elevation={0}
          sx={{
            mb: 2,
            border: "1px solid #E2E8F0",
            borderRadius: "12px",
            animation: `${fadeInUp} 0.4s ease-out 0.3s both`,
            transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
            "&:hover": {
              boxShadow: "0px 6px 20px rgba(0, 0, 0, 0.08)",
              transform: "translateY(-3px)",
              backgroundColor: (theme) => `${theme.palette.primary.main}04`,
            },
            "&:before": {
              display: "none",
            },
            "&:first-of-type": {
              borderTopLeftRadius: "12px",
              borderTopRightRadius: "12px",
            },
            "&:last-of-type": {
              borderBottomLeftRadius: "12px",
              borderBottomRightRadius: "12px",
            },
          }}
        >
          <AccordionSummary
            expandIcon={<ExpandMore />}
            aria-controls="contact-content"
            id="contact-header"
            sx={{ px: 2, py: 0.5 }}
          >
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              CONTACT INFORMATION
            </Typography>
          </AccordionSummary>
          <AccordionDetails sx={{ px: 2, pb: 2, pt: 0 }}>
            <Divider sx={{ mb: 2 }} />
            <Stack spacing={2}>
              {/* Email Row */}
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  gap: 1.5,
                }}
              >
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.5,
                    overflow: "hidden",
                  }}
                >
                  <Email sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box sx={{ minWidth: 0 }}>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Email
                    </Typography>
                    <Typography variant="body2" sx={{ wordBreak: "break-all" }}>
                      {user?.email || "N/A"}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title={emailCopied ? "Copied!" : "Copy Email"}>
                  <IconButton
                    onClick={handleCopyEmail}
                    size="small"
                    sx={{
                      color: emailCopied ? "success.main" : "text.secondary",
                    }}
                  >
                    {emailCopied ? (
                      <Check fontSize="small" />
                    ) : (
                      <ContentCopy fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>

              {/* Phone Row */}
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                }}
              >
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                  <Phone sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Contact No
                    </Typography>
                    <Typography
                      variant="body2"
                      sx={{ fontSize: "0.875rem", letterSpacing: "2px" }}
                    >
                      {maskPhoneNumber(user?.phoneNumber, showPhone)}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title="Hold to reveal">
                  <IconButton
                    onMouseDown={() => setShowPhone(true)}
                    onMouseUp={() => setShowPhone(false)}
                    onMouseLeave={() => setShowPhone(false)}
                    onTouchStart={() => setShowPhone(true)}
                    onTouchEnd={() => setShowPhone(false)}
                    size="small"
                    sx={{ color: "text.secondary" }}
                  >
                    {showPhone ? (
                      <Visibility fontSize="small" />
                    ) : (
                      <VisibilityOff fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>
            </Stack>
          </AccordionDetails>
        </Accordion>

        {/* Footer Actions */}
        <Box sx={{ animation: `${fadeInUp} 0.4s ease-out 0.4s both` }}>
          {/* Help & SCORE */}
          <Stack direction="row" spacing={1} sx={{ mb: 2 }}>
            <Box
              onClick={() => {
                navigate("/help");
                closeDrawer();
              }}
              sx={{
                flex: 1,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 0.75,
                py: 1,
                px: 1,
                borderRadius: "10px",
                cursor: "pointer",
                border: "1px solid #E2E8F0",
                color: "text.primary",
                fontWeight: 600,
                fontSize: "0.8rem",
                transition: "all 0.2s ease",
                "&:hover": {
                  borderColor: "primary.main",
                  backgroundColor: (theme) => `${theme.palette.primary.main}0A`,
                  transform: "translateY(-1px)",
                },
              }}
            >
              <Help sx={{ fontSize: 18, color: "primary.main" }} />
              Help
            </Box>

            <Box
              component="a"
              href="https://score.sbi/"
              target="_blank"
              rel="noopener noreferrer"
              sx={{
                flex: 1,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 0.75,
                py: 1,
                px: 1.5,
                borderRadius: "10px",
                cursor: "pointer",
                border: "1px solid #E2E8F0",
                color: "text.primary",
                fontWeight: 600,
                fontSize: "0.8rem",
                transition: "all 0.2s ease",
                textDecoration: "none",
                "&:hover": {
                  borderColor: "primary.main",
                  backgroundColor: (theme) => `${theme.palette.primary.main}0A`,
                  transform: "translateY(-1px)",
                },
              }}
            >
              <LinkIcon sx={{ fontSize: 18, color: "primary.main" }} />
              SCORE
            </Box>
          </Stack>

          {/* Sign Out */}
          <Box
            onClick={logout}
            sx={{
              display: "flex",
              alignItems: "center",
              gap: 1,
              p: 1.5,
              borderRadius: "12px",
              cursor: "pointer",
              borderLeft: "4px solid transparent",
              transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
              color: "error.main",
              "&:hover": {
                backgroundColor: (theme) => `${theme.palette.error.main}14`,
                borderLeftColor: "error.main",
                "& .logout-icon": {
                  transform: "translateX(3px)",
                  color: "error.dark",
                },
                "& .shortcut-hint": {
                  opacity: 1,
                  transform: "scale(1.05)",
                  backgroundColor: "error.main",
                  color: "white",
                },
              },
            }}
          >
            <Logout
              className="logout-icon"
              sx={{
                fontSize: 18,
                color: "error.light",
                transition: "transform 0.3s ease",
              }}
            />
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, letterSpacing: "0.3px", flex: 1 }}
            >
              Sign Out
            </Typography>
            {!isMobileOrTablet && (
              <Box
                className="shortcut-hint"
                sx={{
                  fontSize: "9px",
                  fontWeight: 800,
                  px: 1,
                  py: 0.3,
                  borderRadius: "6px",
                  border: "1px solid",
                  borderColor: "divider",
                  opacity: 0.6,
                  transition: "all 0.3s ease",
                  textTransform: "uppercase",
                }}
              >
                Alt + L
              </Box>
            )}
          </Box>
        </Box>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
