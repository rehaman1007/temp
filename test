@Override
public Page<LedgerWiseResponse> search(
        LedgerWiseRequest dto
) {

    Sort.Direction direction =
            "asc".equalsIgnoreCase(dto.getSortOrder())
                    ? Sort.Direction.ASC
                    : Sort.Direction.DESC;

    Pageable pageable = PageRequest.of(
            dto.getPage(),
            dto.getSize()
    );

    Specification<LedgerTransaction> specification =
            (root, query, cb) -> {

                List<Predicate> predicates = new ArrayList<>();

                // ---------------- CGL ----------------
                predicates.add(
                        cb.equal(
                                root.get("cglMaster")
                                        .get("cglNumber"),
                                dto.getCgl()
                        )
                );

                // ---------------- DATE RANGE ----------------
                predicates.add(
                        cb.between(
                                root.get("transactionDate"),
                                parseDate(dto.getFromDate()),
                                parseDate(dto.getToDate())
                        )
                );

                // ---------------- CURRENCY ----------------
                if (
                        dto.getCurrencies() != null &&
                                !"ALL".equalsIgnoreCase(dto.getCurrencies())
                ) {

                    predicates.add(
                            cb.equal(
                                    root.get("currencyMaster")
                                            .get("currencyCode"),
                                    dto.getCurrencies()
                            )
                    );
                }

                // ---------------- CIRCLE ----------------
                if (
                        dto.getCircle() != null &&
                                !"ALL".equalsIgnoreCase(dto.getCircle())
                ) {

                    predicates.add(
                            cb.equal(
                                    root.get("branch")
                                            .get("circle")
                                            .get("circleCode"),
                                    dto.getCircle()
                            )
                    );
                }

                // ---------------- SOURCE FLAGS ----------------
                if (
                        dto.getSourceFlags() != null &&
                                !dto.getSourceFlags().isEmpty() &&
                                !dto.getSourceFlags().contains("ALL")
                ) {

                    predicates.add(
                            root.get("sourceFlag")
                                    .in(dto.getSourceFlags())
                    );
                }

                // ---------------- BRANCHES ----------------
                if (
                        dto.getBranches() != null &&
                                !dto.getBranches().isEmpty() &&
                                !dto.getBranches().contains("ALL")
                ) {

                    predicates.add(
                            root.get("branch")
                                    .get("code")
                                    .in(dto.getBranches())
                    );
                }

                // ---------------- GRID FILTERS ----------------
                if (
                        dto.getGridFilters() != null &&
                                !dto.getGridFilters().isEmpty()
                ) {

                    for (GridFilter filter : dto.getGridFilters()) {

                        if (
                                filter.getValue() == null ||
                                        filter.getValue()
                                                .toString()
                                                .trim()
                                                .isEmpty()
                        ) {
                            continue;
                        }

                        Path<?> path =
                                getPath(root, filter.getField());

                        String operator =
                                filter.getOperator();

                        Object value =
                                filter.getValue();

                        switch (operator) {

                            case "contains" -> predicates.add(
                                    cb.like(
                                            cb.upper(path.as(String.class)),
                                            "%" + value.toString().toUpperCase() + "%"
                                    )
                            );

                            case "equals", "is" -> predicates.add(
                                    cb.equal(path, value)
                            );

                            case "startsWith" -> predicates.add(
                                    cb.like(
                                            cb.upper(path.as(String.class)),
                                            value.toString().toUpperCase() + "%"
                                    )
                            );

                            case "endsWith" -> predicates.add(
                                    cb.like(
                                            cb.upper(path.as(String.class)),
                                            "%" + value.toString().toUpperCase()
                                    )
                            );
                        }
                    }
                }

                return cb.and(
                        predicates.toArray(new Predicate[0])
                );
            };

    Page<LedgerTransaction> page =
            ledgerTransactionRepository.findAll(
                    specification,
                    pageable
            );

    // ---------------- MANUAL SORTING ----------------
    List<LedgerWiseResponse> mappedList =
            page.getContent()
                    .stream()
                    .map(this::mapToDto)
                    .collect(Collectors.toList());

    Comparator<LedgerWiseResponse> comparator =
            switch (dto.getSortField()) {

                case "branchCode" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getBranchCode,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "branchName" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getBranchName,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "circleCode" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCircleCode,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "circleName" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCircleName,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "currency" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCurrency,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "currencyName" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCurrencyName,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "cgl" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCgl,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "description" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getDescription,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "sourceFlag" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getSourceFlag,
                                Comparator.nullsLast(String::compareTo)
                        );

                case "debitAmount" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getDebitAmount,
                                Comparator.nullsLast(java.math.BigDecimal::compareTo)
                        );

                case "creditAmount" ->
                        Comparator.comparing(
                                LedgerWiseResponse::getCreditAmount,
                                Comparator.nullsLast(java.math.BigDecimal::compareTo)
                        );

                default ->
                        Comparator.comparing(
                                LedgerWiseResponse::getTransactionDate,
                                Comparator.nullsLast(java.util.Date::compareTo)
                        );
            };

    if ("desc".equalsIgnoreCase(dto.getSortOrder())) {
        comparator = comparator.reversed();
    }

    mappedList.sort(comparator);

    return new PageImpl<>(
            mappedList,
            pageable,
            page.getTotalElements()
    );
}

private LedgerWiseResponse mapToDto(
        LedgerTransaction entity
) {

    return new LedgerWiseResponse(

            entity.getTransactionId(),
            entity.getBatchId(),
            entity.getJournalId(),
            entity.getTransactionDate(),
            entity.getPostDate(),

            entity.getBranch() != null
                    ? entity.getBranch().getCode()
                    : null,

            entity.getBranch() != null
                    ? entity.getBranch().getName()
                    : null,

            entity.getBranch() != null &&
                    entity.getBranch().getCircle() != null
                    ? entity.getBranch()
                    .getCircle()
                    .getCircleCode()
                    : null,

            entity.getBranch() != null &&
                    entity.getBranch().getCircle() != null
                    ? entity.getBranch()
                    .getCircle()
                    .getCircleName()
                    : null,

            entity.getCurrencyMaster() != null
                    ? entity.getCurrencyMaster().getCurrencyCode()
                    : null,

            entity.getCurrencyMaster() != null
                    ? entity.getCurrencyMaster().getCurrencyName()
                    : null,

            entity.getCglMaster() != null
                    ? entity.getCglMaster().getCglNumber()
                    : null,

            entity.getCglMaster() != null
                    ? entity.getCglMaster().getDescription()
                    : null,

            entity.getNarration(),
            entity.getDebitAmount(),
            entity.getCreditAmount(),
            entity.getTransactionCount(),
            entity.getSourceFlag()
    );
}

private Path<?> getPath(
        Root<LedgerTransaction> root,
        String field
) {

    return switch (field) {

        case "branchCode" ->
                root.get("branch")
                        .get("code");

        case "branchName" ->
                root.get("branch")
                        .get("name");

        case "circleCode" ->
                root.get("branch")
                        .get("circle")
                        .get("circleCode");

        case "circleName" ->
                root.get("branch")
                        .get("circle")
                        .get("circleName");

        case "currency" ->
                root.get("currencyMaster")
                        .get("currencyCode");

        case "currencyName" ->
                root.get("currencyMaster")
                        .get("currencyName");

        case "cgl" ->
                root.get("cglMaster")
                        .get("cglNumber");

        case "description" ->
                root.get("cglMaster")
                        .get("description");

        default ->
                root.get(field);
    };
}

private java.util.Date parseDate(String date) {

    try {

        return new java.text.SimpleDateFormat(
                "dd/MM/yyyy"
        ).parse(date);

    } catch (Exception e) {

        throw new RuntimeException(
                "Invalid date format : " + date
        );
    }
}