package com.fincore.enquiry_service.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.enquiry_service.dto.LedgerEnquiryRequest;
import com.fincore.enquiry_service.dto.MyDownloadsRequestDTO;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFSheet;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;

@Slf4j
@Service
@RequiredArgsConstructor
public class LedgerExportService {

    /*
     * =========================================================
     * CONFIG
     * =========================================================
     */

    private static final int FETCH_SIZE = 20000;

    private static final int SXSSF_WINDOW_SIZE = 2000;

    private static final long MAX_EXPORT_RECORDS = 1_000_000;

    private final JdbcTemplate jdbcTemplate;

    private final MyDownloadsService myDownloadsService;

    /*
     * =========================================================
     * EXPORT
     * =========================================================
     */

    public byte[] export(
            LedgerEnquiryRequest dto,
            String userId
    ) {

        validateExportLimit(dto);

        String sql = """
                SELECT
                
                    g.TRANSACTION_ID,
                    g.BATCH_ID,
                    g.JOURNAL_ID,
                    g.TRANSACTION_DATE,
                    g.POST_DATE,
                
                    b.CODE as BRANCH_CODE,
                    b.NAME as BRANCH_NAME,
                
                    c.CIRCLE_CODE,
                    c.CIRCLE_NAME,
                
                    g.CURRENCY,
                    cu.CURRENCY_NAME,
                
                    g.CGL,
                    cg.DESCRIPTION,
                
                    g.NARRATION,
                
                    g.DEBIT_AMOUNT,
                    g.CREDIT_AMOUNT,
                
                    NVL(g.TRANSACTION_COUNT,0) as TRANSACTION_COUNT,
                
                    sf.FLAG_NAME as SOURCE_NAME
                
                FROM GL_TRANSACTIONS g
                
                JOIN BRANCH_MASTER b
                    ON g.BRANCH_CODE = b.CODE
                
                LEFT JOIN CIRCLE_MASTER c
                    ON b.CIRCLE_CODE = c.CIRCLE_CODE
                
                LEFT JOIN CURRENCY_MASTER cu
                    ON g.CURRENCY = cu.CURRENCY_CODE
                
                LEFT JOIN CGL_MASTER cg
                    ON g.CGL = cg.CGL_NUMBER
                
                LEFT JOIN SOURCE_FLAG_MASTER sf
                    ON g.SOURCE_FLAG = sf.FLAG_ID
                
                WHERE g.CGL = ?
                
                AND (? IS NULL OR g.CURRENCY = ?)
                
                AND g.TRANSACTION_DATE BETWEEN
                    TO_DATE(?,'DD/MM/YYYY')
                    AND TO_DATE(?,'DD/MM/YYYY')
                
                AND (
                    ? = 1
                    OR g.BRANCH_CODE IN (%s)
                )
                
                AND (
                    ? = 1
                    OR g.SOURCE_FLAG IN (%s)
                )
                
                AND (
                    ? IS NULL
                    OR c.CIRCLE_CODE = ?
                )
                
                ORDER BY g.TRANSACTION_DATE
                """;

        /*
         * DYNAMIC IN CLAUSE
         */

        String branchPlaceholders =
                dto.getBranches()
                        .stream()
                        .map(b -> "?")
                        .reduce((a, b) -> a + "," + b)
                        .orElse("?");

        String sourcePlaceholders =
                dto.getSourceFlags()
                        .stream()
                        .map(s -> "?")
                        .reduce((a, b) -> a + "," + b)
                        .orElse("?");

        sql =
                String.format(
                        sql,
                        branchPlaceholders,
                        sourcePlaceholders
                );

        try (

                SXSSFWorkbook workbook =
                        new SXSSFWorkbook(SXSSF_WINDOW_SIZE);

                ByteArrayOutputStream out =
                        new ByteArrayOutputStream()

        ) {

            workbook.setCompressTempFiles(true);

            SXSSFSheet sheet =
                    workbook.createSheet("Ledger");

            createHeader(workbook, sheet);

            AtomicInteger rowNum =
                    new AtomicInteger(1);

            jdbcTemplate.setFetchSize(FETCH_SIZE);

            jdbcTemplate.query(

                    connection -> {

                        PreparedStatement ps =
                                connection.prepareStatement(
                                        sql,
                                        ResultSet.TYPE_FORWARD_ONLY,
                                        ResultSet.CONCUR_READ_ONLY
                                );

                        ps.setFetchSize(FETCH_SIZE);

                        int index = 1;

                        /*
                         * CGL
                         */

                        ps.setString(
                                index++,
                                dto.getCgl()
                        );

                        /*
                         * CURRENCY
                         */

                        String currency =
                                dto.getCurrencies()
                                        .equalsIgnoreCase("ALL")
                                        ? null
                                        : dto.getCurrencies();

                        ps.setString(index++, currency);

                        ps.setString(index++, currency);

                        /*
                         * DATES
                         */

                        ps.setString(index++, dto.getFromDate());

                        ps.setString(index++, dto.getToDate());

                        /*
                         * BRANCHES
                         */

                        boolean skipBranches =
                                dto.getBranches()
                                        .contains("ALL");

                        ps.setInt(
                                index++,
                                skipBranches ? 1 : 0
                        );

                        if (!skipBranches) {

                            for (String branch : dto.getBranches()) {

                                ps.setString(index++, branch);
                            }
                        }

                        /*
                         * SOURCE FLAGS
                         */

                        boolean skipSource =
                                dto.getSourceFlags()
                                        .contains("ALL");

                        ps.setInt(
                                index++,
                                skipSource ? 1 : 0
                        );

                        if (!skipSource) {

                            for (String source : dto.getSourceFlags()) {

                                ps.setString(index++, source);
                            }
                        }

                        /*
                         * CIRCLE
                         */

                        String circle =
                                dto.getCircle()
                                        .equalsIgnoreCase("ALL")
                                        ? null
                                        : dto.getCircle();

                        ps.setString(index++, circle);

                        ps.setString(index++, circle);

                        return ps;
                    },

                    rs -> {

                        while (rs.next()) {

                            Row row =
                                    sheet.createRow(
                                            rowNum.getAndIncrement()
                                    );

                            int col = 0;

                            row.createCell(col++)
                                    .setCellValue(rs.getString("TRANSACTION_ID"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("BATCH_ID"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("JOURNAL_ID"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("BRANCH_CODE"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("BRANCH_NAME"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("CIRCLE_CODE"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("CIRCLE_NAME"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("CURRENCY"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("CURRENCY_NAME"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("CGL"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("DESCRIPTION"));

                            row.createCell(col++)
                                    .setCellValue(rs.getString("NARRATION"));

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getBigDecimal("DEBIT_AMOUNT") != null
                                                    ? rs.getBigDecimal("DEBIT_AMOUNT").doubleValue()
                                                    : 0
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getBigDecimal("CREDIT_AMOUNT") != null
                                                    ? rs.getBigDecimal("CREDIT_AMOUNT").doubleValue()
                                                    : 0
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getLong("TRANSACTION_COUNT")
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getString("SOURCE_NAME")
                                    );

                            /*
                             * MEMORY FLUSH
                             */

                            if (rowNum.get() % 2000 == 0) {

                                try {

                                    sheet.flushRows(1000);

                                } catch (IOException e) {

                                    throw new RuntimeException(e);
                                }

                                log.info(
                                        "Processed rows : {}",
                                        rowNum.get()
                                );
                            }
                        }
                    });

            setColumnWidths(sheet);

            workbook.write(out);

            workbook.dispose();

            byte[] bytes =
                    out.toByteArray();

            sendToMyDownloads(
                    userId,
                    dto,
                    bytes
            );

            log.info(
                    "Ledger Export Completed Successfully"
            );

            return bytes;

        } catch (Exception e) {

            log.error(
                    "Ledger Export Failed",
                    e
            );

            throw new RuntimeException(
                    "Export failed",
                    e
            );
        }
    }

    /*
     * =========================================================
     * VALIDATION
     * =========================================================
     */

    private void validateExportLimit(
            LedgerEnquiryRequest dto
    ) {

        String countSql = """
                SELECT COUNT(*)
                FROM GL_TRANSACTIONS
                WHERE CGL = ?
                AND TRANSACTION_DATE BETWEEN
                    TO_DATE(?,'DD/MM/YYYY')
                    AND TO_DATE(?,'DD/MM/YYYY')
                """;

        Long count =
                jdbcTemplate.queryForObject(
                        countSql,
                        Long.class,
                        dto.getCgl(),
                        dto.getFromDate(),
                        dto.getToDate()
                );

        if (
                count != null
                        && count > MAX_EXPORT_RECORDS
        ) {

            throw new RuntimeException(
                    "Excel export cannot be generated for more than 10 lakh records"
            );
        }
    }

    /*
     * =========================================================
     * HEADER
     * =========================================================
     */

    private void createHeader(
            Workbook workbook,
            Sheet sheet
    ) {

        Row header =
                sheet.createRow(0);

        String[] columns = {
                "TRANSACTION ID",
                "BATCH ID",
                "JOURNAL ID",
                "BRANCH CODE",
                "BRANCH NAME",
                "CIRCLE CODE",
                "CIRCLE NAME",
                "CURRENCY",
                "CURRENCY NAME",
                "CGL",
                "DESCRIPTION",
                "NARRATION",
                "DEBIT AMOUNT",
                "CREDIT AMOUNT",
                "TRANSACTION COUNT",
                "SOURCE NAME"
        };

        CellStyle style =
                workbook.createCellStyle();

        Font font =
                workbook.createFont();

        font.setBold(true);

        style.setFont(font);

        for (int i = 0; i < columns.length; i++) {

            Cell cell =
                    header.createCell(i);

            cell.setCellValue(columns[i]);

            cell.setCellStyle(style);
        }
    }

    /*
     * =========================================================
     * WIDTHS
     * =========================================================
     */

    private void setColumnWidths(
            Sheet sheet
    ) {

        sheet.setColumnWidth(0, 5000);
        sheet.setColumnWidth(1, 5000);
        sheet.setColumnWidth(2, 5000);
        sheet.setColumnWidth(3, 5000);
        sheet.setColumnWidth(4, 10000);
        sheet.setColumnWidth(5, 5000);
        sheet.setColumnWidth(6, 10000);
        sheet.setColumnWidth(7, 4000);
        sheet.setColumnWidth(8, 7000);
        sheet.setColumnWidth(9, 5000);
        sheet.setColumnWidth(10, 10000);
        sheet.setColumnWidth(11, 15000);
        sheet.setColumnWidth(12, 5000);
        sheet.setColumnWidth(13, 5000);
        sheet.setColumnWidth(14, 5000);
        sheet.setColumnWidth(15, 10000);
    }

    /*
     * =========================================================
     * DOWNLOADS
     * =========================================================
     */

    private void sendToMyDownloads(
            String userId,
            LedgerEnquiryRequest dto,
            byte[] content
    ) {

        try {

            String json =
                    new ObjectMapper()
                            .writeValueAsString(dto);

            MyDownloadsRequestDTO request =
                    new MyDownloadsRequestDTO(
                            userId,
                            "LedgerWiseEnquiry.xlsx",
                            51,
                            json,
                            content
                    );

            myDownloadsService.insertRequest(request);

        } catch (Exception e) {

            log.error(
                    "Download save failed",
                    e
            );
        }
    }
}