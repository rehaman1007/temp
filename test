import { useEffect, useRef } from "react";
import * as THREE from "three";
import WAVES from "vanta/dist/vanta.waves.min";

// Finance icons
import { FaChartLine, FaDollarSign, FaPiggyBank } from "react-icons/fa";

export default function SplashScreen() {
  const vantaRef = useRef(null);
  const vantaEffect = useRef(null);
  const overlayRef = useRef(null);

  // 🔹 Vanta background setup
  useEffect(() => {
    if (!vantaEffect.current) {
      vantaEffect.current = WAVES({
        el: vantaRef.current,
        THREE: THREE,
        mouseControls: true,
        touchControls: true,
        gyroControls: false,
        minHeight: 200.0,
        minWidth: 200.0,
        scale: 1.0,
        scaleMobile: 1.0,
        color: 0x1e90ff,
        shininess: 50,
        waveHeight: 20,
        waveSpeed: 0.6,
        zoom: 0.9,
      });
    }
    return () => {
      if (vantaEffect.current) vantaEffect.current.destroy();
    };
  }, []);

  // 🔹 Parallax effect for overlay
  useEffect(() => {
    const handleMouseMove = (e) => {
      const { innerWidth, innerHeight } = window;
      const moveX = (e.clientX / innerWidth - 0.5) * 40;
      const moveY = (e.clientY / innerHeight - 0.5) * 40;
      if (overlayRef.current) {
        overlayRef.current.style.transform = `translate(${moveX}px, ${moveY}px)`;
      }
    };
    window.addEventListener("mousemove", handleMouseMove);
    return () => window.removeEventListener("mousemove", handleMouseMove);
  }, []);

  return (
    <div
      ref={vantaRef}
      style={{
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        minHeight: "100vh",
        fontFamily: "system-ui",
        color: "#fff",
        position: "relative",
        overflow: "hidden",
      }}
    >
      {/* 🔹 Animated number styles */}
      <style>{`
        @keyframes change1 { 0% { content: '0'; } 10% { content: '1'; } 20% { content: '2'; } 30% { content: '3'; } 40% { content: '4'; } 50% { content: '5'; } 60% { content: '6'; } 70% { content: '7'; } 80% { content: '8'; } 90% { content: '9'; } }
        @keyframes change2 { 0% { content: '9'; } 10% { content: '0'; } 20% { content: '1'; } 30% { content: '2'; } 40% { content: '3'; } 50% { content: '4'; } 60% { content: '5'; } 70% { content: '6'; } 80% { content: '7'; } 90% { content: '8'; } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
        .d1::after { content: '4'; animation: change1 1.2s infinite; }
        .d2::after { content: '7'; animation: change2 1.1s infinite; }
        .d3::after { content: '2'; animation: change1 0.9s infinite; }
        .d4::after { content: '9'; animation: change2 1.3s infinite; }
        .d5::after { content: '1'; animation: change1 0.8s infinite; }
        .d6::after { content: '8'; animation: change2 1.0s infinite; }
        .d7::after { content: '3'; animation: change1 1.4s infinite; }
        .d8::after { content: '6'; animation: change2 0.7s infinite; }
        .d9::after { content: '5'; animation: change1 1.1s infinite; }
        .d10::after { content: '0'; animation: change2 0.9s infinite; }
      `}</style>

      {/* 🔹 Branding */}
      <div
        style={{
          fontSize: "80px",
          fontWeight: "700",
          marginBottom: "5px",
          animation: "pulse 2s ease-in-out infinite",
          textShadow: "0px 0px 15px rgba(0,0,0,0.7)",
        }}
      >
        Tranche
      </div>

      <div
        style={{
          fontSize: "18px",
          marginBottom: "32px",
          animation: "pulse 2s ease-in-out infinite",
          textShadow: "0px 0px 8px rgba(0,0,0,0.6)",
        }}
      >
        Welcome to Tranche Module…
      </div>

      {/* 🔹 Finance-related icons */}
      <div style={{ display: "flex", gap: "24px", fontSize: "40px", marginBottom: "40px" }}>
        <FaChartLine style={{ color: "#0ff", filter: "drop-shadow(0 0 10px #0ff)" }} />
        <FaDollarSign style={{ color: "#0f0", filter: "drop-shadow(0 0 10px #0f0)" }} />
        <FaPiggyBank style={{ color: "#ff0", filter: "drop-shadow(0 0 10px #ff0)" }} />
      </div>

      {/* 🔹 Animated numbers with parallax */}
      <div
        ref={overlayRef}
        style={{
          fontFamily: "monospace",
          fontWeight: "bolder",
          letterSpacing: "4px",
          opacity: "0.05",
          transition: "transform 0.1s ease-out",
        }}
      >
        {/* top left */}
        <div style={{ fontSize: "180px", position: "absolute", top: "-60px", left: "-30px" }}>
          <span className="d1"></span><span className="d2"></span><span className="d3"></span>
          <span className="d4"></span><span className="d5"></span><span className="d6"></span>
          <span className="d7"></span><span className="d8"></span><span className="d9"></span><span className="d10"></span>
        </div>
        {/* bottom right */}
        <div style={{ fontSize: "180px", position: "absolute", bottom: "-60px", right: "-30px" }}>
          <span className="d1"></span><span className="d2"></span><span className="d3"></span>
          <span className="d4"></span><span className="d5"></span><span className="d6"></span>
          <span className="d7"></span><span className="d8"></span><span className="d9"></span><span className="d10"></span>
        </div>
        {/* center */}
        <div style={{ fontSize: "280px", position: "absolute", top: "30%", right: "10%" }}>
          <span className="d1"></span><span className="d2"></span><span className="d3"></span>
          <span className="d4"></span><span className="d5"></span><span className="d6"></span>
          <span className="d7"></span><span className="d8"></span><span className="d9"></span><span className="d10"></span>
        </div>
      </div>
    </div>
  );
}