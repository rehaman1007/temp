const [elapsed, setElapsed] = useState(0);

useEffect(() => {
  if (!jobStatus?.startedAt) return;

  /**
   * =========================================
   * COMPLETED / FAILED
   * =========================================
   */
  if (
    jobStatus.status === "COMPLETED" ||
    jobStatus.status === "FAILED"
  ) {

    if (jobStatus.completedAt) {

      const finalElapsed = Math.floor(
        (
          Number(jobStatus.completedAt) -
          Number(jobStatus.startedAt)
        ) / 1000
      );

      setElapsed(finalElapsed);

    } else {

      setElapsed(
        Number(jobStatus.elapsedSeconds || 0)
      );
    }

    return;
  }

  /**
   * =========================================
   * LIVE TIMER
   * =========================================
   */
  const updateElapsed = () => {

    const seconds = Math.floor(
      (
        Date.now() -
        Number(jobStatus.startedAt)
      ) / 1000
    );

    setElapsed(seconds > 0 ? seconds : 0);
  };

  updateElapsed();

  const interval = setInterval(updateElapsed, 1000);

  return () => clearInterval(interval);

}, [
  jobStatus?.startedAt,
  jobStatus?.completedAt,
  jobStatus?.status,
  jobStatus?.elapsedSeconds,
]);