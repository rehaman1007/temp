const transactionColumns = useMemo(() => {
  const cols = [
    {
      field: "transactionId",
      headerName: "ID",
      flex: 0.6,
      filterable: false,
    },
    {
      field: "transactionDate",
      headerName: "Date",
      flex: 0.6,
      filterable: false,
      valueFormatter: (v) =>
        v ? dayjs(v).format("DD/MM/YYYY") : "-",
    },

    /* BRANCH DISPLAY COLUMN */
    {
      field: "branchCode",
      headerName: "Branch",
      flex: 1,

      ...(branchOptions?.length
        ? {
            type: "singleSelect",
            valueOptions: branchOptions.map((b) => ({
              value: b.value,
              label: b.value,
            })),
          }
        : {
            type: "string",
          }),

      renderCell: (params) => (
        <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
          <Typography
            variant="body2"
            sx={{
              fontWeight: 700,
              fontSize: "0.8rem",
            }}
          >
            {params.row.branchCode}
          </Typography>

          <Typography
            variant="caption"
            sx={{
              color: "text.secondary",
              fontSize: "0.7rem",
            }}
          >
            {params.row.branchName}
          </Typography>
        </Box>
      ),
    },

    /* HIDDEN BRANCH NAME FILTER COLUMN */
    {
      field: "branchName",
      headerName: "Branch Name",
      hideable: true,
      width: 200,
    },

    {
      field: "narration",
      headerName: "Narration",
      flex: 1.5,
    },

    {
      field: "debitAmount",
      headerName: "Debit",
      flex: 0.8,
      align: "right",
      headerAlign: "right",
      type: "number",
      valueFormatter: (v) =>
        new Intl.NumberFormat("en-IN", {
          minimumFractionDigits: 2,
        }).format(v || 0),
    },

    {
      field: "creditAmount",
      headerName: "Credit",
      flex: 0.8,
      align: "right",
      headerAlign: "right",
      type: "number",
      valueFormatter: (v) =>
        new Intl.NumberFormat("en-IN", {
          minimumFractionDigits: 2,
        }).format(v || 0),
    },

    {
      field: "sourceFlag",
      headerName: "Source",
      flex: 0.8,
      type: "singleSelect",

      valueOptions:
        sourceOptions?.map((flag) => ({
          value: flag.flagId,
          label: flag.flagName,
        })) || [],

      valueFormatter: (value) => {
        const matchedFlag = sourceOptions?.find(
          (flag) => flag.flagId === value,
        );

        return matchedFlag?.flagName || value || "-";
      },
    },
  ];

  /* CIRCLE COLUMNS */
  if (selectedCircle === "ALL") {
    cols.splice(2, 0,

      {
        field: "circleCode",
        headerName: "Circle",
        flex: 1,
        type: "singleSelect",
        valueOptions: circleOptions.map((c) => ({
          value: c.value,
          label: c.value,
        })),

        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{
                fontWeight: 700,
                fontSize: "0.8rem",
              }}
            >
              {params.row.circleCode}
            </Typography>

            <Typography
              variant="caption"
              sx={{
                color: "text.secondary",
                fontSize: "0.7rem",
              }}
            >
              {params.row.circleName}
            </Typography>
          </Box>
        ),
      },

      /* HIDDEN CIRCLE NAME FILTER COLUMN */
      {
        field: "circleName",
        headerName: "Circle Name",
        hideable: true,
        width: 220,
      }
    );
  }

  /* CURRENCY */
  if (selectedCurrency === "All Currencies") {
    const index = selectedCircle === "ALL" ? 8 : 6;

    cols.splice(index, 0, {
      field: "currencyName",
      headerName: "Currency",
      flex: 1,
      type: "singleSelect",

      valueOptions: currencyOptions,

      renderCell: (params) => (
        <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
          <Typography
            variant="body2"
            sx={{
              fontWeight: 700,
              fontSize: "0.8rem",
            }}
          >
            {params.row.currency}
          </Typography>

          <Typography
            variant="caption"
            sx={{
              color: "text.secondary",
              fontSize: "0.7rem",
            }}
          >
            {params.row.currencyName}
          </Typography>
        </Box>
      ),
    });
  }

  return cols;
}, [
  branchOptions,
  circleOptions,
  currencyOptions,
  sourceOptions,
  selectedCircle,
  selectedCurrency,
]);