import React, { useState, useEffect, useCallback } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  List,
  Stack,
  Typography,
  IconButton,
  Divider,
} from "@mui/material";
import RestoreIcon from "@mui/icons-material/Restore";
import { DndProvider } from "react-dnd";
import { HTML5Backend } from "react-dnd-html5-backend";
import DraggablePermissionItem from "../../common/DraggablePermissionItem";

export default function PermissionsDialog({
  open,
  onClose,
  permissions = [],
  roleName = "",
}) {
  const [ordered, setOrdered] = useState(permissions);
  const [original, setOriginal] = useState(permissions);

  useEffect(() => {
    setOrdered(permissions);
    setOriginal(permissions);
  }, [permissions]);

  const moveItem = useCallback(
    (from, to) => {
      const updated = [...ordered];
      const [moved] = updated.splice(from, 1);
      updated.splice(to, 0, moved);
      setOrdered(updated);
    },
    [ordered]
  );

  const handleReset = () => setOrdered(original);
  const handleSave = () => {
    console.log("Save permission order:", ordered);
    onClose();
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="sm">
      <DialogTitle>
        Permissions for Role: <b>{roleName}</b>
      </DialogTitle>
      <DialogContent>
        <Stack direction="row" justifyContent="space-between" alignItems="center" sx={{ mb: 1 }}>
          <Typography variant="subtitle2">
            Total Permissions: {ordered.length}
          </Typography>
          <IconButton color="secondary" onClick={handleReset}>
            <RestoreIcon />
          </IconButton>
        </Stack>
        <Divider sx={{ mb: 1 }} />
        <DndProvider backend={HTML5Backend}>
          <List sx={{ maxHeight: 400, overflowY: "auto" }}>
            {ordered.map((perm, i) => (
              <DraggablePermissionItem
                key={perm.id}
                id={perm.id}
                index={i}
                title={perm.title}
                moveItem={moveItem}
              />
            ))}
          </List>
        </DndProvider>
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={handleSave}>
          Save Order
        </Button>
      </DialogActions>
    </Dialog>
  );
}