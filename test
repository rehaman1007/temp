                      renderOption={(props, option, { selected }) => {
                        // Check if the master "ALL" tag is currently active
                        const isAllActive = Array.isArray(filters.currencies) 
                                            && filters.currencies.includes("ALL");
                        
                        // If "ALL" is active, force every checkbox to appear checked. 
                        // Otherwise, rely on MUI's default 'selected' state.
                        const isChecked = isAllActive || selected;

                        return (
                          <li {...props} key={option}>
                            <Checkbox
                              size="small"
                              style={{ marginRight: 8 }}
                              checked={isChecked}
                            />
                            <Typography 
                              variant="body2" 
                              sx={{ fontWeight: option === "ALL" ? 700 : 400 }}
                            >
                              {option === "ALL" ? "All Currencies" : option}
                            </Typography>
                          </li>
                        );
                      }}
