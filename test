const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  // 1️⃣ In-progress always wins
  const startedIndex = stages.findIndex(
    (s) => s.STATUS === StageStatus.STARTED
  );
  if (startedIndex !== -1) return startedIndex;

  // 2️⃣ Error next priority
  const errorIndex = stages.findIndex(
    (s) => s.STATUS === StageStatus.ERROR
  );
  if (errorIndex !== -1) return errorIndex;

  // 3️⃣ All completed → pick LAST completed stage
  const completedIndexes = stages
    .map((s, i) => (s.STATUS === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  if (completedIndexes.length > 0) {
    return completedIndexes[completedIndexes.length - 1];
  }

  // 4️⃣ Safe fallback
  return 0;
};