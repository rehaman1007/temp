const MIN_ALLOWED_DATE = dayjs("2026-03-31");

const MAX_ALLOWED_DATE =
  etlDate?.isValid?.()
    ? etlDate
    : dayjs();

const shouldDisableFromDate = (
  date,
) => {
  if (!date?.isValid?.()) return true;

  // Before allowed range
  if (
    date.isBefore(
      MIN_ALLOWED_DATE,
      "day",
    )
  ) {
    return true;
  }

  // After ETL date
  if (
    date.isAfter(
      MAX_ALLOWED_DATE,
      "day",
    )
  ) {
    return true;
  }

  return false;
};


const shouldDisableToDate = (
  date,
) => {
  if (!date?.isValid?.()) return true;

  // Before allowed minimum
  if (
    date.isBefore(
      MIN_ALLOWED_DATE,
      "day",
    )
  ) {
    return true;
  }

  // After ETL
  if (
    date.isAfter(
      MAX_ALLOWED_DATE,
      "day",
    )
  ) {
    return true;
  }

  // Before fromDate
  if (
    filters.fromDate &&
    date.isBefore(
      filters.fromDate,
      "day",
    )
  ) {
    return true;
  }

  // Beyond 1 year range
  if (
    filters.fromDate &&
    date.isAfter(
      filters.fromDate.add(
        1,
        "year",
      ),
      "day",
    )
  ) {
    return true;
  }

  return false;
};

<DatePicker
  value={filters.fromDate}
  format="DD/MM/YYYY"
  shouldDisableDate={
    shouldDisableFromDate
  }
  onChange={(value) =>
    onFilterChange(
      "fromDate",
      value,
    )
  }
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",

      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>

<DatePicker
  value={filters.toDate}
  format="DD/MM/YYYY"
  shouldDisableDate={
    shouldDisableToDate
  }
  onChange={(value) =>
    onFilterChange("toDate", value)
  }
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",

      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>