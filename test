import React, { useEffect, useState } from "react";
import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  FormControl,
  Grid,
  InputAdornment,
  InputLabel,
  MenuItem,
  Select,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import PersonIcon from "@mui/icons-material/Person";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import _ from "lodash";

/* ================= CONSTANTS ================= */

const NAME_ALLOWED_REGEX = /[a-zA-Z.\s]/g; // allowed chars
const DIGITS_REGEX = /^[0-9]*$/;
const EMAIL_PREFIX_REGEX = /^[a-zA-Z0-9._]+$/;

const EMAIL_DOMAIN = "@sbi.co.in";
const EMAIL_PREFIX_MAX = 50;

const FORBIDDEN_ROLE_ID = 11; // f1bog

/* ================= COMPONENT ================= */

export default function UserDialog({
  open,
  onClose,
  roles,
  form,
  setForm,
  initialState,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const [errors, setErrors] = useState({});
  const isEdit = Boolean(form.id);

  useEffect(() => {
    setErrors({});
  }, [open]);

  /* ================= HELPERS ================= */

  const setError = (k, v) => setErrors((p) => ({ ...p, [k]: v }));
  const clearError = (k) => setErrors((p) => ({ ...p, [k]: "" }));

  /* ================= USER ID ================= */

  const handleUserIdChange = (val) => {
    if (!DIGITS_REGEX.test(val)) return;
    if (val.length > 7) return;

    if (val.length !== 7) {
      setError("USERID", "User ID must be exactly 7 digits");
    } else {
      clearError("USERID");
    }

    setForm((p) => ({ ...p, USERID: val }));
  };

  /* ================= NAME HANDLERS (SEPARATE) ================= */

  const sanitizeName = (value) => {
    return (value.match(NAME_ALLOWED_REGEX) || []).join("");
  };

  const validateName = (name, value, mandatory) => {
    if (!value && mandatory) return "This field is required";
    if (value && value.length < 3 && mandatory)
      return "Minimum 3 characters required";
    if (value.length > 30) return "Maximum 30 characters allowed";
    return "";
  };

  const handleFirstNameChange = (e) => {
    const clean = sanitizeName(e.target.value);
    const err = validateName("FIRST_NAME", clean, true);
    err ? setError("FIRST_NAME", err) : clearError("FIRST_NAME");
    setForm((p) => ({ ...p, FIRST_NAME: clean }));
  };

  const handleMiddleNameChange = (e) => {
    const clean = sanitizeName(e.target.value);
    const err = validateName("MIDDLE_NAME", clean, false);
    err ? setError("MIDDLE_NAME", err) : clearError("MIDDLE_NAME");
    setForm((p) => ({ ...p, MIDDLE_NAME: clean }));
  };

  const handleLastNameChange = (e) => {
    const clean = sanitizeName(e.target.value);
    const err = validateName("LAST_NAME", clean, true);
    err ? setError("LAST_NAME", err) : clearError("LAST_NAME");
    setForm((p) => ({ ...p, LAST_NAME: clean }));
  };

  /* ================= EMAIL ================= */

  const handleEmailChange = (raw) => {
    let prefix = raw.replace(EMAIL_DOMAIN, "");
    if (prefix.includes("@")) return;
    if (prefix.length > EMAIL_PREFIX_MAX) return;

    if (!prefix) {
      setError("EMAIL", "Email prefix is required");
      setForm((p) => ({ ...p, EMAIL: EMAIL_DOMAIN }));
      return;
    }

    if (!EMAIL_PREFIX_REGEX.test(prefix)) {
      setError(
        "EMAIL",
        "Only letters, numbers, dot (.) and underscore (_) allowed"
      );
      return;
    }

    if (prefix.length < 3) {
      setError("EMAIL", "Minimum 3 characters required before @");
    } else {
      clearError("EMAIL");
    }

    setForm((p) => ({ ...p, EMAIL: prefix + EMAIL_DOMAIN }));
  };

  /* ================= MOBILE ================= */

  const handleMobileChange = (val) => {
    if (!DIGITS_REGEX.test(val)) return;
    if (val.length > 10) return;

    if (val && val.length !== 10) {
      setError("PHONE_NUMBER", "Mobile number must be exactly 10 digits");
    } else {
      clearError("PHONE_NUMBER");
    }

    setForm((p) => ({ ...p, PHONE_NUMBER: val }));
  };

  /* ================= FINAL VALIDATION ================= */

  const validateFinal = () => {
    const e = {};
    if (!form.USERID || form.USERID.length !== 7)
      e.USERID = "User ID must be exactly 7 digits";
    if (!form.FIRST_NAME || form.FIRST_NAME.length < 3)
      e.FIRST_NAME = "First Name is required";
    if (!form.LAST_NAME || form.LAST_NAME.length < 3)
      e.LAST_NAME = "Last Name is required";

    const prefix = (form.EMAIL || "").replace(EMAIL_DOMAIN, "");
    if (!prefix) e.EMAIL = "Email is required";

    if (!form.ROLE_ID) e.ROLE_ID = "Role is required";

    setErrors(e);
    return Object.keys(e).length === 0;
  };

  /* ================= SAVE ================= */

  const onSave = async () => {
    if (!validateFinal()) {
      snackbar("Please fix validation errors", "error");
      return;
    }

    if (_.isEqual(form, initialState)) {
      snackbar("No changes detected", "warning");
      return;
    }

    const wasF1BOG = initialState?.ROLE_ID === FORBIDDEN_ROLE_ID;
    const isF1BOGNow = form.ROLE_ID === FORBIDDEN_ROLE_ID;

    if (!wasF1BOG && isF1BOGNow) {
      snackbar("Assignment of role 'f1bog' is restricted", "error");
      return;
    }

    await callApi("/UM/user/create-request", {
      targetUserId: form.USERID,
      requestType: isEdit ? "MODIFY" : "CREATE",
      requestPayload: JSON.stringify(form),
    });

    snackbar(isEdit ? "User updated" : "User created", "success");
    onClose();
  };

  /* ================= RENDER ================= */

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>{isEdit ? "Edit User" : "Create User"}</DialogTitle>

      <DialogContent>
        <Stack spacing={2}>
          <TextField
            label="User ID *"
            value={form.USERID}
            onChange={(e) => handleUserIdChange(e.target.value)}
            error={!!errors.USERID}
            helperText={errors.USERID || "7 numeric digits"}
            fullWidth
            InputProps={{
              startAdornment: (
                <InputAdornment position="start">
                  <PersonIcon />
                </InputAdornment>
              ),
            }}
          />

          <Divider />

          <Grid container spacing={2}>
            <Grid size={{ xs: 4 }}>
              <TextField
                label="First Name *"
                value={form.FIRST_NAME}
                onChange={handleFirstNameChange}
                error={!!errors.FIRST_NAME}
                helperText={errors.FIRST_NAME || "3–30 characters"}
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 4 }}>
              <TextField
                label="Middle Name"
                value={form.MIDDLE_NAME}
                onChange={handleMiddleNameChange}
                error={!!errors.MIDDLE_NAME}
                helperText={errors.MIDDLE_NAME || "Optional"}
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 4 }}>
              <TextField
                label="Last Name *"
                value={form.LAST_NAME}
                onChange={handleLastNameChange}
                error={!!errors.LAST_NAME}
                helperText={errors.LAST_NAME || "3–30 characters"}
                fullWidth
              />
            </Grid>
          </Grid>

          <Grid container spacing={2}>
            <Grid size={{ xs: 6 }}>
              <TextField
                label="Email *"
                value={form.EMAIL || EMAIL_DOMAIN}
                onChange={(e) => handleEmailChange(e.target.value)}
                error={!!errors.EMAIL}
                helperText={errors.EMAIL}
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 6 }}>
              <TextField
                label="Mobile Number"
                value={form.PHONE_NUMBER}
                onChange={(e) => handleMobileChange(e.target.value)}
                error={!!errors.PHONE_NUMBER}
                helperText={errors.PHONE_NUMBER}
                fullWidth
              />
            </Grid>
          </Grid>

          <FormControl fullWidth error={!!errors.ROLE_ID}>
            <InputLabel>Role *</InputLabel>
            <Select
              value={form.ROLE_ID || ""}
              label="Role *"
              onChange={(e) => {
                const r = roles.find((x) => x.id === e.target.value);
                setForm({ ...form, ROLE_ID: r.id, ROLE_NAME: r.name });
                clearError("ROLE_ID");
              }}
            >
              {roles.map((r) => (
                <MenuItem
                  key={r.id}
                  value={r.id}
                  disabled={r.id === FORBIDDEN_ROLE_ID}
                >
                  {r.name}
                </MenuItem>
              ))}
            </Select>
            <Typography variant="caption" color="error">
              {errors.ROLE_ID}
            </Typography>
          </FormControl>
        </Stack>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={onSave}>
          {isEdit ? "Save Changes" : "Create User"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}