                </Grid>
                <Grid item xs={12} md={2.5}>
                  <TextField
                    label="Comp2"
                    value={details.comp2}
                    fullWidth
                    size="small"
                    InputProps={{ readOnly: true }}
                  />
                </Grid>
                <Grid item xs={12} md={3}>
                  <TextField
                    label="CGL Code"
                    value={details.cglCode}
                    fullWidth
                    size="small"
                    InputProps={{ readOnly: true }}
                  />
