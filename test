package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.LedgerWiseRequest;
import com.fincore.enquiry_service.model.LedgerTransaction;

import jakarta.persistence.criteria.Predicate;

import org.springframework.data.jpa.domain.Specification;

import java.util.ArrayList;
import java.util.List;

public class LedgerWiseSpecification {

    public static Specification<LedgerTransaction>
    filter(LedgerWiseRequest dto) {

        return (root, query, cb) -> {

            List<Predicate> predicates =
                    new ArrayList<>();

            // CGL

            if (dto.getCgl() != null) {

                predicates.add(
                        cb.equal(
                                root.get("cgl"),
                                dto.getCgl()
                        )
                );
            }

            // Currency

            if (
                    dto.getCurrencies() != null &&
                    !"ALL".equalsIgnoreCase(
                            dto.getCurrencies()
                    )
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currency"),
                                dto.getCurrencies()
                        )
                );
            }

            // Branches

            if (
                    dto.getBranches() != null &&
                    !dto.getBranches()
                            .contains("ALL")
            ) {

                predicates.add(
                        root.get("branchCode")
                                .in(dto.getBranches())
                );
            }

            // Source Flags

            if (
                    dto.getSourceFlags() != null &&
                    !dto.getSourceFlags()
                            .contains("ALL")
            ) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags())
                );
            }

            return cb.and(
                    predicates.toArray(
                            new Predicate[0]
                    )
            );
        };
    }
}