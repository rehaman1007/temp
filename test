/**
 * ViewRequestDialog
 *
 * This dialog displays the details of a request dynamically.
 * It renders:
 * 1. Request metadata (creator, status, request type, etc.)
 * 2. Dynamic payload fields
 * 3. Optional dynamic table
 * 4. Optional download action
 *
 * Rendering is optimized using useMemo to avoid repeated computations.
 */

import React, { useMemo } from "react";

import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
  IconButton,
  Stack,
} from "@mui/material";

import CloseIcon from "@mui/icons-material/Close";

import {
  timeStampFormatter,
  toPascalKebabCase,
  formatKeyForDisplay,
} from "../../utils/CommonUtilities";

import { ViewCommonDynamicTable } from "./ViewCommonDynamicTable";

const ViewRequestDialog = ({
  open,
  handleClose,
  data,
  screenConfig,
  handleDownload,
}) => {
  /**
   * If no data or payload exists,
   * do not render dialog.
   */
  if (!data?.payload) return null;

  const { payload } = data;

  /**
   * Extract table column configuration
   * from screenConfig safely
   */
  const tableColumns = screenConfig?.columns || [];

  /**
   * ==========================================================
   * Request Metadata
   * ==========================================================
   * Static fields displayed at the top of dialog
   *
   * useMemo ensures this array is not recreated
   * on every render unless 'data' changes.
   */
  const mainDetails = useMemo(
    () => [
      {
        label: "Creator ID",
        value: data.creatorId,
        size: 2,
      },
      {
        label: "Request Type",
        value: data.changeType === "ADD" ? "Added" : "Modified",
        size: 2.5,
      },
      {
        label: "Request Status",
        value: toPascalKebabCase(data.reqStatus),
        size: 2.5,
      },
      {
        label: "Requested Date",
        value: timeStampFormatter(data.reqDate),
        size: 5,
      },
    ],
    [data]
  );

  /**
   * ==========================================================
   * Dynamic Payload Fields
   * ==========================================================
   * Filter out system keys that should not be displayed
   *
   * Excluded keys:
   * - ShowCustomTable
   * - summaryData
   * - ShowDownload
   *
   * useMemo prevents recalculating on each render
   */
  const dynamicFields = useMemo(() => {
    return Object.entries(payload).filter(
      ([key]) =>
        !["ShowCustomTable", "summaryData", "ShowDownload"].includes(key)
    );
  }, [payload]);

  /**
   * ==========================================================
   * Conditional Rendering Flags
   * ==========================================================
   */

  /** Should custom table render */
  const showTable =
    payload?.ShowCustomTable &&
    (tableColumns.length > 0 || payload?.summaryData?.data?.length > 0);

  /** Should download button render */
  const showDownload = payload?.ShowDownload;

  /** Should action section render */
  const showActions = showDownload;

  /**
   * ==========================================================
   * Component Render
   * ==========================================================
   */

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="md" fullWidth>
      {/* ======================================================
          Dialog Header
         ====================================================== */}

      <DialogTitle
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          pr: 1,
        }}
      >
        <Typography variant="h6" fontWeight={700}>
          Request Details — <b>ID: {data.id}</b>
        </Typography>

        {/* Close Button moved to title area */}
        <IconButton onClick={handleClose} size="small">
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <Divider />

      {/* ======================================================
          Dialog Content
         ====================================================== */}

      <DialogContent sx={{ pt: 3 }}>
        {/* =============================
            Request Metadata Section
           ============================= */}

        <Grid container spacing={2}>
          {mainDetails.map((item) => (
            <Grid size={{ xs: 12, sm: item.size }} key={item.label}>
              <Stack spacing={0.5}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 700,
                    color: "text.secondary",
                  }}
                >
                  {item.label}
                </Typography>

                <Typography variant="body1">
                  {item.value ?? "N/A"}
                </Typography>
              </Stack>
            </Grid>
          ))}
        </Grid>

        {/* Divider shown only if dynamic fields exist */}
        {dynamicFields.length > 0 && <Divider sx={{ my: 2 }} />}

        {/* =============================
            Dynamic Payload Fields
           ============================= */}

        {dynamicFields.length > 0 && (
          <Grid container spacing={2}>
            {dynamicFields.map(([key, value]) => (
              <Grid size={{ xs: 12, sm: 4 }} key={key}>
                <Box>
                  {/* Field label */}
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: 700,
                      color: "text.secondary",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                    }}
                  >
                    {formatKeyForDisplay(key)}
                  </Typography>

                  {/* Field value */}
                  <Typography
                    variant="body1"
                    sx={{ wordBreak: "break-word" }}
                  >
                    {String(value ?? "N/A")}
                  </Typography>
                </Box>
              </Grid>
            ))}
          </Grid>
        )}

        {/* =============================
            Dynamic Table Section
           ============================= */}

        {showTable && (
          <>
            <Divider sx={{ my: 2 }} />

            {/* Table rendering handled by reusable component */}
            <ViewCommonDynamicTable data={payload} />
          </>
        )}
      </DialogContent>

      {/* ======================================================
          Dialog Actions
          Rendered only if actions exist
         ====================================================== */}

      {showActions && (
        <>
          <Divider />

          <DialogActions sx={{ p: 2 }}>
            {showDownload && (
              <Button
                onClick={handleDownload}
                variant="contained"
                sx={{
                  textTransform: "none",
                  borderRadius: 2,
                  px: 3,
                }}
              >
                Download
              </Button>
            )}
          </DialogActions>
        </>
      )}
    </Dialog>
  );
};

export default ViewRequestDialog;