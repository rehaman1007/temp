import { useEffect, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Box,
  MenuItem,
  Autocomplete,
  Typography,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import { useTableConfig } from "../../hooks/useTableConfig";
import { FilterBuilder } from "../FilterBuilder";

/* ---------------- CONSTANTS ---------------- */

const QUERY_TYPES = [
  "DB_VALUE",
  "DB_COUNT",
  "DB_SUM",
  "DB_AVG",
  "DB_MIN",
  "DB_MAX",
];

const EMPTY_SOURCE = {
  type: "",
  table: "",
  column: "",
  filters: {},
};

/* ---------------- COMPONENT ---------------- */

export const ColumnSourceDialog = ({
  open,
  value,
  onClose,
  onSave,
}) => {
  const { tableConfigs, getSelectableColumns } = useTableConfig();

  const [form, setForm] = useState(EMPTY_SOURCE);

  /* 🔥 FIXED EFFECT */
  useEffect(() => {
    if (open) {
      setForm({
        type: value?.type || "",
        table: value?.table || "",
        column: value?.column || "",
        filters: value?.filters || {},
      });
    }
  }, [open]);

  /* ---------------- HELPERS ---------------- */

  const update = (key, val) => {
    setForm((prev) => ({ ...prev, [key]: val }));
  };

  const selectedTable = tableConfigs?.find(
    (t) => t.tableName === form.table,
  );

  const columns = selectedTable
    ? getSelectableColumns(form.table)
    : [];

  const isValid =
    form.type && form.table && form.column;

  /* ---------------- UI ---------------- */

  return (
    <Dialog open={open} maxWidth="sm" fullWidth>
      <DialogTitle>
        Column Source
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        <Box display="flex" flexDirection="column" gap={2}>

          {/* QUERY TYPE */}
          <TextField
            select
            fullWidth
            label="Source Type"
            value={form.type}
            onChange={(e) => update("type", e.target.value)}
          >
            {QUERY_TYPES.map((q) => (
              <MenuItem key={q} value={q}>
                {q}
              </MenuItem>
            ))}
          </TextField>

          {/* TABLE + COLUMN */}
          <Box display="grid" gridTemplateColumns="1fr 1fr" gap={2}>
            <Autocomplete
              options={tableConfigs || []}
              getOptionLabel={(o) =>
                o?.label || o?.tableName || ""
              }
              value={
                tableConfigs?.find(
                  (t) => t.tableName === form.table,
                ) || null
              }
              onChange={(_, v) =>
                update("table", v?.tableName || "")
              }
              renderInput={(p) => (
                <TextField {...p} label="Table" />
              )}
            />

            <Autocomplete
              options={columns || []}
              getOptionLabel={(o) =>
                o?.label || o?.columnName || ""
              }
              value={
                columns.find(
                  (c) => c.columnName === form.column,
                ) || null
              }
              onChange={(_, v) =>
                update("column", v?.columnName || "")
              }
              renderInput={(p) => (
                <TextField {...p} label="Column" />
              )}
            />
          </Box>

          {/* FILTERS */}
          {form.column && (
            <>
              <Typography variant="subtitle2">
                Conditions
              </Typography>

              <FilterBuilder
                tableName={form.table}
                filters={form.filters}
                onFiltersChange={(f) =>
                  update("filters", f)
                }
              />
            </>
          )}
        </Box>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>

        <Button
          variant="contained"
          disabled={!isValid}
          onClick={() => onSave(form)}
        >
          Save
        </Button>
      </DialogActions>
    </Dialog>
  );
};