import React, { useState, useMemo } from "react";
import {
  Box,
  Button,
  IconButton,
  Stack,
  Tooltip,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";

export default function AcceptRejectSegments() {
  const [rows, setRows] = useState([
    { id: 1, segmentCode: "SEG001", description: "Segment One", status: "Pending" },
    { id: 2, segmentCode: "SEG002", description: "Segment Two", status: "Pending" },
  ]);

  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });
  const [remarks, setRemarks] = useState("");

  const columns = useMemo(
    () => [
      {
        field: "segmentCode",
        headerName: "Segment NUMBER",
        flex: 2,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "description",
        headerName: "Description",
        flex: 3,
        sortable: true,
      },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "actions",
        headerName: "Actions",
        sortable: false,
        flex: 1,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => (
          <Stack direction="row" spacing={0.5} alignItems="center">
            <Tooltip title="Accept">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("accept", params.row.id)}
                color="success"
              >
                <CheckIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
            <Tooltip title="Reject">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("reject", params.row.id)}
                color="error"
              >
                <ClearIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
          </Stack>
        ),
      },
    ],
    []
  );

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  const handleConfirm = () => {
    if (confirmDialog.type === "accept") {
      console.log("Accepted row:", confirmDialog.rowId);
    } else if (confirmDialog.type === "reject") {
      if (!remarks.trim()) {
        alert("Please provide remarks before rejecting.");
        return;
      }
      console.log("Rejected row:", confirmDialog.rowId, "Remarks:", remarks);
    }
    closeConfirmDialog();
  };

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={columns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [{ field: "segmentCode", sort: "asc" }] },
        }}
        getRowId={(row) => row.id}
        sx={{ height: 400, width: "100%" }}
      />

      {/* Confirmation Dialog */}
      <Dialog open={confirmDialog.open} onClose={closeConfirmDialog} maxWidth="sm" fullWidth>
        <DialogTitle>
          {confirmDialog.type === "accept" ? "Confirm Accept" : "Confirm Reject"}
        </DialogTitle>
        <DialogContent>
          <Typography>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to accept this row?"
              : "Are you sure you want to reject this row?"}
          </Typography>

          {confirmDialog.type === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={closeConfirmDialog} color="inherit">
            Cancel
          </Button>
          <Button onClick={handleConfirm} color={confirmDialog.type === "accept" ? "success" : "error"}>
            {confirmDialog.type === "accept" ? "Accept" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}