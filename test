import React, { useEffect, useMemo, useState } from "react";
import { Backdrop, Typography, Fade, Box } from "@mui/material";
import LogoImg from "../assets/Logos/Fincore_transperent.svg";

const LoadingOverlay = ({ loading, messages }) => {
  const defaultMessages = [
    "FinCore processing your request...",
    "Securing transaction tunnel...",
    "Just a moment...",
  ];

  const loadingMessages = useMemo(() => {
    return Array.isArray(messages) && messages.length > 0
      ? messages
      : defaultMessages;
  }, [messages]);

  const [messageIndex, setMessageIndex] = useState(0);

  // Rotate messages safely while loader is active
  useEffect(() => {
    let interval;
    if (loading && loadingMessages.length > 1) {
      interval = setInterval(() => {
        setMessageIndex((prev) => (prev + 1) % loadingMessages.length);
      }, 2500); // 2.5s gives users slightly more time to read rotating phrases smoothly
    }
    return () => {
      clearInterval(interval);
      if (!loading) setMessageIndex(0); // Reset index on close
    };
  }, [loading, loadingMessages]);

  return (
    <Backdrop
      open={loading}
      sx={{
        color: "#fff",
        zIndex: (theme) => theme.zIndex.drawer + 10000,
        flexDirection: "column",
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        background: "linear-gradient(to bottom right, rgba(15, 15, 25, 0.85), rgba(5, 5, 10, 0.92))",
        backdropFilter: "blur(8px)", // Gives a gorgeous premium glass blur effect over the app
        transition: "all 0.4s ease-in-out",
      }}
    >
      {/* HIGH-END BRAND ANIMATION CONTAINER */}
      <Box 
        sx={{ 
          position: "relative", 
          display: "flex", 
          justifyContent: "center", 
          alignItems: "center",
          mb: 4 
        }}
      >
        {/* Outer Pulsing Radar Ring */}
        <Box
          sx={{
            position: "absolute",
            width: 90,
            height: 90,
            borderRadius: "50%",
            border: "2px solid rgba(25, 118, 210, 0.4)",
            animation: "radar 2s infinite cubic-bezier(0.25, 0, 0, 1)",
            "@keyframes radar": {
              "0%": { transform: "scale(0.6)", opacity: 1 },
              "100%": { transform: "scale(1.4)", opacity: 0 }
            }
          }}
        />

        {/* Inner Glowing Aura */}
        <Box
          sx={{
            position: "absolute",
            width: 65,
            height: 65,
            borderRadius: "50%",
            backgroundColor: "rgba(25, 118, 210, 0.15)",
            filter: "blur(8px)",
            animation: "pulseGlow 2s infinite ease-in-out",
            "@keyframes pulseGlow": {
              "0%, 100%": { transform: "scale(0.9)", opacity: 0.5 },
              "50%": { transform: "scale(1.1)", opacity: 0.9 }
            }
          }}
        />

        {/* FinCore Interactive Logo */}
        <Box
          component="img"
          src={LogoImg}
          alt="FinCore Loading"
          sx={{
            width: 55,
            height: 55,
            objectFit: "contain",
            zIndex: 1,
            animation: "shimmer Breathing 2.5s infinite ease-in-out",
            "@keyframes shimmerBreathing": {
              "0%, 100%": { 
                transform: "scale(0.95)",
                filter: "drop-shadow(0 0 8px rgba(25, 118, 210, 0.3)) brightness(1)" 
              },
              "50%": { 
                transform: "scale(1.05)", 
                filter: "drop-shadow(0 0 20px rgba(25, 118, 210, 0.7)) brightness(1.2)" 
              }
            }
          }}
        />
      </Box>

      {/* ROTATING MESSAGES ENGINE */}
      {/* Min-height container prevents UI content below it from jumping 
        or vibrating up and down if your loading sentences have varying length layout footprints.
      */}
      <Box sx={{ minHeight: "40px", display: "flex", justifyContent: "center", alignItems: "center" }}>
        <Fade in={loading} key={messageIndex} timeout={400}>
          <Typography
            variant="body1"
            sx={{
              userSelect: "none",
              fontWeight: 500,
              letterSpacing: "0.5px",
              color: "rgba(255, 255, 255, 0.9)",
              textAlign: "center",
              px: 3,
            }}
          >
            {loadingMessages[messageIndex]}
          </Typography>
        </Fade>
      </Box>
    </Backdrop>
  );
};

export default LoadingOverlay;
