import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  Checkbox,
  Autocomplete,
  Divider,
  List,
} from "@mui/material";
import { useEffect, useState, useCallback } from "react";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import RestoreIcon from "@mui/icons-material/Restore";
import { validations } from "../../../utils/Validations";
import { DndProvider } from "react-dnd";
import { HTML5Backend } from "react-dnd-html5-backend";
import DraggablePermissionItem from "../../common/DraggablePermissionItem";

export default function RolesDialog({ open, onClose, form, setForm, canSave }) {
  const [selectedPermissions, setSelectedPermissions] = useState([]);
  const [originalOrder, setOriginalOrder] = useState([]);

  // Mock permission options (replace with API response)
  const allPermissions = Array.from({ length: 20 }).map((_, i) => ({
    id: i + 1,
    title: `Permission ${i + 1}`,
  }));

  /** Initialize permission order on open */
  useEffect(() => {
    if (form?.permissions?.length) {
      // ensure all permissions have order
      const withOrder = form.permissions.map((p, i) => ({
        ...p,
        order: p.order ?? i + 1,
      }));
      setSelectedPermissions(withOrder);
      setOriginalOrder(withOrder);
    } else {
      setSelectedPermissions([]);
      setOriginalOrder([]);
    }
  }, [form]);

  /** Handle input validation */
  const handleChange = (data, key, e, type) => {
    const result = validations(type, e.target.value);
    if (result === "") setForm({ ...data, [key]: e.target.value });
  };

  /** Update order dynamically when drag-drop occurs */
  const moveItem = useCallback(
    (from, to) => {
      const updated = [...selectedPermissions];
      const [moved] = updated.splice(from, 1);
      updated.splice(to, 0, moved);
      // reassign order sequentially
      const reOrdered = updated.map((item, idx) => ({
        ...item,
        order: idx + 1,
      }));
      setSelectedPermissions(reOrdered);
    },
    [selectedPermissions]
  );

  /** Reset to original order */
  const handleReset = () => setSelectedPermissions(originalOrder);

  /** Update permissions when user selects from autocomplete */
  const handlePermissionsSelect = (e, newValue) => {
    // add order if not present
    const withOrder = newValue.map((p, idx) => ({
      ...p,
      order: idx + 1,
    }));
    setSelectedPermissions(withOrder);
  };

  /** Final save handler */
  const handleSave = () => {
    const updatedForm = {
      ...form,
      permissions: selectedPermissions.map((p) => ({
        id: p.id,
        title: p.title,
        order: p.order,
      })),
    };
    console.log("Role Save Payload →", updatedForm);
    setForm(updatedForm);
    onClose();
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>{form.roleId ? "Edit Role" : "Add New Role"}</DialogTitle>

      {form.roleId && (
        <IconButton
          aria-label="role status"
          sx={{ position: "absolute", right: 10, top: 8, color: "grey.500" }}
        >
          {form.status === "ACTIVE" ? (
            <LockOutlineIcon color="error" />
          ) : (
            <LockOpenIcon color="success" />
          )}
          <Typography variant="caption">
            {form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK"}
          </Typography>
        </IconButton>
      )}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {/* Row 1: Role fields */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={4}>
              <TextField
                label="Role Name *"
                value={form.roleName || ""}
                onChange={(e) =>
                  handleChange(form, "roleName", e, "inputValue")
                }
                fullWidth
              />
            </Grid>
            <Grid item xs={12} md={8}>
              <TextField
                label="Description *"
                value={form.description || ""}
                onChange={(e) =>
                  handleChange(form, "description", e, "certainSpecialChars")
                }
                fullWidth
              />
            </Grid>
          </Grid>

          <Divider sx={{ my: 1 }} />

          {/* Row 2: Permission autocomplete */}
          <Autocomplete
            multiple
            options={allPermissions}
            disableCloseOnSelect
            getOptionLabel={(option) => option.title}
            value={selectedPermissions}
            onChange={handlePermissionsSelect}
            isOptionEqualToValue={(opt, val) => opt.id === val.id}
            renderOption={(props, option, { selected }) => (
              <li {...props} key={option.id}>
                <Checkbox checked={selected} sx={{ mr: 1 }} />
                {option.title}
              </li>
            )}
            renderInput={(params) => (
              <TextField {...params} label="Role Permissions" fullWidth />
            )}
            renderTags={() => null}
          />

          {/* Row 3: Permission order with drag */}
          <Stack spacing={1}>
            <Stack
              direction="row"
              justifyContent="space-between"
              alignItems="center"
            >
              <Typography variant="subtitle2">
                Permission Order ({selectedPermissions.length})
              </Typography>
              <IconButton onClick={handleReset}>
                <RestoreIcon />
              </IconButton>
            </Stack>
            <DndProvider backend={HTML5Backend}>
              <List sx={{ maxHeight: 200, overflowY: "auto" }}>
                {selectedPermissions.map((perm, index) => (
                  <DraggablePermissionItem
                    key={perm.id}
                    id={perm.id}
                    index={index}
                    title={`${perm.order}. ${perm.title}`}
                    moveItem={moveItem}
                  />
                ))}
              </List>
            </DndProvider>
          </Stack>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          variant="contained"
          disabled={!canSave}
          onClick={handleSave}
        >
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}