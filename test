import React from "react";
import { Chip, styled } from "@mui/material";

const TOKENS = {
  palette: {
    default: { bg: "#F3F4F6", text: "#111827", border: "#E5E7EB" },
    info: { bg: "#E6F0FF", text: "#0B4DA0", border: "#BFD9FF" },
    success: { bg: "#ECFDF5", text: "#0F6A3A", border: "#C6F6E8" },
    warning: { bg: "#FFFAEB", text: "#7A4A00", border: "#FFE7A8" },
    error: { bg: "#FFF1F2", text: "#7A0B0D", border: "#FFC1C6" },
  },
  // Added missing sizes definition required by your iconPosition logic
  sizes: {
    sm: { height: 24, fontSize: "0.75rem", gap: 4 },
    md: { height: 32, fontSize: "0.875rem", gap: 6 },
    lg: { height: 40, fontSize: "1rem", gap: 8 },
  },
};

const colorTokens = (kind) => TOKENS.palette[kind] || TOKENS.palette.default;
const sizeTokens = (kind) => TOKENS.sizes[kind] || TOKENS.sizes.md;

const StyledChip = styled(Chip, {
  shouldForwardProp: (prop) =>
    !["colorKind", "sizeKind", "variantKind"].includes(String(prop)),
})(({ colorKind, sizeKind, variantKind }) => {
  const pal = colorTokens(colorKind);
  const sz = sizeTokens(sizeKind);

  const background = variantKind === "filled" ? pal.bg : "transparent";
  const border =
    variantKind === "outlined" ? `1px solid ${pal.border}` : "none";

  return {
    borderRadius: 999,
    background,
    color: pal.text,
    border,
    minWidth: 40,
    fontWeight: 500,
    
    /* === RESPONSIVE RULES === */
    maxWidth: "100%", // Ensures the chip never exceeds its parent container's width
    height: sz.height,
    fontSize: sz.fontSize,

    "& .MuiChip-icon": {
      display: "inline-flex",
      alignItems: "center",
      justifyContent: "center",
    },
    
    "& .MuiChip-label": {
      display: "inline-flex",
      alignItems: "center",
      /* === TRUNCATION RULES === */
      whiteSpace: "nowrap",
      overflow: "hidden",
      textOverflow: "ellipsis",
      maxWidth: "100%", // Truncates text with '...' if screen is too thin
    },
  };
});

const CustomChip = ({
  label,
  color = "default",
  size = "md",
  icon,
  iconPosition = "start",
  variant = "filled",
  clickable = false,
  onClick,
  title,
  sx,
  className,
  chipProps = {},
}) => {
  const startIcon = icon && iconPosition === "start" ? icon : undefined;
  const endIcon = icon && iconPosition === "end" ? icon : undefined;
  
  // Safe fallback for gap just in case an invalid size string is passed
  const gap = TOKENS.sizes[size]?.gap || TOKENS.sizes.md.gap;

  return (
    <StyledChip
      role={clickable ? "button" : "status"}
      aria-label={typeof label === "string" ? label : undefined}
      title={typeof title === "string" ? title : typeof label === "string" ? label : undefined}
      clickable={clickable}
      onClick={onClick}
      icon={startIcon}
      colorKind={color}
      sizeKind={size}
      variantKind={variant}
      className={className}
      sx={sx}
      {...chipProps}
      label={
        iconPosition === "end" && endIcon ? (
          <span
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: gap,
              maxWidth: "100%", // Keeps internal wrapper responsive
            }}
          >
            <span
              style={{
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
              }}
            >
              {label}
            </span>
            <span style={{ display: "inline-flex", alignItems: "center" }}>
              {endIcon}
            </span>
          </span>
        ) : (
          label
        )
      }
    />
  );
};

export default CustomChip;
