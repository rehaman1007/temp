/* ---------------- NORMALIZATION ---------------- */

const normalizeStageDetails = (stages = []) => {
  const map = new Map();
  stages.forEach((s) => {
    const prev = map.get(s.processStage);
    if (!prev || s.startTime > prev.startTime) map.set(s.processStage, s);
  });

  return [...map.values()]
    .sort((a, b) => a.processStage - b.processStage)
    .map((s) => ({
      ...s,
      startTime: s.startTime ? timeStampFormatter(s.startTime) : null,
      endTime: s.endTime ? timeStampFormatter(s.endTime) : null,
    }));
};

const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType,
    stageDetails: normalizeStageDetails(p.stageDetails || []),
  }));

const mergeProcesses = (prev = [], incoming = []) => {
  const map = new Map(prev.map((p) => [p.type, p]));
  incoming.forEach((p) => map.set(p.type, p));
  return [...map.values()];
};

/* ---------------- FILE MAP ---------------- */

const FILE_MAP = {
  BALANCE: "balance_compare_report",
  SIBA: "intr_report",
  SUSPENSE: "cntr_report",
};

/* ================================================= */

const ProcessStatusPage = () => {
  const snackbar = useCustomSnackbar();
  const token = useSelector((s) => s.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const STREAM_URL = `${service}/process/processes`;

  /* ---------------- STATE ---------------- */

  const [processes, setProcesses] = useState([]);
  const [loading, setLoading] = useState(true);
  const [selectedProcessType, setSelectedProcessType] = useState(null);

  /* Summary dialog context */
  const [summaryCtx, setSummaryCtx] = useState(null);

  /* Global Download */
  const [downloadState, setDownloadState] = useState({
    running: false,
    type: null,
    mb: 0,
  });

  const initialFetchDone = useRef(false);

  /* ---------------- INITIAL LOAD ---------------- */

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    callApi("/PS/process/processes/data")
      .then((res) =>
        setProcesses(normalizeProcesses(res?.initialData || []))
      )
      .finally(() => setLoading(false));
  }, [callApi]);

  /* ---------------- SSE ---------------- */

  useEffect(() => {
    if (loading) return;

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: { Authorization: `Bearer ${token}` },
      onmessage(e) {
        if (e.event === "connected") return;
        setProcesses((p) =>
          mergeProcesses(p, normalizeProcesses(JSON.parse(e.data)))
        );
      },
    });

    return () => controller.abort();
  }, [STREAM_URL, token, loading]);

  /* ---------------- SUMMARY OPEN ---------------- */

  const handleOpenSummary = (row) => {
    const available = [];

    row.stageDetails.forEach((s) => {
      if (s.processStage === 6 && s.status === 2) available.push("BALANCE");
      if (s.processStage === 7 && s.status === 2) available.push("SIBA");
      if (s.processStage === 8 && s.status === 2) available.push("SUSPENSE");
    });

    setSummaryCtx({
      process: row,
      data: row.stageDetails.find((s) => s.processStage === 6)
        ?.differenceSummary,
      available,
    });
  };

  /* ---------------- DOWNLOAD ---------------- */

  const downloadReport = async (type, reconDate) => {
    try {
      setDownloadState({ running: true, type, mb: 0 });

      const res = await callApi(
        "/RS/reports/download",
        {
          moduleType: "WHOLE_BANK",
          fileName: FILE_MAP[type],
          date: reconDate,
        },
        "POST",
        "blob",
        "application/json",
        {
          onDownloadProgress: (e) => {
            if (e?.loaded) {
              setDownloadState((s) => ({
                ...s,
                mb: (e.loaded / (1024 * 1024)).toFixed(2),
              }));
            }
          },
        },
        false
      );

      const url = URL.createObjectURL(res.data);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${FILE_MAP[type]}_${reconDate}.zip`;
      a.click();
      URL.revokeObjectURL(url);

      snackbar("Report downloaded", "success");
    } catch {
      snackbar("Download failed", "error");
    } finally {
      setDownloadState({ running: false, type: null, mb: 0 });
    }
  };

  /* ================================================= */

  return (
    <>
      <Paper sx={{ p: 3 }}>
        <ProcessStatusHeader />

        {/* GLOBAL DOWNLOAD BAR */}
        {downloadState.running && (
          <Paper sx={{ p: 2, mb: 2 }}>
            <Stack direction="row" spacing={2} alignItems="center">
              <CloudDownloadTwoToneIcon color="primary" />
              <Box flexGrow={1}>
                <Typography fontWeight={600}>
                  Downloading {downloadState.type} Report
                </Typography>
                <LinearProgress />
                <Typography variant="caption">
                  {downloadState.mb} MB received
                </Typography>
              </Box>
            </Stack>
          </Paper>
        )}

        {/* TABLE */}
        <ProcessStatusTable
          loading={loading}
          processes={processes}
          actions={{
            onView: setSelectedProcessType,
            onSummary: handleOpenSummary,
          }}
        />
      </Paper>

      {/* DETAILS */}
      <ProcessDetailsDialog
        process={
          processes.find((p) => p.type === selectedProcessType) || null
        }
        onClose={() => setSelectedProcessType(null)}
      />

      {/* SUMMARY DIALOG */}
      <ProcessSummaryDialog
        open={!!summaryCtx}
        data={summaryCtx?.data}
        availableTypes={summaryCtx?.available}
        onClose={() => setSummaryCtx(null)}
        onDownload={(t) =>
          downloadReport(t, summaryCtx.data.RECON_RUN_DATE)
        }
      />
    </>
  );
};

export default ProcessStatusPage;

import {
  Dialog,
  DialogContent,
  Button,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
  Stack,
  IconButton,
  RadioGroup,
  FormControlLabel,
  Radio,
} from "@mui/material";

import CloseIcon from "@mui/icons-material/Close";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";
import { useEffect, useState } from "react";

/* ---------------- FORMAT ---------------- */

const formatAmount = (n) =>
  typeof n === "number" ? n.toLocaleString("en-IN") : "—";

/* ================================================= */

const ProcessSummaryDialog = ({
  open,
  data,
  availableTypes,
  onDownload,
  onClose,
}) => {

  const [type, setType] = useState(availableTypes?.[0]);

  useEffect(() => {
    setType(availableTypes?.[0]);
  }, [availableTypes]);

  if (!data) return null;

  return (
    <Dialog open={open} fullWidth maxWidth="md">

      {/* HEADER */}
      <Box sx={{ px:3, py:2, display:"flex", justifyContent:"space-between" }}>
        <Box>
          <Typography variant="h6">Difference Summary</Typography>
          <Typography variant="body2">
            Reconciliation Date: {data.RECON_RUN_DATE}
          </Typography>
        </Box>

        <IconButton onClick={onClose}>
          <CloseIcon />
        </IconButton>
      </Box>

      {/* BODY */}
      <DialogContent>

        <Stack direction="row" justifyContent="space-between" mb={2}>

          <RadioGroup row value={type} onChange={(e)=>setType(e.target.value)}>
            {availableTypes.map((t)=>(
              <FormControlLabel
                key={t}
                value={t}
                control={<Radio/>}
                label={t}
              />
            ))}
          </RadioGroup>

          <Button
            variant="contained"
            startIcon={<CloudDownloadTwoToneIcon/>}
            onClick={() => onDownload(type)}
          >
            Download Full Report
          </Button>

        </Stack>

        <TableContainer component={Paper}>
          <Table size="small">
            <TableHead>
              <TableRow>
                <TableCell>HEAD</TableCell>
                <TableCell align="right">TOTAL</TableCell>
                <TableCell align="right">NEW</TableCell>
              </TableRow>
            </TableHead>

            <TableBody>
              {data.summary.map((r,i)=>(
                <TableRow key={i}>
                  <TableCell>{r.HEAD}</TableCell>
                  <TableCell align="right">
                    {formatAmount(r.Total_no_of_entries)}
                  </TableCell>
                  <TableCell align="right">
                    {formatAmount(r["new entry"])}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>

          </Table>
        </TableContainer>

      </DialogContent>
    </Dialog>
  );
};

export default ProcessSummaryDialog;