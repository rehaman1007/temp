import React, { useMemo } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
  Chip,
  Stack,
} from "@mui/material";
import * as MuiIcons from "@mui/icons-material";

import {
  timeStampFormatter,
  toPascalKebabCase,
} from "../../utils/CommonUtilities";

const formatKeyForDisplay = (key) => {
  const result = key.replace(/([A-Z])/g, " $1").trim();
  return result.charAt(0).toUpperCase() + result.slice(1);
};

// returns icon component based on the string name from payload
const getIcon = (iconName) => {
  if (!iconName) return null;
  const IconComp = MuiIcons[iconName];
  return IconComp ? <IconComp fontSize="small" /> : null;
};

const RoleRequestView = ({ open, handleClose, data }) => {
  if (!data || !data.requestPayload) return null;

  // Parse JSON string requestPayload
  const payload = useMemo(() => {
    try {
      return JSON.parse(data.requestPayload);
    } catch (e) {
      return {};
    }
  }, [data]);

  const mainDetails = [
    { label: "Requestor ID", value: data.requestorUserId, size: 2 },
    {
      label: "Request Type",
      value: data.changeType === "ADD" ? "Create" : "Modify",
      size: 2.5,
    },
    {
      label: "Request Status",
      value: toPascalKebabCase(data.requestStatus),
      size: 2.5,
    },
    {
      label: "Requested Date",
      value: timeStampFormatter(data.reqDate),
      size: 5,
    },
  ];

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="md" fullWidth>
      <DialogTitle>
        Request Details - <b>ID: {data.requestId}</b>
      </DialogTitle>

      <Divider />

      <DialogContent>
        {/* Main Details */}
        <Grid container spacing={2}>
          {mainDetails.map((item) => (
            <Grid item xs={12} sm={item.size} key={item.label}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 800, color: "text.secondary" }}
                >
                  {item.label}
                </Typography>
                <Typography variant="body1" sx={{ color: "text.primary" }}>
                  {item.value ?? "N/A"}
                </Typography>
              </Box>
            </Grid>
          ))}
        </Grid>

        <Divider sx={{ my: 2 }} />

        {/* PAYLOAD VIEW */}
        <Typography
          variant="h6"
          sx={{ fontWeight: 700, mb: 1, textDecoration: "underline" }}
        >
          Request Payload
        </Typography>

        <Grid container spacing={2}>
          {Object.entries(payload).map(([key, value]) => (
            <Grid item xs={12} sm={4} key={key}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 800,
                    color: "text.secondary",
                  }}
                >
                  {formatKeyForDisplay(key)}
                </Typography>

                {/* SPECIAL CASE: PERMISSIONS LIST  */}
                {key === "permissions" && Array.isArray(value) ? (
                  <Stack direction="row" spacing={1} flexWrap="wrap" sx={{ mt: 1 }}>
                    {value.map((p) => (
                      <Chip
                        key={p.id}
                        icon={getIcon(p.icon)}
                        label={`${p.title}`}
                        variant="outlined"
                        sx={{
                          mb: 1,
                          fontWeight: 600,
                          borderRadius: 1.5,
                        }}
                      />
                    ))}
                  </Stack>
                ) : (
                  <Typography variant="body1" sx={{ color: "text.primary" }}>
                    {Array.isArray(value)
                      ? JSON.stringify(value)
                      : typeof value === "object" && value !== null
                      ? JSON.stringify(value, null, 2)
                      : String(value ?? "N/A")}
                  </Typography>
                )}
              </Box>
            </Grid>
          ))}
        </Grid>
      </DialogContent>

      <Divider />

      <DialogActions sx={{ p: 2 }}>
        <Button
          variant="contained"
          onClick={handleClose}
          color="primary"
          sx={{ textTransform: "none", borderRadius: 2, px: 3 }}
        >
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default RoleRequestView;