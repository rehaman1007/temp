        <DialogActions>
          <Button
            onClick={closeConfirmDialog}
            color="inherit"
            variant="contained"
          >
            Cancel
          </Button>
          {confirmDialog.type && confirmDialog.type === "accept" && (
            <Button onClick={handleConfirm} color="success" variant="contained">
              Approve
            </Button>
          )}
          {confirmDialog.type && confirmDialog.type === "reject" && (
            <Button onClick={handleConfirm} color="error" variant="contained">
              Reject
            </Button>
          )}
        </DialogActions>
      </Dialog>
    </Box>
  );
}
