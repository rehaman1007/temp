const handleChange = useCallback(
  (e) => {
    const { name, value, type, checked } = e.target;

    /* ---------------- HARD CONSTRAINTS ---------------- */

    if (name === "comp1") {
      if (!/^\d*$/.test(value)) {
        notifyOnce("Comp1 accepts digits only");
        return;
      }
      if (value.length > 4) {
        notifyOnce("Comp1 must be exactly 4 digits");
        return;
      }
    }

    if (name === "comp2") {
      if (!/^\d*$/.test(value)) {
        notifyOnce("Comp2 accepts numbers only");
        return;
      }
      if (value.length > 2) {
        notifyOnce("Comp2 should be 2 digits");
        return;
      }
    }

    if (name === "description") {
      if (!descRegex.test(value)) {
        notifyOnce("Invalid character in Description");
        return;
      }
    }

    /* ---------------- COMP1 (FIXED) ---------------- */

    if (name === "comp1") {
      const newComp1 = value;

      setCglData((prev) => {
        /* 🔴 CASE 1: CLEARED → RESET ALL DEPENDENTS */
        if (!newComp1) {
          return {
            ...prev,
            comp1: "",
            acClassification: "",
            defBalType: "",
            balFwd: false,
            balCompare: "1",
          };
        }

        /* 🟢 CASE 2: PRESENT */
        const mapped = classificationFromComp1(newComp1);
        const next = {
          ...prev,
          comp1: newComp1,
        };

        if (mapped) {
          next.acClassification = mapped;
          next.defBalType = defBalTypeFromClassification(mapped);

          if (mapped === "A" || mapped === "L") next.balFwd = true;
          else if (mapped === "I" || mapped === "E") next.balFwd = false;

          if (mapped === "I" || mapped === "E") next.balCompare = "0";
        } else {
          next.acClassification = "";
          next.defBalType = "";
          next.balFwd = false;
          next.balCompare = "1";
        }

        return next;
      });

      const mapped = classificationFromComp1(newComp1);
      setClassificationLocked(!!mapped);

      setErrors((prev) => ({
        ...prev,
        comp1: validateField("comp1", newComp1),
        acClassification: "",
      }));

      return;
    }

    /* ---------------- BALANCE FORWARD ---------------- */

    if (name === "balFwd") {
      setCglData((prev) => ({ ...prev, balFwd: checked }));
      setErrors((prev) => ({ ...prev, balFwd: "" }));
      return;
    }

    /* ---------------- BALANCE COMPARE ---------------- */

    if (name === "balCompare") {
      setCglData((prev) => ({ ...prev, balCompare: value }));
      setErrors((prev) => ({ ...prev, balCompare: "" }));
      return;
    }

    /* ---------------- DEFAULT UPDATE ---------------- */

    setCglData((prev) => ({
      ...prev,
      [name]: type === "checkbox" ? checked : value,
    }));

    const msg = validateField(name, type === "checkbox" ? checked : value);
    setErrors((prev) => ({ ...prev, [name]: msg }));
  },
  [notifyOnce, validateField]
);