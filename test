if (processedCount % STATUS_UPDATE_INTERVAL == 0 || processedCount == totalStatements) {

                            int progress = totalStatements == 0 ? 0 : (processedCount * 100) / totalStatements;

                            long elapsedSeconds = Duration.between(start, Instant.now()).toSeconds();

                            long executionSpeed = elapsedSeconds == 0 ? executedCount : executedCount / Math.max(elapsedSeconds, 1);

                            long etaSeconds = executionSpeed == 0 ? 0 : (totalStatements - processedCount) / executionSpeed;

                            Map<String, Object> status = new ConcurrentHashMap<>();

                            status.put("jobId", jobId);
                            status.put("status", "RUNNING");
                            status.put("progress", progress);
                            status.put("processedCount", processedCount);
                            status.put("executedCount", executedCount);
                            status.put("insertCount", insertCount);
                            status.put("updateCount", updateCount);
                            status.put("deleteCount", deleteCount);
                            status.put("otherCount", otherCount);
                            status.put("totalStatements", totalStatements);
                            status.put("executionSpeed", executionSpeed);
                            status.put("etaSeconds", etaSeconds);
                            status.put("currentLine", lineNumber);
                            status.put("startedAt", startedAt);
                            status.put("message", "Processing " + processedCount + " / " + totalStatements);
                            JOB_STATUS.put(jobId, status);
                        }
