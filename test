import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  Chip,
  CircularProgress,
  Grid,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import useApi from "../../hooks/useApi";

// ICONS
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import NoteIcon from "@mui/icons-material/Note";

// Classification lookup
const ACCOUNT_CLASSIFICATIONS = {
  A: { label: "Asset", icon: <DatasetIcon fontSize="small" />, color: "primary" },
  L: { label: "Liability", icon: <AccountBalanceWalletIcon fontSize="small" />, color: "warning" },
  I: { label: "Income", icon: <TrendingUpIcon fontSize="small" />, color: "success" },
  E: { label: "Expense", icon: <TrendingDownIcon fontSize="small" />, color: "error" },
  M: { label: "Memo A/c", icon: <NoteIcon fontSize="small" />, color: "info" },
};

export default function CglView() {
  const { callApi } = useApi();

  const [searchText, setSearchText] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search ----
  useEffect(() => {
    const text = searchText.trim();
    if (text.length < 3) {
      setOptions([]);
      return;
    }

    let cancel = false;

    const fetchData = async () => {
      try {
        setLoading(true);

        const res = await callApi(
          "/CM/cglWithSegment",
          { cglNumb: text, cglDesc: text },
          "GET"
        );

        if (!cancel) setOptions(res?.data?.data || []);
      } finally {
        if (!cancel) setLoading(false);
      }
    };

    fetchData();
    return () => (cancel = true);
  }, [searchText, callApi]);

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* SINGLE SEARCH FIELD */}
      <Autocomplete
        fullWidth
        value={selected}
        loading={loading}
        options={options}
        onChange={(_, value) => setSelected(value)}
        getOptionLabel={(opt) =>
          opt ? `${opt.cglNumber} - ${opt.description}` : ""
        }
        noOptionsText={
          searchText.length < 3
            ? "Type at least 3 characters..."
            : "No results found"
        }
        renderInput={(params) => (
          <TextField
            {...params}
            label="Search by CGL Number or Description"
            placeholder="Start typing..."
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
            InputProps={{
              ...params.InputProps,
              endAdornment: (
                <>
                  {loading && <CircularProgress size={18} />}
                  {params.InputProps.endAdornment}
                </>
              ),
            }}
          />
        )}
        sx={{ mb: 3 }}
      />

      {/* DETAILS CARD */}
      <Card sx={{ p: 3 }}>
        {!selected ? (
          <Typography sx={{ color: "gray" }}>No record selected</Typography>
        ) : (
          <Grid container spacing={3}>

            {/* Header Row */}
            <Grid item xs={12}>
              <Stack direction="row" justifyContent="space-between" alignItems="center">
                <Typography variant="h6" fontWeight={600}>
                  {selected.cglNumber}
                </Typography>

                {ACCOUNT_CLASSIFICATIONS[selected.acClassification] && (
                  <Chip
                    variant="filled"
                    color={ACCOUNT_CLASSIFICATIONS[selected.acClassification].color}
                    icon={ACCOUNT_CLASSIFICATIONS[selected.acClassification].icon}
                    label={ACCOUNT_CLASSIFICATIONS[selected.acClassification].label}
                  />
                )}
              </Stack>
            </Grid>

            {/* Row Groups: 2–3 per row */}
            {[
              { label: "Description", value: selected.description },
              { label: "Comp1", value: selected.comp1 },
              { label: "Comp2", value: selected.comp2 },
              { label: "Segment Code", value: selected.segmentCode },
              { label: "Segment Description", value: selected.segmentDescription },
              { label: "Balance Compare", value: selected.balcompare === 1 ? "Include" : "Exclude" },
              { label: "Manual Posting", value: selected.manualPosting === 1 ? "Allowed" : "Not Allowed" },
              { label: "Balance Forward", value: selected.balFwd === 1 ? "Yes" : "No" },
              { label: "Open Date", value: selected.openDate || "-" },
              { label: "Close Date", value: selected.closeDate || "-" },
            ].map((item, idx) => (
              <Grid item xs={12} sm={6} md={4} key={idx}>
                <Typography fontWeight={600} sx={{ color: "#555" }}>
                  {item.label}
                </Typography>
                <Typography sx={{ fontSize: "15px" }}>{item.value}</Typography>
              </Grid>
            ))}

          </Grid>
        )}
      </Card>
    </Box>
  );
}