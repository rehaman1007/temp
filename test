import { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Box,
  Typography,
  IconButton,
  FormControl,
  FormLabel,
  MenuItem,
  Autocomplete,
  Divider,
  Paper,
  ToggleButton,
  ToggleButtonGroup,
  Alert,
  AlertTitle,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import DataObjectIcon from "@mui/icons-material/DataObject";
import SettingsEthernetIcon from "@mui/icons-material/SettingsEthernet";
import WarningIcon from "@mui/icons-material/Warning";

import { useTableConfig } from "../../hooks/useTableConfig";
import { FilterBuilder } from "../editor/FilterBuilder";
import { toPascalKebabCase } from "../../../../utils/CommonUtilities";
import ExpressionEditorWithVariables from "./ExpressionEditorWithVariables";
import useCustomSnackbar from "../../../../utils/useCustomSnackbar";

/* ---------------- CONSTANTS ---------------- */

const dataTypes = ["DATE", "STRING", "NUMBER", "BOOLEAN"];
const modes = ["INPUT", "EXPRESSION", "QUERY"];
const queryTypes = [
  "DB_VALUE",
  "DB_COUNT",
  "DB_SUM",
  "DB_AVG",
  "DB_MIN",
  "DB_MAX",
];

const NAME_REGEX = /^[A-Z0-9_]+$/;
const LABEL_REGEX = /^[A-Za-z0-9 _-]+$/;
const DESCRIPTION_REGEX = /^[a-zA-Z0-9\s/&().,-]*$/;

const emptyState = {
  name: "",
  label: "",
  description: "",
  dataType: "DATE",
  mode: "INPUT",
  expression: "",
  defaultValue: "",
  source: {
    type: "",
    table: "",
    column: "",
    filters: {},
  },
};

/* ---------------- COMPONENT ---------------- */

export const GlobalVariableDialog = ({
  open,
  globalVariable,
  globals = [],
  onClose,
  onSave,
}) => {
  const { tableConfigs, getSelectableColumns } = useTableConfig();
  const snackBar = useCustomSnackbar();
  const [form, setForm] = useState(emptyState);
  const [errors, setErrors] = useState({});

  const isEdit = Boolean(globalVariable);

  useEffect(() => {
    setForm(globalVariable || emptyState);
    setErrors({});
  }, [globalVariable, open]);

  /* ---------------- UPDATE ---------------- */

  const update = (key, val) => {
    if (key.startsWith("source.")) {
      const k = key.split(".")[1];
      setForm((p) => ({ ...p, source: { ...p.source, [k]: val } }));
    } else {
      setForm((p) => ({ ...p, [key]: val }));
    }
  };

  /* ---------------- FIELD VALIDATION ---------------- */

  const validateName = (value) => {
    if (!value) return "Variable name required";
    if (value.length < 3) return "Minimum 3 characters";
    if (value.length > 40) return "Maximum 40 characters";
    if (!NAME_REGEX.test(value)) return "Only A-Z, 0-9 and _ allowed";

    const duplicate = globals.some(
      (g) => g.name === value && g.name !== globalVariable?.name
    );

    if (duplicate) return "Variable already exists";
    return "";
  };

  const validateLabel = (value) => {
    if (!value) return "Label required";
    if (value.length < 3) return "Minimum 3 characters";
    if (value.length > 60) return "Maximum 60 characters";
    if (!LABEL_REGEX.test(value))
      return "Only letters, numbers, space, - and _ allowed";
    return "";
  };

  const validateDescription = (value) => {
    if (!value) return "Description required";
    if (value.length < 5) return "Minimum 5 characters";
    if (value.length > 200) return "Maximum 200 characters";
    if (!DESCRIPTION_REGEX.test(value))
      return "Allowed 5-200 characters (alphabets, numbers, spaces, ,()&/- allowed!)";
    return "";
  };

  const validateForm = () => {
    const e = {};

    e.name = validateName(form.name);
    e.label = validateLabel(form.label);
    e.description = validateDescription(form.description);

    if (!form.dataType) e.dataType = "Select data type";

    if (form.mode === "EXPRESSION" && !form.expression)
      e.expression = "Expression required";

    if (form.mode === "QUERY") {
      if (!form.source.type) e.type = "Select query type";
      if (!form.source.table) e.table = "Select table";
      if (!form.source.column) e.column = "Select column";
    }

    Object.keys(e).forEach((k) => !e[k] && delete e[k]);
    setErrors(e);

    return Object.keys(e).length === 0;
  };

  const handleSave = () => {
    if (!validateForm()) {
      snackBar("Kindly fill the required fields before saving", "error");
      return;
    }
    onSave(form);
    onClose();
  };

  /* ---------------- DERIVED ---------------- */

  const selectedTable = tableConfigs?.find(
    (t) => t.tableName === form?.source?.table
  );

  const columns = selectedTable ? getSelectableColumns(form.source?.table) : [];

  /* ---------------- UI ---------------- */

  return (
    <Dialog 
      open={open} 
      maxWidth="md" 
      fullWidth 
      PaperProps={{ 
        sx: { borderRadius: 3, bgcolor: "background.default" } 
      }}
    >
      <DialogTitle sx={{ pb: 1, display: 'flex', alignItems: 'center', gap: 1 }}>
        <DataObjectIcon color="primary" />
        <Typography variant="h6" fontWeight="bold">
          {isEdit ? "Edit Global Variable" : "New Global Variable"}
        </Typography>
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers sx={{ p: 3, display: "flex", flexDirection: "column", gap: 3 }}>
        
        {/* ZONE 1: Core Information */}
        <Paper elevation={0} sx={{ p: 2.5, borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
          <Typography variant="subtitle2" color="text.secondary" mb={2} textTransform="uppercase" letterSpacing={1}>
            Core Details
          </Typography>
          
          <Box display="grid" gridTemplateColumns="1fr 1fr" gap={2}>
            <TextField
              label="Variable Name *"
              variant="filled"
              value={form.name}
              error={!!errors.name}
              helperText={errors.name || "A-Z, 0-9, _. Used as $G{VAR}"}
              onChange={(e) => {
                const newValue = e.target.value.toUpperCase().replace(/[^A-Z0-9_]/g, "");
                update("name", newValue);
                setErrors((p) => ({ ...p, name: validateName(newValue) }));
              }}
            />

            <TextField
              label="Display Label *"
              variant="filled"
              value={form.label}
              error={!!errors.label}
              helperText={errors.label || "User-friendly name"}
              onChange={(e) => {
                let newValue = e.target.value.replace(/[^A-Za-z0-9 _-]/g, "").replace(/\s\s+/g, " ");
                setErrors((p) => ({ ...p, label: validateLabel(e.target.value) }));
                update("label", newValue);
              }}
            />
          </Box>

          <TextField
            sx={{ mt: 2 }}
            label="Description *"
            variant="filled"
            fullWidth
            multiline
            rows={2}
            value={form.description}
            error={!!errors.description}
            helperText={errors.description || "Brief explanation of what this variable does."}
            onChange={(e) => {
              const cleanedValue = e.target.value
                .replace(/\s{2,}/g, " ")
                .replace(/[^a-zA-Z0-9\s/&().,-]/g, "");
              update("description", cleanedValue);
              setErrors((p) => ({ ...p, description: validateDescription(cleanedValue) }));
            }}
          />
        </Paper>

        {/* ZONE 2: Variable Configuration */}
        <Paper elevation={0} sx={{ p: 2.5, borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
          <Typography variant="subtitle2" color="text.secondary" mb={2} textTransform="uppercase" letterSpacing={1}>
            Configuration
          </Typography>

          <Box display="grid" gridTemplateColumns={{ xs: "1fr", sm: "1fr 1fr" }} gap={4}>
            {/* DATA TYPE - Segmented Control */}
            <FormControl fullWidth>
              <FormLabel sx={{ mb: 1, fontWeight: 500, color: "text.primary" }}>
                Data Type
              </FormLabel>
              <ToggleButtonGroup
                color="primary"
                value={form.dataType}
                exclusive
                fullWidth
                onChange={(e, newVal) => newVal && update("dataType", newVal)}
              >
                {dataTypes.map((m) => (
                  <ToggleButton key={m} value={m} sx={{ py: 1 }}>
                    {toPascalKebabCase(m)}
                  </ToggleButton>
                ))}
              </ToggleButtonGroup>
            </FormControl>

            {/* MODE - Segmented Control */}
            <FormControl fullWidth>
              <FormLabel sx={{ mb: 1, fontWeight: 500, color: "text.primary" }}>
                Resolution Mode
              </FormLabel>
              <ToggleButtonGroup
                color="secondary"
                value={form.mode}
                exclusive
                fullWidth
                onChange={(e, newVal) => newVal && update("mode", newVal)}
              >
                {modes.map((m) => (
                  <ToggleButton key={m} value={m} sx={{ py: 1 }}>
                    {toPascalKebabCase(m)}
                  </ToggleButton>
                ))}
              </ToggleButtonGroup>
            </FormControl>
          </Box>
        </Paper>

        {/* ZONE 3: Contextual Mode Settings */}
        <Box sx={{ minHeight: "100px", display: "flex", flexDirection: "column", justifyContent: "center" }}>
          
          {/* INPUT MODE */}
          {form.mode === "INPUT" && (
            <Box sx={{ animation: "fadeIn 0.3s ease-in-out" }}>
              <Alert severity="info" icon={<WarningIcon />} sx={{ mb: 2, borderRadius: 2 }}>
                <AlertTitle>Interactive Input</AlertTitle>
                When mode is set to <strong>Input</strong>, values are prompted at runtime. A new parameter has been included in the variant configuration.
              </Alert>
              
              <TextField
                label="Default Value"
                variant="outlined"
                value={form.defaultValue || ""}
                fullWidth
                error={!!errors.defaultValue}
                helperText={errors.defaultValue || "Optional fallback value"}
                onChange={(e) => {
                  let newValue = e.target.value.replace(/[^A-Za-z0-9 _-]/g, "").replace(/\s\s+/g, " ");
                  // BUG FIX: changed update("label", newValue) to update("defaultValue", newValue)
                  update("defaultValue", newValue);
                }}
              />
            </Box>
          )}

          {/* EXPRESSION MODE */}
          {form.mode === "EXPRESSION" && (
            <Box sx={{ animation: "fadeIn 0.3s ease-in-out" }}>
              <Typography variant="subtitle2" sx={{ mb: 1, display: 'flex', alignItems: 'center', gap: 1 }}>
                <SettingsEthernetIcon fontSize="small" color="action" /> Define Expression
              </Typography>
              <ExpressionEditorWithVariables
                globals={globals}
                value={form.expression}
                placeholder="e.g. #{ 1000 * G.USD_RATE }"
                onChange={(v) => update("expression", v)}
              />
              {errors.expression && (
                <Typography color="error" variant="caption" sx={{ mt: 1, display: "block" }}>
                  {errors.expression}
                </Typography>
              )}
            </Box>
          )}

          {/* QUERY MODE */}
          {form.mode === "QUERY" && (
            <Box sx={{ animation: "fadeIn 0.3s ease-in-out" }}>
              <Typography variant="subtitle2" sx={{ mb: 2 }}>Database Query Builder</Typography>
              
              <Box display="grid" gridTemplateColumns="1fr 1fr 1fr" gap={2}>
                <TextField
                  select
                  fullWidth
                  label="Query Type"
                  value={form.source.type}
                  error={!!errors.type}
                  helperText={errors.type}
                  onChange={(e) => update("source.type", e.target.value)}
                >
                  {queryTypes.map((q) => (
                    <MenuItem key={q} value={q}>{q}</MenuItem>
                  ))}
                </TextField>

                <Autocomplete
                  options={tableConfigs || []}
                  getOptionLabel={(o) => o?.label || o?.tableName || o || ""}
                  onChange={(_, v) => update("source.table", v?.tableName || "")}
                  value={form.source.table || ""}
                  renderInput={(p) => (
                    <TextField {...p} label="Table" error={!!errors.table} helperText={errors.table} />
                  )}
                />

                <Autocomplete
                  options={columns || []}
                  getOptionLabel={(o) => o?.label || o?.columnName || o || ""}
                  onChange={(_, v) => update("source.column", v || "")}
                  value={form?.source?.column || ""}
                  renderInput={(p) => (
                    <TextField {...p} label="Column" error={!!errors.column} helperText={errors.column} />
                  )}
                />
              </Box>

              {form.source.column && (
                <Paper elevation={0} sx={{ mt: 2, p: 2, bgcolor: "action.hover", borderRadius: 2 }}>
                  <Typography variant="caption" color="text.secondary" fontWeight={600} mb={1} display="block">
                    FILTERS
                  </Typography>
                  <FilterBuilder
                    tableName={form.source.table}
                    filters={form.source.filters}
                    onFiltersChange={(f) => update("source.filters", f)}
                  />
                </Paper>
              )}
            </Box>
          )}
        </Box>
      </DialogContent>

      <DialogActions sx={{ px: 3, py: 2 }}>
        <Button onClick={onClose} color="inherit" sx={{ fontWeight: 600 }}>
          Cancel
        </Button>
        <Button variant="contained" onClick={handleSave} disableElevation sx={{ borderRadius: 2, px: 3, fontWeight: 600 }}>
          {isEdit ? "Save Changes" : "Create Variable"}
        </Button>
      </DialogActions>
    </Dialog>
  );
};
