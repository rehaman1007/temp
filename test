@Override
public Map<String, Object> executeAdminSql(
        AdminSupportDTO dto,
        String userId,
        HttpServletRequest request
) {

    Instant start = Instant.now();

    String clientIp = getClientIp(request);

    String rawSql = dto.getSql() == null ? "" : dto.getSql().trim();

    Map<String, Object> response = new HashMap<>();

    try {

        log.info("""
                
                ==================================================
                ADMIN SQL EXECUTION STARTED
                ==================================================
                userId={}
                clientIp={}
                page={}
                size={}
                sql={}
                ==================================================
                """,
                userId,
                clientIp,
                dto.getPage(),
                dto.getSize(),
                rawSql
        );

        // --------------------------------------------------
        // CLEAN SCRIPT
        // --------------------------------------------------

        rawSql = rawSql.replaceAll(";\\s*$", "").trim();

        String[] statements = rawSql.split(";");

        List<String> cleanStatements = new ArrayList<>();

        for (String stmt : statements) {

            String clean = stmt
                    .replaceAll("(?m)^--.*", "")
                    .trim();

            if (!clean.isEmpty()) {
                cleanStatements.add(clean);
            }
        }

        if (cleanStatements.isEmpty()) {

            response.put("error", true);
            response.put("message", "SQL cannot be empty");

            return response;
        }

        // --------------------------------------------------
        // SINGLE SELECT
        // --------------------------------------------------

        boolean isSingleSelect =
                cleanStatements.size() == 1
                        &&
                        cleanStatements.get(0)
                                .trim()
                                .toUpperCase()
                                .startsWith("SELECT");

        int page = dto.getPage() != null ? dto.getPage() : 0;
        int size = dto.getSize() != null ? dto.getSize() : 10;

        if (isSingleSelect) {

            String executableSelect = cleanStatements.get(0);

            // -------------------------------
            // COUNT
            // -------------------------------

            String countSql =
                    "SELECT COUNT(*) FROM (" + executableSelect + ")";

            Integer total =
                    jdbcTemplate.queryForObject(
                            countSql,
                            Integer.class
                    );

            if (total == null) {
                total = 0;
            }

            // -------------------------------
            // PAGINATION
            // -------------------------------

            int startRow = page * size;
            int endRow = startRow + size;

            String paginatedSql = """
                    SELECT * FROM
                    (
                        SELECT A.*, ROWNUM RN FROM
                        (
                    """ + executableSelect + """
                        ) A
                        WHERE ROWNUM <= ?
                    )
                    WHERE RN > ?
                    """;

            List<Map<String, Object>> rawRows =
                    jdbcTemplate.queryForList(
                            paginatedSql,
                            endRow,
                            startRow
                    );

            // -------------------------------
            // CLEAN ORACLE TYPES
            // -------------------------------

            List<Map<String, Object>> rows =
                    new ArrayList<>();

            for (Map<String, Object> rawRow : rawRows) {

                Map<String, Object> cleanRow =
                        new LinkedHashMap<>();

                for (Map.Entry<String, Object> entry : rawRow.entrySet()) {

                    Object value = entry.getValue();

                    if (value instanceof oracle.sql.TIMESTAMP ts) {

                        cleanRow.put(
                                entry.getKey(),
                                ts.timestampValue().toString()
                        );
                    }

                    else if (value instanceof java.sql.Timestamp ts) {

                        cleanRow.put(
                                entry.getKey(),
                                ts.toLocalDateTime().toString()
                        );
                    }

                    else if (value instanceof java.sql.Clob clob) {

                        cleanRow.put(
                                entry.getKey(),
                                clob.getSubString(
                                        1,
                                        (int) clob.length()
                                )
                        );
                    }

                    else if (value instanceof java.io.InputStream) {

                        cleanRow.put(
                                entry.getKey(),
                                "[BLOB DATA]"
                        );
                    }

                    else if (
                            value != null
                                    &&
                                    value.getClass()
                                            .getName()
                                            .startsWith("oracle.sql.")
                    ) {

                        cleanRow.put(
                                entry.getKey(),
                                value.toString()
                        );
                    }

                    else {

                        cleanRow.put(
                                entry.getKey(),
                                value
                        );
                    }
                }

                rows.add(cleanRow);
            }

            // -------------------------------
            // COLUMNS
            // -------------------------------

            List<Map<String, String>> columns =
                    new ArrayList<>();

            if (!rows.isEmpty()) {

                for (String key : rows.get(0).keySet()) {

                    columns.add(
                            Map.of("name", key)
                    );
                }
            }

            response.put("error", false);
            response.put("columns", columns);
            response.put("rows", rows);
            response.put("total", total);
            response.put("page", page);
            response.put("size", size);

            log.info("""
                    
                    SELECT EXECUTED
                    | rows={}
                    | total={}
                    | executionTime={} ms
                    """,
                    rows.size(),
                    total,
                    Duration.between(start, Instant.now()).toMillis()
            );

            return response;
        }

        // --------------------------------------------------
        // SCRIPT EXECUTION
        // --------------------------------------------------

        int successCount = 0;

        for (int i = 0; i < cleanStatements.size(); i++) {

            String sql = cleanStatements.get(i);

            try {

                jdbcTemplate.execute(sql);

                successCount++;

                log.info("""
                        
                        STATEMENT EXECUTED
                        | line={}
                        | sql={}
                        """,
                        i + 1,
                        sql
                );

            } catch (Exception e) {

                log.error("""
                        
                        SCRIPT EXECUTION FAILED
                        | line={}
                        | sql={}
                        | error={}
                        """,
                        i + 1,
                        sql,
                        e.getMessage(),
                        e
                );

                response.put("error", true);
                response.put(
                        "message",
                        "Error at statement "
                                + (i + 1)
                                + " : "
                                + e.getMessage()
                );

                response.put("failedSql", sql);

                return response;
            }
        }

        response.put("error", false);
        response.put(
                "message",
                "Script executed successfully"
        );
        response.put("executedStatements", successCount);

        response.put(
                "rows",
                List.of(
                        Map.of(
                                "RESULT",
                                successCount
                                        + " statements executed successfully"
                        )
                )
        );

        response.put(
                "columns",
                List.of(
                        Map.of("name", "RESULT")
                )
        );

        response.put("total", 1);

        log.info("""
                
                ==================================================
                SCRIPT EXECUTION COMPLETED
                ==================================================
                executedStatements={}
                executionTime={} ms
                ==================================================
                """,
                successCount,
                Duration.between(start, Instant.now()).toMillis()
        );

        return response;

    } catch (Exception e) {

        log.error(
                "ADMIN SQL EXECUTION FAILED",
                e
        );

        response.put("error", true);
        response.put("message", e.getMessage());

        return response;
    }
}