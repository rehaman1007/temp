import React, { useState, useEffect, useCallback } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  List,
  Stack,
  Typography,
  Divider,
  Tooltip,
} from "@mui/material";
import RestoreIcon from "@mui/icons-material/Restore";
import { DndProvider } from "react-dnd";
import { HTML5Backend } from "react-dnd-html5-backend";
import * as MuiIcons from "@mui/icons-material";
import DraggablePermissionItem from "./DraggablePermissionItem";

export default function PermissionsDialog({
  open,
  handleSavePermissionOrder,
  onClose,
  permissions = [],
  roleName = "",
}) {
  const [ordered, setOrdered] = useState(permissions);
  const [original, setOriginal] = useState(permissions);

  useEffect(() => {
    if (permissions?.length) {
      const withOrder = permissions.map((p, i) => ({
        ...p,
        order: p.order ?? i + 1,
      }));
      setOrdered(withOrder);
      setOriginal(permissions);
    } else {
      setOrdered([]);
      setOriginal([]);
    }
  }, [permissions]);

  const moveItem = useCallback(
    (from, to) => {
      const updated = [...ordered];
      const [moved] = updated.splice(from, 1);
      updated.splice(to, 0, moved);
      const reOrdered = updated.map((item, idx) => ({
        ...item,
        order: idx + 1,
      }));
      setOrdered(reOrdered);
    },
    [ordered],
  );

  const handleReset = () => setOrdered(original);

  /** Render dynamic MUI icon from string name */
  const renderIcon = (iconName) => {
    const IconComp = MuiIcons[iconName];
    return IconComp ? (
      <IconComp fontSize="small" />
    ) : (
      <MuiIcons.HelpOutline fontSize="small" />
    );
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>
        Permissions for <b>{roleName}</b> Role
      </DialogTitle>
      <DialogContent>
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          sx={{ m: 1 }}
        >
          <Typography variant="subtitle2">
            Total Active Permissions: {ordered.length}
          </Typography>
          <Tooltip title="Reset Order">
            <Button
              size="small"
              color="primary"
              onClick={handleReset}
              variant="outlined"
              startIcon={<RestoreIcon />}
              sx={{ align: "center", height: "100%" }}
            >
              Reset
            </Button>
          </Tooltip>
        </Stack>
        <Divider sx={{ mb: 2 }} />
        <DndProvider backend={HTML5Backend}>
          {/* Added slight padding to avoid shadow clipping on hover */}
          <List sx={{ minHeight: 400, overflowY: "auto", px: 0.5 }}>
            {ordered.map((perm, i) => (
              <DraggablePermissionItem
                key={perm.id}
                perm={perm}
                index={i}
                icon={renderIcon(perm.icon)}
                moveItem={moveItem}
              />
            ))}
          </List>
        </DndProvider>
      </DialogContent>
      <DialogActions>
        <Button
          onClick={() => {
            handleReset();
            onClose();
          }}
        >
          Cancel
        </Button>
        <Button
          variant="contained"
          onClick={() => {
            handleSavePermissionOrder(ordered, original);
          }}
        >
          Save Order
        </Button>
      </DialogActions>
    </Dialog>
  );
}



import { useRef } from "react";
import { useDrag, useDrop } from "react-dnd";
import {
  ListItem,
  ListItemIcon,
  Box,
  Typography,
  IconButton,
  Chip,
  Stack,
  Tooltip,
} from "@mui/material";
import DragIndicatorIcon from "@mui/icons-material/DragIndicator";
import LockPersonIcon from "@mui/icons-material/LockPerson";

const ItemType = "PERMISSION_ITEM";

export default function DraggablePermissionItem({
  perm,
  index,
  icon,
  moveItem,
}) {
  const ref = useRef(null);

  // --- Drag and drop setup ---
  const [, drop] = useDrop({
    accept: ItemType,
    hover(item, monitor) {
      if (!ref.current) return;
      const dragIndex = item.index;
      const hoverIndex = index;
      if (dragIndex === hoverIndex) return;

      const hoverBoundingRect = ref.current?.getBoundingClientRect();
      const hoverMiddleY =
        (hoverBoundingRect.bottom - hoverBoundingRect.top) / 2;
      const clientOffset = monitor.getClientOffset();
      const hoverClientY = clientOffset.y - hoverBoundingRect.top;

      if (dragIndex < hoverIndex && hoverClientY < hoverMiddleY) return;
      if (dragIndex > hoverIndex && hoverClientY > hoverMiddleY) return;

      moveItem(dragIndex, hoverIndex);
      item.index = hoverIndex;
    },
  });

  const [{ isDragging }, drag] = useDrag({
    type: ItemType,
    item: { id: perm.id, index },
    collect: (monitor) => ({
      isDragging: monitor.isDragging(),
    }),
  });

  drag(drop(ref));

  // Destructure variables for UI logic
  const isRestricted = perm.isRestricted === "Y";
  const actions = perm.menuAction
    ? perm.menuAction.split("|").filter(Boolean)
    : [];

  return (
    <ListItem
      ref={ref}
      sx={{
        opacity: isDragging ? 0.3 : 1,
        // Distinct styling for restricted vs normal screens
        border: isRestricted ? "1px solid #ffcdd2" : "1px solid #e0e0e0",
        borderRadius: "8px",
        mb: 1.5,
        p: 1.5,
        display: "flex",
        alignItems: "flex-start",
        bgcolor: isRestricted ? "#ffebee" : "background.paper",
        cursor: "move",
        transition: "all 0.2s ease-in-out",
        "&:hover": {
          boxShadow: "0 2px 10px rgba(0,0,0,0.08)",
        },
      }}
    >
      {/* Left Column: Drag Handle & Order Number */}
      <Stack alignItems="center" mr={2} mt={0.5}>
        <IconButton
          size="small"
          sx={{ cursor: "grab", color: "text.disabled", p: 0.5 }}
        >
          <DragIndicatorIcon />
        </IconButton>
        <Typography variant="caption" fontWeight="bold" color="text.secondary">
          #{perm.order}
        </Typography>
      </Stack>

      {/* Main Content Area */}
      <Box flexGrow={1} overflow="hidden">
        {/* Header Row: Icon, Titles, Badges */}
        <Stack
          direction="row"
          alignItems="center"
          spacing={1}
          mb={0.5}
          flexWrap="wrap"
          useFlexGap
        >
          <ListItemIcon
            sx={{
              minWidth: "auto",
              color: isRestricted ? "error.main" : "primary.main",
            }}
          >
            {icon}
          </ListItemIcon>

          {/* Fallback to title if no submenu exists */}
          <Typography
            variant="subtitle1"
            fontWeight="600"
            sx={{ wordBreak: "break-word" }}
          >
            {perm.menuSubmenu ? perm.menuSubmenu : perm.title}
          </Typography>

          {/* Show parent title category as a chip if we displayed the submenu as main title */}
          {perm.menuSubmenu && (
            <Chip
              label={perm.title}
              size="small"
              sx={{
                height: 20,
                fontSize: "0.65rem",
                bgcolor: isRestricted ? "rgba(255,255,255,0.7)" : "rgba(0,0,0,0.06)",
              }}
            />
          )}

          {/* Special UI Badge for Restricted Items */}
          {isRestricted && (
            <Tooltip title="This screen has restricted access mapped only for specific roles.">
              <Chip
                icon={<LockPersonIcon sx={{ fontSize: "14px !important" }} />}
                label="Restricted"
                size="small"
                color="error"
                variant="outlined"
                sx={{
                  height: 20,
                  fontSize: "0.65rem",
                  "& .MuiChip-icon": { ml: 0.5 },
                  bgcolor: "#fff",
                }}
              />
            </Tooltip>
          )}
        </Stack>

        {/* Dynamic Description (Truncated to 2 lines) */}
        {perm.description && (
          <Typography
            variant="body2"
            color="text.secondary"
            sx={{
              mb: 1.5,
              display: "-webkit-box",
              WebkitLineClamp: 2,
              WebkitBoxOrient: "vertical",
              overflow: "hidden",
              textOverflow: "ellipsis",
            }}
          >
            {perm.description}
          </Typography>
        )}

        {/* Action Level Permissions */}
        {actions.length > 0 && (
          <Stack direction="row" spacing={0.8} flexWrap="wrap" useFlexGap>
            {actions.map((act, idx) => (
              <Chip
                key={idx}
                label={act.charAt(0).toUpperCase() + act.slice(1)} // Capitalizes view -> View
                size="small"
                sx={{
                  height: 22,
                  fontSize: "0.7rem",
                  bgcolor: isRestricted ? "white" : "action.selected",
                  border: "1px solid",
                  borderColor: isRestricted ? "error.light" : "divider",
                }}
              />
            ))}
          </Stack>
        )}
      </Box>
    </ListItem>
  );
}
