		// =========================================================
		// BACKEND GUARDRAIL: Identify if sort is chronological
		// =========================================================
		boolean isChronologicalSort = "date".equalsIgnoreCase(sortField) || "postDate".equalsIgnoreCase(sortField);

		Sort sort;
		if (isChronologicalSort) {
