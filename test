import { useEffect, useRef, useState, useCallback } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector, useDispatch } from "react-redux"; // Added useDispatch
import useCustomSnackbar from "../utils/useCustomSnackbar";
import { resolveConfig } from "../config/EnvironmentConfig";

// --- New Imports for Refresh Logic ---
import api from "../config/axiosConfig"; // Reuse your configured Axios instance
import { tokenRefreshed } from "../store/slices/authSlice";
import { parseJwt } from "../utils/EncryptionUtilities";

const useStreamApi = () => {
  const token = useSelector((state) => state.auth.token);
  const dispatch = useDispatch(); // Initialize dispatch
  const snackbar = useCustomSnackbar();

  const controllerRef = useRef(null);
  const [connected, setConnected] = useState(false);
  const [lastMessage, setLastMessage] = useState(null);

  const startStream = useCallback(
    (url, { onMessage, onOpen, onError } = {}) => {
      if (!token) return console.warn("No token, cannot start SSE stream");

      const parts = url.split("/");
      const service = parts[1];
      const resolved = resolveConfig(`/${service}`);
      parts[1] = resolved;
      const Final_Url = parts.slice(1).join("/");

      // Cancel any existing connection
      if (controllerRef.current) controllerRef.current.abort();

      const controller = new AbortController();
      controllerRef.current = controller;

      fetchEventSource(Final_Url, {
        method: "GET",
        headers: { Authorization: `Bearer ${token}` },
        signal: controller.signal,

        async onopen(response) {
          // 1. Handle Successful Connection
          if (response.ok && response.status === 200) {
            console.log("SSE Connection established");
            setConnected(true);
            onOpen?.(response);
            return; // connection successful
          }

          // 2. Handle Token Expiry (401)
          if (response.status === 401) {
            console.log("SSE 401: Token expired, attempting refresh...");

            try {
              // Attempt to refresh using your existing Axios instance
              // We use 'api' here so it includes the HttpOnly cookies and response interceptors
              const refreshResponse = await api.post(
                `${resolveConfig("/LS") || ""}/auth/refresh-token`
              );

              const { accessToken } = refreshResponse.data;

              if (accessToken) {
                // Update Redux - this will likely trigger a re-render in the parent,
                // causing startStream to be called again with the new token.
                const user = parseJwt(accessToken);
                dispatch(tokenRefreshed({ token: accessToken, user }));
                
                // Throw specific error to stop the CURRENT stream attempt
                // The React lifecycle will start a NEW one with the new token
                throw new Error("TOKEN_REFRESHED_RETRY"); 
              }
            } catch (err) {
              console.error("SSE Refresh failed:", err);
              // If refresh fails, your axios interceptor likely handled logout already.
              // We throw a fatal error to stop the stream retries.
              throw err; 
            }
          }

          // 3. Handle Other Errors
          console.error("SSE Connection failed:", response.status);
          // Only show snackbar if it's not a 401 (since 401 is being handled internally)
          if (response.status !== 401) {
             snackbar(`SSE Connection failed (${response.status})`, "error");
          }
          // Throw to trigger onError
          throw new Error(`Connection failed: ${response.status}`);
        },

        onmessage(event) {
          if (event.event === "connected") {
            return;
          }
          if (event.event === "new_notification") {
            try {
              const data = JSON.parse(event.data);
              setLastMessage(data);
              onMessage?.(data);
            } catch (err) {
              console.error("SSE message parse error:", err);
            }
          }
        },

        onerror(err) {
          // If this was our custom error, we stop the internal retry loop
          // because React will create a fresh connection instance.
          if (err.message === "TOKEN_REFRESHED_RETRY") {
             // Throwing ensures fetchEventSource stops retrying this dead connection
             throw err; 
          }

          console.error("SSE Error:", err);
          setConnected(false);
          onError?.(err);
          
          // Optional: You can decide to rethrow here if you want to stop retries entirely
          // or return nothing to let fetchEventSource try again (default behavior)
        },
      });
    },
    [snackbar, token, dispatch] // Added dispatch to dependency array
  );

  const stopStream = useCallback(() => {
    if (controllerRef.current) {
      controllerRef.current.abort();
      controllerRef.current = null;
      setConnected(false);
      console.log("SSE connection stopped.");
    }
  }, []);

  useEffect(() => stopStream, [stopStream]);

  return { connected, lastMessage, startStream, stopStream };
};

export default useStreamApi;
