import {
  Box,
  Button,
  Fab,
  IconButton,
  Stack,
  Tooltip,
  Checkbox,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import React, { useMemo, useState } from "react";
import {
  Edit as EditIcon,
  Block as BlockIcon,
  LockOpen as UnblockIcon,
  Add as AddIcon,
  Close as CloseIcon,
  Check as CheckIcon,
  Clear as ClearIcon,
} from "@mui/icons-material";

export default function AcceptRejectSegments() {
  const [rows, setRows] = useState([]);
  const [open, setOpen] = useState(false);

  const [selectedRows, setSelectedRows] = useState([]);

  // Generate a unique ID

  const columns = useMemo(
    () => [
      {
        field: "checkbox",
        width: 80,
        headerName: (
          <Checkbox
            checked={rows.length > 0 && selectedRows.length === rows.length}
            indeterminate={
              selectedRows.length > 0 && selectedRows.length < rows.length
            }
            onChange={(e) => {
              if (e.target.checked) {
                setSelectedRows(rows.map((row) => row.id));
              } else {
                setSelectedRows([]);
              }
            }}
          />
        ),

        sortable: false,
        filterable: false,
        renderCell: (params) => (
          <Checkbox
            checked={selectedRows.includes(params.row.id)}
            onChange={(e) => {
              const rowId = params.row.id;
              if (e.target.checked) {
                setSelectedRows([...selectedRows, rowId]);
              } else {
                setSelectedRows(selectedRows.filter((id) => id !== rowId));
              }
            }}
          />
        ),
      },
      {
        field: "segmentCode",
        headerName: "Segment NUMBER",
        flex: 2,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "description",
        headerName: "Description",
        flex: 3,
        sortable: true,
      },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "actions",
        headerName: "Actions",
        sortable: false,
        flex: 1,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => {
          const isActive = params.row.status === "Active";
          return (
            <Stack direction="row" spacing={0.5} alignItems="center">
              <Tooltip title="Accept">
                <IconButton
                  size="small"
                  onClick={() => handleAccept(params.row.id)}
                  color="success"
                >
                  <CheckIcon fontSize="inherit" />
                </IconButton>
              </Tooltip>
              <Tooltip title="Reject">
                <IconButton
                  size="small"
                  onClick={() => handleReject(params.row.id)}
                  color="error"
                >
                  <ClearIcon fontSize="inherit" />
                </IconButton>
              </Tooltip>
            </Stack>
          );
        },
      },
    ],
    [selectedRows, rows]
  );

  const handleAccept = (id) => {
    console.log("Accepted row:", id);
  };

  const handleReject = (id) => {
    console.log("Rejected row:", id);
  };

  const handleAcceptAll = () => {
    console.log("Accepted rows:", selectedRows);
  };

  const handleRejectAll = () => {
    console.log("Rejected rows:", selectedRows);
  };

  return (
    <Box>
      <Box sx={{ mb: 2, display: "flex", gap: 1 }}>
        <Button
          variant="contained"
          color="success"
          startIcon={<CheckIcon />}
          onClick={handleAcceptAll}
          disabled={selectedRows.length === 0}
        >
          Accept All
        </Button>
        <Button
          variant="contained"
          color="error"
          startIcon={<ClearIcon />}
          onClick={handleRejectAll}
          disabled={selectedRows.length === 0}
        >
          Reject All
        </Button>
      </Box>

      <DataGrid
        rows={rows}
        columns={columns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [{ field: "segmentCode", sort: "asc" }] },
        }}
        getRowId={(row) => row.id}
        sx={{ height: 400, width: "100%" }}
      />
    </Box>
  );
}
