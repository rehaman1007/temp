const renderCustomBarLabel = (props) => {
  const { x, y, width, value, payload } = props;

  if (!payload) return null;

  return (
    <>
      {/* Pending Requests */}
      <text
        x={x + width / 2}
        y={y - 18}
        fill="#fff"
        fontSize={11}
        textAnchor="middle"
        fontWeight={600}
      >
        {value}
      </text>

      {/* Add Requests */}
      <text
        x={x + width / 2}
        y={y - 6}
        fill="#90caf9"
        fontSize={9}
        textAnchor="middle"
      >
        Add: {payload.addRequests}
      </text>

      {/* Change Type */}
      <text
        x={x + width / 2}
        y={y + 12}
        fill="#ffcc80"
        fontSize={9}
        textAnchor="middle"
      >
        {payload.changeType}
      </text>
    </>
  );
};