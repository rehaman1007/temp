import React, { useEffect, useState } from "react";
import {
  Alert,
  AlertTitle,
  Box,
  Chip,
  Divider,
  LinearProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";
import CustomChip from "../../../utils/CustomChip";

const LogsPanel = ({ lastResponse, jobStatus }) => {
  const theme = useTheme();
  const [elapsed, setElapsed] = useState(0);

  useEffect(() => {
    if (!jobStatus?.startedAt) return;

    if (jobStatus.status === "COMPLETED" || jobStatus.status === "FAILED") {
      setElapsed(Number(jobStatus?.elapsedSeconds || 0));
      return;
    }

    const updateElapsed = () => {
      const seconds = Math.floor(
        (Date.now() - Number(jobStatus.startedAt)) / 1000,
      );
      setElapsed(seconds > 0 ? seconds : 0);
    };

    updateElapsed();
    const interval = setInterval(updateElapsed, 1000);
    return () => clearInterval(interval);
  }, [
    jobStatus?.startedAt,
    jobStatus?.completedAt,
    jobStatus?.status,
    jobStatus?.elapsedSeconds,
  ]);

  const SectionTitle = ({ title }) => (
    <Typography
      variant="subtitle2"
      sx={{
        fontWeight: 700,
        mb: 1.5,
        color: "text.primary",
        borderLeft: `4px solid ${theme.palette.primary.main}`,
        pl: 1.2,
      }}
    >
      {title}
    </Typography>
  );

  const InfoRow = ({ label, value }) => (
    <Stack direction="row" justifyContent="space-between">
      <Typography variant="body2" color="text.secondary">
        {label}
      </Typography>
      <Typography variant="body2" fontWeight={600}>
        {value}
      </Typography>
    </Stack>
  );

  if (!lastResponse && !jobStatus) {
    return (
      <Paper elevation={0}>
        <Box p={{ xs: 2, sm: 3 }}>
          <Alert severity="info">
            <AlertTitle>Waiting for execution</AlertTitle>
            Execute SQL query or upload script to view logs.
          </Alert>
        </Box>
      </Paper>
    );
  }

  const processed = Number(jobStatus?.processedCount || 0);
  const executed = Number(jobStatus?.executedCount || 0);
  const total = Number(jobStatus?.totalStatements || 0);
  const progress = Number(jobStatus?.progress || 0);
  const pending = Math.max(total - executed, 0);
  const currentSpeed = Number(jobStatus?.executionSpeed || 0);

  return (
    <Paper elevation={0} sx={{ borderRadius: 1, overflow: "hidden" }}>
      <Box
        sx={{
          px: { xs: 1.5, md: 2.5 },
          py: 1.5,
          background: "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <Terminal fontSize="small" />
            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>

          {jobStatus?.status && (
            <CustomChip
              size="small"
              label={jobStatus.status}
              color={
                jobStatus.status === "COMPLETED"
                  ? "success"
                  : jobStatus.status === "FAILED"
                    ? "error"
                    : "warning"
              }
            />
          )}
        </Stack>
      </Box>

      <Box
        sx={{
          p: { xs: 1.5, sm: 2, md: 3 },
          bgcolor: theme.palette.background.default,
          flex: 1,
          overflow: "auto",
          minHeight: 400,
        }}
      >
        {jobStatus && (
          <>
            <SectionTitle title="Live Execution Status" />

            <Box
              sx={{
                mb: 3,
                p: { xs: 1.5, sm: 2 },
                borderRadius: 2,
                bgcolor: theme.palette.background.paper,
                border: `1px solid ${theme.palette.divider}`,
              }}
            >
              <Stack spacing={2}>
                {/* TOP */}
                <Stack
                  direction="row"
                  justifyContent="space-between"
                  alignItems="center"
                  flexWrap="wrap"
                  gap={1}
                >
                  <Typography fontWeight={700} sx={{ wordBreak: "break-all" }}>
                    Job ID: {jobStatus.jobId}
                  </Typography>

                  <Chip
                    size="small"
                    label={jobStatus.status}
                    color={
                      jobStatus.status === "COMPLETED"
                        ? "success"
                        : jobStatus.status === "FAILED"
                          ? "error"
                          : "warning"
                    }
                  />
                </Stack>

                {/* METRICS */}
                <Box
                  sx={{
                    display: "grid",
                    // Reduced min width to 120px to fit better on compact screens
                    gridTemplateColumns: "repeat(auto-fit,minmax(120px,1fr))",
                    gap: 1.5,
                  }}
                >
                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      Processed
                    </Typography>
                    <Typography fontWeight={700}>
                      {processed.toLocaleString()}
                    </Typography>
                  </Paper>

                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      Executed
                    </Typography>
                    <Typography fontWeight={700}>
                      {executed.toLocaleString()}
                    </Typography>
                  </Paper>

                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      Pending
                    </Typography>
                    <Typography fontWeight={700}>
                      {pending.toLocaleString()}
                    </Typography>
                  </Paper>

                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      Speed
                    </Typography>
                    <Typography fontWeight={700}>{currentSpeed}/sec</Typography>
                  </Paper>

                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      ETA
                    </Typography>
                    <Typography fontWeight={700}>
                      {jobStatus.status === "COMPLETED"
                        ? "0 sec"
                        : `${jobStatus.etaSeconds || 0} sec`}
                    </Typography>
                  </Paper>

                  <Paper variant="outlined" sx={{ p: 1.5 }}>
                    <Typography variant="caption" color="text.secondary">
                      Elapsed
                    </Typography>
                    <Typography fontWeight={700}>{elapsed} sec</Typography>
                  </Paper>
                </Box>

                {/* PROGRESS */}
                <Box mt={1}>
                  <Stack
                    direction="row"
                    justifyContent="space-between"
                    alignItems="center"
                    mb={1}
                  >
                    <Typography
                      variant="body2"
                      fontWeight={600}
                      color="text.secondary"
                    >
                      Execution Progress
                    </Typography>

                    <Chip
                      size="small"
                      color={
                        progress === 100
                          ? "success"
                          : progress > 70
                            ? "primary"
                            : "warning"
                      }
                      label={`${progress}%`}
                      sx={{
                        fontWeight: 700,
                      }}
                    />
                  </Stack>

                  <Box
                    sx={{
                      position: "relative",
                      height: 14,
                      borderRadius: 20,
                      overflow: "hidden",
                      bgcolor: theme.palette.grey[200],
                      border: `1px solid ${theme.palette.divider}`,
                    }}
                  >
                    <LinearProgress
                      variant="determinate"
                      value={progress}
                      sx={{
                        height: "100%",
                        borderRadius: 20,
                        bgcolor: "transparent",

                        "& .MuiLinearProgress-bar": {
                          borderRadius: 20,
                          background:
                            progress === 100
                              ? "linear-gradient(90deg,#22c55e,#16a34a)"
                              : "linear-gradient(90deg,#2563eb,#3b82f6,#60a5fa)",
                          transition: "transform .5s ease",
                        },
                      }}
                    />

                    <Box
                      sx={{
                        position: "absolute",
                        inset: 0,
                        background:
                          "linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent)",
                        animation: "progressShine 2s linear infinite",
                        pointerEvents: "none",

                        "@keyframes progressShine": {
                          "0%": {
                            transform: "translateX(-100%)",
                          },
                          "100%": {
                            transform: "translateX(100%)",
                          },
                        },
                      }}
                    />
                  </Box>

                  <Stack direction="row" justifyContent="space-between" mt={1}>
                    <Typography variant="caption" color="text.secondary">
                      {executed.toLocaleString()} Executed
                    </Typography>

                    <Typography variant="caption" color="text.secondary">
                      {pending.toLocaleString()} Pending
                    </Typography>
                  </Stack>
                </Box>
              </Stack>
            </Box>
          </>
        )}

        {(lastResponse?.error || jobStatus?.status === "FAILED") && (
          <>
            <SectionTitle title="Error Log" />
            <Alert severity="error" variant="outlined" sx={{ mb: 3 }}>
              <AlertTitle>Execution Failed</AlertTitle>
              {lastResponse?.message || jobStatus?.message || "Unknown error"}

              {jobStatus?.failedLine && (
                <>
                  <Divider sx={{ my: 1 }} />
                  Failed Line : {jobStatus.failedLine}
                </>
              )}
            </Alert>
          </>
        )}

        {jobStatus?.failedSql && (
          <>
            <SectionTitle title="Failed SQL Statement" />
            <Box
              sx={{
                p: { xs: 1.5, md: 2 },
                mb: 3,
                borderRadius: 2,
                bgcolor: theme.palette.grey[100],
                overflowX: "auto", // Ensure long SQL queries don't break layout
              }}
            >
              <Typography
                sx={{
                  whiteSpace: "pre-wrap",
                  fontFamily: "Consolas, monospace",
                  color: theme.palette.error.main,
                  fontSize: { xs: "0.8rem", sm: "0.875rem" },
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          </>
        )}

        {lastResponse && !lastResponse.error && (
          <>
            <SectionTitle title="Execution Result" />
            <Alert severity="success" variant="outlined" sx={{ mb: 3 }}>
              <AlertTitle>SQL Executed Successfully</AlertTitle>
              {lastResponse?.rows?.[0]?.RESULT ||
                "Execution completed successfully"}
            </Alert>
          </>
        )}

        {jobStatus && (
          <>
            <SectionTitle title="Execution Summary" />

            <Stack direction="row" flexWrap="wrap" useFlexGap sx={{ gap: 1 }}>
              <CustomChip
                color="success"
                label={`INSERT ${jobStatus.insertCount || 0}`}
              />
              <CustomChip
                color="info"
                label={`UPDATE ${jobStatus.updateCount || 0}`}
              />
              <CustomChip
                color="error"
                label={`DELETE ${jobStatus.deleteCount || 0}`}
              />
              <CustomChip
                color="warning"
                label={`OTHERS ${jobStatus.otherCount || 0}`}
              />
            </Stack>
          </>
        )}

        {jobStatus?.status === "RUNNING" && (
          <Alert severity="warning" variant="outlined" sx={{ mt: 3 }}>
            <AlertTitle>Execution In Progress</AlertTitle>
            Pending statements : {pending.toLocaleString()}
          </Alert>
        )}
      </Box>
    </Paper>
  );
};

export default LogsPanel;




import React from "react";
import {
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  Typography,
} from "@mui/material";
import { DeleteSweep, WarningAmber } from "@mui/icons-material";

const ConfirmDialog = ({ open, onClose, onConfirm }) => {
  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="xs"
      fullWidth
      PaperProps={{
        sx: {
          borderRadius: { xs: 3, sm: 4 },
          overflow: "hidden",
          margin: { xs: 2, sm: 4 }, // Ensure margin on small mobile screens
        },
      }}
    >
      {/* HEADER */}
      <DialogTitle sx={{ p: 0 }}>
        <Box
          sx={{
            px: { xs: 2, sm: 3 },
            py: { xs: 1.5, sm: 2 },
            background: "linear-gradient(135deg,#991b1b,#dc2626)",
            color: "white",
          }}
        >
          <Stack direction="row" spacing={1.5} alignItems="center">
            <WarningAmber />
            <Typography variant="h6" fontWeight={800} sx={{ fontSize: { xs: '1.1rem', sm: '1.25rem' } }}>
              Dangerous SQL Detected
            </Typography>
          </Stack>
        </Box>
      </DialogTitle>

      {/* CONTENT */}
      <DialogContent
        sx={{
          px: { xs: 2, sm: 3 },
          pt: "24px !important",
          pb: 2,
        }}
      >
        <Typography
          variant="body1"
          sx={{
            lineHeight: 1.8,
            fontSize: { xs: "0.9rem", sm: "1rem" },
          }}
        >
          This SQL statement can modify or permanently delete data.
        </Typography>

        <Box
          sx={{
            mt: 2,
            p: { xs: 1.5, sm: 2 },
            borderRadius: 3,
            bgcolor: "rgba(239,68,68,0.08)",
            border: "1px solid rgba(239,68,68,0.2)",
          }}
        >
          <Typography variant="body2" fontWeight={700} color="error">
            Please verify the query before continuing.
          </Typography>
        </Box>
      </DialogContent>

      {/* ACTIONS */}
      <DialogActions
        sx={{
          px: { xs: 2, sm: 3 },
          pb: { xs: 2, sm: 3 },
          display: "flex",
          flexDirection: { xs: "column", sm: "row" }, // Stack vertically on mobile
          gap: 1.5, // Standardize spacing
          // Target children to wipe out MUI's default consecutive margin applied to dialog buttons
          "& > button": {
            margin: "0 !important",
            width: { xs: "100%", sm: "auto" }
          }
        }}
      >
        <Button
          variant="outlined"
          onClick={onClose}
          sx={{
            borderRadius: 3,
            px: 3,
            py: { xs: 1, sm: 0.75 },
          }}
        >
          Cancel
        </Button>

        <Button
          variant="contained"
          color="error"
          disableElevation
          startIcon={<DeleteSweep />}
          onClick={onConfirm}
          sx={{
            borderRadius: 3,
            px: 3,
            py: { xs: 1, sm: 0.75 },
            background: "linear-gradient(135deg,#dc2626,#ef4444)",
            boxShadow: "0 8px 24px rgba(239,68,68,0.35)",
            "&:hover": {
              transform: "translateY(-1px)",
            },
          }}
        >
          Execute Anyway
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ConfirmDialog;

