package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import oracle.jdbc.OracleConnection;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.*;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.*;
import java.util.concurrent.*;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportExecutor {

    /**
     * =========================================================
     * LIVE STATUS CACHE
     * =========================================================
     */
    public static final Map<String, Map<String, Object>> JOB_STATUS =
            new ConcurrentHashMap<>();

    /**
     * =========================================================
     * PERFORMANCE CONFIG
     * =========================================================
     */
    private static final int FILE_BUFFER_SIZE = 1024 * 1024;

    /**
     * BEST ORACLE COMMIT RANGE
     */
    private static final int COMMIT_BATCH_SIZE = 5000;

    /**
     * THREADS
     */
    private static final int PARALLEL_THREADS = 8;

    /**
     * STATUS UPDATE
     */
    private static final int STATUS_UPDATE_INTERVAL = 2000;

    private final JdbcTemplate jdbcTemplate;

    /**
     * =========================================================
     * EXECUTE SCRIPT
     * =========================================================
     */
    @Async("sqlTaskExecutor")
    public void executeScriptAsync(
            File sqlFile,
            String jobId,
            String userId,
            String clientIp,
            String hdfsFilename
    ) {

        Instant start = Instant.now();

        long startedAt = System.currentTimeMillis();

        long parsedCount = 0;

        long executedCount = 0;

        long insertCount = 0;

        long updateCount = 0;

        long deleteCount = 0;

        long otherCount = 0;

        String failedSql = null;

        long failedLine = 0;

        try {

            /**
             * =====================================================
             * INITIAL STATUS
             * =====================================================
             */
            updateJobStatus(
                    jobId,
                    "RUNNING",
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                    0,
                    startedAt,
                    "Execution Started",
                    0,
                    0,
                    0,
                    0
            );

            /**
             * =====================================================
             * SQL HOLDERS
             * =====================================================
             */
            List<String> ddlStatements =
                    new ArrayList<>();

            List<String> insertStatements =
                    new ArrayList<>();

            List<String> updateStatements =
                    new ArrayList<>();

            List<String> deleteStatements =
                    new ArrayList<>();

            List<String> otherStatements =
                    new ArrayList<>();

            /**
             * =====================================================
             * PARSE FILE
             * =====================================================
             */
            try (
                    BufferedReader reader =
                            new BufferedReader(
                                    new InputStreamReader(
                                            new BufferedInputStream(
                                                    new FileInputStream(sqlFile),
                                                    FILE_BUFFER_SIZE
                                            )
                                    )
                            )
            ) {

                String line;

                StringBuilder sqlBuilder =
                        new StringBuilder(1024);

                long lineNumber = 0;

                while ((line = reader.readLine()) != null) {

                    lineNumber++;

                    line = line.trim();

                    if (
                            line.isEmpty()
                                    ||
                                    line.startsWith("--")
                    ) {
                        continue;
                    }

                    sqlBuilder.append(line).append(" ");

                    /**
                     * =============================================
                     * SQL END
                     * =============================================
                     */
                    if (line.endsWith(";")) {

                        String sql =
                                sqlBuilder.toString().trim();

                        while (sql.endsWith(";")) {

                            sql =
                                    sql.substring(
                                            0,
                                            sql.length() - 1
                                    ).trim();
                        }

                        sqlBuilder.setLength(0);

                        parsedCount++;

                        failedSql = sql;

                        failedLine = lineNumber;

                        String upper =
                                sql.length() > 20
                                        ? sql.substring(0, 20)
                                        .toUpperCase()
                                        : sql.toUpperCase();

                        /**
                         * =========================================
                         * DDL
                         * =========================================
                         */
                        if (
                                upper.startsWith("CREATE")
                                        ||
                                        upper.startsWith("ALTER")
                                        ||
                                        upper.startsWith("DROP")
                                        ||
                                        upper.startsWith("TRUNCATE")
                        ) {

                            ddlStatements.add(sql);

                        }

                        /**
                         * =========================================
                         * INSERT
                         * =========================================
                         */
                        else if (
                                upper.startsWith("INSERT")
                        ) {

                            insertStatements.add(sql);

                            insertCount++;
                        }

                        /**
                         * =========================================
                         * UPDATE
                         * =========================================
                         */
                        else if (
                                upper.startsWith("UPDATE")
                        ) {

                            updateStatements.add(sql);

                            updateCount++;
                        }

                        /**
                         * =========================================
                         * DELETE
                         * =========================================
                         */
                        else if (
                                upper.startsWith("DELETE")
                        ) {

                            deleteStatements.add(sql);

                            deleteCount++;
                        }

                        /**
                         * =========================================
                         * OTHER
                         * =========================================
                         */
                        else {

                            otherStatements.add(sql);

                            otherCount++;
                        }
                    }
                }
            }

            long totalStatements =
                    parsedCount;

            /**
             * =====================================================
             * EXECUTE DDL FIRST
             * =====================================================
             */
            if (!ddlStatements.isEmpty()) {

                log.info(
                        "EXECUTING {} DDL STATEMENTS",
                        ddlStatements.size()
                );

                try (
                        Connection connection =
                                jdbcTemplate
                                        .getDataSource()
                                        .getConnection();

                        Statement statement =
                                connection.createStatement()
                ) {

                    connection.setAutoCommit(false);

                    for (String ddl : ddlStatements) {

                        statement.execute(ddl);

                        connection.commit();

                        executedCount++;
                    }
                }
            }

            /**
             * =====================================================
             * COMBINED DML
             * =====================================================
             */
            List<String> allDml =
                    new ArrayList<>();

            /**
             * INSERTS FIRST
             */
            allDml.addAll(insertStatements);

            /**
             * THEN UPDATES
             */
            allDml.addAll(updateStatements);

            /**
             * THEN DELETES
             */
            allDml.addAll(deleteStatements);

            /**
             * OTHERS
             */
            allDml.addAll(otherStatements);

            /**
             * =====================================================
             * SPLIT INTO CHUNKS
             * =====================================================
             */
            List<List<String>> chunks =
                    splitList(
                            allDml,
                            COMMIT_BATCH_SIZE
                    );

            /**
             * =====================================================
             * PARALLEL EXECUTION
             * =====================================================
             */
            ExecutorService executor =
                    Executors.newFixedThreadPool(
                            PARALLEL_THREADS
                    );

            List<Future<Long>> futures =
                    new ArrayList<>();

            AtomicLong liveExecuted =
                    new AtomicLong(executedCount);

            for (List<String> chunk : chunks) {

                Future<Long> future =
                        executor.submit(() -> {

                            long executed = 0;

                            try (
                                    Connection connection =
                                            jdbcTemplate
                                                    .getDataSource()
                                                    .getConnection();

                                    Statement statement =
                                            connection.createStatement()
                            ) {

                                /**
                                 * =====================================
                                 * ORACLE OPTIMIZATION
                                 * =====================================
                                 */
                                OracleConnection oracleConnection =
                                        connection.unwrap(
                                                OracleConnection.class
                                        );

                                oracleConnection
                                        .setDefaultExecuteBatch(
                                                COMMIT_BATCH_SIZE
                                        );

                                connection.setAutoCommit(false);

                                /**
                                 * =====================================
                                 * PARALLEL DML
                                 * =====================================
                                 */
                                statement.execute(
                                        "ALTER SESSION ENABLE PARALLEL DML"
                                );

                                statement.execute(
                                        "ALTER SESSION FORCE PARALLEL QUERY PARALLEL 8"
                                );

                                int batchCounter = 0;

                                for (String sql : chunk) {

                                    statement.addBatch(sql);

                                    batchCounter++;

                                    /**
                                     * =================================
                                     * EXECUTE BATCH
                                     * =================================
                                     */
                                    if (
                                            batchCounter >=
                                                    COMMIT_BATCH_SIZE
                                    ) {

                                        int[] result =
                                                statement.executeBatch();

                                        connection.commit();

                                        statement.clearBatch();

                                        executed += result.length;

                                        liveExecuted.addAndGet(
                                                result.length
                                        );

                                        batchCounter = 0;
                                    }
                                }

                                /**
                                 * =====================================
                                 * FINAL BATCH
                                 * =====================================
                                 */
                                if (batchCounter > 0) {

                                    int[] result =
                                            statement.executeBatch();

                                    connection.commit();

                                    statement.clearBatch();

                                    executed += result.length;

                                    liveExecuted.addAndGet(
                                            result.length
                                    );
                                }

                            } catch (Exception e) {

                                log.error(
                                        "CHUNK EXECUTION FAILED",
                                        e
                                );

                                throw e;
                            }

                            return executed;
                        });

                futures.add(future);
            }

            /**
             * =====================================================
             * LIVE MONITORING
             * =====================================================
             */
            boolean monitoring = true;

            while (monitoring) {

                long currentExecuted =
                        liveExecuted.get();

                long pending =
                        totalStatements - currentExecuted;

                long elapsedSeconds =
                        Math.max(
                                Duration.between(
                                        start,
                                        Instant.now()
                                ).toSeconds(),
                                1
                        );

                long speed =
                        currentExecuted /
                                elapsedSeconds;

                long eta =
                        speed <= 0
                                ? 0
                                : pending / speed;

                int progress =
                        totalStatements == 0
                                ? 0
                                : (int)
                                (
                                        (currentExecuted * 100.0)
                                                / totalStatements
                                );

                updateJobStatus(
                        jobId,
                        "RUNNING",
                        progress,
                        totalStatements,
                        currentExecuted,
                        pending,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        startedAt,
                        "Executing SQL",
                        speed,
                        elapsedSeconds,
                        eta,
                        currentExecuted
                );

                boolean allDone = true;

                for (Future<Long> future : futures) {

                    if (!future.isDone()) {

                        allDone = false;

                        break;
                    }
                }

                if (allDone) {

                    monitoring = false;
                }

                Thread.sleep(1000);
            }

            /**
             * =====================================================
             * WAIT FOR COMPLETION
             * =====================================================
             */
            for (Future<Long> future : futures) {

                executedCount += future.get();
            }

            executor.shutdown();

            long elapsedSeconds =
                    Duration.between(
                            start,
                            Instant.now()
                    ).toSeconds();

            long speed =
                    elapsedSeconds == 0
                            ? executedCount
                            : executedCount /
                            elapsedSeconds;

            /**
             * =====================================================
             * FINAL STATUS
             * =====================================================
             */
            updateJobStatus(
                    jobId,
                    "COMPLETED",
                    100,
                    totalStatements,
                    executedCount,
                    0,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    startedAt,
                    "Execution Completed",
                    speed,
                    elapsedSeconds,
                    0,
                    executedCount
            );

            log.info("""
                            
                            ===================================================
                            SQL EXECUTION COMPLETED
                            ===================================================
                            TOTAL      : {}
                            EXECUTED   : {}
                            INSERTS    : {}
                            UPDATES    : {}
                            DELETES    : {}
                            OTHERS     : {}
                            TIME(sec)  : {}
                            SPEED      : {} stmt/sec
                            ===================================================
                            """,

                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    elapsedSeconds,
                    speed
            );

        } catch (Exception e) {

            log.error(
                    "SQL EXECUTION FAILED",
                    e
            );

            updateJobStatus(
                    jobId,
                    "FAILED",
                    0,
                    parsedCount,
                    executedCount,
                    parsedCount - executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    startedAt,
                    e.getMessage(),
                    0,
                    0,
                    0,
                    failedLine
            );

        } finally {

            try {

                if (
                        sqlFile != null
                                &&
                                sqlFile.exists()
                ) {

                    boolean deleted =
                            sqlFile.delete();

                    log.info(
                            "TEMP FILE DELETED : {}",
                            deleted
                    );
                }

            } catch (Exception ex) {

                log.error(
                        "FAILED TO DELETE FILE",
                        ex
                );
            }
        }
    }

    /**
     * =========================================================
     * SPLIT LIST
     * =========================================================
     */
    private List<List<String>> splitList(
            List<String> list,
            int chunkSize
    ) {

        List<List<String>> chunks =
                new ArrayList<>();

        for (
                int i = 0;
                i < list.size();
                i += chunkSize
        ) {

            chunks.add(
                    list.subList(
                            i,
                            Math.min(
                                    i + chunkSize,
                                    list.size()
                            )
                    )
            );
        }

        return chunks;
    }

    /**
     * =========================================================
     * UPDATE STATUS
     * =========================================================
     */
    private void updateJobStatus(
            String jobId,
            String status,
            long progress,
            long total,
            long executed,
            long pending,
            long inserts,
            long updates,
            long deletes,
            long others,
            long startedAt,
            String message,
            long speed,
            long elapsed,
            long eta,
            long currentLine
    ) {

        Map<String, Object> map =
                new ConcurrentHashMap<>();

        map.put("jobId", jobId);

        map.put("status", status);

        map.put("progress", progress);

        map.put("totalStatements", total);

        map.put("executedCount", executed);

        map.put("pendingCount", pending);

        map.put("insertCount", inserts);

        map.put("updateCount", updates);

        map.put("deleteCount", deletes);

        map.put("otherCount", others);

        map.put("startedAt", startedAt);

        map.put("message", message);

        map.put("executionSpeed", speed);

        map.put("elapsedSeconds", elapsed);

        map.put("etaSeconds", eta);

        map.put("currentLine", currentLine);

        JOB_STATUS.put(jobId, map);
    }
}