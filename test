import { useEffect, useRef, useState } from "react";
import * as THREE from "three";
import NET from "vanta/dist/vanta.net.min"; // you can swap with "vanta.globe.min" if you want globe instead of net

export default function TrancheSplash() {
  const vantaRef = useRef(null);
  const [vantaEffect, setVantaEffect] = useState(null);

  useEffect(() => {
    if (!vantaEffect) {
      setVantaEffect(
        NET({
          el: vantaRef.current,
          THREE: THREE,
          mouseControls: true,
          touchControls: true,
          minHeight: 200.0,
          minWidth: 200.0,
          scale: 1.0,
          scaleMobile: 1.0,
          color: 0x00ffff,
          backgroundColor: 0x000000,
          points: 12.0,
          maxDistance: 20.0,
          spacing: 18.0,
        })
      );
    }
    return () => {
      if (vantaEffect) vantaEffect.destroy();
    };
  }, [vantaEffect]);

  return (
    <div
      ref={vantaRef}
      style={{
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        minHeight: "100vh",
        fontFamily: "Arial, sans-serif",
        color: "#fff",
        textAlign: "center",
      }}
    >
      <h1 style={{ fontSize: "48px", margin: "0 0 20px" }}>
        Welcome to <span style={{ color: "#00eaff" }}>Tranche</span> Module
      </h1>
      <p style={{ fontSize: "20px", opacity: 0.8 }}>
        Secure • Scalable • Finance Ready
      </p>
    </div>
  );
}