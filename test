const { mutate: exportData, isPending: exportLoading } = useMutation({
    mutationFn: async ({ sql, exportType, tableName }) => {
      const payload = {
        sql,
        exportType,
        tableName,
      };

      console.log("Export Payload", payload);

      return await callApi(
        "/TS/admin-support/export-data",
        payload,
        "POST",
        "blob",
      );
    },

    onSuccess: (response, variables) => {
      console.log("Blob Response", response);
      console.log("Variables", variables);

      let format = "csv";

      switch (variables.exportType?.toUpperCase()) {
        case "EXCEL":
          format = "xlsx";
          break;

        case "JSON":
          format = "json";
          break;

        case "INSERT":
          format = "sql";
          break;

        case "CSV":
        default:
          format = "csv";
          break;
      }

      downloadFile(response, format, `export_${Date.now()}`);

      showSnackbar("Export completed successfully", "success");
    },

    onError: (e) => {
      showSnackbar(e?.message || "Export failed", "error");
    },
  });

  const handleExport = (exportParams) => {
    const sql = lastExecutedQuery;
    const exportType = exportParams.exportType;
    const tableName = exportParams.tableName;
    if (!lastExecutedQuery) {
      showSnackbar("Execute a SELECT query first", "warning");
      return;
    }

    if (exportType === "INSERT" && !tableName.trim()) {
      showSnackbar("Table name required for INSERT export", "warning");
      return;
    }

    exportData({
      sql,
      exportType,
      tableName,
    });
  };
