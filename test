<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Investment Table</title>
<style>
  .table-wrapper {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 1200px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 6px 8px;
    text-align: center;
    vertical-align: middle;
  }
  th {
    background-color: #0073b1; /* SBI blue shade */
    color: white;
    font-weight: normal;
  }
  td {
    background-color: #fafafa;
  }
</style>
</head>
<body>

<div class="table-wrapper">
  <table>
    <thead>
      <!-- Row 1 -->
      <tr>
        <th rowspan="3">NAME OF INVESTEE</th>
        <th rowspan="1" colspan="3">A. INVESTMENT IN SBI/ SUBSIDIARY &amp; JOINT VENTURE, ASSOCIATES (INCLUDING RRB) OF SBI GROUP</th>
        <th colspan="3">IPDI (AT I) AND SUBORDINATED DEBTS &amp; BONDS (TIER II)</th>
        <th colspan="3">INVESTMENT IN DEBENTURES/BONDS/ PREFERENCE SHARES/CD'S / CP'S (OTHER THAN IPDI (AT I) AND SUBORDINATED DEBTS &amp; BONDS (TIER II))</th>
        <th rowspan="3">REMARKS</th>
        <th rowspan="3">ACTION</th>
      </tr>
      <!-- Row 2 -->
      <tr>
        <th rowspan="2">FACE VALUE AS AT 30.06.2025</th>
        <th rowspan="2">CARRYING VALUE AS AT 30.06.2025</th>
        <th rowspan="2">CATEGORY UNDER WHICH IT HAS BEEN INCLUDED IN SCH. 8 (PLEASE SELECT FROM DROP-DOWN LIST)</th>
        <th colspan="2">CARRYING VALUE AS AT 31.03.2025</th>
        <th rowspan="2">CATEGORY UNDER WHICH IT HAS BEEN INCLUDED IN SCH. 8 (PLEASE SELECT FROM DROP-DOWN LIST)</th>
        <th rowspan="2">FACE VALUE AS AT 30.06.2025</th>
        <th rowspan="2">DEBENTURES AND BONDS</th>
        <th rowspan="2">PREFERENCE SHARES/ CD'S / CP'S</th>
      </tr>
      <!-- Row 3 -->
      <tr>
        <th>INVESTMENTS IN INNOVATIVE PERPETUAL DEBT INSTRUMENTS (IPDI) - AT I BONDS</th>
        <th>INVESTMENTS IN SUBORDINATED DEBENTURES AND BONDS (TIER II)</th>
      </tr>
    </thead>
    <tbody id="table-body">
      <!-- Rows populated dynamically -->
    </tbody>
  </table>
</div>

<script>
  // Example DB data
  const data = [
    {
      investee: 'SBI Subsidiary 1',
      faceValueA: 1000,
      carryingValueA: 950,
      categoryA: 'Cat 1',
      ipdiValue: 500,
      subDebtValue: 450,
      categoryB: 'Cat 2',
      faceValueC: 700,
      debentures: 400,
      preference: 200,
      remarks: 'Remark 1',
      action: 'Edit'
    },
    {
      investee: 'SBI Subsidiary 2',
      faceValueA: 1200,
      carryingValueA: 1100,
      categoryA: 'Cat 3',
      ipdiValue: 600,
      subDebtValue: 500,
      categoryB: 'Cat 4',
      faceValueC: 800,
      debentures: 500,
      preference: 300,
      remarks: 'Remark 2',
      action: 'Edit'
    }
  ];

  const tbody = document.getElementById('table-body');

  data.forEach(row => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${row.investee}</td>
      <td>${row.faceValueA}</td>
      <td>${row.carryingValueA}</td>
      <td>${row.categoryA}</td>
      <td>${row.ipdiValue}</td>
      <td>${row.subDebtValue}</td>
      <td>${row.categoryB}</td>
      <td>${row.faceValueC}</td>
      <td>${row.debentures}</td>
      <td>${row.preference}</td>
      <td>${row.remarks}</td>
      <td>${row.action}</td>
    `;
    tbody.appendChild(tr);
  });
</script>

</body>
</html>