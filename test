package com.fincore.transactions_service.controller;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import com.fincore.transactions_service.service.AdminSupportService;
import com.fincore.commonutilities.jwt.JwtUtil;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

@RestController
@RequestMapping("/api/admin-support")
@RequiredArgsConstructor
@Slf4j
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    private final JwtUtil jwtUtil;

    /**
     * =========================================================
     * EXECUTE SQL
     * =========================================================
     */
    @PostMapping("/admin-execute")
    public ResponseEntity<?> executeAdminSql(@RequestHeader("Authorization") String token, @RequestBody AdminSupportDTO dto, HttpServletRequest request) {

        String userId = extractUserId(token);

        log.info("""
                
                ==================================================
                ADMIN EXECUTE REQUEST RECEIVED
                ==================================================
                userId={}
                sql={}
                page={}
                size={}
                ==================================================
                """, userId, dto.getSql(), dto.getPage(), dto.getSize());

        return ResponseEntity.ok(adminSupportService.executeAdminSql(dto, userId, request));
    }

    /**
     * =========================================================
     * UPLOAD SQL FILE
     * =========================================================
     */
    @PostMapping("/upload-script")
    public ResponseEntity<?> uploadSqlFile(@RequestHeader("Authorization") String token, @RequestParam("file") MultipartFile file, HttpServletRequest request) {

        String userId = extractUserId(token);

        log.info("""
                
                ==================================================
                SQL FILE UPLOAD REQUEST RECEIVED
                ==================================================
                userId={}
                fileName={}
                fileSize={} MB
                ==================================================
                """, userId, file.getOriginalFilename(), String.format("%.2f", file.getSize() / 1024.0 / 1024.0));

        return ResponseEntity.ok(adminSupportService.uploadSqlFile(file, userId, request));
    }

    /**
     * =========================================================
     * JOB STATUS
     * =========================================================
     */
    @GetMapping("/job-status/{jobId}")
    public ResponseEntity<?> getJobStatus(@RequestHeader("Authorization") String token, @PathVariable String jobId) {

        String userId = extractUserId(token);

        log.info("""
                
                ==================================================
                JOB STATUS REQUEST
                ==================================================
                userId={}
                jobId={}
                ==================================================
                """, userId, jobId);

        return ResponseEntity.ok(adminSupportService.getJobStatus(jobId));
    }

    /**
     * =========================================================
     * EXTRACT USER ID FROM JWT TOKEN
     * =========================================================
     */
    private String extractUserId(String token) {

        try {

            if (token == null || token.isBlank()) {

                return "UNKNOWN";
            }

            /**
             * REMOVE BEARER PREFIX
             */
            if (token.startsWith("Bearer ")) {

                token = token.substring(7);
            }

            String userId = jwtUtil.getUserIdFromToken(token);

            if (userId == null || userId.isBlank()) {

                return "UNKNOWN";
            }

            return userId;

        } catch (Exception e) {

            log.error("""
                    
                    ==================================================
                    FAILED TO EXTRACT USER ID FROM TOKEN
                    ==================================================
                    error={}
                    ==================================================
                    """, e.getMessage(), e);

            return "UNKNOWN";
        }
    }
}

