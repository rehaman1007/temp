import React from "react";
import lazyRetry from "../utils/lazyRetry";
import ComponentLoadError from "../pages/ComponentLoadError";

// Auto-import all components
const components = import.meta.glob("../features/**/*.jsx");

/**
 * Lazy loads component safely with retry
 */
const lazyLoadComponent = (componentPath) => {
  const componentImport = components[componentPath];

  if (!componentImport) {
    console.error(`Component not found for path: ${componentPath}`);

    return () => (
      <ComponentLoadError
        path={componentPath}
        error="Component not found"
      />
    );
  }

  // ✅ IMPORTANT: Wrap with retry
  const LazyComponent = React.lazy(() =>
    lazyRetry(componentImport)
  );

  return LazyComponent;
};

/**
 * Generate routes recursively
 */
export const generateRouteObjects = (menuItems) => {
  const routes = [];

  for (const item of menuItems) {
    if (item && item.componentPath) {
      const fullPath = `../features/${item.componentPath}.jsx`;

      const Component = lazyLoadComponent(fullPath);

      routes.push({
        path: item.route,

        // ❌ Removed Suspense here (already in AppRouter)
        // ✅ Cleaner + avoids double fallback issues
        element: <Component />,
      });
    }

    // Recursive children
    if (item?.hasChildren && Array.isArray(item.children)) {
      routes.push(...generateRouteObjects(item.children));
    }
  }

  return routes;
};