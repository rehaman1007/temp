// --------------------
// Debounce Hook
// --------------------
function useDebounce(value, delay = 300) {
  const [debounced, setDebounced] = useState(value);

  useEffect(() => {
    const timer = setTimeout(() => setDebounced(value), delay);
    return () => clearTimeout(timer);
  }, [value, delay]);

  return debounced;
}


// --------------------
// Format date
// --------------------
const formatDate = (timestamp) => {
  if (!timestamp) return "-";
  try {
    const d = new Date(Number(timestamp));
    if (isNaN(d)) return "-";

    return new Intl.DateTimeFormat("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    }).format(d);
  } catch {
    return "-";
  }
};


// --------------------
// Status Config
// --------------------
const getStatusConfig = (status) => {
  const configs = {
    null: {
      label: "Not Initiated",
      muiColor: "default",
      icon: <ErrorOutlineIcon fontSize="small" />,
    },
    10: {
      label: "Initiated",
      muiColor: "info",
      icon: <PlayCircleOutlineIcon fontSize="small" />,
    },
    11: {
      label: "In Progress",
      muiColor: "primary",
      icon: <HourglassEmptyIcon fontSize="small" />,
    },
    20: {
      label: "Pending Approval",
      muiColor: "warning",
      icon: <PendingActionsIcon fontSize="small" />,
    },
    12: {
      label: "Rejected",
      muiColor: "error",
      icon: <ErrorOutlineIcon fontSize="small" />,
    },
    53: {
      label: "Freezed",
      muiColor: "success",
      icon: <LockIcon fontSize="small" />,
    },
  };

  return configs[String(status)] || configs["null"];
};


// --------------------
// Memoized Row Component
// --------------------
const CircleRow = React.memo(({ row }) => {
  const status = getStatusConfig(row.MISC_STATUS);

  return (
    <TableRow hover>
      <TableCell>
        <Typography fontWeight={700}>{row.CIRCLE_NAME}</Typography>
        <Typography variant="caption" color="text.secondary">
          Code: {row.CIRCLE_CODE}
        </Typography>
      </TableCell>

      <TableCell>
        <Stack direction="row" spacing={1}>
          <PersonIcon
            sx={{
              fontSize: 18,
              color: row.MISC_MAKERID
                ? "primary.main"
                : "action.disabled",
            }}
          />
          {row.MISC_MAKERID || "Not Assigned"}
        </Stack>
      </TableCell>

      <TableCell>{formatDate(row.MISC_MAKER_UP_DT)}</TableCell>

      <TableCell>
        <Stack direction="row" spacing={1}>
          <HowToRegIcon
            sx={{
              fontSize: 18,
              color: row.MISC_CHECKERID
                ? "success.main"
                : "action.disabled",
            }}
          />
          {row.MISC_CHECKERID || "Pending"}
        </Stack>
      </TableCell>

      <TableCell>{formatDate(row.MISC_CHECKER_DT)}</TableCell>

      <TableCell>
        <Chip
          icon={status.icon}
          label={status.label}
          color={status.muiColor}
          size="small"
        />
      </TableCell>
    </TableRow>
  );
});


// --------------------
// MAIN COMPONENT
// --------------------
const DICGCDashboard = () => {
  const { callApi } = useApi();

  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  const [searchTerm, setSearchTerm] = useState("");
  const debouncedSearch = useDebounce(searchTerm, 300);


  // --------------------
  // Fetch API
  // --------------------
  useEffect(() => {
    const fetch = async () => {
      setLoading(true);
      try {
        const res = await callApi(
          "/bidData/get-dicgc-dashboard",
          { qed: "30/09/2025" }
        );

        // Create searchable index once
        const optimized = res.map((row) => ({
          ...row,
          searchIndex:
            `${row.CIRCLE_NAME} ${row.CIRCLE_CODE}`
              .toLowerCase(),
        }));

        setData(optimized);
      } catch (e) {
        console.error(e);
      }
      setLoading(false);
    };

    fetch();
  }, [callApi]);


  // --------------------
  // FAST FILTER
  // --------------------
  const filteredData = useMemo(() => {
    if (!debouncedSearch) return data;

    return data.filter((row) =>
      row.searchIndex.includes(
        debouncedSearch.toLowerCase()
      )
    );
  }, [data, debouncedSearch]);


  // --------------------
  // KPI
  // --------------------
  const stats = useMemo(() => {
    const total = data.length;
    const freezed = data.filter(d => d.MISC_STATUS === "53").length;

    return {
      total,
      freezed,
      pending: total - freezed,
      freezedPct:
        total ? Math.round((freezed / total) * 100) : 0,
    };
  }, [data]);


  // --------------------
  // Chart
  // --------------------
  const chartData = useMemo(() => {
    const map = {};

    data.forEach(d => {
      const s = String(d.MISC_STATUS);
      map[s] = (map[s] || 0) + 1;
    });

    return Object.entries(map).map(
      ([key, value], i) => ({
        id: i,
        value,
        label: getStatusConfig(key).label,
      })
    );
  }, [data]);


  return (
    <>
      <Box p={3}>

        {/* SEARCH */}
        <Paper sx={{ p: 1.5, mb: 2 }}>
          <FormInput
            fullWidth
            variant="standard"
            placeholder="Search circle..."
            onChange={(e) =>
              setSearchTerm(e.target.value)
            }
            InputProps={{
              disableUnderline: true,
              startAdornment: (
                <InputAdornment position="start">
                  <SearchIcon />
                </InputAdornment>
              ),
            }}
          />

          <Typography variant="caption">
            {filteredData.length} results
          </Typography>
        </Paper>


        {/* TABLE */}
        <TableContainer component={Paper}>
          <Table>

            <TableHead>
              <TableRow>
                <TableCell>Circle</TableCell>
                <TableCell>Maker</TableCell>
                <TableCell>Maker Date</TableCell>
                <TableCell>Checker</TableCell>
                <TableCell>Checker Date</TableCell>
                <TableCell>Status</TableCell>
              </TableRow>
            </TableHead>


            <TableBody>

              {/* NO DATA */}
              {!loading &&
                filteredData.length === 0 && (
                  <TableRow>
                    <TableCell
                      colSpan={6}
                      align="center"
                      sx={{
                        py: 8,
                      }}
                    >
                      <Stack
                        alignItems="center"
                        spacing={2}
                      >
                        <InboxIcon
                          sx={{
                            fontSize: 60,
                            color:
                              "text.disabled",
                          }}
                        />

                        <Typography variant="h6">
                          No Results Found
                        </Typography>

                        <Typography
                          variant="body2"
                          color="text.secondary"
                        >
                          Try adjusting your search
                        </Typography>
                      </Stack>
                    </TableCell>
                  </TableRow>
                )}


              {/* DATA */}
              {filteredData.map((row) => (
                <CircleRow
                  key={row.CIRCLE_CODE}
                  row={row}
                />
              ))}

            </TableBody>

          </Table>
        </TableContainer>

      </Box>

      <LoadingOverlay loading={loading} />
    </>
  );
};

export default DICGCDashboard;