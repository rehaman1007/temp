SELECT
 pm.PROCESS_TYPE,
 SUM(CASE WHEN r.STATUS = 1 THEN 1 ELSE 0 END) RUNNING,
 SUM(CASE WHEN r.STATUS = 2 THEN 1 ELSE 0 END) SUCCESS,
 SUM(CASE WHEN r.STATUS = 3 THEN 1 ELSE 0 END) FAILED
FROM FINCORE.PROCESS_RUN r
JOIN FINCORE.PROCESS_MASTER pm
 ON pm.PROCESS_ID = r.PROCESS_ID
GROUP BY pm.PROCESS_TYPE;