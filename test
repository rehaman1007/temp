import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  IconButton,
} from "@mui/material";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted = !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
    ? "Started"
    : error
    ? "Failed"
    : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                ? theme.palette.success.main
                : started
                ? theme.palette.info.main
                : theme.palette.text.disabled,
              fontSize: 22,
            })}
          />
        }
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
      >
        <Typography
          variant="subtitle2"
          fontWeight={active ? 600 : 400}
        >
          {stage.stage.title}
        </Typography>
      </StepLabel>

      <StepContent sx={{ pl: 4 }}>
        {!notStarted && !active && (
          <IconButton
            size="small"
            onClick={onClick}
            sx={(theme) => ({
              mt: 0.5,
              color: theme.palette.primary.main,
              "&:hover": {
                backgroundColor: theme.palette.action.hover,
              },
            })}
          >
            <VisibilityOutlinedIcon fontSize="small" />
          </IconButton>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  return (
    <Stepper
      orientation="vertical"
      nonLinear
      sx={(theme) => ({
        minWidth: { xs: 140, sm: 180 },
        maxWidth: 220,
        pr: 1,
      })}
    >
      {stageDetails.map((stage, index) => {
        const active = index === activeStep;

        return (
          <Step
            key={index}
            active
            sx={(theme) => ({
              borderRadius: 1,
              transition: "background-color 0.2s ease",
              ...(active && {
                backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                position: "relative",
                "&::after": {
                  content: '""',
                  position: "absolute",
                  right: -6,
                  top: 0,
                  width: 6,
                  height: "100%",
                  backgroundColor: theme.palette.divider,
                },
              }),
              "&:hover": !active && {
                backgroundColor: theme.palette.action.hover,
                cursor: "pointer",
              },
            })}
            onClick={() => onStageClick(index)}
          >
            <ProcessStepContent
              stage={stage}
              active={active}
              onClick={() => onStageClick(index)}
            />
          </Step>
        );
      })}
    </Stepper>
  );
};

export default ProgressStepper;