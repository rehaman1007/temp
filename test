import React, { useState } from "react";
import {
  Avatar,
  Badge,
  Box,
  IconButton,
  Toolbar,
  Typography,
  useTheme,
  useMediaQuery,
  CircularProgress,
  Fab,
  Tooltip,
  Menu,
  MenuItem,
} from "@mui/material";
import {
  Notifications,
  Download,
  Menu as MenuIcon,
  Cached,
  MoreVert as MoreVertIcon,
} from "@mui/icons-material";
import { useSelector } from "react-redux";
import { userAvatarCreator } from "../utils/userUtilities";
import NotificationDrawer from "./NotificationDrawer";
import ProfileDrawer from "./ProfileDrawer";
import SearchBar from "./search/SearchBar";
import fLogo from "../assets/Logos/Fincore_transperent.svg";
import useNotifications from "../hooks/useNotifications";
import NotificationPopup from "./NotificationPopup";
import AutorenewIcon from "@mui/icons-material/Autorenew";
import TaskProgressDrawer from "./TaskProgressDrawer";
import MyDownloadsDrawer from "./downloads/MyDownloadsDrawer";
import FinCoreIcon from "./ai-assistant/chat/FinCoreIcon";
import ChatWidget from "./ai-assistant/chat/ChatWidget";
import useApi from "../hooks/useApi";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const MENUS_AVAILABLE_FOR_DOWNLOADS = [33, 34, 49, 50, 51, 52];

const LayoutHeader = ({ drawerWidth, navigateToPage, handleDrawerToggle }) => {
  const [notificationDrawerOpen, setNotificationDrawerOpen] = useState(false);
  const [profileDrawerOpen, setProfileDrawerOpen] = useState(false);
  const [myDownloadsDrawerOpen, setMyDownloadsDrawer] = useState(false);
  const [taskDrawerOpen, setTaskDrawerOpen] = useState(false);
  const [hasLaunched, setHasLaunched] = useState(false);
  const [isOpen, setIsOpen] = useState(false);

  // State for the Mobile Overflow Menu
  const [mobileMoreAnchorEl, setMobileMoreAnchorEl] = useState(null);
  const isMobileMenuOpen = Boolean(mobileMoreAnchorEl);

  const userInfo = useSelector((state) => state.auth.user);

  const {
    notifications,
    markAsRead,
    markAllAsRead,
    loadMore,
    hasMore,
    unreadCount,
    popNotification,
    setPopNotification,
    tasks,
    activeCount,
  } = useNotifications();

  const { callApi } = useApi();
  const showSnackbar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);
  const menuItems = useSelector((state) => state.menus.menus);
  const [syncing, setSyncing] = useState(false);
  
  const isAdmin = userInfo && userInfo.role === 10 && userInfo.roleName === "ADMIN";
  
  const showDownloads = menuItems?.some(
    (item) =>
      MENUS_AVAILABLE_FOR_DOWNLOADS.includes(item.id) ||
      item.children?.some((child) => MENUS_AVAILABLE_FOR_DOWNLOADS.includes(child.id))
  );

  const theme = useTheme();
  const isSmallScreen = useMediaQuery(theme.breakpoints.down("md"));

  const handleRBACSync = async () => {
    setSyncing(true);
    try {
      const response = await callApi("/UM/role/force-sync-rbac", null, "POST");
      showSnackbar(response.message || "RBAC permissions Syncing Successfull", "success");
    } catch (error) {
      console.error(error);
      showSnackbar(error.message || "Failed to Sync permissions", "error");
    } finally {
      setSyncing(false);
    }
  };

  const handleMobileMenuClose = () => {
    setMobileMoreAnchorEl(null);
  };

  const handleMobileMenuOpen = (event) => {
    setMobileMoreAnchorEl(event.currentTarget);
  };

  // --- DYNAMIC ACTIONS CONFIGURATION ---
  // Evaluates which secondary items are currently active
  const dynamicActions = [
    {
      id: "sync",
      show: isAdmin,
      inline: (
        <Tooltip title="Sync Permissions" key="sync">
          <IconButton color="inherit" onClick={handleRBACSync} disabled={syncing} sx={{ p: { xs: 0.5, sm: 1 } }}>
            {syncing ? <CircularProgress size={20} /> : <Cached />}
          </IconButton>
        </Tooltip>
      ),
      menu: (
        <MenuItem key="sync-menu" onClick={() => { handleRBACSync(); handleMobileMenuClose(); }}>
          <IconButton size="large" color="inherit">
            {syncing ? <CircularProgress size={24} /> : <Cached />}
          </IconButton>
          <p>Sync Permissions</p>
        </MenuItem>
      ),
    },
    {
      id: "tasks",
      show: activeCount > 0,
      inline: (
        <IconButton key="tasks" onClick={() => setTaskDrawerOpen(true)} sx={{ p: { xs: 0.5, sm: 1 } }}>
          <Badge badgeContent={activeCount} color="warning">
            <Box sx={{ position: "relative" }}>
              <AutorenewIcon sx={{ animation: "spin 1.2s linear infinite" }} />
              <CircularProgress size={36} sx={{ position: "absolute", top: -6, left: -6, zIndex: -1 }} />
            </Box>
          </Badge>
        </IconButton>
      ),
      menu: (
        <MenuItem key="tasks-menu" onClick={() => { setTaskDrawerOpen(true); handleMobileMenuClose(); }}>
          <IconButton size="large" color="inherit">
            <Badge badgeContent={activeCount} color="warning">
              <AutorenewIcon sx={{ animation: "spin 1.2s linear infinite" }} />
            </Badge>
          </IconButton>
          <p>Active Tasks</p>
        </MenuItem>
      ),
    },
    {
      id: "downloads",
      show: showDownloads,
      inline: (
        <Tooltip title="My Downloads" key="downloads">
          <IconButton color="inherit" onClick={() => setMyDownloadsDrawer(true)} sx={{ p: { xs: 0.5, sm: 1 } }}>
            <Download />
          </IconButton>
        </Tooltip>
      ),
      menu: (
        <MenuItem key="downloads-menu" onClick={() => { setMyDownloadsDrawer(true); handleMobileMenuClose(); }}>
          <IconButton size="large" color="inherit">
            <Download />
          </IconButton>
          <p>My Downloads</p>
        </MenuItem>
      ),
    },
    {
      id: "profile",
      show: true,
      inline: (
        <Avatar
          key="profile"
          onClick={() => setProfileDrawerOpen(true)}
          sx={{
            width: { xs: 28, sm: 32 },
            height: { xs: 28, sm: 32 },
            color: "primary.contrastText",
            backgroundColor: "primary.main",
            cursor: "pointer",
            ml: { xs: 0.5, sm: 1 },
            fontSize: { xs: "0.8rem", sm: "1rem" },
          }}
        >
          {userAvatarCreator(user)}
        </Avatar>
      ),
      menu: (
        <MenuItem key="profile-menu" onClick={() => { setProfileDrawerOpen(true); handleMobileMenuClose(); }}>
          <IconButton size="large" color="inherit">
            <Avatar
              sx={{ width: 28, height: 28, color: "primary.contrastText", backgroundColor: "primary.main", fontSize: "0.9rem" }}
            >
              {userAvatarCreator(user)}
            </Avatar>
          </IconButton>
          <p>Profile</p>
        </MenuItem>
      ),
    },
  ].filter((item) => item.show); // Filter out any items the user shouldn't see

  // Determine whether to use the overflow Kebab menu on mobile/tablet
  // Condition: Only if it's a small screen AND there are more than 3 secondary actions.
  const useOverflowMenu = isSmallScreen && dynamicActions.length > 3;

  return (
    <Box
      position="fixed"
      sx={{
        width: { xs: "100%", md: `calc(100% - ${drawerWidth}px)` },
        right: 0,
        top: 0,
        zIndex: 1200,
        background: "linear-gradient(90deg, rgba(162,141,240,0.3), rgba(93,63,211,0.8))",
      }}
    >
      <Toolbar sx={{ display: "flex", justifyContent: "space-between", px: { xs: 1, sm: 2 } }}>
        
        {/* Left side section (Navigation Menu + Logo) */}
        <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
          {isSmallScreen && (
            <IconButton onClick={handleDrawerToggle} sx={{ color: "text.primary" }}>
              <MenuIcon />
            </IconButton>
          )}

          <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
            <img src={fLogo} alt="Logo" style={{ width: 35, height: 35 }} />
            <Typography variant="h6" sx={{ fontWeight: 700, display: { xs: "none", sm: "block" } }}>
              FinCore
            </Typography>
          </Box>
        </Box>

        {/* Right side section */}
        <Box sx={{ display: "flex", alignItems: "center", gap: { xs: 0.5, sm: 1 } }}>
          
          {/* SEARCH BAR - Passing the isSmallScreen prop to hide Ctrl+K */}
          <SearchBar navigateToPage={navigateToPage} hideShortcut={isSmallScreen} />

          {/* ALWAYS INLINE: Chat Widget (if Admin) */}
          {isAdmin && (
            <Tooltip title="FinCore Assistant">
              <Fab
                onClick={() => {
                  setIsOpen(true);
                  setHasLaunched(true);
                }}
                className="fab-pulse"
                color="primary"
                size={isSmallScreen ? "small" : "medium"}
                sx={{ m: { xs: 0.5, sm: 1 }, p: 1, minHeight: { xs: 36, sm: 40 }, width: { xs: 36, sm: 40 } }}
              >
                <FinCoreIcon size={isSmallScreen ? 24 : 31} glow animated />
              </Fab>
            </Tooltip>
          )}

          {/* ALWAYS INLINE: Notifications */}
          <Tooltip title="Show Notifications">
            <IconButton color="inherit" onClick={() => setNotificationDrawerOpen(true)} sx={{ p: { xs: 0.5, sm: 1 } }}>
              <Badge badgeContent={unreadCount || ""} color="error">
                <Notifications />
              </Badge>
            </IconButton>
          </Tooltip>

          {/* DYNAMIC SECONDARY ACTIONS */}
          {!useOverflowMenu ? (
            // Render Inline
            dynamicActions.map((action) => action.inline)
          ) : (
            // Render Overflow Menu Toggle
            <IconButton
              size="large"
              aria-label="show more"
              onClick={handleMobileMenuOpen}
              color="inherit"
              sx={{ p: { xs: 0.5, sm: 1 } }}
            >
              <MoreVertIcon />
            </IconButton>
          )}
        </Box>
      </Toolbar>

      {/* Mobile Overflow Dropdown Menu */}
      <Menu
        anchorEl={mobileMoreAnchorEl}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
        keepMounted
        transformOrigin={{ vertical: "top", horizontal: "right" }}
        open={isMobileMenuOpen}
        onClose={handleMobileMenuClose}
      >
        {dynamicActions.map((action) => action.menu)}
      </Menu>

      <style>{`@keyframes spin { 100% { transform: rotate(360deg); } }`}</style>

      {/* Drawers and Modals */}
      {taskDrawerOpen && <TaskProgressDrawer open={taskDrawerOpen} onClose={() => setTaskDrawerOpen(false)} tasks={tasks} />}
      <NotificationDrawer notificationDrawerOpen={notificationDrawerOpen} setNotificationDrawerOpen={setNotificationDrawerOpen} notifications={notifications} markAsRead={markAsRead} markAllAsRead={markAllAsRead} loadMore={loadMore} hasMore={hasMore} />
      {showDownloads && <MyDownloadsDrawer open={myDownloadsDrawerOpen} onClose={() => setMyDownloadsDrawer(false)} />}
      <ProfileDrawer profileDrawerOpen={profileDrawerOpen} setProfileDrawerOpen={setProfileDrawerOpen} />
      {isAdmin && <ChatWidget isOpen={isOpen} setIsOpen={setIsOpen} hasLaunched={hasLaunched} setHasLaunched={setHasLaunched} />}
      {popNotification && <NotificationPopup popup={popNotification} handleNotificationClick={() => { setNotificationDrawerOpen(true); setPopNotification(null); }} onClose={() => setPopNotification(null)} />}
    </Box>
  );
};

export default React.memo(LayoutHeader);
