export default function GlifReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);
  const download = useSelector((state) => state.download);
  const dispatch = useDispatch();

  const [repTypes, setRepTypes] = useState([]);
  const [selectedReport, setReport] = useState(null);
  const [selectedDate, setDate] = useState(null);
  const [minDate, setMinDate] = useState("");

  const theme = useTheme();
  const styles = GlifReportsStyles(theme);

  const downloadedMB =
    download.downloadedBytes > 0
      ? (download.downloadedBytes / (1024 * 1024)).toFixed(2)
      : null;

  useEffect(() => {
    callApi("/RS/reports/types", { roleId: user.role }, "POST")
      .then((res) => {
        setRepTypes(res.data || []);
        setMinDate(res.data?.[0]?.selectedDate || "2025-10-01");
      });
  }, [callApi, user.role]);

  const handleFetchReportData = () => {
    const downloadId = `${selectedReport.fileName}_${selectedDate.format("YYYYMMDD")}`;

    if (downloadManager.isDownloading(downloadId)) return;

    dispatch(startDownload({
      reportName: selectedReport.reportName,
      date: selectedDate.format("YYYY-MM-DD"),
      fileName: selectedReport.fileName,
    }));

    downloadManager.startDownload({
      id: downloadId,
      url: "/RS/reports/download",
      payload: {
        fileName: selectedReport.fileName,
        date: selectedDate.format("YYYY-MM-DD"),
        roleId: user.role,
      },
      onProgress: (bytes) => dispatch(updateProgress(bytes)),
      onComplete: (response) => {
        const blob = response.data;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "report.zip";
        a.click();
        URL.revokeObjectURL(url);
        dispatch(finishDownload());
      },
      onError: () => {
        dispatch(finishDownload());
        showSnackBar("Download failed", "error");
      },
    });
  };

  return (
    <Grow in timeout={500}>
      <Card sx={styles.card}>
        <Button
          variant="contained"
          disabled={download.active}
          onClick={handleFetchReportData}
          endIcon={<CloudDownloadTwoTone />}
        >
          {download.active ? "Downloading..." : "Fetch & Download"}
        </Button>

        <Fade in={download.active}>
          <Box sx={styles.progressContainer}>
            <Typography>
              Downloading {download.meta?.reportName}
            </Typography>
            <Typography variant="caption">
              {downloadedMB
                ? `${downloadedMB} MB downloaded`
                : "Preparing stream..."}
            </Typography>
            <LinearProgress />
          </Box>
        </Fade>
      </Card>
    </Grow>
  );
}