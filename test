          <Typography variant="body2">
            Download in progress…
          </Typography>
          <Typography variant="caption">
            {downloadedMB
              ? `${downloadedMB} MB received`
              : "Preparing stream…"}
          </Typography>
          <LinearProgress />
        </Box>
      </Fade>
    </>
  );
}

export const saveBlob = (blob, filename = "report.zip") => {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
};