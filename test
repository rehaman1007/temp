const histogramData = useMemo(() => {
  const map = {};

  data.forEach((item) => {
    if (item.reqDate) {
      const date = new Date(item.reqDate).toLocaleDateString("en-GB");

      if (!map[date]) {
        map[date] = {
          date,
          pendingRequests: 0,
          addRequests: 0,
          changeType: "—",
        };
      }

      map[date].pendingRequests += 1;

      if (item.changeType === "ADD") {
        map[date].addRequests += 1;
      }

      map[date].changeType = item.changeType || "—";
    }
  });

  return Object.values(map);
}, [data]);

const CustomTooltip = ({ active, payload, label }) => {
  if (active && payload?.length) {
    const d = payload[0].payload;

    return (
      <Box
        sx={{
          bgcolor: "#1e1e2f",
          p: 1.5,
          borderRadius: 1,
          color: "#fff",
          fontSize: 12,
        }}
      >
        <div><b>Date:</b> {label}</div>
        <div><b>Pending Requests:</b> {d.pendingRequests}</div>
        <div><b>Add Requests:</b> {d.addRequests}</div>
        <div><b>Change Type:</b> {d.changeType}</div>
      </Box>
    );
  }
  return null;
};

const CustomBarLabel = ({ x, y, width, value, payload }) => {
  return (
    <>
      {/* Pending Requests */}
      <text
        x={x + width / 2}
        y={y - 18}
        fill="#fff"
        fontSize={11}
        textAnchor="middle"
        fontWeight={600}
      >
        {value}
      </text>

      {/* Add Requests */}
      <text
        x={x + width / 2}
        y={y - 6}
        fill="#90caf9"
        fontSize={9}
        textAnchor="middle"
      >
        Add: {payload.addRequests}
      </text>

      {/* Change Type */}
      <text
        x={x + width / 2}
        y={y + 12}
        fill="#ffcc80"
        fontSize={9}
        textAnchor="middle"
      >
        {payload.changeType}
      </text>
    </>
  );
};

<Box sx={s.barChartArea}>
  <ResponsiveContainer>
    <BarChart data={histogramData}>
      <CartesianGrid
        strokeDasharray="3 3"
        stroke="rgba(255,255,255,0.3)"
      />

      <XAxis
        dataKey="date"
        stroke="white"
        fontSize={10}
        tickMargin={4}
      />

      <YAxis
        stroke="white"
        fontSize={10}
        label={{
          value: "Pending Requests",
          angle: -90,
          position: "insideLeft",
          fill: "white",
          fontSize: 11,
        }}
      />

      <Tooltip content={<CustomTooltip />} />

      <Bar
        dataKey="pendingRequests"
        fill="url(#gradient-3)"
        radius={[6, 6, 0, 0]}
        label={<CustomBarLabel />}
      />
    </BarChart>
  </ResponsiveContainer>
</Box>