import "./App.css";
import AppRouter from "./routes/AppRouter";
import {
  Box,
  CssBaseline,
  StyledEngineProvider,
  ThemeProvider,
  useColorScheme,
} from "@mui/material";
import { useEffect } from "react";
import { SnackbarProviderComponent } from "./utils/SnackbarContext";
import GlobalBackground from "./theme/GlobalBackground";
import AppTheme from "./theme/AppTheme";

// component to handle color scheme logic
const ColorSchemeInitializer = () => {
  const { mode, setMode } = useColorScheme();

  useEffect(() => {
    // Only log and set mode if it's not undefined
    if (mode === "system" || mode === undefined) {
      setMode("light");
    }
    console.log("Current color scheme :: ", mode);
  }, [mode, setMode]);

  // This component doesn't render anything visible, it just manages the state
  return null;
};

function App() {

  return (
    <>
      <AppTheme>
        <StyledEngineProvider enableCssLayer>
          <ColorSchemeInitializer />
          <CssBaseline enableColorScheme />
          <GlobalBackground />
          <Box
            sx={{
              transition:
                "background-color 0.6s ease, color 0.6s ease, filter 0.6s ease",
            }}
          >
            <SnackbarProviderComponent>
              <AppRouter />
            </SnackbarProviderComponent>
          </Box>
        </StyledEngineProvider>
      </AppTheme>
    </>
  );
}

export default App;
