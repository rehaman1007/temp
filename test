import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import { DataGrid, GridToolbarQuickFilter, QuickFilter } from "@mui/x-data-grid";
import EditIcon from "@mui/icons-material/Edit";

export default function RolesTable({
  rows,
  loading,
  onEditRow,
  errorText,
}) {
  /**
   * This function is for displaying search field.
   *
   * @Author : V1014064
   **/
  const QuickSearchToolbar = () => {
    return (
      <Box
        sx={{
          p: 1,
          pb: 0,
          r: 0,
          display: "flex",
          alignItem: "right",
          width: "100%",
          justifyContent: "flex-end",
        }}
      >
        <QuickFilter sx={{ display: "flex", alignItem: "right" }} />
      </Box>
    );
  };
  const columns = [
    {
      field: "roleName",
      headerName: "Role",
      flex: 2,
      sortable: true,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "description",
      headerName: "Description",
      flex: 3,
      sortable: true,
    },
    {
      field: "status",
      headerName: "Role Status",
      flex: 0.6,
      sortable: true,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "action",
      headerName: "Action",
      sortable: false,
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Stack
          direction="row"
          spacing={0.5}
          alignItems="center"
          justifyContent="center"
          sx={{ height: "100%" }}
        >
          <Tooltip title="Edit">
            <IconButton
              size="small"
              onClick={() => onEditRow(params.row, "Edit")}
            >
              <EditIcon fontSize="inherit" />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <DataGrid
      rows={rows}
      columns={columns}
      getRowId={(row) => row.roleId}
      disableRowSelectionOnClick
      slots={{ toolbar: QuickSearchToolbar }}
      slotProps={{
        toolbar: {
          showQuickFilter: true,
        },
      }}
      pageSizeOptions={[5, 10, 25, 50]}
      loading={loading}
      localeText={{
        noRowsLabel: errorText,
      }}
      autoHeight
      initialState={{
        pagination: { paginationModel: { pageSize: 10, page: 0 } },
        sorting: { sortModel: [{ field: "roleName", sort: "asc" }] },
      }}
    />
  );
}

