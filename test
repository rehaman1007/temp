const MIN_ALLOWED_DATE = dayjs("2026-03-31");

const DATE_FORMAT = "DD/MM/YYYY";

const handleSearch = () => {
  const { cgl, fromDate, toDate } = filters;

  // ================= REQUIRED VALIDATION =================
  if (!cgl || !fromDate || !toDate) {
    showSnackBar(
      "Please fill all required fields",
      "warning",
    );

    return;
  }

  // ================= INVALID DATE VALIDATION =================
  if (
    !fromDate?.isValid?.() ||
    !toDate?.isValid?.()
  ) {
    showSnackBar(
      "Invalid date selected",
      "warning",
    );

    return;
  }

  // ================= MIN DATE VALIDATION =================
  if (
    fromDate.isBefore(
      MIN_ALLOWED_DATE,
      "day",
    )
  ) {
    showSnackBar(
      `From date cannot be earlier than ${MIN_ALLOWED_DATE.format(
        DATE_FORMAT,
      )}`,
      "warning",
    );

    return;
  }

  if (
    toDate.isBefore(
      MIN_ALLOWED_DATE,
      "day",
    )
  ) {
    showSnackBar(
      `To date cannot be earlier than ${MIN_ALLOWED_DATE.format(
        DATE_FORMAT,
      )}`,
      "warning",
    );

    return;
  }

  // ================= DATE ORDER VALIDATION =================
  if (fromDate.isAfter(toDate, "day")) {
    showSnackBar(
      "From date cannot be greater than To date",
      "warning",
    );

    return;
  }

  // ================= MAX RANGE VALIDATION =================
  if (
    toDate.isAfter(
      fromDate.add(1, "year"),
      "day",
    )
  ) {
    showSnackBar(
      "Date range cannot exceed 12 months",
      "warning",
    );

    return;
  }

  // ================= ETL DATE VALIDATION =================
  if (
    etlDate?.isValid?.() &&
    toDate.isAfter(etlDate, "day")
  ) {
    showSnackBar(
      `To date cannot exceed ETL date ${etlDate.format(
        DATE_FORMAT,
      )}`,
      "warning",
    );

    return;
  }

  // ================= RESET PAGINATION =================
  setPaginationModel((prev) => ({
    ...prev,
    page: 0,
  }));

  // ================= EXECUTE SEARCH =================
  setSearchQuery({ ...filters });
};