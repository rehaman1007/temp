import React, { useState, useEffect } from "react";
import {
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Button,
  Stack,
  Tooltip,
  IconButton,
  Chip,
  CircularProgress,
  Paper,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import {
  PieChart,
  Pie,
  Cell,
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip as ReTooltip,
  Legend,
  ResponsiveContainer,
} from "recharts";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";

export default function CommonRequestScreen({
  requestType,
  apiUrl,
  patchUrl,
  columns,
  transformData,
  defaultSort = { field: "reqDate", sort: "desc" },
}) {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [remarks, setRemarks] = useState("");
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  // ---- Chart States ----
  const [summaryData, setSummaryData] = useState({
    pending: 0,
    approved: 0,
    rejected: 0,
    add: 0,
    delete: 0,
    modify: 0,
    daily: [],
  });

  // -------- Fetch Data -------------
  const fetchData = async () => {
    setLoading(true);
    try {
      const response = await callApi(
        apiUrl,
        { requestType: requestType || "CGL_CODE" },
        "POST"
      );
      const result = response?.data || [];

      const data = result.map((row) => {
        const payloadData =
          row.payload && typeof row.payload === "object" ? row.payload : {};
        return { ...row, ...payloadData };
      });

      if (transformData) {
        setRows(transformData(data));
      } else {
        setRows(data);
      }

      // Prepare chart data
      const pending = data.filter((d) => d.status === "PENDING").length;
      const approved = data.filter((d) => d.status === "ACCEPTED").length;
      const rejected = data.filter((d) => d.status === "REJECTED").length;
      const add = data.filter((d) => d.changeType === "A").length;
      const del = data.filter((d) => d.changeType === "D").length;
      const mod = data.filter((d) => d.changeType === "M").length;

      // Daily count
      const dailyMap = {};
      data.forEach((d) => {
        const day = new Date(d.reqDate).toLocaleDateString("en-GB");
        dailyMap[day] = (dailyMap[day] || 0) + 1;
      });
      const dailyArr = Object.keys(dailyMap).map((k) => ({
        day: k,
        count: dailyMap[k],
      }));

      setSummaryData({
        pending,
        approved,
        rejected,
        add,
        delete: del,
        modify: mod,
        daily: dailyArr,
      });

      if (!data.length) {
        showSnackBar("No pending requests found", "warning");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error fetching data", "error");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  // -------- Confirmation Handling ----------
  const handleConfirm = async () => {
    if (confirmDialog.type === "reject" && !remarks.trim()) {
      showSnackBar("Please provide remarks before rejecting", "warning");
      return;
    }

    try {
      const payload = {
        requestId: confirmDialog.rowId,
        status: confirmDialog.type === "reject" ? "REJECTED" : "ACCEPTED",
        remarks:
          confirmDialog.type === "reject" ? remarks.trim() : "No Remarks",
      };
      const res = await callApi(patchUrl, payload, "PATCH");

      if (res?.success || res) {
        showSnackBar(
          confirmDialog.type === "accept"
            ? "Request Approved"
            : "Request Rejected",
          "success"
        );
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error while processing request", "error");
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  // -------- Columns with Actions ----------
  const allColumns = [
    ...columns,
    {
      field: "changeType",
      headerName: "Request Type",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const val = params.value;
        return val === "A" ? (
          <Chip icon={<AddBoxIcon />} label="Added" size="small" />
        ) : val === "D" ? (
          <Chip icon={<AutoDeleteIcon />} label="Deleted" size="small" />
        ) : (
          <Chip icon={<EditDocumentIcon />} label="Modified" size="small" />
        );
      },
    },
    {
      field: "creatorId",
      headerName: "Creator ID",
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Chip icon={<AccountCircleIcon />} label={params.value} size="small" />
      ),
    },
    {
      field: "reqDate",
      headerName: "Requested Date",
      flex: 1,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const isoString = params.value;
        if (!isoString) return null;
        const date = new Date(isoString);
        return <Box>{date.toLocaleString()}</Box>;
      },
    },
    {
      field: "actions",
      headerName: "Actions",
      flex: 0.6,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Stack direction="row" spacing={1}>
          <Tooltip title="Approve">
            <IconButton
              onClick={() => openConfirmDialog("accept", params.row.id)}
              color="success"
            >
              <CheckIcon />
            </IconButton>
          </Tooltip>
          <Tooltip title="Reject">
            <IconButton
              onClick={() => openConfirmDialog("reject", params.row.id)}
              color="error"
            >
              <ClearIcon />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  // ---------- Chart Colors ----------
  const COLORS = ["#0088FE", "#00C49F", "#FF8042"];

  return (
    <Box>
      {/* --- Top Charts Section --- */}
      <Stack direction="row" spacing={2} mb={2}>
        {/* Circular Progress for Pending / Approved / Rejected */}
        <Paper sx={{ p: 2, flex: 1 }}>
          <Typography variant="subtitle1" align="center">
            Request Status
          </Typography>
          <Stack direction="row" spacing={2} justifyContent="center" mt={2}>
            <Stack alignItems="center">
              <CircularProgress
                variant="determinate"
                value={summaryData.pending}
                color="warning"
              />
              <Typography>Pending: {summaryData.pending}</Typography>
            </Stack>
            <Stack alignItems="center">
              <CircularProgress
                variant="determinate"
                value={summaryData.approved}
                color="success"
              />
              <Typography>Approved: {summaryData.approved}</Typography>
            </Stack>
            <Stack alignItems="center">
              <CircularProgress
                variant="determinate"
                value={summaryData.rejected}
                color="error"
              />
              <Typography>Rejected: {summaryData.rejected}</Typography>
            </Stack>
          </Stack>
        </Paper>

        {/* Pie Chart Add/Delete/Modify */}
        <Paper sx={{ p: 2, flex: 1 }}>
          <Typography variant="subtitle1" align="center">
            Request Types
          </Typography>
          <ResponsiveContainer width="100%" height={200}>
            <PieChart>
              <Pie
                data={[
                  { name: "Add", value: summaryData.add },
                  { name: "Delete", value: summaryData.delete },
                  { name: "Modify", value: summaryData.modify },
                ]}
                dataKey="value"
                outerRadius={60}
                label
              >
                {COLORS.map((c, i) => (
                  <Cell key={i} fill={c} />
                ))}
              </Pie>
              <ReTooltip />
            </PieChart>
          </ResponsiveContainer>
        </Paper>

        {/* Line Chart for Daily Requests */}
        <Paper sx={{ p: 2, flex: 1 }}>
          <Typography variant="subtitle1" align="center">
            Requests Per Day
          </Typography>
          <ResponsiveContainer width="100%" height={200}>
            <LineChart data={summaryData.daily}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="day" />
              <YAxis />
              <ReTooltip />
              <Legend />
              <Line type="monotone" dataKey="count" stroke="#8884d8" />
            </LineChart>
          </ResponsiveContainer>
        </Paper>
      </Stack>

      {/* --- Data Grid Section --- */}
      <DataGrid
        rows={rows}
        columns={allColumns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [defaultSort] },
        }}
        getRowId={(row) => row.id}
        loading={loading}
        sx={{
          height: 600,
          width: "100%",
          "& .MuiDataGrid-cell:focus": { outline: "none" },
        }}
      />

      {/* --- Confirm Dialog --- */}
      <Dialog open={confirmDialog.open} onClose={closeConfirmDialog} maxWidth="sm" fullWidth>
        <DialogTitle>
          {confirmDialog.type === "accept" ? "Confirm Approval" : "Confirm Rejection"}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 2 }}>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Please enter remarks."}
          </Typography>
          {confirmDialog.type === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={closeConfirmDialog} color="inherit" variant="contained">
            Cancel
          </Button>
          <Button
            onClick={handleConfirm}
            color={confirmDialog.type === "accept" ? "success" : "error"}
            variant="contained"
          >
            {confirmDialog.type === "accept" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}