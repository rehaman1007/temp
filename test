package com.fincore.enquiry_service.service;

import com.fincore.enquiry_service.dto.LedgerWiseRequest;
import com.fincore.enquiry_service.dto.LedgerWiseResponse;
import com.fincore.enquiry_service.model.LedgerTransaction;
import com.fincore.enquiry_service.repository.LedgerWiseRepository;
import com.fincore.enquiry_service.specification.LedgerWiseSpecification;

import lombok.RequiredArgsConstructor;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Service;

@Service
@RequiredArgsConstructor
public class LedgerWiseServiceImpl
        implements LedgerWiseService {

    private final LedgerWiseRepository repository;

    @Override
    public Page<LedgerWiseResponse> search(
            LedgerWiseRequest dto
    ) {

        // ================= SORT =================

        String sortField =
                dto.getSortField() != null
                        ? dto.getSortField()
                        : "transactionDate";

        Sort.Direction direction =
                "asc".equalsIgnoreCase(
                        dto.getSortOrder()
                )
                        ? Sort.Direction.ASC
                        : Sort.Direction.DESC;

        // ================= PAGEABLE =================

        Pageable pageable =
                PageRequest.of(
                        dto.getPage() != null
                                ? dto.getPage()
                                : 0,

                        dto.getSize() != null
                                ? dto.getSize()
                                : 20,

                        Sort.by(
                                direction,
                                sortField
                        )
                );

        // ================= SPECIFICATION =================

        Specification<LedgerTransaction>
                specification =
                LedgerWiseSpecification
                        .filter(dto);

        // ================= FETCH =================

        Page<LedgerTransaction> page =
                repository.findAll(
                        specification,
                        pageable
                );

        // ================= MAP RESPONSE =================

        return page.map(this::mapToDto);
    }

    // ================= DTO MAPPER =================

    private LedgerWiseResponse mapToDto(
            LedgerTransaction entity
    ) {

        return new LedgerWiseResponse(

                entity.getTransactionId(),

                entity.getBatchId(),

                entity.getJournalId(),

                entity.getTransactionDate(),

                entity.getPostDate(),

                entity.getBranchCode(),

                entity.getBranch() != null
                        ? entity.getBranch().getName()
                        : null,

                entity.getBranch() != null
                        ? entity.getBranch()
                            .getCircleCode()
                        : null,

                entity.getBranch() != null &&
                entity.getBranch().getCircle() != null
                        ? entity.getBranch()
                            .getCircle()
                            .getCircleName()
                        : null,

                entity.getCurrency(),

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                            .getCurrencyName()
                        : null,

                entity.getCgl(),

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                            .getDescription()
                        : null,

                entity.getNarration(),

                entity.getDebitAmount(),

                entity.getCreditAmount(),

                entity.getTransactionCount(),

                entity.getSourceFlag()
        );
    }
}