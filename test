            )}

            <TextField
              label="Width"
              type="number"
              size="small"
              value={col.format?.width || ""}
              onChange={(e) => {
                const val = e.target.value;
                onUpdate(
                  "format.width",
                  val === "" ? undefined : parseInt(val),
