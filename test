package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.sql.*;
import java.sql.Date;
import java.time.Duration;
import java.time.Instant;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * CHANGE THIS ANYTIME
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * UI STATUS STORE
     */
    private final Map<String, Map<String, Object>> jobStore = new ConcurrentHashMap<>();

    /**
     * NORMAL SQL EXECUTION
     */
    @Override
    public Map<String, Object> executeAdminSql(AdminSupportDTO dto) {

        String rawSql = dto.getSql().trim();

        String[] statements = rawSql.split(";");

        List<String> cleanStatements = new ArrayList<>();

        for (String s : statements) {

            String clean = s.replaceAll("(?m)^--.*", "").trim();

            if (!clean.isEmpty()) {

                cleanStatements.add(clean);
            }
        }

        boolean isSingleSelect =
                cleanStatements.size() == 1 &&
                        (
                                cleanStatements.get(0).toUpperCase().startsWith("SELECT")
                                        || cleanStatements.get(0).toUpperCase().startsWith("WITH")
                        );

        int page = dto.getPage() != null ? dto.getPage() : 0;

        int size = dto.getSize() != null ? dto.getSize() : 5;

        /**
         * SELECT
         */
        if (isSingleSelect) {

            String sql = cleanStatements.get(0);

            try {

                long start = System.currentTimeMillis();

                String countSql = "SELECT COUNT(*) FROM (" + sql + ")";

                Integer total = jdbcTemplate.queryForObject(countSql, Integer.class);

                String paginatedSql =
                        sql +
                                " OFFSET " + (page * size) +
                                " ROWS FETCH NEXT " + size + " ROWS ONLY";

                return jdbcTemplate.query(paginatedSql, rs -> {

                    ResultSetMetaData meta = rs.getMetaData();

                    int columnCount = meta.getColumnCount();

                    List<Map<String, String>> columns = new ArrayList<>();

                    for (int i = 1; i <= columnCount; i++) {

                        columns.add(Map.of(
                                "name",
                                meta.getColumnLabel(i)
                        ));
                    }

                    List<Map<String, Object>> rows = new ArrayList<>();

                    while (rs.next()) {

                        Map<String, Object> row = new HashMap<>();

                        for (int i = 1; i <= columnCount; i++) {

                            String columnName = meta.getColumnLabel(i);

                            int columnType = meta.getColumnType(i);

                            Object value;

                            switch (columnType) {

                                case Types.VARCHAR:
                                case Types.CHAR:
                                case Types.NVARCHAR:
                                    value = rs.getString(i);
                                    break;

                                case Types.INTEGER:
                                case Types.BIGINT:
                                case Types.NUMERIC:
                                case Types.DECIMAL:
                                    value = rs.getObject(i);
                                    break;

                                case Types.DATE:

                                    Date date = rs.getDate(i);

                                    value =
                                            date != null
                                                    ? date.toLocalDate().toString()
                                                    : null;

                                    break;

                                case Types.TIMESTAMP:

                                    Timestamp ts = rs.getTimestamp(i);

                                    value =
                                            ts != null
                                                    ? ts.toLocalDateTime().toString()
                                                    : null;

                                    break;

                                default:
                                    value = rs.getObject(i);
                            }

                            row.put(columnName, value);
                        }

                        rows.add(row);
                    }

                    long end = System.currentTimeMillis();

                    log.info(
                            "SELECT EXECUTED | rows={} | total={} | time={}ms",
                            rows.size(),
                            total,
                            (end - start)
                    );

                    return Map.of(
                            "columns", columns,
                            "rows", rows,
                            "total", total,
                            "page", page,
                            "size", size,
                            "error", false
                    );
                });

            } catch (Exception e) {

                log.error("SQL EXECUTION FAILED", e);

                return Map.of(
                        "error", true,
                        "message", e.getMessage()
                );
            }
        }

        /**
         * DML / DDL
         */
        else {

            try {

                int success = 0;

                int insertCount = 0;

                int updateCount = 0;

                int deleteCount = 0;

                int otherCount = 0;

                long start = System.currentTimeMillis();

                for (String sql : cleanStatements) {

                    jdbcTemplate.execute(sql);

                    success++;

                    String upper = sql.trim().toUpperCase();

                    if (upper.startsWith("INSERT")) {
                        insertCount++;
                    }
                    else if (upper.startsWith("UPDATE")) {
                        updateCount++;
                    }
                    else if (upper.startsWith("DELETE")) {
                        deleteCount++;
                    }
                    else {
                        otherCount++;
                    }
                }

                long end = System.currentTimeMillis();

                log.info(
                        "SCRIPT EXECUTED | total={} | insert={} | update={} | delete={} | other={} | time={}ms",
                        success,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        (end - start)
                );

                return Map.of(
                        "error", false,
                        "columns", List.of(Map.of("name", "RESULT")),
                        "rows", List.of(
                                Map.of(
                                        "RESULT",
                                        "Execution completed successfully"
                                )
                        ),
                        "insertCount", insertCount,
                        "updateCount", updateCount,
                        "deleteCount", deleteCount,
                        "otherCount", otherCount,
                        "total", success
                );

            } catch (Exception e) {

                log.error("SCRIPT EXECUTION FAILED", e);

                return Map.of(
                        "error", true,
                        "message", e.getMessage()
                );
            }
        }
    }

    /**
     * HUGE FILE UPLOAD
     */
    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file,
            String userId,
            HttpServletRequest request
    ) {

        try {

            String jobId = UUID.randomUUID().toString();

            String ip =
                    request.getHeader("X-Forwarded-For") != null
                            ? request.getHeader("X-Forwarded-For")
                            : request.getRemoteAddr();

            Map<String, Object> initial = new ConcurrentHashMap<>();

            initial.put("status", "UPLOADING");

            initial.put("executedCount", 0);

            initial.put("insertCount", 0);

            initial.put("updateCount", 0);

            initial.put("deleteCount", 0);

            initial.put("otherCount", 0);

            initial.put("progress", 0);

            initial.put("elapsedSeconds", 0);

            initial.put("estimatedRemainingSeconds", 0);

            initial.put("startedAt", Instant.now().toString());

            initial.put("fileName", file.getOriginalFilename());

            initial.put(
                    "fileSizeMb",
                    String.format(
                            "%.2f",
                            (file.getSize() / 1024.0 / 1024.0)
                    )
            );

            jobStore.put(jobId, initial);

            log.info(
                    "SQL UPLOAD RECEIVED | jobId={} | file={} | size={}MB | user={} | ip={}",
                    jobId,
                    file.getOriginalFilename(),
                    String.format("%.2f", (file.getSize() / 1024.0 / 1024.0)),
                    userId,
                    ip
            );

            adminSupportExecutor.executeScriptAsync(
                    file,
                    jobId,
                    userId,
                    ip,
                    COMMIT_BATCH_SIZE,
                    jobStore
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId,
                    "message", "Execution started"
            );

        } catch (Exception e) {

            log.error("UPLOAD FAILED", e);

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * JOB STATUS
     */
    @Override
    public Map<String, Object> getJobStatus(String jobId) {

        return jobStore.getOrDefault(
                jobId,
                Map.of("status", "NOT_FOUND")
        );
    }
}


package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import javax.sql.DataSource;
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    private final DataSource dataSource;

    /**
     * ASYNC SQL EXECUTION
     */
    @Async("sqlExecutor")
    public void executeScriptAsync(
            MultipartFile file,
            String jobId,
            String userId,
            String clientIp,
            int commitBatchSize,
            Map<String, Map<String, Object>> jobStore
    ) {

        Instant startTime = Instant.now();

        int executedCount = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int otherCount = 0;

        int failedLine = -1;

        String failedSql = null;

        try (
                Connection connection = dataSource.getConnection();
                BufferedReader reader =
                        new BufferedReader(
                                new InputStreamReader(file.getInputStream())
                        );
                Statement statement = connection.createStatement()
        ) {

            connection.setAutoCommit(false);

            log.info(
                    "SQL EXECUTION STARTED | jobId={} | batchSize={}",
                    jobId,
                    commitBatchSize
            );

            /**
             * COUNT TOTAL STATEMENTS
             */
            int totalStatements = 0;

            BufferedReader counter =
                    new BufferedReader(
                            new InputStreamReader(file.getInputStream())
                    );

            String cLine;

            while ((cLine = counter.readLine()) != null) {

                if (cLine.trim().endsWith(";")) {
                    totalStatements++;
                }
            }

            counter.close();

            log.info(
                    "TOTAL STATEMENTS FOUND = {}",
                    totalStatements
            );

            jobStore.get(jobId).put(
                    "totalStatements",
                    totalStatements
            );

            jobStore.get(jobId).put(
                    "status",
                    "RUNNING"
            );

            StringBuilder sqlBuilder = new StringBuilder();

            String line;

            int currentLine = 0;

            while ((line = reader.readLine()) != null) {

                currentLine++;

                String trimmed = line.trim();

                if (
                        trimmed.isBlank()
                                || trimmed.startsWith("--")
                ) {
                    continue;
                }

                sqlBuilder.append(line).append("\n");

                if (trimmed.endsWith(";")) {

                    String sql =
                            sqlBuilder.toString().trim();

                    sql =
                            sql.substring(
                                    0,
                                    sql.lastIndexOf(";")
                            );

                    failedSql = sql;

                    validateDangerousSql(sql);

                    statement.execute(sql);

                    executedCount++;

                    String upper =
                            sql.toUpperCase().trim();

                    if (upper.startsWith("INSERT")) {
                        insertCount++;
                    }
                    else if (upper.startsWith("UPDATE")) {
                        updateCount++;
                    }
                    else if (upper.startsWith("DELETE")) {
                        deleteCount++;
                    }
                    else {
                        otherCount++;
                    }

                    /**
                     * BATCH COMMIT
                     */
                    if (executedCount % commitBatchSize == 0) {

                        connection.commit();

                        log.info(
                                "BATCH COMMIT SUCCESS | count={}",
                                executedCount
                        );
                    }

                    long elapsed =
                            Duration.between(
                                    startTime,
                                    Instant.now()
                            ).toSeconds();

                    long eta = 0;

                    if (executedCount > 0) {

                        double avg =
                                (double) elapsed / executedCount;

                        eta =
                                (long) (
                                        (totalStatements - executedCount)
                                                * avg
                                );
                    }

                    double progress =
                            ((double) executedCount / totalStatements) * 100;

                    double speed =
                            elapsed > 0
                                    ? (double) executedCount / elapsed
                                    : executedCount;

                    Map<String, Object> status =
                            jobStore.get(jobId);

                    status.put("status", "RUNNING");

                    status.put("executedCount", executedCount);

                    status.put("insertCount", insertCount);

                    status.put("updateCount", updateCount);

                    status.put("deleteCount", deleteCount);

                    status.put("otherCount", otherCount);

                    status.put(
                            "progress",
                            Math.min(progress, 100)
                    );

                    status.put(
                            "elapsedSeconds",
                            elapsed
                    );

                    status.put(
                            "estimatedRemainingSeconds",
                            eta
                    );

                    status.put(
                            "executionSpeed",
                            String.format("%.2f", speed)
                    );

                    sqlBuilder.setLength(0);
                }
            }

            connection.commit();

            long totalSeconds =
                    Duration.between(
                            startTime,
                            Instant.now()
                    ).toSeconds();

            jobStore.get(jobId).put("status", "COMPLETED");

            jobStore.get(jobId).put(
                    "completedAt",
                    Instant.now().toString()
            );

            jobStore.get(jobId).put(
                    "elapsedSeconds",
                    totalSeconds
            );

            jobStore.get(jobId).put(
                    "progress",
                    100
            );

            log.info(
                    "SQL EXECUTION COMPLETED | jobId={} | total={} | inserts={} | updates={} | deletes={} | time={}s",
                    jobId,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    totalSeconds
            );

            /**
             * STORE AUDIT LOG
             */
            saveExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    file.getOriginalFilename(),
                    "COMPLETED",
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    null,
                    null,
                    null,
                    totalSeconds
            );

        } catch (Exception e) {

            failedLine++;

            log.error(
                    "SQL EXECUTION FAILED | jobId={} | line={}",
                    jobId,
                    failedLine,
                    e
            );

            jobStore.get(jobId).put("status", "FAILED");

            jobStore.get(jobId).put(
                    "failedLine",
                    failedLine
            );

            jobStore.get(jobId).put(
                    "failedSql",
                    failedSql
            );

            jobStore.get(jobId).put(
                    "exceptionType",
                    e.getClass().getSimpleName()
            );

            jobStore.get(jobId).put(
                    "message",
                    e.getMessage()
            );

            saveExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    file.getOriginalFilename(),
                    "FAILED",
                    0,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedLine,
                    failedSql,
                    e,
                    Duration.between(startTime, Instant.now()).toSeconds()
            );
        }
    }

    /**
     * DANGEROUS SQL BLOCKER
     */
    private void validateDangerousSql(String sql) {

        String upper = sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        || upper.contains("ALTER SYSTEM")
                        || upper.contains("SHUTDOWN")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL blocked"
            );
        }
    }

    /**
     * AUDIT LOG
     */
    private void saveExecutionLog(
            String jobId,
            String userId,
            String clientIp,
            String fileName,
            String status,
            int totalStatements,
            int executedCount,
            int insertCount,
            int updateCount,
            int deleteCount,
            int otherCount,
            Integer failedLine,
            String failedSql,
            Exception exception,
            long elapsedSeconds
    ) {

        try (
                Connection con = dataSource.getConnection();
                Statement stmt = con.createStatement()
        ) {

            String sql = """
                    INSERT INTO ADMIN_SUPPORT_LOG (

                        ID,
                        JOB_ID,
                        USER_ID,
                        CLIENT_IP,
                        FILE_NAME,
                        EXECUTION_TYPE,
                        STATUS,
                        TOTAL_STATEMENTS,
                        EXECUTED_COUNT,
                        INSERT_COUNT,
                        UPDATE_COUNT,
                        DELETE_COUNT,
                        OTHER_COUNT,
                        FAILED_STATEMENT_NUMBER,
                        FAILED_SQL,
                        EXCEPTION_TYPE,
                        EXCEPTION_MESSAGE,
                        ELAPSED_SECONDS,
                        STARTED_AT,
                        COMPLETED_AT

                    ) VALUES (

                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        '%s',
                        '%s',
                        '%s',
                        '%s',
                        'SQL_UPLOAD',
                        '%s',
                        %d,
                        %d,
                        %d,
                        %d,
                        %d,
                        %d,
                        %s,
                        %s,
                        %s,
                        %s,
                        %d,
                        SYSTIMESTAMP,
                        SYSTIMESTAMP

                    )
                    """.formatted(
                    safe(jobId),
                    safe(userId),
                    safe(clientIp),
                    safe(fileName),
                    safe(status),
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedLine == null ? "NULL" : failedLine,
                    failedSql == null ? "NULL" : "'" + safe(failedSql) + "'",
                    exception == null
                            ? "NULL"
                            : "'" + safe(exception.getClass().getSimpleName()) + "'",
                    exception == null
                            ? "NULL"
                            : "'" + safe(exception.getMessage()) + "'",
                    elapsedSeconds
            );

            stmt.execute(sql);

        } catch (Exception e) {

            log.error(
                    "FAILED TO SAVE ADMIN LOG",
                    e
            );
        }
    }

    private String safe(String value) {

        if (value == null) {
            return "";
        }

        return value.replace("'", "''");
    }
}

