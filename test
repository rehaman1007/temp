/*==========================================================
  PROCESS_STAGE_MASTER
==========================================================*/
CREATE TABLE FINCORE.PROCESS_STAGE_MASTER (
  STAGE_ID NUMBER PRIMARY KEY,
  TITLE VARCHAR2(100) NOT NULL,
  ICON VARCHAR2(50) NOT NULL
);

COMMENT ON TABLE FINCORE.PROCESS_STAGE_MASTER
IS 'Master list of all possible stages in a process pipeline';

COMMENT ON COLUMN FINCORE.PROCESS_STAGE_MASTER.STAGE_ID
IS 'Unique identifier of a stage';

COMMENT ON COLUMN FINCORE.PROCESS_STAGE_MASTER.TITLE
IS 'Display name of the stage shown in UI';

COMMENT ON COLUMN FINCORE.PROCESS_STAGE_MASTER.ICON
IS 'UI icon name representing the stage';

/*==========================================================
  PROCESS_MASTER
==========================================================*/
CREATE TABLE FINCORE.PROCESS_MASTER (
  PROCESS_ID NUMBER PRIMARY KEY,
  PROCESS_NAME VARCHAR2(30) NOT NULL,
  PROCESS_DAG_ID VARCHAR2(100) NOT NULL,
  PROCESS_FLAG CHAR(1) DEFAULT 'Y' CHECK (PROCESS_FLAG IN ('Y','N')),
  PROCESS_DESCRIPTION VARCHAR2(250),
  CONSTRAINT UK_PROCESS_NAME UNIQUE (PROCESS_NAME, PROCESS_DAG_ID)
);

COMMENT ON TABLE FINCORE.PROCESS_MASTER
IS 'Master of business processes with merged DAG configuration';

COMMENT ON COLUMN FINCORE.PROCESS_MASTER.PROCESS_ID
IS 'Unique identifier of business process';

COMMENT ON COLUMN FINCORE.PROCESS_MASTER.PROCESS_NAME
IS 'Business name of process (CBS, GLIF, DIFFERENCE, ETL, BANCS etc)';

COMMENT ON COLUMN FINCORE.PROCESS_MASTER.PROCESS_DAG_ID
IS 'Airflow DAG name used to execute this process';

COMMENT ON COLUMN FINCORE.PROCESS_MASTER.PROCESS_FLAG
IS 'Y if process is active, N if disabled';

COMMENT ON COLUMN FINCORE.PROCESS_MASTER.PROCESS_DESCRIPTION
IS 'Logical description of what this process does';

/*==========================================================
  PROCESS_RUN
==========================================================*/
CREATE TABLE FINCORE.PROCESS_RUN (
  RUN_ID NUMBER PRIMARY KEY,
  PROCESS_RUN_ID NUMBER,
  PROCESS_ID NUMBER NOT NULL,
  START_TIME TIMESTAMP,
  END_TIME TIMESTAMP,
  STATUS NUMBER(1) CHECK (STATUS IN (0,1,2,3)),
  TRIGGERED_BY VARCHAR2(30),
  ETL_DATE DATE,
  AIRFLOW_RUN_ID VARCHAR2(50),
  CONSTRAINT FK_RUN_PROCESS
    FOREIGN KEY (PROCESS_ID)
    REFERENCES FINCORE.PROCESS_MASTER(PROCESS_ID)
);

COMMENT ON TABLE FINCORE.PROCESS_RUN
IS 'One execution (run) of a process';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.PROCESS_RUN_ID
IS 'Unique identifier of process run';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.PROCESS_ID
IS 'Foreign key referencing PROCESS_MASTER.PROCESS_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.START_TIME
IS 'Timestamp when execution started';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.END_TIME
IS 'Timestamp when execution ended';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.STATUS
IS '0 Not Started, 1 Running, 2 Success, 3 Failed';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.TRIGGERED_BY
IS 'User or system who triggered the run';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.ETL_DATE
IS 'Business date of execution';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.AIRFLOW_RUN_ID
IS 'Run id generated by Airflow';

/*==========================================================
  PROCESS_RUN_STAGE
==========================================================*/
CREATE TABLE FINCORE.PROCESS_RUN_STAGE (
  PROCESS_RUN_STAGE_ID NUMBER PRIMARY KEY,
  PROCESS_RUN_ID NUMBER NOT NULL,
  RUN_ID NUMBER NOT NULL,
  STAGE_ID NUMBER NOT NULL,
  START_TIME TIMESTAMP,
  END_TIME TIMESTAMP,
  STATUS NUMBER(1) CHECK (STATUS IN (0,1,2,3)),
  EXECUTION_REMARKS VARCHAR2(400),
  DIFFERENCE_SUMMARY CLOB,
  CONSTRAINT FK_RS_RUN
    FOREIGN KEY (RUN_ID)
    REFERENCES FINCORE.PROCESS_RUN(RUN_ID),
	CONSTRAINT FK_RS_PROCESS_RUN
    FOREIGN KEY (PROCESS_RUN_ID)
    REFERENCES FINCORE.PROCESS(PROCESS_RUN_ID),
  
  CONSTRAINT FK_RS_STAGE
    FOREIGN KEY (STAGE_ID)
    REFERENCES FINCORE.PROCESS_STAGE_MASTER(STAGE_ID),
  CONSTRAINT UK_RUN_STAGE UNIQUE (RUN_ID, STAGE_ID)
);

COMMENT ON TABLE FINCORE.PROCESS_RUN_STAGE
IS 'Execution status of each stage for a process run';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.RUN_STAGE_ID
IS 'Unique identifier of stage execution row';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.RUN_ID
IS 'Foreign key referencing PROCESS_RUN.RUN_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.PROCESS_ID
IS 'Foreign key referencing PROCESS_MASTER.PROCESS_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.STAGE_ID
IS 'Foreign key referencing PROCESS_STAGE_MASTER.STAGE_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.START_TIME
IS 'Stage start timestamp';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.END_TIME
IS 'Stage end timestamp';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.STATUS
IS '0 Not Started, 1 Running, 2 Success, 3 Failed';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.EXECUTION_REMARKS
IS 'Remarks or error message for stage execution';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.DIFFERENCE_SUMMARY
IS 'Large JSON or text summary for reconciliation or difference stage';

/*==========================================================
  SEQUENCES
==========================================================*/
CREATE SEQUENCE FINCORE.PROCESS_RUN_SEQ START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;
CREATE SEQUENCE FINCORE.PROCESS_RUN_STAGE_SEQ START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;

/*==========================================================
  INDEXES
==========================================================*/
CREATE INDEX IDX_RUN_PROCESS ON FINCORE.PROCESS_RUN(PROCESS_ID);
CREATE INDEX IDX_RUN_STATUS ON FINCORE.PROCESS_RUN(STATUS);
CREATE INDEX IDX_RS_RUN ON FINCORE.PROCESS_RUN_STAGE(RUN_ID);
CREATE INDEX IDX_RS_PROCESS ON FINCORE.PROCESS_RUN_STAGE(PROCESS_ID);
CREATE INDEX IDX_RS_STAGE ON FINCORE.PROCESS_RUN_STAGE(STAGE_ID);
CREATE INDEX IDX_RS_STATUS ON FINCORE.PROCESS_RUN_STAGE(STATUS);

