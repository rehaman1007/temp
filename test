  setSelectedDag(dagData);
  setIsDialogOpen(true);
};

{/* Dialog Component placed at the bottom */}
<DagDetailsDialog 
  open={isDialogOpen} 
  onClose={() => setIsDialogOpen(false)} 
  dagData={selectedDag} 
/>
