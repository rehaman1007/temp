import React, { useMemo } from "react";
import PropTypes from "prop-types";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Container,
  Stack,
  useTheme,
  alpha,
  styled,
} from "@mui/material";
import { motion } from "framer-motion";
import {
  ChevronRight as ChevronRightIcon,
  InfoOutlined as InfoOutlinedIcon,
} from "@mui/icons-material";
import { useNavigate } from "react-router-dom";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { getIconComponent } from "../utils/IconUtils";


// Motion Components

const MotionCard = motion.create(Card);
const MotionBox = motion.create(Box);

// Framer Motion Variants

const cardMotionVariants = {
  initial: { scale: 1, y: 0 },
  hover: {
    scale: 1.03,
    y: -8,
    transition: { duration: 0.2, ease: [0.4, 0, 0.2, 1] },
  },
};

/**
 * Creates motion variants for the icon container.
 * We use a function to get access to the theme.
 */
const getIconMotionVariants = (theme) => ({
  initial: {
    rotate: 0,
    scale: 1,
    backgroundColor: alpha(theme.palette.background.paper, 0.1),
    boxShadow: `0 0 0px ${alpha(theme.palette.primary.main, 0)}`,
  },
  hover: {
    rotate: 0,
    scale: 1.15,
    backgroundColor: alpha(theme.palette.background.paper, 0.18),
    boxShadow: `0 0 ${theme.spacing(2.5)} ${alpha(
      theme.palette.primary.main,
      0.3
    )}`,
    transition: {
      scale: { type: "spring", stiffness: 260, damping: 12 },
      // Use a standard ease transition for background and shadow
      default: { duration: 0.2, ease: "easeInOut" },
    },
  },
});

const getChevronMotionVariants = (theme) => ({
  initial: { x: 0, opacity: 0.7 },
  hover: {
    x: theme.spacing(0.75),
    opacity: 1,
    transition: { duration: 0.25, ease: "easeOut" },
  },
});

const containerVariants = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: {
      staggerChildren: 0.08,
    },
  },
};

const itemVariants = {
  hidden: { opacity: 0, y: 20 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.4, ease: [0.4, 0, 0.2, 1] },
  },
};



/**
 * Submenu Selection Main Component
 * 
 * @author v1018404
 */

const SubmenuSelectionPage = () => {
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const { navigateToPage } = useNavigateToPage();
  const navigate = useNavigate();
  const theme = useTheme();

  if (!selectedMenuItem) {
    navigate("/");
  }

  const submenuOptions = useMemo(
    () => selectedMenuItem?.children || [],
    [selectedMenuItem]
  );

  const iconVariants = useMemo(() => getIconMotionVariants(theme), [theme]);
  const chevronVariants = useMemo(
    () => getChevronMotionVariants(theme),
    [theme]
  );

  // Format description list
  const formattedDescription = useMemo(
    () =>
      submenuOptions
        .map((child) => child?.screenDescription)
        .filter(Boolean)
        .join(", "),
    [submenuOptions]
  );

  return (
    <StyledSubmenuRootCard aria-label={`${selectedMenuItem?.title} submenu`}>
      {/* === Header === */}
      <HeaderBox
        component={motion.div}
        // initial={{ opacity: 0, y: -20 }}
        // animate={{ opacity: 1, y: 0 }}
        // transition={{ duration: 0.5 }}
      >
        <HeaderTitle variant={"h4"} component="h1">
          {selectedMenuItem?.title}
        </HeaderTitle>

        {formattedDescription && (
          <HeaderDescription variant="body1" color="text.secondary">
            {formattedDescription}
          </HeaderDescription>
        )}
      </HeaderBox>

      {/* === Cards Section === */}
      <Container maxWidth="lg" sx={{ mb: { xs: 4, md: 6 } }}>
        <GridContainer
          component={motion.div}
          variants={containerVariants}
          initial="hidden"
          animate="visible"
        >
          {submenuOptions.map((menu) => {
            const MenuIcon = getIconComponent(menu.icon);

            return (
              <StyledMotionCard
                key={menu.id}
                component={motion.div}
                variants={{ ...itemVariants, ...cardMotionVariants }}
                whileHover="hover"
                // Set initial to "initial" so IconContainer picks up
                // its 'initial' variant state from the start.
                initial="initial"
                // Animate prop is implicitly "visible" from parent
                onClick={() => navigateToPage(menu)}
                tabIndex={0}
                role="button"
                aria-label={`Maps to ${menu.title}`}
                onKeyDown={(e) => {
                  if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    navigateToPage(menu);
                  }
                }}
              >
                <StyledCardContent>
                  <Stack
                    direction="row"
                    alignItems="center"
                    spacing={2}
                    sx={{ position: "relative", width: "100%" }}
                  >
                    {/* Icon Container */}
                    <IconContainer
                      // Pass the variants here.
                      // 'initial' and 'hover' states will be picked up
                      // from the parent StyledMotionCard's state.
                      variants={iconVariants}
                    >
                      {MenuIcon && (
                        <MenuIcon
                          sx={{
                            fontSize: {
                              xs: theme.typography.h4.fontSize,
                              sm: theme.typography.h3.fontSize,
                            },
                          }}
                        />
                      )}
                    </IconContainer>

                    {/* Text Content */}
                    <TextContainer>
                      <Typography
                        variant="subtitle1"
                        sx={{
                          fontWeight: theme.typography.fontWeightMedium,
                          mb: 0.5,
                          textShadow: `0 ${theme.spacing(
                            0.125
                          )} ${theme.spacing(0.375)} ${alpha(
                            theme.palette.common.black,
                            0.2
                          )}`,
                          letterSpacing: "-0.01em",
                        }}
                      >
                        {menu.title}
                      </Typography>
                      <Typography
                        variant="body2"
                        color="text.secondary"
                        sx={{
                          lineHeight: theme.typography.body2.lineHeight,
                          opacity: 0.85,
                        }}
                      >
                        {menu.screenDescription}
                      </Typography>
                    </TextContainer>

                    {/* Chevron */}
                    <ChevronContainer variants={chevronVariants}>
                      <ChevronRightIcon
                        sx={{
                          fontSize: {
                            xs: theme.typography.h5.fontSize,
                            sm: theme.typography.h3.fontSize,
                          },
                          opacity: 0.7,
                        }}
                      />
                    </ChevronContainer>
                  </Stack>
                </StyledCardContent>
              </StyledMotionCard>
            );
          })}
        </GridContainer>
      </Container>

      {/* === Info Footer === */}
      <InfoFooter
        component={motion.div}
        // initial={{ opacity: 0 }}
        // animate={{ opacity: 1 }}
        // transition={{ delay: 0.4, duration: 0.5 }}
      >
        <InfoStack
          direction="row"
          justifyContent="center"
          alignItems="center"
          spacing={1.5}
          flexWrap="wrap"
        >
          <InfoOutlinedIcon
            sx={{
              color: alpha(theme.palette.text.primary, 0.9),
              fontSize: {
                xs: theme.typography.h6.fontSize,
                sm: theme.typography.h5.fontSize,
              },
              flexShrink: 0,
            }}
          />
          <Typography
            variant="body2"
            sx={{
              fontWeight: theme.typography.fontWeightRegular,
              opacity: 0.85,
              lineHeight: theme.typography.body2.lineHeight,
            }}
          >
            Click on any of the above options to access the corresponding{" "}
            <Box
              component="span"
              sx={{ fontWeight: theme.typography.fontWeightMedium }}
            >
              {selectedMenuItem?.title}
            </Box>{" "}
            features.
          </Typography>
        </InfoStack>
      </InfoFooter>
    </StyledSubmenuRootCard>
  );
};

// ======================================================================
// Prop Types
// ======================================================================

SubmenuSelectionPage.propTypes = {
  selectedMenuItem: PropTypes.shape({
    id: PropTypes.oneOfType([PropTypes.string, PropTypes.number]).isRequired,
    title: PropTypes.string.isRequired,
    children: PropTypes.arrayOf(
      PropTypes.shape({
        id: PropTypes.oneOfType([PropTypes.string, PropTypes.number])
          .isRequired,
        title: PropTypes.string.isRequired,
        screenDescription: PropTypes.string,
        icon: PropTypes.string,
      })
    ),
  }),
  navigateToPage: PropTypes.func.isRequired,
  getIconComponent: PropTypes.func.isRequired,
};

// ======================================================================
// Styled Components
// ======================================================================

const StyledSubmenuRootCard = styled(Card)(({ theme }) => ({
  width: "100%",
  // margin: theme.spacing(8),
  paddingTop: theme.spacing(8),
  paddingBottom: theme.spacing(8),
  paddingLeft: theme.spacing(4),
  paddingRight: theme.spacing(4),
  [theme.breakpoints.down("md")]: {
    margin: theme.spacing(6),
    paddingTop: theme.spacing(6),
    paddingBottom: theme.spacing(6),
    paddingLeft: theme.spacing(3),
    paddingRight: theme.spacing(3),
  },
  [theme.breakpoints.down("sm")]: {
    margin: theme.spacing(2),
    paddingTop: theme.spacing(4),
    paddingBottom: theme.spacing(4),
    paddingLeft: theme.spacing(2),
    paddingRight: theme.spacing(2),
  },
}));

const HeaderBox = styled(Box)(({ theme }) => ({
  textAlign: "center",
  marginBottom: theme.spacing(6),
  [theme.breakpoints.down("md")]: {
    marginBottom: theme.spacing(4),
  },
}));

const HeaderTitle = styled(Typography)(({ theme }) => ({
  fontWeight: theme.typography.fontWeightBold,
  marginBottom: theme.spacing(2),
  letterSpacing: "-0.02em",
}));

const HeaderDescription = styled(Typography)(({ theme }) => ({
  maxWidth: 700,
  margin: "0 auto",
  lineHeight: theme.typography.body1.lineHeight,
  paddingLeft: theme.spacing(3),
  paddingRight: theme.spacing(3),
  opacity: 0.9,
  [theme.breakpoints.down("sm")]: {
    paddingLeft: theme.spacing(2),
    paddingRight: theme.spacing(2),
  },
}));

const GridContainer = styled(Box)(({ theme }) => ({
  display: "grid",
  gridTemplateColumns: "1fr",
  gap: theme.spacing(3),
  justifyItems: "center",
  [theme.breakpoints.up("sm")]: {
    gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
    gap: theme.spacing(4),
  },
}));

// This is the icon container inside the card
const IconContainer = styled(MotionBox)(({ theme }) => ({
  padding: theme.spacing(1.5),
  borderRadius: theme.shape.borderRadius * 1.5,
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  flexShrink: 0,
  // Base styles for the icon itself
  "& .MuiSvgIcon-root": {
    filter: "none",
    // Add a CSS transition for the filter property
    transition: theme.transitions.create("filter", {
      duration: theme.transitions.duration.standard,
    }),
  },
}));

const TextContainer = styled(Box)({
  flex: 1,
  minWidth: 0,
});

const ChevronContainer = styled(MotionBox)({
  flexShrink: 0,
  display: "flex",
  alignItems: "center",
});

// This is the individual clickable card
const StyledMotionCard = styled(MotionCard)(({ theme }) => ({
  width: "100%",
  maxWidth: 320,
  borderRadius: theme.shape.borderRadius * 2,
  cursor: "pointer",
  background: `linear-gradient(145deg, ${alpha(
    theme.palette.background.paper,
    0.25
  )}, ${alpha(theme.palette.background.paper, 0.08)})`,
  border: `1px solid ${alpha(theme.palette.divider, 0.2)}`,
  backdropFilter: "blur(10px)",
  WebkitBackdropFilter: "blur(10px",

  // transition: theme.transitions.create(["box-shadow", "background"], {
  //   duration: theme.transitions.duration.standard,
  //   easing: theme.transitions.easing.easeInOut,
  // }),

  boxShadow: `0 ${theme.spacing(0.5)} ${theme.spacing(2)} ${alpha(
    theme.palette.common.black,
    0.08
  )}, 0 ${theme.spacing(0.25)} ${theme.spacing(0.5)} ${alpha(
    theme.palette.common.black,
    0.04
  )}`,

  display: "flex",
  flexDirection: "column",

  "&:focus-visible": {
    outline: `2px solid ${alpha(theme.palette.primary.main, 0.6)}`,
    outlineOffset: theme.spacing(0.25),
  },
  "&:active": {
    transform: "scale(0.98)",
  },

  // Hover styles
  "&:hover": {
    // This box-shadow is still handled by CSS transition
    boxShadow: `0 ${theme.spacing(1.5)} ${theme.spacing(5)} ${alpha(
      theme.palette.common.black,
      0.18
    )}, 0 ${theme.spacing(0.5)} ${theme.spacing(1.5)} ${alpha(
      theme.palette.common.black,
      0.12
    )}`,

    [`& ${IconContainer} .MuiSvgIcon-root`]: {
      filter: `drop-shadow(0 0 ${theme.spacing(1)} ${alpha(
        theme.palette.primary.main,
        0.4
      )})`,
    },
  },
}));

// This is the content area inside the card
const StyledCardContent = styled(CardContent)(({ theme }) => ({
  padding: theme.spacing(3),
  [theme.breakpoints.down("sm")]: {
    padding: theme.spacing(2.5),
  },
  flex: 1,
  display: "flex",
  alignItems: "center",
}));

const InfoFooter = styled(Box)(({ theme }) => ({
  marginTop: theme.spacing(6),
  padding: theme.spacing(2.5, 3),
  borderRadius: theme.shape.borderRadius * 2,
  background: `linear-gradient(90deg, ${alpha(
    theme.palette.background.paper,
    0.12
  )}, ${alpha(theme.palette.background.paper, 0.06)})`,
  border: `1px solid ${alpha(theme.palette.divider, 0.15)}`,
  textAlign: "center",
  maxWidth: 800,
  margin: "0 auto",
  boxShadow: `0 ${theme.spacing(0.5)} ${theme.spacing(2)} ${alpha(
    theme.palette.common.black,
    0.08
  )}`,
  [theme.breakpoints.down("md")]: {
    marginTop: theme.spacing(4),
  },
  [theme.breakpoints.down("sm")]: {
    padding: theme.spacing(2),
  },
}));

const InfoStack = styled(Stack)({});

export default React.memo(SubmenuSelectionPage);
