import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";
import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex((s) => s.status === StageStatus.STARTED);
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.status === StageStatus.ERROR);
  if (error !== -1) return error;

  const completedIndexes = stages
    .map((s, i) => (s.status === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  if (completedIndexes.length > 0) {
    return completedIndexes[completedIndexes.length - 1];
  }

  return 0;
};

const ProcessDetailsDialog = ({
  process,
  onClose,
  onStart,
  onStop,
  permissions = {},
}) => {
  const stages = useMemo(() => process?.stageDetails || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    if (stages.length) {
      setActiveStep(resolveInitialActiveStep(stages));
    }
  }, [stages, process]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.status;

  return (
    <Dialog open={!!process} fullWidth maxWidth="md" onClose={onClose}>
      <DialogTitle>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        <Stack direction="row" gap={1}>
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />

          <StageDetails stages={stages} activeStep={activeStep} />
        </Stack>
      </DialogContent>

      {(permissions.start || permissions.stop) && (
        <DialogActions>
          {permissions.start && lastStatus != StageStatus.STARTED && (
            <Button
              startIcon={<RestartAltIcon />}
              disabled={lastStatus === StageStatus.STARTED}
              onClick={() => onStart(process)}
            >
              Restart
            </Button>
          )}

          {permissions.stop && lastStatus == StageStatus.STARTED && (
            <Button
              startIcon={<StopIcon />}
              disabled={lastStatus !== StageStatus.STARTED}
              onClick={() => onStop(process)}
            >
              Stop
            </Button>
          )}
        </DialogActions>
      )}
    </Dialog>
  );
};

export default ProcessDetailsDialog;



import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  Button,
} from "@mui/material";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";

/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted = !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
      ? "Started"
      : error
        ? "Failed"
        : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">{stage.stage.title}</Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button size="small" o variant="contained" onClick={onClick}>
            <VisibilityOutlinedIcon fontSize="small" sx={{ mr: 1 }} />
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  return (
    <Box>
      <Stepper orientation="vertical" sx={{ minWidth: 180 }} nonLinear>
        {stageDetails.map((stage, index) => {
          const active = index === activeStep;

          return (
            <Step
              key={index}
              active
              data-step={index}
              sx={(theme) =>
                active
                  ? {
                      backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                      position: "relative",
                      "&::after": {
                        content: '""',
                        position: "absolute",
                        right: -8,
                        top: 0,
                        width: 8,
                        height: "100%",
                        backgroundColor: theme.palette.divider,
                      },
                    }
                  : {}
              }
            >
              <Box
                sx={(theme) =>
                  active
                    ? {
                        backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                        position: "relative",
                        "&::after": {
                          content: '""',
                          position: "absolute",
                          right: -8,
                          top: 0,
                          width: 8,
                          height: "100%",
                          backgroundColor: theme.palette.divider,
                        },
                      }
                    : {}
                }
              >
                <ProcessStepContent
                  stage={stage}
                  active={active}
                  onClick={() => onStageClick(index)}
                />
              </Box>
            </Step>
          );
        })}
      </Stepper>
    </Box>
  );
};

export default ProgressStepper;
