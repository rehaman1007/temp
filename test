processViewData: (data) => {
      console.log(data);
      const {
        comp1 = "",
        segmentCode = "",
        comp2 = "",
        description = "",
        acClassification = "",
        balFwd = "",
        defBalType = "",
        status = "",
        balCompare = "",
        manualPosting = "",
      } = data;

      const accountClassifications = ACCOUNT_CLASSIFICATIONS.find(
        (x) => x.value === acClassification
      );

      const balanceForward = balFwd == "1" ? "Yes" : "No";

      const defaultBalanceType =
        defBalType == "C" ? "Credit" : defBalType == "D" ? "Debit" : "Memo";

      const cglStatus = status == "1" ? "Active" : "Inactive";

      const balanceCompare = balCompare == "1" ? "Include" : "Exclude";

      const manualPostingAllowed = manualPosting == "1" ? "Yes" : "No";

      const showData = {
        comp1,
        segmentCode,
        comp2,
        description,
        accountClassifications: accountClassifications.label,
        balanceForward,
        defaultBalanceType,
        cglStatus,
        balanceCompare,
        manualPostingAllowed,
      };
      const finalData = { ...data };
      finalData.payload = showData;

      return finalData;
    },
