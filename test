import React, { useMemo, useState } from "react";
import {
  alpha,
  Box,
  Chip,
  Paper,
  Stack,
  Typography,
  useTheme,
  Button,
} from "@mui/material";
import {
  AutoAwesome,
  Storage,
  TableRows,
  Download,
} from "@mui/icons-material";
import {
  DataGrid,
  GridToolbarQuickFilter,
} from "@mui/x-data-grid";

import ExportDialog from "./ExportDialog";

const CustomToolbar = () => (
  <Box
    sx={{
      p: 1,
      display: "flex",
      justifyContent: "flex-end",
    }}
  >
    <GridToolbarQuickFilter />
  </Box>
);

const ResultGrid = ({
  results,
  loading,
  paginationModel,
  setPaginationModel,

  onExport,
  exportLoading,
}) => {
  const theme = useTheme();

  const [exportOpen, setExportOpen] =
    useState(false);

  const rows = results?.rows || [];
  const columns = results?.columns || [];
  const total = results?.total || 0;

  const processedRows = useMemo(() => {
    return rows.map((row, index) => ({
      __rowId:
        row.ID ??
        row.id ??
        row.RN ??
        `${paginationModel.page}-${index}`,
      ...row,
    }));
  }, [rows, paginationModel.page]);

  return (
    <>
      <Paper
        elevation={0}
        sx={{
          height: "100%",
          borderRadius: 1,
          overflow: "hidden",
          border: `1px solid ${theme.palette.divider}`,
          display: "flex",
          flexDirection: "column",
        }}
      >
        {/* HEADER */}
        <Box
          sx={{
            px: 2.5,
            py: 1.5,
            background:
              "linear-gradient(135deg,#111827,#1f2937)",
            color: "white",
            borderBottom:
              "1px solid rgba(255,255,255,0.06)",
          }}
        >
          <Stack
            direction="row"
            justifyContent="space-between"
            alignItems="center"
            flexWrap="wrap"
            gap={1}
          >
            <Stack
              direction="row"
              spacing={1.5}
              alignItems="center"
            >
              <Storage fontSize="small" />
              <Typography fontWeight={800}>
                Query Result Grid
              </Typography>
            </Stack>

            <Stack
              direction="row"
              spacing={1}
              alignItems="center"
              flexWrap="wrap"
            >
              <Chip
                size="small"
                icon={<TableRows />}
                label={`${rows.length} Rows`}
                sx={{
                  bgcolor:
                    "rgba(255,255,255,0.08)",
                  color: "white",
                }}
              />

              <Chip
                size="small"
                icon={<AutoAwesome />}
                label={`${columns.length} Columns`}
                sx={{
                  bgcolor:
                    "rgba(255,255,255,0.08)",
                  color: "white",
                }}
              />

              <Chip
                size="small"
                label={`Total : ${total}`}
                sx={{
                  bgcolor:
                    "rgba(255,255,255,0.08)",
                  color: "white",
                }}
              />

              <Button
                size="small"
                variant="contained"
                startIcon={<Download />}
                disabled={
                  loading ||
                  exportLoading ||
                  !rows.length
                }
                onClick={() =>
                  setExportOpen(true)
                }
              >
                Export
              </Button>
            </Stack>
          </Stack>
        </Box>

        {/* GRID */}
        <Box
          sx={{
            flex: 1,
            minHeight: 0,
            overflow: "hidden",
          }}
        >
          <DataGrid
            rows={processedRows}
            columns={columns}
            rowCount={total}
            loading={loading}
            disableRowSelectionOnClick
            paginationMode="server"
            paginationModel={
              paginationModel
            }
            onPaginationModelChange={
              setPaginationModel
            }
            pageSizeOptions={[
              10,
              25,
              50,
              100,
            ]}
            getRowId={(row) =>
              row.__rowId
            }
            rowHeight={38}
            columnHeaderHeight={48}
            slots={{
              toolbar:
                CustomToolbar,
            }}
            sx={{
              border: "none",
              fontSize: 13,
              bgcolor: "#ffffff",

              "& .MuiDataGrid-columnHeaders":
                {
                  bgcolor:
                    "#f8fafc",
                  borderBottom:
                    "1px solid #e5e7eb",
                },

              "& .MuiDataGrid-columnHeaderTitle":
                {
                  fontWeight: 800,
                  color:
                    "#111827",
                },

              "& .MuiDataGrid-row:hover":
                {
                  bgcolor: alpha(
                    theme.palette
                      .primary.main,
                    0.04,
                  ),
                },

              "& .MuiDataGrid-cell":
                {
                  borderBottom:
                    "1px solid #f1f5f9",
                },

              "& .MuiDataGrid-footerContainer":
                {
                  borderTop:
                    "1px solid #e5e7eb",
                  bgcolor:
                    "#fafafa",
                },

              "& .MuiDataGrid-toolbarContainer":
                {
                  borderBottom:
                    "1px solid #f1f5f9",
                },

              "& .MuiDataGrid-cell:focus, & .MuiDataGrid-columnHeader:focus":
                {
                  outline:
                    "none",
                },

              "& .MuiDataGrid-cell:focus-within, & .MuiDataGrid-columnHeader:focus-within":
                {
                  outline:
                    "none",
                },
            }}
          />
        </Box>
      </Paper>

      <ExportDialog
        open={exportOpen}
        onClose={() =>
          setExportOpen(false)
        }
        onExport={onExport}
        loading={exportLoading}
      />
    </>
  );
};

export default ResultGrid;