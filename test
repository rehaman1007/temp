import React from "react";
import {
  Card,
  CardContent,
  Typography,
  Stack,
  List,
  ListItem,
  ListItemText,
  Divider,
  Box,
} from "@mui/material";
import CampaignIcon from "@mui/icons-material/Campaign";
import CustomChip from "../../../utils/CustomChip";

export const DashboardAnnouncements = ({ announcements = [] }) => {
  /* Method for returning color for severity */
  const getSeverityColor = (severity) => {
    switch (severity) {
      case "WARN":
        return "warning";
      case "ERROR":
        return "error";
      case "INFO":
      default:
        return "info";
    }
  };
  return (
    <>
      <Card variant="outlined" sx={{ borderRadius: 3 }}>
        <CardContent>
          <Stack direction="row" spacing={1} alignItems="center" mb={1}>
            <Box
              sx={{
                width: 44,
                height: 44,
                borderRadius: 2,
                bgcolor: "rgba(0,0,0,0.06)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <CampaignIcon />
            </Box>

            <Typography variant="subtitle1" fontWeight={700}>
              Announcements
            </Typography>
          </Stack>

          <List dense sx={{ minHeight: 320, maxHeight: 320, overflow: "auto" }}>
            {(announcements || []).map((a, idx) => (
              <React.Fragment key={a.id || idx}>
                {idx > 0 && <Divider component="li" />}
                <ListItem alignItems="flex-start">
                  <ListItemText
                    primary={
                      <Stack
                        direction="row"
                        spacing={12}
                        gap={12}
                        alignItems="center"
                      >
                        <Typography variant="body2" fontWeight={600}>
                          {a.title}
                        </Typography>
                        <CustomChip
                          label={a.severity}
                          size="small"
                          color={getSeverityColor(a.severity)}
                          variant="outlined"
                        />
                      </Stack>
                    }
                    secondary={
                      <>
                        <Typography
                          component="span"
                          variant="caption"
                          color="text.secondary"
                          display="block"
                        >
                          {a.date}
                        </Typography>
                        <Typography variant="body2">{a.message}</Typography>
                      </>
                    }
                  />
                </ListItem>
              </React.Fragment>
            ))}
            {(!announcements || announcements.length === 0) && (
              <EmptyState text="No announcements" />
            )}
          </List>
        </CardContent>
      </Card>
    </>
  );
};
