import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  Button,
} from "@mui/material";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";

/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted = !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
      ? "Started"
      : error
        ? "Failed"
        : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">{stage.stage.title}</Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button size="small" o variant="contained" onClick={onClick}>
            <VisibilityOutlinedIcon fontSize="small" sx={{ mr: 1 }} />
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({ stageDetails = [], activeStep, onStageClick }) => {
  return (
    <Box>
      <Stepper orientation="vertical" sx={{ minWidth: 180 }} nonLinear>
        {stageDetails.map((stage, index) => {
          const active = index === activeStep;

          return (
            <Step
              key={index}
              active
              data-step={index}
              sx={(theme) =>
                active
                  ? {
                      backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                      position: "relative",
                      "&::after": {
                        content: '""',
                        position: "absolute",
                        right: -8,
                        top: 0,
                        width: 8,
                        height: "100%",
                        backgroundColor: theme.palette.divider,
                      },
                    }
                  : {}
              }
            >
              <Box
                sx={(theme) =>
                  active
                    ? {
                        backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                        position: "relative",
                        "&::after": {
                          content: '""',
                          position: "absolute",
                          right: -8,
                          top: 0,
                          width: 8,
                          height: "100%",
                          backgroundColor: theme.palette.divider,
                        },
                      }
                    : {}
                }
              >
                <ProcessStepContent
                  stage={stage}
                  active={active}
                  onClick={() => onStageClick(index)}
                />
              </Box>
            </Step>
          );
        })}
      </Stepper>
    </Box>
  );
};

export default ProgressStepper;
