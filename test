import React, { useEffect, useState, useCallback } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  Tooltip,
  Stack,
} from "@mui/material";
import { Close, PushPin, PushPinOutlined, DeleteSweep } from "@mui/icons-material";
import axios from "axios";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
}) => {
  const [notifications, setNotifications] = useState([]);

  // --- API base URL ---
  const BASE_URL = "/api/notifications";

  // === 1️⃣ Fetch initial notifications (View All) ===
  const fetchAllNotifications = useCallback(async () => {
    try {
      const res = await axios.get(`${BASE_URL}/all`);
      setNotifications(res.data || []);
    } catch (err) {
      console.error("Failed to fetch notifications:", err);
    }
  }, []);

  // === 2️⃣ Connect to SSE event stream ===
  useEffect(() => {
    const eventSource = new EventSource(`${BASE_URL}/stream`);
    console.log("🔗 Connected to SSE stream...");

    eventSource.onmessage = (event) => {
      try {
        const newNotification = JSON.parse(event.data);
        setNotifications((prev) => [newNotification, ...prev]);
      } catch (e) {
        console.warn("Invalid SSE message:", e);
      }
    };

    eventSource.onerror = (err) => {
      console.error("❌ SSE connection error:", err);
      eventSource.close();
    };

    return () => {
      console.log("🔒 Closing SSE connection...");
      eventSource.close();
    };
  }, []);

  // === 3️⃣ Mark as read ===
  const handleMarkAsRead = async (id) => {
    try {
      await axios.post(`${BASE_URL}/mark-read/${id}`);
      setNotifications((prev) =>
        prev.map((n) =>
          n.id === id ? { ...n, unread: false } : n
        )
      );
    } catch (err) {
      console.error("Failed to mark as read:", err);
    }
  };

  // === 4️⃣ Toggle Pin ===
  const handleTogglePin = async (id) => {
    try {
      const target = notifications.find((n) => n.id === id);
      const newPinStatus = !target.pinned;
      await axios.post(`${BASE_URL}/pin/${id}`, { pinned: newPinStatus });
      setNotifications((prev) =>
        prev.map((n) =>
          n.id === id ? { ...n, pinned: newPinStatus } : n
        )
      );
    } catch (err) {
      console.error("Failed to toggle pin:", err);
    }
  };

  // === 5️⃣ Clear all notifications ===
  const handleClearAll = async () => {
    try {
      await axios.delete(`${BASE_URL}/clear`);
      setNotifications([]);
    } catch (err) {
      console.error("Failed to clear notifications:", err);
    }
  };

  // === 6️⃣ On Drawer Open, fetch current notifications ===
  useEffect(() => {
    if (notificationDrawerOpen) {
      fetchAllNotifications();
    }
  }, [notificationDrawerOpen, fetchAllNotifications]);

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          p: 0,
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: 3, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Notifications
          </Typography>
          <IconButton
            onClick={() => setNotificationDrawerOpen(false)}
            size="small"
          >
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Notification List */}
      <Box sx={{ p: 2, flex: 1, overflowY: "auto", height: "calc(100vh - 160px)" }}>
        {notifications.length === 0 ? (
          <Typography variant="body2" sx={{ color: "text.secondary", textAlign: "center", mt: 4 }}>
            No notifications yet.
          </Typography>
        ) : (
          notifications.map((notification) => (
            <Paper
              key={notification.id}
              sx={{
                p: 2,
                mb: 2,
                border: notification.unread
                  ? "1px solid #1565C0"
                  : "1px solid #E2E8F0",
                backgroundColor: notification.unread ? "#F0F9FF" : "white",
                cursor: "pointer",
                "&:hover": { backgroundColor: "#F8FAFC" },
              }}
              onClick={() => handleMarkAsRead(notification.id)}
            >
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
                <Box
                  sx={{
                    width: 8,
                    height: 8,
                    borderRadius: "50%",
                    backgroundColor:
                      notification.type === "success"
                        ? "#10B981"
                        : notification.type === "warning"
                        ? "#F59E0B"
                        : "#1565C0",
                    mt: 1,
                  }}
                />
                <Box sx={{ flex: 1 }}>
                  <Typography variant="subtitle2" sx={{ fontWeight: 600, mb: 0.5 }}>
                    {notification.title}
                  </Typography>
                  <Typography variant="body2" sx={{ color: "text.secondary", mb: 1 }}>
                    {notification.message}
                  </Typography>
                  <Typography variant="caption" sx={{ color: "text.secondary" }}>
                    {notification.time}
                  </Typography>
                </Box>

                <Tooltip title={notification.pinned ? "Unpin" : "Pin"}>
                  <IconButton
                    size="small"
                    onClick={(e) => {
                      e.stopPropagation();
                      handleTogglePin(notification.id);
                    }}
                  >
                    {notification.pinned ? (
                      <PushPin fontSize="small" color="primary" />
                    ) : (
                      <PushPinOutlined fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>
            </Paper>
          ))
        )}
      </Box>

      {/* Footer Actions */}
      <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
        <Stack direction="row" spacing={1}>
          <Button
            fullWidth
            variant="outlined"
            onClick={fetchAllNotifications}
          >
            View All
          </Button>
          <Button
            fullWidth
            variant="outlined"
            color="error"
            startIcon={<DeleteSweep />}
            onClick={handleClearAll}
          >
            Clear
          </Button>
        </Stack>
      </Box>
    </Drawer>
  );
};

export default NotificationDrawer;

