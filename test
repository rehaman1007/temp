import React, { useMemo } from "react";
import { Box, Typography, Card, Stack, Chip } from "@mui/material";

import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
} from "recharts";

import { analyticsStyles as s } from "./RequestAnalyticsStyles";
import { warning } from "framer-motion";

// Assigned fixed colors to maintain consistency regardless of filtering
const COLORS = {
  add: "#d87093",
  modify: "#6a5acd",
  delete: "#7A0B0D",
  bar: "#6296cf",
};

const RequestAnalytics = ({ data = [], showDeleteRequest = false }) => {
  const { total, pieData } = useMemo(() => {
    const counts = { add: 0, modify: 0, delete: 0 };

    data.forEach((d) => {
      if (d.changeType === "ADD") counts.add++;
      if (d.changeType === "UPDATE") counts.modify++;
      if (d.changeType === "DELETE") counts.delete++;
    });

    // Build base data array
    const basePieData = [
      { name: "Add Requests", value: counts.add, color: COLORS.add, id: 0 },
      {
        name: "Modify Requests",
        value: counts.modify,
        color: COLORS.modify,
        id: 1,
      },
    ];

    // Conditionally add Delete Requests
    if (showDeleteRequest) {
      basePieData.push({
        name: "Delete Requests",
        value: counts.delete,
        color: COLORS.delete,
        id: 2,
      });
    }

    return {
      total: data.length,
      pieData: basePieData,
    };
  }, [data, showDeleteRequest]);

  const histogramData = useMemo(() => {
    const map = {};

    data.forEach((item) => {
      if (item.reqDate) {
        const date = new Date(item.reqDate).toLocaleDateString("en-GB");

        if (!map[date]) {
          map[date] = {
            date,
            pendingRequests: 0,
            addRequests: 0,
            updateRequests: 0,
            deleteRequests: 0,
            totalRequests: 0,
          };
        }

        if (item.reqStatus === "PENDING") {
          map[date].pendingRequests += 1;
          if (item.changeType === "ADD") map[date].addRequests += 1;
          if (item.changeType === "UPDATE") map[date].updateRequests += 1;
          if (item.changeType === "DELETE") map[date].deleteRequests += 1;
        }

        map[date].totalRequests += 1;
      }
    });

    return Object.values(map).sort((a, b) => {
      const [d1, m1, y1] = a.date.split("/").map(Number);
      const [d2, m2, y2] = b.date.split("/").map(Number);
      return new Date(y1, m1 - 1, d1) - new Date(y2, m2 - 1, d2);
    });
  }, [data]);

  const CustomTooltip = ({ active, payload, label }) => {
    if (active && payload?.length) {
      const d = payload[0].payload;
      return (
        <Box
          sx={{
            bgcolor: "#1e1e2f",
            p: 1.5,
            borderRadius: 1,
            color: "#fff",
            fontSize: 12,
          }}
        >
          <div>
            <b>Date:</b> {label}
          </div>
          <div>
            <b>Pending Requests:</b> {d.pendingRequests}
          </div>

          <div>
            <b>Add Requests:</b> {d.addRequests}
          </div>
          <div>
            <b>Modify Requests:</b> {d.updateRequests}
          </div>
          {showDeleteRequest && (
            <div>
              <b>Delete Requests:</b> {d.deleteRequests}
            </div>
          )}
        </Box>
      );
    }
    return null;
  };

  return (
    <Card sx={s.card}>
      <Typography sx={s.headerTitle}>Request Analytics Overview</Typography>
      <Typography variant="caption" sx={s.headerSubtitle}>
        Requests comparison by type and daily frequency
      </Typography>

      {total > 0 ? (
        <Box sx={s.wrapper}>
          {/* PIE SECTION */}
          <Box sx={s.pieWrapper}>
            <Box sx={s.pieChartBox}>
              <ResponsiveContainer>
                <PieChart>
                  <defs>
                    {/* Dynamic Gradients based on entry color */}
                    {pieData.map((p) => (
                      <linearGradient
                        key={p.id}
                        id={`gradient-${p.id}`}
                        x1="0"
                        y1="0"
                        x2="1"
                        y2="1"
                      >
                        <stop
                          stopColor={p.color}
                          stopOpacity={0.9}
                          offset="0%"
                        />
                        <stop
                          stopColor={p.color}
                          stopOpacity={0.5}
                          offset="100%"
                        />
                      </linearGradient>
                    ))}
                    <linearGradient
                      id="gradient-bar"
                      x1="0"
                      y1="0"
                      x2="1"
                      y2="1"
                    >
                      <stop
                        stopColor={COLORS.bar}
                        stopOpacity={0.9}
                        offset="0%"
                      />
                      <stop
                        stopColor={COLORS.bar}
                        stopOpacity={0.5}
                        offset="100%"
                      />
                    </linearGradient>
                  </defs>

                  <Pie
                    data={pieData}
                    cx="50%"
                    cy="50%"
                    innerRadius={55}
                    outerRadius={80}
                    paddingAngle={3}
                    dataKey="value"
                  >
                    {pieData.map((p) => (
                      <Cell key={p.id} fill={`url(#gradient-${p.id})`} />
                    ))}
                  </Pie>
                </PieChart>
              </ResponsiveContainer>

              <Box sx={s.pieCenterBox}>
                <Typography variant="caption" sx={s.pieCenterSubtitle}>
                  Total Requests
                </Typography>
                <Typography sx={s.pieCenterValue}>{total}</Typography>
              </Box>
            </Box>

            {/* Legend - Shows even if value is 0 */}
            <Stack direction="row" spacing={1.5} sx={s.legendRow}>
              {pieData.map((p) => (
                <Stack
                  key={p.name}
                  direction="row"
                  alignItems="center"
                  spacing={0.5}
                  sx={s.legendChipBox}
                >
                  <Box sx={s.legendColorDot(p.color)} />
                  <Typography variant="caption">{p.name}</Typography>
                  <Chip
                    label={p.value}
                    sx={{ bgcolor: p.color, color: "white" }}
                    size="small"
                  />
                </Stack>
              ))}
            </Stack>
          </Box>

          {/* BAR SECTION */}
          <Box sx={s.barChartArea}>
            <ResponsiveContainer>
              <BarChart data={histogramData}>
                <CartesianGrid
                  strokeDasharray="3 3"
                  stroke="rgba(255,255,255,0.3)"
                />
                <XAxis
                  dataKey="date"
                  stroke="white"
                  fontSize={10}
                  tickMargin={4}
                />
                <YAxis
                  stroke="white"
                  fontSize={10}
                  allowDecimals={false}
                  label={{
                    value: "Requests",
                    angle: -90,
                    position: "insideLeft",
                    fill: "white",
                    fontSize: 11,
                  }}
                />
                <Tooltip content={<CustomTooltip />} />
                <Bar
                  //dataKey="totalRequests"
                  dataKey="pendingRequests"
                  fill="url(#gradient-bar)"
                  radius={[6, 6, 0, 0]}
                />
              </BarChart>
            </ResponsiveContainer>

            {/* DISCLAIMER / LOGIC FOOTNOTE */}
            <Typography
              variant="caption"
              sx={{
                display: "block",
                fontStyle: "italic",
                textAlign: "center",
                color: "warning.dark",
                mb: 1,
                fontSize: "0.6rem",
              }}
            >
              * Represents the number of pending requests for that date and the
              classifaction of request type.
            </Typography>
          </Box>
        </Box>
      ) : (
        <Typography sx={{ p: 4, textAlign: "center" }}>
          No data to display
        </Typography>
      )}
    </Card>
  );
};

export default RequestAnalytics;
