function classificationFromComp1(comp1Val) {
  if (!comp1Val) return null;
  const ch = String(comp1Val)[0];
  if (ch === "1" || ch === "6") return "A";
  if (["2", "3", "4"].includes(ch)) return "L";
  if (ch === "5") return "M";
  if (ch === "7") return "I";
  if (ch === "8") return "E";
  return null;
}

function defBalTypeFromClassification(ac) {
  switch (ac) {
    case "A":
      return "D";
    case "L":
      return "C";
    case "M":
      return "M";
    case "I":
      return "C";
    case "E":
      return "D";
    default:
      return "";
  }
}

const descRegex = /^[A-Za-z0-9 .,"<>/&()=_-]*$/;

