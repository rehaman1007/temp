const rows = useMemo(() => {
  /* Track run order per process */
  const runSequenceMap = new Map();

  /* Sort processes by runId ascending */
  const sortedProcesses = [...processes].sort(
    (a, b) => (a.runId || 0) - (b.runId || 0),
  );

  return sortedProcesses.map((p) => {
    const key = `${p.processType}_${p.processId}`;

    const currentSeq = (runSequenceMap.get(key) || 0) + 1;

    runSequenceMap.set(key, currentSeq);

    const lastStage = p.stages?.at(-1);

    const latestRun =
      latestRunMap.get(key)?.runId === p.runId;

    const hasSummary =
      p.processType?.toUpperCase() === "DIFFERENCE" &&
      p.stages?.some(
        (s) =>
          s.stageStatus === StageStatus.COMPLETED &&
          SUMMARY_STAGES.has(s.stageId),
      );

    return {
      id: `${p.processType}_${p.processId}_${p.runId}`,

      processId: p.processId,

      processType: p.processType,

      /* FIXED DISPLAY NAME */
      processDisplayName:
        currentSeq > 1
          ? `${p.processType} (${getOrdinal(currentSeq)})`
          : p.processType,

      runId: p.runId,

      status: p.status,

      stageTitle: lastStage?.stageTitle ?? "N/A",

      stageIcon: lastStage?.stageIcon,

      startTime: p.processStartTime,

      endTime: p.processEndTime,

      raw: p,

      hasSummary,

      isLatestRun: latestRun,
    };
  });
}, [processes, latestRunMap]);