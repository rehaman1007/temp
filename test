import {
  alpha,
  Box,
  Chip,
  Paper,
  Stack,
  Typography,
  useTheme,
  Button,
  MenuItem,
  Select,
  TextField,
} from "@mui/material";
import { AutoAwesome, Storage, TableRows, Download } from "@mui/icons-material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";

const ResultGrid = ({
  results,
  loading,
  paginationModel,
  setPaginationModel,

  exportType,
  setExportType,

  tableName,
  setTableName,

  onExport,
  exportLoading,
}) => {
  const theme = useTheme();
  const rows = results?.rows || [];
  const columns = results?.columns || [];
  const total = results?.total || 0;

  return (
    <Paper
      elevation={0}
      sx={{
        height: "100%",
        borderRadius: 1,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          px: 2.5,
          py: 1.5,
          background: "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack direction="row" spacing={1} alignItems="center" flexWrap="wrap">
          <Select
            size="small"
            value={exportType}
            onChange={(e) => setExportType(e.target.value)}
            sx={{
              minWidth: 130,
              bgcolor: "white",
            }}
          >
            <MenuItem value="CSV">CSV</MenuItem>

            <MenuItem value="EXCEL">Excel</MenuItem>

            <MenuItem value="JSON">JSON</MenuItem>

            <MenuItem value="INSERT">INSERT</MenuItem>
          </Select>

          {exportType === "INSERT" && (
            <TextField
              size="small"
              placeholder="Table Name"
              value={tableName}
              onChange={(e) => setTableName(e.target.value)}
              sx={{
                width: 180,
                bgcolor: "white",
              }}
            />
          )}

          <Button
            size="small"
            variant="contained"
            startIcon={<Download />}
            onClick={onExport}
            disabled={
              exportLoading || loading || total === 0 || !results?.rows?.length
            }
          >
            Export
          </Button>
        </Stack>

        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          {/* LEFT */}
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Storage fontSize="small" />
            <Typography fontWeight={800}>Query Result Grid</Typography>
          </Stack>

          {/* RIGHT */}
          <Stack direction="row" spacing={1} flexWrap="wrap">
            <Chip
              size="small"
              icon={<TableRows />}
              label={`${rows.length} Rows`}
              sx={{
                bgcolor: "rgba(255,255,255,0.08)",
                color: "white",
              }}
            />

            <Chip
              size="small"
              icon={<AutoAwesome />}
              label={`${columns.length} Columns`}
              sx={{
                bgcolor: "rgba(255,255,255,0.08)",
                color: "white",
              }}
            />

            <Chip
              size="small"
              label={`Total : ${total}`}
              sx={{
                bgcolor: "rgba(255,255,255,0.08)",
                color: "white",
              }}
            />
          </Stack>
        </Stack>
      </Box>

      {/* GRID */}
      <Box
        sx={{
          flex: 1,
          // minHeight: 500,
        }}
      >
        <DataGrid
          rows={rows}
          columns={columns}
          rowCount={total}
          loading={loading}
          disableRowSelectionOnClick
          paginationMode="server"
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[10, 25, 50, 100]}
          slots={{
            toolbar: GridToolbar,
          }}
          getRowId={(row, index) =>
            row.ID ?? row.id ?? row.RN ?? `${index}-${JSON.stringify(row)}`
          }
          sx={{
            border: "none",
            fontSize: 13,
            bgcolor: "#ffffff",

            /**
             * HEADER
             */
            "& .MuiDataGrid-columnHeaders": {
              bgcolor: "#f8fafc",
              borderBottom: "1px solid #e5e7eb",
              fontWeight: 700,
              minHeight: "52px !important",
            },

            "& .MuiDataGrid-columnHeaderTitle": {
              fontWeight: 800,
              color: "#111827",
            },

            /**
             * ROWS
             */
            "& .MuiDataGrid-row": {
              transition: "background-color .15s ease",
            },

            "& .MuiDataGrid-row:hover": {
              bgcolor: alpha(theme.palette.primary.main, 0.04),
            },

            "& .MuiDataGrid-cell": {
              borderBottom: "1px solid #f1f5f9",

              display: "flex",
              alignItems: "center",
            },

            /**
             * FOOTER
             */
            "& .MuiDataGrid-footerContainer": {
              borderTop: "1px solid #e5e7eb",
              bgcolor: "#fafafa",
            },

            /**
             * TOOLBAR
             */
            "& .MuiDataGrid-toolbarContainer": {
              p: 1.2,
              borderBottom: "1px solid #f1f5f9",
              bgcolor: "#fcfcfc",
            },

            /**
             * PAGINATION
             */
            "& .MuiTablePagination-root": {
              color: "#374151",
            },

            /**
             * REMOVE FOCUS BORDER
             */
            "& .MuiDataGrid-cell:focus, & .MuiDataGrid-columnHeader:focus": {
              outline: "none",
            },

            "& .MuiDataGrid-cell:focus-within, & .MuiDataGrid-columnHeader:focus-within":
              {
                outline: "none",
              },

            /**
             * SCROLLBAR
             */
            "& ::-webkit-scrollbar": {
              width: 8,
              height: 8,
            },

            "& ::-webkit-scrollbar-thumb": {
              background: "rgba(100,116,139,0.35)",
              borderRadius: 20,
            },
          }}
        />
      </Box>
    </Paper>
  );
};

export default ResultGrid;
