import {
  Dialog,
  DialogContent,
  Grid,
  Box,
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Button,
} from "@mui/material";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

/* -------------------------------------------------------
   STEP LABEL + CONTENT (LEFT)
------------------------------------------------------- */

const ProcessStepItem = ({ stage, active, onClick }) => {
  const notStarted =
    !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
    ? "Started"
    : error
    ? "Failed"
    : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                ? theme.palette.success.main
                : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">
          {stage.stage.title}
        </Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button
            size="small"
            variant="contained"
            onClick={onClick}
          >
            <VisibilityOutlinedIcon fontSize="small" sx={{ mr: 1 }} />
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* -------------------------------------------------------
   MAIN DIALOG
------------------------------------------------------- */

const ProgressStepperDialog = ({
  open,
  stageDetails = [],
  activeStep = 0,
  onStageClick,
  onClose,
  children, // RIGHT SIDE CONTENT
}) => {
  return (
    <Dialog
      open={open}
      fullWidth
      maxWidth="lg"
      onClose={onClose}
      PaperProps={{
        sx: {
          height: "100vh",
          maxHeight: "100vh",
        },
      }}
    >
      <DialogContent
        sx={{
          height: "100%",
          p: 0,
          overflow: "hidden", // ❌ dialog itself never scrolls
        }}
      >
        <Grid container height="100%">
          {/* ==================================================
              LEFT COLUMN — SCROLLABLE STEPPER
          ================================================== */}
          <Grid
            item
            xs={4}
            sx={{
              height: "100%",
              borderRight: 1,
              borderColor: "divider",
              overflowY: "auto", // ✅ ONLY THIS SCROLLS
              p: 2,
            }}
          >
            <Stepper orientation="vertical" nonLinear>
              {stageDetails.map((stage, index) => (
                <Step key={index} active>
                  <ProcessStepItem
                    stage={stage}
                    active={index === activeStep}
                    onClick={() => onStageClick(index)}
                  />
                </Step>
              ))}
            </Stepper>
          </Grid>

          {/* ==================================================
              RIGHT COLUMN — FIXED CONTENT
          ================================================== */}
          <Grid
            item
            xs={8}
            sx={{
              height: "100%",
              p: 3,
              overflow: "hidden", // ❌ NEVER scroll
            }}
          >
            {children}
          </Grid>
        </Grid>
      </DialogContent>
    </Dialog>
  );
};

export default ProgressStepperDialog;