// src/hooks/useStreamApi.js
import { useEffect, useRef, useState, useCallback } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const useStreamApi = () => {
  const token = useSelector((state) => state.auth.token);
  const snackbar = useCustomSnackbar();
  const controllerRef = useRef(null);
  const [connected, setConnected] = useState(false);
  const [messages, setMessages] = useState([]);

  const startStream = useCallback(
    (url, { onMessage, onError, onOpen } = {}) => {
      if (controllerRef.current) controllerRef.current.abort();
      const controller = new AbortController();
      controllerRef.current = controller;
      setConnected(false);

      fetchEventSource(url, {
        method: "GET",
        headers: {
          Authorization: `Bearer ${token}`,
        },
        signal: controller.signal,

        onopen(response) {
          if (response.ok) {
            setConnected(true);
            onOpen?.(response);
          } else {
            console.error("Stream connection failed:", response.status);
            snackbar(`Stream failed: ${response.status}`, "error");
          }
        },

        onmessage(event) {
          if (event.event === "connected") {
            console.log("Connected:", event.data);
            return;
          }
          try {
            const data = JSON.parse(event.data);
            setMessages((prev) => [data, ...prev]);
            onMessage?.(data);
          } catch (err) {
            console.error("Stream parse error:", err);
          }
        },

        onerror(err) {
          console.error("Stream error:", err);
          setConnected(false);
          onError?.(err);
        },
      });
    },
    [token]
  );

  const stopStream = useCallback(() => {
    if (controllerRef.current) {
      controllerRef.current.abort();
      controllerRef.current = null;
      setConnected(false);
      console.log("Stream stopped.");
    }
  }, []);

  useEffect(() => {
    return () => stopStream(); // Cleanup on unmount
  }, [stopStream]);

  return { connected, messages, startStream, stopStream };
};

export default useStreamApi;

import React, { useEffect } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
} from "@mui/material";
import { Close } from "@mui/icons-material";
import useStreamApi from "../hooks/useStreamApi"; // ✅ import your hook

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
  setNotifications, // <- make sure you have a setter from parent
}) => {
  const { connected, startStream, stopStream } = useStreamApi();

  useEffect(() => {
    if (!notificationDrawerOpen) {
      stopStream();
      return;
    }

    startStream("/NS/notifications/stream", {
      onOpen: (res) => console.log("Stream opened", res),
      onMessage: (newNotification) => {
        setNotifications((prev) => [newNotification, ...prev]);
      },
      onError: (err) => {
        console.error("Notification stream error:", err);
      },
    });

    return () => stopStream();
  }, [notificationDrawerOpen, startStream, stopStream]);

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          p: 0,
        },
      }}
    >
      <Box sx={{ p: 3, borderBottom: "1px solid #E2E8F0" }}>
        <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Notifications {connected ? "(Live)" : ""}
          </Typography>
          <IconButton onClick={() => setNotificationDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      <Box sx={{ p: 2 }}>
        {notifications.map((notification) => (
          <Paper
            key={notification.id}
            sx={{
              p: 2,
              mb: 2,
              border: notification.unread ? "1px solid #1565C0" : "1px solid #E2E8F0",
              backgroundColor: notification.unread ? "#F0F9FF" : "white",
              cursor: "pointer",
              "&:hover": { backgroundColor: "#F8FAFC" },
            }}
          >
            <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
              <Box
                sx={{
                  width: 8,
                  height: 8,
                  borderRadius: "50%",
                  backgroundColor:
                    notification.type === "success"
                      ? "#10B981"
                      : notification.type === "warning"
                      ? "#F59E0B"
                      : "#1565C0",
                  mt: 1,
                }}
              />
              <Box sx={{ flex: 1 }}>
                <Typography variant="subtitle2" sx={{ fontWeight: 600, mb: 0.5 }}>
                  {notification.title}
                </Typography>
                <Typography variant="body2" sx={{ color: "text.secondary", mb: 1 }}>
                  {notification.message}
                </Typography>
                <Typography variant="caption" sx={{ color: "text.secondary" }}>
                  {notification.time}
                </Typography>
              </Box>
            </Box>
          </Paper>
        ))}
      </Box>

      <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
        <Button fullWidth variant="outlined">
          View All Notifications
        </Button>
      </Box>
    </Drawer>
  );
};

export default NotificationDrawer;