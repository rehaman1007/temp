import React from "react";
import {
  Box,
  Typography,
  Avatar,
  Slide,
  Paper,
  Stack,
  IconButton,
} from "@mui/material";
import NotificationsActiveIcon from "@mui/icons-material/NotificationsActive";
import { getIconComponent } from "../utils/IconUtils";
import { useSelector } from "react-redux";
import { formatRelativeTime } from "../utils/CommonUtilities";

const NotificationPopup = ({ popup, onOpenDrawer }) => {
  const menuItems = useSelector((state) => state.menus.menus);

  if (!popup) return null;

  /** Find menu icon & title */
  const menu = menuItems.find((m) => m.route === popup.linkUrl);
  const IconComp = getIconComponent(menu?.icon || "NotificationsActive");
  const menuTitle = menu?.title || "Crysta App";

  return (
    <Slide in={!!popup} direction="left" mountOnEnter unmountOnExit>
      <Paper
        onClick={onOpenDrawer}
        elevation={10}
        sx={{
          position: "fixed",
          top: 16,
          right: 16,
          zIndex: 3000,
          p: 2,
          pr: 2.5,
          borderRadius: 3,
          display: "flex",
          alignItems: "center",
          gap: 1.5,
          width: { xs: "90%", sm: 380 },
          backgroundColor: "rgba(255,255,255,0.7)",
          backdropFilter: "blur(10px)",
          cursor: "pointer",
          boxShadow: "0 8px 20px rgba(0,0,0,0.15)",
          transition: "all 0.25s ease",
          "&:hover": {
            transform: "scale(1.015)",
            boxShadow: "0 10px 24px rgba(0,0,0,0.22)",
          },
        }}
      >
        {/* ICON */}
        <Avatar
          sx={{
            bgcolor: "#5D3FD3",
            width: 44,
            height: 44,
          }}
        >
          <IconComp style={{ fontSize: 22 }} />
        </Avatar>

        {/* TEXTS */}
        <Box flex={1}>
          <Typography fontWeight={700} sx={{ mb: 0.2 }}>
            {menuTitle}
          </Typography>

          <Typography
            variant="body2"
            sx={{
              mb: 0.3,
              fontSize: "0.85rem",
              color: "text.primary",
            }}
            noWrap
          >
            {popup.message}
          </Typography>

          <Typography variant="caption" color="text.secondary">
            {formatRelativeTime(popup.createdAt || popup.receivedAt)}
          </Typography>
        </Box>
      </Paper>
    </Slide>
  );
};

export default NotificationPopup;