package com.fincore.transactions_service.controller;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import com.fincore.transactions_service.service.AdminSupportService;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.MediaType;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.security.Principal;
import java.util.Map;

@Slf4j
@RestController
@RequestMapping("/api/admin-support")
@RequiredArgsConstructor
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    /**
     * COMMAND EXECUTION
     */
    @PostMapping("/admin-execute")
    public Map<String, Object> executeAdminSql(
            @RequestBody AdminSupportDTO dto,
            Principal principal,
            HttpServletRequest request
    ) {

        String userId =
                principal != null
                        ? principal.getName()
                        : "UNKNOWN";

        log.info(
                "ADMIN SQL EXECUTE REQUEST | userId={} | page={} | size={}",
                userId,
                dto.getPage(),
                dto.getSize()
        );

        return adminSupportService.executeAdminSql(
                dto,
                userId,
                request
        );
    }

    /**
     * FILE UPLOAD
     */
    @PostMapping(
            value = "/upload-script",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public Map<String, Object> uploadScript(
            @RequestParam("file") MultipartFile file,
            Principal principal,
            HttpServletRequest request
    ) {

        String userId =
                principal != null
                        ? principal.getName()
                        : "UNKNOWN";

        log.info(
                "UPLOAD SCRIPT REQUEST RECEIVED | userId={}",
                userId
        );

        return adminSupportService.uploadSqlFile(
                file,
                userId,
                request
        );
    }

    /**
     * JOB STATUS
     */
    @GetMapping("/job-status/{jobId}")
    public Map<String, Object> getJobStatus(
            @PathVariable String jobId
    ) {

        return adminSupportService.getJobStatus(jobId);
    }
}


