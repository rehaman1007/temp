import { useState, useRef, useMemo } from "react";
import {
  TextField,
  Popper,
  Paper,
  List,
  ListItemButton,
  Box,
  Typography,
} from "@mui/material";

/*
  Allowed Token:
  $G{{VAR_NAME}}
*/

const TOKEN_REGEX = /\$G\{\{([A-Z0-9_]+)\}\}/gi;

export default function ExpressionEditorWithVariables({
  value,
  onChange,
  globals = [],
  placeholder,
}) {
  const inputRef = useRef(null);
  const anchorRef = useRef(null);

  const [open, setOpen] = useState(false);
  const [searchText, setSearchText] = useState("");

  /* ---------------- GLOBAL LOOKUP ---------------- */

  const globalNames = useMemo(
    () => globals.map((g) => g.name.toUpperCase()),
    [globals],
  );

  /* ---------------- PARSE TOKENS ---------------- */

  const parsed = useMemo(() => {
    const parts = [];
    let lastIndex = 0;

    for (const match of value.matchAll(TOKEN_REGEX)) {
      const start = match.index;
      const full = match[0];
      const name = match[1];

      if (start > lastIndex) {
        parts.push({
          type: "text",
          value: value.slice(lastIndex, start),
        });
      }

      parts.push({
        type: "var",
        value: full,
        valid: globalNames.includes(name.toUpperCase()),
      });

      lastIndex = start + full.length;
    }

    if (lastIndex < value.length) {
      parts.push({
        type: "text",
        value: value.slice(lastIndex),
      });
    }

    return parts;
  }, [value, globalNames]);

  /* ---------------- INPUT HANDLER ---------------- */

  const handleChange = (e) => {
    const val = e.target.value;
    const cursor = e.target.selectionStart;

    onChange(val);

    const before = val.slice(0, cursor);
    const match = before.match(/\$G\{\{([A-Z0-9_]*)$/i);

    if (match) {
      setSearchText(match[1] || "");
      setOpen(true);
    } else {
      setOpen(false);
    }
  };

  /* ---------------- INSERT VARIABLE ---------------- */

  const insertVariable = (v) => {
    const input = inputRef.current;
    const cursor = input.selectionStart;

    const before = value.slice(0, cursor);
    const after = value.slice(cursor);

    const replaced = before.replace(
      /\$G\{\{([A-Z0-9_]*)$/i,
      `$G{{${v.name}}}`,
    );

    const newValue = replaced + after;

    onChange(newValue);
    setOpen(false);

    setTimeout(() => {
      const pos = replaced.length;
      input.focus();
      input.setSelectionRange(pos, pos);
    }, 0);
  };

  /* ---------------- FILTERED LIST ---------------- */

  const filteredGlobals = globals.filter((g) =>
    g.name.toUpperCase().includes(searchText.toUpperCase()),
  );

  const hasInvalid = parsed.some(
    (p) => p.type === "var" && !p.valid,
  );

  /* ---------------- UI ---------------- */

  return (
    <Box ref={anchorRef}>
      {/* Highlight Layer */}
      <Box
        sx={{
          position: "absolute",
          pointerEvents: "none",
          whiteSpace: "pre-wrap",
          wordBreak: "break-word",
          fontFamily: "monospace",
          padding: "16.5px 14px",
          width: "100%",
          minHeight: 84,
          color: "transparent",
        }}
      >
        {parsed.map((p, i) =>
          p.type === "text" ? (
            <span key={i}>{p.value}</span>
          ) : (
            <span
              key={i}
              style={{
                color: p.valid ? "#2e7d32" : "#d32f2f",
                fontWeight: 600,
              }}
            >
              {p.value}
            </span>
          ),
        )}
      </Box>

      {/* Real Input */}
      <TextField
        fullWidth
        multiline
        rows={3}
        placeholder={placeholder}
        value={value}
        onChange={handleChange}
        inputRef={inputRef}
        sx={{
          fontFamily: "monospace",
        }}
        helperText={
          hasInvalid
            ? "Invalid global variable detected"
            : "Use format: $G{{VARIABLE_NAME}}"
        }
        error={hasInvalid}
      />

      {/* Suggestion Popper */}
      <Popper
        open={open && filteredGlobals.length > 0}
        anchorEl={anchorRef.current}
        placement="bottom-start"
        disablePortal
      >
        <Paper sx={{ width: 260, maxHeight: 220, overflow: "auto" }}>
          <List dense>
            {filteredGlobals.map((v) => (
              <ListItemButton
                key={v.name}
                onClick={() => insertVariable(v)}
              >
                <Typography fontFamily="monospace">
                  {v.name}
                </Typography>
              </ListItemButton>
            ))}
          </List>
        </Paper>
      </Popper>
    </Box>
  );
}