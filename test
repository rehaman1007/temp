package com.fincore.transactions_service.controller;

import java.util.Map;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.fincore.transactions_service.service.AdminSupportService;

import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/admin-support")
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    /**
     * Executes direct SQL operations from the Admin Console.
     * Handles both single SELECT queries (returning a DataGrid)
     * and multiple DDL/DML statements (returning a log).
     */
    @PostMapping("/admin-execute")
    public Map<String, Object> executeAdminSql(@RequestBody @Valid AdminSupportDTO adminSupportDTO) {
        log.info("Admin SQL request received for execution.");
        return adminSupportService.executeAdminSql(adminSupportDTO);
    }
}

package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.validation.Valid;

import java.util.Map;

public interface AdminSupportService {
    Map<String, Object> executeAdminSql(@Valid AdminSupportDTO adminSupportDTO);
}


package com.fincore.transactions_service.dto;

import jakarta.validation.constraints.NotBlank;
import lombok.Data;

@Data
public class AdminSupportDTO {

    /**
     * Raw SQL query string sent from the React editor.
     * Use @NotBlank to ensure we don't process empty strings.
     */
    @NotBlank(message = "SQL query cannot be empty")
    private String sql;

    /**
     * Current page index for server-side pagination (starts at 0)
     */
    private Integer page;

    /**
     * Number of rows to fetch per page
     */
    private Integer size;
}
