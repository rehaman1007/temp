import { useState, useRef } from "react";
import {
  TextField,
  Popper,
  Paper,
  List,
  ListItemButton,
} from "@mui/material";

/**
 * Inline expression editor with variable suggestions
 * Triggers:
 *  - G.
 *  - {{
 */
export default function ExpressionEditorWithVariables({
  value,
  onChange,
  globals = [],
  placeholder,
}) {
  const inputRef = useRef(null);
  const [open, setOpen] = useState(false);
  const [anchorEl, setAnchorEl] = useState(null);
  const [trigger, setTrigger] = useState(null); // "G." or "{{"

  const handleChange = (e) => {
    const val = e.target.value;
    const cursor = e.target.selectionStart;

    onChange(val);

    const lastTwo = val.slice(cursor - 2, cursor);

    if (lastTwo === "G.") {
      setTrigger("G.");
      setAnchorEl(inputRef.current);
      setOpen(true);
      return;
    }

    if (lastTwo === "{{") {
      setTrigger("{{");
      setAnchorEl(inputRef.current);
      setOpen(true);
      return;
    }

    setOpen(false);
  };

  const insertVariable = (variable) => {
    const textarea = inputRef.current.querySelector("textarea");
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;

    let insertText = "";

    if (trigger === "G.") {
      insertText = variable.name;
    } else if (trigger === "{{") {
      insertText = `G.${variable.name}}}`;
    }

    const newValue =
      value.substring(0, start) +
      insertText +
      value.substring(end);

    onChange(newValue);

    setOpen(false);

    setTimeout(() => {
      textarea.focus();
      textarea.setSelectionRange(
        start + insertText.length,
        start + insertText.length
      );
    }, 0);
  };

  return (
    <>
      <TextField
        fullWidth
        multiline
        rows={3}
        inputRef={inputRef}
        value={value}
        placeholder={placeholder}
        onChange={handleChange}
      />

      <Popper open={open} anchorEl={anchorEl} placement="bottom-start">
        <Paper sx={{ width: 260, maxHeight: 220, overflow: "auto" }}>
          <List dense>
            {globals.map((v) => (
              <ListItemButton
                key={v.name}
                onClick={() => insertVariable(v)}
              >
                {v.name} ({v.dataType})
              </ListItemButton>
            ))}
          </List>
        </Paper>
      </Popper>
    </>
  );
}

{form.mode === "EXPRESSION" && (
  <>
    <ExpressionEditorWithVariables
      globals={globals}
      value={form.expression}
      placeholder="e.g. #{ 1000 * G.USD_RATE }"
      onChange={(v) => update("expression", v)}
    />

    {errors.expression && (
      <Typography color="error" variant="caption">
        {errors.expression}
      </Typography>
    )}
  </>
)}