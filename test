import React, {
  useState,
  useCallback,
  useEffect,
  useMemo,
} from "react";

import { useSelector } from "react-redux";

import { Box } from "@mui/material";

import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

import dayjs from "dayjs";
import debounce from "lodash/debounce";

import LedgerForm from "./components/LedgerForm";
import LedgerDataGrid from "./components/LedgerDataGrid";

import { getPermissions } from "../../utils/CommonUtilities";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const DEFAULT_PAGE_SIZE = 20;

const LedgerWiseEnquiry = () => {
  const { callApi } = useApi();

  const showSnackBar = useCustomSnackbar();

  const user = useSelector((state) => state.auth.user);

  const menu = useSelector(
    (state) => state.menus.selectedMenuItem,
  );

  const permissions = getPermissions(menu);

  const hasWholeBank = !!permissions.wholebank;

  const hasCircle =
    user?.isCircle === "Y" || !!permissions.circle;

  const isCircleUser =
    user?.isCircle === "Y" && !hasWholeBank;

  // ================= MASTER DATA =================

  const [circles, setCircles] = useState([]);

  const [currencies, setCurrencies] = useState([]);

  const [sourceOptions, setSourceOptions] = useState([]);

  const [etlDate, setEtlDate] = useState(null);

  // ================= GRID DATA =================

  const [rows, setRows] = useState([]);

  const [rowCount, setRowCount] = useState(0);

  // ================= LOADING =================

  const [loading, setLoading] = useState(false);

  const [exporting, setExporting] = useState(false);

  // ================= GRID CONTROLS =================

  const [paginationModel, setPaginationModel] =
    useState({
      page: 0,
      pageSize: DEFAULT_PAGE_SIZE,
    });

  const [sortModel, setSortModel] = useState([
    {
      field: "transactionDate",
      sort: "desc",
    },
  ]);

  const [filterModel, setFilterModel] = useState({
    items: [],
  });

  // ================= INITIAL FILTERS =================

  const initialState = useMemo(
    () => ({
      level: hasWholeBank
        ? "BANK"
        : isCircleUser
          ? "CIRCLE"
          : "BRANCH",

      circle: hasWholeBank
        ? "ALL"
        : user?.circleCode,

      branches:
        user?.isCircle === "N" && !hasWholeBank
          ? [user?.branchCode]
          : ["ALL"],

      currencies: "ALL",

      sourceFlags: [],

      cgl: "",

      fromDate: null,

      toDate: null,
    }),
    [
      hasWholeBank,
      isCircleUser,
      user?.circleCode,
      user?.branchCode,
      user?.isCircle,
    ],
  );

  const [filters, setFilters] = useState(initialState);

  const [searchQuery, setSearchQuery] =
    useState(null);

  // ================= FETCH MASTERS =================

  const fetchMasters = useCallback(async () => {
    try {
      const [dateRes, currRes, flagRes] =
        await Promise.all([
          callApi(
            "/PS/file/fincore-date",
            {},
            "GET",
          ),

          callApi(
            "/CM/common-master/currency-code-name-only",
            null,
            "GET",
          ),

          callApi(
            "/CM/common-master/source-flag",
            null,
            "GET",
          ),
        ]);

      if (dateRes?.data?.etlDate) {
        setEtlDate(
          dayjs(
            dateRes.data.etlDate,
            "DD-MM-YYYY",
          ),
        );
      }

      const formattedCurrencies =
        currRes?.data?.map(
          (c) =>
            `${c.currencyCode} (${c.currencyName})`,
        ) || [];

      setCurrencies(
        formattedCurrencies.sort((a, b) =>
          a.localeCompare(b),
        ),
      );

      if (flagRes?.data) {
        setSourceOptions(flagRes.data);

        setFilters((prev) => ({
          ...prev,
          sourceFlags: flagRes.data,
        }));
      }

      if (hasWholeBank) {
        const circleRes = await callApi(
          "/CM/common-master/circle-codes",
          null,
          "GET",
        );

        setCircles(circleRes?.data || []);
      }
    } catch (error) {
      showSnackBar(
        "Failed to load master configuration",
        "error",
      );
    }
  }, [
    callApi,
    hasWholeBank,
    showSnackBar,
  ]);

  useEffect(() => {
    fetchMasters();
  }, [fetchMasters]);

  // ================= RESET PAGE =================

  useEffect(() => {
    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));
  }, [sortModel, filterModel, searchQuery]);

  // ================= FILTERED FLAGS =================

  const selectedSourceOptions = useMemo(() => {
    if (!filters?.sourceFlags?.length) {
      return sourceOptions;
    }

    const selectedIds = new Set(
      filters.sourceFlags.map((f) => f.flagId),
    );

    return sourceOptions.filter((option) =>
      selectedIds.has(option.flagId),
    );
  }, [filters.sourceFlags, sourceOptions]);

  // ================= PAYLOAD =================

  const buildPayload = useCallback(() => {
    if (!searchQuery) return null;

    const gridFilters = filterModel.items
      .filter(
        (item) =>
          item.field &&
          item.operator &&
          item.value !== undefined &&
          item.value !== null &&
          item.value !== "",
      )
      .map((item) => ({
        field: item.field,
        operator: item.operator,
        value: item.value,
      }));

    return {
      circle:
        searchQuery.circle === "ALL"
          ? "ALL"
          : searchQuery.circle,

      cgl: searchQuery.cgl.split(" - ")[0],

      currencies:
        searchQuery.currencies === "ALL"
          ? "ALL"
          : searchQuery.currencies.split(
              " (",
            )[0],

      branches:
        searchQuery.branches.includes("ALL")
          ? ["ALL"]
          : searchQuery.branches.map((b) =>
              b.split("-")[0],
            ),

      sourceFlags:
        searchQuery.sourceFlags.map(
          (f) => f.flagId,
        ),

      fromDate:
        searchQuery.fromDate.format(
          "DD/MM/YYYY",
        ),

      toDate:
        searchQuery.toDate.format(
          "DD/MM/YYYY",
        ),

      page: paginationModel.page,

      size: paginationModel.pageSize,

      sortField:
        sortModel?.[0]?.field ||
        "transactionDate",

      sortOrder:
        sortModel?.[0]?.sort || "desc",

      gridFilters,
    };
  }, [
    searchQuery,
    paginationModel,
    sortModel,
    filterModel,
  ]);

  // ================= FETCH =================

  const fetchRows = useCallback(async () => {
    const payload = buildPayload();

    if (!payload) return;

    try {
      setLoading(true);

      const res = await callApi(
        "/ES/ledger-enquiries/search",
        payload,
        "POST",
      );

      setRows(res?.data?.content || []);

      setRowCount(
        res?.data?.totalElements || 0,
      );
    } catch (error) {
      showSnackBar(
        "Enquiry failed",
        "error",
      );
    } finally {
      setLoading(false);
    }
  }, [
    callApi,
    buildPayload,
    showSnackBar,
  ]);

  // ================= DEBOUNCED FETCH =================

  const debouncedFetch = useMemo(
    () =>
      debounce(() => {
        fetchRows();
      }, 350),
    [fetchRows],
  );

  useEffect(() => {
    debouncedFetch();

    return () => debouncedFetch.cancel();
  }, [debouncedFetch]);

  // ================= SEARCH =================

  const handleSearch = () => {
    if (
      !filters.cgl ||
      !filters.fromDate ||
      !filters.toDate
    ) {
      showSnackBar(
        "Please fill all required fields",
        "warning",
      );

      return;
    }

    if (
      filters.fromDate.isAfter(filters.toDate)
    ) {
      showSnackBar(
        "From date cannot be greater than To date",
        "warning",
      );

      return;
    }

    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));

    setSearchQuery({ ...filters });
  };

  // ================= RESET =================

  const handleReset = () => {
    setFilters(initialState);

    setSearchQuery(null);

    setRows([]);

    setRowCount(0);

    setPaginationModel({
      page: 0,
      pageSize: DEFAULT_PAGE_SIZE,
    });

    setSortModel([
      {
        field: "transactionDate",
        sort: "desc",
      },
    ]);

    setFilterModel({
      items: [],
    });
  };

  // ================= EXPORT =================

  const handleExcelExport = async () => {
    const payload = buildPayload();

    if (!payload) return;

    try {
      setExporting(true);

      const response = await callApi(
        "/ES/ledger-enquiries/export",
        {
          ...payload,
          page: 0,
          size: 100000,
        },
        "POST",
        {
          responseType: "blob",
        },
      );

      const url =
        window.URL.createObjectURL(
          new Blob([response.data]),
        );

      const link =
        document.createElement("a");

      link.href = url;

      link.setAttribute(
        "download",
        `Ledger_${
          searchQuery.cgl.split(" - ")[0]
        }_${dayjs().format(
          "YYYYMMDD",
        )}.xlsx`,
      );

      document.body.appendChild(link);

      link.click();

      link.remove();
    } catch (error) {
      showSnackBar(
        "Export failed",
        "error",
      );
    } finally {
      setExporting(false);
    }
  };

  return (
    <LocalizationProvider
      dateAdapter={AdapterDayjs}
    >
      <Box
        sx={{
          p: 2.5,
          bgcolor: "#f5f7fb",
          minHeight: "100vh",
        }}
      >
        <LedgerForm
          filters={filters}
          onFilterChange={(field, value) =>
            setFilters((prev) => ({
              ...prev,
              [field]: value,
            }))
          }
          onReset={handleReset}
          onFetch={handleSearch}
          permissions={{
            hasWholeBank,
            hasCircle,
          }}
          user={user}
          circles={circles}
          currencies={currencies}
          sourceOptions={sourceOptions}
          etlDate={etlDate}
        />

        <LedgerDataGrid
          rows={rows}
          loading={loading}
          rowCount={rowCount}
          paginationModel={paginationModel}
          setPaginationModel={
            setPaginationModel
          }
          sortModel={sortModel}
          setSortModel={setSortModel}
          filterModel={filterModel}
          setFilterModel={setFilterModel}
          onExcelExport={
            handleExcelExport
          }
          exporting={exporting}
          selectedCurrency={
            searchQuery?.currencies ||
            "ALL"
          }
          selectedCircle={
            searchQuery?.circle || "ALL"
          }
          circles={circles}
          sourceOptions={
            selectedSourceOptions
          }
          searchPerformed={!!searchQuery}
        />
      </Box>
    </LocalizationProvider>
  );
};

export default LedgerWiseEnquiry;

import React, { useMemo } from "react";

import {
  Box,
  Typography,
  Button,
  CircularProgress,
  Stack,
  Chip,
} from "@mui/material";

import {
  DataGrid,
  GridOverlay,
} from "@mui/x-data-grid";

import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import FileDownloadIcon from "@mui/icons-material/FileDownload";

import dayjs from "dayjs";

const formatAmount = (value) =>
  new Intl.NumberFormat("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value || 0);

const LedgerDataGrid = ({
  rows,
  loading,
  rowCount,

  paginationModel,
  setPaginationModel,

  sortModel,
  setSortModel,

  filterModel,
  setFilterModel,

  onExcelExport,
  exporting,

  selectedCurrency,
  selectedCircle,

  circles,
  sourceOptions,

  searchPerformed,
}) => {
  // ================= EMPTY STATE =================

  const EmptyOverlay = () => (
    <GridOverlay>
      <Stack
        spacing={1.5}
        alignItems="center"
      >
        <ErrorOutlineIcon
          sx={{
            fontSize: 48,
            color: "text.secondary",
          }}
        />

        <Typography
          variant="h6"
          fontWeight={700}
        >
          {searchPerformed
            ? "No Records Found"
            : "Start Searching"}
        </Typography>

        <Typography
          variant="body2"
          color="text.secondary"
        >
          {searchPerformed
            ? "No matching transactions available"
            : "Apply filters and fetch transactions"}
        </Typography>
      </Stack>
    </GridOverlay>
  );

  // ================= COLUMNS =================

  const transactionColumns = useMemo(() => {
    const cols = [
      {
        field: "transactionId",
        headerName: "Txn ID",
        width: 120,
        filterable: false,
      },

      {
        field: "transactionDate",
        headerName: "Date",
        width: 130,

        valueFormatter: ({
          value,
        }) =>
          value
            ? dayjs(value).format(
                "DD/MM/YYYY",
              )
            : "-",
      },

      {
        field: "branchName",
        headerName: "Branch",
        width: 220,

        renderCell: (params) => (
          <Box sx={{ py: 0.5 }}>
            <Typography
              variant="body2"
              fontWeight={700}
            >
              {params.row.branchCode}
            </Typography>

            <Typography
              variant="caption"
              color="text.secondary"
            >
              {params.row.branchName}
            </Typography>
          </Box>
        ),
      },

      {
        field: "narration",
        headerName: "Narration",
        flex: 1.4,
        minWidth: 260,
      },

      {
        field: "debitAmount",
        headerName: "Debit",
        width: 160,
        type: "number",

        align: "right",
        headerAlign: "right",

        valueFormatter: ({
          value,
        }) => formatAmount(value),
      },

      {
        field: "creditAmount",
        headerName: "Credit",
        width: 160,
        type: "number",

        align: "right",
        headerAlign: "right",

        valueFormatter: ({
          value,
        }) => formatAmount(value),
      },

      {
        field: "sourceFlag",
        headerName: "Source",
        width: 180,
        type: "singleSelect",

        valueOptions:
          sourceOptions?.map((flag) => ({
            value: flag.flagId,
            label: flag.flagName,
          })) || [],

        valueFormatter: ({
          value,
        }) => {
          const matched =
            sourceOptions?.find(
              (flag) =>
                flag.flagId === value,
            );

          return (
            matched?.flagName ||
            value ||
            "-"
          );
        },
      },
    ];

    if (selectedCircle === "ALL") {
      cols.splice(2, 0, {
        field: "circleName",
        headerName: "Circle",
        width: 180,
      });
    }

    if (selectedCurrency === "ALL") {
      cols.splice(4, 0, {
        field: "currencyName",
        headerName: "Currency",
        width: 180,

        renderCell: (params) => (
          <Box sx={{ py: 0.5 }}>
            <Typography
              variant="body2"
              fontWeight={700}
            >
              {params.row.currency}
            </Typography>

            <Typography
              variant="caption"
              color="text.secondary"
            >
              {params.row.currencyName}
            </Typography>
          </Box>
        ),
      });
    }

    return cols;
  }, [
    sourceOptions,
    selectedCircle,
    selectedCurrency,
  ]);

  return (
    <Box sx={{ width: "100%", mt: 2 }}>
      <Box
        sx={{
          p: 2.5,

          borderRadius: 4,

          bgcolor: "#fff",

          border:
            "1px solid rgba(0,0,0,0.06)",

          boxShadow:
            "0 2px 12px rgba(0,0,0,0.06)",

          display: "flex",
          flexDirection: "column",
          gap: 2,
        }}
      >
        {/* HEADER */}

        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
        >
          <Stack
            direction="row"
            spacing={1.5}
            alignItems="center"
          >
            <Typography
              variant="h6"
              fontWeight={800}
            >
              Transactions Ledger
            </Typography>

            <Chip
              size="small"
              label={`${rowCount.toLocaleString()} Records`}
              sx={{
                fontWeight: 700,
              }}
            />
          </Stack>

          <Button
            variant="contained"
            startIcon={
              exporting ? (
                <CircularProgress
                  size={16}
                  color="inherit"
                />
              ) : (
                <FileDownloadIcon />
              )
            }
            disabled={
              !rowCount ||
              loading ||
              exporting
            }
            onClick={onExcelExport}
            sx={{
              textTransform: "none",
              borderRadius: 2,
              fontWeight: 700,
            }}
          >
            {exporting
              ? "Preparing..."
              : "Export"}
          </Button>
        </Stack>

        {/* GRID */}

        <Box
          sx={{
            height:
              "calc(100vh - 320px)",
            minHeight: 520,
          }}
        >
          <DataGrid
            rows={rows}
            columns={transactionColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) =>
              row.transactionId
            }

            pagination
            paginationMode="server"

            sortingMode="server"

            filterMode="server"

            paginationModel={
              paginationModel
            }

            onPaginationModelChange={
              setPaginationModel
            }

            sortModel={sortModel}

            onSortModelChange={
              setSortModel
            }

            filterModel={filterModel}

            onFilterModelChange={
              setFilterModel
            }

            pageSizeOptions={[
              10,
              20,
              50,
              100,
            ]}

            disableRowSelectionOnClick

            disableDensitySelector

            rowHeight={58}

            rowBufferPx={400}

            columnBufferPx={300}

            slots={{
              noRowsOverlay:
                EmptyOverlay,
            }}

            slotProps={{
              loadingOverlay: {
                variant:
                  "linear-progress",
              },
            }}

            sx={{
              borderRadius: 3,

              border:
                "1px solid rgba(0,0,0,0.08)",

              bgcolor: "#fff",

              "& .MuiDataGrid-columnHeaders":
                {
                  bgcolor: "#f8fafc",

                  borderBottom:
                    "1px solid rgba(0,0,0,0.08)",

                  position: "sticky",

                  top: 0,

                  zIndex: 10,
                },

              "& .MuiDataGrid-columnHeaderTitle":
                {
                  fontWeight: 800,
                },

              "& .MuiDataGrid-row:nth-of-type(even)":
                {
                  backgroundColor:
                    "rgba(0,0,0,0.012)",
                },

              "& .MuiDataGrid-row:hover":
                {
                  backgroundColor:
                    "rgba(25,118,210,0.04)",
                },

              "& .MuiDataGrid-cell:focus":
                {
                  outline: "none",
                },

              "& .MuiDataGrid-columnHeader:focus":
                {
                  outline: "none",
                },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default LedgerDataGrid;

import React, {
  useState,
  useCallback,
  useMemo,
  useEffect,
} from "react";

import {
  Card,
  CardContent,
  TextField,
  Button,
  Autocomplete,
  Checkbox,
  Typography,
  Stack,
  Box,
  IconButton,
  Grid,
  InputAdornment,
  Paper,
  Collapse,
  Chip,
  Divider,
} from "@mui/material";

import { DatePicker } from "@mui/x-date-pickers";

import debounce from "lodash/debounce";

import dayjs from "dayjs";

// ================= ICONS =================

import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SearchIcon from "@mui/icons-material/Search";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import DeleteSweepIcon from "@mui/icons-material/DeleteSweep";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import DateRangeIcon from "@mui/icons-material/DateRange";
import AccountTreeIcon from "@mui/icons-material/AccountTree";
import CurrencyRupeeIcon from "@mui/icons-material/CurrencyRupee";

// ================= CUSTOM =================

import useApi from "../../../hooks/useApi";

import CustomChip from "../../../utils/CustomChip";

const LedgerForm = ({
  filters,
  onFilterChange,
  onReset,
  onFetch,

  permissions,
  user,

  circles,
  currencies,

  sourceOptions,

  etlDate,
}) => {
  const { callApi } = useApi();

  const { hasWholeBank, hasCircle } =
    permissions;

  // ================= STATES =================

  const [branches, setBranches] =
    useState([]);

  const [cgls, setCgls] = useState([]);

  const [viewBranchList, setViewBranchList] =
    useState(false);

  const [loading, setLoading] = useState({
    branch: false,
    cgl: false,
  });

  // ================= DATES =================

  const minLimit = dayjs("31/03/2026");

  const maxLimit = etlDate || dayjs();

  // ================= VISIBILITY =================

  const isCircleVisible = hasWholeBank;

  const isBranchVisible =
    (hasWholeBank &&
      filters.circle !== "ALL") ||
    (user?.isCircle === "Y" &&
      !hasWholeBank);

  const hasSelectedBranches =
    !filters.branches.includes("ALL") &&
    filters.branches.length > 0;

  // ================= SEARCH =================

  const searchLogic = useCallback(
    async (type, term) => {
      if (!term || term.length < 3)
        return;

      try {
        setLoading((prev) => ({
          ...prev,
          [type]: true,
        }));

        const circleParam =
          hasWholeBank &&
          filters.circle !== "ALL"
            ? `&circleCode=${filters.circle}`
            : !hasWholeBank
              ? `&circleCode=${user.circleCode}`
              : "";

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
                term,
              )}${circleParam}`
            : `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(
                term,
              )}`;

        const res = await callApi(
          url,
          null,
          "GET",
        );

        if (res?.data) {
          const options = res.data.map(
            (item) =>
              type === "branch"
                ? `${item.code}-${item.name}`
                : `${item.cglNumber} - ${item.description}`,
          );

          if (type === "branch") {
            setBranches(options);
          } else {
            setCgls(options);
          }
        }
      } catch (error) {
        console.error(error);
      } finally {
        setLoading((prev) => ({
          ...prev,
          [type]: false,
        }));
      }
    },
    [
      callApi,
      user,
      hasWholeBank,
      filters.circle,
    ],
  );

  const fetchSearchData = useMemo(
    () =>
      debounce((type, value) => {
        searchLogic(type, value);
      }, 350),
    [searchLogic],
  );

  useEffect(() => {
    return () =>
      fetchSearchData.cancel();
  }, [fetchSearchData]);

  // ================= BRANCH HANDLING =================

  const handleBranchChange = (value) => {
    const clickedAll =
      value.includes("ALL") &&
      !filters.branches.includes("ALL");

    const isEmpty = value.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("branches", ["ALL"]);

      setViewBranchList(false);

      return;
    }

    const filteredValues = value.filter(
      (v) => v !== "ALL",
    );

    onFilterChange(
      "branches",
      filteredValues,
    );
  };

  const removeBranch = (
    branchToRemove,
  ) => {
    const updated =
      filters.branches.filter(
        (b) => b !== branchToRemove,
      );

    if (!updated.length) {
      onFilterChange("branches", [
        "ALL",
      ]);

      setViewBranchList(false);
    } else {
      onFilterChange(
        "branches",
        updated,
      );
    }
  };

  // ================= SECTION HEADER =================

  const SectionHeader = ({
    icon,
    title,
  }) => (
    <Stack
      direction="row"
      spacing={1}
      alignItems="center"
      sx={{ mb: 2 }}
    >
      <Box
        sx={{
          width: 30,
          height: 30,

          borderRadius: 2,

          display: "flex",
          alignItems: "center",
          justifyContent: "center",

          bgcolor:
            "rgba(25,118,210,0.08)",

          color: "primary.main",
        }}
      >
        {icon}
      </Box>

      <Typography
        variant="subtitle2"
        sx={{
          fontWeight: 800,
          letterSpacing: 0.3,
        }}
      >
        {title}
      </Typography>
    </Stack>
  );

  return (
    <Box sx={{ mb: 2 }}>
      <Card
        sx={{
          borderRadius: 4,

          border:
            "1px solid rgba(0,0,0,0.06)",

          boxShadow:
            "0 2px 12px rgba(0,0,0,0.06)",
        }}
      >
        <CardContent sx={{ p: 3 }}>
          {/* HEADER */}

          <Stack
            direction={{
              xs: "column",
              md: "row",
            }}
            justifyContent="space-between"
            alignItems={{
              xs: "flex-start",
              md: "center",
            }}
            spacing={2}
            sx={{ mb: 3 }}
          >
            <Box>
              <Typography
                variant="h4"
                fontWeight={900}
              >
                Ledger Explorer
              </Typography>

              <Typography
                variant="body2"
                color="text.secondary"
              >
                Advanced enquiry &
                transaction analysis
              </Typography>
            </Box>

            <CustomChip
              icon={
                <AccountBalanceIcon />
              }
              label={`${
                hasWholeBank
                  ? "Whole Bank"
                  : hasCircle
                    ? "Circle"
                    : "Branch"
              } Access`}
              color="primary"
            />
          </Stack>

          <Grid container spacing={2.5}>
            {/* HIERARCHY */}

            {(isCircleVisible ||
              isBranchVisible) && (
              <Grid
                size={{
                  xs: 12,
                  lg: 5,
                }}
              >
                <Paper
                  variant="outlined"
                  sx={{
                    p: 2.5,

                    borderRadius: 3,

                    border:
                      "1px solid rgba(0,0,0,0.08)",
                  }}
                >
                  <SectionHeader
                    icon={
                      <AccountTreeIcon fontSize="small" />
                    }
                    title="Hierarchy Filters"
                  />

                  <Grid
                    container
                    spacing={2}
                  >
                    {isCircleVisible && (
                      <Grid
                        size={{
                          xs: 12,
                          md: isBranchVisible
                            ? 6
                            : 12,
                        }}
                      >
                        <Autocomplete
                          size="small"
                          options={[
                            "All Circles",
                            ...circles.map(
                              (c) =>
                                `${c.circleCode} - ${c.circleName}`,
                            ),
                          ]}
                          value={
                            filters.circle ===
                            "ALL"
                              ? "All Circles"
                              : circles.find(
                                    (c) =>
                                      c.circleCode ===
                                      filters.circle,
                                  )
                                ? `${filters.circle} - ${
                                    circles.find(
                                      (c) =>
                                        c.circleCode ===
                                        filters.circle,
                                    )
                                      ?.circleName
                                  }`
                                : filters.circle
                          }
                          onChange={(
                            _,
                            value,
                          ) =>
                            onFilterChange(
                              "circle",
                              value ===
                                "All Circles" ||
                                !value
                                ? "ALL"
                                : value.split(
                                    " - ",
                                  )[0],
                            )
                          }
                          renderInput={(
                            params,
                          ) => (
                            <TextField
                              {...params}
                              label="Circle"
                            />
                          )}
                        />
                      </Grid>
                    )}

                    {isBranchVisible && (
                      <Grid
                        size={{
                          xs: 12,
                          md: 6,
                        }}
                      >
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={[
                            "ALL",
                            ...branches,
                          ]}
                          loading={
                            loading.branch
                          }
                          value={
                            filters.branches
                          }
                          renderTags={() => null}
                          onInputChange={(
                            _,
                            value,
                            reason,
                          ) => {
                            if (
                              reason ===
                                "input" &&
                              value.length >=
                                3
                            ) {
                              fetchSearchData(
                                "branch",
                                value,
                              );
                            }
                          }}
                          onChange={(
                            _,
                            value,
                          ) =>
                            handleBranchChange(
                              value,
                            )
                          }
                          renderOption={(
                            props,
                            option,
                            {
                              selected,
                            },
                          ) => (
                            <li
                              {...props}
                              key={option}
                            >
                              <Checkbox
                                size="small"
                                checked={
                                  selected
                                }
                                sx={{
                                  mr: 1,
                                }}
                              />

                              <Typography variant="body2">
                                {option}
                              </Typography>
                            </li>
                          )}
                          renderInput={(
                            params,
                          ) => (
                            <TextField
                              {...params}
                              label="Branches"
                              placeholder="Search branches..."
                              InputProps={{
                                ...params.InputProps,

                                endAdornment:
                                  (
                                    <InputAdornment position="end">
                                      <Stack
                                        direction="row"
                                        spacing={
                                          1
                                        }
                                        alignItems="center"
                                      >
                                        <CustomChip
                                          label={
                                            filters.branches.includes(
                                              "ALL",
                                            )
                                              ? "All"
                                              : `${filters.branches.length} Selected`
                                          }
                                          color="primary"
                                        />

                                        {!filters.branches.includes(
                                          "ALL",
                                        ) &&
                                          filters.branches.length >
                                            0 && (
                                            <IconButton
                                              size="small"
                                              onClick={() =>
                                                setViewBranchList(
                                                  (
                                                    prev,
                                                  ) =>
                                                    !prev,
                                                )
                                              }
                                            >
                                              {viewBranchList ? (
                                                <VisibilityOffIcon fontSize="small" />
                                              ) : (
                                                <VisibilityIcon fontSize="small" />
                                              )}
                                            </IconButton>
                                          )}
                                      </Stack>
                                    </InputAdornment>
                                  ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* ACCOUNT */}

            <Grid
              size={{
                xs: 12,
                lg:
                  isCircleVisible ||
                  isBranchVisible
                    ? 7
                    : 12,
              }}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 2.5,

                  borderRadius: 3,

                  border:
                    "1px solid rgba(0,0,0,0.08)",
                }}
              >
                <SectionHeader
                  icon={
                    <CurrencyRupeeIcon fontSize="small" />
                  }
                  title="Account Details"
                />

                <Grid
                  container
                  spacing={2}
                >
                  <Grid
                    size={{
                      xs: 12,
                      md: 7,
                    }}
                  >
                    <Autocomplete
                      size="small"
                      options={cgls}
                      value={filters.cgl}
                      onInputChange={(
                        _,
                        value,
                      ) => {
                        if (
                          value.length >= 3
                        ) {
                          fetchSearchData(
                            "cgl",
                            value,
                          );
                        }
                      }}
                      onChange={(
                        _,
                        value,
                      ) =>
                        onFilterChange(
                          "cgl",
                          value,
                        )
                      }
                      renderInput={(
                        params,
                      ) => (
                        <TextField
                          {...params}
                          label="CGL Account"
                          required
                        />
                      )}
                    />
                  </Grid>

                  <Grid
                    size={{
                      xs: 12,
                      md: 5,
                    }}
                  >
                    <Autocomplete
                      size="small"
                      options={[
                        "ALL",
                        ...currencies,
                      ]}
                      value={
                        filters.currencies
                      }
                      onChange={(
                        _,
                        value,
                      ) =>
                        onFilterChange(
                          "currencies",
                          value || "ALL",
                        )
                      }
                      renderInput={(
                        params,
                      ) => (
                        <TextField
                          {...params}
                          label="Currency"
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* BRANCH LIST */}

            <Grid size={{ xs: 12 }}>
              <Collapse
                in={
                  viewBranchList &&
                  hasSelectedBranches
                }
              >
                <Paper
                  variant="outlined"
                  sx={{
                    p: 2,

                    borderRadius: 3,

                    border:
                      "1px solid rgba(0,0,0,0.08)",
                  }}
                >
                  <Stack
                    direction="row"
                    justifyContent="space-between"
                    alignItems="center"
                    sx={{ mb: 2 }}
                  >
                    <Typography
                      variant="subtitle2"
                      fontWeight={800}
                    >
                      Selected Branches
                    </Typography>

                    <Button
                      size="small"
                      color="error"
                      startIcon={
                        <DeleteSweepIcon />
                      }
                      onClick={() => {
                        onFilterChange(
                          "branches",
                          ["ALL"],
                        );

                        setViewBranchList(
                          false,
                        );
                      }}
                    >
                      Clear All
                    </Button>
                  </Stack>

                  <Divider
                    sx={{ mb: 2 }}
                  />

                  <Box
                    sx={{
                      display: "flex",
                      flexWrap: "wrap",
                      gap: 1,
                    }}
                  >
                    {filters.branches.map(
                      (branch) => (
                        <Chip
                          key={branch}
                          label={branch}
                          onDelete={() =>
                            removeBranch(
                              branch,
                            )
                          }
                          color="primary"
                          variant="outlined"
                        />
                      ),
                    )}
                  </Box>
                </Paper>
              </Collapse>
            </Grid>

            {/* TIMELINE */}

            <Grid size={{ xs: 12 }}>
              <Paper
                sx={{
                  p: 2.5,

                  borderRadius: 3,

                  bgcolor:
                    "primary.main",

                  color: "#fff",
                }}
              >
                <SectionHeader
                  icon={
                    <DateRangeIcon fontSize="small" />
                  }
                  title="Timeline & Source Filters"
                />

                <Grid
                  container
                  spacing={2}
                >
                  <Grid
                    size={{
                      xs: 12,
                      md: 3,
                    }}
                  >
                    <DatePicker
                      value={
                        filters.fromDate
                      }
                      minDate={
                        minLimit
                      }
                      maxDate={maxLimit}
                      onChange={(
                        value,
                      ) =>
                        onFilterChange(
                          "fromDate",
                          value,
                        )
                      }
                      slotProps={{
                        textField: {
                          fullWidth: true,
                          size: "small",
                          label:
                            "From Date",

                          sx: {
                            bgcolor:
                              "#fff",
                            borderRadius: 2,
                          },
                        },
                      }}
                    />
                  </Grid>

                  <Grid
                    size={{
                      xs: 12,
                      md: 3,
                    }}
                  >
                    <DatePicker
                      value={
                        filters.toDate
                      }
                      minDate={
                        minLimit
                      }
                      maxDate={maxLimit}
                      onChange={(
                        value,
                      ) =>
                        onFilterChange(
                          "toDate",
                          value,
                        )
                      }
                      slotProps={{
                        textField: {
                          fullWidth: true,
                          size: "small",
                          label:
                            "To Date",

                          sx: {
                            bgcolor:
                              "#fff",
                            borderRadius: 2,
                          },
                        },
                      }}
                    />
                  </Grid>

                  <Grid
                    size={{
                      xs: 12,
                      md: 6,
                    }}
                  >
                    <Autocomplete
                      multiple
                      size="small"
                      disableCloseOnSelect
                      options={
                        sourceOptions
                      }
                      value={
                        filters.sourceFlags
                      }
                      getOptionLabel={(
                        option,
                      ) =>
                        option.flagName ||
                        ""
                      }
                      isOptionEqualToValue={(
                        option,
                        value,
                      ) =>
                        option.flagId ===
                        value.flagId
                      }
                      onChange={(
                        _,
                        value,
                      ) =>
                        onFilterChange(
                          "sourceFlags",
                          value,
                        )
                      }
                      renderTags={(
                        value,
                      ) => (
                        <CustomChip
                          label={`${value.length} Sources`}
                          color="default"
                          sx={{
                            bgcolor:
                              "#fff",
                          }}
                        />
                      )}
                      renderOption={(
                        props,
                        option,
                        {
                          selected,
                        },
                      ) => (
                        <li
                          {...props}
                          key={
                            option.flagId
                          }
                        >
                          <Checkbox
                            checked={
                              selected
                            }
                            size="small"
                            sx={{
                              mr: 1,
                            }}
                          />

                          <Typography variant="body2">
                            {
                              option.flagName
                            }
                          </Typography>
                        </li>
                      )}
                      renderInput={(
                        params,
                      ) => (
                        <TextField
                          {...params}
                          placeholder="Source Flags"
                          sx={{
                            bgcolor:
                              "#fff",

                            borderRadius: 2,
                          }}
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>
          </Grid>

          {/* ACTIONS */}

          <Box
            sx={{
              mt: 3,

              position: "sticky",

              bottom: 12,

              zIndex: 20,

              display: "flex",

              justifyContent: "flex-end",

              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={
                <RestartAltIcon />
              }
              onClick={onReset}
              sx={{
                borderRadius: 2,

                textTransform:
                  "none",

                fontWeight: 700,
              }}
            >
              Reset
            </Button>

            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.cgl ||
                !filters.fromDate ||
                !filters.toDate
              }
              sx={{
                borderRadius: 2,

                px: 4,

                textTransform:
                  "none",

                fontWeight: 800,
              }}
            >
              Fetch Records
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default LedgerForm;