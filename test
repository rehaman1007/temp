package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportServiceImpl
        implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * CHANGEABLE
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * JOB STORE
     */
    private final Map<String, Map<String, Object>> jobStore =
            new ConcurrentHashMap<>();

    /**
     * ADMIN EXECUTE
     */
    @Override
    public Map<String, Object> executeAdminSql(
            AdminSupportDTO dto,
            String userId,
            HttpServletRequest request
    ) {

        long start = System.currentTimeMillis();

        String ip = getClientIp(request);

        String rawSql = dto.getSql().trim();

        int page =
                dto.getPage() != null
                        ? dto.getPage()
                        : 0;

        int size =
                dto.getSize() != null
                        ? dto.getSize()
                        : 5;

        log.info(
                "ADMIN SQL START | user={} | ip={} | page={} | size={}",
                userId,
                ip,
                page,
                size
        );

        try {

            String[] statements =
                    rawSql.split(";");

            List<String> cleanStatements =
                    new ArrayList<>();

            for (String s : statements) {

                String clean =
                        s.replaceAll(
                                "(?m)^--.*",
                                ""
                        ).trim();

                if (!clean.isEmpty()) {
                    cleanStatements.add(clean);
                }
            }

            boolean isSelect =
                    cleanStatements.size() == 1
                            &&
                            (
                                    cleanStatements.get(0)
                                            .toUpperCase()
                                            .startsWith("SELECT")

                                            ||

                                            cleanStatements.get(0)
                                                    .toUpperCase()
                                                    .startsWith("WITH")
                            );

            /**
             * SELECT
             */
            if (isSelect) {

                String sql =
                        cleanStatements.get(0);

                String countSql =
                        "SELECT COUNT(*) FROM (" + sql + ")";

                Integer total =
                        jdbcTemplate.queryForObject(
                                countSql,
                                Integer.class
                        );

                String paginatedSql =
                        sql
                                + " OFFSET "
                                + (page * size)
                                + " ROWS FETCH NEXT "
                                + size
                                + " ROWS ONLY";

                List<Map<String, Object>> rows =
                        jdbcTemplate.queryForList(
                                paginatedSql
                        );

                List<Map<String, String>> columns =
                        new ArrayList<>();

                if (!rows.isEmpty()) {

                    rows.get(0)
                            .keySet()
                            .forEach(col -> {

                                columns.add(
                                        Map.of(
                                                "name",
                                                col
                                        )
                                );
                            });
                }

                long executionMs =
                        System.currentTimeMillis() - start;

                insertExecutionLog(
                        userId,
                        ip,
                        "SELECT",
                        sql,
                        "SUCCESS",
                        rows.size(),
                        executionMs,
                        null
                );

                log.info(
                        "SELECT EXECUTED | rows={} | total={} | timeMs={}",
                        rows.size(),
                        total,
                        executionMs
                );

                return Map.of(
                        "error", false,
                        "rows", rows,
                        "columns", columns,
                        "total", total,
                        "page", page,
                        "size", size
                );
            }

            /**
             * DML
             */
            int success = 0;

            for (String sql : cleanStatements) {

                jdbcTemplate.execute(sql);

                success++;
            }

            long executionMs =
                    System.currentTimeMillis() - start;

            insertExecutionLog(
                    userId,
                    ip,
                    "SCRIPT",
                    rawSql,
                    "SUCCESS",
                    success,
                    executionMs,
                    null
            );

            return Map.of(
                    "error", false,
                    "rows",
                    List.of(
                            Map.of(
                                    "RESULT",
                                    "Executed Successfully : "
                                            + success
                            )
                    )
            );

        } catch (Exception e) {

            log.error(
                    "ADMIN SQL FAILED",
                    e
            );

            insertExecutionLog(
                    userId,
                    ip,
                    "FAILED",
                    rawSql,
                    "FAILED",
                    0,
                    System.currentTimeMillis() - start,
                    e.getMessage()
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * FILE UPLOAD
     */
    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file,
            String userId,
            HttpServletRequest request
    ) {

        try {

            String jobId =
                    UUID.randomUUID().toString();

            String ip =
                    getClientIp(request);

            Path tempFile =
                    Files.createTempFile(
                            "admin_sql_",
                            ".sql"
                    );

            Files.copy(
                    file.getInputStream(),
                    tempFile,
                    StandardCopyOption.REPLACE_EXISTING
            );

            Map<String, Object> status =
                    new ConcurrentHashMap<>();

            status.put("status", "STARTING");
            status.put("executedCount", 0);
            status.put("progress", 0);
            status.put("insertCount", 0);
            status.put("updateCount", 0);
            status.put("deleteCount", 0);
            status.put("otherCount", 0);
            status.put("startTime", LocalDateTime.now().toString());

            jobStore.put(jobId, status);

            log.info(
                    "SQL FILE RECEIVED | jobId={} | file={} | size={}MB",
                    jobId,
                    file.getOriginalFilename(),
                    String.format(
                            "%.2f",
                            file.getSize()
                                    / 1024.0
                                    / 1024.0
                    )
            );

            adminSupportExecutor.executeScriptAsync(
                    tempFile,
                    file.getOriginalFilename(),
                    jobId,
                    userId,
                    ip,
                    COMMIT_BATCH_SIZE,
                    jobStore
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId
            );

        } catch (Exception e) {

            log.error(
                    "UPLOAD FAILED",
                    e
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * JOB STATUS
     */
    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStore.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }

    /**
     * LOG INSERT
     */
    private void insertExecutionLog(
            String userId,
            String ip,
            String type,
            String sql,
            String status,
            int affectedRows,
            long executionMs,
            String errorMessage
    ) {

        try {

            jdbcTemplate.update(
                    """
                    INSERT INTO ADMIN_SUPPORT_LOG
                    (
                        ID,
                        USER_ID,
                        CLIENT_IP,
                        EXECUTION_TYPE,
                        SQL_TEXT,
                        EXECUTION_STATUS,
                        AFFECTED_ROWS,
                        EXECUTION_TIME_MS,
                        ERROR_MESSAGE,
                        CREATED_AT
                    )
                    VALUES
                    (
                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        ?, ?, ?, ?, ?, ?, ?, ?, SYSTIMESTAMP
                    )
                    """,
                    userId,
                    ip,
                    type,
                    sql,
                    status,
                    affectedRows,
                    executionMs,
                    errorMessage
            );

        } catch (Exception e) {

            log.error(
                    "FAILED TO INSERT LOG",
                    e
            );
        }
    }

    private String getClientIp(
            HttpServletRequest request
    ) {

        String xf =
                request.getHeader(
                        "X-Forwarded-For"
                );

        if (
                xf != null
                        && !xf.isBlank()
        ) {
            return xf.split(",")[0];
        }

        return request.getRemoteAddr();
    }
}


package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.io.BufferedReader;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    private final DataSource dataSource;

    private final JdbcTemplate jdbcTemplate;

    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path filePath,
            String fileName,
            String jobId,
            String userId,
            String clientIp,
            int commitBatchSize,
            Map<String, Map<String, Object>> jobStore
    ) {

        Instant start = Instant.now();

        int executed = 0;

        int inserts = 0;

        int updates = 0;

        int deletes = 0;

        int others = 0;

        int failedLine = 0;

        String failedSql = "";

        try {

            Map<String, Object> status =
                    jobStore.get(jobId);

            status.put("status", "RUNNING");

            int totalStatements = 0;

            try (
                    BufferedReader counter =
                            Files.newBufferedReader(filePath)
            ) {

                String line;

                while ((line = counter.readLine()) != null) {

                    if (line.trim().endsWith(";")) {
                        totalStatements++;
                    }
                }
            }

            status.put(
                    "totalStatements",
                    totalStatements
            );

            log.info(
                    "SCRIPT STARTED | jobId={} | totalStatements={}",
                    jobId,
                    totalStatements
            );

            try (
                    Connection connection =
                            dataSource.getConnection();

                    Statement statement =
                            connection.createStatement();

                    BufferedReader reader =
                            Files.newBufferedReader(filePath)
            ) {

                connection.setAutoCommit(false);

                StringBuilder sqlBuilder =
                        new StringBuilder();

                String line;

                int lineNo = 0;

                while ((line = reader.readLine()) != null) {

                    lineNo++;

                    String trimmed =
                            line.trim();

                    if (
                            trimmed.isBlank()
                                    || trimmed.startsWith("--")
                    ) {
                        continue;
                    }

                    sqlBuilder
                            .append(line)
                            .append("\n");

                    if (trimmed.endsWith(";")) {

                        String sql =
                                sqlBuilder.toString().trim();

                        sql =
                                sql.substring(
                                        0,
                                        sql.lastIndexOf(";")
                                );

                        failedLine = lineNo;

                        failedSql = sql;

                        statement.execute(sql);

                        executed++;

                        String upper =
                                sql.toUpperCase();

                        if (upper.startsWith("INSERT")) {
                            inserts++;
                        }
                        else if (upper.startsWith("UPDATE")) {
                            updates++;
                        }
                        else if (upper.startsWith("DELETE")) {
                            deletes++;
                        }
                        else {
                            others++;
                        }

                        if (executed % commitBatchSize == 0) {

                            connection.commit();

                            log.info(
                                    "COMMIT SUCCESS | jobId={} | executed={}",
                                    jobId,
                                    executed
                            );
                        }

                        long elapsed =
                                Duration.between(
                                        start,
                                        Instant.now()
                                ).toSeconds();

                        long eta = 0;

                        if (
                                executed > 0
                                        && elapsed > 0
                        ) {

                            double avg =
                                    (double) elapsed
                                            / executed;

                            eta =
                                    (long) (
                                            (totalStatements - executed)
                                                    * avg
                                    );
                        }

                        double progress =
                                totalStatements > 0
                                        ? (
                                        (double) executed
                                                / totalStatements
                                ) * 100
                                        : 0;

                        status.put("executedCount", executed);
                        status.put("insertCount", inserts);
                        status.put("updateCount", updates);
                        status.put("deleteCount", deletes);
                        status.put("otherCount", others);
                        status.put("elapsedSeconds", elapsed);
                        status.put("estimatedRemainingSeconds", eta);
                        status.put("progress", progress);

                        sqlBuilder.setLength(0);
                    }
                }

                connection.commit();

                status.put("status", "COMPLETED");

                insertExecutionLog(
                        userId,
                        clientIp,
                        "UPLOAD_SCRIPT",
                        fileName,
                        "SUCCESS",
                        executed,
                        Duration.between(
                                start,
                                Instant.now()
                        ).toMillis(),
                        null
                );

                log.info(
                        "SCRIPT COMPLETED | jobId={} | executed={}",
                        jobId,
                        executed
                );
            }

            Files.deleteIfExists(filePath);

        } catch (Exception e) {

            log.error(
                    "SCRIPT FAILED | line={}",
                    failedLine,
                    e
            );

            Map<String, Object> status =
                    jobStore.get(jobId);

            if (status != null) {

                status.put("status", "FAILED");
                status.put("failedLine", failedLine);
                status.put("failedSql", failedSql);
                status.put("message", e.getMessage());
            }

            insertExecutionLog(
                    userId,
                    clientIp,
                    "UPLOAD_SCRIPT",
                    failedSql,
                    "FAILED",
                    executed,
                    Duration.between(
                            start,
                            Instant.now()
                    ).toMillis(),
                    e.getMessage()
            );
        }
    }

    private void insertExecutionLog(
            String userId,
            String ip,
            String type,
            String sql,
            String status,
            int affectedRows,
            long executionMs,
            String errorMessage
    ) {

        jdbcTemplate.update(
                """
                INSERT INTO ADMIN_SUPPORT_LOG
                (
                    ID,
                    USER_ID,
                    CLIENT_IP,
                    EXECUTION_TYPE,
                    SQL_TEXT,
                    EXECUTION_STATUS,
                    AFFECTED_ROWS,
                    EXECUTION_TIME_MS,
                    ERROR_MESSAGE,
                    CREATED_AT
                )
                VALUES
                (
                    ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                    ?, ?, ?, ?, ?, ?, ?, ?, SYSTIMESTAMP
                )
                """,
                userId,
                ip,
                type,
                sql,
                status,
                affectedRows,
                executionMs,
                errorMessage
        );
    }
}


package com.fincore.transactions_service.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

@Slf4j
@Configuration
@EnableAsync
public class AsyncConfig {

    @Bean(name = "sqlExecutor")
    public Executor sqlExecutor() {

        ThreadPoolTaskExecutor executor =
                new ThreadPoolTaskExecutor();

        executor.setCorePoolSize(2);

        executor.setMaxPoolSize(5);

        executor.setQueueCapacity(20);

        executor.setThreadNamePrefix("SQL-EXECUTOR-");

        executor.initialize();

        log.info("SQL EXECUTOR INITIALIZED");

        return executor;
    }
}

