while (rs.next()) {

    Map<String, Object> row =
            new HashMap<>();

    for (
            int i = 1;
            i <= columnCount;
            i++
    ) {

        String columnName =
                meta.getColumnLabel(i);

        int columnType =
                meta.getColumnType(i);

        Object value;

        switch (columnType) {

            /**
             * VARCHAR / CHAR
             */
            case java.sql.Types.VARCHAR:

            case java.sql.Types.CHAR:

            case java.sql.Types.LONGVARCHAR:

            case java.sql.Types.NVARCHAR:

            case java.sql.Types.NCHAR:

                value =
                        rs.getString(i);

                break;

            /**
             * INTEGER TYPES
             */
            case java.sql.Types.INTEGER:

            case java.sql.Types.SMALLINT:

            case java.sql.Types.TINYINT:

                value =
                        rs.getInt(i);

                if (rs.wasNull()) {
                    value = null;
                }

                break;

            /**
             * BIGINT
             */
            case java.sql.Types.BIGINT:

                value =
                        rs.getLong(i);

                if (rs.wasNull()) {
                    value = null;
                }

                break;

            /**
             * DECIMAL / NUMBER
             */
            case java.sql.Types.NUMERIC:

            case java.sql.Types.DECIMAL:

                value =
                        rs.getBigDecimal(i);

                break;

            /**
             * FLOAT / DOUBLE
             */
            case java.sql.Types.FLOAT:

            case java.sql.Types.REAL:

            case java.sql.Types.DOUBLE:

                value =
                        rs.getDouble(i);

                if (rs.wasNull()) {
                    value = null;
                }

                break;

            /**
             * BOOLEAN
             */
            case java.sql.Types.BOOLEAN:

            case java.sql.Types.BIT:

                value =
                        rs.getBoolean(i);

                if (rs.wasNull()) {
                    value = null;
                }

                break;

            /**
             * DATE
             */
            case java.sql.Types.DATE:

                java.sql.Date date =
                        rs.getDate(i);

                value =
                        date != null
                                ? date.toLocalDate()
                                .toString()
                                : null;

                break;

            /**
             * TIME
             */
            case java.sql.Types.TIME:

                java.sql.Time time =
                        rs.getTime(i);

                value =
                        time != null
                                ? time.toLocalTime()
                                .toString()
                                : null;

                break;

            /**
             * TIMESTAMP
             */
            case java.sql.Types.TIMESTAMP:

            case java.sql.Types.TIMESTAMP_WITH_TIMEZONE:

                java.sql.Timestamp ts =
                        rs.getTimestamp(i);

                value =
                        ts != null
                                ? ts.toLocalDateTime()
                                .toString()
                                : null;

                break;

            /**
             * CLOB
             */
            case java.sql.Types.CLOB:

            case java.sql.Types.NCLOB:

                java.sql.Clob clob =
                        rs.getClob(i);

                value =
                        clob != null
                                ? clob.getSubString(
                                        1,
                                        (int) clob.length()
                                )
                                : null;

                break;

            /**
             * BLOB
             */
            case java.sql.Types.BLOB:

            case java.sql.Types.BINARY:

            case java.sql.Types.VARBINARY:

            case java.sql.Types.LONGVARBINARY:

                value = "[BLOB DATA]";

                break;

            /**
             * ARRAY
             */
            case java.sql.Types.ARRAY:

                value = "[ARRAY DATA]";

                break;

            /**
             * SQLXML
             */
            case java.sql.Types.SQLXML:

                value =
                        rs.getSQLXML(i) != null
                                ? rs.getSQLXML(i)
                                    .getString()
                                : null;

                break;

            /**
             * DEFAULT
             */
            default:

                value =
                        rs.getObject(i);

                /**
                 * Prevent Oracle proprietary serialization
                 */
                if (
                        value != null &&
                        value.getClass()
                                .getName()
                                .startsWith("oracle.sql.")
                ) {

                    value =
                            value.toString();
                }
        }

        row.put(columnName, value);
    }

    rows.add(row);
}