import React from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  List,
  ListItem,
  ListItemText,
  Divider,
} from "@mui/material";
import CustomChip from "../../../utils/CustomChip";
export const DashboardRecentActivity = ({ recentActivity = [] }) => {
  return (
    <>
      <Card variant="outlined" sx={{ borderRadius: 3 }}>
        <CardContent>
          <Typography variant="subtitle2" fontWeight={600} mb={1}>
            Recent Activity
          </Typography>

          <List dense sx={{ maxHeight: 320, overflow: "auto" }}>
            {(recentActivity || []).slice(0, 20).map((r, idx) => (
              <Box key={r.timestamp + idx}>
                {idx > 0 && <Divider component="li" />}
                <ListItem alignItems="flex-start">
                  <ListItemText
                    primary={
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography variant="body2" fontWeight={600}>
                          {r.action}
                        </Typography>
                        <CustomChip
                          label={r.status}
                          size="small"
                          color={
                            r.status === "PENDING"
                              ? "warning"
                              : r.status === "REJECTED"
                              ? "error"
                              : "success"
                          }
                          variant="outlined"
                        />
                      </Stack>
                    }
                    secondary={
                      <Box>
                        <Typography
                          component="span"
                          variant="caption"
                          color="text.secondary"
                          display="block"
                        >
                          {r.displayTime}
                        </Typography>
                        <Typography variant="body2">{r.details}</Typography>
                      </Box>
                    }
                  />
                </ListItem>
              </Box>
            ))}
            {(!recentActivity || recentActivity.length === 0) && (
              <EmptyState text="No activity" />
            )}
          </List>
        </CardContent>
      </Card>
    </>
  );
};
