package com.fincore.enquiry_service.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.enquiry_service.dto.*;
import com.fincore.enquiry_service.model.LedgerTransaction;
import com.fincore.enquiry_service.repository.GlTransactionsRepository;
import com.fincore.enquiry_service.repository.LedgerWiseRepository;
import com.fincore.enquiry_service.specification.LedgerSpecification;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.ss.util.CellRangeAddress;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;

import org.springframework.data.domain.*;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.util.List;

@Slf4j
@RequiredArgsConstructor
@Service("LedgerEnquiryService")
public class LedgerEnquiryServiceImpl
        implements LedgerEnquiryService {

    private final GlTransactionsRepository glTransactionsRepository;

    private final LedgerWiseRepository ledgerTransactionRepository;

    private final MyDownloadsService myDownloadsService;

    @Override
    public Page<LedgerEnquiryResponse> search(
            LedgerEnquiryRequest dto
    ) {

        Sort.Direction direction =
                "asc".equalsIgnoreCase(dto.getSortOrder())
                        ? Sort.Direction.ASC
                        : Sort.Direction.DESC;

        Pageable pageable =
                PageRequest.of(
                        dto.getPage(),
                        dto.getSize(),
                        Sort.by(
                                direction,
                                getSortField(dto.getSortField())
                        )
                );

        Page<LedgerTransaction> page =
                ledgerTransactionRepository.findAll(
                        LedgerSpecification.build(dto),
                        pageable
                );

        return page.map(this::mapToDto);
    }

    @Override
    public byte[] excelExport(
            LedgerEnquiryRequest dto,
            String userId
    ) {

        /*
         * EXPORT LIMIT CHECK
         */
        long count =
                ledgerTransactionRepository.count(
                        LedgerSpecification.build(dto)
                );

        if (count > 1_000_000) {

            throw new RuntimeException(
                    "Excel export limit exceeded. Maximum allowed records: 10,00,000"
            );
        }

        /*
         * FETCH DATA
         */
        List<LedgerEnquiryResponse> mappedContent =
                ledgerTransactionRepository
                        .findAll(
                                LedgerSpecification.build(dto)
                        )
                        .stream()
                        .map(this::mapToDto)
                        .toList();

        try (
                SXSSFWorkbook workbook =
                        new SXSSFWorkbook(500);

                ByteArrayOutputStream out =
                        new ByteArrayOutputStream()
        ) {

            workbook.setCompressTempFiles(true);

            Sheet sheet =
                    workbook.createSheet(
                            "TransactionsData"
                    );

            /*
             * TITLE STYLE
             */
            CellStyle titleStyle =
                    workbook.createCellStyle();

            Font titleFont =
                    workbook.createFont();

            titleFont.setBold(true);

            titleFont.setFontHeightInPoints(
                    (short) 14
            );

            titleStyle.setFont(titleFont);

            titleStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            /*
             * SUBTITLE STYLE
             */
            CellStyle subTitleStyle =
                    workbook.createCellStyle();

            Font subTitleFont =
                    workbook.createFont();

            subTitleFont.setBold(true);

            subTitleFont.setFontHeightInPoints(
                    (short) 11
            );

            subTitleStyle.setFont(subTitleFont);

            subTitleStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            /*
             * HEADER STYLE
             */
            Font headerFont =
                    workbook.createFont();

            headerFont.setBold(true);

            CellStyle headerStyle =
                    workbook.createCellStyle();

            headerStyle.setFont(headerFont);

            headerStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            /*
             * ALIGNMENT STYLES
             */
            CellStyle leftAlignStyle =
                    workbook.createCellStyle();

            leftAlignStyle.setAlignment(
                    HorizontalAlignment.LEFT
            );

            CellStyle rightAlignStyle =
                    workbook.createCellStyle();

            rightAlignStyle.setAlignment(
                    HorizontalAlignment.RIGHT
            );

            CellStyle centerAlignStyle =
                    workbook.createCellStyle();

            centerAlignStyle.setAlignment(
                    HorizontalAlignment.CENTER
            );

            /*
             * DATE STYLE
             */
            CellStyle dateStyle =
                    workbook.createCellStyle();

            CreationHelper creationHelper =
                    workbook.getCreationHelper();

            dateStyle.setDataFormat(
                    creationHelper
                            .createDataFormat()
                            .getFormat("dd/MM/yyyy")
            );

            /*
             * TITLE ROWS
             */
            Row title1 =
                    sheet.createRow(0);

            Cell titleCell1 =
                    title1.createCell(0);

            titleCell1.setCellValue(
                    "Ledger-Wise Enquiry"
            );

            titleCell1.setCellStyle(
                    titleStyle
            );

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            0,
                            0,
                            0,
                            17
                    )
            );

            Row title2 =
                    sheet.createRow(1);

            Cell titleCell2 =
                    title2.createCell(0);

            titleCell2.setCellValue(
                    "CGL: "
                            + dto.getCgl()
                            + " - "
                            + dto.getCglName()
            );

            titleCell2.setCellStyle(
                    titleStyle
            );

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            1,
                            1,
                            0,
                            17
                    )
            );

            Row subTitle =
                    sheet.createRow(2);

            Cell subTitleCell =
                    subTitle.createCell(0);

            subTitleCell.setCellValue(
                    "From "
                            + dto.getFromDate()
                            + " To "
                            + dto.getToDate()
            );

            subTitleCell.setCellStyle(
                    subTitleStyle
            );

            sheet.addMergedRegion(
                    new CellRangeAddress(
                            2,
                            2,
                            0,
                            17
                    )
            );

            /*
             * HEADER
             */
            Row header =
                    sheet.createRow(3);

            String[] headers = {
                    "TRANSACTION ID",
                    "BATCH ID",
                    "JOURNAL ID",
                    "TRANSACTION DATE",
                    "POST DATE",
                    "BRANCH CODE",
                    "BRANCH NAME",
                    "CIRCLE CODE",
                    "CIRCLE NAME",
                    "CURRENCY",
                    "CURRENCY NAME",
                    "CGL",
                    "CGL DESCRIPTION",
                    "NARRATION",
                    "DEBIT AMOUNT",
                    "CREDIT AMOUNT",
                    "TRANSACTION COUNT",
                    "SOURCE NAME"
            };

            for (int i = 0; i < headers.length; i++) {

                Cell cell =
                        header.createCell(i);

                cell.setCellValue(headers[i]);

                cell.setCellStyle(headerStyle);
            }

            /*
             * DATA
             */
            int rowNum = 4;

            for (
                    LedgerEnquiryResponse dtoList
                            : mappedContent
            ) {

                Row row =
                        sheet.createRow(rowNum++);

                createCell(
                        row,
                        0,
                        dtoList.getTransactionId(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        1,
                        dtoList.getBatchId(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        2,
                        dtoList.getJournalId(),
                        leftAlignStyle
                );

                Cell c4 =
                        row.createCell(3);

                if (
                        dtoList.getTransactionDate()
                                != null
                ) {

                    c4.setCellValue(
                            dtoList.getTransactionDate()
                    );
                }

                c4.setCellStyle(dateStyle);

                Cell c5 =
                        row.createCell(4);

                if (
                        dtoList.getPostDate()
                                != null
                ) {

                    c5.setCellValue(
                            dtoList.getPostDate()
                    );
                }

                c5.setCellStyle(dateStyle);

                createCell(
                        row,
                        5,
                        dtoList.getBranchCode(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        6,
                        dtoList.getBranchName(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        7,
                        dtoList.getCircleCode(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        8,
                        dtoList.getCircleName(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        9,
                        dtoList.getCurrency(),
                        centerAlignStyle
                );

                createCell(
                        row,
                        10,
                        dtoList.getCurrencyName(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        11,
                        dtoList.getCgl(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        12,
                        dtoList.getDescription(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        13,
                        dtoList.getNarration(),
                        leftAlignStyle
                );

                createCell(
                        row,
                        14,
                        dtoList.getDebitAmount(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        15,
                        dtoList.getCreditAmount(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        16,
                        dtoList.getTransactionCount(),
                        rightAlignStyle
                );

                createCell(
                        row,
                        17,
                        dtoList.getSourceName(),
                        leftAlignStyle
                );
            }

            /*
             * FIXED COLUMN WIDTHS
             */
            sheet.setColumnWidth(0, 5000);
            sheet.setColumnWidth(1, 5000);
            sheet.setColumnWidth(2, 5000);
            sheet.setColumnWidth(3, 6000);
            sheet.setColumnWidth(4, 6000);
            sheet.setColumnWidth(5, 4500);
            sheet.setColumnWidth(6, 9000);
            sheet.setColumnWidth(7, 4500);
            sheet.setColumnWidth(8, 9000);
            sheet.setColumnWidth(9, 4000);
            sheet.setColumnWidth(10, 7000);
            sheet.setColumnWidth(11, 5000);
            sheet.setColumnWidth(12, 10000);
            sheet.setColumnWidth(13, 12000);
            sheet.setColumnWidth(14, 5000);
            sheet.setColumnWidth(15, 5000);
            sheet.setColumnWidth(16, 5000);
            sheet.setColumnWidth(17, 8000);

            workbook.write(out);

            byte[] byteArrayContent =
                    out.toByteArray();

            workbook.dispose();

            String json =
                    new ObjectMapper()
                            .writeValueAsString(dto);

            sendToMyDownloads(
                    userId,
                    json,
                    byteArrayContent
            );

            return byteArrayContent;

        } catch (IOException e) {

            throw new RuntimeException(
                    "Failed to generate excel",
                    e
            );
        }
    }

    private void createCell(
            Row row,
            int column,
            Object value,
            CellStyle style
    ) {

        Cell cell =
                row.createCell(column);

        if (value != null) {

            cell.setCellValue(
                    value.toString()
            );
        }

        cell.setCellStyle(style);
    }

    private void sendToMyDownloads(
            String userId,
            String searchCriteria,
            byte[] byteArrayContent
    ) {

        try {

            MyDownloadsRequestDTO request =
                    new MyDownloadsRequestDTO(
                            userId,
                            "LedgerWiseEnquiry.xlsx",
                            51,
                            searchCriteria,
                            byteArrayContent
                    );

            myDownloadsService.insertRequest(
                    request
            );

        } catch (Exception e) {

            log.error(
                    "Error sending download data",
                    e
            );
        }
    }

    private LedgerEnquiryResponse mapToDto(
            LedgerTransaction entity
    ) {

        String branchCode = null;
        String branchName = null;
        String circleCode = null;
        String circleName = null;

        try {

            if (entity.getBranch() != null) {

                branchCode =
                        entity.getBranch().getCode();

                branchName =
                        entity.getBranch().getName();

                if (
                        entity.getBranch().getCircle()
                                != null
                ) {

                    circleCode =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleCode();

                    circleName =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleName();
                }
            }

        } catch (Exception e) {

            log.warn(
                    "Circle mapping failed for transaction : {}",
                    entity.getTransactionId()
            );
        }

        return new LedgerEnquiryResponse(

                entity.getTransactionId(),
                entity.getBatchId(),
                entity.getJournalId(),
                entity.getTransactionDate(),
                entity.getPostDate(),

                branchCode,
                branchName,

                circleCode,
                circleName,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyCode()
                        : null,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyName()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getCglNumber()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getDescription()
                        : null,

                entity.getNarration(),

                entity.getDebitAmount(),

                entity.getCreditAmount(),

                entity.getTransactionCount(),

                entity.getSourceFlag(),

                entity.getSourceFlagMaster() != null
                        ? entity.getSourceFlagMaster()
                        .getFlagName()
                        : null
        );
    }

    private String getSortField(
            String field
    ) {

        return switch (field) {

            case "transactionId" ->
                    "transactionId";

            case "batchId" ->
                    "batchId";

            case "journalId" ->
                    "journalId";

            case "transactionDate" ->
                    "transactionDate";

            case "postDate" ->
                    "postDate";

            case "narration" ->
                    "narration";

            case "debitAmount" ->
                    "debitAmount";

            case "creditAmount" ->
                    "creditAmount";

            case "transactionCount" ->
                    "transactionCount";

            case "sourceFlag" ->
                    "sourceFlag";

            case "sourceName" ->
                    "sourceFlagMaster.flagName";

            case "branchCode" ->
                    "branch.code";

            case "branchName" ->
                    "branch.name";

            case "circleCode" ->
                    "branch.circle.circleCode";

            case "circleName" ->
                    "branch.circle.circleName";

            case "currency" ->
                    "currencyMaster.currencyCode";

            case "currencyName" ->
                    "currencyMaster.currencyName";

            case "cgl" ->
                    "cglMaster.cglNumber";

            case "description" ->
                    "cglMaster.description";

            default ->
                    "transactionDate";
        };
    }
}