import { useState, useEffect } from "react";
import {
  Box,
  Drawer,
  List,
  Typography,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Card,
  CardContent,
  Button,
  Chip,
} from "@mui/material";
import * as MuiIcons from "@mui/icons-material";
import { useNavigate, useLocation } from "react-router-dom";
import f1Logo from "../../assets/Logos/Fincore_transperent.svg";
// import { useAuth } from "../../hooks/useAuth";
import { useDispatch, useSelector } from "react-redux";
import { setSelectedMenuItem } from "../../app/menuSlice";

const drawerWidth = 240;

// Get Icon component dynamically from icon name
const getIconComponent = (iconName) => {
  const IconName = iconName
    .replace(/_./g, (match) => match[1].toUpperCase())
    .replace(/^./, (match) => match.toUpperCase());
  const Icon = MuiIcons[IconName];
  console.log("IconName :: ", IconName, Icon);
  return Icon ? <Icon /> : <MuiIcons.HelpOutline />; // fallback icon
};

const SideBar = ({ onParentMenuClick }) => {
  const navigate = useNavigate();
  const location = useLocation();

  const menus = useSelector((state) => state.menus.items);
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const dispatch = useDispatch();

  const [menuItems, setMenuItems] = useState(menus);

  useEffect(() => {
    let finalMenu = [];
    const storedMenu = menus;

    if (storedMenu) {
      try {
        const parsedMenu = storedMenu;
        if (Array.isArray(parsedMenu) && parsedMenu.length > 0) {
          // Filter to show only top-level menus
          finalMenu = parsedMenu.filter(
            (item) =>
              !item.hasChildren ||
              (item.hasChildren && item.children && item.children.length > 0)
          );
        }
      } catch (err) {
        console.error("Invalid menu data:", err);
      }
    }

    setMenuItems(finalMenu);
  }, [menus]);

  // // Highlight menu based on current route
  // useEffect(() => {
  //   if (menuItems.length > 0) {
  //     const activeIndex = menuItems.findIndex(
  //       (item) => location.pathname === item.route
  //     );
  //     if (activeIndex >= 0) dispatch(setSelectedMenuItem(activeIndex));
  //   }
  // }, [location.pathname, menuItems]);

  useEffect(() => {
    if (menuItems.length > 0) {
      const selectedItem = menuItems.find(
        (item) => location.pathname === item.route
      );

      if (selectedItem) {
        dispatch(setSelectedMenuItem(selectedItem));
      }
    }
  }, [location.pathname, menuItems]);

  const navigateToPage = (item) => {
    if (item.hasChildren) {
      // If it has children, call the parent click handler to display submenu
      onParentMenuClick(item.children, item.route);
      navigate(item.route);
    } else {
      // If no children, simply navigate
      onParentMenuClick(null); // Clear submenu
      navigate(item.route);
    }
    dispatch(setSelectedMenuItem(item));
  };

  const drawer = (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column" }}>
      {/* Logo Section */}
      <Box
        sx={{
          p: 2,
          borderBottom: "1px solid #E2E8F0",
          display: "flex",
          alignItems: "center",
          gap: 2,
        }}
      >
        <img src={f1Logo} alt="Logo" style={{ width: 50, height: 50 }} />
        <Box>
          <Typography variant="h6" sx={{ fontWeight: 700 }}>
            FinCore
          </Typography>
          <Typography variant="caption" color="text.secondary">
            Empowering Data
          </Typography>
        </Box>
      </Box>

      {/* Menu Items */}
      <List sx={{ flexGrow: 1, py: 1 }}>
        {menuItems.length > 0 ? (
          menuItems.map((item) => (
            <ListItem key={item.id} disablePadding>
              <ListItemButton
                selected={selectedMenuItem.id === item.id}
                onClick={() => navigateToPage(item)}
              >
                <ListItemIcon sx={{ minWidth: 40 }}>
                  {getIconComponent(item.icon)}
                </ListItemIcon>
                <ListItemText
                  primary={item.title}
                  sx={{
                    "& .MuiTypography-root": {
                      fontWeight: selectedMenuItem.id === item.id ? 600 : 400,
                      color:
                        selectedMenuItem.id === item.id
                          ? "primary.main"
                          : "text.primary",
                    },
                  }}
                />
                {item.badge && (
                  <Chip
                    size="small"
                    label={item.badge}
                    sx={{
                      height: 20,
                      fontSize: "0.7rem",
                      backgroundColor: "secondary.main",
                      color: "white",
                    }}
                  />
                )}
              </ListItemButton>
            </ListItem>
          ))
        ) : (
          <Typography
            variant="body2"
            color="text.secondary"
            sx={{ textAlign: "center", mt: 3 }}
          >
            No menu available
          </Typography>
        )}
      </List>

      {/* Support Section */}
      <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
        <Card>
          <CardContent sx={{ p: 2 }}>
            <Typography variant="subtitle2" sx={{ fontWeight: 600, mb: 1 }}>
              Need Help?
            </Typography>
            <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
              Contact our support team
            </Typography>
            <Button size="small" variant="contained" fullWidth>
              Connect to SCORE
            </Button>
          </CardContent>
        </Card>
      </Box>
    </Box>
  );

  return (
    <Box
      component="nav"
      sx={{ width: { md: drawerWidth }, flexShrink: { md: 0 } }}
    >
      <Drawer
        variant="permanent"
        sx={{
          display: { xs: "none", md: "block" },
          "& .MuiDrawer-paper": { width: drawerWidth, boxSizing: "border-box" },
        }}
        open
      >
        {drawer}
      </Drawer>
    </Box>
  );
};

export default SideBar;
