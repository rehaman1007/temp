private void validateExportLimit(LedgerEnquiryRequest dto) {

    StringBuilder sql = new StringBuilder("""
        SELECT COUNT(*)
        FROM GL_TRANSACTIONS g
        JOIN BRANCH_MASTER b
            ON g.BRANCH_CODE = b.CODE
        LEFT JOIN CIRCLE_MASTER c
            ON b.CIRCLE_CODE = c.CIRCLE_CODE
        WHERE 1=1
        """);

    List<Object> params = new ArrayList<>();

    sql.append(" AND g.CGL = ? ");
    params.add(dto.getCgl());

    sql.append("""
        AND g.TRANSACTION_DATE
        BETWEEN TO_DATE(?,'DD/MM/YYYY')
        AND TO_DATE(?,'DD/MM/YYYY')
        """);

    params.add(dto.getFromDate());
    params.add(dto.getToDate());

    // Currency
    if (dto.getCurrencies() != null &&
        !"ALL".equalsIgnoreCase(dto.getCurrencies())) {

        sql.append(" AND g.CURRENCY = ? ");
        params.add(dto.getCurrencies());
    }

    // Circle
    if ("DOMESTIC".equalsIgnoreCase(dto.getCircle())) {
        sql.append(" AND c.CIRCLE_CODE <> ? ");
        params.add(FOREIGN_CIRCLE);

    } else if ("FOREIGN".equalsIgnoreCase(dto.getCircle())) {
        sql.append(" AND c.CIRCLE_CODE = ? ");
        params.add(FOREIGN_CIRCLE);

    } else if (dto.getCircle() != null &&
            !"ALL".equalsIgnoreCase(dto.getCircle())) {

        sql.append(" AND c.CIRCLE_CODE = ? ");
        params.add(dto.getCircle());
    }

    // Branches
    if (dto.getBranches() != null
            && !dto.getBranches().isEmpty()
            && !dto.getBranches().contains("ALL")) {

        sql.append(" AND g.BRANCH_CODE IN (");
        sql.append(
            dto.getBranches()
               .stream()
               .map(v -> "?")
               .collect(Collectors.joining(","))
        );
        sql.append(")");

        params.addAll(dto.getBranches());
    }

    // Source Flags
    if (dto.getSourceFlags() != null
            && !dto.getSourceFlags().isEmpty()) {

        sql.append(" AND g.SOURCE_FLAG IN (");
        sql.append(
            dto.getSourceFlags()
               .stream()
               .map(v -> "?")
               .collect(Collectors.joining(","))
        );
        sql.append(")");

        params.addAll(dto.getSourceFlags());
    }

    Long count = jdbcTemplate.queryForObject(
            sql.toString(),
            Long.class,
            params.toArray()
    );

    log.info("Export record count = {}", count);

    if (count != null && count > MAX_EXPORT_LIMIT) {
        throw new ExportLimitException(
            "Excel export cannot be generated for more than 10 lakh records. Current count: " + count
        );
    }
}