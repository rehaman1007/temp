import React, { useEffect, useState } from "react";
import {
  Alert,
  AlertTitle,
  Box,
  Chip,
  Divider,
  LinearProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";

const LogsPanel = ({ lastResponse, jobStatus }) => {
  const theme = useTheme();
  const [elapsed, setElapsed] = useState(0);

  useEffect(() => {
    if (!jobStatus?.startedAt) return;

    if (jobStatus.status === "COMPLETED" || jobStatus.status === "FAILED") {
      setElapsed(Number(jobStatus?.elapsedSeconds || 0));
      return;
    }

    const updateElapsed = () => {
      const seconds = Math.floor(
        (Date.now() - Number(jobStatus.startedAt)) / 1000
      );
      setElapsed(seconds > 0 ? seconds : 0);
    };

    updateElapsed();
    const interval = setInterval(updateElapsed, 1000);
    return () => clearInterval(interval);
  }, [
    jobStatus?.startedAt,
    jobStatus?.completedAt,
    jobStatus?.status,
    jobStatus?.elapsedSeconds,
  ]);

  const SectionTitle = ({ title }) => (
    <Typography
      variant="subtitle2"
      sx={{
        fontWeight: 700,
        mb: 1.5,
        color: "text.primary",
        borderLeft: `4px solid ${theme.palette.primary.main}`,
        pl: 1.2,
      }}
    >
      {title}
    </Typography>
  );

  const InfoRow = ({ label, value }) => (
    <Stack direction="row" justifyContent="space-between">
      <Typography variant="body2" color="text.secondary">
        {label}
      </Typography>
      <Typography variant="body2" fontWeight={600}>
        {value}
      </Typography>
    </Stack>
  );

  if (!lastResponse && !jobStatus) {
    return (
      <Paper elevation={0}>
        <Box p={3}>
          <Alert severity="info">
            <AlertTitle>Waiting for execution</AlertTitle>
            Execute SQL query or upload script to view logs.
          </Alert>
        </Box>
      </Paper>
    );
  }

  const processed = Number(jobStatus?.processedCount || 0);
  const executed = Number(jobStatus?.executedCount || 0);
  const total = Number(jobStatus?.totalStatements || 0);
  const progress = Number(jobStatus?.progress || 0);
  const pending = Math.max(total - executed, 0);
  const currentSpeed = Number(jobStatus?.executionSpeed || 0);

  return (
    <Paper elevation={0} sx={{ borderRadius: 1, overflow: "hidden" }}>
      <Box
        sx={{
          px: 2.5,
          py: 1.5,
          background: "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
        }}
      >
        <Stack direction="row" justifyContent="space-between">
          <Stack direction="row" spacing={1}>
            <Terminal fontSize="small" />
            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>

          {jobStatus?.status && (
            <Chip
              size="small"
              label={jobStatus.status}
              color={
                jobStatus.status === "COMPLETED"
                  ? "success"
                  : jobStatus.status === "FAILED"
                  ? "error"
                  : "warning"
              }
            />
          )}
        </Stack>
      </Box>

      <Box
        sx={{
          p: 3,
          bgcolor: theme.palette.background.default,
          flex: 1,
          overflow: "auto",
          minHeight: 400,
        }}
      >
        {jobStatus && (
          <>
            <SectionTitle title="Live Execution Status" />

            <Box
              sx={{
                mb: 3,
                p: 2.5,
                borderRadius: 2,
                bgcolor: theme.palette.background.paper,
                border: `1px solid ${theme.palette.divider}`,
              }}
            >
              <Stack spacing={1.2}>
                <InfoRow label="Status" value={jobStatus.status} />
                <InfoRow label="Job ID" value={jobStatus.jobId || "-"} />
                <InfoRow label="Processed" value={processed.toLocaleString()} />
                <InfoRow label="Executed" value={executed.toLocaleString()} />
                <InfoRow label="Total" value={total.toLocaleString()} />
                <InfoRow label="Pending" value={pending.toLocaleString()} />
                <InfoRow
                  label="Speed"
                  value={`${currentSpeed.toLocaleString()} stmt/sec`}
                />
                <InfoRow label="Elapsed" value={`${elapsed} sec`} />

                <Box mt={2}>
                  <LinearProgress
                    variant="determinate"
                    value={progress}
                    sx={{ height: 10, borderRadius: 10 }}
                  />
                  <Typography variant="caption">
                    {progress}% Complete
                  </Typography>
                </Box>
              </Stack>
            </Box>
          </>
        )}

        {(lastResponse?.error || jobStatus?.status === "FAILED") && (
          <>
            <SectionTitle title="Error Log" />
            <Alert severity="error" variant="outlined" sx={{ mb: 3 }}>
              <AlertTitle>Execution Failed</AlertTitle>
              {lastResponse?.message ||
                jobStatus?.message ||
                "Unknown error"}

              {jobStatus?.failedLine && (
                <>
                  <Divider sx={{ my: 1 }} />
                  Failed Line : {jobStatus.failedLine}
                </>
              )}
            </Alert>
          </>
        )}

        {jobStatus?.failedSql && (
          <>
            <SectionTitle title="Failed SQL Statement" />
            <Box
              sx={{
                p: 2,
                mb: 3,
                borderRadius: 2,
                bgcolor: theme.palette.grey[100],
              }}
            >
              <Typography
                sx={{
                  whiteSpace: "pre-wrap",
                  fontFamily: "Consolas, monospace",
                  color: theme.palette.error.main,
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          </>
        )}

        {lastResponse && !lastResponse.error && (
          <>
            <SectionTitle title="Execution Result" />
            <Alert severity="success" variant="outlined" sx={{ mb: 3 }}>
              <AlertTitle>SQL Executed Successfully</AlertTitle>
              {lastResponse?.rows?.[0]?.RESULT ||
                "Execution completed successfully"}
            </Alert>
          </>
        )}

        {jobStatus && (
          <>
            <SectionTitle title="Execution Summary" />

            <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
              <Chip
                color="success"
                label={`INSERT ${jobStatus.insertCount || 0}`}
              />
              <Chip
                color="warning"
                label={`UPDATE ${jobStatus.updateCount || 0}`}
              />
              <Chip
                color="error"
                label={`DELETE ${jobStatus.deleteCount || 0}`}
              />
              <Chip
                color="info"
                label={`OTHERS ${jobStatus.otherCount || 0}`}
              />
            </Stack>
          </>
        )}

        {jobStatus?.status === "RUNNING" && (
          <Alert severity="warning" variant="outlined" sx={{ mt: 3 }}>
            <AlertTitle>Execution In Progress</AlertTitle>
            Pending statements : {pending.toLocaleString()}
          </Alert>
        )}
      </Box>
    </Paper>
  );
};

export default LogsPanel;
