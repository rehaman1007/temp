// useNotifications.js
import { useState, useEffect, useCallback, useRef } from "react";
import useApi from "./useApi";
import useStreamApi from "./useStreamApi";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const BASE_URL = "/NS/notifications";
const POPUP_DURATION = 5000;

const useNotifications = () => {
  const { callApi } = useApi();
  const { showSnackbar } = useCustomSnackbar();
  const { startStream, stopStream, lastMessage, connected } = useStreamApi();

  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [popupQueue, setPopupQueue] = useState([]);

  const popupTimers = useRef({});

  /** ---------------- FETCH UNREAD COUNT ---------------- */
  const fetchUnreadCount = useCallback(async () => {
    try {
      const data = await callApi(`${BASE_URL}/unread-count`);
      if (data?.count !== undefined) setUnreadCount(data.count);
    } catch (err) {
      console.error(err);
    }
  }, [callApi]);

  /** ---------------- POPUP QUEUE ---------------- */
  const addPopup = useCallback((notif) => {
    const popupId = `${notif.id}-${Date.now()}`;

    setPopupQueue((prev) => [...prev, { ...notif, popupId }]);

    popupTimers.current[popupId] = setTimeout(() => {
      removePopup(popupId);
    }, POPUP_DURATION);
  }, []);

  const removePopup = useCallback((popupId) => {
    setPopupQueue((prev) => prev.filter((p) => p.popupId !== popupId));

    if (popupTimers.current[popupId]) {
      clearTimeout(popupTimers.current[popupId]);
      delete popupTimers.current[popupId];
    }
  }, []);

  /** ---------------- SSE STREAM ---------------- */
  useEffect(() => {
    fetchUnreadCount();

    startStream(`${BASE_URL}/stream`, {
      onMessage: () => {},
    });

    return () => stopStream();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  /** ---------------- ON NEW NOTIFICATION ---------------- */
  useEffect(() => {
    if (!lastMessage) return;

    setNotifications((prev) => [lastMessage, ...prev]);
    setUnreadCount((prev) => prev + 1);
    addPopup(lastMessage);
  }, [lastMessage, addPopup]);

  return {
    connected,
    notifications,
    unreadCount,
    popupQueue,
    removePopup,
  };
};

export default useNotifications;

import React from "react";
import { Stack } from "@mui/material";
import { AnimatePresence } from "framer-motion";
import NotificationPopup from "./NotificationPopup";

const NotificationPopupStack = ({ popups, onClose, onClick }) => {
  return (
    <Stack
      spacing={1.2}
      sx={{
        position: "fixed",
        top: 16,
        right: 16,
        zIndex: 3000,
      }}
    >
      <AnimatePresence>
        {popups.map((popup) => (
          <NotificationPopup
            key={popup.popupId}
            popup={popup}
            onClose={() => onClose(popup.popupId)}
            onClick={() => onClick(popup)}
          />
        ))}
      </AnimatePresence>
    </Stack>
  );
};

export default NotificationPopupStack;

import React from "react";
import {
  Box,
  Typography,
  Avatar,
  Paper,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import { motion } from "framer-motion";
import { getIconComponent } from "../utils/IconUtils";
import { useSelector } from "react-redux";
import { formatRelativeTime } from "../utils/CommonUtilities";
import {
  paperStyles,
  avatarStyles,
  iconStyles,
} from "./NotificationStyles";

const MotionPaper = motion(Paper);

const NotificationPopup = ({ popup, onClose, onClick }) => {
  const menuItems = useSelector((state) => state.menus.menus);

  const menu = menuItems.find((m) => m.route === popup.linkUrl);
  const IconComp = getIconComponent(menu?.icon || "NotificationsActive");

  return (
    <MotionPaper
      layout
      initial={{ opacity: 0, x: 80 }}
      animate={{ opacity: 1, x: 0 }}
      exit={{ opacity: 0, x: 80 }}
      transition={{ duration: 0.25 }}
      elevation={10}
      sx={paperStyles}
    >
      <Avatar sx={avatarStyles}>
        <IconComp style={iconStyles} />
      </Avatar>

      <Box
        flex={1}
        sx={{ cursor: "pointer" }}
        onClick={onClick}
      >
        <Typography fontWeight={700}>
          {menu?.title || "Notification"}
        </Typography>

        <Typography variant="body2">
          {popup.message}
        </Typography>

        <Typography variant="caption" color="text.secondary">
          {formatRelativeTime(popup.createdAt)}
        </Typography>
      </Box>

      <IconButton size="small" onClick={onClose}>
        <CloseIcon fontSize="small" />
      </IconButton>
    </MotionPaper>
  );
};

export default NotificationPopup;

const {
  popupQueue,
  removePopup,
} = useNotifications();

<NotificationPopupStack
  popups={popupQueue}
  onClose={removePopup}
  onClick={(popup) => {
    removePopup(popup.popupId);
    // optional: navigate or mark read
  }}
/>
