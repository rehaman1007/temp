
Implement following changes in component so that other logic should not effect
 
1. Account Classification should be based on comp1 value (also onChange)
 if it starts with 1,6 then set Asset disable
 if it starts with 2,3,4 then set Liability disable
 if it starts with 5 then set Memo disable
 if it starts with 7 then set Income disable
 if it starts with 8 then set Expense disable
 else enable dropdown to choose any 
 
2. Balance Carry Forward to next year field should as follows 
 For Asset and Liability - Disabled (Checked)
 For Income and Expense - Disable (Unchecked)
 Else - Enable (can choose any) 
 
3.  Balance Compare Flag should Disable for Income and Expense with Exclude else enable can choose any for others

4. Default Balance type should be hidden no need to show in form but set values but auto set as following
 if Asset - Debit(D)
 if Liability - Credit(C)
 if Memo - Memo(M)
 if Income - Credit(C)
 if Expense - Debit(D)
 
 
 import React, {
  useEffect,
  useMemo,
  useCallback,
  useState,
  useRef,
} from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  Box,
  Grid,
  TextField,
  MenuItem,
  Paper,
  Typography,
  FormControlLabel,
  Checkbox,
  FormHelperText,
  FormControl,
  FormLabel,
  RadioGroup,
  Radio,
  Button,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import EditIcon from "@mui/icons-material/Edit";
import AddIcon from "@mui/icons-material/Add";
import BlockIcon from "@mui/icons-material/Block";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const ACCOUNT_CLASSIFICATIONS = [
  { value: "A", label: "Asset" },
  { value: "L", label: "Liability" },
  { value: "I", label: "Income" },
  { value: "E", label: "Expense" },
  { value: "M", label: "Memo A/c" },
];

const initialCGLState = {
  comp1: "",
  segmentCode: "",
  comp2: "",
  description: "",
  acClassification: "",
  balFwd: false,
  defBalType: "",
  balCompare: "1",
  manualPosting: "1",
  status: "Active",
  openDate: new Date().toISOString().split("T")[0],
  closeDate: null,
};

export default function CGLFormDialog({
  open,
  onClose,
  onSaved, // callback to parent to refresh list after successful save
  editInitialData = null, // when editing, parent passes the row object
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  // form state & validation lives here
  const [cglData, setCglData] = useState(initialCGLState);
  const [errors, setErrors] = useState({});
  const [editingId, setEditingId] = useState(null);
  const [isActive, setIsActive] = useState(false);
  const [segments, setSegments] = useState([]);
  const [blockConfirmOpen, setBlockConfirmOpen] = useState(false);

  // throttle snackbars during typing
  const snackGateRef = useRef(true);
  const notifyOnce = (msg, variant = "warning") => {
    if (!snackGateRef.current) return;
    snackGateRef.current = false;
    snackbar(msg, variant);
    setTimeout(() => (snackGateRef.current = true), 800);
  };

  // derived cglNumber
  const cglNumber = useMemo(() => {
    return cglData.comp1 && cglData.segmentCode && cglData.comp2
      ? `${cglData.comp1}${cglData.segmentCode}${String(cglData.comp2).padStart(
          2,
          "0"
        )}`
      : "";
  }, [cglData.comp1, cglData.segmentCode, cglData.comp2]);

  // load segments (dialog owns this API call)
  const fetchSegments = useCallback(async () => {
    const resp = await callApi(
      "/CM/segment-codes",
      { requestType: "SEGMENT_CODE" },
      "GET"
    );
    setSegments(resp?.data || []);
  }, [callApi]);

  // when dialog opens for Add or Edit, populate
  useEffect(() => {
    if (!open) return;
    fetchSegments();

    if (editInitialData) {
      // populate form from editInitialData
      setCglData({
        ...initialCGLState,
        ...editInitialData,
        comp1: String(editInitialData.comp1 ?? "").padStart(4, "0"),
        comp2: String(parseInt(editInitialData.comp2, 10) || ""),
        defBalType: editInitialData.defBalType ?? "",
        segmentCode: editInitialData.segmentCode ?? "",
        description: editInitialData.description ?? "",
        balFwd: !!editInitialData.balFwd,
      });
      setEditingId(editInitialData.cglNumber);
      setIsActive(editInitialData.status === 1);
      setErrors({});
    } else {
      // fresh
      setCglData(initialCGLState);
      setEditingId(null);
      setIsActive(false);
      setErrors({});
    }
  }, [open, editInitialData, fetchSegments]);

  // auto-derive defBalType + enforce balFwd disabled for Income/Expense
  useEffect(() => {
    if (!cglData.acClassification) return;
    let defBalType = cglData.defBalType;
    if (["A", "E", "M"].includes(cglData.acClassification)) defBalType = "D";
    if (["L", "I"].includes(cglData.acClassification)) defBalType = "C";

    setCglData((prev) => ({
      ...prev,
      defBalType,
      balFwd:
        prev.acClassification === "I" || prev.acClassification === "E"
          ? false
          : prev.balFwd,
    }));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [cglData.acClassification]);

  // single-field validator
  const validateField = useCallback((name, value) => {
    switch (name) {
      case "comp1":
        if (!value) return "Comp1 is required";
        if (!/^\d{4}$/.test(value)) return "Comp1 must be exactly 4 digits";
        if (parseInt(value, 10) < 1000) return "Comp1 must be ≥ 1000";
        return "";
      case "segmentCode":
        if (!value) return "Segment code is required";
        return "";
      case "comp2":
        if (!value) return "Comp2 is required";
        if (!/^\d{1,2}$/.test(value)) return "Comp2 must be 1 or 2 digits";
        if (parseInt(value, 10) < 1 || parseInt(value, 10) > 99)
          return "Comp2 must be between 01 and 99";
        return "";
      case "description":
        if (!value) return "Description is required";
        if (!/^[A-Za-z0-9 /&()\-]+$/.test(value))
          return "Only letters, digits, spaces, / & ( ) -";
        return "";
      case "acClassification":
        if (!value) return "Account classification is required";
        return "";
      case "defBalType":
        if (!value) return "Default balance type is required";
        return "";
      default:
        return "";
    }
  }, []);

  const isFormValid = useMemo(() => {
    const fields = [
      "comp1",
      "segmentCode",
      "comp2",
      "description",
      "acClassification",
      "defBalType",
    ];
    return fields.every((f) => !validateField(f, cglData[f]));
  }, [cglData, validateField]);

  // onChange with live validation + snackbars
  const handleChange = useCallback(
    (e) => {
      const { name, value, type, checked } = e.target;

      // hard-constraints / input blocking
      if (name === "comp1") {
        if (!/^\d*$/.test(value)) {
          notifyOnce("Comp1 accepts digits only");
          return;
        }
        if (value.length > 4) {
          notifyOnce("Comp1 must be exactly 4 digits");
          return;
        }
      }

      if (name === "comp2") {
        if (!/^\d*$/.test(value)) {
          notifyOnce("Comp2 accepts digits only");
          return;
        }
        if (value.length > 2) {
          notifyOnce("Comp2 max 2 digits");
          return;
        }
      }

      if (name === "description") {
        if (!/^[A-Za-z0-9 /&()\-]*$/.test(value)) {
          notifyOnce("Invalid character in Description");
          return;
        }
      }

      // update state
      setCglData((prev) => ({
        ...prev,
        [name]: type === "checkbox" ? checked : value,
      }));

      // set per-field error
      const msg = validateField(name, type === "checkbox" ? checked : value);
      setErrors((prev) => ({ ...prev, [name]: msg }));
    },
    [validateField]
  );

  const validateForm = useCallback(() => {
    const fields = [
      "comp1",
      "segmentCode",
      "comp2",
      "description",
      "acClassification",
      "defBalType",
    ];
    const newErrors = {};
    fields.forEach((f) => {
      const msg = validateField(f, cglData[f]);
      if (msg) newErrors[f] = msg;
    });
    setErrors(newErrors);
    if (Object.keys(newErrors).length) {
      snackbar("Please fix validation errors", "error");
      return false;
    }
    return true;
  }, [cglData, validateField, snackbar]);

  // submit — dialog does the API call
  const handleSubmit = useCallback(
    async (e) => {
      e?.preventDefault();
      if (!validateForm()) return;

      const apiEndpoint = "/CR/create-request";
      const method = "POST";
      const changeType = editingId ? "UPDATE" : "ADD";
      const reqStatus = "P";

      const innerPayload = {
        comp1: cglData.comp1,
        segmentCode: cglData.segmentCode,
        comp2: cglData.comp2,
        cglNumber: cglNumber,
        description: cglData.description,
        acClassification: cglData.acClassification,
        balFwd: cglData.balFwd ? 1 : 0,
        defBalType: cglData.defBalType,
        reqStatus,
        balCompare: cglData.balCompare,
        manualPosting: cglData.manualPosting,
      };

      const payloadData = {
        requestType: "CGL_CODE",
        changeType,
        payload: innerPayload,
      };

      try {
        const response = await callApi(apiEndpoint, payloadData, method);
        if (response) {
          snackbar(
            editingId ? "CGL updated successfully" : "CGL created successfully",
            "success"
          );
          // tell parent to refresh list
          onSaved?.();
          handleClose();
        } else {
          snackbar("No response from server", "error");
        }
      } catch (error) {
        snackbar(error?.message || "Request failed", "error");
      }
    },
    [callApi, cglData, cglNumber, editingId, onSaved, snackbar, validateForm]
  );

  const handleReset = useCallback(() => {
    setCglData(initialCGLState);
    setEditingId(null);
    setErrors({});
  }, []);

  const handleClose = useCallback(() => {
    onClose?.();
    handleReset();
    setBlockConfirmOpen(false);
  }, [onClose, handleReset]);

  // block flow — dialog owns the blocking behaviour (local mock here)
  const openBlockConfirm = useCallback(() => {
    setBlockConfirmOpen(true);
  }, []);
  const handleBlockConfirm = useCallback(async () => {
    // if your API exists, call it here. For now we just call a simple API shape:
    try {
      // example API (adjust per your backend)
      const payload = {
        requestType: "CGL_CODE",
        changeType: "BLOCK",
        payload: { cglNumber: editingId || cglNumber },
      };
      const resp = await callApi("/CR/block-cgl", payload, "POST");
      if (resp) {
        snackbar("Blocked successfully", "success");
        onSaved?.();
      } else {
        snackbar("Block failed", "error");
      }
    } catch (err) {
      snackbar(err?.message || "Block request failed", "error");
    } finally {
      setBlockConfirmOpen(false);
      handleClose();
    }
  }, [callApi, cglNumber, editingId, onSaved, snackbar, handleClose]);

  // expose an 'open as edit' helper for parent usage (parent can pass editInitialData)
  // but we also want to allow parent to just open dialog for create (editInitialData null)

  return (
    <>
      <Dialog open={open} onClose={handleClose} fullWidth maxWidth="sm">
        <DialogTitle>
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
            }}
          >
            <Typography variant="h6" color="primary">
              {editingId ? "Edit CGL" : "Add New CGL"}
            </Typography>
            <IconButton onClick={handleClose}>
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>

        <DialogContent>
          <Box component="form" onSubmit={handleSubmit}>
            <Grid xs={12} sm={6}>
              <Paper variant="outlined" sx={{ p: 2, width: "100%" }}>
                <Typography variant="body" color="textSecondary">
                  CGL Number: {cglNumber || ""}
                </Typography>
              </Paper>
            </Grid>

            <Grid xs={12} sm={6} spacing={2}>
              <Grid xs={12} sm={6}>
                <Box display="flex" gap={1}>
                  <TextField
                    fullWidth
                    label="Comp1 *"
                    name="comp1"
                    value={cglData.comp1}
                    onChange={handleChange}
                    error={!!errors.comp1}
                    helperText={errors.comp1 || "Exactly 4 digits (≥1000)"}
                    placeholder="1000 to 9999"
                    disabled={!!editingId}
                    inputProps={{ maxLength: 4, inputMode: "numeric" }}
                  />

                  <TextField
                    fullWidth
                    select
                    label="Segment Code *"
                    name="segmentCode"
                    value={cglData.segmentCode}
                    onChange={handleChange}
                    error={!!errors.segmentCode}
                    helperText={errors.segmentCode}
                    disabled={!!editingId}
                  >
                    <MenuItem value="">Select Segment</MenuItem>
                    {segments.map((segment) => (
                      <MenuItem
                        key={segment.segmentCode}
                        value={segment.segmentCode}
                      >
                        {segment.segmentCode} - {segment.description}
                      </MenuItem>
                    ))}
                  </TextField>

                  <TextField
                    fullWidth
                    label="Comp2 *"
                    name="comp2"
                    value={cglData.comp2}
                    onChange={handleChange}
                    error={!!errors.comp2}
                    helperText={errors.comp2 || "01 - 99"}
                    placeholder="01-99"
                    disabled={!!editingId}
                    inputProps={{ maxLength: 2, inputMode: "numeric" }}
                  />
                </Box>
              </Grid>

              <Grid xs={12} sm={6}>
                <TextField
                  fullWidth
                  label="Description *"
                  name="description"
                  value={cglData.description}
                  onChange={handleChange}
                  error={!!errors.description}
                  inputProps={{ maxLength: 100 }}
                  helperText={
                    errors.description ||
                    "Allowed: letters, numbers, spaces, / & ( ) -"
                  }
                  multiline
                  rows={3}
                />
              </Grid>

              <Grid xs={12} sm={6}>
                <Box display="flex" gap={2}>
                  <TextField
                    select
                    fullWidth
                    label="Account Classification *"
                    name="acClassification"
                    value={cglData.acClassification}
                    onChange={handleChange}
                    error={!!errors.acClassification}
                    helperText={errors.acClassification}
                  >
                    <MenuItem value="">Select Classification</MenuItem>
                    {ACCOUNT_CLASSIFICATIONS.map((option) => (
                      <MenuItem key={option.value} value={option.value}>
                        {option.label}
                      </MenuItem>
                    ))}
                  </TextField>

                  <TextField
                    select
                    fullWidth
                    label="Default Balance Type *"
                    name="defBalType"
                    value={cglData.defBalType}
                    onChange={handleChange}
                    error={!!errors.defBalType}
                    helperText={errors.defBalType}
                  >
                    <MenuItem value="">Select Type</MenuItem>
                    <MenuItem value="D">Debit</MenuItem>
                    <MenuItem value="C">Credit</MenuItem>
                  </TextField>
                </Box>
              </Grid>

              <Grid xs={12} sm={6}>
                <FormControlLabel
                  control={
                    <Checkbox
                      name="balFwd"
                      checked={cglData.balFwd}
                      onChange={handleChange}
                      disabled={["I", "E"].includes(cglData.acClassification)}
                    />
                  }
                  label="Balance Carry Forward to next year"
                />
                <FormHelperText>
                  {["I", "E"].includes(cglData.acClassification)
                    ? "Not applicable for Income/Expense accounts"
                    : ""}
                </FormHelperText>
              </Grid>

              <Grid xs={12} sm={6} md={6}>
                <FormControl component="fieldset">
                  <FormLabel component="legend">Balance Compare Flag</FormLabel>
                  <RadioGroup
                    row
                    name="balCompare"
                    value={cglData.balCompare}
                    onChange={handleChange}
                  >
                    <FormControlLabel
                      value="1"
                      control={<Radio />}
                      label="Include"
                    />
                    <FormControlLabel
                      value="0"
                      control={<Radio />}
                      label="Exclude"
                    />
                  </RadioGroup>
                </FormControl>
              </Grid>

              <Grid xs={12} sm={6} md={6}>
                <FormControl component="fieldset">
                  <FormLabel component="legend">Manual Posting Flag</FormLabel>
                  <RadioGroup
                    row
                    name="manualPosting"
                    value={cglData.manualPosting}
                    onChange={handleChange}
                  >
                    <FormControlLabel
                      value="1"
                      control={<Radio />}
                      label="Allowed"
                    />
                    <FormControlLabel
                      value="0"
                      control={<Radio />}
                      label="Not Allowed"
                    />
                  </RadioGroup>
                </FormControl>
              </Grid>

              {editingId && (
                <Grid xs={12} sm={6}>
                  <TextField
                    fullWidth
                    label="Status"
                    value={isActive ? "Active" : "In-Active"}
                    disabled
                  />
                </Grid>
              )}
            </Grid>

            <Box
              sx={{
                mt: 3,
                display: "flex",
                gap: 1,
                justifyContent: "flex-end",
              }}
            >
              {!editingId && (
                <Button onClick={handleReset} variant="outlined">
                  Reset
                </Button>
              )}

              <Button
                type="submit"
                variant="contained"
                startIcon={editingId ? <EditIcon /> : <AddIcon />}
                disabled={!isFormValid}
              >
                {editingId ? "Update CGL" : "Add CGL"}
              </Button>

              {editingId && (
                <Button
                  onClick={openBlockConfirm}
                  variant="contained"
                  color="error"
                  startIcon={<BlockIcon />}
                >
                  Block CGL
                </Button>
              )}
            </Box>
          </Box>
        </DialogContent>
      </Dialog>

      {/* Block confirmation dialog (owned by dialog component) */}
      <Dialog
        open={blockConfirmOpen}
        onClose={() => setBlockConfirmOpen(false)}
      >
        <DialogTitle>Block CGL</DialogTitle>
        <DialogContent>
          <Typography>
            Are you sure you want to block CGL {editingId || cglNumber}?
          </Typography>
        </DialogContent>
        <Box sx={{ display: "flex", gap: 1, justifyContent: "flex-end", p: 2 }}>
          <Button onClick={() => setBlockConfirmOpen(false)}>Cancel</Button>
          <Button
            color="error"
            variant="contained"
            onClick={handleBlockConfirm}
          >
            Block
          </Button>
        </Box>
      </Dialog>
    </>
  );
}
