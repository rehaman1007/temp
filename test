import React, { useState, useEffect } from "react";
import CountdownPage from "./CountdownPage";
import CelebrationOverlay from "./CelebrationOverlay";
import { fetchLaunchData } from "../services/launchApi";
import Login from "../../../features/auth/pages/Login";
import LoadingOverlay from "../../../utils/LoadingOverlay";

const LaunchScreen = () => {
  const [launchData, setLaunchData] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [showCelebration, setShowCelebration] = useState(false);
  const [isLaunched, setIsLaunched] = useState(false);

  useEffect(() => {
    const checkLaunchStatus = async () => {
      try {
        const data = await fetchLaunchData();

        // CHANGED: Removed 'Z' (UTC) and appended '+05:30' (IST)
        // This explicitly tells the browser the incoming 10:00:00 is IST.
        // The browser will then correctly calculate the countdown relative to the user's system clock.
        const target = new Date(`${data.prodDate}T${data.launchTime}+05:30`);

        if (target.getTime() <= Date.now()) {
          setIsLaunched(true);
        } else {
          setLaunchData({ ...data, targetDate: target });
        }
      } catch (error) {
        console.error("Failed to fetch launch data", error);
        setIsLaunched(true);
      } finally {
        setIsLoading(false);
      }
    };

    checkLaunchStatus();
  }, []);

  const handleCountdownComplete = () => {
    setShowCelebration(true);
  };

  const handleCelebrationComplete = () => {
    setShowCelebration(false);
    setIsLaunched(true);
  };

  // if (isLoading) return <LoadingOverlay loading={isLoading} />; // Or use your PageLoader
  if (isLoading) return <div>Loading</div>; // Or use your PageLoader

  if (isLaunched) return <Login />;

  return (
    <>
      {showCelebration ? (
        <CelebrationOverlay
          version={launchData?.version}
          onComplete={handleCelebrationComplete}
        />
      ) : (
        <CountdownPage
          targetDate={launchData?.targetDate}
          appName={launchData?.appName}
          version={launchData?.version}
          onCountdownComplete={handleCountdownComplete}
        />
      )}
    </>
  );
};

export default LaunchScreen;

