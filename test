import { useEffect } from "react";
import { useLocation, useNavigate } from "react-router-dom";
import { useSelector } from "react-redux";
import {
  Box,
  Button,
  Typography,
  Paper,
  Container,
  Stack,
} from "@mui/material";
import { styled } from "@mui/system";
import LogoImg from "../assets/Logos/Fincore_transperent.svg";
import fTitle from "../assets/Logos/Fincore_title.png";
import FindInPageIcon from "@mui/icons-material/FindInPage";
import { ArrowBack, Home } from "@mui/icons-material";

const Background = styled(Box)(() => ({
  position: "absolute",
  inset: 0,
  backgroundImage: "url('/src/assets/glass-bg.jpg')",
  backgroundSize: "cover",
  backgroundPosition: "center",
  opacity: 0.15,
  zIndex: 0,
}));

const BlurOverlay = styled(Box)({
  position: "absolute",
  inset: 0,
  backdropFilter: "blur(40px)",
  zIndex: 1,
});

const Card = styled(Paper)(({ theme }) => ({
  position: "relative",
  zIndex: 2,
  maxWidth: 500,
  width: "100%",
  margin: "auto",
  padding: theme.spacing(4),
  borderRadius: theme.spacing(3),
  backdropFilter: "blur(24px)",
  backgroundColor: "rgba(255, 255, 255, 0.05)",
  border: "1px solid rgba(255,255,255,0.1)",
  textAlign: "center",
  [theme.breakpoints.up("sm")]: {
    padding: theme.spacing(6),
  },
}));

const NotFound = () => {
  const location = useLocation();
  const navigate = useNavigate();
  const menus = useSelector((state) => state.menus.menus);

  useEffect(() => {
    console.error(
      "404 Error: User attempted to access non-existent route:",
      location.pathname
    );
  }, [location.pathname]);

  // Dynamic routing logic extracted from your successful login block
  const handleHomeNavigation = () => {
    if (menus && menus.length > 0 && menus[0]?.route) {
      if (menus[0].hasChildren) {
        navigate("/choose-option" + menus[0]?.route, { replace: true });
      } else {
        navigate(menus[0]?.route, { replace: true });
      }
    } else {
      // Emergency absolute fallback if menus are cleared or unauthenticated
      navigate("/", { replace: true });
    }
  };

  return (
    <Box
      sx={{
        minHeight: "100vh",
        position: "relative",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        p: 2,
        // Blue ambient gradient to match the premium glassmorphism design system
        background:
          "linear-gradient(to bottom right, rgba(25, 118, 210, 0.08), rgba(0, 0, 0, 0.4))",
      }}
    >
      <Background />
      <BlurOverlay />

      <Container
        maxWidth="sm"
        sx={{ zIndex: 2, display: "flex", justifyContent: "center" }}
      >
        <Card>
          {/* BRANDING LOGO & TITLE IMAGES */}
          <Box
            sx={{
              mb: 4,
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              gap: 1.5,
            }}
          >
            <Box
              component="img"
              src={LogoImg}
              alt="FinCore Logo"
              sx={{
                height: 36,
                width: "auto",
                objectFit: "contain",
              }}
            />
            <Box
              component="img"
              src={fTitle}
              alt="FinCore"
              sx={{
                height: 22,
                width: "auto",
                objectFit: "contain",
              }}
            />
          </Box>

          {/* 404 NAVIGATION NOT FOUND ICON */}
          <Box sx={{ display: "flex", justifyContent: "center", mb: 3 }}>
            <Box
              sx={{
                p: 2,
                borderRadius: "50%",
                backgroundColor: "rgba(25, 118, 210, 0.15)",
                display: "inline-flex",
              }}
            >
              <FindInPageIcon sx={{ fontSize: 40, color: "primary.main" }} />
            </Box>
          </Box>

          {/* ERROR CODE & TITLE */}
          <Typography
            variant="h1"
            sx={{
              fontWeight: 800,
              mb: 1,
              background: "linear-gradient(to right, #1976D2, #82B1FF)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              fontSize: { xs: "2.5rem", sm: "3.5rem" },
            }}
          >
            404
          </Typography>

          <Typography variant="h5" sx={{ mb: 2, fontWeight: 600 }}>
            Page Not Found
          </Typography>

          <Typography
            sx={{ color: "text.secondary", mb: 4, fontSize: "0.95rem" }}
          >
            The destination link you are attempting to locate has either shifted, 
            expired, or contains a broken address parameter.
          </Typography>

          {/* ROUTE LOCATION CONTEXT NOTICE */}
          <Paper
            elevation={0}
            sx={{
              backgroundColor: "rgba(255, 255, 255, 0.02)",
              border: "1px solid rgba(255, 255, 255, 0.08)",
              borderRadius: 2,
              p: 2,
              mb: 4,
            }}
          >
            <Typography
              variant="subtitle2"
              sx={{ color: "text.primary", fontWeight: 600, mb: 0.5 }}
            >
              Requested Target URL
            </Typography>
            <Typography
              variant="body2"
              sx={{ 
                color: "primary.main", 
                fontSize: "0.85rem", 
                fontFamily: "monospace",
                wordBreak: "break-all" 
              }}
            >
              {location.pathname}
            </Typography>
          </Paper>

          {/* ACTION NAVIGATION BUTTONS */}
          <Stack
            spacing={2}
            direction={{ xs: "column", sm: "row" }}
            justifyContent="center"
          >
            <Button
              onClick={() => navigate(-1)}
              variant="outlined"
              startIcon={<ArrowBack sx={{ fontSize: 18 }} />}
              fullWidth
              sx={{
                borderColor: "rgba(255,255,255,0.15)",
                color: "text.primary",
                "&:hover": {
                  borderColor: "rgba(255,255,255,0.3)",
                  backgroundColor: "rgba(255,255,255,0.05)",
                },
              }}
            >
              Go Back
            </Button>
            <Button
              variant="contained"
              onClick={handleHomeNavigation}
              startIcon={<Home sx={{ fontSize: 18 }} />}
              fullWidth
            >
              Portal Home
            </Button>
          </Stack>
        </Card>
      </Container>
    </Box>
  );
};

export default NotFound;
