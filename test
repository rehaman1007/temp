const allowedYear = nextFYInfo?.expectedStart?.year();

const [selectedYear, setSelectedYear] = useState(null);
const [inputValue, setInputValue] = useState("");
const [error, setError] = useState("");

<LocalizationProvider dateAdapter={AdapterDayjs}>
  <DatePicker
    views={["year"]}
    label="Financial Year*"
    value={selectedYear ? dayjs(`${selectedYear}-01-01`) : null}
    disabled={!allowedYear}

    // ONLY picker selection
    onChange={(val) => {
      if (!val) return;
      const year = val.year();

      setSelectedYear(year);
      setInputValue(String(year));
      setError("");
    }}

    slotProps={{
      textField: {
        size: "small",
        fullWidth: true,
        value: inputValue,
        error: Boolean(error),

        onChange: (e) => {
          const val = e.target.value;

          // allow typing
          if (!/^\d*$/.test(val)) return;

          setInputValue(val);
          setError("");
        },

        onBlur: () => {
          // validate AFTER typing
          if (inputValue.length !== 4) {
            setError("Enter a valid 4-digit year");
            setInputValue("");
            setSelectedYear(null);
            return;
          }

          const year = Number(inputValue);

          if (year !== allowedYear) {
            setError(
              `Only Financial Year ${allowedYear}-${allowedYear + 1} is allowed`
            );
            setInputValue("");
            setSelectedYear(null);
            return;
          }

          setSelectedYear(year);
          setError("");
        },

        helperText: error
          ? error
          : selectedYear
          ? `Selected Financial Year: ${selectedYear}-${selectedYear + 1} (April–March)`
          : allowedYear
          ? `Allowed Financial Year: ${allowedYear}-${allowedYear + 1}`
          : "",

        inputProps: {
          maxLength: 4,
          inputMode: "numeric",
        },

        FormHelperTextProps: {
          sx: {
            mt: 1,
            fontSize: "0.9rem",
            fontWeight: 500,
            color: error ? "#d32f2f" : "#6500caff",
          },
        },
      },
    }}
  />
</LocalizationProvider>