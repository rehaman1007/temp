import React, { useState, useEffect } from "react";
import { Box, Dialog, DialogTitle, DialogContent, DialogActions, TextField, Typography, Button, Stack, Tooltip, IconButton, Chip } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

export default function CommonRequestScreen({
  apiUrl,
  patchUrl,
  columns,
  transformData,
  defaultSort = { field: "reqDate", sort: "desc" }
}) {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [remarks, setRemarks] = useState("");
  const [confirmDialog, setConfirmDialog] = useState({ open: false, type: null, rowId: null });

  const fetchData = async () => {
    setLoading(true);
    try {
      const response = await callApi(apiUrl, {}, "GET");
      let data = response?.data || response || [];

      if (transformData) data = transformData(data);

      setRows(data);
      if (!data.length) showSnackBar("No pending requests found", "warning");
    } catch (err) {
      console.error(err);
      showSnackBar("Error fetching data", "error");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleConfirm = async () => {
    if (confirmDialog.type === "reject" && !remarks.trim()) {
      showSnackBar("Please provide remarks before rejecting", "warning");
      return;
    }

    try {
      const payload = {
        requestId: confirmDialog.rowId,
        status: confirmDialog.type === "reject" ? "REJECTED" : "ACCEPTED",
        remarks: confirmDialog.type === "reject" ? remarks.trim() : "No Remarks"
      };
      const res = await callApi(patchUrl, payload, "PATCH");

      if (res?.success || res) {
        showSnackBar(confirmDialog.type === "accept" ? "Request Approved" : "Request Rejected", "success");
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error while processing request", "error");
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  // Add actions column dynamically
  const allColumns = [
    ...columns,
    {
      field: "actions",
      headerName: "Actions",
      sortable: false,
      flex: 0.6,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Stack direction="row" spacing={1} alignItems="center" justifyContent="center">
          <Tooltip title="Approve">
            <IconButton size="small" onClick={() => openConfirmDialog("accept", params.row.id)} color="success">
              <CheckIcon fontSize="inherit" />
            </IconButton>
          </Tooltip>
          <Tooltip title="Reject">
            <IconButton size="small" onClick={() => openConfirmDialog("reject", params.row.id)} color="error">
              <ClearIcon fontSize="inherit" />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    }
  ];

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={allColumns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [defaultSort] }
        }}
        getRowId={(row) => row.id}
        loading={loading}
        sx={{
          height: 600,
          width: "100%",
          "& .MuiDataGrid-cell:focus": { outline: "none" }
        }}
      />

      <Dialog open={confirmDialog.open} onClose={closeConfirmDialog} maxWidth="sm" fullWidth>
        <DialogTitle>{confirmDialog.type === "accept" ? "Confirm Approval" : "Confirm Rejection"}</DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 2 }}>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Please enter remarks."}
          </Typography>
          {confirmDialog.type === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={closeConfirmDialog} color="inherit" variant="contained">Cancel</Button>
          <Button onClick={handleConfirm} color={confirmDialog.type === "accept" ? "success" : "error"} variant="contained">
            {confirmDialog.type === "accept" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
