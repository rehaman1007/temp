import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogContentText,
  DialogActions,
  Button,
  Typography,
  Box,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";

export const DeleteConfirmDialog = ({
  open,
  deleteDialog,
  onClose,
  onConfirmRow,
  onConfirmColumn,
}) => {
  if (!deleteDialog) return null;

  return (
    <Dialog open={open} onClose={onClose}>
      <DialogTitle>
        Confirm Deletion
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 10 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent>
        <DialogContentText>
          {deleteDialog.type === "row"
            ? "This row is referenced in:"
            : "This column is referenced in:"}
        </DialogContentText>

        <Box mt={1} maxHeight={200} overflow="auto">
          {deleteDialog.references.map((r, i) => (
            <Typography key={i} color="error">
              • {r}
            </Typography>
          ))}
        </Box>

        <DialogContentText sx={{ mt: 2 }}>
          Deleting will remove these references. Continue?
        </DialogContentText>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          color="error"
          variant="contained"
          onClick={() => {
            if (deleteDialog.type === "row")
              onConfirmRow(deleteDialog.rowId);
            else
              onConfirmColumn(
                deleteDialog.colId,
                deleteDialog.index,
              );
          }}
        >
          Delete Anyway
        </Button>
      </DialogActions>
    </Dialog>
  );
};