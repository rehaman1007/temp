const dicgcCalculations = (report = {}) => {
  if (!report) return {};

  const updated = { ...report };

  // --- Helper functions ---
  const toValue = (val) => (isNaN(val) || val === null || val === undefined ? 0 : parseFloat(val));
  const sumValues = (...args) => args.reduce((sum, v) => sum + toValue(v), 0);
  const diffOk = (a, b, tolerance = 5) =>
    Math.abs(toValue(a) - toValue(b)) <= tolerance ? "OK" : Math.abs(toValue(a) - toValue(b));

  // --- SECTION 1: Initial Totals ---
  updated.input4t = sumValues(updated.input1bid, updated.input3bid);
  updated.input6t = sumValues(updated.input4t, updated.input5t);
  updated.input13 = sumValues(updated.input8bid, updated.input10, updated.input11, updated.input12);
  updated.input14 = sumValues(updated.input6t, updated.input13);
  updated.input17 = sumValues(updated.input15bid, updated.input16bid);
  updated.input20 = sumValues(updated.input18bid, updated.input19bid);
  updated.input23 = sumValues(updated.input21bid, updated.input22bid);

  const input37List = [
    updated.input17,
    updated.input20,
    updated.input23,
    updated.input24bid,
    updated.input25bid,
    updated.input26bid,
    updated.input27bid,
    updated.input28bid,
    updated.input29bid,
    updated.input30bid,
    updated.input31bid,
    updated.input32bid,
    updated.input33bid,
    updated.input34bid,
    updated.input35bid,
    updated.input36bid,
  ];
  updated.input37 = input37List.reduce((sum, v) => sum + toValue(v), 0);

  updated.input38 = toValue(updated.input14) - toValue(updated.input37);
  updated.input40 = ((toValue(updated.input39) * toValue(updated.input38)) / 10000).toFixed(2);

  // --- SECTION 2: Totals by Roman Numerals ---
  const romanKeys = [
    "I",
    "II",
    "III",
    "IV",
    "V",
    "VI",
    "VII",
    "VIII",
    "IX",
    "X",
    "XI",
    "XII",
    "XIIb",
    "XIII",
    "XIV",
  ];

  romanKeys.forEach((key) => {
    updated[`input${key}t`] = sumValues(updated[`input${key}bid`], updated[`input${key}a`]);
  });

  updated.inputXIIbt = sumValues(updated.inputXIIbbid, updated.inputXIIba);
  updated.inputxxiibid = updated.input36bid;

  // --- VALIDATIONS ---
  const validations = {
    validate1: updated.inputIt === updated.inputI,
    validate2: updated.inputIVt === updated.inputIV,
    validate3: updated.inputXIt === updated.inputXI,
    validate4: updated.inputXIIt === updated.inputXII,
    validate5: updated.inputXIIbt === updated.inputXIIb,
    validate6: updated.inputXIIIt === updated.inputXIII,
    validate7: updated.inputXIVt === updated.inputXIV,
  };

  // --- RECALCULATE SECTION 1 (Net Impact Adjustments) ---
  updated.input1bid = sumValues(actualInputi, updated.inputIa, updated.inputXIIIa, updated.inputXIVa);
  updated.input3bid = sumValues(actualInputii, updated.inputIVa);
  updated.input8bid = sumValues(
    actualInputiii,
    updated.inputXIa,
    -updated.inputXIIa,
    -updated.inputXIIba
  );
  updated.input26bid = sumValues(actualInput26bid, updated.inputXIIIa);

  // Reapply derived totals
  updated.input4t = sumValues(updated.input1bid, updated.input3bid);
  updated.input6t = sumValues(updated.input4t, updated.input5t);
  updated.input13 = sumValues(updated.input8bid, updated.input10, updated.input11, updated.input12);
  updated.input14 = sumValues(updated.input6t, updated.input13);
  updated.input17 = sumValues(updated.input15bid, updated.input16bid);
  updated.input20 = sumValues(updated.input18bid, updated.input19bid);
  updated.input23 = sumValues(updated.input21bid, updated.input22bid);
  updated.input37 = input37List.reduce((sum, v) => sum + toValue(v), 0);
  updated.input38 = toValue(updated.input14) - toValue(updated.input37);
  updated.input40 = ((toValue(updated.input39) * toValue(updated.input38)) / 10000).toFixed(2);

  // --- Adjusted QSA Figures for DICGC ---
  updated.input2XI = sumValues(updated.inputIt, updated.inputIVt, updated.inputXIIIt, updated.inputXIVt);
  updated.input2XII = toValue(updated.inputXIIt);
  updated.input2XIII = toValue(updated.inputXIt) - toValue(updated.inputXIIt) - toValue(updated.inputXIIbt);
  updated.input2XIV = sumValues(updated.inputIIt, updated.inputVt, updated.inputVIt);
  updated.input2XV = sumValues(updated.inputVIIt, updated.inputVIIIt);
  updated.input2XVI = toValue(updated.inputXIIIt);
  updated.input2XVII = toValue(updated.inputXIVt);

  // --- Extra Adjustments ---
  if (!bidDataFlag) {
    updated.input8bid = updated.input2XIII;
  }

  // --- Results (Comparison with QSA) ---
  if (!bidDataFlag) {
    updated.input2XVIII = diffOk(updated.input2XI, sumValues(updated.input4t, updated.input5t));
  } else {
    updated.input2XVIII = diffOk(updated.input2XI, updated.input4t);
  }

  updated.input2XX = diffOk(updated.input2XIII, updated.input8bid);
  updated.input2XXI = diffOk(updated.input2XIV, updated.input24bid);
  updated.input2XXII = diffOk(updated.input2XV, sumValues(updated.input27bid, updated.inputIXt, updated.inputXt));
  updated.input2XXIII = diffOk(updated.input2XVI, updated.input26bid);

  updated.input2XXIV = !bidDataFlag
    ? diffOk(updated.input2XVII, sumValues(updated.input1bid, updated.input5t, -updated.inputIt, -updated.inputXIIIt))
    : diffOk(updated.input2XVII, sumValues(updated.input1bid, -updated.inputIt, -updated.inputXIIIt));

  // --- SECTION 4: Account Checks ---
  if (!bidDataFlag) {
    actualInput4aamount = updated.input4aamount;
  }

  updated.input4aamount = sumValues(
    actualInput4aamount,
    updated.inputIa,
    updated.inputXIIIa,
    updated.inputXIVa,
    updated.inputIVa,
    updated.inputXIa,
    -updated.inputXIIa,
    -updated.inputXIIba
  );

  updated.input4haccount = sumValues(
    updated.input4aaccount,
    updated.input4baccount,
    updated.input4caccount,
    updated.input4daccount
  );

  updated.input4hamount = sumValues(
    updated.input4aamount,
    updated.input4bamount,
    updated.input4camount,
    updated.input4damount
  );

  ["a", "b", "c", "d"].forEach((key) => {
    updated[`input4${key}amountTot`] = sumValues(
      updated[`input4${key}amount`],
      updated[`input4${key}amountAdj`]
    );
  });

  updated.input4hamountAdj = sumValues(
    updated.input4aamountAdj,
    updated.input4bamountAdj,
    updated.input4camountAdj,
    updated.input4damountAdj
  );

  updated.input4hamountTot = sumValues(
    updated.input4aamountTot,
    updated.input4bamountTot,
    updated.input4camountTot,
    updated.input4damountTot
  );

  // --- Check Points Table I ---
  updated.input4xi = (toValue(updated.input4aaccount) * 1).toFixed(0);
  updated.input4xiv = (toValue(updated.input4baccount) * 500001).toFixed(0);
  updated.input4xvii = (toValue(updated.input4caccount) * 750001).toFixed(0);
  updated.input4xx = (toValue(updated.input4daccount) * 1000001).toFixed(0);

  updated.input4xii = (toValue(updated.input4aaccount) * 500000).toFixed(0);
  updated.input4xv = (toValue(updated.input4baccount) * 750000).toFixed(0);
  updated.input4xviii = (toValue(updated.input4caccount) * 1000000).toFixed(0);

  const checkRange = (val, min, max) =>
    toValue(val) >= toValue(min) && toValue(val) <= toValue(max) ? "OK" : "INCORRECT";

  updated.input4xiii = checkRange(updated.input4aamount, updated.input4xi, updated.input4xii);
  updated.input4xvi = checkRange(updated.input4bamount, updated.input4xiv, updated.input4xv);
  updated.input4xix = checkRange(updated.input4camount, updated.input4xvii, updated.input4xviii);
  updated.input4xxii = toValue(updated.input4damount) >= toValue(updated.input4xx) - 1 ? "OK" : "INCORRECT";

  // --- Check Points Table II ---
  updated.input4xxiii = Math.abs(toValue(updated.input38));
  updated.input4xxiv = bidDataFlag
    ? Math.abs(toValue(updated.input4hamountTot))
    : Math.abs(toValue(updated.input4hamount));

  updated.input4xxv =
    toValue(updated.input4xxiii) === toValue(updated.input4xxiv)
      ? "OK"
      : toValue(updated.input4xxiii) - toValue(updated.input4xxiv);

  return { ...updated, ...validations };
};