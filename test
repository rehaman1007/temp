  errorText,
}) {
  const columns = [
    {
      field: "USERID",
      headerName: "User Id",
      flex: 0.7,
      sortable: true,
    },
    {
      field: "__name",
      headerName: "User Name",
      flex: 1.4,
      sortable: true,
    },

    { field: "ROLE_NAME", headerName: "Role", flex: 0.8, sortable: true },

    // {
    //   field: "ACCOUNT_STATUS",
    //   headerName: "Account Status",
    //   flex: 1,
    //   sortable: true,
    //   align: "center",
    //   headerAlign: "center",
    //   renderCell: (params) => (
    //     <CustomChip
    //       icon={<OnlinePredictionIcon />}
    //       label={toPascalKebabCase(params.value)}
    //       variant="outlined"
    //     />
    //   ),
    // },

    { field: "EMAIL", headerName: "Email", flex: 1.2, sortable: true },
    { field: "PHONE_NUMBER", headerName: "Phone", flex: 0.9, sortable: true },
    {
      field: "action",
      headerName: "Action",
      sortable: false,
      flex: 1,
      align: "center",
      headerAlign: "center",
      filterable: false,
      disableColumnMenu: true,
      renderCell: (params) => (
        <Stack
          direction="row"
          spacing={0.5}
          alignItems="center"
          justifyContent="center"
          sx={{ height: "100%" }}
