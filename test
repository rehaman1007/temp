import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  SmartScreen,
  Link as LinkIcon,
  Visibility,
  VisibilityOff,
  AccountBalance,
  Shield,
  InfoOutlined,
} from "@mui/icons-material";
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  Divider,
  Drawer,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  useTheme,
  useMediaQuery,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { userAvatarCreator } from "../utils/userUtilities";
import { useContext, useEffect, useState } from "react";
import { AuthContext } from "../context/AuthContext";

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);

  const theme = useTheme();
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));
  
  // State for toggling phone number visibility
  const [showPhone, setShowPhone] = useState(false);

  const formatCode = (code, length) => {
    if (code === undefined || code === null || code === "") return "N/A";
    return String(code).padStart(length, "0");
  };

  const branchDisplay = user?.branchName
    ? `${user.branchName.trim()} (${formatCode(user.branch, 5)})`
    : "N/A";

  const circleDisplay = user?.circleName
    ? `${user.circleName.trim()} (${formatCode(user.circleCode, 3)})`
    : "N/A";

  const formatPhoneNumber = (phone) => {
    if (!phone) return "N/A";
    if (showPhone) return phone;
    // Mask all but the last 4 digits
    const visibleDigits = phone.slice(-4);
    const maskedSection = "•".repeat(Math.max(0, phone.length - 4));
    return `${maskedSection}${visibleDigits}`;
  };

  useEffect(() => {
    const handleKeyDown = (event) => {
      if (
        !isMobileOrTablet &&
        event.altKey &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();
        logout();
      }

      if (event.key === "Escape" && profileDrawerOpen) {
        setProfileDrawerOpen(false);
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, setProfileDrawerOpen, isMobileOrTablet]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={() => setProfileDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: { xs: "85vw", sm: 380 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          p: 0,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: { xs: 1.5, sm: 2 }, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Scrollable Content - Margins and paddings tightened to avoid scroll */}
      <Box
        sx={{
          p: { xs: 1.5, sm: 2 },
          overflowY: "auto",
          overflowX: "hidden",
          flex: 1,
        }}
      >
        {/* User Identity Section */}
        <Box sx={{ textAlign: "center", mb: 1.5 }}>
          <Avatar
            sx={{
              width: 64, // Reduced from 80 to save space
              height: 64,
              mx: "auto",
              mb: 1,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "1.5rem",
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Typography variant="h6" sx={{ fontWeight: 600, mb: 0.25, fontSize: '1.1rem' }}>
            {`${user.firstName} ${user.middleName ? user.middleName + " " : ""}${user.lastName}`}
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
            User ID: {user.userId} • Role ID: {user.role}
          </Typography>
          <Chip
            label={user.roleName}
            size="small"
            sx={{
              backgroundColor: "#10B981",
              color: "white",
              fontWeight: 500,
              height: 24,
            }}
          />
        </Box>

        {/* Organizational Information */}
        <Card sx={{ mb: 1.5 }}>
          {/* Override default last-child padding to save space */}
          <CardContent sx={{ p: 1.5, "&:last-child": { pb: 1.5 } }}>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{ fontWeight: 700, mb: 0.5, fontSize: "0.7rem", letterSpacing: "1px" }}
            >
              SERVICE INFORMATION
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={1.5}>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <Business sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Branch
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {branchDisplay}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <AccountTree sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Circle
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {circleDisplay}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <AccountBalance sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Circle Branch
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {formatCode(user.circleBranch, 5)}
                  </Typography>
                </Box>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        {/* Access Configuration (New Section for Missing Data) */}
        <Card sx={{ mb: 1.5 }}>
          <CardContent sx={{ p: 1.5, "&:last-child": { pb: 1.5 } }}>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{ fontWeight: 700, mb: 0.5, fontSize: "0.7rem", letterSpacing: "1px" }}
            >
              ACCESS CONFIGURATION
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={1.5}>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <SmartScreen sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    System Level
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {user.isCircle ? "Circle Level" : "Branch Level"}
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <Shield sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Role Access
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 500 }}>
                    {user.accessName} ({user.roleAccess})
                  </Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "flex-start", gap: 1.5 }}>
                <InfoOutlined sx={{ color: "text.secondary", fontSize: 18, mt: 0.25 }} />
                <Box>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Access Description
                  </Typography>
                  <Typography variant="caption" sx={{ fontWeight: 500, lineHeight: 1.1, display: 'block' }}>
                    {user.accessDescription}
                  </Typography>
                </Box>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        {/* Contact Information */}
        <Card sx={{ mb: 1.5 }}>
          <CardContent sx={{ p: 1.5, "&:last-child": { pb: 1.5 } }}>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{ fontWeight: 700, mb: 0.5, fontSize: "0.7rem", letterSpacing: "1px" }}
            >
              CONTACT INFORMATION
            </Typography>
            <Divider sx={{ mb: 1 }} />
            <Stack spacing={1.5}>
              <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                <Email sx={{ color: "text.secondary", fontSize: 18 }} />
                <Box sx={{ minWidth: 0 }}>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                    Email
                  </Typography>
                  <Typography variant="body2" sx={{ wordBreak: "break-all" }}>
                    {user.email}
                  </Typography>
                </Box>
              </Box>
              
              <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                  <Phone sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box>
                    <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1 }}>
                      Contact No
                    </Typography>
                    <Typography variant="body2" sx={{ fontFamily: showPhone ? 'inherit' : 'monospace', fontSize: showPhone ? '0.875rem' : '1rem' }}>
                      {formatPhoneNumber(user.phoneNumber)}
                    </Typography>
                  </Box>
                </Box>
                <IconButton 
                  onClick={() => setShowPhone(!showPhone)} 
                  size="small"
                  sx={{ color: "text.secondary" }}
                >
                  {showPhone ? <VisibilityOff fontSize="small" /> : <Visibility fontSize="small" />}
                </IconButton>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        {/* Footer Actions (Your Original Code) */}
        <List sx={{ p: 0 }}>
          <ListItem disablePadding sx={{ px: 1 }}>
            <ListItemButton
              onClick={() => {
                navigate("/help");
                setProfileDrawerOpen(false);
              }}
              sx={{
                borderRadius: "12px",
                py: 1, // Reduced padding
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                color: "primary.main",
                "&:hover": {
                  backgroundColor: "action.hover",
                  borderLeftColor: "primary.main",
                  "& .help-icon": {
                    transform: "translateX(5px)",
                  },
                },
              }}
            >
              <ListItemIcon className="help-icon" sx={{ color: "primary.main", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <Help fontSize="small" />
              </ListItemIcon>
              <ListItemText
                primary={<Typography variant="body2" sx={{ fontWeight: 600 }}>Help & Support</Typography>}
              />
            </ListItemButton>
          </ListItem>

          <ListItem disablePadding sx={{ mt: 0.5, px: 1 }}>
            <ListItemButton
              component="a"
              href="https://score.sbi/"
              target="_blank"
              rel="noopener noreferrer"
              sx={{
                borderRadius: "12px",
                py: 1, // Reduced padding
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                color: "primary.main",
                "&:hover": {
                  backgroundColor: (theme) => `${theme.palette.primary.main}14`,
                  borderLeftColor: "primary.main",
                  "& .connect-icon": {
                    transform: "translateX(5px)",
                    color: "primary.dark",
                  },
                },
              }}
            >
              <ListItemIcon className="connect-icon" sx={{ color: "primary.main", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <LinkIcon fontSize="small" />
              </ListItemIcon>
              <ListItemText
                primary={<Typography variant="body2" sx={{ fontWeight: 700 }}>Connect to SCORE</Typography>}
              />
            </ListItemButton>
          </ListItem>

          <Divider sx={{ my: 0.5 }} />

          <ListItem disablePadding sx={{ mt: 0.5, px: 1 }}>
            <ListItemButton
              onClick={logout}
              sx={{
                borderRadius: "12px",
                py: 1, // Reduced padding
                transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
                borderLeft: "4px solid transparent",
                position: "relative",
                overflow: "hidden",
                color: "error.main",
                "&:hover": {
                  backgroundColor: (theme) => `${theme.palette.error.main}14`,
                  borderLeftColor: "error.main",
                  "& .logout-icon": {
                    transform: "translateX(5px)",
                    color: "error.dark",
                  },
                  "& .shortcut-hint": {
                    opacity: 1,
                    transform: "scale(1.05)",
                    backgroundColor: "error.main",
                    color: "white",
                  },
                },
              }}
            >
              <ListItemIcon className="logout-icon" sx={{ color: "error.light", minWidth: "40px", transition: "transform 0.3s ease" }}>
                <Logout fontSize="small" />
              </ListItemIcon>
              <ListItemText
                primary={<Typography variant="body2" sx={{ fontWeight: 700 }}>Sign Out</Typography>}
              />
              {!isMobileOrTablet && (
                <Box
                  className="shortcut-hint"
                  sx={{
                    fontSize: "9px",
                    fontWeight: 800,
                    px: 1,
                    py: 0.3,
                    borderRadius: "6px",
                    border: "1px solid",
                    borderColor: "divider",
                    opacity: 0.6,
                    transition: "all 0.3s ease",
                    textTransform: "uppercase",
                  }}
                >
                  Alt + L
                </Box>
              )}
            </ListItemButton>
          </ListItem>
        </List>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
