import { useEffect, useState, useCallback } from "react";
import { Box, Fab } from "@mui/material";
import useApi from "../../../hooks/useApi";

import UsersTable from "../components/UsersTable";
import UserDialog from "../components/UserDialog";
import DeleteConfirmDialog from "../components/DeleteConfirmDialog";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import AddIcon from "@mui/icons-material/Add";

const API_URL = "/UM/user/user-details";

export default function UserManagement() {
  const { callApi, loading, error: apiError } = useApi();

  // ---- server data ----
  const [rows, setRows] = useState([]);
  const [roles, setRoles] = useState([]);
  const [uiError, setUiError] = useState("");

  const [selection, setSelection] = useState([]);

  const emailDomain = "@sbi.co.in";
  //const emailPrefix = 50;
  // ---- local CRUD dialog state ----
  const emptyForm = {
    id: null,
    USERID: "",
    FIRST_NAME: "",
    MIDDLE_NAME: "",
    LAST_NAME: "",
    EMAIL: emailDomain,
    PHONE_NUMBER: "",
    ROLE_NAME: "",
    ROLE_ID: "",
  };
  const [form, setForm] = useState(emptyForm);
  const [initialState, setInitialState] = useState({});
  const [openEdit, setOpenEdit] = useState(false);
  const [openView, setOpenView] = useState(false);
  const [isViewMode, setIsViewMode] = useState(false);

  // ---- delete dialog ----
  const [deleteTarget, setDeleteTarget] = useState(null);

  const snackbar = useCustomSnackbar();

  const normalizeUsers = useCallback((users = []) => {
    return users.map((u, idx) => {
      const USERID = u?.USERID ?? u?.userId ?? "";
      const first = (u?.FIRST_NAME ?? u?.firstName ?? "").toString().trim();
      const last = (u?.LAST_NAME ?? u?.lastName ?? "").toString().trim();
      const name = [first, last].filter(Boolean).join(" ");
      const roleIdRaw = u?.ROLE_ID ?? u?.roleId ?? "";
      const parsedRoleId =
        typeof roleIdRaw === "number"
          ? roleIdRaw
          : Number.isNaN(parseInt(roleIdRaw, 10))
          ? roleIdRaw
          : parseInt(roleIdRaw, 10);

      return {
        id: USERID || String(idx + 1),
        USERID,
        FIRST_NAME: first,
        LAST_NAME: last,
        EMAIL: (u?.EMAIL ?? u?.email ?? "").toString(),
        PHONE_NUMBER: (u?.PHONE_NUMBER ?? u?.phone ?? "").toString(),
        ROLE_NAME: (u?.ROLE_NAME ?? u?.roleName ?? "").toString().trim(),
        ROLE_ID: parsedRoleId,
        BRANCH: (u?.BRANCH ?? u?.branch ?? "").toString(),
        __name: name || USERID || "(unknown)",
        ACCOUNT_STATUS: u?.ACCOUNT_STATUS,
      };
    });
  }, []);

  const fetchUsers = useCallback(async () => {
    setUiError("");
    try {
      const data = await callApi(API_URL, null, "GET");
      const users = data?.result?.users ?? [];
      setRows(normalizeUsers(users));
    } catch (e) {
      console.error(e);
      setRows([]);
      // setUiError(
      //   "Failed to fetch users. Check network, CORS, or API availability."
      // );
    }
  }, [callApi, normalizeUsers]);

  const fetchRoles = useCallback(async () => {
    try {
      const data = await callApi(
        "/UM/role/get-roles",
        { permissions: false },
        "GET"
      );
      const raw = data?.result?.roles ?? [];
      setRoles(
        raw.map((r) => ({
          id: r?.roleId,
          name: (r?.roleName ?? "").trim(),
          description: r?.description ?? "",
        }))
      );
    } catch (e) {
      console.error("Error while fetching roles", e);
    }
  }, [callApi]);

  const findRole = useCallback(
    (id) => roles.find((r) => String(r.id) === String(id)),
    [roles]
  );

  useEffect(() => {
    fetchUsers();
    fetchRoles();
  }, [fetchUsers, fetchRoles]);

  const removeUser = useCallback(
    (id) => setRows((prev) => prev.filter((r) => r.id !== id)),
    []
  );

  const effectiveError =
    apiError?.response?.data?.message || apiError?.message || uiError || "";

  if (effectiveError !== "") {
    snackbar(
      apiError?.response?.data?.message || apiError?.message || uiError,
      "error"
    );
  }

  return (
    <Box sx={{ p: { xs: 2, md: 0 } }}>
      <Box variant="outlined" sx={{ mt: 2 }}>
        <UsersTable
          rows={rows}
          roles={roles}
          loading={loading}
          onSelectionChange={setSelection}
          onEditRow={(row) => {
            const matched = findRole(row.ROLE_ID);
            setForm({
              ...row,
              ROLE_ID: matched ? matched.id : row.ROLE_ID,
              ROLE_NAME: matched ? matched.name : row.ROLE_NAME,
            });
            setInitialState({
              ...row,
              ROLE_ID: matched ? matched.id : row.ROLE_ID,
              ROLE_NAME: matched ? matched.name : row.ROLE_NAME,
            });
            setOpenEdit(true);
          }}
          onViewRow={(row) => {
            const matched = findRole(row.ROLE_ID);
            setForm({
              ...row,
              ROLE_ID: matched ? matched.id : row.ROLE_ID,
              ROLE_NAME: matched ? matched.name : row.ROLE_NAME,
            });

            setIsViewMode(true);
            setOpenView(true);
          }}
          onDeleteRow={(row) => setDeleteTarget(row)}
          errorText={effectiveError}
        />
      </Box>

      <UserDialog
        open={openEdit}
        onClose={() => setOpenEdit(false)}
        roles={roles}
        form={form}
        setForm={setForm}
        initialState={initialState}
      />

      <DeleteConfirmDialog
        open={!!deleteTarget}
        name={deleteTarget?.__name || deleteTarget?.USERID}
        onCancel={() => setDeleteTarget(null)}
        onConfirm={() => {
          if (deleteTarget?.id) removeUser(deleteTarget.id);
          setDeleteTarget(null);
        }}
      />
      <Fab
        sx={{
          position: "fixed",
          borderRadius: "4px",
          fontSize: "15px",
          bottom: "64px",
          right: "32px",
          zIndex: 1200,
        }}
        onClick={() => {
          setForm({ ...emptyForm });
          setOpenEdit(true);
        }}
        // disabled={loading || errorText}
        color="primary"
        variant="extended"
      >
        <AddIcon />
        Create
      </Fab>
    </Box>
  );
}


