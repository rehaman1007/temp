import { useEffect, useState, useRef } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ProcessStatusTable from "./components/ProcessStatusTable";
import ProcessDetailsDialog from "./components/ProcessDetailsDialog";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";
import { Grid, Box, Button, Paper } from "@mui/material";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import dayjs from "dayjs";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { DatePicker } from "@mui/x-date-pickers/DatePicker";
import PlayArrowIcon from "@mui/icons-material/PlayArrow";
import TaskAltIcon from "@mui/icons-material/TaskAlt";

/* ======================================================
   NORMALIZE STAGES (LATEST PER processStage)
====================================================== */
const normalizeStageDetails = (stageDetails = []) => {
  const stageMap = new Map();

  stageDetails.forEach((stage) => {
    const key = stage.processStage;
    const existing = stageMap.get(key);

    if (!existing || stage.startTime > existing.startTime) {
      stageMap.set(key, stage);
    }
  });

  return Array.from(stageMap.values())
    .sort((a, b) => a.processStage - b.processStage)
    .map((stage) => ({
      ...stage,
      _START_TIME_RAW: stage.startTime,
      _END_TIME_RAW: stage.endTime,
      startTime: stage.startTime ? timeStampFormatter(stage.startTime) : null,
      endTime: stage.endTime ? timeStampFormatter(stage.endTime) : null,
    }));
};

/* ======================================================
   NORMALIZE PROCESS SNAPSHOT
====================================================== */
const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType,
    stageDetails: normalizeStageDetails(p.stageDetails),
  }));

/* ======================================================
   MERGE SNAPSHOTS (PROCESS LEVEL ONLY)
====================================================== */
const mergeProcesses = (prev = [], incoming = []) => {
  const map = new Map(prev.map((p) => [p.type, p]));
  incoming.forEach((p) => map.set(p.type, p)); // replace
  return Array.from(map.values());
};

const ProcessStatusPage = () => {
  const [processes, setProcesses] = useState([]);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [loading, setLoading] = useState(true);
  const [selectedDate, setSelectedDate] = useState("2026-01-21");

  const snackbar = useCustomSnackbar();
  const token = useSelector((state) => state.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const INITIAL_URL = "/PS/process/processes/data";
  const STREAM_URL = `${service}/process/processes-testing`;

  /* ================= INITIAL LOAD ================= */
  const initialFetchDone = useRef(false);

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    let mounted = true;

    callApi(INITIAL_URL, null)
      .then((data) => {
        if (mounted && Array.isArray(data)) {
          setProcesses(normalizeProcesses(data));
        }
      })
      .catch(() => snackbar("Failed to load processes"))
      .finally(() => mounted && setLoading(false));

    return () => {
      mounted = false;
    };
  }, []);

  /* ================= SSE STREAM ================= */
  useEffect(() => {
    if (loading) return;

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },

      onmessage(event) {
        if (event.event === "connected") return;

        try {
          const raw = JSON.parse(event.data);
          if (!Array.isArray(raw)) return;

          const normalized = normalizeProcesses(raw);

          setProcesses((prev) => mergeProcesses(prev, normalized));
        } catch (e) {
          console.error("SSE parse error", e);
        }
      },
    });

    return () => controller.abort();
  }, [loading, STREAM_URL, token]);

  return (
    <Paper sx={{ p: 2, minHeight: "70vh" }}>
      <Box sx={{ m: 2 }}>
        <Grid container spacing={2} alignItems="center" justifyContent="center">
          {/* First Row: Centered Date Picker */}
          <Grid
            size={{ xs: 12 }}
            sx={{ display: "flex", justifyContent: "center" }}
          >
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <DatePicker label="ETL Date" defaultValue={dayjs(selectedDate)} />
            </LocalizationProvider>
          </Grid>

          {/* Second Row: Icon Button */}
          <Grid size={{ xs: 12, md: 6 }} sx={{ textAlign: "center" }}>
            <Button
              variant="contained"
              size="large"
              startIcon={<PlayArrowIcon />}
              sx={{
                fontWeight: "bold",
                fontSize: "1.1rem",
                boxShadow: " rgb(38, 57, 77) 0px 20px 30px -10px",
                "&:hover": {
                  boxShadow: "0 6px 20px rgba(30, 60, 114, 0.4)",
                },
                transition: "all 0.3s ease",
              }}
            >
              Start EOD
            </Button>
          </Grid>

          <Grid size={{ xs: 12, md: 6 }} sx={{ textAlign: "center" }}>
            <Button
              variant="contained"
              size="large"
              startIcon={<TaskAltIcon />}
              sx={{
                fontWeight: "bold",
                fontSize: "1.1rem",
                boxShadow: " rgb(38, 57, 77) 0px 20px 30px -10px",
                "&:hover": {
                  boxShadow: "0 6px 20px rgba(30, 60, 114, 0.4)",
                },
                transition: "all 0.3s ease",
              }}
            >
              Finish EOD
            </Button>
          </Grid>
        </Grid>
      </Box>
      <ProcessDetailsDialog
        process={selectedProcess}
        onClose={() => setSelectedProcess(null)}
      />

      <ProcessStatusTable
        loading={loading}
        processes={processes}
        actions={{
          onView: setSelectedProcess,
          onStop: () => {},
          onRestart: () => {},
        }}
      />
    </Paper>
  );
};

export default ProcessStatusPage;
