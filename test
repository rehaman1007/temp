package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.sql.ResultSetMetaData;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    @Override
    public Map<String, Object> executeAdminSql(AdminSupportDTO adminSupportDTO) {
        String rawSql = adminSupportDTO.getSql().trim();

        // 1. Split script by semicolon
        String[] statements = rawSql.split(";");

        // Filter out empty lines/comments to get "Real" statements
        List<String> cleanStatements = new ArrayList<>();
        for (String s : statements) {
            String clean = s.replaceAll("(?m)^--.*", "").trim();
            if (!clean.isEmpty()) cleanStatements.add(clean);
        }

        // 2. LOGIC: Is this a single SELECT query?
        boolean isSingleSelect = cleanStatements.size() == 1 &&
                cleanStatements.get(0).toUpperCase().startsWith("SELECT");

        log.info("Admin SQL Request - Mode: {}", isSingleSelect ? "SELECT_GRID" : "SCRIPT_EXECUTION");

        int page = (adminSupportDTO.getPage() != null) ? adminSupportDTO.getPage() : 0;
        int size = (adminSupportDTO.getSize() != null) ? adminSupportDTO.getSize() : 5;

        if (isSingleSelect) {
            String executableSelect = cleanStatements.get(0);
            try {
                // A. Syntax Validation (EXPLAIN PLAN)
                try {
                    jdbcTemplate.execute("EXPLAIN PLAN FOR " + executableSelect);
                } catch (DataAccessException e) {
                    return Map.of("error", true, "message", "Oracle Syntax Error: " + e.getMostSpecificCause().getMessage());
                }

                // B. Count records for Pagination
                String countSql = "SELECT COUNT(*) FROM (" + executableSelect + ")";
                Integer total = jdbcTemplate.queryForObject(countSql, Integer.class);
                final Integer finalTotal = (total == null) ? 0 : total;

                // C. Paginated Query (Oracle 12c+)
                String paginatedSql = String.format("%s OFFSET %d ROWS FETCH NEXT %d ROWS ONLY", executableSelect, (page * size), size);

                return jdbcTemplate.query(paginatedSql, rs -> {
                    ResultSetMetaData metaData = rs.getMetaData();
                    int columnCount = metaData.getColumnCount();

                    List<Map<String, String>> columns = new ArrayList<>();
                    for (int i = 1; i <= columnCount; i++) {
                        columns.add(Map.of("name", metaData.getColumnLabel(i)));
                    }

                    List<Map<String, Object>> rows = new ArrayList<>();
                    while (rs.next()) {
                        Map<String, Object> row = new HashMap<>();
                        for (int i = 1; i <= columnCount; i++) {
                            Object value = rs.getObject(i);
                            if (value instanceof java.io.InputStream) value = "[BLOB DATA]";
                            else if (value != null && value.getClass().getName().startsWith("oracle.sql.")) value = value.toString();
                            row.put(metaData.getColumnLabel(i), value);
                        }
                        rows.add(row);
                    }

                    return Map.of(
                            "columns", columns, "rows", rows, "total", finalTotal,
                            "page", page, "size", size, "error", false
                    );
                });

            } catch (Exception e) {
                log.error("Execution Error", e);
                return Map.of("error", true, "message", "Execution failed: " + e.getMessage());
            }
        } else {
            // 3. SCRIPT EXECUTION (DDL or Multiple Statements)
            try {
                int successfulStatements = 0;
                for (String execSql : cleanStatements) {
                    try {
                        jdbcTemplate.execute(execSql);
                        successfulStatements++;
                    } catch (DataAccessException e) {
                        throw new RuntimeException("Error in statement " + (successfulStatements + 1) + ": " + e.getMostSpecificCause().getMessage());
                    }
                }
                return Map.of(
                        "error", false,
                        "columns", List.of(Map.of("name", "RESULT")),
                        "rows", List.of(Map.of("RESULT", "Script completed successfully. " + successfulStatements + " statements processed.")),
                        "total", successfulStatements
                );
            } catch (Exception e) {
                log.error("Script Error", e);
                return Map.of("error", true, "message", e.getMessage());
            }
        }
    }
}
