import React from "react";
import {
  Box,
  Typography,
  Avatar,
  Slide,
  Paper,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import { getIconComponent } from "../utils/IconUtils";
import { useSelector } from "react-redux";
import { formatRelativeTime } from "../utils/CommonUtilities";
// Import styles from the new file
import {
  paperStyles,
  avatarStyles,
  iconStyles,
  menuTitleStyles,
  messageTextStyles,
  captionTextStyles,
} from "./NotificationStyles"; // Adjust path as needed

const NotificationPopup = ({ popup, handleNotificationClick, onClose }) => {
  const menuItems = useSelector((state) => state.menus.menus);

  if (!popup) return null;

  /** Find menu icon & title */
  const menu = menuItems.find((m) => m.route === popup.linkUrl);
  const IconComp = getIconComponent(menu?.icon || "NotificationsActive");
  const menuTitle = menu?.title || "FinCore";

  return (
    <Slide in={!!popup} direction="left" mountOnEnter unmountOnExit>
      <Paper
        onClick={handleNotificationClick}
        elevation={10}
        sx={paperStyles} // Use the imported style object
      >
        {/* ICON */}
        <Box>
          <Avatar
            sx={avatarStyles} // Use the imported style object
          >
            <IconComp style={iconStyles} />{" "}
            {/* Use the imported style object */}
          </Avatar>

          {/* TEXTS */}
          <Box flex={1}>
            <Typography fontWeight={700} sx={menuTitleStyles}>
              {menuTitle}
            </Typography>

            <Typography variant="body2" sx={messageTextStyles}>
              {popup.message}
            </Typography>

            <Typography variant="caption" sx={captionTextStyles}>
              {formatRelativeTime(popup.createdAt || popup.receivedAt)}
            </Typography>
          </Box>
        </Box>
        <IconButton size="small" onClick={onClose}>
          <CloseIcon fontSize="small" />
        </IconButton>
      </Paper>
    </Slide>
  );
};

export default NotificationPopup;
