else if (columnType.contains("TIMESTAMP")) {

    Timestamp ts = rs.getTimestamp(i);

    String formatted =
            ts.toLocalDateTime()
              .format(
                  DateTimeFormatter.ofPattern(
                      "yyyy-MM-dd HH:mm:ss"
                  )
              );

    values.append(
            "TO_TIMESTAMP('")
          .append(formatted)
          .append(
              "','YYYY-MM-DD HH24:MI:SS')"
          );
}

else if ("DATE".equalsIgnoreCase(columnType)) {

    Date date = rs.getDate(i);

    values.append(
            "TO_DATE('")
          .append(date)
          .append(
              "','YYYY-MM-DD')"
          );
}