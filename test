export default function App() {
  const [mode, setMode] = useState("decrypt");

  const [sessionKey, setSessionKey] = useState("");
  const [inputData, setInputData] = useState("");
  const [outputData, setOutputData] = useState("");

  const [showKey, setShowKey] = useState(false);

  const [snackbar, setSnackbar] = useState({
    open: false,
    message: "",
    severity: "success",
  });

  // =========================================================
  // NOTIFICATIONS
  // =========================================================

  const showNotification = (
    message,
    severity = "error"
  ) => {
    setSnackbar({
      open: true,
      message,
      severity,
    });
  };

  const handleCloseSnackbar = (
    event,
    reason
  ) => {
    if (reason === "clickaway") return;

    setSnackbar((prev) => ({
      ...prev,
      open: false,
    }));
  };

  // =========================================================
  // MODE CHANGE
  // =========================================================

  const handleModeChange = (
    event,
    newMode
  ) => {
    if (!newMode) return;

    setMode(newMode);
    setInputData("");
    setOutputData("");
  };

  // =========================================================
  // CLEAR PAYLOAD
  // =========================================================

  const handleClearPayload = () => {
    setInputData("");
    setOutputData("");

    showNotification(
      "Payload cleared.",
      "info"
    );
  };

  // =========================================================
  // COPY
  // =========================================================

  const handleCopy = async (
    textToCopy,
    successMessage = "Copied to clipboard!"
  ) => {
    if (!textToCopy) return;

    try {
      await navigator.clipboard.writeText(
        textToCopy
      );

      showNotification(
        successMessage,
        "success"
      );
    } catch (error) {
      showNotification(
        "Unable to copy content.",
        "error"
      );
    }
  };

  // =========================================================
  // FORMAT OUTPUT
  // =========================================================

  const formatOutput = (data) => {
    if (
      typeof data === "object" &&
      data !== null
    ) {
      return JSON.stringify(
        data,
        null,
        2
      );
    }

    try {
      const parsed = JSON.parse(data);

      return JSON.stringify(
        parsed,
        null,
        2
      );
    } catch (error) {
      return String(data);
    }
  };

  // =========================================================
  // ENCRYPT / DECRYPT
  // =========================================================

  const handleProcess = async () => {
    setOutputData("");

    if (!sessionKey.trim()) {
      showNotification(
        "Session Key is required.",
        "warning"
      );
      return;
    }

    if (!inputData.trim()) {
      showNotification(
        "Please provide a payload to process.",
        "warning"
      );
      return;
    }

    try {
      if (mode === "decrypt") {
        const decryptedRaw =
          await decryptPayload(
            inputData.trim(),
            sessionKey.trim()
          );

        setOutputData(
          formatOutput(decryptedRaw)
        );

        showNotification(
          "Payload decrypted successfully!",
          "success"
        );
      } else {
        let parsedInput;

        try {
          parsedInput = JSON.parse(
            inputData
          );
        } catch (error) {
          showNotification(
            "Invalid JSON format. Please provide valid JSON before encrypting.",
            "error"
          );
          return;
        }

        const encryptedString =
          await encryptPayload(
            parsedInput,
            sessionKey.trim()
          );

        setOutputData(
          encryptedString
        );

        showNotification(
          "Payload encrypted successfully!",
          "success"
        );
      }
    } catch (error) {
      console.error(error);

      showNotification(
        error?.message ||
          `Failed to ${mode} payload. Please verify your key and payload.`,
        "error"
      );
    }
  };

