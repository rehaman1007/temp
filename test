CREATE SEQUENCE FINCORE.PROCESS_STAGE_SEQ START WITH 1;
CREATE SEQUENCE FINCORE.PROCESS_DAG_SEQ START WITH 1;
CREATE SEQUENCE FINCORE.PROCESS_MASTER_SEQ START WITH 1;
CREATE SEQUENCE FINCORE.PROCESS_RUN_SEQ START WITH 1;
CREATE SEQUENCE FINCORE.PROCESS_RUN_STAGE_SEQ START WITH 1;

