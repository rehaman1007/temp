import React, { useState } from "react";
import {
  Box,
  Button,
  Container,
  Paper,
  TextField,
  Typography,
  ToggleButton,
  ToggleButtonGroup,
  Alert,
  CssBaseline,
  ThemeProvider,
  createTheme,
  InputAdornment,
  IconButton,
  Tooltip,
  Snackbar,
} from "@mui/material";
import LockOutlinedIcon from "@mui/icons-material/LockOutlined";
import LockOpenOutlinedIcon from "@mui/icons-material/LockOpenOutlined";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import ContentCopyIcon from "@mui/icons-material/ContentCopy";
import DeleteOutlineIcon from "@mui/icons-material/DeleteOutline";

// Ensure this path matches where you placed your copied crypto utility
import { encryptPayload, decryptPayload } from "./utils/cryptoUtil";

const theme = createTheme({
  palette: {
    mode: "light",
    background: {
      default: "#f4f6f8",
    },
    primary: {
      main: "#1976d2",
    },
  },
});

export default function App() {
  const [mode, setMode] = useState("decrypt");
  const [sessionKey, setSessionKey] = useState("");
  const [inputData, setInputData] = useState("");
  const [outputData, setOutputData] = useState("");
  const [showKey, setShowKey] = useState(false);
  
  // Unified Snackbar State
  const [snackbar, setSnackbar] = useState({
    open: false,
    message: "",
    severity: "success", // 'success' | 'error' | 'warning' | 'info'
  });

  // --- Handlers ---

  const handleCloseSnackbar = (event, reason) => {
    if (reason === "clickaway") return;
    setSnackbar((prev) => ({ ...prev, open: false }));
  };

  const showNotification = (message, severity = "error") => {
    setSnackbar({
      open: true,
      message,
      severity,
    });
  };

  const handleModeChange = (event, newMode) => {
    if (newMode !== null) {
      setMode(newMode);
      setInputData("");
      setOutputData("");
    }
  };

  const handleClearPayload = () => {
    setInputData("");
    setOutputData("");
  };

  const handleCopy = () => {
    if (outputData) {
      navigator.clipboard.writeText(outputData);
      showNotification("Copied to clipboard!", "success");
    }
  };

  // Format output for structured display (handles Objects, Arrays, Strings, Numbers)
  const formatOutput = (data) => {
    if (typeof data === "object") {
      return JSON.stringify(data, null, 2);
    }
    // Attempt to parse string to JSON for pretty printing
    try {
      const parsed = JSON.parse(data);
      return JSON.stringify(parsed, null, 2);
    } catch (e) {
      // If it's a plain string, number, or non-JSON string, return as is
      return String(data);
    }
  };

  const handleProcess = async () => {
    setOutputData("");

    // 1. Validation
    if (!sessionKey.trim()) {
      showNotification("Session Key is required.");
      return;
    }
    if (!inputData.trim()) {
      showNotification("Please provide a payload to process.");
      return;
    }

    // 2. Processing
    try {
      if (mode === "decrypt") {
        const decryptedRaw = await decryptPayload(
          inputData.trim(),
          sessionKey.trim()
        );
        setOutputData(formatOutput(decryptedRaw));
        showNotification("Payload decrypted successfully!", "success");
      } else {
        // Mode === "encrypt"
        let parsedInput;
        try {
          // Validate if input is valid JSON before encrypting
          parsedInput = JSON.parse(inputData);
        } catch (err) {
          showNotification("Invalid JSON format. Please ensure your payload is valid JSON before encrypting.");
          return;
        }

        const encryptedString = await encryptPayload(
          parsedInput,
          sessionKey.trim()
        );
        setOutputData(encryptedString);
        showNotification("Payload encrypted successfully!", "success");
      }
    } catch (err) {
      console.error(err);
      showNotification(
        err.message ||
          `Failed to ${mode} payload. Ensure your key and payload are correct.`
      );
    }
  };

  return (
    <ThemeProvider theme={theme}>
      <CssBaseline />
      <Container maxWidth="md" sx={{ py: 6 }}>
        <Paper elevation={4} sx={{ p: 4, borderRadius: 3 }}>
          <Typography
            variant="h4"
            gutterBottom
            fontWeight="bold"
            align="center"
          >
            Payload Debugger
          </Typography>
          <Typography
            variant="body1"
            color="text.secondary"
            align="center"
            sx={{ mb: 4 }}
          >
            Manually paste your session key and payload. The key is preserved
            between clears.
          </Typography>

          <Box sx={{ display: "flex", justifyContent: "center", mb: 4 }}>
            <ToggleButtonGroup
              color="primary"
              value={mode}
              exclusive
              onChange={handleModeChange}
              aria-label="Operation Mode"
            >
              <ToggleButton value="decrypt" aria-label="decrypt" sx={{ px: 3 }}>
                <LockOpenOutlinedIcon sx={{ mr: 1 }} />
                Decrypt Response
              </ToggleButton>
              <ToggleButton value="encrypt" aria-label="encrypt" sx={{ px: 3 }}>
                <LockOutlinedIcon sx={{ mr: 1 }} />
                Encrypt Request
              </ToggleButton>
            </ToggleButtonGroup>
          </Box>

          {/* Session Key Input with Hold-to-View functionality using Pointer Events */}
          <TextField
            fullWidth
            label="Session Key (payloadEncryptionKey)"
            variant="outlined"
            type={showKey ? "text" : "password"}
            value={sessionKey}
            onChange={(e) => setSessionKey(e.target.value)}
            sx={{ mb: 3 }}
            autoComplete="off"
            InputProps={{
              endAdornment: (
                <InputAdornment position="end">
                  <Tooltip title="Hold to view key" arrow>
                    <IconButton
                      onPointerDown={() => setShowKey(true)}
                      onPointerUp={() => setShowKey(false)}
                      onPointerLeave={() => setShowKey(false)}
                      sx={{ cursor: "grab", "&:active": { cursor: "grabbing" } }}
                    >
                      {showKey ? <VisibilityIcon /> : <VisibilityOffIcon />}
                    </IconButton>
                  </Tooltip>
                </InputAdornment>
              ),
            }}
          />

          <TextField
            fullWidth
            multiline
            rows={6}
            label={
              mode === "decrypt"
                ? "Encrypted String (from Network Tab)"
                : "JSON Payload (to send)"
            }
            variant="outlined"
            value={inputData}
            onChange={(e) => setInputData(e.target.value)}
            placeholder={
              mode === "decrypt"
                ? "Paste the encrypted string here..."
                : '{\n  "example": "data",\n  "count": 1\n}'
            }
            sx={{ mb: 4 }}
            autoComplete="off"
            spellCheck="false"
          />

          {/* Action Buttons */}
          <Box sx={{ display: "flex", gap: 2, mb: 4 }}>
            <Button
              variant="outlined"
              size="large"
              color="inherit"
              onClick={handleClearPayload}
              startIcon={<DeleteOutlineIcon />}
              sx={{ flex: 1, py: 1.5 }}
            >
              Clear Payload
            </Button>
            <Button
              variant="contained"
              size="large"
              onClick={handleProcess}
              sx={{ flex: 2, py: 1.5, fontSize: "1.1rem" }}
            >
              {mode === "decrypt" ? "Decrypt Payload" : "Encrypt Payload"}
            </Button>
          </Box>

          {/* Structured Output Section */}
          <Box
            sx={{
              backgroundColor: "#1e1e1e",
              borderRadius: 1,
              overflow: "hidden",
              border: "1px solid #333",
            }}
          >
            <Box
              sx={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                backgroundColor: "#2d2d2d",
                px: 2,
                py: 1,
                borderBottom: "1px solid #444",
              }}
            >
              <Typography variant="body2" sx={{ color: "#aaa" }}>
                Output Result
              </Typography>
              <Tooltip title="Copy to clipboard">
                <span>
                  <IconButton
                    size="small"
                    onClick={handleCopy}
                    disabled={!outputData}
                    sx={{ color: "#aaa", "&:hover": { color: "#fff" } }}
                  >
                    <ContentCopyIcon fontSize="small" />
                  </IconButton>
                </span>
              </Tooltip>
            </Box>
            <Box
              sx={{
                p: 2,
                minHeight: "150px",
                maxHeight: "400px",
                overflow: "auto",
              }}
            >
              {outputData ? (
                <pre
                  style={{
                    margin: 0,
                    color: "#4caf50",
                    fontFamily: "monospace",
                    whiteSpace: "pre-wrap",
                    wordBreak: "break-all",
                  }}
                >
                  {outputData}
                </pre>
              ) : (
                <Typography variant="body2" sx={{ color: "#666" }}>
                  Awaiting input...
                </Typography>
              )}
            </Box>
          </Box>
        </Paper>
      </Container>

      {/* Global Snackbar Notification */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: "bottom", horizontal: "center" }}
      >
        <Alert
          onClose={handleCloseSnackbar}
          severity={snackbar.severity}
          variant="filled"
          sx={{ width: "100%" }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}
