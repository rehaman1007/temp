import { Autocomplete, Chip } from "@mui/material";
import { useEffect, useState } from "react";

export default function RolesDialog({ open, onClose, form, setForm, canSave, fetchRoles }) {
  const user = JSON.parse(sessionStorage.getItem("user"));
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [permissionsList, setPermissionsList] = useState([]); // List of all available permissions

  // Load permissions when dialog opens
  useEffect(() => {
    if (open) {
      (async () => {
        const res = await callApi("/UM/permissions/list", {}, "GET");
        if (res?.result?.status) {
          setPermissionsList(res.result.data || []);
        }
      })();
    }
  }, [open]);

  const onSave = async (type) => {
    if (!form.roleName || !form.description) {
      snackbar("Kindly fill all the required fields.", "error");
      return;
    }

    let subDialog = {
      roleId: form.roleId,
      roleName: form.roleName,
      description: form.description,
      permissions: form.permissions?.map((p) => p.id) || [], // send selected permission IDs
    };

    let payload = {
      requestType: type,
      targetRoleId: form.roleId,
      requestorUserId: user.userId,
      requestPayload: JSON.stringify(subDialog),
    };

    let res = await callApi("/UM/role/create-role-request", payload, "POST");
    if (res?.result?.status) {
      snackbar(res?.result?.message, "success");
      onClose();
      fetchRoles();
    }
  };

  const handleChange = (data, key, e, type) => {
    let result = validations(type, e.target.value);
    if (result === "") {
      setForm({ ...data, [key]: e.target.value });
    } else {
      snackbar(result, "error");
    }
  };

  return (
    <Dialog
      open={open}
      onClose={onClose}
      fullWidth
      maxWidth="md"
      PaperProps={{ sx: { minWidth: 800, maxWidth: "45vw" } }}
    >
      <DialogTitle>{form.id ? "Edit Role" : "Add New Role"}</DialogTitle>

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          <Grid container spacing={2} alignItems="flex-start">
            <Grid item xs={12} md={4}>
              <TextField
                label="Role Name *"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.roleName}
                onChange={(e) => handleChange(form, "roleName", e, "inputValue")}
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          <Grid container spacing={2}>
            <Grid item xs={12} md={8}>
              <TextField
                sx={{ width: 465, borderRadius: 0.7 }}
                label="Description *"
                slotProps={{ htmlInput: { maxLength: 100 } }}
                value={form.description}
                onChange={(e) => handleChange(form, "description", e, "certainSpecialChars")}
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          {/* Permissions Section */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={8}>
              <Autocomplete
                multiple
                options={permissionsList}
                getOptionLabel={(option) => option.title}
                value={form.permissions || []}
                onChange={(e, newValue) => setForm({ ...form, permissions: newValue })}
                renderTags={(value, getTagProps) =>
                  value.map((option, index) => (
                    <Chip
                      label={option.title}
                      size="small"
                      {...getTagProps({ index })}
                      key={option.id}
                    />
                  ))
                }
                renderInput={(params) => (
                  <TextField {...params} label="Permissions" placeholder="Select permissions" />
                )}
              />
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          variant="contained"
          disabled={!canSave}
          onClick={() => onSave(form.roleId ? "MODIFY" : "CREATE")}
        >
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}