<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dynamic Investment Table</title>
<style>
  .table-wrapper {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 1200px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 6px 8px;
    text-align: center;
    vertical-align: middle;
  }
  th {
    background-color: #0073b1; /* SBI blue */
    color: white;
    font-weight: normal;
  }
  td {
    background-color: #fafafa;
  }
</style>
</head>
<body>

<div class="table-wrapper">
  <table id="dynamic-table"></table>
</div>

<script>
  // --- Column structure from DB ---
  const columns = [
    { id: 'investee', title: 'NAME OF INVESTEE', children: [] },
    {
      title: 'A. INVESTMENT IN SBI/ SUBSIDIARY & JOINT VENTURE, ASSOCIATES (INCLUDING RRB) OF SBI GROUP',
      children: [
        { id: 'faceValueA', title: 'FACE VALUE AS AT 30.06.2025' },
        { id: 'carryingValueA', title: 'CARRYING VALUE AS AT 30.06.2025' },
        { id: 'categoryA', title: 'CATEGORY UNDER WHICH IT HAS BEEN INCLUDED IN SCH. 8 (PLEASE SELECT FROM DROP-DOWN LIST)' }
      ]
    },
    {
      title: 'IPDI (AT I) AND SUBORDINATED DEBTS & BONDS (TIER II)',
      children: [
        {
          title: 'CARRYING VALUE AS AT 31.03.2025',
          children: [
            { id: 'ipdiValue', title: 'INVESTMENTS IN INNOVATIVE PERPETUAL DEBT INSTRUMENTS (IPDI) - AT I BONDS' },
            { id: 'subDebtValue', title: 'INVESTMENTS IN SUBORDINATED DEBENTURES AND BONDS (TIER II)' }
          ]
        },
        { id: 'categoryB', title: 'CATEGORY UNDER WHICH IT HAS BEEN INCLUDED IN SCH. 8 (PLEASE SELECT FROM DROP-DOWN LIST)' }
      ]
    },
    {
      title: 'INVESTMENT IN DEBENTURES/BONDS/ PREFERENCE SHARES/CD\'S / CP\'S (OTHER THAN IPDI (AT I) AND SUBORDINATED DEBTS & BONDS (TIER II))',
      children: [
        { id: 'faceValueC', title: 'FACE VALUE AS AT 30.06.2025' },
        { id: 'debentures', title: 'DEBENTURES AND BONDS' },
        { id: 'preference', title: 'PREFERENCE SHARES/ CD\'S / CP\'S' }
      ]
    },
    { id: 'remarks', title: 'REMARKS', children: [] },
    { id: 'action', title: 'ACTION', children: [] }
  ];

  // --- Example DB data ---
  const data = [
    {
      investee: 'SBI Subsidiary 1',
      faceValueA: 1000,
      carryingValueA: 950,
      categoryA: 'Cat 1',
      ipdiValue: 500,
      subDebtValue: 450,
      categoryB: 'Cat 2',
      faceValueC: 700,
      debentures: 400,
      preference: 200,
      remarks: 'Remark 1',
      action: 'Edit'
    },
    {
      investee: 'SBI Subsidiary 2',
      faceValueA: 1200,
      carryingValueA: 1100,
      categoryA: 'Cat 3',
      ipdiValue: 600,
      subDebtValue: 500,
      categoryB: 'Cat 4',
      faceValueC: 800,
      debentures: 500,
      preference: 300,
      remarks: 'Remark 2',
      action: 'Edit'
    }
  ];

  // --- Utility functions ---
  function getMaxDepth(cols) {
    return Math.max(...cols.map(c => c.children?.length ? 1 + getMaxDepth(c.children) : 1));
  }

  function buildHeaderRows(cols, maxDepth) {
    const rows = Array.from({ length: maxDepth }, () => []);
    function traverse(node, depthIndex) {
      const isLeaf = !node.children || node.children.length === 0;
      const colspan = isLeaf ? 1 : node.children.reduce((sum, child) => sum + traverse(child, depthIndex + 1), 0);
      const rowspan = isLeaf ? maxDepth - depthIndex : 1;
      rows[depthIndex].push({ title: node.title, colspan, rowspan });
      return colspan;
    }
    cols.forEach(c => traverse(c, 0));
    return rows;
  }

  function getLeafColumns(cols) {
    const leafs = [];
    function collect(c) {
      if (!c.children || c.children.length === 0) {
        leafs.push(c);
      } else {
        c.children.forEach(collect);
      }
    }
    cols.forEach(collect);
    return leafs;
  }

  // --- Render table ---
  const maxDepth = getMaxDepth(columns);
  const headerRows = buildHeaderRows(columns, maxDepth);
  const leafColumns = getLeafColumns(columns);

  const table = document.getElementById('dynamic-table');

  // Build header
  const thead = document.createElement('thead');
  headerRows.forEach(row => {
    const tr = document.createElement('tr');
    row.forEach(cell => {
      const th = document.createElement('th');
      if (cell.colspan > 1) th.colSpan = cell.colspan;
      if (cell.rowspan > 1) th.rowSpan = cell.rowspan;
      th.textContent = cell.title;
      tr.appendChild(th);
    });
    thead.appendChild(tr);
  });
  table.appendChild(thead);

  // Build body
  const tbody = document.createElement('tbody');
  data.forEach(rowData => {
    const tr = document.createElement('tr');
    leafColumns.forEach(col => {
      const td = document.createElement('td');
      td.textContent = rowData[col.id] ?? '';
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);
</script>

</body>
</html>