import React, { useState, useEffect, useRef } from 'react';
import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Button,
  Box,
} from '@mui/material';
import { tableCellClasses } from '@mui/material/TableCell';
import { styled } from '@mui/material/styles';
import { Edit, Delete, Save, Cancel, AddCircleOutline } from '@mui/icons-material';
import useCustomSnackbar from '../../../../../common/hooks/useCustomSnackbar';
import useApi from '../../../../../common/hooks/useApi';
import FormInput from '../../../../../common/components/ui/FormInput';
import { CustomButton } from '../../../../../common/components/ui/Buttons';

// Styled Cells
const StyledTableCell = styled(TableCell)(({ theme }) => ({
  fontSize: '1rem',
  [`&.${tableCellClasses.head}`]: {
    backgroundColor: 'hsl(220, 20%, 35%)',
    color: theme.palette.common.white,
  },
}));

const StyledTableRow = styled(TableRow)(({ error }) => ({
  ...(error && { backgroundColor: '#fdd' }),
}));

const DICGCSection3 = ({ reportSts, reportID, input5t = 0, setSec3TotalDifference }) => {
  console.log('input5t >', input5t);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const toValue = (val) => parseFloat(val) || 0;
  const user = JSON.parse(localStorage.getItem('user') || '{}');
  const { circleCode, quarterEndDate } = user;
  const [rows, setRows] = useState([]);
  const [prevValues, setPrevValues] = useState({});
  const inputRefs = useRef({});
  const [totalDifference, setTotalDifference] = useState(0);
  const [showTotalDiff, setShowTotalDiff] = useState(false);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    const payload = {
      circleCode,
      quarterEndDate,
      reportID,
      reportSts,
    };
    try {
      const responseData = await callApi('/dicgcReport/getSec3Val', payload, 'POST');
      if (responseData) {
        const formatted = responseData.map((row) => ({
          text: row.text,
          amt1: row.amt1,
          amt2: row.amt2,
          totalAmt: row.totalAmt,
          remark: row.remark,
          flag: row.flag,
          srno: row.srno,
          isEdit: false,
          difference: row.amt1 - row.amt2,
        }));
        setRows(formatted || []);

        const total = formatted.reduce((sum, r) => sum + toValue(r.difference), 0);
        setTotalDifference(total);
        setSec3TotalDifference(total);
      } else {
        showSnackBar('Error while fetching data', 'error');
      }
    } catch (error) {
      console.error('Error fetching report data:', error.message);
      if (error.code === 'ERR_CANCELED') {
        return;
      }
    }
  };

  const handleAddRow = () => {
    if (rows.some((row) => row.isEdit)) {
      showSnackBar('Please save or cancel the current row before adding a new one.', 'warning');
      return;
    }

    const newRow = {
      text: '',
      amt1: '',
      amt2: '',
      totalAmt: 0,
      remark: '',
      srno: '0',
      flag: '',
      isEdit: true,
    };

    setRows((prev) => [...prev, newRow]);

    setTimeout(() => {
      if (inputRefs.current[0]) inputRefs.current[0].focus();
    }, 100);
    setShowTotalDiff(true);
  };

  const handleEdit = (rowId) => {
    if (rows.some((row) => row.isEdit)) {
      showSnackBar('Please save or cancel the current row before editing another.', 'warning');
      return;
    }

    const foundRow = rows.find((row) => row.srno === rowId);

    if (foundRow) {
      setPrevValues((prev) => ({ ...prev, [rowId]: foundRow }));
      console.log('prev values set');
      setRows((prev) => prev.map((row) => (row.srno === rowId ? { ...row, isEdit: true } : row)));
      console.log('rows set');
    }
  };

  const handleCancel = (rowId) => {
    const oldData = prevValues[rowId];
    console.log(oldData, rowId);
    let updatedData;

    console.log(prevValues);
    setRows((prev) => {
      updatedData = prev.filter((row) => row.srno !== rowId);
      if (oldData) {
        updatedData = prev.map((row) => (row.srno === rowId ? { ...oldData, isEdit: false } : row));
      }
      return updatedData;
    });

    const total = updatedData.reduce((sum, r) => sum + toValue(r.totalAmt), 0);
    console.log('total,', total);
    setTotalDifference(total);
  };

  const handleChange = (rowId, field, value) => {
    setRows((prev) => {
      const updatedRows = prev.map((row) => {
        if (row.srno === rowId) {
          const updatedRow = { ...row, [field]: value };
          const amt1 = toValue(field === 'amt1' ? value : row.amt1);
          const amt2 = toValue(field === 'amt2' ? value : row.amt2);
          updatedRow.totalAmt = toValue(amt1 - amt2);
          return updatedRow;
        }
        return row;
      });

      const total = updatedRows.reduce((sum, r) => sum + toValue(r.totalAmt), 0);
      setTotalDifference(total);
      setSec3TotalDifference(total);

      return updatedRows;
    });
  };

  const validateFields = (row) => {
    if (!row.text?.trim()) {
      showSnackBar('Particulars cannot be empty.', 'warning');
      return false;
    }

    if (!row.amt1?.trim()) {
      showSnackBar('Amount Reported for DI&CGC Premium Payable cannot be empty.', 'warning');
      return false;
    }

    if (!row.amt2?.trim()) {
      showSnackBar('Adjusted QSA Figures for DI&CGC cannot be empty.', 'warning');
      return false;
    }

    if (!row.remark?.trim()) {
      showSnackBar('Reasons cannot be empty.', 'warning');
      return false;
    }

    return true;
  };

  const handleUpdate = async (rowId) => {
    console.log('RowId :', rowId);
    const row = rows.find((r) => r.srno === rowId);
    if (!validateFields(row)) return;
    const payload = {
      circleCode,
      srno: rowId,
      qed: quarterEndDate,
      dataFlag: rowId === '0' ? 'I' : 'U',
      difference: row.totalAmt,
      Amt1: row.amt1,
      Amt2: row.amt2,
      remark: row.remark,
      particular: row.text,
      isEdit: true,
    };
    console.log(payload);

    try {
      const response = await callApi('/dicgcReport/saveRowNew', payload, 'POST');
      console.log(response);
      if (response.result) {
        let id = response.action === 'insert' ? response.id : rowId;
        setRows((prev) => prev.map((r) => (r.srno === rowId ? { ...r, srno: id, isEdit: false } : r)));
        showSnackBar('Data Saved Successfully.', 'success');
      } else {
        showSnackBar('Error while saving data.', 'error');
      }
    } catch {
      showSnackBar('Error while saving data., Kindly try again', 'error');
    }
  };

  const handleDelete = async (rowId) => {
    console.log('inside handledelete fn   ', rowId);
    const row = rows.find((r) => r.srno === rowId);
    if (!row) return;

    const isNewRow = rowId === 0;
    if (isNewRow) {
      setRows((prev) => prev.filter((r) => r.srno !== rowId));
      showSnackBar('New row discarded.', 'info');
      return;
    }

    const payload = {
      rowId,
      circleCode,
      qed: quarterEndDate,
    };
    console.log('payload', payload);

    try {
      const response = await callApi('/dicgcReport/deleteRow', payload, 'POST');
      if (response == true) {
        const updatedRows = rows.filter((r) => r.srno !== rowId);
        setRows(updatedRows);

        const total = updatedRows.reduce((sum, r) => sum + (toValue(r.totalAmt) || 0), 0);
        setTotalDifference(total);
        setSec3TotalDifference(total);

        showSnackBar('Data deleted successfully.', 'success');
      } else {
        showSnackBar('Failed to delete data.', 'error');
      }
    } catch {
      showSnackBar('Error while deleting data.', 'error');
    }
  };

  return (
    <>
      <Box p={2}>
        <CustomButton buttonType={'create'} label={'Add Row'} sx={{ mb: 2 }} onClickHandler={handleAddRow} />
        <TableContainer component={Paper}>
          <Table>
            <TableHead>
              <StyledTableRow>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Particulars (e.g. Demand Deposits, Bankers Cheques etc.)</strong>
                </StyledTableCell>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Amount Reported for DI&CGC Premium Payable</strong>
                </StyledTableCell>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Adjusted QSA Figures for DI&CGC reported in II above</strong>
                </StyledTableCell>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Difference</strong>
                </StyledTableCell>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Reason(s) for difference</strong>
                </StyledTableCell>
                <StyledTableCell align="center" sx={{ width: '17%' }}>
                  <strong>Actions</strong>
                </StyledTableCell>
              </StyledTableRow>
              <StyledTableRow>
                <StyledTableCell align="center">
                  <strong>(a)</strong>
                </StyledTableCell>
                <StyledTableCell align="center">
                  <strong>(b)</strong>
                </StyledTableCell>
                <StyledTableCell align="center">
                  <strong>(c)</strong>
                </StyledTableCell>
                <StyledTableCell align="center">
                  <strong>(d = b - c)</strong>
                </StyledTableCell>
                <StyledTableCell align="center">
                  <strong>(e)</strong>
                </StyledTableCell>
                <StyledTableCell align="center">
                  <strong></strong>
                </StyledTableCell>
              </StyledTableRow>
            </TableHead>
            <TableBody>
              {rows.map((row) => (
                <StyledTableRow key={row.srno}>
                  <StyledTableCell sx={{ width: '17%' }}>
                    <FormInput
                      name={'text'}
                      value={row.text}
                      onChange={(e) => handleChange(row.srno, 'text', e.target.value)}
                      variant="standard"
                      inputType={'certainSpecialChars'}
                      readOnly={!row.isEdit}
                      inputRef={(el) => {
                        if (row.isEdit) inputRefs.current[row.srno] = el;
                      }}
                    />
                  </StyledTableCell>
                  <StyledTableCell sx={{ width: '17%' }}>
                    <FormInput
                      name={'amt1'}
                      value={row.amt1}
                      onChange={(e) => handleChange(row.srno, 'amt1', e.target.value)}
                      inputType={'negativePositive'}
                      readOnly={!row.isEdit}
                      fullWidth
                      maxLength={16}
                      debounceDuration={1}
                    />
                  </StyledTableCell>
                  <StyledTableCell sx={{ width: '17%' }}>
                    <FormInput
                      name={'amt2'}
                      value={row.amt2}
                      onChange={(e) => handleChange(row.srno, 'amt2', e.target.value)}
                      inputType={'negativePositive'}
                      readOnly={!row.isEdit}
                      fullWidth
                      maxLength={16}
                      debounceDuration={1}
                    />
                  </StyledTableCell>
                  <StyledTableCell sx={{ width: '17%' }}>
                    <FormInput
                      name={'totalAmt'}
                      value={row.totalAmt}
                      onChange={(e) => handleChange(row.srno, 'totalAmt', e.target.value)}
                      inputType={'negativePositive'}
                      debounceDuration={1}
                      readOnly={true}
                      fullWidth
                      maxLength={18}
                    />
                  </StyledTableCell>
                  <StyledTableCell sx={{ width: '17%' }}>
                    <FormInput
                      name={'remark'}
                      value={row.remark}
                      onChange={(e) => handleChange(row.srno, 'remark', e.target.value)}
                      inputType={'certainSpecialChars'}
                      variant="standard"
                      fullWidth
                      readOnly={!row.isEdit}
                    />
                  </StyledTableCell>
                  <StyledTableCell align="center" sx={{ width: '17%' }}>
                    {row.isEdit ? (
                      <Box>
                        <IconButton color="success" onClick={() => handleUpdate(row.srno)} sx={{ mr: 1 }}>
                          <Save />
                        </IconButton>
                        {row.srno !== 0 && (
                          <IconButton color="error" onClick={() => handleDelete(row.srno)} sx={{ mr: 1 }}>
                            <Delete />
                          </IconButton>
                        )}
                        <IconButton color="warning" onClick={() => handleCancel(row.srno)} sx={{ mr: 1 }}>
                          <Cancel />
                        </IconButton>
                      </Box>
                    ) : (
                      <Box>
                        <IconButton color="primary" onClick={() => handleEdit(row.srno)}>
                          <Edit />
                        </IconButton>
                      </Box>
                    )}
                  </StyledTableCell>
                </StyledTableRow>
              ))}
              {rows.length !== 0 && (
                <StyledTableRow align="center">
                  <StyledTableCell colSpan={3} align="right">
                    Total Difference:
                  </StyledTableCell>
                  <StyledTableCell colSpan={1} align="center">
                    <FormInput
                      name={'diffTotal'}
                      value={totalDifference}
                      fullWidth
                      readOnly={true}
                      inputProps={{
                        maxLength: 19,
                      }}
                      debounceDuration={1}
                      sx={{
                        textAlign: 'right',
                        fontWeight: 'bold',
                        '& .Mui-disabled': {
                          WebkitTextFillColor:
                            input5t !== totalDifference
                              ? 'orangered'
                              : input5t === totalDifference
                              ? 'green'
                              : 'inherit',
                          fontWeight: 'bold',
                        },
                      }}
                    />
                  </StyledTableCell>
                </StyledTableRow>
              )}
              {rows.length === 0 && (
                <StyledTableRow align="center">
                  <StyledTableCell colSpan={6} align="center">
                    No data available
                  </StyledTableCell>
                </StyledTableRow>
              )}
            </TableBody>
          </Table>
        </TableContainer>
      </Box>
    </>
  );
};

export default DICGCSection3;
