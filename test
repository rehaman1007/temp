import React, { useState, useEffect, useCallback, useMemo } from "react";
import {
  Box,
  Grid,
  Card,
  CardContent,
  Typography,
  Chip,
  Paper,
  IconButton,
  Container,
  Stack,
  Avatar,
  useTheme,
  Tooltip,
  Skeleton,
  Fade,
  Divider,
  useMediaQuery,
} from "@mui/material";
import { DataGrid, GridActionsCellItem } from "@mui/x-data-grid";
import {
  Storage,
  Speed,
  SettingsInputComponent,
  Psychology,
  Refresh,
  PlayArrow,
  CheckCircle,
  ErrorOutline,
  Info,
  Visibility,
  HourglassEmpty,
  Timeline,
} from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import { timeStampFormatter } from "../../utils/CommonUtilities";

const HEALTH_URL = "/PS/airflow/health";
const PIPELINE_URL = "/PS/process/all-pipelines";
const DAGS_URL = "/PS/airflow/running-dags";

const AirflowDashboard = () => {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down("sm"));

  const [health, setHealth] = useState(null);
  const [pipelines, setPipelines] = useState([]);
  const [runningDags, setRunningDags] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isRefreshing, setIsRefreshing] = useState(false);
  const { callApi } = useApi();

  const [dagMetrics, setDagMetrics] = useState({
    total: 0,
    running: 0,
    queued: 0,
  });

  const fetchData = useCallback(
    async (manual = false) => {
      if (manual) setIsRefreshing(true);
      try {
        const [healthRes, pipeRes, runsRes] = await Promise.all([
          callApi(HEALTH_URL, null, "GET"),
          callApi(PIPELINE_URL, null, "GET"),
          callApi(DAGS_URL, null, "GET"),
        ]);

        const dags = runsRes.data?.dag_runs || [];

        setDagMetrics({
          total: dags.length,
          running: dags.filter(d => d.state === "running").length,
          queued: dags.filter(d => d.state === "queued").length,
        });

        setHealth(healthRes.data);
        setPipelines(pipeRes.data || []);
        setRunningDags(dags);
      } catch (err) {
        console.error("Dashboard Error:", err);
      } finally {
        setLoading(false);
        setIsRefreshing(false);
      }
    },
    [callApi]
  );

  useEffect(() => {
    fetchData();
    const interval = setInterval(() => fetchData(false), 30000);
    return () => clearInterval(interval);
  }, [fetchData]);

  const getComponentIcon = (name) => {
    switch (name) {
      case "metadatabase": return <Storage />;
      case "scheduler": return <Speed />;
      case "triggerer": return <SettingsInputComponent />;
      case "dag_processor": return <Psychology />;
      default: return <Info />;
    }
  };

  const columns = useMemo(() => [
    {
      field: "dag_id",
      headerName: "DAG ID",
      flex: 1.4,
      minWidth: 200,
      renderCell: (params) => (
        <Typography fontWeight={600}>{params.value}</Typography>
      )
    },
    {
      field: "state",
      headerName: "Status",
      flex: 1,
      minWidth: 130,
      renderCell: (params) => {
        const isRunning = params.value === "running";
        const isQueued = params.value === "queued";
        return (
          <Chip
            icon={
              isRunning ? <PlayArrow sx={{ fontSize: 16 }} /> :
              isQueued ? <HourglassEmpty sx={{ fontSize: 14 }} /> : null
            }
            label={params.value}
            size="small"
            color={isRunning ? "success" : isQueued ? "warning" : "default"}
            sx={{ fontWeight: 700, textTransform: "capitalize" }}
          />
        );
      },
    },
    {
      field: "start_date",
      headerName: "Start Time",
      flex: 1,
      minWidth: 180,
      valueFormatter: (params) =>
        params.value
          ? new Date(params.value).toLocaleString()
          : "-",
    },
    {
      field: "actions",
      type: "actions",
      width: 80,
      getActions: (params) => [
        <GridActionsCellItem
          icon={<Visibility color="primary" />}
          label="View"
          onClick={() => alert(params.row.dag_id)}
        />,
      ],
    },
  ], []);

  if (loading) {
    return (
      <Container maxWidth="xl" sx={{ mt: 4 }}>
        <Skeleton height={60} width={300} />
        <Skeleton height={300} sx={{ mt: 3 }} />
      </Container>
    );
  }

  return (
    <Paper
      elevation={0}
      sx={{
        minHeight: "100vh",
        background: `linear-gradient(to bottom, ${theme.palette.background.default}, ${theme.palette.grey[50]})`,
        pb: 4,
      }}
    >
      <Fade in>
        <Container maxWidth="xl" sx={{ pt: 4 }}>
          
          {/* Header */}
          <Stack
            direction={isMobile ? "column" : "row"}
            justifyContent="space-between"
            alignItems="center"
            spacing={2}
            mb={4}
          >
            <Box>
              <Typography variant="h4" fontWeight={800} color="primary.main">
                Fincore Airflow Control Center
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Real-time orchestration monitoring
              </Typography>
            </Box>

            <IconButton
              onClick={() => fetchData(true)}
              disabled={isRefreshing}
              sx={{
                border: "1px solid",
                borderColor: "primary.main",
                transition: "0.3s",
                transform: isRefreshing ? "rotate(180deg)" : "none",
                "&:hover": {
                  bgcolor: "primary.main",
                  color: "#fff",
                },
              }}
            >
              <Refresh />
            </IconButton>
          </Stack>

          {/* KPI Metrics */}
          <Grid container spacing={3} mb={3}>
            {[
              { label: "Total DAGs", value: dagMetrics.total },
              { label: "Running", value: dagMetrics.running, color: "success.main" },
              { label: "Queued", value: dagMetrics.queued, color: "warning.main" },
            ].map((item, i) => (
              <Grid item xs={12} sm={4} key={i}>
                <Card
                  sx={{
                    borderRadius: 3,
                    boxShadow: theme.shadows[2],
                    transition: "0.2s",
                    "&:hover": { transform: "translateY(-3px)" },
                  }}
                >
                  <CardContent>
                    <Stack direction="row" justifyContent="space-between">
                      <Box>
                        <Typography variant="caption" color="text.secondary">
                          {item.label}
                        </Typography>
                        <Typography
                          variant="h5"
                          fontWeight={800}
                          color={item.color || "text.primary"}
                        >
                          {item.value}
                        </Typography>
                      </Box>
                      <Timeline color="primary" />
                    </Stack>
                  </CardContent>
                </Card>
              </Grid>
            ))}
          </Grid>

          {/* DAG Grid */}
          <Card sx={{ borderRadius: 3 }}>
            <Box p={2}>
              <Typography variant="h6" fontWeight={700}>
                Active Orchestrations
              </Typography>
            </Box>
            <Divider />
            <Box sx={{ height: 420 }}>
              <DataGrid
                rows={runningDags}
                columns={columns}
                getRowId={(row) =>
                  row.dag_run_id || row.dag_id + row.start_date
                }
                pageSizeOptions={[5, 10]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 5 } },
                }}
                disableRowSelectionOnClick
                density="compact"
                sx={{
                  border: 0,
                  "& .MuiDataGrid-columnHeaders": {
                    backgroundColor: theme.palette.grey[100],
                    fontWeight: 700,
                  },
                  "& .MuiDataGrid-row:hover": {
                    backgroundColor: theme.palette.action.hover,
                  },
                }}
              />
            </Box>
          </Card>

          {/* Pipeline Registry */}
          <Typography variant="h6" fontWeight={800} mt={5} mb={3}>
            Pipeline Registry
          </Typography>

          <Grid container spacing={3}>
            {pipelines.map((pipe) => (
              <Grid item xs={12} sm={6} md={4} lg={3} key={pipe.processId}>
                <Paper
                  sx={{
                    p: 2.5,
                    borderRadius: 3,
                    border: "1px solid",
                    borderColor: "divider",
                    transition: "0.2s",
                    "&:hover": {
                      borderColor: "primary.main",
                      boxShadow: theme.shadows[3],
                    },
                  }}
                >
                  <Stack direction="row" spacing={2}>
                    <Avatar
                      sx={{
                        bgcolor:
                          pipe.processFlag === "Y"
                            ? "success.light"
                            : "error.light",
                      }}
                    >
                      {pipe.processFlag === "Y" ? (
                        <CheckCircle />
                      ) : (
                        <ErrorOutline />
                      )}
                    </Avatar>
                    <Box>
                      <Typography fontWeight={700}>
                        {pipe.processName}
                      </Typography>
                      <Typography
                        variant="caption"
                        color="primary"
                        fontWeight={600}
                      >
                        {pipe.dagId}
                      </Typography>
                    </Box>
                  </Stack>
                </Paper>
              </Grid>
            ))}
          </Grid>
        </Container>
      </Fade>
    </Paper>
  );
};

export default AirflowDashboard;