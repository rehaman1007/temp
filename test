package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.dto.LedgerWiseRequest;
import com.fincore.enquiry_service.model.LedgerTransaction;

import jakarta.persistence.criteria.CriteriaBuilder;
import jakarta.persistence.criteria.Path;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;

import lombok.extern.slf4j.Slf4j;

import org.springframework.data.jpa.domain.Specification;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

@Slf4j
public class LedgerSpecification {

    public static Specification<LedgerTransaction> build(
            LedgerWiseRequest dto
    ) {

        return (root, query, cb) -> {

            List<Predicate> predicates = new ArrayList<>();

            /*
             * CGL
             */
            predicates.add(
                    cb.equal(
                            root.get("cglMaster")
                                    .get("cglNumber"),
                            dto.getCgl()
                    )
            );

            /*
             * DATE RANGE
             */
            predicates.add(
                    cb.between(
                            root.get("transactionDate"),
                            parseDate(dto.getFromDate()),
                            parseDate(dto.getToDate())
                    )
            );

            /*
             * CURRENCY
             */
            if (
                    dto.getCurrencies() != null &&
                    !"ALL".equalsIgnoreCase(dto.getCurrencies())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currencyMaster")
                                        .get("currencyCode"),
                                dto.getCurrencies()
                        )
                );
            }

            /*
             * CIRCLE
             */
            if (
                    dto.getCircle() != null &&
                    !"ALL".equalsIgnoreCase(dto.getCircle())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("branch")
                                        .get("circle")
                                        .get("circleCode"),
                                dto.getCircle()
                        )
                );
            }

            /*
             * BRANCHES
             */
            if (
                    dto.getBranches() != null &&
                    !dto.getBranches().isEmpty() &&
                    !dto.getBranches().contains("ALL")
            ) {

                predicates.add(
                        root.get("branch")
                                .get("code")
                                .in(dto.getBranches())
                );
            }

            /*
             * SOURCE FLAGS
             */
            if (
                    dto.getSourceFlags() != null &&
                    !dto.getSourceFlags().isEmpty() &&
                    !dto.getSourceFlags().contains("ALL")
            ) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags())
                );
            }

            /*
             * GRID FILTERS
             */
            applyGridFilters(
                    dto.getGridFilters(),
                    root,
                    cb,
                    predicates
            );

            return cb.and(
                    predicates.toArray(new Predicate[0])
            );
        };
    }

    private static void applyGridFilters(
            List<GridFilter> filters,
            Root<LedgerTransaction> root,
            CriteriaBuilder cb,
            List<Predicate> predicates
    ) {

        if (
                filters == null ||
                filters.isEmpty()
        ) {
            return;
        }

        for (GridFilter filter : filters) {

            if (
                    filter == null ||
                    filter.getField() == null ||
                    filter.getOperator() == null
            ) {
                continue;
            }

            Path<?> path =
                    getPath(
                            root,
                            filter.getField()
                    );

            String operator =
                    filter.getOperator();

            Object value =
                    filter.getValue();

            switch (operator) {

                /*
                 * CONTAINS
                 */
                case "contains" -> {

                    if (value != null) {

                        predicates.add(
                                cb.like(
                                        cb.upper(
                                                path.as(String.class)
                                        ),
                                        "%" +
                                        value.toString().toUpperCase() +
                                        "%"
                                )
                        );
                    }
                }

                /*
                 * EQUALS
                 */
                case "equals", "is" -> {

                    if (value != null) {

                        predicates.add(
                                cb.equal(
                                        cb.upper(
                                                path.as(String.class)
                                        ),
                                        value.toString().toUpperCase()
                                )
                        );
                    }
                }

                /*
                 * NOT
                 */
                case "not" -> {

                    if (value != null) {

                        predicates.add(
                                cb.notEqual(
                                        cb.upper(
                                                path.as(String.class)
                                        ),
                                        value.toString().toUpperCase()
                                )
                        );
                    }
                }

                /*
                 * STARTS WITH
                 */
                case "startsWith" -> {

                    if (value != null) {

                        predicates.add(
                                cb.like(
                                        cb.upper(
                                                path.as(String.class)
                                        ),
                                        value.toString().toUpperCase() +
                                        "%"
                                )
                        );
                    }
                }

                /*
                 * ENDS WITH
                 */
                case "endsWith" -> {

                    if (value != null) {

                        predicates.add(
                                cb.like(
                                        cb.upper(
                                                path.as(String.class)
                                        ),
                                        "%" +
                                        value.toString().toUpperCase()
                                )
                        );
                    }
                }

                /*
                 * MULTI SELECT
                 */
                case "isAnyOf" -> {

                    if (
                            value instanceof List<?> values &&
                            !values.isEmpty()
                    ) {

                        CriteriaBuilder.In<Object> inClause =
                                cb.in(
                                        cb.upper(
                                                path.as(String.class)
                                        )
                                );

                        for (Object val : values) {

                            if (val != null) {

                                inClause.value(
                                        val.toString().toUpperCase()
                                );
                            }
                        }

                        predicates.add(inClause);
                    }
                }

                /*
                 * EMPTY
                 */
                case "isEmpty" -> {

                    predicates.add(
                            cb.or(
                                    cb.isNull(path),
                                    cb.equal(
                                            cb.trim(
                                                    path.as(String.class)
                                            ),
                                            ""
                                    )
                            )
                    );
                }

                /*
                 * NOT EMPTY
                 */
                case "isNotEmpty" -> {

                    predicates.add(
                            cb.and(
                                    cb.isNotNull(path),
                                    cb.notEqual(
                                            cb.trim(
                                                    path.as(String.class)
                                            ),
                                            ""
                                    )
                            )
                    );
                }

                default -> log.warn(
                        "Unsupported operator :: {}",
                        operator
                );
            }
        }
    }

    private static Path<?> getPath(
            Root<LedgerTransaction> root,
            String field
    ) {

        return switch (field) {

            /*
             * BRANCH
             */
            case "branchCode" ->
                    root.get("branch")
                            .get("code");

            case "branchName" ->
                    root.get("branch")
                            .get("name");

            /*
             * CIRCLE
             */
            case "circleCode" ->
                    root.get("branch")
                            .get("circle")
                            .get("circleCode");

            case "circleName" ->
                    root.get("branch")
                            .get("circle")
                            .get("circleName");

            /*
             * CURRENCY
             */
            case "currency" ->
                    root.get("currencyMaster")
                            .get("currencyCode");

            case "currencyName" ->
                    root.get("currencyMaster")
                            .get("currencyName");

            /*
             * CGL
             */
            case "cgl" ->
                    root.get("cglMaster")
                            .get("cglNumber");

            case "description" ->
                    root.get("cglMaster")
                            .get("description");

            default -> root.get(field);
        };
    }

    private static LocalDate parseDate(
            String date
    ) {

        return LocalDate.parse(
                date,
                DateTimeFormatter.ofPattern(
                        "dd/MM/yyyy"
                )
        );
    }
}


@Override
public Page<LedgerWiseResponse> search(
        LedgerWiseRequest dto
) {

    Sort.Direction direction =
            "asc".equalsIgnoreCase(dto.getSortOrder())
                    ? Sort.Direction.ASC
                    : Sort.Direction.DESC;

    Pageable pageable = PageRequest.of(
            dto.getPage(),
            dto.getSize(),
            Sort.by(
                    direction,
                    getSortField(dto.getSortField())
            )
    );

    Page<LedgerTransaction> page =
            ledgerTransactionRepository.findAll(
                    LedgerSpecification.build(dto),
                    pageable
            );

    return page.map(this::mapToDto);
}

private String safeCircleCode(
        LedgerTransaction entity
) {

    try {

        if (
                entity.getBranch() != null &&
                entity.getBranch().getCircle() != null
        ) {

            return entity.getBranch()
                    .getCircle()
                    .getCircleCode();
        }

    } catch (Exception ignored) {
    }

    return null;
}

private String safeCircleName(
        LedgerTransaction entity
) {

    try {

        if (
                entity.getBranch() != null &&
                entity.getBranch().getCircle() != null
        ) {

            return entity.getBranch()
                    .getCircle()
                    .getCircleName();
        }

    } catch (Exception ignored) {
    }

    return null;
}