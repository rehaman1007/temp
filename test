<Grid size={{ xs: 12 }}>
  <Paper
    sx={{
      p: 3,
      borderRadius: "20px",
      background: "#58469f",
      color: "white",
    }}
  >
    <Grid container spacing={3} alignItems="flex-start">
      {/* FROM DATE */}
      <Grid size={{ xs: 12, md: 3 }}>
        <Stack spacing={0.5}>
          <Stack direction="row" spacing={1} alignItems="center">
            <DateRangeIcon fontSize="small" />
            <Typography sx={{ fontWeight: 700 }}>
              From Date *
            </Typography>
          </Stack>

          <DatePicker
            value={filters.fromDate}
            format="DD/MM/YYYY"
            minDate={minLimit}
            maxDate={filters.toDate || maxLimit}
            views={["year", "month", "day"]}
            onChange={(value) => {
              onFilterChange("fromDate", value);

              if (
                value &&
                filters.toDate &&
                value.isValid() &&
                filters.toDate.isValid()
              ) {
                if (value.isAfter(filters.toDate, "day")) {
                  setFromDateError("fromGreaterThanTo");
                  setToDateError("toLessThanFrom");
                } else {
                  setFromDateError(null);
                  setToDateError(null);
                }
              } else {
                setFromDateError(null);
              }
            }}
            onError={(error) => {
              if (error) {
                setFromDateError(error);
              } else {
                setFromDateError(null);
              }
            }}
            slotProps={{
              textField: {
                size: "small",
                fullWidth: true,
                placeholder: "DD/MM/YYYY",
                error: !!fromDateError,
                helperText:
                  getDateErrorMessage(fromDateError) || " ",
                FormHelperTextProps: {
                  sx: {
                    minHeight: 22,
                    ml: 0,
                    color: "#ffd7d7",
                    fontWeight: 500,
                  },
                },
                sx: {
                  bgcolor: "white",
                  borderRadius: 2,
                },
              },
            }}
          />
        </Stack>
      </Grid>

      {/* TO DATE */}
      <Grid size={{ xs: 12, md: 3 }}>
        <Stack spacing={0.5}>
          <Stack direction="row" spacing={1} alignItems="center">
            <DateRangeIcon fontSize="small" />
            <Typography sx={{ fontWeight: 700 }}>
              To Date *
            </Typography>
          </Stack>

          <DatePicker
            value={filters.toDate}
            format="DD/MM/YYYY"
            minDate={filters.fromDate || minLimit}
            maxDate={maxLimit}
            views={["year", "month", "day"]}
            onChange={(value) => {
              onFilterChange("toDate", value);

              if (
                filters.fromDate &&
                value &&
                filters.fromDate.isValid() &&
                value.isValid()
              ) {
                if (value.isBefore(filters.fromDate, "day")) {
                  setToDateError("toLessThanFrom");
                  setFromDateError("fromGreaterThanTo");
                } else {
                  setToDateError(null);
                  setFromDateError(null);
                }
              } else {
                setToDateError(null);
              }
            }}
            onError={(error) => {
              if (error) {
                setToDateError(error);
              } else {
                setToDateError(null);
              }
            }}
            slotProps={{
              textField: {
                size: "small",
                fullWidth: true,
                placeholder: "DD/MM/YYYY",
                error: !!toDateError,
                helperText:
                  getDateErrorMessage(toDateError) || " ",
                FormHelperTextProps: {
                  sx: {
                    minHeight: 22,
                    ml: 0,
                    color: "#ffd7d7",
                    fontWeight: 500,
                  },
                },
                sx: {
                  bgcolor: "white",
                  borderRadius: 2,
                },
              },
            }}
          />
        </Stack>
      </Grid>

      {/* TRANSACTION TYPE */}
      <Grid size={{ xs: 12, md: 6 }}>
        <Stack spacing={0.5}>
          <Stack direction="row" spacing={1} alignItems="center">
            <DateRangeIcon fontSize="small" />
            <Typography sx={{ fontWeight: 700 }}>
              Transaction Type *
            </Typography>
          </Stack>

          <Autocomplete
            multiple
            size="small"
            disableCloseOnSelect
            options={sourceOptions}
            value={filters.sourceFlags}
            getOptionLabel={(o) => o.flagName || ""}
            isOptionEqualToValue={(option, value) =>
              option.flagId === value.flagId
            }
            onChange={(_, selectedOptions) => {
              const isSelectAllClicked = selectedOptions.some(
                (option) => option.flagId === "select-all"
              );

              if (isSelectAllClicked) {
                if (
                  filters.sourceFlags.length ===
                  sourceOptions.length
                ) {
                  onFilterChange("sourceFlags", []);
                } else {
                  onFilterChange(
                    "sourceFlags",
                    sourceOptions
                  );
                }
              } else {
                onFilterChange(
                  "sourceFlags",
                  selectedOptions
                );
              }
            }}
            filterOptions={(options) => [
              {
                flagId: "select-all",
                flagName: "Select All",
              },
              ...options,
            ]}
            renderTags={(v) => (
              <CustomChip
                label={
                  v.length === sourceOptions.length
                    ? "All Transaction Types"
                    : `${v.length} Types`
                }
                color="default"
              />
            )}
            renderOption={(props, option, { selected }) => {
              const isAllSelected =
                filters.sourceFlags.length ===
                sourceOptions.length;

              return (
                <li {...props} key={option.flagId}>
                  <Checkbox
                    size="small"
                    checked={
                      option.flagId === "select-all"
                        ? isAllSelected
                        : selected
                    }
                  />
                  {option.flagName}
                </li>
              );
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                placeholder="Transaction Types"
                helperText=" "
                FormHelperTextProps={{
                  sx: {
                    minHeight: 22,
                  },
                }}
                sx={{
                  bgcolor: "white",
                  borderRadius: 2,
                  "& .MuiOutlinedInput-root": {
                    borderRadius: 2,
                  },
                }}
              />
            )}
          />
        </Stack>
      </Grid>
    </Grid>
  </Paper>
</Grid>