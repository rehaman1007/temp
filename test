// Index.js
import { useEffect, useState } from "react";
import { useDispatch } from "react-redux";
import { logout } from "../../../store/slices/authSlice";
import { persistor } from "../../../store/store";
import { clearMenus } from "../../../store/slices/menuSlice";
import LoginPort from "../components/LoginPort";

const Login = () => {
  const dispatch = useDispatch();

  useEffect(() => {
    const handleLogout = async () => {
      dispatch(clearMenus());
      dispatch(logout());
      try {
        //This clears redux persists local or session storage
        await persistor.purge();
      } catch (error) {
        console.error("Error while purging persisted store:", error);
      }

      // sessionStorage.clear();
      // localStorage.clear();
    };
    handleLogout();
  }, [dispatch]);

  return (
    <LoginPort />
  );
};

export default Login;
