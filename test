@PostMapping("/search")
public ResponseEntity<?> search(
        @RequestBody LedgerWiseRequest dto
) {

    return ResponseEntity.ok(
            ApiResponse.success(
                    ledgerEnquiryService.search(dto),
                    "Transaction records fetched Successfully"
            )
    );
}

