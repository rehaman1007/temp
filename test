const buildBreadcrumbs = (selectedMenuItem, menus) => {
  if (!selectedMenuItem) return [];

  // Case 1: Top-level menu
  if (selectedMenuItem.hasChildren) {
    return [selectedMenuItem];
  }

  // Immediate parent
  const parent = getParentMenu(selectedMenuItem, menus);

  if (!parent) {
    return [selectedMenuItem];
  }

  // Parent's parent (grandparent)
  const grandParent = getParentMenu(parent, menus);

  if (grandParent) {
    return [grandParent, parent, selectedMenuItem];
  }

  // Only one level deep
  return [parent, selectedMenuItem];
};

import React, { useMemo } from "react";
import { Breadcrumbs, Link, Typography } from "@mui/material";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import { useSelector } from "react-redux";
import { getParentMenu } from "../utils/CommonUtilities";
import useNavigateToPage from "../hooks/useNavigateToPage";

const AppBreadcrumbs = () => {
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const menus = useSelector((state) => state.menus.menus);
  const { navigateToPage } = useNavigateToPage();

  const breadcrumbs = useMemo(() => {
    return buildBreadcrumbs(selectedMenuItem, menus);
  }, [selectedMenuItem, menus]);

  if (!breadcrumbs.length) return null;

  return (
    <Breadcrumbs
      separator={<NavigateNextIcon fontSize="small" />}
      sx={{ mb: 1 }}
    >
      {breadcrumbs.map((item, index) => {
        const isLast = index === breadcrumbs.length - 1;

        return isLast ? (
          <Typography key={item.title} fontWeight={600}>
            {item.title}
          </Typography>
        ) : (
          <Link
            key={item.title}
            underline="hover"
            sx={{ cursor: "pointer" }}
            onClick={() => navigateToPage(item)}
          >
            {item.title}
          </Link>
        );
      })}
    </Breadcrumbs>
  );
};

export default AppBreadcrumbs;