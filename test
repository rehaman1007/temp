package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.dto.LedgerWiseRequest;
import com.fincore.enquiry_service.model.LedgerTransaction;

import jakarta.persistence.criteria.CriteriaBuilder;
import jakarta.persistence.criteria.Path;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;

import org.springframework.data.jpa.domain.Specification;

import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

public class LedgerSpecification {

    public static Specification<LedgerTransaction> build(
            LedgerWiseRequest dto
    ) {

        return (root, query, cb) -> {

            List<Predicate> predicates = new ArrayList<>();

            /*
             * CGL
             */
            predicates.add(
                    cb.equal(
                            root.get("cglMaster")
                                    .get("cglNumber"),
                            dto.getCgl()
                    )
            );

            /*
             * DATE RANGE
             */
            predicates.add(
                    cb.between(
                            root.get("transactionDate"),
                            parseDate(dto.getFromDate()),
                            parseDate(dto.getToDate())
                    )
            );

            /*
             * CURRENCY
             */
            if (
                    dto.getCurrencies() != null &&
                            !"ALL".equalsIgnoreCase(dto.getCurrencies())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currencyMaster")
                                        .get("currencyCode"),
                                dto.getCurrencies()
                        )
                );
            }

            /*
             * CIRCLE
             */
            if (
                    dto.getCircle() != null &&
                            !"ALL".equalsIgnoreCase(dto.getCircle())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("branch")
                                        .get("circle")
                                        .get("circleCode"),
                                dto.getCircle()
                        )
                );
            }

            /*
             * BRANCHES
             */
            if (
                    dto.getBranches() != null &&
                            !dto.getBranches().isEmpty() &&
                            !dto.getBranches().contains("ALL")
            ) {

                predicates.add(
                        root.get("branch")
                                .get("code")
                                .in(dto.getBranches())
                );
            }

            /*
             * SOURCE FLAGS
             */
            if (
                    dto.getSourceFlags() != null &&
                            !dto.getSourceFlags().isEmpty() &&
                            !dto.getSourceFlags().contains("ALL")
            ) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags())
                );
            }

            /*
             * GRID FILTERS
             */
            if (
                    dto.getGridFilters() != null &&
                            !dto.getGridFilters().isEmpty()
            ) {

                for (GridFilter filter : dto.getGridFilters()) {

                    if (
                            filter == null ||
                                    filter.getField() == null ||
                                    filter.getOperator() == null
                    ) {
                        continue;
                    }

                    Object value = filter.getValue();

                    if (
                            value == null ||
                                    value.toString().trim().isEmpty()
                    ) {
                        continue;
                    }

                    Path<?> path =
                            getPath(root, filter.getField());

                    String operator =
                            filter.getOperator();

                    switch (operator) {

                        /*
                         * CONTAINS
                         */
                        case "contains" -> predicates.add(
                                cb.like(
                                        cb.upper(path.as(String.class)),
                                        "%" + value.toString().toUpperCase() + "%"
                                )
                        );

                        /*
                         * EQUALS
                         */
                        case "equals", "is" -> predicates.add(
                                cb.equal(path, value)
                        );

                        /*
                         * STARTS WITH
                         */
                        case "startsWith" -> predicates.add(
                                cb.like(
                                        cb.upper(path.as(String.class)),
                                        value.toString().toUpperCase() + "%"
                                )
                        );

                        /*
                         * ENDS WITH
                         */
                        case "endsWith" -> predicates.add(
                                cb.like(
                                        cb.upper(path.as(String.class)),
                                        "%" + value.toString().toUpperCase()
                                )
                        );

                        /*
                         * NOT
                         */
                        case "not" -> predicates.add(
                                cb.notEqual(path, value)
                        );

                        /*
                         * isAnyOf
                         */
                        case "isAnyOf" -> {

                            if (value instanceof List<?> values) {

                                CriteriaBuilder.In<Object> inClause =
                                        cb.in(path);

                                for (Object v : values) {
                                    inClause.value(v);
                                }

                                predicates.add(inClause);
                            }
                        }
                    }
                }
            }

            return cb.and(
                    predicates.toArray(new Predicate[0])
            );
        };
    }

    private static Path<?> getPath(
            Root<LedgerTransaction> root,
            String field
    ) {

        return switch (field) {

            /*
             * BRANCH
             */
            case "branchCode" -> root.get("branch")
                    .get("code");

            case "branchName" -> root.get("branch")
                    .get("name");

            /*
             * CIRCLE
             */
            case "circleCode" -> root.get("branch")
                    .get("circle")
                    .get("circleCode");

            case "circleName" -> root.get("branch")
                    .get("circle")
                    .get("circleName");

            /*
             * CURRENCY
             */
            case "currency" -> root.get("currencyMaster")
                    .get("currencyCode");

            case "currencyName" -> root.get("currencyMaster")
                    .get("currencyName");

            /*
             * CGL
             */
            case "cgl" -> root.get("cglMaster")
                    .get("cglNumber");

            case "description" -> root.get("cglMaster")
                    .get("description");

            default -> root.get(field);
        };
    }

    private static Date parseDate(
            String date
    ) {

        try {

            return new SimpleDateFormat(
                    "dd/MM/yyyy"
            ).parse(date);

        } catch (Exception e) {

            throw new RuntimeException(
                    "Invalid date format : " + date
            );
        }
    }
}


package com.fincore.enquiry_service.service;

import com.fincore.enquiry_service.dto.*;
import com.fincore.enquiry_service.model.LedgerTransaction;
import com.fincore.enquiry_service.repository.GlTransactionsRepository;
import com.fincore.enquiry_service.repository.LedgerWiseRepository;
import com.fincore.enquiry_service.specification.LedgerSpecification;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;

import org.springframework.data.domain.*;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.util.List;
import java.util.stream.Collectors;

@Slf4j
@RequiredArgsConstructor
@Service("LedgerEnquiryService")
public class LedgerEnquiryServiceImpl
        implements LedgerEnquiryService {

    private final GlTransactionsRepository glTransactionsRepository;
    private final LedgerWiseRepository ledgerTransactionRepository;

    /*
     * OLD API
     */
    @Override
    public Page<LedgerEnquiryResponse> search(
            LedgerEnquiryRequest dto,
            Pageable pageable
    ) {

        String currency =
                "ALL".equalsIgnoreCase(dto.getCurrencies())
                        ? null
                        : dto.getCurrencies();

        String circle =
                "ALL".equalsIgnoreCase(dto.getCircle())
                        ? null
                        : dto.getCircle();

        int skipSource =
                dto.getSourceFlags() != null &&
                        dto.getSourceFlags().contains("ALL")
                        ? 1
                        : 0;

        int skipBranches =
                dto.getBranches() != null &&
                        dto.getBranches().contains("ALL")
                        ? 1
                        : 0;

        Page<SearchProjection> projectionList =
                glTransactionsRepository.getSearchList(
                        dto.getCgl(),
                        skipSource,
                        dto.getSourceFlags(),
                        currency,
                        dto.getFromDate(),
                        dto.getToDate(),
                        skipBranches,
                        dto.getBranches(),
                        circle,
                        pageable
                );

        return projectionList.map(this::mapToResponseDto);
    }

    /*
     * NEW API
     */
    @Override
    public Page<LedgerWiseResponse> search(
            LedgerWiseRequest dto
    ) {

        Sort.Direction direction =
                "asc".equalsIgnoreCase(dto.getSortOrder())
                        ? Sort.Direction.ASC
                        : Sort.Direction.DESC;

        Pageable pageable = PageRequest.of(
                dto.getPage(),
                dto.getSize(),
                Sort.by(
                        direction,
                        getSortField(dto.getSortField())
                )
        );

        Page<LedgerTransaction> page =
                ledgerTransactionRepository.findAll(
                        LedgerSpecification.build(dto),
                        pageable
                );

        return page.map(this::mapToDto);
    }

    private LedgerEnquiryResponse mapToResponseDto(
            SearchProjection searchProjection
    ) {

        return new LedgerEnquiryResponse(

                searchProjection.getTransactionId(),
                searchProjection.getBatchId(),
                searchProjection.getJournalId(),
                searchProjection.getTransactionDate(),
                searchProjection.getPostDate(),
                searchProjection.getBranchCode(),
                searchProjection.getBranchName(),
                searchProjection.getCircleCode(),
                searchProjection.getCircleName(),
                searchProjection.getCurrency(),
                searchProjection.getCurrencyName(),
                searchProjection.getCgl(),
                searchProjection.getDescription(),
                searchProjection.getNarration(),
                searchProjection.getDebitAmount(),
                searchProjection.getCreditAmount(),
                searchProjection.getTransactionCount(),
                searchProjection.getSourceFlag()
        );
    }

    private LedgerWiseResponse mapToDto(
            LedgerTransaction entity
    ) {

        String branchCode = null;
        String branchName = null;
        String circleCode = null;
        String circleName = null;

        try {

            if (entity.getBranch() != null) {

                branchCode =
                        entity.getBranch().getCode();

                branchName =
                        entity.getBranch().getName();

                if (
                        entity.getBranch().getCircle()
                                != null
                ) {

                    circleCode =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleCode();

                    circleName =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleName();
                }
            }

        } catch (Exception e) {

            log.warn(
                    "Circle mapping failed for transaction : {}",
                    entity.getTransactionId()
            );
        }

        return new LedgerWiseResponse(

                entity.getTransactionId(),
                entity.getBatchId(),
                entity.getJournalId(),
                entity.getTransactionDate(),
                entity.getPostDate(),

                branchCode,
                branchName,

                circleCode,
                circleName,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyCode()
                        : null,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster()
                        .getCurrencyName()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getCglNumber()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster()
                        .getDescription()
                        : null,

                entity.getNarration(),
                entity.getDebitAmount(),
                entity.getCreditAmount(),
                entity.getTransactionCount(),
                entity.getSourceFlag()
        );
    }

    private String getSortField(
            String field
    ) {

        return switch (field) {

            case "transactionId" -> "transactionId";
            case "batchId" -> "batchId";
            case "journalId" -> "journalId";
            case "transactionDate" -> "transactionDate";
            case "postDate" -> "postDate";
            case "narration" -> "narration";
            case "debitAmount" -> "debitAmount";
            case "creditAmount" -> "creditAmount";
            case "transactionCount" -> "transactionCount";
            case "sourceFlag" -> "sourceFlag";

            case "branchCode" -> "branch.code";
            case "branchName" -> "branch.name";

            case "circleCode" -> "branch.circle.circleCode";
            case "circleName" -> "branch.circle.circleName";

            case "currency" -> "currencyMaster.currencyCode";
            case "currencyName" -> "currencyMaster.currencyName";

            case "cgl" -> "cglMaster.cglNumber";
            case "description" -> "cglMaster.description";

            default -> "transactionDate";
        };
    }
}