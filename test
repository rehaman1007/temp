const [tableName, setTableName] =
  useState("");

useEffect(() => {
  if (
    ["INSERT", "CLIPBOARD"].includes(
      exportType,
    )
  ) {
    setTableName(
      getSuggestedTableName(
        lastExecutedQuery,
      ),
    );
  }
}, [
  exportType,
  lastExecutedQuery,
]);

const getSuggestedTableName = (sql) => {
  if (!sql) return "EXPORT_TABLE";

  const normalized = sql
    .replace(/\s+/g, " ")
    .trim();

  /**
   * FROM table_name
   */
  const match = normalized.match(
    /\bFROM\s+([A-Z0-9_$.]+)/i,
  );

  if (!match?.[1]) {
    return "EXPORT_TABLE";
  }

  let tableName = match[1];

  /**
   * Remove schema if present
   * SCHEMA.EMP -> EMP
   */
  if (tableName.includes(".")) {
    tableName =
      tableName.split(".").pop();
  }

  return `${tableName}_BACKUP`;
};

onChange={(e) => {
  const value = e.target.value;

  setExportType(value);

  if (
    value === "INSERT" ||
    value === "CLIPBOARD"
  ) {
    setTableName(
      getSuggestedTableName(
        lastExecutedQuery,
      ),
    );
  }
}}