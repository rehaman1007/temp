    transformData: (data) => {
      return data.map((row) => {
        const parsed = row.payload || {};
        const rows = parsed.rows || [];

        return {
          ...row,
          ...parsed,
          fileType: parsed.fileType || row.targetId,
          rowCount: rows.length,
        };
      });
    },

    processViewData: (data) => {
      if (!data || typeof data !== "object") return data;

      const { fileType = "", rows = [], key = "" } = data;

      /* -------- Transform Rows -------- */

      const formattedRows = (rows || []).map((r, index) => ({
        "Sr No": index + 1,
        "Column Name": r.columnName,
        "Start Value": r.startValue,
        "End Value": r.endValue,
        Included: r.toBeIncluded === "yes" ? "Yes" : "No",
        "Data Type": r.dataType,
        "Decimal Count": r.dataType === "AMOUNT" ? (r.decimalCount ?? 0) : "-",
      }));

      /* -------- Final View Payload -------- */

      const viewPayload = {
        ShowCustomTable: true,
        summaryData: {
          data: formattedRows || [],
          header: fileType + " File Data Parameters:",
        },
      };

      return {
        ...data,
        payload: viewPayload,
      };
    },
  },
