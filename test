// useApi.js
import { useEffect, useRef, useState, useCallback } from "react";
import axios from "axios";
import { useNavigate } from "react-router-dom";
import useCustomSnackbar from "../utils/useCustomSnackbar";
import { useSelector } from "react-redux";
import { resolveConfig } from "../config/EnvironmentConfig";

const useApi = () => {
  const [data, setData] = useState(null); // Store API response data
  const [error, setError] = useState(null); // Store error info
  const [loading, setLoading] = useState(false); // Loading state
  const navigate = useNavigate();
  const snackbar = useCustomSnackbar();
  const token = useSelector((state) => state.auth.token);
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const xRequestType = selectedMenuItem?.requestType || "*";
  
  // Keep track of active requests for cancellation
  const activeRequestsRef = useRef(new Set());

  /** Refresh token handler (if required) */
  const refreshToken = async () => {
    try {
      await axios.post(
        `${resolveConfig("/LS") ?? ""}/refresh-token`,
        {},
        { withCredentials: true }
      );
    } catch (err) {
      console.error("Token refresh failed", err);
    }
  };

  /** Cancel all ongoing requests */
  const cancelAllRequests = () => {
    activeRequestsRef.current.forEach((controller) => {
      if (controller && !controller.signal.aborted) {
        controller.abort();
      }
    });
    activeRequestsRef.current.clear();
    setLoading(false);
  };

  // Cleanup on unmount
  useEffect(() => {
    return () => cancelAllRequests();
  }, []);

 
  const callApi = useCallback(
    async (
      url,
      payload = null,
      method = "GET",
      responseType = "json",
      contentType = "application/json",
      extraConfig = {},
      returnDataOnly = true
    ) => {
      // Build final URL using service resolution
      const parts = url.split("/");
      const service = parts[1];
      const resolved = resolveConfig(`/${service}`);
      parts[1] = resolved;
      const Final_Url = parts.slice(1).join("/");

      const controller = new AbortController();
      activeRequestsRef.current.add(controller);

      setLoading(true);
      setError(null);

      console.log("menu ID >>", selectedMenuItem?.id);
      console.log("menu title >>", selectedMenuItem?.title);
      console.log("xRequestType >>", xRequestType);

      try {
        const headers = {
          Authorization: `Bearer ${token}`,
          "Content-Type": contentType,
          "X-Request-Type": xRequestType,
        };

        const config = {
          method: method.toUpperCase(),
          url: Final_Url,
          headers,
          responseType,
          withCredentials: true,
          signal: controller.signal,
          ...extraConfig,
        };

        // Attach payload depending on method type
        if (payload !== null) {
          if (method.toUpperCase() === "GET") {
            config.params = payload;
          } else {
            config.data = payload;
          }
        }

        const response = await axios(config);

        if (!controller.signal.aborted) {
          setData(response.data);
          return returnDataOnly ? response.data : response;
        }
      } catch (err) {
        // Axios error structure: err.response?.status
        const status = err.response?.status;

        // Session / auth handling
        if (status === 440) {
          navigate("/");
          window.alert("You have logged in another session");
        }

        if (status === 401 && err.response?.data?.message === "INVALID_TOKEN") {
          navigate("/");
        }

        // Ignore cancellation
        if (!axios.isCancel(err) && !controller.signal.aborted) {
          console.error("API call error:", err);

          const apiMessage =
            err.response?.data?.result?.message ||
            err.response?.data?.message ||
            err.response?.statusText ||
            "Something went wrong";

          snackbar(apiMessage, "error");
          setError(err);
        }

        if (axios.isCancel(err)) {
          // Let caller handle cancellation if they care
          throw err;
        }
      } finally {
        activeRequestsRef.current.delete(controller);
        setLoading(false);
      }
    },
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [navigate, snackbar, token]
  );

  return { data, error, loading, callApi, cancelAllRequests, refreshToken };
};

export default useApi;
