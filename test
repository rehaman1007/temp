const lazyRetry = (importFunc) =>
  new Promise((resolve, reject) => {
    importFunc()
      .then(resolve)
      .catch((error) => {
        console.error("Chunk load failed:", error);

        const isReloaded = sessionStorage.getItem("retry");

        if (!isReloaded) {
          sessionStorage.setItem("retry", "true");
          window.location.reload();
        } else {
          reject(error);
        }
      });
  });

export default lazyRetry;

const checkVersion = async () => {
  try {
    const res = await fetch(`/version.json?ts=${Date.now()}`);
    const data = await res.json();

    if (data.version !== __APP_VERSION__) {
      console.log("New version detected. Reloading...");
      window.location.reload();
    }
  } catch (e) {
    console.error("Version check failed", e);
  }
};

export default checkVersion;

import React from "react";
import lazyRetry from "../utils/lazyRetry";

// 🔥 MAP ALL YOUR PAGES HERE
const componentMap = {
  Home: React.lazy(() =>
    lazyRetry(() => import("../pages/Home"))
  ),
  Help: React.lazy(() =>
    lazyRetry(() => import("../features/help/Help"))
  ),
  ProcessStatusPage: React.lazy(() =>
    lazyRetry(() => import("../pages/ProcessStatusPage"))
  ),
  SubmenuSelectionPage: React.lazy(() =>
    lazyRetry(() => import("../pages/SubmenuSelectionPage"))
  ),
};

export const generateRouteObjects = (menus) => {
  return menus
    .map((menu) => {
      const Component = componentMap[menu.component];

      if (!Component) {
        console.warn("Component not found:", menu.component);
        return null;
      }

      return {
        path: menu.path,
        element: <Component />,
      };
    })
    .filter(Boolean);
};

import React, { useMemo, Suspense } from "react";
import { createBrowserRouter, RouterProvider } from "react-router-dom";
import { useSelector } from "react-redux";
import PrivateRouter from "./PrivateRouter";

import NotFound from "../pages/NotFound";
import ServerError from "../pages/ServerError";
import CommonLayout from "../layout/CommonLayout";
import FullscreenLayout from "../layout/FullscreenLayout";

import { generateRouteObjects } from "./RouteGenerator";
import LaunchScreen from "../components/live-countdown/components/LaunchScreen";

const PageLoader = () => (
  <div style={{ display: "flex", height: "100vh", justifyContent: "center", alignItems: "center" }}>
    Loading...
  </div>
);

const DynamicLayout = () => {
  const isComponentFullscreen = useSelector(
    (state) => state.ui.isComponentFullscreen
  );
  return !isComponentFullscreen ? <CommonLayout /> : <FullscreenLayout />;
};

const AppRouter = () => {
  const menus = useSelector((state) => state.menus.menus);

  const router = useMemo(() => {
    const dynamicRoutes = generateRouteObjects(menus || []);

    return createBrowserRouter([
      {
        path: "/",
        element: <LaunchScreen />,
        errorElement: <ServerError />,
      },
      {
        path: "/server-error",
        element: <ServerError />,
      },
      {
        element: <PrivateRouter />,
        children: [
          {
            element: <DynamicLayout />,
            children: [...dynamicRoutes],
          },
        ],
      },
      {
        path: "*",
        element: <NotFound />,
      },
    ]);
  }, [menus]);

  return (
    <Suspense fallback={<PageLoader />}>
      <RouterProvider router={router} />
    </Suspense>
  );
};

export default AppRouter;

import "./App.css";
import AppRouter from "./routes/AppRouter";
import {
  Box,
  CssBaseline,
  StyledEngineProvider,
  useColorScheme,
} from "@mui/material";
import { useEffect } from "react";
import { SnackbarProviderComponent } from "./utils/SnackbarContext";
import GlobalBackground from "./theme/GlobalBackground";
import AppTheme from "./theme/AppTheme";
import { AuthProvider } from "./context/AuthContext";
import checkVersion from "./utils/versionCheck";

const ColorSchemeInitializer = () => {
  const { mode, setMode } = useColorScheme();

  useEffect(() => {
    if (mode === "system" || mode === undefined) {
      setMode("light");
    }
  }, [mode, setMode]);

  return null;
};

function App() {
  useEffect(() => {
    checkVersion();
  }, []);

  return (
    <AppTheme>
      <StyledEngineProvider enableCssLayer>
        <ColorSchemeInitializer />
        <CssBaseline enableColorScheme />
        <GlobalBackground />
        <Box
          sx={{
            transition:
              "background-color 0.6s ease, color 0.6s ease, filter 0.6s ease",
          }}
        >
          <AuthProvider>
            <SnackbarProviderComponent>
              <AppRouter />
            </SnackbarProviderComponent>
          </AuthProvider>
        </Box>
      </StyledEngineProvider>
    </AppTheme>
  );
}

export default App;

