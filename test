const [fromDate, setFromDate] = useState(null);
const [toDate, setToDate] = useState(null);

const [fromDateError, setFromDateError] = useState(null);
const [toDateError, setToDateError] = useState(null);

const [fromDateInputValue, setFromDateInputValue] = useState("");
const [toDateInputValue, setToDateInputValue] = useState("");


const getFromDateErrorMessage = (error) => {
  const minDateStr = minDate?.isValid()
    ? minDate.format("DD/MM/YYYY")
    : "Allowed Min Date";

  switch (error) {
    case "maxDate":
      return "Date cannot be in the future.";

    case "minDate":
      return `Date cannot be prior to ${minDateStr}`;

    case "invalidDate":
      return "Please enter a valid date in DD/MM/YYYY format.";

    case "fromDateAfterToDate":
      return "From Date cannot be greater than To Date.";

    default:
      return "";
  }
};

const getToDateErrorMessage = (error) => {
  const minDateStr = minDate?.isValid()
    ? minDate.format("DD/MM/YYYY")
    : "Allowed Min Date";

  switch (error) {
    case "maxDate":
      return "Date cannot be in the future.";

    case "minDate":
      return `Date cannot be prior to ${minDateStr}`;

    case "invalidDate":
      return "Please enter a valid date in DD/MM/YYYY format.";

    case "toDateBeforeFromDate":
      return "To Date cannot be less than From Date.";

    default:
      return "";
  }
};


<FormControl sx={styles.formControl}>
  <LocalizationProvider
    dateAdapter={AdapterDayjs}
    adapterLocale="en-gb"
  >
    <DatePicker
      label="From Date *"
      format="DD/MM/YYYY"
      views={["year", "month", "day"]}
      value={fromDate}
      minDate={minDate}
      maxDate={dayjs().endOf("day")}
      disabled={disableInputs}
      onChange={(newDate) => {
        setFromDate(newDate);

        if (
          newDate &&
          toDate &&
          newDate.isValid() &&
          toDate.isValid()
        ) {
          if (newDate.isAfter(toDate, "day")) {
            setFromDateError("fromDateAfterToDate");
            setToDateError("toDateBeforeFromDate");
          } else {
            setFromDateError(null);
            setToDateError(null);
          }
        }
      }}
      onError={(error) => {
        if (error) {
          setFromDateError(error);
          return;
        }

        if (
          fromDate &&
          toDate &&
          fromDate.isValid() &&
          toDate.isValid() &&
          fromDate.isAfter(toDate, "day")
        ) {
          setFromDateError("fromDateAfterToDate");
        } else {
          setFromDateError(null);
        }
      }}
      slotProps={{
        textField: {
          placeholder: "DD/MM/YYYY",
          onChange: (e) =>
            setFromDateInputValue(e.target.value),
          error:
            fromDateInputValue.length === 10 &&
            !!fromDateError,
          helperText:
            fromDateInputValue.length > 0 &&
            fromDateInputValue.length < 10
              ? ""
              : getFromDateErrorMessage(fromDateError),
        },
      }}
    />
  </LocalizationProvider>
</FormControl>


<FormControl sx={styles.formControl}>
  <LocalizationProvider
    dateAdapter={AdapterDayjs}
    adapterLocale="en-gb"
  >
    <DatePicker
      label="To Date *"
      format="DD/MM/YYYY"
      views={["year", "month", "day"]}
      value={toDate}
      minDate={minDate}
      maxDate={dayjs().endOf("day")}
      disabled={disableInputs}
      onChange={(newDate) => {
        setToDate(newDate);

        if (
          fromDate &&
          newDate &&
          fromDate.isValid() &&
          newDate.isValid()
        ) {
          if (newDate.isBefore(fromDate, "day")) {
            setToDateError("toDateBeforeFromDate");
            setFromDateError("fromDateAfterToDate");
          } else {
            setToDateError(null);
            setFromDateError(null);
          }
        }
      }}
      onError={(error) => {
        if (error) {
          setToDateError(error);
          return;
        }

        if (
          fromDate &&
          toDate &&
          fromDate.isValid() &&
          toDate.isValid() &&
          toDate.isBefore(fromDate, "day")
        ) {
          setToDateError("toDateBeforeFromDate");
        } else {
          setToDateError(null);
        }
      }}
      slotProps={{
        textField: {
          placeholder: "DD/MM/YYYY",
          onChange: (e) =>
            setToDateInputValue(e.target.value),
          error:
            toDateInputValue.length === 10 &&
            !!toDateError,
          helperText:
            toDateInputValue.length > 0 &&
            toDateInputValue.length < 10
              ? ""
              : getToDateErrorMessage(toDateError),
        },
      }}
    />
  </LocalizationProvider>
</FormControl>