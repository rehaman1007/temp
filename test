import * as React from "react";
import PropTypes from "prop-types";
import { PieChart } from "@mui/x-charts/PieChart";
import { useDrawingArea } from "@mui/x-charts/hooks";
import { styled } from "@mui/material/styles";
import Typography from "@mui/material/Typography";
import Card from "@mui/material/Card";
import CardContent from "@mui/material/CardContent";
import Box from "@mui/material/Box";
import Stack from "@mui/material/Stack";
import DonutLargeIcon from "@mui/icons-material/DonutLarge";
import LinearProgress from "@mui/material/LinearProgress";
import Avatar from "@mui/material/Avatar";

import { dashboardChartSx } from "./DashboardStyles";

/* ================= Center Text ================= */

const StyledText = styled("text", {
  shouldForwardProp: (prop) => prop !== "variant",
})(({ theme, variant }) => ({
  textAnchor: "middle",
  dominantBaseline: "central",
  fill: theme.palette.text.secondary,
  fontSize:
    variant === "primary"
      ? theme.typography.h6.fontSize
      : theme.typography.body2.fontSize,
  fontWeight:
    variant === "primary"
      ? theme.typography.h6.fontWeight
      : theme.typography.body2.fontWeight,
}));

function PieCenterLabel({ primaryText, secondaryText }) {
  const { width, height, left, top } = useDrawingArea();
  const primaryY = top + height / 2 - 8;
  const secondaryY = primaryY + 20;

  return (
    <>
      <StyledText variant="primary" x={left + width / 2} y={primaryY}>
        {primaryText}
      </StyledText>
      <StyledText variant="secondary" x={left + width / 2} y={secondaryY}>
        {secondaryText}
      </StyledText>
    </>
  );
}

PieCenterLabel.propTypes = {
  primaryText: PropTypes.string.isRequired,
  secondaryText: PropTypes.string.isRequired,
};

/* ================= Component ================= */

const defaultColors = [
  "hsl(220, 25%, 65%)",
  "hsl(220, 25%, 45%)",
  "hsl(220, 25%, 30%)",
  "hsl(220, 25%, 20%)",
];

const defaultIcon = <DonutLargeIcon />;

export default function DashboardCustomChart({
  title,
  icon = defaultIcon,
  seriesData = [],
  colors = defaultColors,
}) {
  const total = seriesData.reduce(
    (s, it) => s + (Number(it.value) || 0),
    0
  );

  const chartData = seriesData.map((d) => ({
    label: d.label,
    value: Number(d.value) || 0,
  }));

  const legendItems = chartData.map((d, idx) => ({
    name: d.label,
    value: total > 0 ? Math.round((d.value / total) * 100) : 0,
    color: colors[idx % colors.length],
    icon: (
      <Avatar sx={dashboardChartSx.legendAvatar(colors[idx % colors.length])} />
    ),
  }));

  return (
    <Card variant="outlined" sx={dashboardChartSx.card}>
      <CardContent>
        <Stack direction="row" spacing={1} alignItems="center" mb={1}>
          <Box sx={dashboardChartSx.headerIconBox}>{icon}</Box>
          <Typography variant="subtitle1" fontWeight={700}>
            {title}
          </Typography>
        </Stack>

        <Box sx={dashboardChartSx.chartRow}>
          <Box>
            <PieChart
              colors={colors}
              margin={{ left: 24, right: 24, top: 24, bottom: 24 }}
              series={[
                {
                  data: chartData,
                  innerRadius: 75,
                  outerRadius: 100,
                  paddingAngle: 0,
                  highlightScope: {
                    fade: "global",
                    highlight: "item",
                  },
                },
              ]}
              height={260}
              width={260}
              hideLegend
            >
              <PieCenterLabel primaryText={`${total}`} secondaryText="Total" />
            </PieChart>
          </Box>

          <Box sx={dashboardChartSx.legendContainer}>
            <Stack spacing={1}>
              {legendItems.length === 0 && (
                <Typography variant="caption" color="text.secondary">
                  No data
                </Typography>
              )}

              {legendItems.map((it, idx) => (
                <Stack
                  key={it.name + idx}
                  direction="row"
                  alignItems="center"
                  spacing={1}
                >
                  <Box sx={dashboardChartSx.legendIconWrapper}>
                    {it.icon}
                  </Box>

                  <Box sx={{ flex: 1 }}>
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                    >
                      <Typography
                        variant="body2"
                        sx={dashboardChartSx.legendTitle}
                      >
                        {it.name}
                      </Typography>
                      <Typography
                        variant="body2"
                        color="text.secondary"
                      >
                        {it.value}%
                      </Typography>
                    </Stack>

                    <LinearProgress
                      variant="determinate"
                      value={it.value}
                      sx={dashboardChartSx.progressBar(it.color)}
                      aria-label={`${it.name} share`}
                    />
                  </Box>
                </Stack>
              ))}
            </Stack>
          </Box>
        </Box>
      </CardContent>
    </Card>
  );
}

import { linearProgressClasses } from "@mui/material/LinearProgress";

export const dashboardChartSx = {
  card: {
    display: "flex",
    flexDirection: "column",
    gap: "8px",
    flexGrow: 1,
    transition: "transform .14s ease, box-shadow .14s ease",
    "&:hover": {
      transform: "translateY(-4px)",
      boxShadow: 4,
    },
  },

  headerIconBox: {
    width: 44,
    height: 44,
    borderRadius: 2,
    bgcolor: "rgba(0,0,0,0.06)",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
  },

  chartRow: {
    display: "flex",
    gap: 2,
    alignItems: "center",
  },

  legendContainer: {
    flex: 1,
    minWidth: 140,
  },

  legendIconWrapper: {
    width: 28,
  },

  legendTitle: {
    fontWeight: 600,
  },

  progressBar: (color) => ({
    height: 8,
    borderRadius: 2,
    mt: 0.5,
    [`& .${linearProgressClasses.bar}`]: {
      backgroundColor: color,
    },
  }),

  legendAvatar: (color) => ({
    width: 18,
    height: 18,
    bgcolor: color,
  }),
};