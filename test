import React from "react";

import {
  Alert,
  AlertTitle,
  alpha,
  Box,
  Chip,
  Grid,
  LinearProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";

import {
  CheckCircle,
  ErrorOutline,
  Pending,
  Timer,
  WarningAmber,
} from "@mui/icons-material";

const ExecutionDashboard = ({ jobStatus }) => {
  const theme = useTheme();

  if (!jobStatus) return null;

  /**
   * =========================================
   * STATUS COLOR
   * =========================================
   */
  const getStatusColor = () => {
    switch (jobStatus.status) {
      case "COMPLETED":
        return "success";

      case "FAILED":
        return "error";

      default:
        return "warning";
    }
  };

  /**
   * =========================================
   * STATUS ICON
   * =========================================
   */
  const getStatusIcon = () => {
    switch (jobStatus.status) {
      case "COMPLETED":
        return <CheckCircle />;

      case "FAILED":
        return <ErrorOutline />;

      default:
        return <Pending />;
    }
  };

  /**
   * =========================================
   * STATS
   * =========================================
   */
  const stats = [
    {
      label: "Executed",
      value: jobStatus.executedCount || 0,
    },

    {
      label: "Insert",
      value: jobStatus.insertCount || 0,
    },

    {
      label: "Update",
      value: jobStatus.updateCount || 0,
    },

    {
      label: "Delete",
      value: jobStatus.deleteCount || 0,
    },

    {
      label: "Others",
      value: jobStatus.otherCount || 0,
    },

    {
      label: "Total",
      value: jobStatus.totalStatements || 0,
    },

    {
      label: "Elapsed",
      value: `${jobStatus.elapsedSeconds || 0} sec`,
    },

    {
      label: "ETA",
      value: `${jobStatus.etaSeconds || 0} sec`,
    },
  ];

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 4,
        p: 3,
        border: `1px solid ${theme.palette.divider}`,
        overflow: "hidden",
        position: "relative",
      }}
    >
      {/* ================================================= */}
      {/* BACKGROUND GLOW */}
      {/* ================================================= */}

      <Box
        sx={{
          position: "absolute",
          top: -80,
          right: -80,

          width: 220,
          height: 220,

          borderRadius: "50%",

          background:
            "radial-gradient(circle, rgba(59,130,246,0.18), transparent)",

          pointerEvents: "none",
        }}
      />

      {/* ================================================= */}
      {/* HEADER */}
      {/* ================================================= */}

      <Stack
        direction="row"
        justifyContent="space-between"
        alignItems="center"
        flexWrap="wrap"
        gap={2}
        mb={3}
      >
        <Box>
          <Typography variant="h6" fontWeight={800}>
            Live Execution Monitor
          </Typography>

          <Typography variant="body2" color="text.secondary" mt={0.5}>
            Job ID : {jobStatus.jobId}
          </Typography>
        </Box>

        <Chip
          icon={getStatusIcon()}
          label={jobStatus.status}
          color={getStatusColor()}
          sx={{
            fontWeight: 700,
            px: 1,
          }}
        />
      </Stack>

      {/* ================================================= */}
      {/* PROGRESS */}
      {/* ================================================= */}

      <Box
        sx={{
          position: "relative",
          mb: 4,
        }}
      >
        <LinearProgress
          variant="determinate"
          value={jobStatus.progress || 0}
          sx={{
            height: 16,
            borderRadius: 20,
            bgcolor: alpha(theme.palette.primary.main, 0.12),

            "& .MuiLinearProgress-bar": {
              borderRadius: 20,

              background: "linear-gradient(90deg,#2563eb,#7c3aed)",
            },
          }}
        />

        <Typography
          variant="caption"
          sx={{
            position: "absolute",
            top: -24,
            right: 0,
            fontWeight: 800,
          }}
        >
          {jobStatus.progress || 0}%
        </Typography>
      </Box>

      {/* ================================================= */}
      {/* STATS */}
      {/* ================================================= */}

      <Grid container spacing={2}>
        {stats.map((item) => (
          <Grid
            size={{
              xs: 6,
              md: 3,
            }}
            key={item.label}
          >
            <Paper
              elevation={0}
              sx={{
                borderRadius: 3,
                p: 2,

                textAlign: "center",

                bgcolor: alpha(theme.palette.primary.main, 0.04),

                border: "1px solid rgba(59,130,246,0.08)",

                transition: "all .25s ease",

                "&:hover": {
                  transform: "translateY(-2px)",
                  boxShadow: "0 8px 24px rgba(0,0,0,0.08)",
                },
              }}
            >
              <Typography variant="body2" color="text.secondary">
                {item.label}
              </Typography>

              <Typography variant="h5" fontWeight={800} mt={0.5}>
                {item.value}
              </Typography>
            </Paper>
          </Grid>
        ))}
      </Grid>

      {/* ================================================= */}
      {/* RUNNING */}
      {/* ================================================= */}

      {jobStatus.status === "RUNNING" && (
        <Alert
          severity="warning"
          icon={<Timer />}
          sx={{
            mt: 3,
            borderRadius: 3,
          }}
        >
          <AlertTitle>Execution In Progress</AlertTitle>
          Please stay on this screen until execution completes.
        </Alert>
      )}

      {/* ================================================= */}
      {/* FAILED */}
      {/* ================================================= */}

      {jobStatus.status === "FAILED" && (
        <Alert
          severity="error"
          icon={<WarningAmber />}
          sx={{
            mt: 3,
            borderRadius: 3,
          }}
        >
          <AlertTitle>Execution Failed</AlertTitle>

          <Typography variant="body2">{jobStatus.message}</Typography>

          <Typography variant="body2" mt={1} fontWeight={700}>
            Failed Line : {jobStatus.failedLine || "-"}
          </Typography>

          {jobStatus.failedSql && (
            <Box
              sx={{
                mt: 2,
                p: 2,
                borderRadius: 2,
                bgcolor: "#111827",
                overflowX: "auto",
              }}
            >
              <Typography
                variant="caption"
                sx={{
                  color: "#fca5a5",
                  fontFamily: "monospace",
                  whiteSpace: "pre-wrap",
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          )}
        </Alert>
      )}

      {/* ================================================= */}
      {/* SUCCESS */}
      {/* ================================================= */}

      {jobStatus.status === "COMPLETED" && (
        <Alert
          severity="success"
          sx={{
            mt: 3,
            borderRadius: 3,
            color: "white",
          }}
        >
          <AlertTitle>Execution Completed Successfully</AlertTitle>
          Total statements executed : {jobStatus.executedCount}
        </Alert>
      )}
    </Paper>
  );
};

export default ExecutionDashboard;





import React from "react";

import {
  Alert,
  AlertTitle,
  alpha,
  Box,
  Chip,
  Divider,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";

import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";
import CustomChip from "../../../utils/CustomChip";

const LogsPanel = ({ lastResponse, jobStatus }) => {
  const theme = useTheme();

  /**
   * =========================================
   * EMPTY STATE
   * =========================================
   */
  if (!lastResponse && !jobStatus) {
    return (
      <Paper
        elevation={0}
        sx={{
          borderRadius: 1,
          border: `1px solid ${theme.palette.divider}`,
          overflow: "hidden",
        }}
      >
        <Box
          sx={{
            px: 2.5,
            py: 1.5,

            background: "linear-gradient(135deg,#111827,#1f2937)",

            color: "white",
          }}
        >
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>
        </Box>

        <Box p={3}>
          <Alert
            severity="info"
            icon={<Info />}
            sx={{
              borderRadius: 3,
            }}
          >
            <AlertTitle>Waiting for execution</AlertTitle>
            Execute SQL query or upload script to view logs.
          </Alert>
        </Box>
      </Paper>
    );
  }

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 1,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* ================================================= */}
      {/* HEADER */}
      {/* ================================================= */}

      <Box
        sx={{
          px: 2.5,
          py: 1.5,

          background: "linear-gradient(135deg,#111827,#1f2937)",

          color: "white",

          borderBottom: "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          {/* LEFT */}

          <Stack direction="row" spacing={1.5} alignItems="center">
            <Terminal fontSize="small" />

            <Typography fontWeight={800}>Execution Logs</Typography>
          </Stack>

          {/* STATUS */}

          {jobStatus?.status && (
            <Chip
              size="small"
              label={jobStatus.status}
              color={
                jobStatus.status === "COMPLETED"
                  ? "success"
                  : jobStatus.status === "FAILED"
                    ? "error"
                    : "warning"
              }
            />
          )}
        </Stack>
      </Box>

      {/* ================================================= */}
      {/* TERMINAL BODY */}
      {/* ================================================= */}

      <Box
        sx={{
          p: 2.5,

          bgcolor: "#020617",

          color: "#e2e8f0",

          fontFamily: "monospace",

          flex: 1,

          overflow: "auto",

          minHeight: 400,
        }}
      >
        {/* ============================================= */}
        {/* JOB STATUS */}
        {/* ============================================= */}

        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#38bdf8",
                mb: 1,
              }}
            >
              {">"} JOB STATUS
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,
                borderRadius: 2,

                bgcolor: "rgba(255,255,255,0.03)",

                border: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack spacing={1}>
                <Typography>STATUS : {jobStatus.status}</Typography>

                <Typography>JOB ID : {jobStatus.jobId}</Typography>

                <Typography>
                  EXECUTED : {jobStatus.executedCount || 0}
                </Typography>

                <Typography>
                  TOTAL : {jobStatus.totalStatements || 0}
                </Typography>

                <Typography>
                  ELAPSED : {jobStatus.elapsedSeconds || 0} sec
                </Typography>

                <Typography>PROGRESS : {jobStatus.progress || 0}%</Typography>
              </Stack>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* ERROR */}
        {/* ============================================= */}

        {(lastResponse?.error || jobStatus?.status === "FAILED") && (
          <>
            <Typography
              sx={{
                color: "#f87171",
                mb: 1,
              }}
            >
              {">"} ERROR LOG
            </Typography>

            <Alert
              severity="error"
              icon={<ErrorOutline />}
              sx={{
                mb: 3,
                borderRadius: 3,
              }}
            >
              <AlertTitle>Execution Failed</AlertTitle>

              {lastResponse?.message || jobStatus?.message || "Unknown error"}

              {jobStatus?.failedLine && (
                <>
                  <Divider
                    sx={{
                      my: 1,
                    }}
                  />
                  Failed Line : {jobStatus.failedLine}
                </>
              )}
            </Alert>
          </>
        )}

        {/* ============================================= */}
        {/* FAILED SQL */}
        {/* ============================================= */}

        {jobStatus?.failedSql && (
          <>
            <Typography
              sx={{
                color: "#fb7185",
                mb: 1,
              }}
            >
              {">"} FAILED SQL
            </Typography>

            <Box
              sx={{
                mb: 3,
                p: 2,

                borderRadius: 2,

                bgcolor: "#111827",

                border: "1px solid rgba(248,113,113,0.2)",

                overflowX: "auto",
              }}
            >
              <Typography
                sx={{
                  whiteSpace: "pre-wrap",
                  color: "#fca5a5",
                  fontSize: 13,
                  lineHeight: 1.8,
                }}
              >
                {jobStatus.failedSql}
              </Typography>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* SUCCESS */}
        {/* ============================================= */}

        {lastResponse && !lastResponse.error && (
          <>
            <Typography
              sx={{
                color: "#4ade80",
                mb: 1,
              }}
            >
              {">"} EXECUTION SUCCESS
            </Typography>

            <Alert
              severity="success"
              icon={<CheckCircle sx={{ color: "white" }} />}
              sx={{
                mb: 3,
                borderRadius: 3,
                color: "white",
              }}
            >
              <AlertTitle>SQL Executed Successfully</AlertTitle>

              {lastResponse?.rows?.[0]?.RESULT ||
                "Execution completed successfully"}
            </Alert>
          </>
        )}

        {/* ============================================= */}
        {/* SUMMARY */}
        {/* ============================================= */}

        {jobStatus && (
          <>
            <Typography
              sx={{
                color: "#c084fc",
                mb: 1,
              }}
            >
              {">"} EXECUTION SUMMARY
            </Typography>

            <Box
              sx={{
                p: 2,

                borderRadius: 2,

                bgcolor: alpha(theme.palette.primary.main, 0.08),

                border: "1px solid rgba(255,255,255,0.06)",
              }}
            >
              <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
                <CustomChip
                  variant="outlined"
                  label={`INSERT : ${jobStatus.insertCount || 0}`}
                  color="success"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`UPDATE : ${jobStatus.updateCount || 0}`}
                  color="warning"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`DELETE : ${jobStatus.deleteCount || 0}`}
                  color="error"
                  size="small"
                />

                <CustomChip
                  variant="outlined"
                  label={`OTHERS : ${jobStatus.otherCount || 0}`}
                  color="info"
                  size="small"
                />
              </Stack>
            </Box>
          </>
        )}

        {/* ============================================= */}
        {/* RUNNING */}
        {/* ============================================= */}

        {jobStatus?.status === "RUNNING" && (
          <Alert
            severity="warning"
            icon={<WarningAmber />}
            sx={{
              mt: 3,
              borderRadius: 3,
            }}
          >
            <AlertTitle>Execution In Progress</AlertTitle>
            Total statements pending :{" "}
            {Number(jobStatus?.totalStatements || 0) -
              Number(jobStatus?.executedCount || 0)}
          </Alert>
        )}
      </Box>
    </Paper>
  );
};

export default LogsPanel;
