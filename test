{/* ROW 2: BALANCES */}
{showBalances && balances && (
  <Grid container spacing={2}>
    {[
      {
        label: "Opening Balance",
        date: balances.openingDate || balances.OpeningDate,
        amt: balances.openingBalance,
        icon: <AccountBalanceWalletIcon />,
      },
      {
        label: "Closing Balance",
        date: balances.closingDate || balances.ClosingDate,
        amt: balances.closingBalance,
        icon: <AccountBalanceWalletIcon />,
      },
    ].map((item, index) => {
      const isNeg = item.amt < 0;
      const indicator = isNeg ? "DR" : "CR";
      const absVal = Math.abs(item.amt || 0).toFixed(4);

      const activeColor = isNeg ? "#b84646f3" : "#427a44";
      const activeBg = isNeg
        ? "linear-gradient(135deg, #fff5f5 0%, #fed7d759 100%)"
        : "linear-gradient(135deg, #f6fdf9 0%, #c6f6d556 100%)";

      return (
        <Grid
          key={index}
          size={{
            xs: 12,
            sm: 6,
          }}
        >
          <Box
            sx={{
              p: { xs: 1, sm: 0.8 },
              borderRadius: "12px",
              background: activeBg,
              border: "1px solid rgba(255,255,255,0.3)",
              borderBottom: `4px solid ${activeColor}`,
              display: "flex",
              flexDirection: {
                xs: "column",
                sm: "row",
              },
              alignItems: {
                xs: "flex-start",
                sm: "center",
              },
              justifyContent: "space-between",
              gap: 1.5,
              position: "relative",
              overflow: "hidden",
              minHeight: {
                xs: 110,
                sm: 90,
              },
            }}
          >
            <Stack
              direction="row"
              alignItems="center"
              sx={{ zIndex: 1, width: "100%" }}
            >
              <Box
                sx={{
                  p: 0.6,
                  borderRadius: "10px",
                  bgcolor: "#fff",
                  display: "flex",
                  mr: 1.5,
                  boxShadow: "0 2px 6px rgba(0,0,0,0.05)",
                  color: activeColor,
                  flexShrink: 0,
                }}
              >
                {item.icon}
              </Box>

              <Box sx={{ minWidth: 0 }}>
                <Typography
                  sx={{
                    color: "text.secondary",
                    fontWeight: 700,
                    textTransform: "uppercase",
                    fontSize: {
                      xs: "0.65rem",
                      sm: "0.72rem",
                    },
                  }}
                >
                  {item.label}
                </Typography>

                <Typography
                  sx={{
                    fontWeight: 800,
                    color: "#2c3e50",
                    lineHeight: 1.2,
                    fontSize: {
                      xs: "0.85rem",
                      sm: "0.95rem",
                    },
                    wordBreak: "break-word",
                  }}
                >
                  {absVal}

                  <Box
                    component="span"
                    sx={{
                      fontSize: {
                        xs: "0.65rem",
                        sm: "0.7rem",
                      },
                      ml: 0.5,
                      color: activeColor,
                      fontWeight: 900,
                    }}
                  >
                    {indicator}
                  </Box>
                </Typography>
              </Box>
            </Stack>

            {isNeg ? (
              <TrendingDownIcon
                sx={{
                  position: "absolute",
                  left: "50%",
                  top: "50%",
                  transform: "translate(-50%, -50%)",
                  fontSize: {
                    xs: "2.2rem",
                    sm: "2.8rem",
                  },
                  opacity: 0.25,
                  color: activeColor,
                  zIndex: 0,
                }}
              />
            ) : (
              <TrendingUpIcon
                sx={{
                  position: "absolute",
                  left: "50%",
                  top: "50%",
                  transform: "translate(-50%, -50%)",
                  fontSize: {
                    xs: "2.2rem",
                    sm: "2.8rem",
                  },
                  opacity: 0.25,
                  color: activeColor,
                  zIndex: 0,
                }}
              />
            )}

            <Box
              sx={{
                textAlign: {
                  xs: "left",
                  sm: "right",
                },
                zIndex: 1,
                width: {
                  xs: "100%",
                  sm: "auto",
                },
              }}
            >
              <Stack
                direction="row"
                alignItems="center"
                spacing={0.5}
                justifyContent={{
                  xs: "flex-start",
                  sm: "flex-end",
                }}
              >
                <EventIcon
                  sx={{
                    fontSize: "0.8rem",
                    color: "text.secondary",
                  }}
                />

                <Typography
                  sx={{
                    color: "text.secondary",
                    fontWeight: 700,
                    fontSize: {
                      xs: "0.65rem",
                      sm: "0.72rem",
                    },
                  }}
                >
                  AS OF
                </Typography>
              </Stack>

              <Typography
                sx={{
                  color: "#2c3e50",
                  fontWeight: 700,
                  display: "block",
                  fontSize: {
                    xs: "0.72rem",
                    sm: "0.8rem",
                  },
                  wordBreak: "break-word",
                }}
              >
                {item.date || "N/A"}
              </Typography>
            </Box>
          </Box>
        </Grid>
      );
    })}
  </Grid>
)}