<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Dynamic Colspan/Rowspan Table</title>
  <style>
    table {
      border-collapse: collapse;
      width: 100%;
    }
    th, td {
      border: 1px solid #000;
      padding: 6px 8px;
      text-align: center;
    }
    th {
      background: #eee;
    }
  </style>
</head>
<body>

<div id="table-container"></div>

<script>
  // --- Nested Columns from DB ---
  const columns = [
    {
      id: 'A',
      title: 'A. Investment in SBI Subsidiary & Joint Venture',
      children: [
        { id: 'A_name', title: 'Name of Investee' },
        { id: 'A_equity', title: 'Equity share capital' },
        { id: 'A_note', title: 'Comments / Remarks' }
      ]
    },
    {
      id: 'B',
      title: 'IPDI (AT I) and Subordinated Debts & Bonds (Tier II)',
      children: [
        { id: 'B_face', title: 'Face Value as at date' },
        { id: 'B_carrying', title: 'Carrying Value as at closing year' },
        { id: 'B_category', title: 'Category' }
      ]
    },
    {
      id: 'C',
      title: 'Investment in Debentures/Bonds/Preference Shares/CDS',
      children: [
        { id: 'C_deb', title: 'Debentures and Bonds' },
        { id: 'C_pref', title: 'Preference Shares/CPS' },
        { id: 'C_cat', title: 'Category' }
      ]
    }
  ];

  // --- Example Data from DB ---
  const data = [
    {
      A_name: 'SBI Subsidiary 1',
      A_equity: '1000',
      A_note: '',
      B_face: '500',
      B_carrying: '480',
      B_category: 'Tier II',
      C_deb: '300',
      C_pref: '50',
      C_cat: 'Type X'
    },
    {
      A_name: 'SBI Subsidiary 2',
      A_equity: '1500',
      A_note: 'Good investment',
      B_face: '700',
      B_carrying: '690',
      B_category: 'Tier I',
      C_deb: '400',
      C_pref: '80',
      C_cat: 'Type Y'
    }
  ];

  // --- Compute table header structure ---
  function getMaxDepth(cols) {
    return Math.max(...cols.map(c => c.children ? 1 + getMaxDepth(c.children) : 1));
  }

  function buildHeaderRows(cols, maxDepth) {
    const rows = Array.from({ length: maxDepth }, () => []);

    function traverse(node, depthIndex) {
      const isLeaf = !node.children || node.children.length === 0;
      const colspan = isLeaf ? 1 : node.children.reduce((sum, child) => sum + traverse(child, depthIndex + 1), 0);
      const rowspan = isLeaf ? maxDepth - depthIndex : 1;

      rows[depthIndex].push({ title: node.title, colspan, rowspan });
      return colspan;
    }

    cols.forEach(c => traverse(c, 0));
    return rows;
  }

  function getLeafColumns(cols) {
    const leafs = [];
    function collect(c) {
      if (!c.children || c.children.length === 0) {
        leafs.push(c);
      } else {
        c.children.forEach(collect);
      }
    }
    cols.forEach(collect);
    return leafs;
  }

  // --- Render table ---
  const maxDepth = getMaxDepth(columns);
  const headerRows = buildHeaderRows(columns, maxDepth);
  const leafColumns = getLeafColumns(columns);

  const table = document.createElement('table');

  // Header
  const thead = document.createElement('thead');
  headerRows.forEach(row => {
    const tr = document.createElement('tr');
    row.forEach(cell => {
      const th = document.createElement('th');
      if (cell.colspan > 1) th.colSpan = cell.colspan;
      if (cell.rowspan > 1) th.rowSpan = cell.rowspan;
      th.textContent = cell.title;
      tr.appendChild(th);
    });
    thead.appendChild(tr);
  });
  table.appendChild(thead);

  // Body
  const tbody = document.createElement('tbody');
  data.forEach(rowData => {
    const tr = document.createElement('tr');
    leafColumns.forEach(col => {
      const td = document.createElement('td');
      td.textContent = rowData[col.id] || '';
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);

  document.getElementById('table-container').appendChild(table);
</script>

</body>
</html>