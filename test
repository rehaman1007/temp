[
  {
    "name": "REPORT_DATE",
    "mode": "INPUT",
    "dataType": "DATE",
    "label": "Report Date"
  },
  {
    "name": "MONTH_START",
    "mode": "EXPRESSION", 
    "dataType": "DATE",
    "expression": "#{ DateUtils.startOfMonth(G.REPORT_DATE) }"
  },
  {
    "name": "USD_RATE",
    "mode": "QUERY",
    "dataType": "NUMBER",
    "label": "USD Exchange Rate",
    "source": {
      "type": "DB_SUM",
      "table": "EXCHANGE_RATES",
      "column": "CONVERSION_RATE",
      "filters": {
        "CURRENCY_CODE": "USD",
        // Dependency on previous param!
        "EFFECTIVE_DATE": "$G{MONTH_START}" 
      }
    }
  },
  {
    "name": "TARGET_REVENUE_INR",
    "mode": "EXPRESSION",
    "dataType": "NUMBER",
    // Uses the DB fetched value
    "expression": "#{ 1000 * G.USD_RATE }" 
  }
]
