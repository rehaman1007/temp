import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Card,
  Container,
  Grid,
  Grow,
  Paper,
  Stack,
  IconButton,
  Tooltip,
  Chip,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
} from "@mui/material";
import { motion, AnimatePresence } from "framer-motion";
import dayjs from "dayjs";

// MUI Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import PictureAsPdfIcon from "@mui/icons-material/PictureAsPdf";
import TableChartIcon from "@mui/icons-material/TableChart";
import ArticleIcon from "@mui/icons-material/Article";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import SyncIcon from "@mui/icons-material/Sync";
import EventBusyIcon from "@mui/icons-material/EventBusy";
import DescriptionIcon from "@mui/icons-material/Description";
import DownloadRoundedIcon from '@mui/icons-material/DownloadRounded';
import CloseIcon from '@mui/icons-material/Close';

// Custom Hooks (Ensure paths match your project)
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import LoadingOverlay from "../../utils/LoadingOverlay";
import CustomChip from "../../utils/CustomChip";

// --- Date Utility ---
const isLastDayOfMonth = (dateString) => {
  if (!dateString) return false;
  const [day, month, year] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return date.getDate() === lastDayOfMonth;
};

// --- Sub-Components ---
const DownloadOptions = ({ isAvailable, onDownload }) => {
  const formats = [
    { id: "PDF", label: "PDF", icon: <PictureAsPdfIcon />, color: "#d32f2f" },
    { id: "EXCEL", label: "Excel", icon: <TableChartIcon />, color: "#1b5e20" },
    { id: "TEXT", label: "Text", icon: <ArticleIcon />, color: "#424242" },
  ];

  return (
    <Box sx={{ display: "flex", gap: 3, mt: 2, justifyContent: "center" }}>
      {formats.map((format, index) => (
        <Tooltip
          title={
            !isAvailable
              ? "ETL job is running. Downloads unavailable."
              : `Download as ${format.label}`
          }
          key={format.id}
          arrow
        >
          <motion.div
            initial={{ opacity: 0, y: 15 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: index * 0.1 }}
            whileHover={isAvailable ? { scale: 1.1, y: -4 } : {}}
            whileTap={isAvailable ? { scale: 0.95 } : {}}
          >
            <Paper
              elevation={0}
              onClick={() => isAvailable && onDownload(format.id)}
              sx={{
                p: 2,
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                gap: 1,
                cursor: isAvailable ? "pointer" : "not-allowed",
                border: "2px solid transparent",
                bgcolor: !isAvailable
                  ? "action.disabledBackground"
                  : `${format.color}08`,
                color: !isAvailable ? "action.disabled" : format.color,
                transition: "all 0.2s ease-in-out",
                opacity: isAvailable ? 1 : 0.6,
                "&:hover": {
                  borderColor: isAvailable ? format.color : "transparent",
                  bgcolor: isAvailable ? `${format.color}15` : "action.disabledBackground",
                },
              }}
            >
              {React.cloneElement(format.icon, { sx: { fontSize: 40 } })}
              <Typography variant="body2" fontWeight="bold">
                {format.label}
              </Typography>
            </Paper>
          </motion.div>
        </Tooltip>
      ))}
    </Box>
  );
};

const ReportCard = ({ report, onClick }) => {
  return (
    <motion.div whileHover={{ y: -5 }} whileTap={{ scale: 0.98 }} style={{ height: "100%" }}>
      <Paper
        onClick={onClick}
        elevation={0}
        sx={{
          p: 3,
          borderRadius: 3,
          border: "1px solid",
          borderColor: "divider",
          background: "linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%)",
          height: "100%",
          display: "flex",
          flexDirection: "column",
          cursor: "pointer",
          transition: "box-shadow 0.3s ease",
          "&:hover": {
            boxShadow: "0 8px 24px rgba(0,0,0,0.05)",
            borderColor: "primary.light",
          },
        }}
      >
        <Box sx={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", mb: 2 }}>
          <Box sx={{ p: 1.5, borderRadius: 2, bgcolor: "primary.50", color: "primary.main" }}>
            <DescriptionIcon />
          </Box>
          <IconButton size="small" color="primary" sx={{ bgcolor: "primary.50" }}>
            <DownloadRoundedIcon fontSize="small" />
          </IconButton>
        </Box>

        <Typography variant="h6" fontWeight="700" color="text.primary" gutterBottom>
          {report.reportName}
        </Typography>
        
        {/* Description spans fully, flex-grow ensures uniform card heights */}
        <Typography variant="body2" color="text.secondary" sx={{ flexGrow: 1, lineHeight: 1.6 }}>
          {report.reportDescription || "No detailed description provided for this adhoc report."}
        </Typography>
      </Paper>
    </motion.div>
  );
};

// --- Main Screen ---

export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [etlDate, setEtlDate] = useState("");
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(false);
  const [reports, setReports] = useState([]);

  const [loading, setLoading] = useState(true);
  const [isDownloading, setIsDownloading] = useState(false);
  
  // State for controlling the download dialog
  const [selectedReport, setSelectedReport] = useState(null);

  const fetchData = async () => {
    setLoading(true);
    try {
      // 1. Fetch Metadata (ETL Date & Availability Flag)
      const etlDetails = await callApi("/PS/file/fincore-date", {}, "GET");

      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.isAvailableToDownload || true;

      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(true);

      // 2. Fetch Dynamic Reports List
      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/adhoc-types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        setReports(reportsData);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar(
        "Failed to load report data. Kindly try again after sometime.",
        "error",
      );
      setEtlDate(dayjs().format("DD-MM-YYYY"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = async (reportId, formatType) => {
    // Close modal first
    setSelectedReport(null);
    setIsDownloading(true);
    showSnackBar(`Generating fresh ${formatType} data...`, "info");

    try {
      const extensions = {
        PDF: ".pdf",
        EXCEL: ".xlsx",
        TEXT: ".txt",
      };
      const fileExtension = extensions[formatType] || ".txt";
      const fileName = `${reportId}_${etlDate}${fileExtension}`;

      const response = await callApi(
        `/RS/reports/download?reportId=${reportId}&format=${formatType}`,
        {},
        "GET",
        { responseType: "blob" },
      );

      const blobData = response?.data || response;
      const blob = new Blob([blobData], { type: "application/octet-stream" });

      const downloadUrl = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = downloadUrl;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();

      link.parentNode.removeChild(link);
      window.URL.revokeObjectURL(downloadUrl);

      showSnackBar(`${fileName} downloaded successfully!`, "success");
    } catch (error) {
      console.error("Download Error:", error);
      showSnackBar("Failed to download the report. Please try again.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  return (
    <>
      <LoadingOverlay loading={loading || isDownloading} />

      {/* Download Dialog Modal */}
      <AnimatePresence>
        {selectedReport && (
          <Dialog
            open={Boolean(selectedReport)}
            onClose={() => setSelectedReport(null)}
            maxWidth="sm"
            fullWidth
            PaperProps={{
              sx: { borderRadius: 3, p: 1 },
              component: motion.div,
              initial: { opacity: 0, y: 20 },
              animate: { opacity: 1, y: 0 },
              exit: { opacity: 0, y: -20 },
            }}
          >
            <DialogTitle sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <Typography variant="h6" fontWeight="bold">
                Download Report
              </Typography>
              <IconButton onClick={() => setSelectedReport(null)} size="small">
                <CloseIcon />
              </IconButton>
            </DialogTitle>
            <Divider />
            <DialogContent sx={{ textAlign: "center", pb: 4 }}>
              <Typography variant="subtitle1" color="primary.main" fontWeight="bold" gutterBottom>
                {selectedReport.reportName}
              </Typography>
              <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                Select your preferred file format to generate and download fresh data for this report.
              </Typography>
              <DownloadOptions
                isAvailable={isAvailableToDownload}
                onDownload={(formatType) => handleDownload(selectedReport.id, formatType)}
              />
            </DialogContent>
          </Dialog>
        )}
      </AnimatePresence>

      <Grow in timeout={500}>
        <Stack spacing={4}>
          <Box
            sx={{
              width: "100%",
              p: { xs: 2, sm: 3, md: 4 },
            }}
          >
            <Stack spacing={3} direction={"column"} alignItems="center" justifyContent="center">
              <Card sx={{ width: "100%", borderRadius: 3, boxShadow: 6, overflow: "hidden" }}>
                
                {/* Unified Header (Titles + ETL Date combined) */}
                <Box
                  sx={{
                    display: "flex",
                    flexDirection: { xs: "column", md: "row" },
                    alignItems: { xs: "flex-start", md: "center" },
                    justifyContent: "space-between",
                    gap: 3,
                    px: { xs: 3, md: 4 },
                    py: { xs: 3, md: 3 },
                    background: "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 100%)",
                    color: "white",
                  }}
                >
                  {/* Left Side: Title & Description */}
                  <Box sx={{ display: "flex", alignItems: "center", gap: 2, flex: 1 }}>
                    <Box sx={{ borderRadius: "50%", p: 1.5, bgcolor: "rgba(255,255,255,0.15)", display: "flex" }}>
                      <DescriptionIcon sx={{ width: { xs: 35, md: 45 }, height: { xs: 35, md: 45 } }} />
                    </Box>
                    <Box>
                      <Typography variant="h5" fontWeight="bold">
                        Adhoc Reports Generation
                      </Typography>
                      <Typography variant="body2" sx={{ opacity: 0.9, maxWidth: 600, mt: 0.5 }}>
                        View and download your monthly reports. Data is generated freshly upon request when the month-end ETL processing has completed.
                      </Typography>
                    </Box>
                  </Box>

                  {/* Right Side: ETL Date & Status (Moved here per requirement) */}
                  <Box 
                    sx={{ 
                      bgcolor: "rgba(0,0,0,0.2)", 
                      borderRadius: 3, 
                      p: 2, 
                      display: "flex", 
                      flexDirection: "column", 
                      alignItems: { xs: "flex-start", md: "flex-end" }, 
                      gap: 1,
                      minWidth: "fit-content"
                    }}
                  >
                    <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                      <CalendarMonthIcon fontSize="small" sx={{ opacity: 0.8 }} />
                      <Typography variant="caption" fontWeight="bold" sx={{ opacity: 0.9, letterSpacing: 0.5 }}>
                        ACTIVE ETL DATE
                      </Typography>
                    </Box>
                    <Typography variant="h6" fontWeight="bold" sx={{ mt: -0.5 }}>
                      {etlDate}
                    </Typography>
                    <Chip
                      size="small"
                      icon={
                        isAvailableToDownload ? (
                          <CheckCircleIcon style={{ color: "#4caf50" }} />
                        ) : (
                          <SyncIcon
                            style={{ color: "#ff9800" }}
                            sx={{
                              animation: "spin 2s linear infinite",
                              "@keyframes spin": { "0%": { transform: "rotate(0deg)" }, "100%": { transform: "rotate(360deg)" } },
                            }}
                          />
                        )
                      }
                      label={isAvailableToDownload ? "Ready for Download" : "ETL Job Running..."}
                      sx={{ 
                        bgcolor: "white", 
                        color: "text.primary", 
                        fontWeight: "bold", 
                        px: 0.5 
                      }}
                    />
                  </Box>
                </Box>

                {/* Content Area */}
                <Box sx={{ p: { xs: 2, md: 4 }, bgcolor: "#f8f9fa" }}>
                  {!loading && etlDate && !isLastDayOfMonth(etlDate) ? (
                    <Container maxWidth="sm" sx={{ py: 6 }}>
                      <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.5 }}>
                        <Paper
                          elevation={0}
                          sx={{
                            p: 6,
                            borderRadius: 4,
                            textAlign: "center",
                            border: "1px solid",
                            borderColor: "divider",
                            bgcolor: "white",
                            boxShadow: "0 4px 20px rgba(0,0,0,0.03)"
                          }}
                        >
                          <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} transition={{ delay: 0.2, type: "spring", stiffness: 150 }}>
                            <EventBusyIcon sx={{ fontSize: 80, color: "text.secondary", mb: 3, opacity: 0.3 }} />
                          </motion.div>
                          <Typography variant="h5" fontWeight="bold" gutterBottom color="text.primary">
                            Not a Month-End Cycle
                          </Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>
                            Adhoc Reports are strictly generated as part of the month-end activity.
                          </Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>
                            The current ETL Date processed is <strong>{etlDate}</strong>.
                          </Typography>
                          <Typography variant="body1" color="text.secondary">
                            Please check back during the month-end processing cycle.
                          </Typography>
                        </Paper>
                      </motion.div>
                    </Container>
                  ) : (
                    <Box>
                      {/* Grid set to md={4} for strictly 3 items per row */}
                      <Grid container spacing={3}>
                        {reports.map((report, index) => (
                          <Grid item xs={12} sm={6} md={4} key={report.id || index}>
                            <motion.div
                              initial={{ opacity: 0, y: 30 }}
                              animate={{ opacity: 1, y: 0 }}
                              transition={{ duration: 0.4, delay: index * 0.1 }}
                              style={{ height: "100%" }}
                            >
                              <ReportCard
                                report={report}
                                onClick={() => setSelectedReport(report)}
                              />
                            </motion.div>
                          </Grid>
                        ))}

                        {reports.length === 0 && (
                          <Grid item xs={12}>
                            <Typography align="center" color="text.secondary" sx={{ py: 8 }}>
                              No reports configured for this date.
                            </Typography>
                          </Grid>
                        )}
                      </Grid>
                    </Box>
                  )}
                </Box>
              </Card>
            </Stack>
          </Box>
        </Stack>
      </Grow>
    </>
  );
}
