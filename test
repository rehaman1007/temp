                      <Box sx={{ width: 8, height: 8, borderRadius: "50%", background: "#7CBF83" }} />
                    </Box>
                    <TerminalIcon sx={{ fontSize: 16, color: "#C9C3E6", mr: 1 }} />
                    <Typography
                      sx={{
                        color: "#D6D1EB",
                        fontSize: "0.75rem",
                        fontWeight: 700,
                        letterSpacing: "0.5px",
                      }}
                    >
                      OUTPUT RESULT
                    </Typography>
                  </Box>
                  <Tooltip title="Copy result" arrow>
                    <span>
                      <IconButton
                        size="small"
                        disabled={!outputData}
                        onClick={() => handleCopy(outputData, "Result copied to clipboard!")}
                        sx={{
                          color: "#C8C2DF",
                          "&:hover": { color: "#FFFFFF" },
                          "&.Mui-disabled": { color: "#5A566B" },
                        }}
                      >
                        <ContentCopyIcon sx={{ fontSize: 18 }} />
                      </IconButton>
                    </span>
                  </Tooltip>
                </Box>
                
                <Box
                  sx={{
                    flex: 1,
                    overflowY: "auto",
                    overflowX: "auto",
                    p: 2,
                    "&::-webkit-scrollbar": { width: 8, height: 8 },
                    "&::-webkit-scrollbar-track": { background: "rgba(255,255,255,0.03)" },
                    "&::-webkit-scrollbar-thumb": {
                      background: "rgba(196,188,231,0.35)",
                      borderRadius: 10,
                    },
                    "&::-webkit-scrollbar-thumb:hover": { background: "rgba(196,188,231,0.55)" },
                  }}
                >
                  {outputData ? (
                    <pre
                      style={{
                        margin: 0,
                        color: "#BDE5C5",
                        fontFamily: '"Fira Code", "Roboto Mono", monospace',
                        fontSize: "0.85rem",
                        lineHeight: 1.6,
                        whiteSpace: "pre-wrap",
                        wordBreak: "break-all",
                      }}
                    >
                      {outputData}
                    </pre>
                  ) : (
                    <Box
                      sx={{
                        height: "100%",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        flexDirection: "column",
                        gap: 1.5,
                        opacity: 0.6,
                      }}
                    >
                      <TerminalIcon sx={{ fontSize: 40, color: "rgba(205,198,235,0.4)" }} />
                      <Typography sx={{ color: "rgba(215,209,235,0.7)", fontSize: "0.85rem", fontStyle: "italic" }}>
                        Output will appear here
                      </Typography>
                    </Box>
                  )}
                </Box>
              </Box>
            </Box>
          </Paper>
        </Box>

        {/* ====================================================
            FOOTER
        ===================================================== */}
        <Box
          sx={{
            py: 2,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            mt: "auto", // pushes footer to the very bottom
          }}
        >
          <Typography sx={{ color: "rgba(72,68,105,0.65)", fontSize: "0.75rem", fontWeight: 500 }}>
            FinCore Application Utility
          </Typography>
        </Box>
      </Box>

      {/* ========================================================
          SNACKBAR
      ========================================================= */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: "bottom", horizontal: "center" }}
      >
        <Alert
          onClose={handleCloseSnackbar}
          severity={snackbar.severity}
          variant="filled"
          sx={{ width: "100%", borderRadius: 2, boxShadow: "0 8px 25px rgba(40,35,80,0.20)" }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}
