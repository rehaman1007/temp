import {
  Close,
  Email,
  Help,
  Logout,
  Phone,
  Security,
} from "@mui/icons-material";
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  Divider,
  Drawer,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { userAvatarCreator } from "../utils/userUtilities";
import { useContext } from "react";
import { AuthContext } from "../context/AuthContext";

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={() => setProfileDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 380,
          p: 0,
        },
      }}
    >
      <Box sx={{ p: 3, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      <Box sx={{ p: 3 }}>
        <Box sx={{ textAlign: "center", mb: 3 }}>
          <Avatar
            sx={{
              width: 80,
              height: 80,
              mx: "auto",
              mb: 2,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "2rem",
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Typography variant="h6" sx={{ fontWeight: 600, mb: 0.5 }}>
            {user.firstName +
              " " +
              (!user?.middleName ? "" : user.middleName + " ") +
              user.lastName}
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
            User ID: {user.userId}
          </Typography>
          <Chip
            label={user.roleName}
            size="small"
            sx={{
              backgroundColor: "#10B981",
              color: "white",
              fontWeight: 500,
            }}
          />
        </Box>

        <Card sx={{ mb: 3 }}>
          <CardContent>
            <Typography variant="subtitle1" sx={{ fontWeight: 600, mb: 2 }}>
              Contact Information
            </Typography>
            <Stack spacing={2}>
              <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                <Email sx={{ color: "text.secondary" }} />
                <Box>
                  <Typography variant="body2" color="text.secondary">
                    Email
                  </Typography>
                  <Typography variant="body2">{user.email}</Typography>
                </Box>
              </Box>
              <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                <Phone sx={{ color: "text.secondary" }} />
                <Box>
                  <Typography variant="body2" color="text.secondary">
                    Contact No
                  </Typography>
                  <Typography variant="body2">{user.phoneNumber}</Typography>
                </Box>
              </Box>
            </Stack>
          </CardContent>
        </Card>

        <List sx={{ p: 0, bottom: 0 }}>
          <ListItem disablePadding>
            <ListItemButton
              onClick={() => {
                navigate("/help");
              }}
            >
              <ListItemIcon>
                <Help />
              </ListItemIcon>
              <ListItemText primary="Help & Support" />
            </ListItemButton>
          </ListItem>
          <Divider sx={{ my: 1 }} />
          <ListItem disablePadding>
            <ListItemButton
              sx={{ color: "error.main" }}
              onClick={() => {
                logout();
              }}
            >
              <ListItemIcon sx={{ color: "error.main" }}>
                <Logout />
              </ListItemIcon>
              <ListItemText primary="Sign Out" />
            </ListItemButton>
          </ListItem>
        </List>
      </Box>
    </Drawer>
  );
};
export default ProfileDrawer;
