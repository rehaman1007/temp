import { PieChart, Pie, Cell, Legend } from "recharts";
import { Box, Typography, Stack } from "@mui/material";

const COLORS = ["#1976d2", "#9c27b0", "#2e7d32", "#ed6c02", "#d32f2f", "#0288d1"];

export default function MergedDonutChart({ statusData, typeData, total }) {
  // Merge two datasets into one for the donut chart
  const mergedData = [
    ...statusData.map(item => ({ ...item, group: "Status" })),
    ...typeData.map(item => ({ ...item, group: "Type" }))
  ];

  return (
    <Box sx={{ display: "flex", flexDirection: "row", alignItems: "center", justifyContent: "center", width: "100%" }}>
      <PieChart width={280} height={280}>
        <Pie
          data={mergedData}
          dataKey="value"
          nameKey="name"
          innerRadius={80}
          outerRadius={120}
          paddingAngle={2}
          startAngle={90}
          endAngle={-270}
        >
          {mergedData.map((_, index) => (
            <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
          ))}
        </Pie>
      </PieChart>

      {/* Center Text */}
      <Box sx={{ position: "absolute", textAlign: "center" }}>
        <Typography variant="h5" fontWeight="bold">
          {total}
        </Typography>
        <Typography variant="body2" color="textSecondary">
          Requests
        </Typography>
      </Box>

      {/* Legend on the side */}
      <Stack spacing={1} sx={{ ml: 3 }}>
        {mergedData.map((entry, index) => (
          <Box key={index} sx={{ display: "flex", alignItems: "center" }}>
            <Box sx={{ width: 14, height: 14, backgroundColor: COLORS[index % COLORS.length], mr: 1 }} />
            <Typography variant="body2">
              {entry.name}: {entry.value}
            </Typography>
          </Box>
        ))}
      </Stack>
    </Box>
  );
}