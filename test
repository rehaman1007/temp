import React, { useState, useMemo, useEffect, useCallback } from "react";
import {
  StyledContainerBox,
  StyledDataGridContainer,
  StyledDialog,
  StyledDialogTitle,
  StyledDialogContent,
  StyledTextField,
  StyledDialogActions,
  StyledCircularProgressBox,
  StyledCircularProgress,
  StyledButton,
  StyledGridContainer,
  StyledGridItem,
  StyledFormControl,
  StyledInputLabel,
  StyledSelect,
  StyledMenuItem,
  StyledBox,
  StyledDialogTitleBox,
  StyledTable,
  StyledTableContainer,
  StyledTableHead,
  StyledTableRow,
  StyledTableHeaderCell,
  StyledTableBody,
  StyledTableCell,
  StyledTablePagination,
  StyledTypographyBox,
  StyledTypography,
  StyledCloseButton,
  StyledEmptyCell,
} from "./CurrencyRateChangeStyles";
import {
  DataGrid,
  GridActionsCellItem,
  GridToolbarContainer,
} from "@mui/x-data-grid";
import EditIcon from "@mui/icons-material/Edit";
import CloseIcon from "@mui/icons-material/Close";
import HistoryIcon from "@mui/icons-material/History";
import UpdateIcon from "@mui/icons-material/Update";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import {
  Divider,
  Stack,
  IconButton,
  TablePagination,
  Typography,
  styled,
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogContentText,
  DialogActions,
  Button,
} from "@mui/material";
import { currencyFormatterWith6Decimals } from "../../utils/NumberFormat";

const initialFormState = {
  currencyCode: "",
  currencyRate: "",
};

const getFinancialYear = (date) => {
  const year = date.getFullYear();
  const month = date.getMonth();
  return month >= 3 ? `${year}-${year + 1}` : `${year - 1}-${year}`;
};

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => {
  return (
    <OverlayBox>
      <ErrorOutlineIcon fontSize="large" />
      <Typography variant="h5" fontSize="1.2rem">
        Data is not available
      </Typography>
    </OverlayBox>
  );
};

export default function CurrencyRateChangeTab() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  // Single Edit State
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [formData, setFormData] = useState(initialFormState);
  const [editingRow, setEditingRow] = useState(null);
  const [errors, setErrors] = useState({});
  const [PreviousRate, setPreviousRate] = useState(null);

  // Bulk Edit State
  const [isBulkConfirmDialogOpen, setIsBulkConfirmDialogOpen] = useState(false);
  const [isBulkSubmitting, setIsBulkSubmitting] = useState(false);

  // History State
  const [isHistoryDialogOpen, setIsHistoryDialogOpen] = useState(false);
  const [historyData, setHistoryData] = useState([]);
  const [isHistoryLoading, setIsHistoryLoading] = useState(false);
  const [currentCurrency, setCurrentCurrency] = useState(null);
  const [financialYearOptions, setFinancialYearOptions] = useState([]);
  const [selectedYear, setSelectedYear] = useState("");
  const [selectedMonth, setSelectedMonth] = useState("all");
  const [monthOptions, setMonthOptions] = useState([
    { value: "all", label: "All Months" },
  ]);
  const [page, setPage] = useState(0);

  const [etlDate, setEtlDate] = useState("");

  const handleChangePage = (event, newPage) => {
    setPage(newPage);
  };

  const fetchData = useCallback(async () => {
    setIsLoading(true);
    try {
      const response = await callApi(
        "/CM/common-master/currency-master",
        null,
        "GET",
      );

      if (response && response.data && Array.isArray(response.data)) {
        const formattedData = response.data.map((row) => {
          let formattedDate = "N/A";
          if (row.updatedAt) {
            const date = new Date(row.updatedAt);
            if (!isNaN(date.getTime())) {
              const day = String(date.getDate()).padStart(2, "0");
              const month = String(date.getMonth() + 1).padStart(2, "0");
              const year = date.getFullYear();
              formattedDate = `${day}-${month}-${year}`;
            }
          }
          return { ...row, id: row.currencyCode, updatedAt: formattedDate };
        });
        setRows(formattedData);

        // Mocking ETL Date for now, replace with your actual API call if needed
        const etlResponse = await callApi("/PS/file/fincore-date", null, "GET");
        setEtlDate(etlResponse?.data?.etlDate || "2026-07-31");
      } else {
        showSnackBar("Received invalid data format.", "error");
        setRows([]);
      }
    } catch (error) {
      console.error("Error fetching currency master data:", error);
      showSnackBar("Something went wrong while fetching data.", "error");
      setRows([]);
    } finally {
      setIsLoading(false);
    }
  }, [callApi, showSnackBar]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const fetchHistoryData = useCallback(
    async (currencyCode) => {
      setIsHistoryLoading(true);
      try {
        const response = await callApi(
          `/CM/common-master/currency-rate-change`,
          null,
          "GET",
        );

        if (response && response.data && Array.isArray(response.data)) {
          const currencySpecificData = response.data.filter(
            (item) => item.currencyCode === currencyCode,
          );

          if (currencySpecificData.length === 0) {
            setHistoryData([]);
            showSnackBar(
              `No history data found for currency: ${currencyCode}.`,
              "info",
            );
          } else {
            const processedData = currencySpecificData.map((item) => {
              const dateObject = new Date(item.rateChangeDate);
              let formattedDate = "N/A";
              if (!isNaN(dateObject.getTime())) {
                const day = String(dateObject.getDate()).padStart(2, "0");
                const month = String(dateObject.getMonth() + 1).padStart(
                  2,
                  "0",
                );
                const year = dateObject.getFullYear();
                formattedDate = `${day}-${month}-${year}`;
              }
              return {
                ...item,
                rateChangeDate: formattedDate,
                dateObject: dateObject,
              };
            });

            setHistoryData(processedData);

            const years = [
              ...new Set(
                processedData.map((item) => getFinancialYear(item.dateObject)),
              ),
            ];
            years.sort().reverse();
            setFinancialYearOptions(years);
            if (years.length > 0) {
              setSelectedYear(years[0]);
            }
          }
        } else {
          setHistoryData([]);
          showSnackBar(
            "Received invalid history data format from server.",
            "warning",
          );
        }
      } catch (error) {
        console.error("Error fetching currency history:", error);
        showSnackBar("Failed to fetch currency rate history.", "error");
        setHistoryData([]);
      } finally {
        setIsHistoryLoading(false);
      }
    },
    [callApi, showSnackBar],
  );

  useEffect(() => {
    if (!selectedYear || historyData.length === 0) {
      setMonthOptions([{ value: "all", label: "All Months" }]);
      return;
    }
    const availableMonths = new Set();
    historyData.forEach((item) => {
      if (getFinancialYear(item.dateObject) === selectedYear) {
        availableMonths.add(item.dateObject.getMonth());
      }
    });
    const sortedMonths = Array.from(availableMonths).sort((a, b) => a - b);
    const options = [
      { value: "all", label: "All Months" },
      ...sortedMonths.map((monthIndex) => ({
        value: monthIndex,
        label: new Date(0, monthIndex).toLocaleString("default", {
          month: "long",
        }),
      })),
    ];
    setMonthOptions(options);
    setSelectedMonth("all");
  }, [selectedYear, historyData]);

  const filteredHistoryData = useMemo(() => {
    if (!selectedYear) return [];
    return historyData.filter((item) => {
      const itemFinancialYear = getFinancialYear(item.dateObject);
      const yearMatch = itemFinancialYear === selectedYear;
      const monthMatch =
        selectedMonth === "all" || item.dateObject.getMonth() === selectedMonth;
      return yearMatch && monthMatch;
    });
  }, [historyData, selectedYear, selectedMonth]);

  const handleCloseDialog = () => {
    setIsDialogOpen(false);
    setEditingRow(null);
    setFormData(initialFormState);
    setErrors({});
  };

  const handleEditClick = useCallback(
    (id) => () => {
      const rowToEdit = rows.find((row) => row.id === id);
      if (rowToEdit) {
        setEditingRow(rowToEdit);
        setPreviousRate(Number(rowToEdit.currencyRate));
        setFormData({
          currencyCode: rowToEdit.currencyCode,
          currencyRate: rowToEdit.currencyRate,
        });
        setErrors({});
        setIsDialogOpen(true);
      }
    },
    [rows],
  );

  const handleHistoryClick = useCallback(
    (id) => () => {
      setCurrentCurrency(id);
      setIsHistoryDialogOpen(true);
      fetchHistoryData(id);
    },
    [fetchHistoryData],
  );

  const handleCloseHistoryDialog = () => {
    setIsHistoryDialogOpen(false);
    // reset history state...
  };

  const validate = () => {
    let tempErrors = {};
    const rate = formData.currencyRate;
    if (!String(rate).trim())
      tempErrors.currencyRate = "Currency Rate is required.";
    else if (parseFloat(rate) === 0)
      tempErrors.currencyRate = "Currency Rate cannot be taken as zero.";
    setErrors(tempErrors);
    return Object.keys(tempErrors).length === 0;
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    if (name === "currencyRate") {
      if (value !== "" && !/^[0-9.]*$/.test(value)) {
        setErrors((prev) => ({
          ...prev,
          currencyRate: "Special Characters and Alphabeticals are not allowed.",
        }));
        return;
      }
      if (!/^\d{0,6}(\.\d{0,6})?$/.test(value)) return;
      setFormData({ ...formData, [name]: value });
      if (errors[name]) setErrors({ ...errors, [name]: "" });
    }
  };

  // --- SINGLE SUBMIT LOGIC ---
  const handleSubmit = async () => {
    if (!validate()) return;
    const apiPayload = {
      requestType: "CURRENCY_RATE_CHANGE",
      changeType: "UPDATE",
      payload: {
        currencyCode: editingRow.currencyCode,
        currencyRate: parseFloat(formData.currencyRate).toFixed(6) || 0,
        existingCurrencyRate: parseFloat(PreviousRate).toFixed(6) || 0,
      },
    };

    try {
      const data = await callApi("/CR/create-request", apiPayload, "POST");
      if (data) showSnackBar("Request submitted successfully.", "success");
      handleCloseDialog();
      fetchData();
    } catch (err) {
      showSnackBar(err.message, "error");
    }
  };

  // --- BULK SUBMIT LOGIC ---
  const handleBulkSubmit = async () => {
    setIsBulkConfirmDialogOpen(false);
    setIsBulkSubmitting(true);

    // Create a single array payload of all current rates
    const bulkPayload = {
      requestType: "BULK_CURRENCY_RATE_CHANGE",
      changeType: "UPDATE",
      requests: rows.map((row) => ({
        currencyCode: row.currencyCode,
        currencyRate: parseFloat(row.currencyRate).toFixed(6) || 0,
        existingCurrencyRate: parseFloat(row.currencyRate).toFixed(6) || 0,
      })),
    };

    try {
      // Trigger your new bulk API endpoint
      const response = await callApi(
        "/CR/bulk-create-request",
        bulkPayload,
        "POST",
      );
      if (response) {
        showSnackBar(
          "All unchanged currency rates have been submitted for the new month.",
          "success",
        );
        fetchData();
      }
    } catch (err) {
      console.error(err);
      showSnackBar(
        "Failed to process bulk updates. Please try again.",
        "error",
      );
    } finally {
      setIsBulkSubmitting(false);
    }
  };

  const columns = useMemo(() => {
    // ... [Keep your existing column definitions and etlDate logic exactly the same] ...
    return [
      {
        field: "currencyCode",
        headerName: "Currency Code",
        flex: 1,
        minWidth: 150,
      },
      {
        field: "currencyRate",
        headerName: "Currency Rate",
        flex: 1,
        minWidth: 150,
        align: "right",
        renderCell: (params) =>
          currencyFormatterWith6Decimals("INR").format(params.value),
      },
      {
        field: "updatedAt",
        headerName: "Last Updated",
        flex: 1,
        minWidth: 250,
      },
      {
        field: "actions",
        type: "actions",
        headerName: "Actions",
        flex: 0.5,
        minWidth: 150,
        getActions: ({ id }) => [
          <GridActionsCellItem
            icon={<EditIcon />}
            label="Edit Rate"
            onClick={handleEditClick(id)}
            key="edit"
            sx={{ ml: 6 }}
          />,
          <GridActionsCellItem
            icon={<HistoryIcon />}
            label="View History"
            onClick={handleHistoryClick(id)}
            color="inherit"
            key="history"
          />,
        ],
      },
    ];
  }, [handleEditClick, handleHistoryClick, etlDate]);

  const historyColumns = [
    {
      field: "rateChangeDate",
      headerName: "Date of Change",
      flex: 1.5,
    },
    {
      field: "currencyRate",
      headerName: "Changed Rate",
      type: "number",
      flex: 1,
    },
  ];

  // Custom Toolbar containing the bulk update button
  const CustomToolbar = () => (
    <GridToolbarContainer sx={{ p: 2, justifyContent: "flex-end" }}>
      <StyledButton
        variant="contained"
        color="primary"
        startIcon={<UpdateIcon />}
        onClick={() => setIsBulkConfirmDialogOpen(true)}
        disabled={isBulkSubmitting || rows.length === 0}
      >
        Carry Forward Unchanged Rates
      </StyledButton>
    </GridToolbarContainer>
  );

  return (
    <StyledContainerBox>
      <StyledDataGridContainer
        rows={rows}
        columns={columns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10 } },
          sorting: { sortModel: [{ field: "updatedAt", sort: "desc" }] },
        }}
        loading={isLoading || isBulkSubmitting}
        slots={{
          noRowsOverlay: CustomNoRowsOverlay,
          toolbar: CustomToolbar,
        }}
      />

      {/* --- BULK CONFIRMATION DIALOG --- */}
      <Dialog
        open={isBulkConfirmDialogOpen}
        onClose={() => setIsBulkConfirmDialogOpen(false)}
        aria-labelledby="bulk-update-dialog-title"
        aria-describedby="bulk-update-dialog-description"
        disableEscapeKeyDown // Forces explicit interaction
      >
        <DialogTitle
          id="bulk-update-dialog-title"
          sx={{ color: "warning.main", fontWeight: "bold" }}
        >
          Warning: Confirm Bulk Rate Update
        </DialogTitle>
        <DialogContent>
          <DialogContentText id="bulk-update-dialog-description">
            You are about to submit the current rates for{" "}
            <strong>all {rows.length} currencies</strong> to satisfy the monthly
            pipeline requirements.
            <br />
            <br />
            Are you sure you want to continue? This action cannot be undone.
          </DialogContentText>
        </DialogContent>
        <DialogActions sx={{ p: 2, pt: 0 }}>
          <Button
            onClick={() => setIsBulkConfirmDialogOpen(false)}
            color="inherit"
          >
            Cancel
          </Button>
          <Button
            onClick={handleBulkSubmit}
            color="warning"
            variant="contained"
            autoFocus
          >
            Continue
          </Button>
        </DialogActions>
      </Dialog>

      {/* --- SINGLE EDIT DIALOG --- */}
      <StyledDialog open={isDialogOpen} fullWidth maxWidth="sm">
        <StyledDialogTitle>
          <StyledTypography>Edit Currency Rate</StyledTypography>
          <StyledCloseButton onClick={handleCloseDialog}>
            <CloseIcon />
          </StyledCloseButton>
        </StyledDialogTitle>
        <Divider />
        <StyledDialogContent>
          <StyledTextField
            autoFocus
            name="currencyCode"
            label="Currency Code"
            type="text"
            fullWidth
            variant="outlined"
            value={formData.currencyCode}
            disabled
          />

          <StyledTextField
            name="currencyRate"
            label="New Currency Rate"
            type="text"
            fullWidth
            variant="outlined"
            value={formData.currencyRate}
            onChange={handleInputChange}
            error={!!errors.currencyRate}
            helperText={
              errors.currencyRate ||
              "Max 6 digits before decimal, up to 6 after (e.g., 123456.123456)."
            }
          />
        </StyledDialogContent>
        <StyledDialogActions>
          <StyledButton onClick={handleCloseDialog}>Cancel</StyledButton>
          <StyledButton
            onClick={handleSubmit}
            // disabled={isSameRate} // commented for updating same rate for that month
            variant="contained"
          >
            Submit Request
          </StyledButton>
        </StyledDialogActions>
      </StyledDialog>

      {/* --- HISTORY DIALOG --- */}
      <StyledDialog
        open={isHistoryDialogOpen}
        onClose={handleCloseHistoryDialog}
        fullWidth
        maxWidth="md"
      >
        <StyledDialogTitle>
          <StyledTypography>
            Rate Change History for {currentCurrency}
          </StyledTypography>
          <StyledCloseButton onClick={handleCloseHistoryDialog}>
            <CloseIcon />
          </StyledCloseButton>
        </StyledDialogTitle>
        <Divider />

        <StyledBox>
          <StyledDialogTitleBox>
            <StyledDialogContent>
              {isHistoryLoading ? (
                <StyledCircularProgressBox>
                  <StyledCircularProgress />
                </StyledCircularProgressBox>
              ) : financialYearOptions.length ? (
                <>
                  <StyledGridContainer container spacing={2}>
                    {/* Financial Year */}
                    <StyledGridItem item xs={12} sm={6}>
                      <StyledFormControl fullWidth>
                        <StyledInputLabel id="financial-year-select-label">
                          Financial Year
                        </StyledInputLabel>
                        <StyledSelect
                          labelId="financial-year-select-label"
                          value={selectedYear}
                          label="Financial Year"
                          onChange={(e) => setSelectedYear(e.target.value)}
                          disabled={!financialYearOptions.length}
                        >
                          {financialYearOptions.map((year) => (
                            <StyledMenuItem key={year} value={year}>
                              {year}
                            </StyledMenuItem>
                          ))}
                        </StyledSelect>
                      </StyledFormControl>
                    </StyledGridItem>

                    {/* Month */}
                    <StyledGridItem item xs={12} sm={6}>
                      <StyledFormControl fullWidth>
                        <StyledInputLabel id="month-select-label">
                          Month
                        </StyledInputLabel>
                        <StyledSelect
                          labelId="month-select-label"
                          value={selectedMonth}
                          label="Month"
                          onChange={(e) => setSelectedMonth(e.target.value)}
                        >
                          {monthOptions.map((option) => (
                            <StyledMenuItem
                              key={option.value}
                              value={option.value}
                            >
                              {option.label}
                            </StyledMenuItem>
                          ))}
                        </StyledSelect>
                      </StyledFormControl>
                    </StyledGridItem>
                  </StyledGridContainer>

                  {/* TABLE START */}
                  <StyledTableContainer>
                    <StyledTable>
                      <StyledTableHead>
                        <StyledTableRow>
                          {historyColumns.map((col) => (
                            <StyledTableHeaderCell key={col.field}>
                              {col.headerName}
                            </StyledTableHeaderCell>
                          ))}
                        </StyledTableRow>
                      </StyledTableHead>

                      <StyledTableBody>
                        {filteredHistoryData.length === 0 ? (
                          <StyledTableRow>
                            <StyledEmptyCell colSpan={historyColumns.length}>
                              No history found for the selected period
                            </StyledEmptyCell>
                          </StyledTableRow>
                        ) : (
                          filteredHistoryData
                            .slice(page * 5, page * 5 + 5)
                            .map((row) => (
                              <StyledTableRow key={row.id}>
                                {historyColumns.map((col) => (
                                  <StyledTableCell key={col.field}>
                                    {col.field == "currencyRate"
                                      ? currencyFormatterWith6Decimals(
                                          "INR",
                                        ).format(row[col.field])
                                      : row[col.field]}
                                  </StyledTableCell>
                                ))}
                              </StyledTableRow>
                            ))
                        )}
                      </StyledTableBody>
                    </StyledTable>
                  </StyledTableContainer>
                  {/* TABLE END */}
                </>
              ) : (
                <StyledTypographyBox>
                  No data found for this currency
                </StyledTypographyBox>
              )}
              {filteredHistoryData.length > 0 && (
                <StyledTablePagination
                  component="div"
                  count={filteredHistoryData.length}
                  page={page}
                  onPageChange={handleChangePage}
                  rowsPerPage={5}
                  rowsPerPageOptions={[]}
                  labelDisplayedRows={({ page }) => {
                    return `PAGE: ${page + 1}`;
                  }}
                />
              )}
            </StyledDialogContent>
          </StyledDialogTitleBox>
        </StyledBox>
      </StyledDialog>
    </StyledContainerBox>
  );
}
