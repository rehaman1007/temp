import { Stack, Grid, Typography } from "@mui/material";
import { toPascalKebabCase } from "../../../utils/CommonUtilities";

const formatDuration = (start, end) => {
  if (!start || !end) return null;

  const startMs = new Date(start).getTime();
  const endMs = new Date(end).getTime();

  if (isNaN(startMs) || isNaN(endMs) || endMs < startMs) return null;

  const diff = endMs - startMs;
  const s = Math.floor(diff / 1000) % 60;
  const m = Math.floor(diff / (1000 * 60)) % 60;
  const h = Math.floor(diff / (1000 * 60 * 60));

  return [h && `${h} hr`, m && `${m} min`, s && `${s} sec`]
    .filter(Boolean)
    .join(" ");
};

const Detail = ({ title, value }) =>
  value ? (
    <Grid>
      <Typography variant="caption" color="text.secondary">
        {title}
      </Typography>
      <Typography>{value}</Typography>
    </Grid>
  ) : null;

const StageDetails = ({ stages = [], activeStep }) => {
  const stage = stages[activeStep];
  if (!stage) return null;

  return (
    <Stack
      flex={2}
      p={4}
      sx={(theme) => ({
        backgroundImage: `linear-gradient(to left, transparent, ${theme.palette.divider})`,
        backgroundColor: theme.palette.action.hover,
        borderLeft: `1px solid ${theme.palette.divider}`,
      })}
    >
      <Grid container spacing={2}>
        <Detail title="Stage" value={stage.stage?.title} />
        <Detail title="Start Time" value={stage.startTime} />
        <Detail title="End Time" value={stage.endTime} />
        <Detail
          title="Time Taken"
          value={formatDuration(stage._START_TIME_RAW, stage._END_TIME_RAW)}
        />
        <Detail title="Remarks" value={stage.remarks} />
        <Detail
          title="Triggered By"
          value={toPascalKebabCase(stage.triggeredBy) || "N/A"}
        />
      </Grid>
    </Stack>
  );
};

export default StageDetails;
