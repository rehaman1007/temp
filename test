const selectedBranchOptions = useMemo(() => {
  if (
    !filters.branches?.length ||
    filters.branches.includes("ALL")
  ) {
    return [];
  }

  return filters.branches.map((branch) => ({
    value: branch.split("-")[0],
    label: branch,
  }));
}, [filters.branches]);

const selectedCircleOptions = useMemo(() => {
  if (
    !filters.circle ||
    filters.circle === "ALL"
  ) {
    return circles.map((circle) => ({
      value: circle.circleCode,
      label: `${circle.circleCode} - ${circle.circleName}`,
    }));
  }

  const matched = circles.find(
    (circle) =>
      circle.circleCode === filters.circle,
  );

  return matched
    ? [
        {
          value: matched.circleCode,
          label: `${matched.circleCode} - ${matched.circleName}`,
        },
      ]
    : [];
}, [filters.circle, circles]);

const selectedCurrencyOptions = useMemo(() => {
  if (
    !filters.currencies ||
    filters.currencies === "ALL"
  ) {
    return currencies.map((currency) => ({
      value: currency.split(" (")[0],
      label: currency,
    }));
  }

  return [
    {
      value:
        filters.currencies.split(" (")[0],
      label: filters.currencies,
    },
  ];
}, [filters.currencies, currencies]);


