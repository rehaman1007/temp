        executedCount % STATUS_UPDATE_INTERVAL == 0
                || executedCount == totalStatements
)

long elapsedSeconds =
        Duration.between(
                start,
                Instant.now()
        ).toSeconds();

long avgPerStatement =
        executedCount == 0
                ? 0
                : Math.max(1, elapsedSeconds / executedCount);

long remainingStatements =
        totalStatements - executedCount;

long etaSeconds =
        avgPerStatement * remainingStatements;

long executionSpeed =
        elapsedSeconds == 0
                ? executedCount
                : executedCount / elapsedSeconds;

status.put("elapsedSeconds", elapsedSeconds);

status.put("etaSeconds", etaSeconds);

status.put("executionSpeed", executionSpeed);

status.put("progress", progress);

