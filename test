/* -------------------- Widget renderer -------------------- */

function renderWidget(widget) {
  const { type, data } = widget;

  if (type === "stat") {
    return (
      <Stack spacing={1} justifyContent="center" sx={{ height: "100%" }}>
        <Typography variant="h3">{data.value}</Typography>
        {data.secondary && data.secondary.length > 0 && (
          <Box>
            {data.secondary.map((s) => (
              <Typography
                key={s.label}
                variant="caption"
                display="block"
                color="text.secondary"
              >
                {s.label}: <strong>{s.value}</strong>
              </Typography>
            ))}
          </Box>
        )}
      </Stack>
    );
  }

  if (type === "pie") {
    if (!data || data.length === 0) return <EmptyState text="No data" />;

    return (
      <ResponsiveContainer width="100%" height="100%">
        <PieChart>
          <Pie
            data={data}
            dataKey="value"
            nameKey="label"
            outerRadius="80%"
            label
          >
            {data.map((entry, index) => (
              <Cell
                key={`cell-${index}`}
                fill={COLORS[index % COLORS.length]}
              />
            ))}
          </Pie>
          <Tooltip />
        </PieChart>
      </ResponsiveContainer>
    );
  }

  if (type === "bar") {
    if (!data || data.length === 0) return <EmptyState text="No data" />;

    return (
      <ResponsiveContainer width="100%" height="100%">
        <BarChart data={data}>
          <XAxis dataKey="module" />
          <YAxis />
          <Tooltip />
          <Legend />
          <Bar dataKey="pending" name="Pending" />
          <Bar dataKey="approved" name="Approved" />
          <Bar dataKey="rejected" name="Rejected" />
        </BarChart>
      </ResponsiveContainer>
    );
  }

  if (type === "list-announcements") {
    if (!data || data.length === 0)
      return <EmptyState text="No announcements" />;

    return (
      <List dense sx={{ maxHeight: "100%", overflow: "auto" }}>
        {data.map((a, idx) => (
          <React.Fragment key={a.id}>
            {idx > 0 && <Divider component="li" />}
            <ListItem alignItems="flex-start">
              <ListItemText
                primary={
                  <Stack direction="row" spacing={1} alignItems="center">
                    <Typography variant="body2" fontWeight={600}>
                      {a.title}
                    </Typography>
                    <Chip
                      label={a.severity}
                      size="small"
                      color={getSeverityColor(a.severity)}
                      variant="outlined"
                    />
                  </Stack>
                }
                secondary={
                  <>
                    <Typography
                      component="span"
                      variant="caption"
                      color="text.secondary"
                      display="block"
                    >
                      {a.date}
                    </Typography>
                    <Typography variant="body2">{a.message}</Typography>
                  </>
                }
              />
            </ListItem>
          </React.Fragment>
        ))}
      </List>
    );
  }

  if (type === "list-activity") {
    if (!data || data.length === 0)
      return <EmptyState text="No recent activity" />;

    return (
      <List dense sx={{ maxHeight: "100%", overflow: "auto" }}>
        {data.slice(0, 10).map((a, idx) => (
          <React.Fragment key={a.timestamp + idx}>
            {idx > 0 && <Divider component="li" />}
            <ListItem alignItems="flex-start">
              <ListItemText
                primary={
                  <Stack direction="row" spacing={1} alignItems="center">
                    <Typography variant="body2" fontWeight={600}>
                      {a.action}
                    </Typography>
                    <Chip
                      label={a.status}
                      size="small"
                      color={
                        a.status === "PENDING"
                          ? "warning"
                          : a.status === "REJECTED"
                          ? "error"
                          : "success"
                      }
                      variant="outlined"
                    />
                  </Stack>
                }
                secondary={
                  <>
                    <Typography
                      component="span"
                      variant="caption"
                      color="text.secondary"
                      display="block"
                    >
                      {a.displayTime}
                    </Typography>
                    <Typography variant="body2">{a.details}</Typography>
                  </>
                }
              />
            </ListItem>
          </React.Fragment>
        ))}
      </List>
    );
  }

  return <EmptyState text={`Unknown widget type: ${type}`} />;
}

function EmptyState({ text }) {
  return (
    <Stack alignItems="center" justifyContent="center" sx={{ height: "100%" }}>
      <Typography variant="caption" color="text.secondary">
        {text}
      </Typography>
    </Stack>
  );
}

// src/utils/buildDashboardConfig.js

const labelMap = {
  BRANCH: "Branch Management",
  CURRENCY: "Currency Management",
  ROLE_MANAGEMENT: "Role Management",
  SEGMENT: "Segment Management",
  CGL: "CGL Management",
  STATE: "State Management",
  USER_MANAGEMENT: "User Management",
  CALENDER: "Calendar Management",
  CIRCLE: "Circle Management",
};

function mapLabel(key) {
  return labelMap[key] || key;
}

export function buildDashboardConfig(apiData) {
  if (!apiData || !apiData.stats) return { sections: [] };

  const { stats, announcements = [], recentActivity = [] } = apiData;

  // ---------- arrays for charts ----------

  const myPendingDetailsArr = Object.entries(stats.myPendingDetails || {}).map(
    ([k, v]) => ({ label: mapLabel(k), value: v })
  );

  const pendingForMeDetailsArr = Object.entries(
    stats.pendingForMeDetails || {}
  ).map(([k, v]) => ({ label: mapLabel(k), value: v }));

  const allModules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {}),
  ]);

  const statusByModule = Array.from(allModules).map((m) => ({
    module: mapLabel(m),
    pending: (stats.myPendingDetails && stats.myPendingDetails[m]) || 0,
    approved: (stats.myApprovedDetails && stats.myApprovedDetails[m]) || 0,
    rejected: (stats.myRejectedDetails && stats.myRejectedDetails[m]) || 0,
  }));

  const overallStatus = [
    { label: "Pending", value: stats.totalPending || 0 },
    { label: "Approved", value: stats.totalApproved || 0 },
    { label: "Rejected", value: stats.totalRejected || 0 },
  ];

  return {
    sections: [
      {
        id: "overallStatus",
        title: "Overall Requests Status",
        widgets: [
          {
            id: "overallStatusPie",
            title: "Pending vs Approved vs Rejected",
            type: "pie",
            data: overallStatus,
          },
        ],
      },
      {
        id: "overview",
        title: "My Summary",
        widgets: [
          {
            id: "totalPending",
            title: "Total Pending Requests",
            type: "stat",
            data: {
              value: stats.totalPending || 0,
              secondary: [
                { label: "Approved", value: stats.totalApproved || 0 },
                { label: "Rejected", value: stats.totalRejected || 0 },
              ],
            },
          },
          {
            id: "myPending",
            title: "My Pending",
            type: "stat",
            data: {
              value: stats.myPending || 0,
              secondary: myPendingDetailsArr,
            },
          },
          {
            id: "pendingForMe",
            title: "Pending For Me",
            type: "stat",
            data: {
              value: stats.pendingForMe || 0,
              secondary: pendingForMeDetailsArr,
            },
          },
        ],
      },
      {
        id: "myPendingByModule",
        title: "My Requests by Module",
        widgets: [
          {
            id: "myPendingPie",
            title: "My Pending (Module-wise)",
            type: "pie",
            data: myPendingDetailsArr,
          },
          {
            id: "myStatusByModule",
            title: "Pending vs Approved vs Rejected (Module-wise)",
            type: "bar",
            data: statusByModule,
          },
        ],
      },
      {
        id: "announcements",
        title: "Announcements",
        widgets: [
          {
            id: "annList",
            title: "Important Messages",
            type: "list-announcements",
            data: announcements,
          },
        ],
      },
      {
        id: "recentActivity",
        title: "Recent Activity",
        widgets: [
          {
            id: "activityList",
            title: "Latest Requests / Actions",
            type: "list-activity",
            data: recentActivity,
          },
        ],
      },
    ],
  };
}
