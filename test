import React, { useState, useEffect } from "react";
import {
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Button,
  Stack,
  Tooltip,
  IconButton,
  Chip,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";

export default function CommonRequestScreen({
  requestType,
  apiUrl,
  patchUrl,
  columns,
  transformData,
  defaultSort = { field: "reqDate", sort: "desc" },
}) {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [remarks, setRemarks] = useState("");
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  const fetchData = async () => {
    setLoading(true);
    try {
      const response = await callApi(
        apiUrl,
        { requestType: requestType || "CGL_CODE" },
        "POST"
      );
      const result = response?.data || [];

      const data = result.map((row) => {
        const payloadData =
          row.payload && typeof row.payload === "object" ? row.payload : {};
        const flattenedObject = {
          ...row,
          ...payloadData,
        };
        return flattenedObject;
      });
      console.log(data);

      if (transformData) {
        setRows(transformData(data));
      } else {
        setRows(data);
      }

      if (!data.length) {
        showSnackBar("No pending requests found", "warning");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error fetching data", "error");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleConfirm = async () => {
    if (confirmDialog.type === "reject" && !remarks.trim()) {
      showSnackBar("Please provide remarks before rejecting", "warning");
      return;
    }

    try {
      const payload = {
        requestId: confirmDialog.rowId,
        status: confirmDialog.type === "reject" ? "REJECTED" : "ACCEPTED",
        remarks:
          confirmDialog.type === "reject" ? remarks.trim() : "No Remarks",
      };
      const res = await callApi(patchUrl, payload, "PATCH");

      if (res?.success || res) {
        showSnackBar(
          confirmDialog.type === "accept"
            ? "Request Approved"
            : "Request Rejected",
          "success"
        );
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error while processing request", "error");
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  // Add actions column dynamically
  const allColumns = [
    ...columns,
    {
      field: "changeType",
      headerName: "Request Type",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
      justifyContent: "center",
      renderCell: (params) => {
        const val = params.value;
        return (
          <Box>
            {val === "A" ? (
              <Chip icon={<AddBoxIcon />} label="Added" size="small" />
            ) : val === "D" ? (
              <Chip icon={<AutoDeleteIcon />} label="Deleted" size="small" />
            ) : (
              <Chip icon={<EditDocumentIcon />} label="Modified" size="small" />
            )}
          </Box>
        );
      },
    },
    {
      field: "creatorId",
      headerName: "Creator ID",
      flex: 0.8,
      sortable: true,
      align: "center",
      headerAlign: "center",
      justifyContent: "center",
      renderCell: (params) => {
        const value = params.value;
        return (
          <Box>
            <Chip icon={<AccountCircleIcon />} label={value} size="small" />
          </Box>
        );
      },
    },
    {
      field: "reqDate",
      headerName: "Requested Date",
      flex: 1,
      sortable: true,
      align: "center",
      headerAlign: "center",
      justifyContent: "center",
      renderCell: (params) => {
        const isoString = params.value;

        if (!isoString) {
          return null; // Handle cases where the date is not available
        }

        try {
          const date = new Date(isoString);
          const options = {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true, // Use 12-hour format with AM/PM
            timeZone: "Asia/Calcutta",
          };

          const formattedDateTime = date.toLocaleString("en-US", options);
          return <Box>{formattedDateTime}</Box>;
        } catch (error) {
          console.error("Invalid date format:", error);
          return <Box>{isoString}</Box>;
        }
      },
    },
    {
      field: "actions",
      headerName: "Actions",
      sortable: false,
      flex: 0.6,
      align: "center",
      headerAlign: "center",
      justifyContent: "center",
      renderCell: (params) => (
        <Stack
          direction="row"
          spacing={1}
          alignItems="center"
          justifyContent="center"
        >
          <Tooltip title="Approve">
            <IconButton
              size="medium"
              onClick={() => openConfirmDialog("accept", params.row.id)}
              color="success"
            >
              <CheckIcon fontSize="inherit" />
            </IconButton>
          </Tooltip>
          <Tooltip title="Reject">
            <IconButton
              size="medium"
              onClick={() => openConfirmDialog("reject", params.row.id)}
              color="error"
            >
              <ClearIcon fontSize="inherit" />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={allColumns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [defaultSort] },
        }}
        getRowId={(row) => row.id}
        loading={loading}
        sx={{
          height: 600,
          width: "100%",
          "& .MuiDataGrid-cell:focus": { outline: "none" },
        }}
      />

      <Dialog
        open={confirmDialog.open}
        onClose={closeConfirmDialog}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>
          {confirmDialog.type === "accept"
            ? "Confirm Approval"
            : "Confirm Rejection"}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 2 }}>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Please enter remarks."}
          </Typography>
          {confirmDialog.type === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button
            onClick={closeConfirmDialog}
            color="inherit"
            variant="contained"
          >
            Cancel
          </Button>
          <Button
            onClick={handleConfirm}
            color={confirmDialog.type === "accept" ? "success" : "error"}
            variant="contained"
          >
            {confirmDialog.type === "accept" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
