import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  Checkbox,
  Chip,
  Autocomplete,
} from "@mui/material";
import { useState } from "react";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import { FixedSizeList } from "react-window";
import { validations } from "../../../utils/Validations";

const LISTBOX_PADDING = 8; // px

function renderRow(props) {
  const { data, index, style } = props;
  const option = data[index];
  return (
    <li {...option[0]} style={{ ...style, top: style.top + LISTBOX_PADDING }} key={option[1].id}>
      {option[1].title}
    </li>
  );
}

// Custom Listbox for virtualization
const ListboxComponent = (props) => {
  const { children, ...other } = props;
  const itemData = children.map((child, index) => [child.props, child.key]);
  const itemCount = itemData.length;
  const itemSize = 36;

  return (
    <div {...other}>
      <FixedSizeList
        height={Math.min(8, itemCount) * itemSize + 2 * LISTBOX_PADDING}
        itemCount={itemCount}
        itemSize={itemSize}
        width="100%"
        itemData={itemData}
        overscanCount={5}
      >
        {renderRow}
      </FixedSizeList>
    </div>
  );
};

export default function RolesDialog({ open, onClose, form, setForm, canSave, fetchRoles }) {
  const [selectedPermissions, setSelectedPermissions] = useState([]);

  // Dummy data: 200 permissions
  const allPermissions = Array.from({ length: 200 }).map((_, i) => ({
    id: i + 1,
    title: `Permission ${i + 1}`,
  }));

  const handleChange = (data, key, e, type) => {
    const result = validations(type, e.target.value);
    if (result === "") setForm({ ...data, [key]: e.target.value });
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>{form.roleId ? "Edit Role" : "Add New Role"}</DialogTitle>

      {form.roleId && (
        <IconButton
          aria-label="role status"
          sx={(theme) => ({
            position: "absolute",
            right: 10,
            top: 8,
            color: theme.palette.grey[500],
          })}
          onClick={() => {}}
        >
          {form.status === "ACTIVE" ? <LockOutlineIcon color="error" /> : <LockOpenIcon color="success" />}
          <Typography variant="caption">{form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK"}</Typography>
        </IconButton>
      )}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          <Grid container spacing={2}>
            <Grid item xs={12} md={4}>
              <TextField
                key="roleName"
                label="Role Name *"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.roleName || ""}
                onChange={(e) => handleChange(form, "roleName", e, "inputValue")}
                fullWidth
                size="medium"
              />
            </Grid>
            <Grid item xs={12} md={8}>
              <TextField
                key="description"
                label="Description *"
                slotProps={{ htmlInput: { maxLength: 100 } }}
                value={form.description || ""}
                onChange={(e) => handleChange(form, "description", e, "certainSpecialChars")}
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12}>
              <Autocomplete
                multiple
                key="permissions"
                options={allPermissions}
                disableCloseOnSelect
                getOptionLabel={(option) => option.title}
                value={selectedPermissions}
                onChange={(e, newValue) => setSelectedPermissions(newValue)}
                isOptionEqualToValue={(option, value) => option.id === value.id}
                renderOption={(props, option, { selected }) => (
                  <li {...props} key={option.id}>
                    <Checkbox checked={selected} sx={{ mr: 1 }} />
                    {option.title}
                  </li>
                )}
                renderInput={(params) => <TextField {...params} label="Permissions" fullWidth />}
                renderTags={() => null} // Don't show inside input
                ListboxComponent={ListboxComponent} // Virtualized list
                fullWidth
              />

              <Stack direction="row" spacing={1} sx={{ mt: 1, flexWrap: "wrap" }}>
                {selectedPermissions.map((p) => (
                  <Chip
                    key={p.id}
                    label={p.title}
                    size="small"
                    onDelete={() =>
                      setSelectedPermissions(selectedPermissions.filter((perm) => perm.id !== p.id))
                    }
                  />
                ))}
              </Stack>
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" disabled={!canSave} onClick={() => {}}>
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}