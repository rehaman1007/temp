const { mutate: exportData, isPending: exportLoading } = useMutation({
    mutationFn: async ({ sql, exportType, tableName }) => {
      const payload = {
        sql,
        exportType: exportType === "CLIPBOARD" ? "INSERT" : exportType,
        tableName,
      };

      console.log("Export Payload", payload);

      return await callApi(
        "/TS/admin-support/export-data",
        payload,
        "POST",
        "blob",
        "application/json",
        {},
        false,
      );
    },

    onSuccess: async (response, variables) => {
      console.log("Blob Response", response);
      console.log("Variables", variables);

      const exportType = variables.exportType?.toUpperCase();

      /**
       * CLIPBOARD EXPORT
       */
      if (exportType === "CLIPBOARD") {
        try {
          const text = await response.text();

          if (!text?.trim()) {
            showSnackbar("No data available to copy", "warning");
            return;
          }

          // Optional safety limit (10 MB)
          if (text.length > 100_000_000) {
            showSnackbar(
              "Clipboard content is too large. Use INSERT export instead.",
              "warning",
            );
            return;
          }

          await navigator.clipboard.writeText(text);

          showSnackbar("INSERT statements copied to clipboard", "success");

          return;
        } catch (err) {
          console.error(err);

          showSnackbar("Failed to copy to clipboard", "error");

          return;
        }
      }

      /**
       * FILE EXPORT
       */
      let format = "csv";

      switch (exportType) {
        case "EXCEL":
          format = "xlsx";
          break;

        case "JSON":
          format = "json";
          break;

        case "INSERT":
          format = "sql";
          break;

        case "CSV":
        default:
          format = "csv";
          break;
      }

      console.log(response);
      console.log(response.headers);

      const contentDisposition =
        response.headers["content-disposition"] ||
        response.headers["Content-Disposition"];

      console.log("contentDisposition >", contentDisposition);
      let filename = `export_${Date.now()}`;

      const filenameMatch = contentDisposition.match(
        /filename\*=UTF-8''([^;]+)|filename="?([^";\n]+)"?/i,
      );
      console.log("filenameMatch >>", filenameMatch);
      if (filenameMatch) {
        // Group 1 is for filename*, Group 2 is for standard filename
        const rawName = filenameMatch[1] || filenameMatch[2];
        if (rawName) {
          // Decode if it was URL encoded (common with filename*)
          try {
            filename = decodeURIComponent(rawName.trim());
          } catch (e) {
            filename = rawName.trim();
          }
        }
      }

      console.log("filename >>", filename);

      downloadFile(response?.data, format, filename);

      showSnackbar("Export completed successfully", "success");
    },

    onError: (e) => {
      showSnackbar(e?.message || "Export failed", "error");
    },
  });
