import React, { lazy, Suspense } from "react";
import { Routes, Route, Navigate } from "react-router-dom";
import { CircularProgress } from "@mui/material";

const AppRouter = ({ userData }) => {
  const { user, menu, extraRoutes, defaultPage } = userData;

  // Unified route loader function
  const loadRoute = (path, component) => {
    const Component = lazy(() => import(`./pages/${component}`));
    return (
      <Route
        key={path}
        path={`/${user.role}/${path}`}
        element={<Component />}
      />
    );
  };

  return (
    <Suspense fallback={<CircularProgress />}>
      <Routes>
        {/* Side menu routes */}
        {menu.map((r) => loadRoute(r.path, r.component))}

        {/* Extra routes (not in menu) */}
        {extraRoutes.map((r) => loadRoute(r.path, r.component))}

        {/* Default page */}
        <Route
          path={`/${user.role}/${defaultPage}`}
          element={lazy(() => import(`./pages/HomePage`))()}
        />

        {/* Fallback → first menu or default page */}
        <Route
          path="*"
          element={
            <Navigate
              to={
                menu.length > 0
                  ? `/${user.role}/${menu[0].path}`
                  : `/${user.role}/${defaultPage}`
              }
            />
          }
        />
      </Routes>
    </Suspense>
  );
};

export default AppRouter;
