/**
 * Optimised Parameter Formatter
 * Memoized via usage inside memo components to prevent unnecessary re-parsing.
 */
const formatParams = (params) => {
  if (!params)
    return <Typography variant="caption">No filters applied</Typography>;

  try {
    let data;
    if (typeof params === "string") {
      // 1. Wrap keys in quotes: branch: -> "branch":
      let fixedString = params.replace(
        /([{,])\s*([^,{}:"\s]+)\s*:/g,
        '$1"$2":',
      );

      // 2. Wrap unquoted values (like 00001) in quotes to keep leading zeros
      // This looks for values that aren't already quoted and aren't objects/arrays
      fixedString = fixedString.replace(/:\s*([^,"{}[\]\s][^,}]*)/g, ': "$1"');

      // 3. Clean up any double-quoting that might have happened to already-quoted dates
      fixedString = fixedString.replace(/"\s*"/g, '"');

      data = JSON.parse(fixedString);
    } else {
      data = params;
    }

    const entries = Object.entries(data);
    return entries.map(([key, value], index) => (
      <React.Fragment key={key}>
        <Box component="span" sx={{ fontWeight: 700, color: "text.primary" }}>
          {toPascalKebabCase(key)}:
        </Box>
        <Box
          component="span"
          sx={{ fontWeight: 400, color: "text.secondary", ml: 0.5 }}
        >
          {String(value).trim()}{" "}
        </Box>
        {index < entries.length - 1 && (
          <Box component="span" sx={{ color: "divider", fontWeight: 900 }}>
            {" | "}
          </Box>
        )}
      </React.Fragment>
    ));
  } catch (e) {
    console.error("Format Error:", e);
    return (
      <Typography variant="caption">
        {String(params).replace(/[{}]/g, "")}
      </Typography>
    );
  }
};

const getMenuNames = (menuId, menuList) => {
  // 1. Safety check for the list
  if (!Array.isArray(menuList) || menuList.length === 0) {
    return { primary: "System Report", secondary: null };
  }

  const targetId = Number(menuId);

  // 2. Iterate to find Submenu FIRST (to handle duplicate IDs correctly)
  for (const menu of menuList) {
    if (menu.children && Array.isArray(menu.children)) {
      const child = menu.children.find((c) => Number(c.id) === targetId);
      if (child) {
        return {
          primary: child.title, // Submenu Name (e.g., Template Requests)
          secondary: menu.title, // Parent Name (e.g., Template Management)
        };
      }
    }
  }

  // 3. If not found in children, check Top-Level Menus
  for (const menu of menuList) {
    if (Number(menu.id) === targetId) {
      return {
        primary: menu.title, // Parent Name (e.g., View Template Reports)
        secondary: null,
      };
    }
  }

  // 4. Final fallback
  return { primary: "Report Builder", secondary: "System" };
};

const MyDownloadsDrawer = ({ open, onClose }) => {
  const FETCH_URL = "/ES/my-downloads/get-downloads";
  const DOWNLOAD_URL = "/ES/my-downloads/download";
  const [downloads, setDownloads] = useState([]);
  const [loading, setLoading] = useState(false);
  const menuItems = useSelector((state) => state.menus.menus || []);
  const { callApi } = useApi();
  const showSnackbar = useCustomSnackbar();
  const [activeDownloadId, setActiveDownloadId] = useState(null);

  // Stable fetch function prevents unnecessary effect triggers
  const fetchDownloads = useCallback(async () => {
    setLoading(true);
    try {
      const response = await callApi(FETCH_URL, null, "GET");
      setDownloads(response?.data || []);
    } catch (error) {
      console.error("Fetch Error:", error);
      showSnackbar(
        error.message || "Something went wrong, kindly try again.",
        "error",
      );
      setDownloads([]);
    } finally {
      setLoading(false);
    }
  }, [callApi, showSnackbar]);

  useEffect(() => {
    if (open) fetchDownloads();
  }, [open, fetchDownloads]);

  const handleDownload = async (file) => {
    setActiveDownloadId(file.id);
    try {
      const response = await callApi(DOWNLOAD_URL, { id: file.id }, "POST");

      if (response?.success && response?.data) {
        const fullFileName = file.fileName || "report.xlsx";

        const extension = fullFileName.includes(".")
          ? fullFileName.split(".").pop().toLowerCase()
          : "xlsx";

        const baseName =
          fullFileName.substring(0, fullFileName.lastIndexOf(".")) || "report";

        downloadFile(response.data, extension, baseName, true);
      }
    } catch (e) {
      console.error("Download Error:", e);
      showSnackbar(
        e.message ||
          "Something went wrong while downloading file, Kindly try again",
        "error",
      );
    } finally {
      setActiveDownloadId(null);
    }
  };

  return (
    <Drawer
      anchor="right"
      open={open}
      onClose={onClose}
      sx={{ "& .MuiDrawer-paper": { width: 400, border: "none" } }}
    >
      <Box sx={{ height: "100%", display: "flex", flexDirection: "column" }}>
        {/* HEADER */}
        <Box
          sx={{
            m: 0,
            pr: 2,
            pl: 2,
            pt: 3,
            pb: 1.5,
            borderBottom: "1px solid",
            borderColor: "divider",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <Box>
            <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1.2 }}>
              My Downloads
            </Typography>
            <Typography variant="caption" color="text.secondary">
              Files are available for 24 hours after generation
            </Typography>
          </Box>
          <IconButton size="small" onClick={onClose}>
            <CloseIcon fontSize="small" />
          </IconButton>
        </Box>

        <Divider />

        {/* CONTENT */}
        <Box sx={{ flexGrow: 1, overflowY: "auto", p: 2 }}>
          {loading ? (
            <Box
              sx={{
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                mt: 5,
                gap: 2,
              }}
            >
              {[1, 2, 3].map((i) => (
                <DownloadSkeleton key={i} />
              ))}
            </Box>
          ) : downloads.length > 0 ? (
            <List sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
              {downloads.map((file) => (
                <DownloadItem
                  key={file.id}
                  file={file}
                  isDownloading={activeDownloadId === file.id}
                  onDownload={handleDownload}
                  menuInfo={getMenuNames(file.menuId, menuItems)} // Pass search results as props
                  formattedParams={formatParams(file.searchCriteria)}
                />
              ))}
            </List>
          ) : (
            <EmptyStateView />
          )}
        </Box>
      </Box>
    </Drawer>
  );
};

export default MyDownloadsDrawer;
