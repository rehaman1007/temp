      columns={columns}
      disableRowSelectionOnClick
      onRowSelectionModelChange={onSelectionChange}
      pageSizeOptions={[5, 10, 25, 50]}
      loading={loading}
      localeText={{
        noRowsLabel: errorText,
      }}
      autoHeight
      initialState={{
        pagination: { paginationModel: { pageSize: 10, page: 0 } },
        sorting: { sortModel: [{ field: "__name", sort: "asc" }] },
      }}
      slots={{
        noRowsOverlay: CustomNoRowsOverlay,
      }}
    />
  );
}

import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControl,
  InputLabel,
  MenuItem,
  Select,
  Stack,
  TextField,
  Grid,
  Divider,
  IconButton,
  Typography,
} from "@mui/material";
import useApi from "../../../hooks/useApi";

import { useCallback, useRef, useState } from "react";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import VerifiedUserIcon from "@mui/icons-material/VerifiedUser";
import GppBadIcon from "@mui/icons-material/GppBad";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import _ from "lodash";

const STATUS_MAP = {
  ACTIVE: <VerifiedUserIcon color="success" />,
  INACTIVE: <GppBadIcon color="error" />,
  LOCKED: <LockOutlineIcon color="error" />,
  UNLOCKED: <LockOpenIcon color="success" />,
};

export default function UserDialog({
  open,
  onClose,
  roles,
  form,
  setForm,
  initialState,
}) {
  const user = JSON.parse(sessionStorage.getItem("user"));
  const API_URL = "/UM/user/create-request";

  const { callApi } = useApi();

  const snackbar = useCustomSnackbar();
  const [errors, setErrors] = useState({});
  console.log(form);

  const makePayload = useCallback(() => {
    const requestPayload = JSON.stringify({
      userId: form.USERID,
      firstName: form.FIRST_NAME,
      middleName: form.MIDDLE_NAME,
      lastName: form.LAST_NAME,
      email: form.EMAIL,
      phoneNumber: form.PHONE_NUMBER,
      roleName: form.ROLE_NAME,
      roleId: form.ROLE_ID,
      // branch: form.BRANCH,
    });
    return {
      targetUserId: form?.USERID || undefined,
      requestorUserId: user?.userId || undefined,
      requestType: form.id
        ? "MODIFY"
        : form.ACCOUNT_STATUS === "LOCKED"
        ? "UNLOCK"
        : form.ACCOUNT_STATUS === "ACTIVE"
        ? "LOCK"
        : form.ACCOUNT_STATUS === "INACTIVE"
        ? "ACTIVE"
        : "CREATE",
      requestPayload,
    };
  }, [form, user]);

  const onSave = async () => {
    if (!isFormValid()) {
      snackbar("Please fix validation errors", "error");
      return;
    }
    const isSame = _.isEqual(initialState, form);
    if (isSame) {
      snackbar("No Changes detected, Kindly modify before saving", "error");
      return;
    }
    try {
      const payload = makePayload();
      const res = await callApi(API_URL, payload, "POST");
      if (res) {
        snackbar(
          form.id
            ? "User update request submitted successfully"
            : "User creation request submitted successfully",
          "success"
        );
        onClose();
      }
    } catch (error) {
      console.error(error);
      snackbar(
        error?.response?.data?.message ||
          "Something went wrong, Kindly try again",
        "error"
      );
    }
  };

  const reDigits = /^[0-9]*$/;
  const reDesc = /^[a-zA-Z\s]*$/;
  const fname = /^[a-zA-Z\s.]*$/;
  const emailRegex = /^[a-zA-Z0-9._]*$/;

  const validateField = useCallback((name, value) => {
    switch (name) {
      case "USERID":
        if (!value) return "User ID is required";
        if (!reDigits.test(value)) return "Only digits allowed";
        if (value.length !== 7) return "Must be 7 digits";
        break;

      case "FIRST_NAME":
        if (!value.trim()) return "First Name is required";
        if (!fname.test(value)) return "Only letters, spaces";
        break;

      case "MIDDLE_NAME":
        if (!value.trim()) return "Middle Name is required";
        if (!reDesc.test(value)) return "Only letters, spaces";
        break;

      case "LAST_NAME":
        if (!value.trim()) return "Last Name is required";
        if (!reDesc.test(value)) return "Only letters, spaces";
        break;

      case "PHONE_NUMBER":
        if (!value) return "Phone Number is required";
        if (!reDigits.test(value)) return "Only digits allowed";
        if (value.length !== 10) return "Must be 10 digits";
        break;

      case "EMAIL": {
        if (!value | (value === emailDomain)) return "Email ID is required";
        const prefix = value.replace(emailDomain, "");
        if (prefix.length === 0) return "Email ID is required";
        if (prefix.length > emailPrefix)
          return "Maximum 50 characters allowed before @";
        if (!emailRegex.test(prefix))
          return "Only letters, digits,.,_,- allowed";
        break;
      }

      case "ROLE_ID": {
        if (!value) return "Role is required";
        break;
      }

      default:
        return "";
    }
  });

  const isFormValid = useCallback(() => {
    const fields = ["USERID", "FIRST_NAME", "PHONE_NUMBER", "EMAIL", "ROLE_ID"];
    return fields.every((f) => !validateField(f, form[f] || ""));
  });
  const snackGateRef = useRef(true);
  const notifyOnce = useCallback(
    (msg, variant = "warning") => {
      if (!snackGateRef.current) return;
      snackGateRef.current = false;
      snackbar(msg, variant);
      setTimeout(() => (snackGateRef.current = true), 800);
    },
    [snackbar]
  );
  const isAllZeros = (str) => {
    return /^0+$/.test(str);
  };
  const emailDomain = "@sbi.co.in";
  const emailPrefix = 50;

  // --- live validation on change + snackbars for bad keystrokes ---
  const handleChange = (e) => {
    const { name, value } = e.target;
    console.log(e.target.name, e.target.value);

    if (name === "USERID") {
      if (!reDigits.test(value)) {
        notifyOnce("User ID accepts digits only");
        return;
      }
      if (value.length > 7) {
        notifyOnce("User ID must be 7 digits");
        return;
      }
      if (value.length === 7 && isAllZeros(value)) {
        notifyOnce("All zeros are not Allowed");
        return;
      }
    }
    if (name === "FIRST_NAME") {
      if (!fname.test(value)) {
        notifyOnce("First Name accepts letters and spaces only");
        return;
      }
    }
    if (name === "MIDDLE_NAME") {
      if (!reDesc.test(value)) {
        notifyOnce("Middle Name accepts letters and spaces only");
        return;
      }
    }
    if (name === "LAST_NAME") {
      if (!reDesc.test(value)) {
        notifyOnce("Last Name accepts letters and spaces only");
        return;
      }
    }
    if (name === "PHONE_NUMBER") {
      if (!reDigits.test(value)) {
        notifyOnce("Phone Number accepts digits only");
        return;
      }
      if (value.length > 10) {
        notifyOnce("Phone Number must be 10 digits");
        return;
      }
      if (value.length === 10 && isAllZeros(value)) {
        notifyOnce("All zeros are not Allowed");
        return;
      }
    }
    if (name === "EMAIL") {
      const prefix = value.replace(emailDomain, "");
      if (prefix.includes("@")) return;
      if (prefix.length > emailPrefix) return;
      if (!emailRegex.test(prefix) && prefix.length > 0) return;
      if (prefix.length === emailPrefix && isAllZeros(prefix)) {
        notifyOnce("All zeros are not Allowed");
        return;
      }
      setForm((prev) => ({ ...prev, EMAIL: prefix + emailDomain }));
      return;
    }

    setForm((prev) => ({ ...prev, [name]: value }));

    // update error for just this field
    setErrors((prev) => ({
      ...prev,
      [name]: validateField(name, value),
    }));
  };

  return (
    <Dialog
      open={open}
      onClose={onClose}
      fullWidth
      maxWidth="md"
      PaperProps={{
        sx: {
          minWidth: 800,
          maxWidth: "45vw",
        },
      }}
    >
      <DialogTitle>{form.id ? "Edit User" : "Add New User"}</DialogTitle>
      {/* {form?.id && (
        <IconButton
          aria-label="account status"
          sx={(theme) => ({
            position: "absolute",
            right: 10,
            top: 8,
            color: theme.palette.grey[500],
          })}
          onClick={() => onSave()}
        >
          {STATUS_MAP[form.ACCOUNT_STATUS]}
          <Typography variant="caption">{form.ACCOUNT_STATUS}</Typography>
        </IconButton>
      )} */}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {/* Identity Section */}
          <Grid container spacing={2} alignItems="flex-start">
            <Grid item xs={12} md={8}>
              <TextField
                name="USERID"
                label="User ID *"
                value={form.USERID || ""}
                onChange={handleChange}
                fullWidth
                size="medium"
                disabled={form?.id}
                error={!!errors.USERID}
                helperText={errors.USERID}
              />
            </Grid>
            {/* spacer to keep nice balance on first row */}
            <Grid item xs={12} md={4} />
          </Grid>
          <Divider />
          <Grid container spacing={2} alignItems="flex-start">
            <Grid item xs={12} md={4}>
              <TextField
                name="FIRST_NAME"
                label="First Name *"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.FIRST_NAME || ""}
                onChange={handleChange}
                fullWidth
                size="medium"
                error={!!errors.FIRST_NAME}
                helperText={errors.FIRST_NAME}
              />
            </Grid>

            <Grid item xs={12} md={4}>
              <TextField
                name="MIDDLE_NAME"
                label="Middle Name"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.MIDDLE_NAME || ""}
                onChange={handleChange}
                fullWidth
                size="medium"
                error={!!errors.MIDDLE_NAME}
                helperText={errors.MIDDLE_NAME}
              />
            </Grid>

            <Grid item xs={12} md={4}>
              <TextField
                name="LAST_NAME"
                label="Last Name"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.LAST_NAME || ""}
                onChange={handleChange}
                fullWidth
                size="medium"
                error={!!errors.LAST_NAME}
                helperText={errors.LAST_NAME}
              />
            </Grid>
          </Grid>

          {/* Contact Section */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={8}>
              <TextField
                name="EMAIL"
                sx={{ width: 465, borderRadius: 0.7 }}
                label="Email *"
                slotProps={{ htmlInput: { maxLength: 100 } }}
                type="email"
                value={form.EMAIL || emailDomain}
                onChange={handleChange}
                onClick={(e) => {
                  const i = e.target;
                  const p = form.EMAIL.indexOf("@");
                  i.setSelectionRange(p, p);
                }}
                onKeyDown={(e) => {
                  const p = e.target.selectionStart;
                  const a = form.EMAIL.indexOf("@");
                  if (e.key === "Delete" && p >= a) {
                    e.preventDefault();
                    return;
                  }
                  if (p > a) {
                    e.preventDefault();
                    e.target.setSelectionRange(a, a);
                  }
                }}
                onBlur={(e) => {
                  const { name, value } = e.target;
                  setErrors((prev) => ({
                    ...prev,
                    [name]: validateField(name, value),
                  }));
                }}
                fullWidth
                size="medium"
                error={!!errors.EMAIL}
                helperText={errors.EMAIL}
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <TextField
                name="PHONE_NUMBER"
                label="Mobile Number *"
                value={form.PHONE_NUMBER}
                onChange={handleChange}
                slotProps={{
                  htmlInput: {
                    maxLength: 10, // Limits the input to 10 characters
                  },
                }}
                fullWidth
                size="medium"
                error={!!errors.PHONE_NUMBER}
                helperText={errors.PHONE_NUMBER}
              />
            </Grid>
          </Grid>

          {/* Org Section */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth size="medium">
                <InputLabel required>Role</InputLabel>
                <Select
                  label="Role"
                  name="ROLE"
                  value={form.ROLE_ID || ""}
                  sx={{ width: 220, borderRadius: 0.7 }}
                  onChange={(e) => {
                    const roleId = e.target.value;
                    const r = roles.find(
                      (rr) => String(rr.id) === String(roleId)
                    ) || { id: roleId, name: String(roleId) };
                    setForm({ ...form, ROLE_ID: r.id, ROLE_NAME: r.name });
                  }}
                  MenuProps={{ PaperProps: { style: { maxHeight: 320 } } }}
                >
                  {roles.map((r) => (
                    <MenuItem key={r.id} value={r.id}>
                      {r.name}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={onSave} disabled={!isFormValid()}>
          {form.id ? "Update User" : "Add User"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}

