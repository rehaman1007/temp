import axios from "axios";

class ReportDownloadService {
  constructor() {
    this.activeDownload = null;
    this.listeners = new Set();
    this.state = {
      isDownloading: false,
      downloadedBytes: 0,
      meta: null,
    };
  }

  subscribe(listener) {
    this.listeners.add(listener);
    listener(this.state); // send current state immediately
    return () => this.listeners.delete(listener);
  }

  notify() {
    this.listeners.forEach((l) => l(this.state));
  }

  startDownload({ payload, onComplete, onError }) {
    if (this.activeDownload) return; // already running

    const controller = new AbortController();

    this.activeDownload = controller;
    this.state = {
      isDownloading: true,
      downloadedBytes: 0,
      meta: payload,
    };
    this.notify();

    axios.post("/RS/reports/download", payload, {
      responseType: "blob",
      signal: controller.signal,
      onDownloadProgress: (e) => {
        if (e?.loaded) {
          this.state.downloadedBytes = e.loaded;
          this.notify();
        }
      },
    })
      .then((response) => {
        this.reset();
        onComplete(response);
      })
      .catch((err) => {
        this.reset();
        if (!axios.isCancel(err)) onError(err);
      });
  }

  reset() {
    this.activeDownload = null;
    this.state = {
      isDownloading: false,
      downloadedBytes: 0,
      meta: null,
    };
    this.notify();
  }

  getState() {
    return this.state;
  }
}

export default new ReportDownloadService();

import { useEffect, useState } from "react";
import {
  Box,
  Button,
  Fade,
  LinearProgress,
  Typography,
} from "@mui/material";
import { CloudDownloadTwoTone } from "@mui/icons-material";
import dayjs from "dayjs";

import reportDownloadService from "../../services/reportDownloadService";
import { saveBlob } from "../../utils/downloadHelpers";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

export default function GlifReports() {
  const showSnackBar = useCustomSnackbar();

  const [downloadState, setDownloadState] = useState(
    reportDownloadService.getState()
  );

  // 🔗 Attach listener when screen opens
  useEffect(() => {
    const unsubscribe = reportDownloadService.subscribe(setDownloadState);
    return unsubscribe; // detach when leaving screen
  }, []);

  const handleFetchReportData = () => {
    reportDownloadService.startDownload({
      payload: {
        fileName: selectedReport.fileName,
        date: selectedDate.format("YYYY-MM-DD"),
        roleId: user.role,
      },
      onComplete: (response) => {
        saveBlob(response.data);
      },
      onError: () => {
        showSnackBar("Download failed", "error");
      },
    });
  };

  const downloadedMB =
    downloadState.downloadedBytes > 0
      ? (downloadState.downloadedBytes / (1024 * 1024)).toFixed(2)
      : null;

  return (
    <>
      <Button
        variant="contained"
        onClick={handleFetchReportData}
