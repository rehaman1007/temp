import React, { useState, useEffect, useRef } from "react";
import {
  Typography,
  Button,
  Box,
  InputBase,
  Stack,
  CircularProgress,
} from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import TimerOffIcon from "@mui/icons-material/TimerOff";
import BlockIcon from "@mui/icons-material/Block";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  userId,
  otpData,
  openLoginErrorDialog,
  onBackToHome,
  onSessionEstablished,
}) => {
  const showSnackbar = useCustomSnackbar();

  const [otpValues, setOtpValues] = useState(["", "", "", "", "", ""]);
  const [isLoading, setIsLoading] = useState(false);
  const [wrongAttempts, setWrongAttempts] = useState(0);

  // --- API Driven Timers & Limits ---
  const [currentTxnId, setCurrentTxnId] = useState(
    otpData?.transactionId || ""
  );
  const [expiresIn, setExpiresIn] = useState(otpData?.expiresInSeconds || 300);
  const [cooldown, setCooldown] = useState(
    otpData?.resendCooldownSeconds || 30
  );
  const [resendsLeft, setResendsLeft] = useState(
    otpData?.resendsRemaining ?? 5
  );

  const inputRefs = useRef([]);

  const isExpired = expiresIn <= 0;
  const isExhausted = resendsLeft <= 0;
  const otpString = otpValues.join("");

  // Focus management
  useEffect(() => {
    if (!isExpired && inputRefs.current[0]) {
      inputRefs.current[0].focus();
    }
  }, [isExpired]);

  // Global Tick Timer
  useEffect(() => {
    const timer = setInterval(() => {
      setExpiresIn((prev) => (prev > 0 ? prev - 1 : 0));
      setCooldown((prev) => (prev > 0 ? prev - 1 : 0));
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const formatTime = (seconds) => {
    const m = Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0");
    const s = (seconds % 60).toString().padStart(2, "0");
    return `${m}:${s}`;
  };

  const updateTimersFromResponse = (data) => {
    if (data?.transactionId) setCurrentTxnId(data.transactionId);
    if (data?.expiresInSeconds) setExpiresIn(data.expiresInSeconds);
    if (data?.resendCooldownSeconds) setCooldown(data.resendCooldownSeconds);
    if (data?.resendsRemaining !== undefined)
      setResendsLeft(data.resendsRemaining);
  };

  const forceResendOTP = async () => {
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        }
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(["", "", "", "", "", ""]);
      showSnackbar(
        "3 invalid attempts. A fresh verification code was sent.",
        "warning"
      );
      inputRefs.current[0]?.focus();
    } catch (err) {
      console.error("Forced OTP Generation Error:", err);
      openLoginErrorDialog(
        "Session Terminated",
        "Could not generate a new code. Please restart login."
      );
    }
  };

  const handleResendClick = async () => {
    if (isExhausted || cooldown > 0 || isExpired) return;

    setIsLoading(true);
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        }
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(["", "", "", "", "", ""]);
      showSnackbar(
        res?.data?.message || "A new code has been sent successfully.",
        "success"
      );
      inputRefs.current[0]?.focus();
    } catch (err) {
      const msg =
        err.response?.data?.message || "Failed to resend verification code.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  const handleVerifyOTP = async () => {
    if (otpString.length !== 6 || isExpired) return;

    setIsLoading(true);

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          userId,
          transactionId: currentTxnId,
          otp: otpString,
        }
      );

      const isSuccess = response?.data?.success === true;
      const result = response?.data?.data || {};

      if (isSuccess) {
        if (onSessionEstablished) {
          onSessionEstablished(result);
        }
      } else {
        const targetFailures = wrongAttempts + 1;
        setWrongAttempts(targetFailures);

        if (targetFailures >= 3) {
          await forceResendOTP();
        } else {
          showSnackbar(
            response?.data?.message ||
              `Invalid code. Attempt ${targetFailures} of 3.`,
            "error"
          );
        }
      }
    } catch (e) {
      console.error("OTP Verification Exception:", e);
      const msg =
        e.response?.data?.message || "Verification request failed. Try again.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  // Robust Native Key & Focus Management
  const handleKeyDown = (index, e) => {
    if (e.key === "Backspace") {
      e.preventDefault();
      const updated = [...otpValues];
      if (updated[index]) {
        updated[index] = "";
        setOtpValues(updated);
      } else if (index > 0) {
        updated[index - 1] = "";
        setOtpValues(updated);
        inputRefs.current[index - 1]?.focus();
      }
    } else if (e.key === "ArrowLeft" && index > 0) {
      e.preventDefault();
      inputRefs.current[index - 1]?.focus();
    } else if (e.key === "ArrowRight" && index < 5) {
      e.preventDefault();
      inputRefs.current[index + 1]?.focus();
    } else if (e.key === "Enter" && otpString.length === 6 && !isLoading) {
      e.preventDefault();
      handleVerifyOTP();
    }
  };

  const handleChange = (index, e) => {
    const rawVal = e.target.value;
    const digitsOnly = rawVal.replace(/\D/g, "");

    if (!digitsOnly) {
      const updated = [...otpValues];
      updated[index] = "";
      setOtpValues(updated);
      return;
    }

    const updated = [...otpValues];

    // Single digit entry
    if (digitsOnly.length === 1) {
      updated[index] = digitsOnly;
      setOtpValues(updated);
      if (index < 5) {
        inputRefs.current[index + 1]?.focus();
      }
    } 
    // Paste or multiple fast inputs fallback
    else {
      const chars = digitsOnly.split("").slice(0, 6);
      chars.forEach((char, idx) => {
        if (index + idx < 6) {
          updated[index + idx] = char;
        }
      });
      setOtpValues(updated);
      const nextTarget = Math.min(index + chars.length, 5);
      inputRefs.current[nextTarget]?.focus();
    }
  };

  const handlePaste = (e) => {
    e.preventDefault();
    const pasted = e.clipboardData
      .getData("text/plain")
      .replace(/\D/g, "")
      .slice(0, 6);
    if (!pasted) return;

    const updated = [...otpValues];
    for (let i = 0; i < pasted.length; i++) {
      updated[i] = pasted[i];
    }
    setOtpValues(updated);

    const targetIdx = pasted.length < 6 ? pasted.length : 5;
    inputRefs.current[targetIdx]?.focus();
  };

  return (
    <Box sx={{ width: "100%", maxWidth: "420px", mx: "auto" }}>
      {/* Dynamic Header Info Card */}
      {!isExpired && (
        <Box
          sx={{
            mb: 3,
            p: 2,
            borderRadius: 2.5,
            bgcolor: "rgba(240, 244, 248, 0.6)",
            border: "1px solid rgba(226, 232, 240, 0.8)",
            boxShadow: "0 2px 4px rgba(0,0,0,0.02)",
          }}
        >
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              mb: 1.5,
            }}
          >
            <Typography
              variant="caption"
              sx={{
                fontWeight: 600,
                textTransform: "uppercase",
                letterSpacing: 0.6,
                color: "text.secondary",
              }}
            >
              Verification Channel
            </Typography>

            {/* Stable Monospace Countdown Pill */}
            <Box
              sx={{
                display: "inline-flex",
                alignItems: "center",
                gap: 0.5,
                px: 1,
                py: 0.25,
                borderRadius: 1.5,
                bgcolor: expiresIn > 60 ? "primary.50" : "error.50",
                color: expiresIn > 60 ? "primary.main" : "error.main",
                border: "1px solid",
                borderColor: expiresIn > 60 ? "primary.100" : "error.100",
              }}
            >
              <AccessTimeIcon sx={{ fontSize: 14 }} />
              <Typography
                component="span"
                sx={{
                  fontFamily: "monospace",
                  fontWeight: 700,
                  fontSize: "0.775rem",
                  width: "36px",
                  textAlign: "center",
                }}
              >
                {formatTime(expiresIn)}
              </Typography>
            </Box>
          </Box>

          <Stack spacing={0.75}>
            {otpData?.maskedMobile && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                <PhoneAndroidIcon sx={{ fontSize: 16, color: "text.secondary" }} />
                <Typography
                  variant="body2"
                  fontWeight={500}
                  color="text.primary"
                  sx={{ fontSize: "0.85rem" }}
                >
                  {otpData.maskedMobile}
                </Typography>
              </Box>
            )}

            {otpData?.maskedEmail && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                <EmailIcon sx={{ fontSize: 16, color: "text.secondary" }} />
                <Typography
                  variant="body2"
                  fontWeight={500}
                  color="text.primary"
                  sx={{ fontSize: "0.85rem", wordBreak: "break-all" }}
                >
                  {otpData.maskedEmail}
                </Typography>
              </Box>
            )}
          </Stack>
        </Box>
      )}

      {/* STATE 1: Active OTP Entry Flow */}
      {!isExpired && (
        <>
          {/* Native High-Performance 6-Cell Grid */}
          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: "repeat(6, 1fr)",
              gap: { xs: 0.75, sm: 1.25 },
              mb: 3,
            }}
          >
            {otpValues.map((val, idx) => (
              <Box
                key={idx}
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  borderRadius: 2,
                  bgcolor: "background.paper",
                  border: "1.5px solid",
                  borderColor: val ? "primary.main" : "rgba(0, 0, 0, 0.15)",
                  boxShadow: val ? "0 0 0 3px rgba(25, 118, 210, 0.12)" : "none",
                  transition: "all 0.15s ease-in-out",
                  height: { xs: 48, sm: 56 },
                  "&:focus-within": {
                    borderColor: "primary.main",
                    boxShadow: "0 0 0 3px rgba(25, 118, 210, 0.2)",
                  },
                }}
              >
                <InputBase
                  inputRef={(el) => (inputRefs.current[idx] = el)}
                  value={val}
                  onChange={(e) => handleChange(idx, e)}
                  onKeyDown={(e) => handleKeyDown(idx, e)}
                  onPaste={handlePaste}
                  disabled={isLoading}
                  inputProps={{
                    maxLength: 1,
                    inputMode: "numeric",
                    pattern: "[0-9]*",
                    style: {
                      textAlign: "center",
                      fontSize: "1.25rem",
                      fontWeight: 700,
                      padding: 0,
                      width: "100%",
                      height: "100%",
                    },
                  }}
                />
              </Box>
            ))}
          </Box>

          <PrimaryButton
            fullWidth
            variant="contained"
            onClick={handleVerifyOTP}
            disabled={isLoading || otpString.length !== 6}
            sx={{ py: 1.25, fontSize: "0.95rem" }}
          >
            {isLoading ? (
              <CircularProgress size={22} color="inherit" />
            ) : (
              "Verify & Sign In"
            )}
          </PrimaryButton>

          {/* Navigation and Resend Row */}
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              mt: 2.5,
            }}
          >
            <Button
              startIcon={<ArrowBackIcon />}
              onClick={onBackToHome}
              sx={{
                textTransform: "none",
                color: "text.secondary",
                fontSize: "0.825rem",
                p: 0.5,
              }}
            >
              Back to User ID
            </Button>

            {/* Hidden if resend limit exhausted */}
            {!isExhausted && (
              <Button
                startIcon={<RefreshIcon />}
                onClick={handleResendClick}
                disabled={cooldown > 0 || isLoading}
                sx={{
                  textTransform: "none",
                  fontSize: "0.825rem",
                  fontWeight: 600,
                  p: 0.5,
                }}
              >
                {cooldown > 0 ? (
                  <Box component="span" sx={{ display: "inline-flex", gap: 0.5 }}>
                    Resend in
                    <Typography
                      component="span"
                      sx={{
                        fontFamily: "monospace",
                        fontWeight: 700,
                        fontSize: "0.825rem",
                      }}
                    >
                      {cooldown}s
                    </Typography>
                  </Box>
                ) : (
                  "Resend Code"
                )}
              </Button>
            )}
          </Box>
        </>
      )}

      {/* STATE 2: Session Expired View */}
      {isExpired && (
        <Box
          sx={{
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            textAlign: "center",
            py: 2.5,
            px: 1,
          }}
        >
          <Box
            sx={{
              width: 52,
              height: 52,
              borderRadius: "50%",
              bgcolor: isExhausted ? "grey.100" : "error.50",
              color: isExhausted ? "text.secondary" : "error.main",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              mb: 2,
            }}
          >
            {isExhausted ? (
              <BlockIcon sx={{ fontSize: 28 }} />
            ) : (
              <TimerOffIcon sx={{ fontSize: 28 }} />
            )}
          </Box>

          <Typography variant="h6" fontWeight={700} gutterBottom>
            {isExhausted ? "Attempts Limit Exceeded" : "OTP Token Expired"}
          </Typography>

          <Typography
            variant="body2"
            color="text.secondary"
            sx={{ mb: 3, maxWidth: "300px", lineHeight: 1.5 }}
          >
            {isExhausted
              ? "You have used all available verification attempts. Please log in again to start a new session."
              : "Your 6-digit verification code has expired for security reasons. Please return to the login screen."}
          </Typography>

          <PrimaryButton
            fullWidth
            variant="contained"
            startIcon={<ArrowBackIcon />}
            onClick={onBackToHome}
            sx={{ py: 1.25 }}
          >
            Back to User ID
          </PrimaryButton>
        </Box>
      )}
    </Box>
  );
};

export default LoginWithOTP;
