  DROP OBJECTS
==========================================================*/
BEGIN EXECUTE IMMEDIATE 'DROP TABLE FINCORE.PROCESS_RUN_STAGE CASCADE CONSTRAINTS'; EXCEPTION WHEN OTHERS THEN NULL; END;
/
BEGIN EXECUTE IMMEDIATE 'DROP TABLE FINCORE.PROCESS_RUN CASCADE CONSTRAINTS'; EXCEPTION WHEN OTHERS THEN NULL; END;
/
BEGIN EXECUTE IMMEDIATE 'DROP SEQUENCE FINCORE.SEQ_PROCESS_RUN'; EXCEPTION WHEN OTHERS THEN NULL; END;
/
BEGIN EXECUTE IMMEDIATE 'DROP SEQUENCE FINCORE.SEQ_PROCESS_RUN_STAGE'; EXCEPTION WHEN OTHERS THEN NULL; END;
/

/*==========================================================
  CREATE SEQUENCES
==========================================================*/
CREATE SEQUENCE FINCORE.SEQ_PROCESS_RUN
START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;

CREATE SEQUENCE FINCORE.SEQ_PROCESS_RUN_STAGE
START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;

/*==========================================================
  CREATE TABLE : PROCESS_RUN
==========================================================*/
CREATE TABLE FINCORE.PROCESS_RUN
(
  PROCESS_RUN_ID NUMBER
    DEFAULT FINCORE.SEQ_PROCESS_RUN.NEXTVAL PRIMARY KEY,

  PROCESS_ID NUMBER NOT NULL,
  ETL_DATE DATE NOT NULL,
  RUN_ID NUMBER NOT NULL,
  STATUS NUMBER NOT NULL,
  START_TIME TIMESTAMP(6),
  END_TIME TIMESTAMP(6),
  TRIGGERED_BY VARCHAR2(100),
  AIRFLOW_RUN_ID VARCHAR2(100),

  CONSTRAINT UQ_PROCESS_RUN
    UNIQUE (PROCESS_ID, ETL_DATE, RUN_ID),

  CONSTRAINT FK_PR_PROCESS
    FOREIGN KEY (PROCESS_ID)
    REFERENCES FINCORE.PROCESS_MASTER(PROCESS_ID)
);

/*==========================================================
  CREATE TABLE : PROCESS_RUN_STAGE
==========================================================*/
CREATE TABLE FINCORE.PROCESS_RUN_STAGE
(
  PROCESS_RUN_STAGE_ID NUMBER
    DEFAULT FINCORE.SEQ_PROCESS_RUN_STAGE.NEXTVAL PRIMARY KEY,

  PROCESS_RUN_ID NUMBER NOT NULL,
  STAGE_ID VARCHAR2(50) NOT NULL,
  PARENT_STAGE_ID VARCHAR2(50),
  STATUS NUMBER NOT NULL,
  EVENT_TIME TIMESTAMP(6),
  SOURCE VARCHAR2(20) NOT NULL,
  REMARKS VARCHAR2(500),
  SUMMARY CLOB,

  CONSTRAINT FK_PRS_RUN
    FOREIGN KEY (PROCESS_RUN_ID)
    REFERENCES FINCORE.PROCESS_RUN(PROCESS_RUN_ID)
);

/*==========================================================
  INDEXES
==========================================================*/
CREATE INDEX FINCORE.IDX_PR_PROCESS
ON FINCORE.PROCESS_RUN(PROCESS_ID);

CREATE INDEX FINCORE.IDX_PR_STATUS
ON FINCORE.PROCESS_RUN(STATUS);

CREATE INDEX FINCORE.IDX_PRS_RUN
ON FINCORE.PROCESS_RUN_STAGE(PROCESS_RUN_ID);

CREATE INDEX FINCORE.IDX_PRS_STATUS
ON FINCORE.PROCESS_RUN_STAGE(STATUS);

