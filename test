const { mutate: exportData, isPending: exportLoading } = useMutation({
    mutationFn: async ({ sql, exportType, tableName }) => {
      const response = await callApi(
        "/TS/admin-support/export-data",
        {
          sql,
          exportType,
          tableName,
        },
        "POST",
        "blob",
      );

      if (!response.ok) {
        showSnackbar("Export failed", "error");
      }

      console.log(response);
      console.log(typeof response);

      // const blob = await response.blob();
      const blob = await response;

      const disposition = response.headers.get("Content-Disposition");

      let fileName = "export";

      if (disposition) {
        const match = disposition.match(/filename="?([^"]+)"?/);

        if (match?.[1]) {
          fileName = match[1];
        }
      }

      return {
        blob,
        fileName,
      };
    },

    onSuccess: ({ blob, fileName }) => {
      const url = window.URL.createObjectURL(blob);

      const link = document.createElement("a");

      link.href = url;
      link.download = fileName;

      document.body.appendChild(link);

      link.click();

      link.remove();

      URL.revokeObjectURL(url);

      showSnackbar("Export completed successfully", "success");
    },

    onError: (e) => {
      showSnackbar(e?.message || "Export failed", "error");
    },
  });

  const handleExport = () => {
    if (!lastExecutedQuery) {
      showSnackbar("Execute a SELECT query first", "warning");
      return;
    }

    if (exportType === "INSERT" && !tableName.trim()) {
      showSnackbar("Table name required for INSERT export", "warning");
      return;
    }

    exportData({
      sql: lastExecutedQuery,
      exportType,
      tableName,
    });
  };
