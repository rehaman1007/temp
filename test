const [exportType, setExportType] = useState("CSV");
const [tableName, setTableName] = useState("");

const { mutate: exportData, isPending: exportLoading } = useMutation({
  mutationFn: async ({ sql, exportType, tableName }) => {
    const token = localStorage.getItem("token");

    const response = await fetch(
      `${process.env.REACT_APP_API_URL}/TS/admin-support/export`,
      {
        method: "POST",
        headers: {
          Authorization: token,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          sql,
          exportType,
          tableName,
        }),
      },
    );

    if (!response.ok) {
      throw new Error("Export failed");
    }

    const blob = await response.blob();

    const disposition = response.headers.get(
      "Content-Disposition",
    );

    let fileName = "export";

    if (disposition) {
      const match =
        disposition.match(/filename="?([^"]+)"?/);

      if (match?.[1]) {
        fileName = match[1];
      }
    }

    return {
      blob,
      fileName,
    };
  },

  onSuccess: ({ blob, fileName }) => {
    const url = window.URL.createObjectURL(blob);

    const link = document.createElement("a");

    link.href = url;
    link.download = fileName;

    document.body.appendChild(link);

    link.click();

    link.remove();

    URL.revokeObjectURL(url);

    showSnackbar(
      "Export completed successfully",
      "success",
    );
  },

  onError: (e) => {
    showSnackbar(
      e?.message || "Export failed",
      "error",
    );
  },
});


const handleExport = () => {
  if (!lastExecutedQuery) {
    showSnackbar(
      "Execute a SELECT query first",
      "warning",
    );
    return;
  }

  if (
    exportType === "INSERT" &&
    !tableName.trim()
  ) {
    showSnackbar(
      "Table name required for INSERT export",
      "warning",
    );
    return;
  }

  exportData({
    sql: lastExecutedQuery,
    exportType,
    tableName,
  });
};





<ResultGrid
  results={results}
  loading={isPending}
  paginationModel={paginationModel}
  setPaginationModel={handlePaginationChange}
  exportType={exportType}
  setExportType={setExportType}
  tableName={tableName}
  setTableName={setTableName}
  onExport={handleExport}
  exportLoading={exportLoading}
/>


