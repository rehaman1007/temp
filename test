@Override
public Page<LedgerEnquiryResponse> search(
        LedgerEnquiryRequest dto,
        Pageable pageable
) {

    Sort.Direction direction =
            "asc".equalsIgnoreCase(
                    dto.getSortOrder()
            )
                    ? Sort.Direction.ASC
                    : Sort.Direction.DESC;

    Pageable dynamicPageable =
            PageRequest.of(
                    dto.getPage(),
                    dto.getSize(),
                    Sort.by(
                            direction,
                            dto.getSortField()
                    )
            );

    Specification<GlTransactions>
            specification =
            LedgerEnquirySpecification
                    .filter(dto);

    Page<GlTransactions> page =
            glTransactionsRepository.findAll(
                    specification,
                    dynamicPageable
            );

    return page.map(
            this::mapEntityToDto
    );
}

