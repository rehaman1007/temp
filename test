import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  Grid,
  TextField,
  Typography,
} from "@mui/material";
import useApi from "../../hooks/useApi";

export default function CglView() {
  const { callApi } = useApi();

  const [cglCode, setCglCode] = useState("");
  const [cglDesc, setCglDesc] = useState("");

  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Call API when either field has >= 3 characters ----
  useEffect(() => {
    const code = cglCode.trim();
    const desc = cglDesc.trim();

    if (code.length < 3 && desc.length < 3) {
      setOptions([]);
      setSelected(null);
      return;
    }

    let cancelled = false;

    const fetchData = async () => {
      try {
        setLoading(true);

        const res = await callApi(
          "/CM/cglWithSegment",
          { cglNumb: code, cglDesc: desc },
          "GET"
        );

        const list = res?.data?.data || [];

        if (!cancelled) setOptions(list);
      } catch (err) {
        console.log("ERROR >", err);
        if (!cancelled) {
          setOptions([]);
          setSelected(null);
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    fetchData();

    return () => (cancelled = true);
  }, [cglCode, cglDesc, callApi]);

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* Search Area */}
      <Grid container spacing={2} sx={{ mb: 3 }}>
        <Grid item xs={12} sm={6}>
          <TextField
            label="CGL Number"
            fullWidth
            value={cglCode}
            onChange={(e) => setCglCode(e.target.value)}
            placeholder="Type at least 3 digits"
          />
        </Grid>

        <Grid item xs={12} sm={6}>
          <Autocomplete
            fullWidth
            loading={loading}
            options={options}
            value={selected}
            onChange={(_, value) => setSelected(value)}
            getOptionLabel={(opt) =>
              opt ? `${opt.cglNumber} - ${opt.description}` : ""
            }
            noOptionsText={
              cglDesc.trim().length < 3
                ? "Type at least 3 characters..."
                : "No matching results"
            }
            renderInput={(params) => (
              <TextField
                {...params}
                label="CGL Description Search"
                value={cglDesc}
                onChange={(e) => setCglDesc(e.target.value)}
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
                    <>
                      {loading && <CircularProgress size={18} />}
                      {params.InputProps.endAdornment}
                    </>
                  ),
                }}
              />
            )}
          />
        </Grid>
      </Grid>

      {/* Details Section */}
      <Card sx={{ p: 3 }}>
        {!selected ? (
          <Typography sx={{ color: "gray" }}>No CGL Selected</Typography>
        ) : (
          <Grid container spacing={2}>
            <Grid item xs={6}>
              <Typography fontWeight={600}>CGL Number</Typography>
              <Typography>{selected.cglNumber}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Description</Typography>
              <Typography>{selected.description}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Comp1</Typography>
              <Typography>{selected.comp1}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Comp2</Typography>
              <Typography>{selected.comp2}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Segment Code</Typography>
              <Typography>{selected.segmentCode}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Segment Description</Typography>
              <Typography>{selected.segmentDescription || "-"}</Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Balance Compare</Typography>
              <Typography>
                {selected.balcompare === 1 ? "Include" : "Exclude"}
              </Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Manual Posting</Typography>
              <Typography>
                {selected.manualPosting === 1 ? "Allowed" : "Not Allowed"}
              </Typography>
            </Grid>

            <Grid item xs={4}>
              <Typography fontWeight={600}>Balance Forward</Typography>
              <Typography>
                {selected.balFwd === 1 ? "Yes" : "No"}
              </Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Open Date</Typography>
              <Typography>{selected.openDate || "-"}</Typography>
            </Grid>

            <Grid item xs={6}>
              <Typography fontWeight={600}>Close Date</Typography>
              <Typography>{selected.closeDate || "-"}</Typography>
            </Grid>
          </Grid>
        )}
      </Card>
    </Box>
  );
}