import React, { useState, useEffect, useMemo, useRef } from "react";
import {
  Box,
  Paper,
  Typography,
  Grid,
  Card,
  CardContent,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Chip,
  Stack,
  Avatar,
  LinearProgress,
  Fade,
  Tooltip,
  IconButton,
  Skeleton,
} from "@mui/material";

import { PieChart } from "@mui/x-charts/PieChart";

// icons
import AssessmentIcon from "@mui/icons-material/Assessment";
import LockIcon from "@mui/icons-material/Lock";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import DownloadIcon from "@mui/icons-material/Download";
import PictureAsPdfIcon from "@mui/icons-material/PictureAsPdf";
import RefreshIcon from "@mui/icons-material/Refresh";
import InboxIcon from "@mui/icons-material/Inbox";

// utils
import html2canvas from "html2canvas";
import jsPDF from "jspdf";

import useApi from "../../../../common/hooks/useApi";
import LoadingOverlay from "../../../../common/components/ui/loadingOverlay";


// ---------- Status Config ----------
const STATUS_CONFIG = {
  null: {
    label: "Not Initiated",
    color: "#9e9e9e",
    muiColor: "default",
  },
  11: {
    label: "In Progress",
    color: "#1976d2",
    muiColor: "primary",
  },
  20: {
    label: "Pending Approval",
    color: "#ed6c02",
    muiColor: "warning",
  },
  53: {
    label: "Freezed",
    color: "#2e7d32",
    muiColor: "success",
  },
  12: {
    label: "Rejected",
    color: "#d32f2f",
    muiColor: "error",
  },
};

const getStatusConfig = (status) =>
  STATUS_CONFIG[String(status)] || STATUS_CONFIG.null;


// ---------- Component ----------
const DICGCDashboard = () => {

  const { callApi } = useApi();

  const dashboardRef = useRef();

  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  const [filter, setFilter] = useState("ALL");

  const user = JSON.parse(localStorage.getItem("user"));
  const qed = user?.quarterEndDate;


  // ---------- API CALL ----------
  const fetchData = async () => {

    try {

      setLoading(true);

      const response =
        await callApi("/bidData/get-dicgc-dashboard", {
          qed,
        });

      setData(response || []);

    } catch (e) {

      console.error(e);

    } finally {

      setLoading(false);

    }

  };


  useEffect(() => {

    fetchData();

  }, []);


  // ---------- LIVE REFRESH ----------
  useEffect(() => {

    const interval =
      setInterval(fetchData, 60000);

    return () => clearInterval(interval);

  }, []);



  // ---------- KPI CALC ----------
  const stats = useMemo(() => {

    const total = data.length;

    const freezed =
      data.filter(d => d.MISC_STATUS === "53").length;

    const pending =
      data.filter(d =>
        d.MISC_STATUS !== "53"
      ).length;

    const notInitiated =
      data.filter(d =>
        !d.MISC_STATUS
      ).length;

    return {

      total,
      freezed,
      pending,
      notInitiated,

      freezedPct:
        total ?
        Math.round((freezed / total) * 100)
        : 0,

      pendingPct:
        total ?
        Math.round((pending / total) * 100)
        : 0,

      notInitiatedPct:
        total ?
        Math.round((notInitiated / total) * 100)
        : 0,

    };

  }, [data]);



  // ---------- FILTER ----------
  const filteredData =
    useMemo(() => {

      if (filter === "ALL")
        return data;

      if (filter === "FREEZED")
        return data.filter(
          d => d.MISC_STATUS === "53"
        );

      if (filter === "PENDING")
        return data.filter(
          d => d.MISC_STATUS !== "53"
        );

      if (filter === "NOT_INITIATED")
        return data.filter(
          d => !d.MISC_STATUS
        );

      return data;

    }, [data, filter]);



  // ---------- CHART ----------
  const chartData =
    useMemo(() => [

      {
        value: stats.freezed,
        label: "Freezed",
        color: "#2e7d32",
      },

      {
        value: stats.pending,
        label: "Pending",
        color: "#ed6c02",
      },

      {
        value: stats.notInitiated,
        label: "Not Initiated",
        color: "#9e9e9e",
      },

    ], [stats]);



  // ---------- EXPORT PNG ----------
  const exportPNG =
    async () => {

      const canvas =
        await html2canvas(
          dashboardRef.current
        );

      const link =
        document.createElement("a");

      link.download =
        "dicgc-dashboard.png";

      link.href =
        canvas.toDataURL();

      link.click();

    };



  // ---------- EXPORT PDF ----------
  const exportPDF =
    async () => {

      const canvas =
        await html2canvas(
          dashboardRef.current
        );

      const img =
        canvas.toDataURL("image/png");

      const pdf =
        new jsPDF("landscape");

      pdf.addImage(
        img,
        "PNG",
        10,
        10,
        280,
        150
      );

      pdf.save(
        "dicgc-dashboard.pdf"
      );

    };



  // ---------- KPI ----------
  const KPI = [

    {
      key: "ALL",
      label: "Total",
      value: stats.total,
      pct: 100,
      icon: <AssessmentIcon />,
      color: "#1565c0",
    },

    {
      key: "FREEZED",
      label: "Freezed",
      value: stats.freezed,
      pct: stats.freezedPct,
      icon: <LockIcon />,
      color: "#2e7d32",
    },

    {
      key: "PENDING",
      label: "Pending",
      value: stats.pending,
      pct: stats.pendingPct,
      icon: <PendingActionsIcon />,
      color: "#ed6c02",
    },

    {
      key: "NOT_INITIATED",
      label: "Not Initiated",
      value: stats.notInitiated,
      pct: stats.notInitiatedPct,
      icon: <ErrorOutlineIcon />,
      color: "#9e9e9e",
    },

  ];



  return (

    <Box
      ref={dashboardRef}
      sx={{ p: 3 }}
    >

      {/* HEADER */}
      <Stack
        direction="row"
        justifyContent="space-between"
        mb={3}
      >

        <Typography variant="h4">

          DICGC Dashboard

        </Typography>

        <Stack direction="row">

          <Tooltip title="Refresh">

            <IconButton onClick={fetchData}>

              <RefreshIcon />

            </IconButton>

          </Tooltip>

          <Tooltip title="Export PNG">

            <IconButton onClick={exportPNG}>

              <DownloadIcon />

            </IconButton>

          </Tooltip>

          <Tooltip title="Export PDF">

            <IconButton onClick={exportPDF}>

              <PictureAsPdfIcon />

            </IconButton>

          </Tooltip>

        </Stack>

      </Stack>



      {/* KPI */}
      <Grid container spacing={2} mb={3}>

        {KPI.map(k => (

          <Grid item xs={12} md={3} key={k.key}>

            <Card
              onClick={() =>
                setFilter(k.key)
              }
              sx={{
                cursor: "pointer",
                border:
                  filter === k.key ?
                  "2px solid" + k.color :
                  "",
              }}
            >

              <CardContent>

                <Stack
                  direction="row"
                  justifyContent="space-between"
                >

                  <Box>

                    <Typography variant="h4">

                      {loading ?
                        <Skeleton width={40} />
                        :
                        k.value}

                    </Typography>

                    <Typography>

                      {k.label}

                    </Typography>

                    <Typography variant="caption">

                      {k.pct}%

                    </Typography>

                  </Box>

                  <Avatar
                    sx={{
                      bgcolor: k.color,
                    }}
                  >

                    {k.icon}

                  </Avatar>

                </Stack>

                <LinearProgress
                  variant="determinate"
                  value={k.pct}
                  sx={{ mt: 2 }}
                />

              </CardContent>

            </Card>

          </Grid>

        ))}

      </Grid>



      {/* CHART */}
      <Paper sx={{ p: 3, mb: 3 }}>

        {loading ?

          <Skeleton
            variant="circular"
            width={200}
            height={200}
          />

          :

          <PieChart
            series={[
              {
                data: chartData,
                innerRadius: 60,
              },
            ]}
            width={400}
            height={250}
          />

        }

      </Paper>



      {/* TABLE */}
      <Paper>

        <Table>

          <TableHead>

            <TableRow>

              <TableCell>

                Circle

              </TableCell>

              <TableCell>

                Status

              </TableCell>

            </TableRow>

          </TableHead>

          <TableBody>

            {loading ?

              [...Array(5)].map((_, i) => (

                <TableRow key={i}>

                  <TableCell>

                    <Skeleton />

                  </TableCell>

                  <TableCell>

                    <Skeleton />

                  </TableCell>

                </TableRow>

              ))

              :

              filteredData.length === 0 ?

                <TableRow>

                  <TableCell
                    colSpan={2}
                    align="center"
                  >

                    <InboxIcon />

                    No Data Found

                  </TableCell>

                </TableRow>

                :

                filteredData.map(row => {

                  const status =
                    getStatusConfig(
                      row.MISC_STATUS
                    );

                  return (

                    <Fade in key={row.CIRCLE_CODE}>

                      <TableRow>

                        <TableCell>

                          {row.CIRCLE_NAME}

                        </TableCell>

                        <TableCell>

                          <Chip
                            label={status.label}
                            color={status.muiColor}
                          />

                        </TableCell>

                      </TableRow>

                    </Fade>

                  );

                })

            }

          </TableBody>

        </Table>

      </Paper>


      <LoadingOverlay loading={loading} />

    </Box>

  );

};


export default DICGCDashboard;