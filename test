/**
 * =========================================================
 * SAFE ORACLE VALUE EXTRACTOR
 * =========================================================
 *
 * Important:
 * Do NOT call rs.getObject() first for CLOB columns.
 * Oracle JDBC drivers may return an Oracle-specific CLOB
 * implementation whose toString() returns an object reference
 * instead of the actual CLOB content.
 */
private Object getSafeValue(ResultSet rs, int index) throws SQLException {

    ResultSetMetaData metaData = rs.getMetaData();
    int sqlType = metaData.getColumnType(index);

    /*
     * =====================================================
     * CLOB
     * =====================================================
     */
    if (sqlType == java.sql.Types.CLOB) {

        try (Reader reader = rs.getCharacterStream(index)) {

            if (reader == null) {
                return null;
            }

            StringBuilder value = new StringBuilder();

            char[] buffer = new char[8192];
            int charsRead;

            while ((charsRead = reader.read(buffer)) != -1) {
                value.append(buffer, 0, charsRead);
            }

            return value.toString();
        }
    }

    /*
     * =====================================================
     * NCLOB
     * =====================================================
     */
    if (sqlType == java.sql.Types.NCLOB) {

        try (Reader reader = rs.getNCharacterStream(index)) {

            if (reader == null) {
                return null;
            }

            StringBuilder value = new StringBuilder();

            char[] buffer = new char[8192];
            int charsRead;

            while ((charsRead = reader.read(buffer)) != -1) {
                value.append(buffer, 0, charsRead);
            }

            return value.toString();
        }
    }

    /*
     * =====================================================
     * LONG VARCHAR
     * =====================================================
     */
    if (sqlType == java.sql.Types.LONGVARCHAR ||
            sqlType == java.sql.Types.LONGNVARCHAR) {

        return rs.getString(index);
    }

    /*
     * =====================================================
     * Normal JDBC values
     * =====================================================
     */
    Object value = rs.getObject(index);

    if (value == null) {
        return null;
    }

    /*
     * =====================================================
     * Extra protection for Oracle-specific CLOB objects
     * =====================================================
     */
    if (value instanceof java.sql.Clob clob) {

        try (Reader reader = clob.getCharacterStream()) {

            if (reader == null) {
                return null;
            }

            StringBuilder result = new StringBuilder();

            char[] buffer = new char[8192];
            int charsRead;

            while ((charsRead = reader.read(buffer)) != -1) {
                result.append(buffer, 0, charsRead);
            }

            return result.toString();
        }
    }

    /*
     * =====================================================
     * Oracle driver fallback
     * =====================================================
     */
    String className = value.getClass().getName();

    if (className.toUpperCase(Locale.ROOT).contains("CLOB")) {

        try {
            String stringValue = rs.getString(index);

            if (stringValue != null) {
                return stringValue;
            }
        } catch (Exception e) {
            log.warn(
                    "Unable to convert Oracle CLOB column {} using getString(). Type={}",
                    index,
                    className,
                    e
            );
        }
    }

    return value;
}