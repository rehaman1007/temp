package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import org.springframework.web.multipart.MultipartFile;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;

import java.sql.*;
import java.sql.Date;

import java.util.*;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * COMMAND PANEL EXECUTION
     */
    @Override
    public Map<String, Object> executeAdminSql(
            AdminSupportDTO dto
    ) {

        String rawSql = dto.getSql().trim();

        String[] statements = rawSql.split(";");

        List<String> cleanStatements =
                new ArrayList<>();

        for (String s : statements) {

            String clean = s
                    .replaceAll("(?m)^--.*", "")
                    .trim();

            if (!clean.isEmpty()) {

                cleanStatements.add(clean);
            }
        }

        boolean isSingleSelect =
                cleanStatements.size() == 1
                        &&
                        (
                                cleanStatements.get(0)
                                        .toUpperCase()
                                        .startsWith("SELECT")

                                        ||

                                        cleanStatements.get(0)
                                                .toUpperCase()
                                                .startsWith("WITH")
                        );

        int page =
                dto.getPage() != null
                        ? dto.getPage()
                        : 0;

        int size =
                dto.getSize() != null
                        ? dto.getSize()
                        : 5;

        /**
         * SELECT QUERY
         */
        if (isSingleSelect) {

            String sql = cleanStatements.get(0);

            try {

                String countSql =
                        "SELECT COUNT(*) FROM (" + sql + ")";

                Integer total =
                        jdbcTemplate.queryForObject(
                                countSql,
                                Integer.class
                        );

                String paginatedSql =
                        sql
                                + " OFFSET "
                                + (page * size)
                                + " ROWS FETCH NEXT "
                                + size
                                + " ROWS ONLY";

                return jdbcTemplate.query(
                        paginatedSql,
                        rs -> {

                            ResultSetMetaData meta =
                                    rs.getMetaData();

                            int columnCount =
                                    meta.getColumnCount();

                            List<Map<String, String>>
                                    columns =
                                    new ArrayList<>();

                            for (
                                    int i = 1;
                                    i <= columnCount;
                                    i++
                            ) {

                                columns.add(
                                        Map.of(
                                                "name",
                                                meta.getColumnLabel(i)
                                        )
                                );
                            }

                            List<Map<String, Object>>
                                    rows =
                                    new ArrayList<>();

                            while (rs.next()) {

                                Map<String, Object> row =
                                        new HashMap<>();

                                for (
                                        int i = 1;
                                        i <= columnCount;
                                        i++
                                ) {

                                    String columnName =
                                            meta.getColumnLabel(i);

                                    int columnType =
                                            meta.getColumnType(i);

                                    Object value = null;

                                    switch (columnType) {

                                        case Types.VARCHAR:
                                        case Types.CHAR:
                                        case Types.LONGVARCHAR:
                                        case Types.NVARCHAR:
                                        case Types.NCHAR:

                                            value =
                                                    rs.getString(i);

                                            break;

                                        case Types.INTEGER:
                                        case Types.SMALLINT:
                                        case Types.TINYINT:

                                            int intVal =
                                                    rs.getInt(i);

                                            value =
                                                    rs.wasNull()
                                                            ? null
                                                            : intVal;

                                            break;

                                        case Types.BIGINT:

                                            long longVal =
                                                    rs.getLong(i);

                                            value =
                                                    rs.wasNull()
                                                            ? null
                                                            : longVal;

                                            break;

                                        case Types.NUMERIC:
                                        case Types.DECIMAL:

                                            value =
                                                    rs.getBigDecimal(i);

                                            break;

                                        case Types.FLOAT:
                                        case Types.DOUBLE:
                                        case Types.REAL:

                                            double dbl =
                                                    rs.getDouble(i);

                                            value =
                                                    rs.wasNull()
                                                            ? null
                                                            : dbl;

                                            break;

                                        case Types.DATE:

                                            Date date =
                                                    rs.getDate(i);

                                            value =
                                                    date != null
                                                            ? date.toLocalDate().toString()
                                                            : null;

                                            break;

                                        case Types.TIME:

                                            Time time =
                                                    rs.getTime(i);

                                            value =
                                                    time != null
                                                            ? time.toLocalTime().toString()
                                                            : null;

                                            break;

                                        case Types.TIMESTAMP:
                                        case -101:

                                            Timestamp ts =
                                                    rs.getTimestamp(i);

                                            value =
                                                    ts != null
                                                            ?
                                                            ts.toLocalDateTime()
                                                                    .format(
                                                                            java.time.format.DateTimeFormatter.ofPattern(
                                                                                    "dd-MM-yyyy HH:mm:ss"
                                                                            )
                                                                    )
                                                            : null;

                                            break;

                                        case Types.CLOB:
                                        case Types.NCLOB:

                                            Clob clob =
                                                    rs.getClob(i);

                                            value =
                                                    clob != null
                                                            ?
                                                            clob.getSubString(
                                                                    1,
                                                                    (int) clob.length()
                                                            )
                                                            : null;

                                            break;

                                        case Types.BLOB:
                                        case Types.BINARY:
                                        case Types.VARBINARY:
                                        case Types.LONGVARBINARY:

                                            value = "[BLOB DATA]";

                                            break;

                                        default:

                                            Object obj =
                                                    rs.getObject(i);

                                            value =
                                                    obj != null
                                                            ? obj.toString()
                                                            : null;
                                    }

                                    row.put(
                                            columnName,
                                            value
                                    );
                                }

                                rows.add(row);
                            }

                            return Map.of(
                                    "columns", columns,
                                    "rows", rows,
                                    "total", total,
                                    "page", page,
                                    "size", size,
                                    "error", false
                            );
                        }
                );

            } catch (Exception e) {

                log.error(
                        "Execution Error",
                        e
                );

                return Map.of(
                        "error", true,
                        "message", e.getMessage()
                );
            }
        }

        /**
         * SCRIPT EXECUTION
         */
        else {

            try {

                int successful = 0;

                for (String sql : cleanStatements) {

                    jdbcTemplate.execute(sql);

                    successful++;
                }

                return Map.of(
                        "error", false,
                        "columns",
                        List.of(
                                Map.of(
                                        "name",
                                        "RESULT"
                                )
                        ),
                        "rows",
                        List.of(
                                Map.of(
                                        "RESULT",
                                        "Script executed successfully. Statements : "
                                                + successful
                                )
                        ),
                        "total",
                        successful
                );

            } catch (Exception e) {

                log.error(
                        "Script Error",
                        e
                );

                return Map.of(
                        "error", true,
                        "message", e.getMessage()
                );
            }
        }
    }

    /**
     * HUGE FILE EXECUTION
     */
    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file
    ) {

        try {

            String jobId =
                    UUID.randomUUID().toString();

            Path tempFile =
                    Files.createTempFile(
                            "sql-upload-",
                            ".sql"
                    );

            Files.copy(
                    file.getInputStream(),
                    tempFile,
                    StandardCopyOption.REPLACE_EXISTING
            );

            log.info(
                    "Temporary SQL file created : {}",
                    tempFile
            );

            adminSupportExecutor.executeScriptAsync(
                    tempFile,
                    jobId
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId,
                    "message", "SQL execution started"
            );

        } catch (Exception e) {

            log.error(
                    "Failed to start SQL execution",
                    e
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    /**
     * JOB STATUS
     */
    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return adminSupportExecutor.getJobStatus(
                jobId
        );
    }
}