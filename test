import React from "react";
import {
  Card,
  CardContent,
  Typography,
  Stack,
  List,
  ListItem,
  ListItemText,
  Divider,
  Box,
  Chip
} from "@mui/material";
import CampaignIcon from "@mui/icons-material/Campaign";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import InfoIcon from "@mui/icons-material/Info";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CustomChip from "../../../utils/CustomChip";

/**
 * Announcements component
 * - severity chip positioned at the right end of the row
 * - chip contains an icon for quick scanning
 */
export const DashboardAnnouncements = ({ announcements = [] }) => {
  const getSeverityConfig = (severity) => {
    const key = (severity || "").toUpperCase();
    switch (key) {
      case "WARN":
        return { color: "warning", label: "WARN", icon: <WarningAmberIcon fontSize="small" /> };
      case "ERROR":
        return { color: "error", label: "ERROR", icon: <ErrorOutlineIcon fontSize="small" /> };
      case "INFO":
      default:
        return { color: "info", label: "INFO", icon: <InfoIcon fontSize="small" /> };
    }
  };

  // fallback renderer for chip (in case CustomChip doesn't accept icon prop)
  const RenderChip = ({ severity }) => {
    const cfg = getSeverityConfig(severity);
    // try CustomChip first; if it supports icon prop it'll be used.
    // If CustomChip is not available or doesn't accept icon, fallback to MUI Chip.
    try {
      return (
        <CustomChip
          label={cfg.label}
          size="small"
          color={cfg.color}
          variant="outlined"
          icon={cfg.icon}
          sx={{ fontWeight: 700 }}
        />
      );
    } catch (e) {
      return (
        <Chip
          label={cfg.label}
          size="small"
          color={cfg.color}
          variant="outlined"
          icon={cfg.icon}
          sx={{ fontWeight: 700 }}
        />
      );
    }
  };

  return (
    <Card variant="outlined" sx={{ borderRadius: 3 }}>
      <CardContent>
        <Stack direction="row" spacing={1} alignItems="center" mb={1}>
          <Box
            sx={{
              width: 44,
              height: 44,
              borderRadius: 2,
              bgcolor: "rgba(0,0,0,0.06)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            <CampaignIcon />
          </Box>

          <Typography variant="subtitle1" fontWeight={700}>
            Announcements
          </Typography>
        </Stack>

        <List dense sx={{ minHeight: 320, maxHeight: 320, overflow: "auto" }}>
          {(announcements || []).length === 0 && (
            <Box sx={{ py: 3, textAlign: "center" }}>
              <Typography variant="body2" color="text.secondary">
                No announcements
              </Typography>
            </Box>
          )}

          {(announcements || []).map((a, idx) => {
            const cfg = getSeverityConfig(a.severity);
            const key = a.id ?? idx;

            return (
              <React.Fragment key={key}>
                {idx > 0 && <Divider component="li" />}

                <ListItem alignItems="flex-start" sx={{ py: 1.25 }}>
                  {/* Use a flex container so title and chip sit at extremes */}
                  <Box sx={{ display: "flex", width: "100%", alignItems: "flex-start", gap: 2 }}>
                    <Box sx={{ flex: 1, minWidth: 0 }}>
                      <ListItemText
                        primary={
                          <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 2 }}>
                            <Typography
                              variant="body2"
                              fontWeight={700}
                              sx={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}
                            >
                              {a.title}
                            </Typography>

                            {/* Right-corner chip */}
                            <Box sx={{ flexShrink: 0, ml: 1 }}>
                              <RenderChip severity={a.severity} />
                            </Box>
                          </Box>
                        }
                        secondary={
                          <Box>
                            <Typography component="span" variant="caption" color="text.secondary" display="block">
                              {a.date}
                            </Typography>
                            <Typography variant="body2" sx={{ mt: 0.5 }}>
                              {a.message}
                            </Typography>
                          </Box>
                        }
                      />
                    </Box>
                  </Box>
                </ListItem>
              </React.Fragment>
            );
          })}
        </List>
      </CardContent>
    </Card>
  );
};

export default DashboardAnnouncements;