import {
  Dialog,
  DialogContent,
  Button,
  Paper,
  Typography,
  Box,
  Stack,
  IconButton,
  Tooltip,
  RadioGroup,
  FormControlLabel,
  Radio,
} from "@mui/material";

import GppBadIcon from "@mui/icons-material/GppBad";
import GppGoodIcon from "@mui/icons-material/GppGood";
import CloseIcon from "@mui/icons-material/Close";
import PictureAsPdfOutlinedIcon from "@mui/icons-material/PictureAsPdfOutlined";
import ImageOutlinedIcon from "@mui/icons-material/ImageOutlined";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";

import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import { toPng } from "html-to-image";
import { useRef, useState, useEffect, useMemo } from "react";
import { TABLE_CONFIG } from "../util/ProcessSummaryTableConfig";
import DynamicSummaryTable from "./ProcessDynamicSummaryTable";
import ProcessReportDownloadProgress from "./ProcessReportDownloadProgress";
import { StageStatus } from "../util/StageStatus";

/* ================= FORMAT ================= */

const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : "—";

/* ================= SUMMARY → FILE MAP ================= */

const SUMMARY_FILE_MAP = {
  BALANCE: "balance_compare_report",
  CIBA: "intr_report",
  SUSPENSE: "cntr_report",
};

/* ====================================================== */

const ProcessSummaryDialog = ({
  open,
  data,
  isCurrentDate,
  onClose,
  onAccept,
  onReject,
  onDownload,
  downloadProgress,
  permissions = {},
}) => {
  const reportRef = useRef(null);
  const copyTimeoutRef = useRef(null);

  const [copied, setCopied] = useState(false);
  const [summaryType, setSummaryType] = useState("BALANCE");

  const safeData = data || {};
  /* ================= DATA ================= */

  const {
    process = {},
    processRunId,
    RECON_RUN_DATE,
    differenceSummary = [],
    cibaSummary = [],
    suspenseSummary = [],
    stages = [],
  } = safeData;

  /* ================= STAGE CHECK ================= */

  const balanceDone = stages.some(
    (s) => s.stageId === "balance_Compare_generated" && s.stageStatus === 2,
  );

  const cibaDone = stages.some(
    (s) => s.stageId === "intr_summary_calculated" && s.stageStatus === 2,
  );

  const suspenseDone = stages.some(
    (s) => s.stageId === "cntr_summary_calculated" && s.stageStatus === 2,
  );

  // const stageWaiting = stages.some(
  //   (s) => s.stageId === "waiting_for_approval" && s.stageStatus === 1,
  // );

  const stageWaiting = process?.status == StageStatus.WAITING_FOR_APPROVAL;

  /* ================= AVAILABLE TYPES ================= */

  const availableSummaryTypes = useMemo(() => {
    const arr = [];

    if (balanceDone) arr.push("BALANCE");
    if (cibaDone) arr.push("CIBA");
    if (suspenseDone) arr.push("SUSPENSE");

    return arr;
  }, [balanceDone, cibaDone, suspenseDone]);

  /* ================= AUTO FIX SELECTED TYPE ================= */

  useEffect(() => {
    if (!availableSummaryTypes.includes(summaryType)) {
      setSummaryType(availableSummaryTypes[0] || "BALANCE");
    }
  }, [availableSummaryTypes, summaryType]);

  /* ================= ACTIVE SUMMARY ================= */

  const activeSummary = useMemo(() => {
    switch (summaryType) {
      case "BALANCE":
        return differenceSummary || [];

      case "CIBA":
        return cibaSummary || [];

      case "SUSPENSE":
        return suspenseSummary || [];

      default:
        return [];
    }
  }, [summaryType, differenceSummary, cibaSummary, suspenseSummary]);

  /* ================= EXPORT PDF ================= */

  const exportPDF = () => {
    const config = TABLE_CONFIG[summaryType];

    if (!config) return;

    const doc = new jsPDF("p", "pt");

    doc.setFontSize(14);
    doc.text(`${summaryType} Summary Report`, 40, 40);

    doc.setFontSize(10);
    doc.text(`Reconciliation Date: ${RECON_RUN_DATE}`, 40, 58);

    /* ================= HEADERS ================= */

    const headers = config.columns.map((col) => col.label);

    /* ================= BODY ================= */

    const body = activeSummary.map((row) =>
      config.columns.map((col) =>
        col.align === "right"
          ? formatAmount(row[col.field]) || row[col.field]
          : row[col.field] || "—",
      ),
    );

    /* ================= TOTAL ROW ================= */

    if (config.totalFields?.length) {
      const totals = {};

      config.totalFields.forEach((field) => {
        totals[field] = activeSummary.reduce(
          (sum, r) => sum + (Number(r[field]) || 0),
          0,
        );
      });

      const totalRow = config.columns.map((col, index) => {
        if (index === 0) return "TOTAL";

        if (totals[col.field] !== undefined)
          return formatAmount(totals[col.field]);

        return "";
      });

      body.push(totalRow);
    }

    /* ================= GENERATE TABLE ================= */

    autoTable(doc, {
      startY: 80,
      head: [headers],
      body,
      styles: {
        fontSize: 9,
        halign: "right",
      },
      columnStyles: {
        0: { halign: "left" },
      },
      didParseCell: (data) => {
        if (data.row.index === body.length - 1) {
          data.cell.styles.fontStyle = "bold";
        }
      },
    });

    doc.save(`${summaryType}_Summary_${RECON_RUN_DATE}.pdf`);
  };

  /* ================= COPY PNG ================= */
  const copyPNGToClipboard = async () => {
    if (!reportRef.current) return;

    const element = reportRef.current;

    try {
      const dataUrl = await toPng(element, {
        cacheBust: true,
        backgroundColor: "#ffffff",
        pixelRatio: 2,

        /* fixes font/css errors */
        skipFonts: true,
      });

      const blob = await (await fetch(dataUrl)).blob();

      await navigator.clipboard.write([
        new ClipboardItem({
          "image/png": blob,
        }),
      ]);

      setCopied(true);

      clearTimeout(copyTimeoutRef.current);

      copyTimeoutRef.current = setTimeout(() => {
        setCopied(false);
      }, 2000);
    } catch (err) {
      console.error(err);
    }
  };

  /* ====================================================== */

  return (
    <>
      <Dialog open={open} fullWidth maxWidth="md">
        {/* HEADER */}

        <Box
          sx={{
            px: 3,
            py: 2,
            borderBottom: 1,
            borderColor: "divider",
            display: "flex",
            justifyContent: "space-between",
          }}
        >
          <Box>
            <Typography variant="h6" fontWeight={700}>
              {summaryType} Summary Report
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Reconciliation Date: {RECON_RUN_DATE}
            </Typography>
          </Box>

          <Stack direction="row" spacing={1}>
            <Tooltip title="Export summary to PDF">
              <IconButton onClick={exportPDF}>
                <PictureAsPdfOutlinedIcon />
              </IconButton>
            </Tooltip>

            <Tooltip title={copied ? "Copied!" : "Copy summary as image"}>
              <IconButton
                onClick={copyPNGToClipboard}
                sx={{ color: copied ? "success.main" : "inherit" }}
              >
                {copied ? <CheckCircleOutlineIcon /> : <ImageOutlinedIcon />}
              </IconButton>
            </Tooltip>

            <IconButton onClick={onClose}>
              <CloseIcon />
            </IconButton>
          </Stack>
        </Box>

        {/* BODY */}

        <DialogContent>
          {/* RADIO */}
          {permissions.download && availableSummaryTypes.length > 0 && (
            <Paper sx={{ p: 2, mb: 2 }}>
              <Stack
                direction="row"
                justifyContent="space-between"
                alignItems="center"
                flexWrap="wrap"
                gap={2}
              >
                <RadioGroup
                  row
                  value={summaryType}
                  onChange={(e) => {
                    setSummaryType(e.target.value);
                  }}
                >
                  {availableSummaryTypes.includes("BALANCE") && (
                    <FormControlLabel
                      value="BALANCE"
                      control={<Radio />}
                      label="Balance Compare"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}

                  {availableSummaryTypes.includes("CIBA") && (
                    <FormControlLabel
                      value="CIBA"
                      control={<Radio />}
                      label="CIBA"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}

                  {availableSummaryTypes.includes("SUSPENSE") && (
                    <FormControlLabel
                      value="SUSPENSE"
                      control={<Radio />}
                      label="Suspense"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}
                </RadioGroup>

                <Button
                  startIcon={<CloudDownloadTwoToneIcon />}
                  variant="contained"
                  onClick={() =>
                    onDownload(
                      SUMMARY_FILE_MAP[summaryType],
                      RECON_RUN_DATE,
                      processRunId,
                    )
                  }
                  disabled={downloadProgress?.inProgress}
                >
                  Download Full Report
                </Button>
              </Stack>

              {/* DOWNLOAD PROGRESS */}

              <ProcessReportDownloadProgress
                downloadProgress={downloadProgress}
              />
            </Paper>
          )}

          {/* TABLE */}

          <Box ref={reportRef}>
            <DynamicSummaryTable
              summaryType={summaryType}
              data={activeSummary}
            />
          </Box>
        </DialogContent>

        {/* FOOTER */}

        {isCurrentDate && safeData && stageWaiting && (
          <Box
            sx={{
              px: 3,
              py: 2,
              borderTop: 1,
              borderColor: "divider",
              display: "flex",
              justifyContent: "center",
              gap: 2,
            }}
          >
            {permissions.reject && (
              <Button
                color="error"
                variant="outlined"
                startIcon={<GppBadIcon />}
                onClick={onReject}
              >
                Reject
              </Button>
            )}

            {permissions.approve && (
              <Button
                color="success"
                variant="contained"
                startIcon={<GppGoodIcon />}
                onClick={onAccept}
              >
                Accept
              </Button>
            )}
          </Box>
        )}
      </Dialog>
    </>
  );
};

export default ProcessSummaryDialog;



import React, { useMemo, forwardRef, useState, useEffect } from "react";
import {
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
  TableSortLabel,
} from "@mui/material";
import { TABLE_CONFIG } from "../util/ProcessSummaryTableConfig";
import AssignmentLateOutlinedIcon from "@mui/icons-material/AssignmentLateOutlined";
import { visuallyHidden } from "@mui/utils";

/* ================= FORMATTERS ================= */
const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : num || "—";

/* ================= COMPONENT ================= */
const DynamicSummaryTable = forwardRef(
  ({ summaryType = "BALANCE", data }, ref) => {
    /* ================= SORTING STATE ================= */
    const [order, setOrder] = useState("asc");
    const [orderBy, setOrderBy] = useState("");

    /* ================= RESET SORT ON SUMMARY CHANGE ================= */
    // This effect ensures that whenever you switch summaries,
    // the sorting resets to your required defaults.
    useEffect(() => {
      setOrder("asc");
      setOrderBy(summaryType === "BALANCE" ? "HEAD" : "count");
    }, [summaryType]);

    const config = useMemo(() => {
      return TABLE_CONFIG[summaryType] || { columns: [], totalFields: [] };
    }, [summaryType]);

    const handleRequestSort = (property) => {
      const isAsc = orderBy === property && order === "asc";
      setOrder(isAsc ? "desc" : "asc");
      setOrderBy(property);
    };

    /* ================= MULTI-COLUMN SORTING (1, 2, 3) ================= */
    const sortedData = useMemo(() => {
      if (!data || data.length === 0) return [];

      return [...data].sort((a, b) => {
        // Sort based on the first 3 columns defined in the config
        for (let i = 0; i < Math.min(config.columns.length, 3); i++) {
          const colField = config.columns[i].field;

          // Current column uses 'order' state; others default to 'asc'
          const currentOrder = colField === orderBy ? order : "asc";

          let valA = a[colField];
          let valB = b[colField];

          if (valA === valB) continue;

          // Numeric Comparison
          const numA = parseFloat(valA);
          const numB = parseFloat(valB);
          if (!isNaN(numA) && !isNaN(numB)) {
            return currentOrder === "asc" ? numA - numB : numB - numA;
          }

          // String Comparison
          const strA = String(valA || "").toLowerCase();
          const strB = String(valB || "").toLowerCase();
          if (strA < strB) return currentOrder === "asc" ? -1 : 1;
          if (strA > strB) return currentOrder === "asc" ? 1 : -1;
        }
        return 0;
      });
    }, [data, order, orderBy, config]);

    /* ================= TOTAL CALCULATION ================= */
    const totals = useMemo(() => {
      const result = {};
      config?.totalFields.forEach((field) => {
        result[field] =
          data?.reduce((sum, row) => sum + (Number(row[field]) || 0), 0) || 0;
      });
      return result;
    }, [data, config]);

    if (!config?.columns || config.columns.length === 0) {
      return (
        <Box p={2}>
          <Typography color="text.secondary">No configuration found</Typography>
        </Box>
      );
    }

    return (
      <TableContainer component={Paper} ref={ref}>
        <Table size="small">
          <TableHead>
            <TableRow>
              {config.columns.map((col) => (
                <TableCell
                  key={col.field}
                  align={col.align}
                  sx={{ fontWeight: 700, whiteSpace: "nowrap" }}
                  sortDirection={orderBy === col.field ? order : false}
                >
                  <TableSortLabel
                    active={orderBy === col.field}
                    direction={orderBy === col.field ? order : "asc"}
                    onClick={() => handleRequestSort(col.field)}
                  >
                    {col.label}
                    {orderBy === col.field ? (
                      <Box component="span" sx={visuallyHidden}>
                        {order === "desc"
                          ? "sorted descending"
                          : "sorted ascending"}
                      </Box>
                    ) : null}
                  </TableSortLabel>
                </TableCell>
              ))}
            </TableRow>
          </TableHead>

          <TableBody>
            {sortedData.length > 0 ? (
              <>
                {sortedData.map((row, index) => (
                  <TableRow key={index} hover>
                    {config.columns.map((col) => (
                      <TableCell
                        key={col.field}
                        align={col.align}
                        sx={{
                          ...(col.style || {}),
                          ...(col.field !== "HEAD" &&
                            !col.style && {
                              fontFamily: "monospace",
                              fontWeight: "bold",
                            }),
                        }}
                      >
                        {col.align === "right"
                          ? formatAmount(row[col.field])
                          : row[col.field] || "—"}
                      </TableCell>
                    ))}
                  </TableRow>
                ))}

                {config.totalFields.length > 0 && (
                  <TableRow sx={{ bgcolor: "#f5f5f5" }}>
                    {config.columns.map((col, index) => {
                      if (index === 0)
                        return (
                          <TableCell key="label">
                            <b>TOTAL</b>
                          </TableCell>
                        );
                      return (
                        <TableCell key={col.field} align={col.align}>
                          {totals[col.field] !== undefined ? (
                            <b>{formatAmount(totals[col.field])}</b>
                          ) : null}
                        </TableCell>
                      );
                    })}
                  </TableRow>
                )}
              </>
            ) : (
              <TableRow>
                <TableCell
                  colSpan={config.columns.length}
                  sx={{ py: 6, textAlign: "center" }}
                >
                  <Box
                    sx={{
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      opacity: 0.7,
                    }}
                  >
                    <AssignmentLateOutlinedIcon
                      sx={{
                        fontSize: 56,
                        mb: 2,
                        color: "primary.main",
                        opacity: 0.4,
                      }}
                    />
                    <Typography variant="h6" sx={{ fontWeight: 700 }}>
                      NO SUMMARY DATA
                    </Typography>
                  </Box>
                </TableCell>
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>
    );
  },
);

export default DynamicSummaryTable;


import React from "react";
import {
  Box,
  Paper,
  Typography,
  Fade,
  LinearProgress,
  useTheme,
} from "@mui/material";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";
import CustomChip from "../../../utils/CustomChip";

const ProcessReportDownloadProgress = ({ downloadProgress }) => {
  const theme = useTheme();

  const downloadedMB =
    downloadProgress?.loadedBytes > 0
      ? (downloadProgress.loadedBytes / (1024 * 1024)).toFixed(2)
      : null;

  return (
    <Fade in={downloadProgress?.inProgress} unmountOnExit>
      <Box sx={{ mt: 2 }}>
        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            gap: 2,
            p: 1.5,
            mb: 1.5,
            borderRadius: 2,
            bgcolor: theme.palette.mode === "light" ? "grey.50" : "grey.800",
            border: "1px solid",
            borderColor: "divider",
          }}
        >
          {/* Pulsing Icon Wrapper */}
          <Box
            sx={{
              p: 1,
              borderRadius: "50%",
              bgcolor: "primary.main",
              color: "common.white",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              boxShadow: `0 0 0 0 ${theme.palette.primary.main}44`,
              animation: downloadProgress?.inProgress
                ? "pulse 2s infinite"
                : "none",
              "@keyframes pulse": {
                "0%": {
                  boxShadow: `0 0 0 0 ${theme.palette.primary.main}66`,
                },
                "70%": {
                  boxShadow: `0 0 0 10px ${theme.palette.primary.main}00`,
                },
                "100%": {
                  boxShadow: `0 0 0 0 ${theme.palette.primary.main}00`,
                },
              },
            }}
          >
            <CloudDownloadTwoToneIcon
              sx={{
                fontSize: 22,
                transform: "translateY(1px)",
              }}
            />
          </Box>

          <Box sx={{ flex: 1 }}>
            <Typography variant="body2" fontWeight={600} color="text.primary">
              Downloading Report
            </Typography>

            <Typography
              variant="caption"
              color="text.secondary"
              sx={{ display: "block" }}
            >
              {downloadedMB > 0
                ? `Streaming content… ${downloadedMB} MB received`
                : "Establishing connection to report server…"}
            </Typography>
          </Box>

          {downloadedMB > 0 && (
            <CustomChip
              color="error"
              label={`${downloadedMB} MB`}
              variant="filled"
            />
          )}
        </Box>

        <LinearProgress
          variant="indeterminate"
          sx={{
            height: 8,
            borderRadius: 4,
            overflow: "hidden",
            bgcolor: theme.palette.mode === "light" ? "grey.200" : "grey.800",
            "& .MuiLinearProgress-bar": {
              borderRadius: 4,
              backgroundImage:
                "linear-gradient(90deg, #42a5f5 0%, #7e57c2 50%, #ffb300 100%)",
            },
          }}
        />
      </Box>
    </Fade>
  );
};

export default ProcessReportDownloadProgress;
