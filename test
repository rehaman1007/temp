import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  Checkbox,
  Autocomplete,
  Divider,
  List,
  ListItemIcon,
  ToggleButton,
  Tooltip,
  Box,
} from "@mui/material";
import { useEffect, useState, useCallback } from "react";
import * as MuiIcons from "@mui/icons-material";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import RestoreIcon from "@mui/icons-material/Restore";
import { validations } from "../../../utils/Validations";
import { DndProvider } from "react-dnd";
import { HTML5Backend } from "react-dnd-html5-backend";
import DraggablePermissionItem from "./DraggablePermissionItem";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import LockOutlinedIcon from "@mui/icons-material/LockOutlined";

export default function RolesDialog({
  open,
  onClose,
  form,
  setForm,
  canSave,
  fetchRoles,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const [selectedPermissions, setSelectedPermissions] = useState([]);
  const [originalOrder, setOriginalOrder] = useState([]);
  const [isBlocked, setIsBlocked] = useState(form?.roleStatus === "BLOCKED");

  const handleStatusToggle = async () => {
    const newStatus = form.roleStatus === "ACTIVE" ? "BLOCKED" : "ACTIVE";
    setIsBlocked(!isBlocked);
    form.roleStatus = newStatus;
  };

  const DummyPermissions = [
    { id: 1, title: "Dashboard Access", icon: "Dashboard" },
    { id: 2, title: "User Management", icon: "People" },
    { id: 3, title: "Settings Access", icon: "Settings" },
    { id: 4, title: "Audit Reports", icon: "Assessment" },
    { id: 5, title: "View Analytics", icon: "BarChart" },
  ];

  const [allPermissions, setAllPermissions] = useState([]);
  const fetchAllPermissions = async () => {
    try {
      const responnse = await callApi(
        "/UM/role/get-all-permissions",
        {},
        "GET"
      );
      const permits = responnse?.result ?? DummyPermissions;
      setAllPermissions(permits);
    } catch (error) {
      console.error(error);
      setAllPermissions(DummyPermissions);
    }
  };

  /** Initialize permission order + icons */
  useEffect(() => {
    if (open) {
      fetchAllPermissions();
      if (form?.permissions?.length) {
        const withOrder = form.permissions.map((p, i) => ({
          ...p,
          order: p.order ?? i + 1,
        }));
        setSelectedPermissions(withOrder);
        setOriginalOrder(withOrder);
      } else {
        setSelectedPermissions([]);
        setOriginalOrder([]);
      }
    }
  }, [open]);

  /** Validation handler */
  const handleChange = (data, key, e, type) => {
    const result = validations(type, e.target.value);
    if (result === "") setForm({ ...data, [key]: e.target.value });
  };

  /** Move item via DND */
  const moveItem = useCallback(
    (from, to) => {
      const updated = [...selectedPermissions];
      const [moved] = updated.splice(from, 1);
      updated.splice(to, 0, moved);
      const reOrdered = updated.map((item, idx) => ({
        ...item,
        order: idx + 1,
      }));
      setSelectedPermissions(reOrdered);
    },
    [selectedPermissions]
  );

  /** Reset to original order */
  const handleReset = () => setSelectedPermissions(originalOrder);

  /** Handle Autocomplete selection change */
  const handlePermissionsSelect = (e, newValue) => {
    const withOrder = newValue.map((p, idx) => ({
      ...p,
      order: idx + 1,
    }));
    setSelectedPermissions(withOrder);
  };

  /** Save with permissions & order */
  const handleSave = async () => {
    if (!form.roleName || !form.description) {
      snackbar("Kindly fill all the required fields.", "error");
      return;
    }
    const updatedForm = {
      ...form,
      permissions: selectedPermissions.map((p) => ({
        id: p.id,
        title: p.title,
        order: p.order,
        icon: p.icon,
      })),
    };
    console.log("updatedForm →", updatedForm);
    setForm(updatedForm);
    const payload = {
      requestType: form.roleId ? "MODIFY" : "CREATE",
      targetRoleId: form.roleId || "",
      requestPayload: JSON.stringify(updatedForm),
    };
    console.log("Payload →", payload);
    let response = await callApi(
      "/UM/role/create-role-request",
      payload,
      "POST"
    );
    if (response?.result?.status) {
      snackbar(response?.result?.message, "success");
      onClose();
      fetchRoles();
    }
    onClose();
  };

  /** Render dynamic MUI icon from string name */
  const renderIcon = (iconName) => {
    const IconComp = MuiIcons[iconName];
    return IconComp ? (
      <IconComp fontSize="small" sx={{ mr: 1 }} />
    ) : (
      <MuiIcons.HelpOutline fontSize="small" sx={{ mr: 1 }} />
    );
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" color="primary">
            {form.roleId ? "Edit " : "Create New "} <b>{form.roleName}</b> Role
          </Typography>
          {form.roleId && (
            <Tooltip
              title={
                (!isBlocked ? "Block " : "Un-Block ") + form.roleName + " Role"
              }
            >
              <Button
                size="small"
                color="secondary"
                onClick={handleStatusToggle}
                variant="outlined" // or "contained", "text"
                startIcon={
                  !isBlocked ? (
                    <LockOutlinedIcon color="error" sx={{ mr: 0.5 }} />
                  ) : (
                    <LockOpenIcon color="success" sx={{ mr: 0.5 }} />
                  )
                }
                sx={{ align: "center", height: "100%" }}
              >
                {!isBlocked ? "BLOCK" : "UN-BLOCK"}
              </Button>
            </Tooltip>
          )}
        </Box>
      </DialogTitle>

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 2.5 }}>
          {/* Row 1: Role details */}
          <Grid container spacing={2}>
            <Grid item xs={12} md={4} sx={{ width: "27%" }}>
              <TextField
                label="Role Name *"
                value={form.roleName || ""}
                onChange={(e) =>
                  handleChange(form, "roleName", e, "inputValue")
                }
                fullWidth
              />
            </Grid>
            <Grid item xs={12} md={8} sx={{ width: "70%" }}>
              <TextField
                label="Description *"
                value={form.description || ""}
                onChange={(e) =>
                  handleChange(form, "description", e, "certainSpecialChars")
                }
                fullWidth
              />
            </Grid>
          </Grid>

          <Divider sx={{ my: 1 }} />

          {/* Row 2: Permission autocomplete */}
          <Autocomplete
            multiple
            options={allPermissions}
            disableCloseOnSelect
            getOptionLabel={(option) => option.title}
            value={selectedPermissions}
            onChange={handlePermissionsSelect}
            isOptionEqualToValue={(opt, val) => opt.id === val.id}
            renderOption={(props, option, { selected }) => (
              <li {...props} key={option.id}>
                <Checkbox checked={selected} sx={{ mr: 1 }} />
                <ListItemIcon sx={{ minWidth: 32 }}>
                  {renderIcon(option.icon)}
                </ListItemIcon>
                {option.title}
              </li>
            )}
            renderInput={(params) => (
              <TextField {...params} label="Role Permissions" fullWidth />
            )}
            renderTags={() => null}
          />

          {/* Row 3: Permission order (DND) */}
          <Stack spacing={1}>
            <Stack
              direction="row"
              justifyContent="space-between"
              alignItems="center"
            >
              <Typography variant="subtitle2">
                Allowed Permissions: {selectedPermissions.length}
              </Typography>
              <Tooltip title="Reset Permissions">
                <Button
                  size="small"
                  color="secondary"
                  onClick={handleReset}
                  variant="outlined" // or "contained", "text"
                  startIcon={<RestoreIcon />}
                  sx={{ align: "center", height: "100%" }}
                >
                  Reset
                </Button>
              </Tooltip>
            </Stack>
            <DndProvider backend={HTML5Backend}>
              <List sx={{ minHeight: 400, overflowY: "auto" }}>
                {selectedPermissions.map((perm, index) => (
                  <DraggablePermissionItem
                    key={perm.id}
                    id={perm.id}
                    index={index}
                    title={`${perm.order}. ${perm.title}`}
                    icon={renderIcon(perm.icon)}
                    moveItem={moveItem}
                  />
                ))}
              </List>
            </DndProvider>
          </Stack>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" disabled={!canSave} onClick={handleSave}>
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
import React, { useState, useEffect } from "react";
import {
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Button,
  Stack,
  Tooltip,
  IconButton,
  Chip,
  CircularProgress,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import RequestAnalytics from "../../common/RequestAnalytics";
import { toPascalKebabCase } from "../../../utils/CommonUtilities";

export default function RoleApprovals() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [remarks, setRemarks] = useState("");
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  const fetchData = async () => {
    try {
      const response = await callApi(
        "/UM/role/pending-role-requests",
        {},
        "GET"
      );
      const result = response?.result?.pendingRequests || [];
      const processedResult = result.map((row) => {
        const parsed = JSON.parse(row.requestPayload) || {};
        return {
          ...row,
          ...parsed,
          changeType: row.requestType === "CREATE" ? "ADD" : row.requestType,
          reqDate: row.requestDate,
        };
      });
      setRows(processedResult);
    } catch (err) {
      console.error(err);
      showSnackBar("Error fetching data", "error");
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleConfirm = async () => {
    if (confirmDialog.type === "reject" && !remarks.trim()) {
      showSnackBar("Please provide remarks before rejecting", "warning");
      return;
    }

    try {
      const payload = {
        requestId: confirmDialog.rowId,
        actionFlag: confirmDialog.type,
        remarks: confirmDialog.type === "REJECT" ? remarks.trim() : "NA",
      };

      const res = await callApi(
        "/UM/role/role-request-action",
        payload,
        "POST"
      );

      if (res?.result?.status) {
        showSnackBar(res?.result?.message, "success");
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch (err) {
      console.error(err);
      showSnackBar("Error while processing request", "error");
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) =>
    setConfirmDialog({ open: true, type, rowId });

  const closeConfirmDialog = () => {
    setRemarks("");
    setConfirmDialog({ open: false, type: null, rowId: null });
  };

  const columns = [
    { field: "roleName", headerName: "Role Name", flex: 0.5 },
    { field: "description", headerName: "Role Name", flex: 1.2 },
    {
      field: "requestType",
      headerName: "Change Type",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const val = params.value;
        const color =
          val === "CREATE" ? "success" : val === "DELETE" ? "error" : "warning";
        const icon =
          val === "CREATE" ? (
            <AddBoxIcon />
          ) : val === "DELETE" ? (
            <AutoDeleteIcon />
          ) : (
            <EditDocumentIcon />
          );
        return (
          <Chip
            icon={icon}
            label={toPascalKebabCase(val)}
            color={color}
            size="small"
          />
        );
      },
    },
    {
      field: "requestorUserId",
      headerName: "Requestor ID",
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Chip
          icon={<AccountCircleIcon />}
          label={params.value}
          size="small"
          color="info"
        />
      ),
    },
    {
      field: "requestDate",
      headerName: "Requested Date",
      flex: 1,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const isoString = params.value;
        if (!isoString) return null;
        let formattedDate = isoString;
        try {
          const date = new Date(isoString);
          formattedDate = date.toLocaleString("en-IN", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
            timeZone: "Asia/Kolkata",
          });
        } catch (error) {
          console.error("Error formatting date:", error);
        }

        return (
          <Typography variant="body1" component="span">
            {formattedDate}
          </Typography>
        );
      },
    },
    {
      field: "actions",
      headerName: "Actions",
      flex: 0.6,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Stack direction="row" spacing={1} justifyContent="center">
          <Tooltip title="Approve">
            <IconButton
              onClick={() => openConfirmDialog("ACCEPT", params.row.requestId)}
              color="success"
            >
              <CheckIcon />
            </IconButton>
          </Tooltip>
          <Tooltip title="Reject">
            <IconButton
              onClick={() => openConfirmDialog("REJECT", params.row.requestId)}
              color="error"
            >
              <ClearIcon />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  const CustomNoRowsOverlay = () => {
    return (
      <Box
        sx={{
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          height: "100%",
        }}
      >
        <Typography variant="body1" color="textSecondary">
          No pending requests
        </Typography>
      </Box>
    );
  };

  return (
    <Box sx={{ p: 2 }}>
      <Box>
        <RequestAnalytics data={rows} />
        <DataGrid
          rows={rows}
          columns={columns}
          disableRowSelectionOnClick
          pageSizeOptions={[5, 10, 25, 50]}
          initialState={{
            pagination: { paginationModel: { pageSize: 5, page: 0 } },
            sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
          }}
          getRowId={(row) => row.requestId}
          sx={{
            minHeight: 350,
            "& .MuiDataGrid-cell:focus": { outline: "none" },
          }}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
        />
      </Box>

      <Dialog
        open={confirmDialog.open}
        onClose={closeConfirmDialog}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>
          {confirmDialog.type === "ACCEPT"
            ? "Confirm Approval"
            : "Confirm Rejection"}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Please enter remarks."}
          </Typography>
          {confirmDialog.type === "REJECT" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={closeConfirmDialog} variant="outlined">
            Cancel
          </Button>
          <Button
            onClick={handleConfirm}
            color={confirmDialog.type === "ACCEPT" ? "success" : "error"}
            variant="contained"
          >
            {confirmDialog.type === "ACCEPT" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
