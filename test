        },
      },
      {
        field: "inrBalance",
        headerName: "INR Balance",
        flex: 1,
        minWidth: 180,
        headerAlign: "right",
        align: "right",
        sortable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          const isNegative = val < 0;
          const type = isNegative ? "Dr" : "Cr";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            minimumFractionDigits: 2,
          }).format(Math.abs(val || 0));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
                // pr: 2, // Right padding for better spacing
              }}
            >
              {/* Amount with dynamic color */}
              <Typography
                variant="body2"
                fontWeight="600"
                sx={{
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  mr: 1,
                }}
              >
                {formattedAmount}
              </Typography>

              {/* Type as a small, subtle chip */}
              <CustomChip
                label={type}
                size="small"
                sx={{
                  height: 20,
                  fontSize: "0.7rem",
                  fontWeight: "700",
                  bgcolor: isNegative
                    ? "rgba(211, 47, 47, 0.08)"
                    : "rgba(46, 125, 50, 0.08)",
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  border: `1px solid ${isNegative ? "rgba(211, 47, 47, 0.2)" : "rgba(46, 125, 50, 0.2)"}`,
                }}
              />
            </Box>
          );
        },
      },
    ],
    [branchOptions, selectedCircle, circleOptions, selectedCgl],
  );

  const balanceColumns =
    enquiryType === "CONSOLIDATED" ? consolidatedColumns : collationColumns;

  const columnVisibilityModel = useMemo(
    () => ({
      branchName: false,
      circleName: false,
      ...(isMobile && {
        narration: false,
        circleCode: false,
        inrBalance: false, // Optional: Hiding INR balance on very small screens saves horizontal scroll space
      }),
      ...(isTablet && {
        narration: false,
      }),
    }),
    [isMobile, isTablet],
  );

  const CustomNoRowsOverlay = () => (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        justifyContent: "center",
        alignItems: "center",
        p: 2,
        textAlign: "center",
      }}
    >
      <ErrorOutlineIcon fontSize="large" color="action" />
      <Typography
        variant="h6"
        fontSize={{ xs: "1rem", sm: "1.2rem" }}
        color="text.secondary"
        mt={1}
      >
        No balances available for the selected criteria
      </Typography>
    </Box>
  );

  return (
    <Box
      sx={{
        width: "100%",
        height: "100%",
        mt: { xs: 2, sm: 3 },
        boxSizing: "border-box",
      }}
    >
      <Box
        sx={{
          p: { xs: 1.5, sm: 2.5 },
          mb: { xs: 2, sm: 3 },
          borderRadius: { xs: "12px", sm: "20px" },
          background: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255, 255, 255, 0.3)",
          boxShadow: "0 8px 32px rgba(0,0,0,0.05)",
          display: "flex",
          flexDirection: "column",
          gap: { xs: 1.5, sm: 2.5 },
        }}
      >
        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={2}
          justifyContent="space-between"
          alignItems={{ xs: "stretch", sm: "center" }}
        >
          <Box
            sx={{
              display: "flex",
              flexDirection: { xs: "column", sm: "row" },
              alignItems: { xs: "flex-start", sm: "baseline" },
              gap: { xs: 1, sm: 1.5 },
            }}
          >
            <Typography
              variant="h6"
              fontWeight={800}
              sx={{
                color: "#1a1a1a",
                letterSpacing: "-0.5px",
                fontSize: { xs: "1.1rem", sm: "1.25rem" },
              }}
            >
              Balance Ledger
            </Typography>

            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString("en-IN")} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
                width: { xs: "fit-content", sm: "auto" },
              }}
            />
          </Box>
          <Button
            variant="contained"
            size={isMobile ? "medium" : "small"}
            startIcon={
              exporting ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={!rowCount || loading || exporting}
            sx={{
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              width: { xs: "100%", sm: "auto" }, // Expands completely on mobile
              "&:hover": { bgcolor: "#45357a" },
            }}
          >
            {exporting ? "Preparing..." : "Export"}
          </Button>
        </Stack>

        <Box
          sx={{
            width: "100%",
            overflowX: "auto",
            height: {
              xs: "55vh",
              sm: "65vh",
              md: 600,
            },
          }}
        >
          <DataGrid
            rows={rows}
            columns={balanceColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) => row.id}
            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"
            pageSizeOptions={[10, 20, 50, 100]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            sortModel={sortModel}
            onSortModelChange={setSortModel}
            filterModel={filterModel}
            onFilterModelChange={setFilterModel}
            rowHeight={50}
            disableRowSelectionOnClick
            slots={{ noRowsOverlay: CustomNoRowsOverlay }}
            initialState={{
              columns: {
                columnVisibilityModel,
              },
            }}
            sx={{
              borderRadius: { xs: "12px", sm: "20px" },
              backgroundColor: "rgba(255,255,255,0.4)",
              border: "1px solid rgba(255,255,255,0.3)",
              "& .MuiDataGrid-columnHeaders": {
                bgcolor: "#f8f9fa",
                fontWeight: 700,
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default BalanceLedgerDataGrid;
