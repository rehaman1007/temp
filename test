while (rs.next()) {

    Map<String, Object> row =
            new HashMap<>();

    for (
            int i = 1;
            i <= columnCount;
            i++
    ) {

        String columnName =
                meta.getColumnLabel(i);

        int columnType =
                meta.getColumnType(i);

        Object value = null;

        switch (columnType) {

            /**
             * STRING TYPES
             */
            case java.sql.Types.VARCHAR:

            case java.sql.Types.CHAR:

            case java.sql.Types.LONGVARCHAR:

            case java.sql.Types.NVARCHAR:

            case java.sql.Types.NCHAR:

                value =
                        rs.getString(i);

                break;

            /**
             * INTEGER
             */
            case java.sql.Types.INTEGER:

            case java.sql.Types.SMALLINT:

            case java.sql.Types.TINYINT:

                int intVal =
                        rs.getInt(i);

                value =
                        rs.wasNull()
                                ? null
                                : intVal;

                break;

            /**
             * BIGINT
             */
            case java.sql.Types.BIGINT:

                long longVal =
                        rs.getLong(i);

                value =
                        rs.wasNull()
                                ? null
                                : longVal;

                break;

            /**
             * DECIMAL
             */
            case java.sql.Types.NUMERIC:

            case java.sql.Types.DECIMAL:

                value =
                        rs.getBigDecimal(i);

                break;

            /**
             * DOUBLE
             */
            case java.sql.Types.FLOAT:

            case java.sql.Types.DOUBLE:

            case java.sql.Types.REAL:

                double dbl =
                        rs.getDouble(i);

                value =
                        rs.wasNull()
                                ? null
                                : dbl;

                break;

            /**
             * BOOLEAN
             */
            case java.sql.Types.BOOLEAN:

            case java.sql.Types.BIT:

                boolean bool =
                        rs.getBoolean(i);

                value =
                        rs.wasNull()
                                ? null
                                : bool;

                break;

            /**
             * DATE
             */
            case java.sql.Types.DATE:

                java.sql.Date date =
                        rs.getDate(i);

                value =
                        date != null
                                ? date.toLocalDate()
                                .toString()
                                : null;

                break;

            /**
             * TIME
             */
            case java.sql.Types.TIME:

                java.sql.Time time =
                        rs.getTime(i);

                value =
                        time != null
                                ? time.toLocalTime()
                                .toString()
                                : null;

                break;

            /**
             * TIMESTAMP
             */
            case java.sql.Types.TIMESTAMP:

            case -101: // Oracle TIMESTAMP WITH TIMEZONE

                java.sql.Timestamp ts =
                        rs.getTimestamp(i);

                value =
                        ts != null
                                ? ts.toLocalDateTime()
                                    .format(
                                            java.time.format.DateTimeFormatter.ofPattern(
                                                    "dd-MM-yyyy HH:mm:ss"
                                            )
                                    )
                                : null;

                break;

            /**
             * CLOB
             */
            case java.sql.Types.CLOB:

            case java.sql.Types.NCLOB:

                java.sql.Clob clob =
                        rs.getClob(i);

                value =
                        clob != null
                                ? clob.getSubString(
                                        1,
                                        (int) clob.length()
                                )
                                : null;

                break;

            /**
             * BLOB
             */
            case java.sql.Types.BLOB:

            case java.sql.Types.BINARY:

            case java.sql.Types.VARBINARY:

            case java.sql.Types.LONGVARBINARY:

                value = "[BLOB DATA]";

                break;

            /**
             * SQLXML
             */
            case java.sql.Types.SQLXML:

                java.sql.SQLXML sqlxml =
                        rs.getSQLXML(i);

                value =
                        sqlxml != null
                                ? sqlxml.getString()
                                : null;

                break;

            /**
             * DEFAULT SAFE HANDLER
             */
            default:

                Object obj =
                        rs.getObject(i);

                if (obj == null) {

                    value = null;

                } else {

                    /**
                     * LAST RESORT:
                     * convert everything to string
                     */
                    value =
                            obj.toString();
                }
        }

        row.put(columnName, value);
    }

    rows.add(row);
}