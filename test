SELECT
    id,
    process_id,
    process_type,
    process_stage,
    start_time,
    end_time,
    status,
    execution_remarks,
    triggered_by,
    etl_date,
    difference_summary,
    airflow_run_id,
    dag_id
FROM
    process_status;
    
SELECT PROCESS_ID, PROCESS_NAME, PROCESS_DAG_ID, PROCESS_FLAG, PROCESS_DESCRIPTION FROM PROCESS_MASTER;
SELECT STAGE_ID, TITLE, ICON FROM PROCESS_STAGE_MASTER;
SELECT PROCESS_RUN_ID, PROCESS_ID, ETL_DATE, RUN_ID, STATUS, START_TIME, END_TIME, TRIGGERED_BY, AIRFLOW_RUN_ID, REMARKS, EXECUTION_REMARKS FROM PROCESS_RUN;
SELECT PROCESS_RUN_STAGE_ID, PROCESS_RUN_ID, STAGE_ID, PARENT_STAGE_ID, STATUS, SOURCE, REMARKS, SUMMARY, START_TIME, END_TIME FROM PROCESS_RUN_STAGE;

SELECT * FROM PROCESS_RUN_STAGE prs LEFT JOIN  PROCESS_RUN pr ON pr.PROCESS_RUN_ID = prs.PROCESS_RUN_ID;



