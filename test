SELECT
 r.RUN_ID,
 pm.PROCESS_TYPE,
 sm.STAGE_ID,
 sm.TITLE,
 sm.ICON,
 s.STATUS,
 s.START_TIME,
 s.END_TIME,
 s.EXECUTION_REMARKS
FROM FINCORE.PROCESS_RUN r
JOIN FINCORE.PROCESS_MASTER pm
  ON pm.PROCESS_ID = r.PROCESS_ID
JOIN FINCORE.PROCESS_RUN_STAGE s
  ON s.RUN_ID = r.RUN_ID
JOIN FINCORE.PROCESS_STAGE_MASTER sm
  ON sm.STAGE_ID = s.STAGE_ID
WHERE r.RUN_ID = 1
ORDER BY sm.STAGE_ID;

SELECT *
FROM (
   SELECT r.*,
          ROW_NUMBER() OVER
          (PARTITION BY PROCESS_ID ORDER BY RUN_ID DESC) rn
   FROM FINCORE.PROCESS_RUN r
)
WHERE rn = 1;

