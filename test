import { memo, useCallback } from "react";
import {
  Box,
  Typography,
  IconButton,
  TextField,
  FormControlLabel,
  Checkbox,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
} from "@mui/material";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import DeleteIcon from "@mui/icons-material/Delete";
import FormatAlignLeftIcon from "@mui/icons-material/FormatAlignLeft";
import FormatAlignCenterIcon from "@mui/icons-material/FormatAlignCenter";
import FormatAlignRightIcon from "@mui/icons-material/FormatAlignRight";
import { useDebouncedInput } from "../../hooks/useDebouncedInput";

export const ColumnItem = memo(
  ({ col, isEditing, onToggleEdit, onRemove, onUpdate }) => {
    const handleNameUpdate = useCallback(
      (value) => onUpdate("name", value),
      [onUpdate],
    );

    const [debouncedName, setDebouncedName] = useDebouncedInput(
      col.name || "",
      handleNameUpdate,
      200,
    );

    return (
      <Box sx={{ mb: 1, p: 1, border: "1px solid #e0e0e0", borderRadius: 1 }}>
        <Box sx={{ display: "flex", justifyContent: "space-between" }}>
          <Typography variant="caption">{col.id}</Typography>
          <Box>
            <IconButton size="small" onClick={onToggleEdit}>
              <ExpandMoreIcon
                fontSize="small"
                sx={{ transform: isEditing ? "rotate(180deg)" : "none" }}
              />
            </IconButton>
            <IconButton size="small" onClick={onRemove}>
              <DeleteIcon fontSize="small" />
            </IconButton>
          </Box>
        </Box>

        {isEditing && (
          <TextField
            size="small"
            fullWidth
            label="Column Name"
            value={debouncedName}
            onChange={(e) => setDebouncedName(e.target.value)}
          />
        )}
      </Box>
    );
  },
);

ColumnItem.displayName = "ColumnItem";

import { Box, Button, List, Typography } from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import ViewColumnIcon from "@mui/icons-material/ViewColumn";
import Accordion from "@mui/material/Accordion";
import AccordionSummary from "@mui/material/AccordionSummary";
import AccordionDetails from "@mui/material/AccordionDetails";
import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import { ColumnItem } from "./ColumnItem";

export const ColumnsPanel = ({
  expanded,
  onToggle,
  columns,
  editingColumn,
  setEditingColumn,
  onAddColumn,
  onRemoveColumn,
  onUpdateColumn,
}) => {
  return (
    <Accordion expanded={expanded} onChange={onToggle}>
      <AccordionSummary expandIcon={<ExpandMoreIcon />}>
        <ViewColumnIcon sx={{ mr: 1 }} />
        <Typography>Columns ({columns.length})</Typography>
      </AccordionSummary>

      <AccordionDetails>
        <Button
          fullWidth
          size="small"
          startIcon={<AddIcon />}
          onClick={onAddColumn}
        >
          Add Column
        </Button>

        <List dense>
          {columns.map((col, i) => (
            <ColumnItem
              key={col.id}
              col={col}
              isEditing={editingColumn === i}
              onToggleEdit={() =>
                setEditingColumn(editingColumn === i ? null : i)
              }
              onRemove={() => onRemoveColumn(col.id, i)}
              onUpdate={(field, val) =>
                onUpdateColumn(i, field, val)
              }
            />
          ))}
        </List>
      </AccordionDetails>
    </Accordion>
  );
};

