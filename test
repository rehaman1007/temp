            {col.format?.type === "number" && (
              <>
                <TextField
                  label="Decimals"
                  type="number"
                  size="small"
                  value={col.format?.decimals ?? 0}
                  onChange={(e) =>
                    onUpdate("format.decimals", parseInt(e.target.value))
