import React, { useMemo, forwardRef } from "react";
import {
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
} from "@mui/material";

/* ================= FORMAT ================= */

const formatAmount = (num) =>
  typeof num === "number"
    ? num.toLocaleString("en-IN")
    : num || "—";

/* ================= SAMPLE DEFAULT DATA ================= */

const DEFAULT_DATA = {
  BALANCE: [
    {
      HEAD: "Assets",
      Total_no_of_entries: 120,
      "new entry": 10,
    },
    {
      HEAD: "Liabilities",
      Total_no_of_entries: 80,
      "new entry": 5,
    },
    {
      HEAD: "Income",
      Total_no_of_entries: 50,
      "new entry": 2,
    },
  ],

  SIBA: [
    {
      CGL: "CGL001",
      CURRENCY: "INR",
      AMOUNT: 125000.5,
    },
    {
      CGL: "CGL002",
      CURRENCY: "USD",
      AMOUNT: 8450.75,
    },
    {
      CGL: "CGL003",
      CURRENCY: "EUR",
      AMOUNT: 9200.0,
    },
  ],

  SUSPENSE: [
    {
      CGL: "CGL101",
      CURRENCY: "INR",
      COUNT: 15,
    },
    {
      CGL: "CGL102",
      CURRENCY: "USD",
      COUNT: 8,
    },
    {
      CGL: "CGL103",
      CURRENCY: "EUR",
      COUNT: 3,
    },
  ],
};

/* ================= TABLE CONFIG ================= */

const TABLE_CONFIG = {
  BALANCE: {
    columns: [
      { field: "HEAD", label: "HEAD", align: "left" },
      {
        field: "Total_no_of_entries",
        label: "TOTAL ENTRIES",
        align: "right",
      },
      {
        field: "new entry",
        label: "NEW ENTRIES",
        align: "right",
      },
    ],
    totalFields: ["Total_no_of_entries", "new entry"],
  },

  SIBA: {
    columns: [
      { field: "CGL", label: "CGL", align: "left" },
      { field: "CURRENCY", label: "CURRENCY", align: "left" },
      { field: "AMOUNT", label: "AMOUNT", align: "right" },
    ],
    totalFields: ["AMOUNT"],
  },

  SUSPENSE: {
    columns: [
      { field: "CGL", label: "CGL", align: "left" },
      { field: "CURRENCY", label: "CURRENCY", align: "left" },
      { field: "COUNT", label: "COUNT", align: "right" },
    ],
    totalFields: ["COUNT"],
  },
};

/* ================= COMPONENT ================= */

const DynamicSummaryTable = forwardRef(
  ({ summaryType = "BALANCE", data }, ref) => {
    /* ================= USE DEFAULT DATA IF EMPTY ================= */

    const safeData = useMemo(() => {
      if (!data || data.length === 0) {
        return DEFAULT_DATA[summaryType] || [];
      }
      return data;
    }, [data, summaryType]);

    /* ================= GET CONFIG ================= */

    const config =
      TABLE_CONFIG[summaryType] || {
        columns: [],
        totalFields: [],
      };

    /* ================= TOTAL CALCULATION ================= */

    const totals = useMemo(() => {
      const result = {};

      config.totalFields.forEach((field) => {
        result[field] = safeData.reduce(
          (sum, row) =>
            sum + (Number(row[field]) || 0),
          0,
        );
      });

      return result;
    }, [safeData, config]);

    /* ================= EMPTY CHECK ================= */

    if (!config.columns.length) {
      return (
        <Box p={2}>
          <Typography color="text.secondary">
            No table configuration found
          </Typography>
        </Box>
      );
    }

    /* ================= RENDER ================= */

    return (
      <TableContainer component={Paper} ref={ref}>
        <Table size="small">
          {/* HEADER */}

          <TableHead>
            <TableRow>
              {config.columns.map((col) => (
                <TableCell
                  key={col.field}
                  align={col.align}
                  sx={{ fontWeight: 700 }}
                >
                  {col.label}
                </TableCell>
              ))}
            </TableRow>
          </TableHead>

          {/* BODY */}

          <TableBody>
            {safeData.map((row, index) => (
              <TableRow key={index}>
                {config.columns.map((col) => (
                  <TableCell
                    key={col.field}
                    align={col.align}
                  >
                    {col.align === "right"
                      ? formatAmount(
                          row[col.field],
                        )
                      : row[col.field] || "—"}
                  </TableCell>
                ))}
              </TableRow>
            ))}

            {/* TOTAL ROW */}

            {config.totalFields.length > 0 && (
              <TableRow sx={{ bgcolor: "#f5f5f5" }}>
                {config.columns.map(
                  (col, index) => {
                    if (index === 0)
                      return (
                        <TableCell key={col.field}>
                          <b>TOTAL</b>
                        </TableCell>
                      );

                    if (
                      totals[col.field] !==
                      undefined
                    )
                      return (
                        <TableCell
                          key={col.field}
                          align="right"
                        >
                          <b>
                            {formatAmount(
                              totals[col.field],
                            )}
                          </b>
                        </TableCell>
                      );

                    return (
                      <TableCell
                        key={col.field}
                      />
                    );
                  },
                )}
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>
    );
  },
);

export default DynamicSummaryTable;

<DynamicSummaryTable
  summaryType={summaryType}
  data={activeSummary}
/>