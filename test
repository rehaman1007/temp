import { DataGrid } from "@mui/x-data-grid";
import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import InfoIcon from "@mui/icons-material/Info";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";
import TableRowsIcon from "@mui/icons-material/TableRows";
import MemoryIcon from "@mui/icons-material/Memory";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import ApprovalIcon from "@mui/icons-material/Approval";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import AdsClickIcon from "@mui/icons-material/AdsClick";

import { StageStatus } from "../util/StageStatus";
import ProcessStatusChip from "./ProcessStatusChip";
import { useMemo } from "react";
import { timeStampFormatter } from "../../../utils/CommonUtilities";
import CustomChip from "../../../utils/CustomChip";
import { getIconComponent } from "../../../utils/IconUtils";

/* ================= MAIN COMPONENT ================= */

const ProcessStatusTable = ({
  processes = [],
  actions,
  loading,
  permissions = {},
}) => {
  const SUMMARY_STAGES = new Set([
    "CNTR_Report_generated",
    "INTR_Report_generated",
    "balance_Compare_generated",
  ]);

  const rows = processes.map((p) => {
    const lastStage = p.stages.at(-1);

    // Use .some() with the Set for a cleaner, more scalable check
    const hasSummary =
      p.processType?.toUpperCase() === "DIFFERENCE" &&
      p.stages.some(
        (s) =>
          s.stageStatus === StageStatus.COMPLETED &&
          SUMMARY_STAGES.has(s.stageId),
      );

    return {
      processId: p.processId,
      processRunId: p.processRunId,
      processType: p.processType,
      runId: p.runId,
      status: p.status,
      stageTitle: lastStage?.stageTitle ?? "N/A", // Nullish coalescing
      stageIcon: lastStage?.stageIcon,
      startTime: p.processStartTime,
      endTime: p.processEndTime,
      raw: p,
      hasSummary,
    };
  });

  const columns = useMemo(
    () => [
      // {
      //   field: "processRunId",
      //   headerName: "ID",
      //   flex: 0.4,
      // },
      // {
      //   field: "processId",
      //   headerName: "ID",
      //   flex: 0.4,
      // },

      {
        field: "processId",
        flex: 0.4,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <TableRowsIcon sx={{}} />
            <Typography variant="subtitle1">ID</Typography>
          </Box>
        ),
      },
      {
        field: "processType",
        headerName: "Process Name",
        flex: 1,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <MemoryIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Process Name</Typography>
          </Box>
        ),
      },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AnalyticsIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Status</Typography>
          </Box>
        ),
        renderCell: (p) => <ProcessStatusChip status={p.value} />,
      },
      {
        field: "stageTitle",
        headerName: "Stage",
        flex: 1.2,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <ApprovalIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Stage</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const x = params.row?.stageIcon;
          const Icon = getIconComponent(x);
          return (
            <CustomChip
              label={params.row?.stageTitle}
              icon={<Icon />}
              variant="outlined"
            />
          );
        },
      },
      {
        field: "startTime",
        headerName: "Started",
        flex: 1,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Started</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography
            variant="body1"
            component="span"
            sx={{
              fontSize: "0.9rem",
            }}
          >
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },
      {
        field: "endTime",
        headerName: "Ended",
        flex: 1,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Ended</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography
            variant="body1"
            component="span"
            sx={{
              fontSize: "0.9rem",
            }}
          >
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.8,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AdsClickIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Actions</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const row = params.row.raw;
          const showRestart = row?.status !== StageStatus.STARTED;
          const showStop = row?.status === StageStatus.STARTED;

          return (
            <Stack
              direction="row"
              spacing={1}
              alignItems="center"
              justifyContent="center"
              sx={{ height: "100%" }}
            >
              {(permissions.restart || permissions.start) && showRestart && (
                <Tooltip title="Restart">
                  <IconButton size="small" onClick={() => actions.onStart(row)}>
                    <RestartAltIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.stop && showStop && (
                <Tooltip title="Stop">
                  <IconButton size="small" onClick={() => actions.onStop(row)}>
                    <StopIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view && (
                <Tooltip title="View">
                  <IconButton size="small" onClick={() => actions.onView(row)}>
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view && params.row.hasSummary && (
                <Tooltip title="Summary">
                  <IconButton
                    size="small"
                    onClick={() => actions.onSummary(row)}
                  >
                    <SummarizeOutlinedIcon />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [
      actions,
      permissions.restart,
      permissions.start,
      permissions.stop,
      permissions.view,
    ],
  );

  const filteredColumns = useMemo(() => {
    if (
      permissions.start ||
      permissions.stop ||
      permissions.restart ||
      permissions.view
    ) {
      return columns;
    }
    return columns.filter((c) => c.field !== "actions");
  }, [columns, permissions]);

  return (
    <Box
      sx={{
        height: 372,
        "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#b4a7d6",
          fontWeight: 600,
        },
        "& .MuiDataGrid-row:hover": {
          backgroundColor: "action.hover",
        },
      }}
    >
      <DataGrid
        rows={rows}
        columns={filteredColumns}
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: {
            paginationModel: {
              pageSize: 5,
              page: 0,
            },
          },
        }}
        loading={loading}
        getRowId={(p) =>
          `${p.processType}_${p.processRunId || ""}_${p.processId || ""}_${p.dagId || ""}`
        }
        disableRowSelectionOnClick
        slots={{
          noRowsOverlay: () => (
            <Stack height="100%" alignItems="center" justifyContent="center">
              <InfoIcon
                sx={{
                  fontSize: 48,
                  color: "text.secondary",
                  mb: 1,
                }}
              />
              <Typography variant="h6">No processes available</Typography>
              <Typography variant="body2">
                Processes not found for the ETL date.
              </Typography>
            </Stack>
          ),
        }}
      />
    </Box>
  );
};

export default ProcessStatusTable;
