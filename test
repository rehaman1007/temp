import React, {
  createContext,
  useEffect,
  useRef,
  useCallback,
  useState,
} from "react";
import { useDispatch, useSelector } from "react-redux";
import SessionDialog from "../components/SessionDialog";
import SessionWarningDialog from "../components/SessionWarningDialog";
import { setUser, clearAuth } from "../store/slices/authSlice";

export const AuthContext = createContext();

/** ===== DEBUG SHORT TIMES ===== */
const INACTIVITY_TIMEOUT = 60 * 1000; // 1 min
const WARNING_TIME = 30 * 1000;

export const AuthProvider = ({ children }) => {
  const dispatch = useDispatch();

  /** ---------- USER SOURCE ---------- */
  const reduxUser = useSelector((state) => state.auth.user);
  const sessionUser = sessionStorage.getItem("user");
  const user = reduxUser || (sessionUser && JSON.parse(sessionUser));

  /** ---------- UI STATE ---------- */
  const [dialogOpen, setDialogOpen] = useState(false);
  const [warningOpen, setWarningOpen] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(30);
  const [sessionError, setSessionError] = useState("");

  /** ---------- REFS ---------- */
  const inactivityTimerRef = useRef(null);
  const warningTimerRef = useRef(null);
  const countdownRef = useRef(null);
  const sessionInvalidatedRef = useRef(false);

  /* -------------------- INIT -------------------- */
  useEffect(() => {
    console.log("🟢 AuthProvider mounted");

    if (!reduxUser && sessionUser) {
      console.log("📦 Restoring user from sessionStorage");
      dispatch(setUser(JSON.parse(sessionUser)));
    }
  }, []);

  /* -------------------- LOGOUT -------------------- */
  const logout = useCallback(() => {
    console.log("🔴 LOGOUT");

    sessionStorage.clear();
    dispatch(clearAuth());

    setDialogOpen(false);
    setWarningOpen(false);
    sessionInvalidatedRef.current = false;

    sessionStorage.setItem("LOGOUT_EVENT", Date.now());
    window.location.href = "/";
  }, [dispatch]);

  /* -------------------- SESSION INVALID -------------------- */
  const triggerSessionDialog = useCallback((reason) => {
    if (sessionInvalidatedRef.current) {
      console.log("⚠️ Session already invalidated");
      return;
    }

    console.log("⛔ SESSION INVALIDATED:", reason);
    sessionInvalidatedRef.current = true;

    setSessionError(reason);
    setDialogOpen(true);
  }, []);

  /* -------------------- START / RESET TIMERS -------------------- */
  const startInactivityTimers = useCallback(() => {
    if (!user) {
      console.log("⚠️ No user → timers not started");
      return;
    }

    console.log("⏱️ STARTING INACTIVITY TIMERS");

    clearTimeout(inactivityTimerRef.current);
    clearTimeout(warningTimerRef.current);
    clearInterval(countdownRef.current);

    setWarningOpen(false);
    setSecondsLeft(30);

    /** ---- Warning Timer ---- */
    warningTimerRef.current = setTimeout(() => {
      console.log("⚠️ WARNING TIMER FIRED");

      setWarningOpen(true);
      let counter = 30;
      setSecondsLeft(counter);

      countdownRef.current = setInterval(() => {
        counter -= 1;
        console.log("⏳ Countdown:", counter);
        setSecondsLeft(counter);
      }, 1000);
    }, INACTIVITY_TIMEOUT - WARNING_TIME);

    /** ---- Logout Timer ---- */
    inactivityTimerRef.current = setTimeout(() => {
      console.log("⛔ INACTIVITY TIMEOUT FIRED");
      triggerSessionDialog("SESSION_EXPIRED");
    }, INACTIVITY_TIMEOUT);
  }, [user, triggerSessionDialog]);

  /* -------------------- START WHEN USER AVAILABLE -------------------- */
  useEffect(() => {
    console.log("👤 User resolved:", user);
    if (user) startInactivityTimers();
  }, [user, startInactivityTimers]);

  /* -------------------- USER ACTIVITY -------------------- */
  useEffect(() => {
    if (!user) return;

    const handleActivity = (e) => {
      console.log("🖱️ USER ACTIVITY:", e.type);
      startInactivityTimers();
      sessionStorage.setItem("LAST_ACTIVITY", Date.now());
    };

    const events = ["mousemove", "keydown", "click", "scroll", "touchstart"];
    events.forEach((e) => window.addEventListener(e, handleActivity));

    return () => {
      events.forEach((e) =>
        window.removeEventListener(e, handleActivity)
      );
    };
  }, [user, startInactivityTimers]);

  /* -------------------- MULTI TAB SYNC -------------------- */
  useEffect(() => {
    const handleStorage = (e) => {
      console.log("🪟 STORAGE EVENT:", e.key);

      if (e.key === "LAST_ACTIVITY") {
        console.log("🔄 Activity sync from another tab");
        startInactivityTimers();
      }

      if (e.key === "LOGOUT_EVENT") {
        console.log("🔴 Logout sync from another tab");
        logout();
      }
    };

    window.addEventListener("storage", handleStorage);
    return () => window.removeEventListener("storage", handleStorage);
  }, [logout, startInactivityTimers]);

  return (
    <AuthContext.Provider value={{ user, logout, triggerSessionDialog }}>
      {children}

      <SessionWarningDialog
        open={warningOpen}
        secondsLeft={secondsLeft}
        onContinue={startInactivityTimers}
      />

      <SessionDialog
        open={dialogOpen}
        reason={sessionError}
        onConfirm={logout}
      />
    </AuthContext.Provider>
  );
};