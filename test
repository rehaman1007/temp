import React, { useState, useEffect, useMemo, useCallback } from "react";
import {
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Button,
  Stack,
  Tooltip,
  IconButton,
  Divider,
} from "@mui/material";
import InfoIcon from "@mui/icons-material/Info";
import { DataGrid } from "@mui/x-data-grid";
import { Check, Clear, Visibility } from "@mui/icons-material";
import AddBoxIcon from "@mui/icons-material/AddBox";
import AutoDeleteIcon from "@mui/icons-material/AutoDelete";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import { useNavigate } from "react-router-dom";
import { useSelector } from "react-redux";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { COMMON_REQ_SCREEN_CONFIGS } from "../common/CommonConstants";
import CustomChip from "../../utils/CustomChip";
import RequestAnalytics from "./RequestAnalytics";
import ViewRequestDialog from "./ViewRequestDailog";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import { styles } from "./CommonRequestScreenStyles";
import LoadingOverlay from "../../utils/LoadingOverlay";

export default function CommonRequestScreen() {
  const selectedMenuItem = useSelector((s) => s.menus.selectedMenuItem);
  const requestType = selectedMenuItem?.requestType || "";
  const navigate = useNavigate();
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const screenConfig = COMMON_REQ_SCREEN_CONFIGS[selectedMenuItem?.id] || {};
  const { columns, transformData, processViewData } = screenConfig;

  const [rows, setRows] = useState([]);
  const [remarks, setRemarks] = useState("");
  const [loading, setLoading] = useState(false);
  const [dataGridLoading, setDataGridLoading] = useState(true);

  const [viewOpen, setViewOpen] = useState(false);
  const [viewData, setViewData] = useState(null);

  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  /* ---------------- FETCH DATA ---------------- */
  const fetchData = useCallback(async () => {
    if (!requestType) return;

    try {
      setDataGridLoading(true);
      const response = await callApi("/CR/pending-requests", { requestType }, "POST");
      const result = response?.data || [];

      const normalized = result.map((r) => ({
        ...r,
        ...(typeof r.payload === "object" ? r.payload : {}),
      }));

      setRows(transformData ? transformData(normalized) : normalized);
    } catch {
      showSnackBar("Error fetching data", "error");
    } finally {
      setDataGridLoading(false);
      setRemarks("");
      setConfirmDialog({ open: false, type: null, rowId: null });
    }
  }, [requestType, transformData, callApi, showSnackBar]);

  useEffect(() => {
    if (!screenConfig || !requestType) return;
    fetchData();
  }, [selectedMenuItem?.id, fetchData, screenConfig, requestType, navigate]);

  /* ---------------- CONFIRM ACTION ---------------- */
  const handleConfirm = async () => {
    const { type, rowId } = confirmDialog;

    if (type === "reject" && remarks.trim().length < 5) {
      showSnackBar("Please provide minimum 5 characters remarks", "warning");
      return;
    }

    setLoading(true);
    try {
      const payload = {
        requestId: rowId,
        status: type === "accept" ? "ACCEPTED" : "REJECTED",
        remarks: type === "reject" ? remarks.trim() : "No Remarks",
      };

      const res = await callApi("/CR/update-request", payload, "PATCH");

      if (res?.success || res) {
        showSnackBar(
          type === "accept" ? "Request Approved" : "Request Rejected",
          "success"
        );
        fetchData();
      } else {
        showSnackBar("Failed to process request", "error");
      }
    } catch {
      showSnackBar("Error while processing request", "error");
    } finally {
      setLoading(false);
      setConfirmDialog({ open: false, type: null, rowId: null });
    }
  };

  /* ---------------- VIEW ---------------- */
  const handleViewClick = (row) => {
    setViewData(processViewData ? processViewData(row) : row);
    setViewOpen(true);
  };

  /* ---------------- COLUMNS ---------------- */
  const allColumns = useMemo(() => [
    ...(columns || []),

    {
      field: "changeType",
      headerName: "Type",
      flex: 0.7,
      align: "center",
      headerAlign: "center",
      renderCell: ({ value }) => (
        <CustomChip
          size="small"
          variant="outlined"
          icon={
            value === "ADD" ? <AddBoxIcon /> :
            value === "DELETE" ? <AutoDeleteIcon /> :
            <EditDocumentIcon />
          }
          label={
            value === "ADD" ? "Added" :
            value === "DELETE" ? "Deleted" :
            "Modified"
          }
          color={
            value === "ADD" ? "success" :
            value === "DELETE" ? "error" :
            "warning"
          }
        />
      ),
    },

    {
      field: "creatorId",
      headerName: "Creator",
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: ({ value }) => (
        <CustomChip
          size="small"
          icon={<AccountCircleIcon />}
          label={value}
          color="info"
          variant="outlined"
        />
      ),
    },

    {
      field: "reqDate",
      headerName: "Date",
      flex: 1,
      align: "center",
      headerAlign: "center",
      renderCell: ({ value }) => (
        <Typography sx={styles.requestDate}>
          {timeStampFormatter(value)}
        </Typography>
      ),
    },

    {
      field: "actions",
      headerName: "Actions",
      flex: 0.8,
      align: "center",
      headerAlign: "center",
      renderCell: ({ row }) => (
        <Stack direction="row" spacing={1}>
          <Tooltip title="Approve">
            <IconButton
              color="success"
              onClick={() =>
                setConfirmDialog({ open: true, type: "accept", rowId: row.id })
              }
            >
              <Check />
            </IconButton>
          </Tooltip>

          <Tooltip title="Reject">
            <IconButton
              color="error"
              onClick={() =>
                setConfirmDialog({ open: true, type: "reject", rowId: row.id })
              }
            >
              <Clear />
            </IconButton>
          </Tooltip>

          <Tooltip title="View">
            <IconButton onClick={() => handleViewClick(row)}>
              <Visibility />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ], [columns]);

  const isApprove = confirmDialog.type === "accept";

  return (
    <Box sx={styles.container}>
      <RequestAnalytics data={rows} />

      <DataGrid
        rows={rows}
        columns={allColumns}
        loading={dataGridLoading}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 5 } },
          sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
        }}
        getRowId={(r) => r.id}
        sx={styles.dataGrid}
        slots={{
          noRowsOverlay: () => (
            <Stack height="100%" alignItems="center" justifyContent="center">
              <InfoIcon sx={{ fontSize: 48, mb: 2 }} />
              <Typography variant="h6">No Pending Requests</Typography>
              <Typography>
                All {selectedMenuItem?.title} are processed.
              </Typography>
            </Stack>
          ),
        }}
      />

      <ViewRequestDialog
        open={viewOpen}
        handleClose={() => setViewOpen(false)}
        data={viewData}
      />

      {/* CONFIRM DIALOG */}
      <Dialog
        open={confirmDialog.open}
        maxWidth="sm"
        fullWidth
        keepMounted={false}
        onClose={() =>
          setConfirmDialog({ open: false, type: null, rowId: null })
        }
      >
        <DialogTitle>
          {isApprove ? "Confirm Approval" : "Confirm Rejection"}
        </DialogTitle>
        <Divider />
        <DialogContent>
          <Typography>
            {isApprove
              ? "Are you sure you want to approve this request?"
              : "Please provide remarks to reject this request."}
          </Typography>

          {!isApprove && (
            <TextField
              fullWidth
              multiline
              rows={4}
              margin="dense"
              label="Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value)}
              helperText={
                remarks && remarks.length < 5
                  ? "Minimum 5 characters required"
                  : "Allowed 5–200 characters"
              }
              error={remarks && remarks.length < 5}
              inputProps={{ maxLength: 200 }}
            />
          )}
        </DialogContent>

        <DialogActions>
          <Button
            onClick={() =>
              setConfirmDialog({ open: false, type: null, rowId: null })
            }
          >
            Cancel
          </Button>

          <Button
            variant="contained"
            color={isApprove ? "success" : "error"}
            onClick={handleConfirm}
          >
            {isApprove ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>

      <LoadingOverlay loading={loading} />
    </Box>
  );
}

import React, { useMemo } from "react";
import { Box, Typography, Card, Stack, Chip } from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Legend,
} from "recharts";
import { analyticsStyles as s } from "./RequestAnalyticsStyles";

const COLORS = {
  ADD: "#4caf50",
  UPDATE: "#ff9800",
  DELETE: "#f44336",
};

const RequestAnalytics = ({ data = [] }) => {
  /* -------- PIE DATA -------- */
  const pieData = useMemo(() => {
    const map = { ADD: 0, UPDATE: 0, DELETE: 0 };
    data.forEach((d) => map[d.changeType]++);
    return Object.entries(map)
      .filter(([, v]) => v > 0)
      .map(([k, v]) => ({ name: k, value: v }));
  }, [data]);

  /* -------- BAR DATA (DAY + TYPE) -------- */
  const barData = useMemo(() => {
    const map = {};
    data.forEach((d) => {
      if (!d.reqDate) return;
      const day = new Date(d.reqDate).toLocaleDateString("en-GB");
      map[day] ??= { date: day, ADD: 0, UPDATE: 0, DELETE: 0 };
      map[day][d.changeType]++;
    });
    return Object.values(map);
  }, [data]);

  return (
    <Card sx={s.card}>
      <Typography sx={s.headerTitle}>Request Analytics Overview</Typography>
      <Typography variant="caption" sx={s.headerSubtitle}>
        Distribution by request type & daily activity trend
      </Typography>

      {data.length === 0 ? (
        <Typography>No data available</Typography>
      ) : (
        <Box sx={s.wrapper}>
          {/* PIE */}
          <Box sx={s.pieWrapper}>
            <Typography variant="subtitle2" sx={s.chartCaption}>
              Request Type Distribution
            </Typography>

            <ResponsiveContainer height={260}>
              <PieChart>
                <Pie
                  data={pieData}
                  dataKey="value"
                  nameKey="name"
                  innerRadius={60}
                  outerRadius={90}
                >
                  {pieData.map((p) => (
                    <Cell key={p.name} fill={COLORS[p.name]} />
                  ))}
                </Pie>
                <Tooltip />
              </PieChart>
            </ResponsiveContainer>
          </Box>

          {/* BAR */}
          <Box sx={s.barChartArea}>
            <Typography variant="subtitle2" sx={s.chartCaption}>
              Daily Request Activity (by type)
            </Typography>

            <ResponsiveContainer height={260}>
              <BarChart data={barData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="date" fontSize={10} />
                <YAxis fontSize={10} />
                <Tooltip />
                <Legend />
                <Bar dataKey="ADD" stackId="a" fill={COLORS.ADD} />
                <Bar dataKey="UPDATE" stackId="a" fill={COLORS.UPDATE} />
                <Bar dataKey="DELETE" stackId="a" fill={COLORS.DELETE} />
              </BarChart>
            </ResponsiveContainer>
          </Box>
        </Box>
      )}
    </Card>
  );
};

export default RequestAnalytics;