const selectedBranchOptions = useMemo(() => {
  /*
   * IMPORTANT:
   * When ALL selected,
   * allow manual typing in filters
   */
  if (
    !filters.branches?.length ||
    filters.branches.includes("ALL")
  ) {
    return null;
  }

  return filters.branches.map((branch) => ({
    value: branch.split("-")[0],
    label: branch.split("-")[0], // ONLY CODE
  }));
}, [filters.branches]);


{
  field: "branchCode",
  headerName: "Branch",
  flex: 1,

  /*
   * ONLY use singleSelect
   * when branch options available
   */
  ...(branchOptions
    ? {
        type: "singleSelect",
        valueOptions: branchOptions,
      }
    : {}),

  filterOperators: undefined,

renderCell: (params) => (
  <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
    <Typography
      variant="body2"
      sx={{ fontWeight: 700, fontSize: "0.8rem" }}
    >
      {params.row.branchCode}
    </Typography>

    <Typography
      variant="caption"
      sx={{
        color: "text.secondary",
        fontSize: "0.7rem",
      }}
    >
      {params.row.branchName}
    </Typography>
  </Box>
),