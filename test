// src/components/DashboardHead.jsx
import React from "react";
import { useSelector } from "react-redux";
import { Card, CardContent, Typography, Stack, Box, Chip } from "@mui/material";
import Grid from "@mui/material/Grid";

// Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import LocationCityIcon from "@mui/icons-material/LocationCity";
import PersonIcon from "@mui/icons-material/Person";
import CodeIcon from "@mui/icons-material/Code";

/**
 * Reusable information card
 */
const InfoCard = ({ icon, title, rows = [] }) => (
  <Card
    variant="outlined"
    sx={{
      borderRadius: 3,
      transition: "all .18s ease",
      "&:hover": { transform: "translateY(-6px)", boxShadow: 6 },
      cursor: "default",
      height: "100%",
      bgcolor: "background.paper"
    }}
  >
    <CardContent>
      <Stack direction="row" spacing={1} alignItems="center" mb={1}>
        <Box
          sx={{
            width: 44,
            height: 44,
            borderRadius: 2,
            bgcolor: "rgba(0,0,0,0.06)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center"
          }}
        >
          {icon}
        </Box>

        <Typography variant="subtitle1" fontWeight={700}>
          {title}
        </Typography>
      </Stack>

      {rows.map((r) => (
        <Box key={r.label} sx={{ mb: 0.8 }}>
          <Typography variant="caption" color="text.secondary">
            {r.label}
          </Typography>

          <Stack direction="row" spacing={1} alignItems="center">
            <Typography variant="body2" fontWeight={700}>
              {r.value}
            </Typography>

            {r.pill && (
              <Chip
                icon={<CodeIcon />}
                label={r.pill}
                size="small"
                sx={{
                  bgcolor: "rgba(0,0,0,0.05)",
                  fontWeight: 700,
                  borderRadius: 2,
                  px: 1
                }}
              />
            )}
          </Stack>
        </Box>
      ))}
    </CardContent>
  </Card>
);

/**
 * Small user info pill (right side)
 */
const UserInfoPill = ({ user = {} }) => {
  return (
    <Card
      variant="outlined"
      sx={{
        borderRadius: 3,
        transition: ".12s",
        "&:hover": { transform: "translateY(-3px)", boxShadow: 3 },
        bgcolor: "background.paper"
      }}
    >
      <CardContent>
        <Typography variant="caption" color="text.secondary">
          Name:
        </Typography>
        <Typography variant="body1" fontWeight={700}>
          {user.displayName || `${user.firstName || "User"} ${user.lastName || ""}`}
        </Typography>

        <Typography variant="caption" color="text.secondary" sx={{ mt: 1, display: "block" }}>
          Role:
        </Typography>
        <Typography variant="body1" fontWeight={700}>
          {user.roleName || user.role || "UCO"}
        </Typography>
      </CardContent>
    </Card>
  );
};

/**
 * Dashboard head main
 */
export const DashboardHead = () => {
  const user = useSelector((state) => state.auth?.user) || {};
  const fy = user.financialYear || {};

  return (
    <Box sx={{ m: 2 }}>
      {/* Row 1 — Welcome + User Info Pill */}
      <Grid container spacing={2} sx={{ mb: 2 }}>
        <Grid size={{ xs: 12, md: 8 }}>
          <Card
            sx={{
              borderRadius: 3,
              transition: ".18s",
              "&:hover": { transform: "translateY(-4px)", boxShadow: 4 },
              bgcolor: "background.paper"
            }}
          >
            <CardContent sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <Typography variant="h4" fontWeight={800}>
                Welcome To FinCore
              </Typography>

              <Chip
                icon={<PersonIcon />}
                label={user.displayName || `${user.firstName || "User"} ${user.lastName || ""}`}
                variant="outlined"
                sx={{ fontWeight: 700 }}
              />
            </CardContent>
          </Card>
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <UserInfoPill user={user} />
        </Grid>
      </Grid>

      {/* Row 2 — 3 Info Cards */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 4 }}>
          <InfoCard
            icon={<CalendarMonthIcon />}
            title="Current Financial Period"
            rows={[
              { label: "Start date", value: fy.startDate || "01-04-2025" },
              { label: "End date", value: fy.endDate || "31-03-2026" }
            ]}
          />
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <InfoCard
            icon={<LocationCityIcon />}
            title="Circle Information"
            rows={[
              { label: "Circle Name", value: user.circleName || "CO-AU II, MUMBAI" },
              { label: "Circle Code", value: user.circleCode || "020", pill: user.circleCode || "020" }
            ]}
          />
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <InfoCard
            icon={<AccountBalanceIcon />}
            title="Branch Information"
            rows={[
              { label: "Branch Name", value: user.branchName || "Main Branch Name" },
              { label: "Branch Code", value: user.branchCode || "12345", pill: user.branchCode || "12345" }
            ]}
          />
        </Grid>
      </Grid>
    </Box>
  );
};

export default DashboardHead;