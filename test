import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Tooltip,
  Typography,
  CircularProgress,
  TablePagination,
  Box,
  Stack,
} from "@mui/material";

import PlayArrowIcon from "@mui/icons-material/PlayArrow";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";

import ProcessStatusChip from "./ProcessStatusChip";
import { StageStatus } from "../util/StageStatus";
import { useState, useMemo, useEffect } from "react";

const MIN_PAGE_SIZE = 5;

/* ---------------- ACTION BUTTON ---------------- */
const Action = ({ title, icon, disabled, onClick }) => (
  <Tooltip title={title}>
    <span>
      <IconButton size="small" disabled={disabled} onClick={onClick}>
        {icon}
      </IconButton>
    </span>
  </Tooltip>
);

const ProcessStatusTable = ({ processes = [], actions, loading }) => {
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(MIN_PAGE_SIZE);

  /* ================= FILTER ================= */
  const validProcesses = useMemo(
    () => processes.filter((p) => p.stageDetails?.length),
    [processes]
  );

  /* ================= PAGINATION FIX ================= */
  useEffect(() => {
    if (page * rowsPerPage >= validProcesses.length) {
      setPage(0);
    }
  }, [validProcesses.length, page, rowsPerPage]);

  const paginatedData = useMemo(
    () =>
      validProcesses.slice(
        page * rowsPerPage,
        page * rowsPerPage + rowsPerPage
      ),
    [validProcesses, page, rowsPerPage]
  );

  /* ================= SUMMARY CHECK ================= */
  const hasDifferenceSummary = (process) => {
    if (process.type !== "DIFFERENCE") return false;

    const stage6 = [...process.stageDetails]
      .sort((a, b) => b.id - a.id)
      .find((s) => s.processStage === 6);

    return stage6?.status === StageStatus.COMPLETED;
  };

  /* ================================================= */

  return (
    <Paper elevation={1}>
      <TableContainer sx={{ maxHeight: 380 }}>
        <Table stickyHeader size="small">
          {/* ================= HEADER ================= */}
          <TableHead
            sx={{
              position: "sticky",
              top: 0,
              zIndex: 2,
              backgroundColor: "#b4a7d6",
              backdropFilter: "blur(8px)",
            }}
          >
            <TableRow>
              <TableCell>Process</TableCell>
              <TableCell align="center">Status</TableCell>
              <TableCell align="center">Stage</TableCell>
              <TableCell align="center">Started</TableCell>
              <TableCell align="center">Ended</TableCell>
              <TableCell align="center">Actions</TableCell>
            </TableRow>
          </TableHead>

          {/* ================= BODY ================= */}
          <TableBody>
            {/* ---------- LOADING ---------- */}
            {loading && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Box py={2}>
                    <CircularProgress size={20} />
                    <Typography variant="caption" ml={1}>
                      Loading processes…
                    </Typography>
                  </Box>
                </TableCell>
              </TableRow>
            )}

            {/* ---------- DATA ---------- */}
            {!loading &&
              paginatedData.map((p) => {
                const lastStage = p.stageDetails.at(-1);

                return (
                  <TableRow
                    key={p.type}
                    hover
                    sx={{
                      bgcolor:
                        lastStage.status === StageStatus.STARTED
                          ? "action.hover"
                          : "inherit",
                    }}
                  >
                    <TableCell fontWeight={500}>{p.type}</TableCell>

                    <TableCell align="center">
                      <ProcessStatusChip status={lastStage.status} />
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.stage?.title}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.startTime || "—"}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.endTime || "—"}
                    </TableCell>

                    {/* ================= ACTIONS ================= */}
                    <TableCell align="center">
                      <Stack
                        direction="row"
                        spacing={1}
                        justifyContent="center"
                      >
                        {/* START */}
                        <Action
                          title="Start"
                          icon={<PlayArrowIcon fontSize="small" />}
                          disabled={lastStage.status !== StageStatus.NOT_STARTED}
                          onClick={() => actions.onStart(p)}
                        />

                        {/* STOP */}
                        <Action
                          title="Stop"
                          icon={<StopIcon fontSize="small" />}
                          disabled={lastStage.status !== StageStatus.STARTED}
                          onClick={() => actions.onStop(p)}
                        />

                        {/* VIEW */}
                        <Action
                          title="View Details"
                          icon={<VisibilityIcon fontSize="small" />}
                          onClick={() => actions.onView(p.type)}
                        />

                        {/* SUMMARY */}
                        {hasDifferenceSummary(p) && (
                          <Action
                            title="View Summary"
                            icon={<SummarizeOutlinedIcon fontSize="small" />}
                            onClick={() => actions.onSummary(p)}
                          />
                        )}
                      </Stack>
                    </TableCell>
                  </TableRow>
                );
              })}

            {/* ---------- EMPTY ---------- */}
            {!loading && validProcesses.length === 0 && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Typography color="error.light">
                    Processes Not Available
                  </Typography>
                </TableCell>
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ================= PAGINATION ================= */}
      {!loading && validProcesses.length > MIN_PAGE_SIZE && (
        <TablePagination
          component="div"
          count={validProcesses.length}
          page={page}
          onPageChange={(_, p) => setPage(p)}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={(e) => {
            setRowsPerPage(parseInt(e.target.value, 10));
            setPage(0);
          }}
          rowsPerPageOptions={[5, 10, 25]}
          labelRowsPerPage="Rows"
        />
      )}
    </Paper>
  );
};

export default ProcessStatusTable;