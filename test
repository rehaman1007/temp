@Slf4j
public class AdminSupportServiceImpl implements AdminSupportService {

    private static final int FETCH_SIZE = 20000;
    private static final int EXCEL_WINDOW_SIZE = 1000;
    private static final long MAX_EXPORT_LIMIT = 1_000_000;

    private final JdbcTemplate jdbcTemplate;
    private final AdminSupportExecutor adminSupportExecutor;
    private final FileSystem hdfsFileSystem;

    /**
     * =========================================================
     * EXECUTE ADMIN SQL (COMMAND CONSOLE)
     * =========================================================
     */
    @Override
    public Map<String, Object> executeAdminSql(AdminSupportDTO dto, String userId, HttpServletRequest request) {

        Instant start = Instant.now();
        String clientIp = getClientIp(request);
        String rawSql = dto.getSql() == null ? "" : dto.getSql().trim();
        Map<String, Object> response = new HashMap<>();

        try {
            log.info("""
                    
                    ==================================================
                    ADMIN SQL EXECUTION STARTED
                    ==================================================
                    userId={}
                    clientIp={}
                    page={}
                    size={}
                    ==================================================
                    """, userId, clientIp, dto.getPage(), dto.getSize());

            /* CLEAN AND PARSE SQL/PLSQL */
            List<String> cleanStatements = parseSqlStatements(rawSql);

            if (cleanStatements.isEmpty()) {
                response.put("error", true);
                response.put("message", "SQL cannot be empty");
                return response;
            }

            /**
             * SINGLE SELECT EVALUATION
             */
            boolean isSingleSelect = cleanStatements.size() == 1 && isSelectQuery(cleanStatements.get(0));
            int page = dto.getPage() != null ? dto.getPage() : 0;
            int size = dto.getSize() != null ? dto.getSize() : 10;

            /**
             * EXECUTE SELECT QUERY
             */
            if (isSingleSelect) {
                String executableSelect = cleanStatements.get(0);

                String countSql = """
                        SELECT COUNT(*)
                        FROM (
                        """ + executableSelect + """
                        ) CNT
                        """;
                Integer total = jdbcTemplate.queryForObject(countSql, Integer.class);

                if (total == null) total = 0;

                int startRow = page * size;
                int endRow = startRow + size;

                String paginatedSql = executableSelect.trim() +
                        " OFFSET ? ROWS FETCH NEXT ? ROWS ONLY";

                List<Map<String, String>> columns = new ArrayList<>();
                List<Map<String, Object>> rawRows = new ArrayList<>();

                jdbcTemplate.query(paginatedSql, rs -> {

                    ResultSetMetaData metaData = rs.getMetaData();
                    int columnCount = metaData.getColumnCount();

                    if (columns.isEmpty()) {
                        for (int i = 1; i <= columnCount; i++) {
                            columns.add(Map.of("name", metaData.getColumnLabel(i)));
                        }
                    }

                    while (rs.next()) {
                        Map<String, Object> row = new LinkedHashMap<>();
                        for (int i = 1; i <= columnCount; i++) {
                            row.put(metaData.getColumnLabel(i), rs.getObject(i));
                        }
                        rawRows.add(row);
                    }

                    return null;
                }, startRow, size);

                List<Map<String, Object>> rows = adminSupportExecutor.cleanOracleRows(rawRows);

                response.put("error", false);
                response.put("columns", columns);
                response.put("rows", rows);
                response.put("total", total);
                response.put("page", page);
                response.put("size", size);

                adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "SUCCESS", 1, 1, 1, 0, 0, 0, 1, null, null, null, null, 1, Duration.between(start, Instant.now()).toSeconds(), rawSql);

                return response;
            }

            /**
             * EXECUTE DML/DDL COMMANDS
             */
            int successCount = 0;
            int insertCount = 0, updateCount = 0, deleteCount = 0, otherCount = 0;

            for (int i = 0; i < cleanStatements.size(); i++) {
                String sql = cleanStatements.get(i);

                try {
                    jdbcTemplate.execute(sql);
                    successCount++;
                    String upperSql = sql.toUpperCase();

                    if (upperSql.startsWith("INSERT")) insertCount++;
                    else if (upperSql.startsWith("UPDATE")) updateCount++;
                    else if (upperSql.startsWith("DELETE")) deleteCount++;
                    else otherCount++;

                } catch (Exception e) {
                    Throwable rootCause = getRootCause(e);
                    
                    adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "FAILED", cleanStatements.size(), successCount, successCount, insertCount, updateCount, deleteCount, otherCount, i + 1, sql, rootCause.getClass().getSimpleName(), rootCause.getMessage(), 0, Duration.between(start, Instant.now()).toSeconds(), rawSql);

                    response.put("error", true);
                    response.put("message", "Error at statement " + (i + 1) + " : " + rootCause.getMessage());
                    response.put("failedSql", sql);
                    return response;
                }
            }

            response.put("error", false);
            response.put("message", "Script executed successfully");
            response.put("rows", List.of(Map.of("RESULT", successCount + " statements executed successfully")));
            response.put("columns", List.of(Map.of("name", "RESULT")));
            response.put("total", 1);

            adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "SUCCESS", successCount, successCount, successCount, insertCount, updateCount, deleteCount, otherCount, null, null, null, null, successCount, Duration.between(start, Instant.now()).toSeconds(), rawSql);

            return response;

        } catch (Exception e) {
            log.error("ADMIN SQL EXECUTION FAILED", e);
            Throwable rootCause = getRootCause(e);
            
            adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "FAILED", 0, 0, 0, 0, 0, 0, 0, null, rawSql, rootCause.getClass().getSimpleName(), rootCause.getMessage(), 0, Duration.between(start, Instant.now()).toSeconds(), rawSql);

            response.put("error", true);
            response.put("message", rootCause.getMessage());
            return response;
        }
    }

    /**
     * =========================================================
     * EXPORT EXECUTED SQL COMMAND
     * =========================================================
     */
    @Override
    public ResponseEntity<Resource> exportData(AdminSupportDTO dto, String userId, HttpServletRequest request) {

        String sql = dto.getSql().trim();

        if (!isSelectQuery(sql)) {
            throw new RuntimeException("Only SELECT/CTE queries can be exported");
        }

        long count = validateExportLimit(sql);

        log.info("""
                ==================================
                EXPORT STARTED
                ==================================
                user={}
                type={}
                rows={}
                ==================================
                """, userId, dto.getExportType(), count);

        return switch (dto.getExportType().toUpperCase()) {
            case "EXCEL" -> exportExcel(sql);
            case "JSON" -> exportJson(sql);
            case "INSERT" -> exportInsert(dto);
            default -> exportCsv(sql);
        };
    }

    /**
     * =========================================================
     * UPLOAD & EXECUTE SQL FILE
     * =========================================================
     */
    @Override
    public Map<String, Object> uploadSqlFile(MultipartFile file, String userId, HttpServletRequest request) {

        Map<String, Object> response = new HashMap<>();
        String basePathStr = "/admin-support";
        Path basePath = new Path(basePathStr);

        try {
            String jobId = UUID.randomUUID().toString();
            String originalFilename = file.getOriginalFilename();
            log.info("Receiving SQL Script: {}", originalFilename);

            String baseName = originalFilename.substring(0, originalFilename.lastIndexOf('.'));
            String extension = originalFilename.substring(originalFilename.lastIndexOf('.'));

            File tempFile = File.createTempFile(baseName, extension);
            String hdfsFilename = baseName + "_" + jobId + extension;
            Path filePath = new Path(basePath, hdfsFilename);

            // Transfer multipart payload to physical temp file
            file.transferTo(tempFile);

            // 1. BACKUP TO HDFS SYNCHRONOUSLY FIRST
            if (!hdfsFileSystem.exists(basePath)) {
                hdfsFileSystem.mkdirs(basePath);
            }
            try (InputStream in = new FileInputStream(tempFile); FSDataOutputStream out = hdfsFileSystem.create(filePath)) {
                IOUtils.copyBytes(in, out, 4096, true);
            } catch (Exception hdfsEx) {
                log.error("HDFS Backup failed, but proceeding with execution", hdfsEx);
            }

            log.info("HDFS Backup Success and proceeding with execution");
            log.info("HDFS Filename: {}", hdfsFilename);
            log.info("HDFS filePath: {}", filePath);

            // 2. PASS TO ASYNC EXECUTOR
            adminSupportExecutor.executeScriptAsync(tempFile, jobId, userId, getClientIp(request), hdfsFilename);

            response.put("jobId", jobId);
            response.put("status", "STARTED");

            return response;

        } catch (Exception e) {
            log.error("Failed to initialize script upload process", e);
            response.put("error", true);
            response.put("message", e.getMessage());
            return response;
        }
    }

    /**
     * =========================================================
     * GET LIVE JOB STATUS
     * =========================================================
     */
    @Override
    public Map<String, Object> getJobStatus(String jobId) {
        Map<String, Object> status = AdminSupportExecutor.JOB_STATUS.get(jobId);
        if (status == null) {
            return Map.of("status", "NOT_FOUND");
        }
        Map<String, Object> response = new LinkedHashMap<>();
        response.putAll(status);
        return response;
    }

    /**
     * =========================================================
     * Robust SQL Parser for Mixed SQL & PL/SQL
     * =========================================================
     */
    private List<String> parseSqlStatements(String rawSql) {
        List<String> statements = new ArrayList<>();
        
        // 1. Split by Oracle's PL/SQL block terminator (a single '/' on its own line)
        String[] blocks = rawSql.split("(?m)^\\s*/\\s*$");
        
        for (String block : blocks) {
            block = block.trim();
            if (block.isEmpty()) continue;
            
            // 2. Check if this block is PL/SQL
            if (isPlSqlBlock(block)) {
                // Keep the entire block intact (JDBC needs the internal semicolons but NO trailing '/')
                statements.add(block);
            } else {
                // 3. It's standard SQL, safely split by semicolon
                String[] sqlStmts = block.split(";");
                for (String stmt : sqlStmts) {
                    // Remove standalone comments and trim
                    String clean = stmt.replaceAll("(?m)^--.*", "").trim();
                    if (!clean.isEmpty()) {
                        statements.add(clean);
                    }
                }
            }
        }
        return statements;
    }

    /**
     * =========================================================
     * Identifies if a string is a PL/SQL block
     * =========================================================
     */
    private boolean isPlSqlBlock(String sql) {
        String normalized = sql.trim().toUpperCase();
        
        // Check for Anonymous blocks
        if (normalized.startsWith("DECLARE") || normalized.startsWith("BEGIN")) {
            return true;
        }
        
        // Check for DDL PL/SQL blocks using dotall regex (?s) to handle newlines
        return normalized.matches("(?s)^CREATE\\s+(OR\\s+REPLACE\\s+)?(EDITIONABLE\\s+|NONEDITIONABLE\\s+)?(PROCEDURE|FUNCTION|TRIGGER|PACKAGE|TYPE).*");
    }

    /**
     * =========================================================
     * Extract Root Cause Exception
     * =========================================================
     */
    private Throwable getRootCause(Throwable e) {
        Throwable cause = e;
        while (cause.getCause() != null && cause != cause.getCause()) {
            cause = cause.getCause();
        }
        return cause;
    }

    /**
     * =========================================================
     * EXTRACT CLIENT IP
     * =========================================================
     */
    private String getClientIp(HttpServletRequest request) {
        String xfHeader = request.getHeader("X-Forwarded-For");
        if (xfHeader == null || xfHeader.isEmpty() || "unknown".equalsIgnoreCase(xfHeader)) {
            return request.getRemoteAddr();
        }
        return xfHeader.split(",")[0];
    }

    /**
     * =========================================================
     * Check SELECT Query
     * =========================================================
     */
    private boolean isSelectQuery(String sql) {
        if (sql == null || sql.isBlank()) {
            return false;
        }
        String normalized = sql.trim().toUpperCase();
        return normalized.startsWith("SELECT") || normalized.startsWith("WITH");
    }

    /**
     * =========================================================
     * Validating Export Limit
     * =========================================================
     */
    private long validateExportLimit(String sql) {
        String countSql = """
                SELECT COUNT(*)
                FROM (
                """ + sql + """
                ) CNT
                """;
        Long count = jdbcTemplate.queryForObject(countSql, Long.class);

        if (count == null) {
            count = 0L;
        }

        if (count > MAX_EXPORT_LIMIT) {
            throw new RuntimeException("Export limit exceeded. Maximum " + MAX_EXPORT_LIMIT + " rows allowed.");
        }

        return count;
    }

    /**
     * =========================================================
     * Build INSERT statements
     * =========================================================
     */
    private String buildInsertStatement(String tableName, ResultSet rs) throws Exception {

        ResultSetMetaData meta = rs.getMetaData();
        StringBuilder columns = new StringBuilder();
        StringBuilder values = new StringBuilder();

        int count = meta.getColumnCount();

        for (int i = 1; i <= count; i++) {
            String column = meta.getColumnName(i);
            String columnType = meta.getColumnTypeName(i);

            Object value = rs.getObject(i);
            columns.append(column);

            if (value == null) {
                values.append("NULL");
            } else if (columnType.equalsIgnoreCase("NUMBER") ||
                    columnType.equalsIgnoreCase("INTEGER") ||
                    columnType.equalsIgnoreCase("FLOAT") ||
                    columnType.equalsIgnoreCase("BINARY_FLOAT") ||
                    columnType.equalsIgnoreCase("BINARY_DOUBLE")) {

                values.append(value.toString());

            } else if (columnType.contains("TIMESTAMP")) {

                Timestamp ts = rs.getTimestamp(i);
                String formatted = ts.toLocalDateTime().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
                values.append("TO_TIMESTAMP('").append(formatted).append("','YYYY-MM-DD HH24:MI:SS')");

            } else if ("DATE".equalsIgnoreCase(columnType)) {

                Date date = rs.getDate(i);
                values.append("TO_DATE('").append(date).append("','YYYY-MM-DD')");

            } else {

                values.append("'").append(value.toString().replace("'", "''")).append("'");
            }

            if (i < count) {
                columns.append(",");
                values.append(",");
            }
        }
        return "INSERT INTO " + tableName + " (" + columns + ") VALUES (" + values + ");";
    }

    /**
     * =========================================================
     * Exporting data to INSERT (.sql File)
     * =========================================================
     */
    private ResponseEntity<Resource> exportInsert(AdminSupportDTO dto) {

        String tableName = dto.getTableName();

        if (tableName == null || tableName.isBlank()) {
            throw new RuntimeException("tableName is mandatory for INSERT export");
        }

        StringBuilder script = new StringBuilder();

        jdbcTemplate.query(
                connection -> {
                    var ps = connection.prepareStatement(dto.getSql());
                    ps.setFetchSize(FETCH_SIZE);
                    return ps;
                },
                rs -> {
                    try {
                        script.append(buildInsertStatement(tableName, rs)).append("\n");
                    } catch (Exception e) {
                        throw new RuntimeException(e);
                    }
                });

        byte[] bytes = script.toString().getBytes(StandardCharsets.UTF_8);
        return downloadFile(bytes, tableName + ".sql", MediaType.TEXT_PLAIN_VALUE);
    }

    /**
     * =========================================================
     * Exporting data to Excel
     * =========================================================
     */
    private ResponseEntity<Resource> exportExcel(String sql) {

        try (
                SXSSFWorkbook workbook = new SXSSFWorkbook(EXCEL_WINDOW_SIZE);
                ByteArrayOutputStream out = new ByteArrayOutputStream()
        ) {

            workbook.setCompressTempFiles(true);
            SXSSFSheet sheet = workbook.createSheet("Export");
            AtomicInteger rowNum = new AtomicInteger(0);

            jdbcTemplate.query(
                    connection -> {
                        var ps = connection.prepareStatement(sql);
                        ps.setFetchSize(FETCH_SIZE);
                        return ps;
                    },
                    rs -> {
                        ResultSetMetaData meta = rs.getMetaData();
                        int cols = meta.getColumnCount();

                        if (rowNum.get() == 0) {
                            Row header = sheet.createRow(0);
                            for (int i = 1; i <= cols; i++) {
                                header.createCell(i - 1).setCellValue(meta.getColumnLabel(i));
                            }
                            rowNum.incrementAndGet();
                        }

                        Row row = sheet.createRow(rowNum.getAndIncrement());

                        for (int i = 1; i <= cols; i++) {
                            Object value = rs.getObject(i);
                            row.createCell(i - 1).setCellValue(value == null ? "" : value.toString());
                        }

                        if (rowNum.get() % 5000 == 0) {
                            try {
                                sheet.flushRows(500);
                            } catch (IOException e) {
                                throw new RuntimeException(e);
                            }
                        }
                    });

            workbook.write(out);
            workbook.dispose();

            return downloadFile(out.toByteArray(), "export.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

        } catch (Exception e) {
            throw new RuntimeException("Excel export failed", e);
        }
    }

    /**
     * =========================================================
     * Exporting data to JSON
     * =========================================================
     */
    private ResponseEntity<Resource> exportJson(String sql) {
        try {
            List<Map<String, Object>> rows = jdbcTemplate.queryForList(sql);
            ObjectMapper mapper = new ObjectMapper();
            byte[] bytes = mapper.writerWithDefaultPrettyPrinter().writeValueAsBytes(rows);
            return downloadFile(bytes, "export.json", MediaType.APPLICATION_JSON_VALUE);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    /**
     * =========================================================
     * Exporting data to CSV
     * =========================================================
     */
    private ResponseEntity<Resource> exportCsv(String sql) {

        StringBuilder csv = new StringBuilder(1024 * 1024);
        final boolean[] headerWritten = {false};

        jdbcTemplate.query(
                connection -> {
                    var ps = connection.prepareStatement(sql);
                    ps.setFetchSize(FETCH_SIZE);
                    return ps;
                },
                rs -> {
                    ResultSetMetaData meta = rs.getMetaData();
                    int cols = meta.getColumnCount();

                    /* HEADER */
                    if (!headerWritten[0]) {
                        for (int i = 1; i <= cols; i++) {
                            if (i > 1) {
                                csv.append(",");
                            }
                            csv.append(csvEscape(meta.getColumnLabel(i)));
                        }
                        csv.append("\n");
                        headerWritten[0] = true;
                    }

                    /* DATA */
                    for (int i = 1; i <= cols; i++) {
                        if (i > 1) {
                            csv.append(",");
                        }
                        csv.append(csvEscape(rs.getObject(i)));
                    }

                    csv.append("\n");
                });

        return downloadFile(csv.toString().getBytes(StandardCharsets.UTF_8), "export.csv", "text/csv");
    }

    /**
     * =========================================================
     * Helper Method for Exporting data to CSV
     * =========================================================
     */
    private String csvEscape(Object value) {
        if (value == null) {
            return "";
        }

        String text = value.toString();

        if (text.contains(",")
                || text.contains("\"")
                || text.contains("\n")
                || text.contains("\r")) {

            text = text.replace("\"", "\"\"");
            return "\"" + text + "\"";
        }
        return text;
    }

    /**
     * =========================================================
     * Download File Helper
     * =========================================================
     */
    private ResponseEntity<Resource> downloadFile(byte[] data, String fileName, String contentType) {
        ByteArrayResource resource = new ByteArrayResource(data);
        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=" + fileName)
                .contentLength(data.length)
                .contentType(MediaType.parseMediaType(contentType))
                .body(resource);
    }
