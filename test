<Dialog
  open={open}
  onClose={onClose}
  maxWidth="sm"
  fullWidth
  PaperProps={{
    sx: {
      width: {
        xs: "95%",
        sm: "90%",
        md: "600px",
      },
      maxWidth: "600px",
      m: {
        xs: 1,
        sm: 2,
      },
      borderRadius: 2,
    },
  }}
>
  <DialogTitle
    sx={{
      fontSize: {
        xs: "1rem",
        sm: "1.1rem",
        md: "1.25rem",
      },
      pb: 1,
    }}
  >
    <b>{titleMap[actionType]}</b>
  </DialogTitle>

  <DialogContent
    dividers
    sx={{
      p: {
        xs: 2,
        sm: 3,
      },
    }}
  >
    <Stack spacing={2}>
      <Typography
        sx={{
          fontSize: {
            xs: "0.9rem",
            sm: "1rem",
          },
          wordBreak: "break-word",
        }}
      >
        Are you sure you want to {titleMap[actionType]}
        {processName && (
          <>
            {" "}
            for <b>{processName}</b>
          </>
        )}
        ?
      </Typography>

      <TextField
        label="Remarks *"
        placeholder="Enter remarks"
        multiline
        rows={4}
        value={remarks}
        fullWidth
        required
        onChange={handleRemarksChange}
        margin="dense"
        slotProps={{
          htmlInput: {
            maxLength: 200,
          },
        }}
        helperText={
          remarks?.length !== 0 && remarks?.length < 5
            ? "Enter at least 5 characters"
            : "Allowed 5-200 characters (alphabets, numbers, spaces,()&,/-.)"
        }
        error={remarks?.length !== 0 && remarks?.length < 5}
        sx={{
          "& .MuiInputBase-root": {
            fontSize: {
              xs: "0.9rem",
              sm: "1rem",
            },
          },
        }}
      />
    </Stack>
  </DialogContent>

  <DialogActions
    sx={{
      p: 2,
      flexDirection: {
        xs: "column-reverse",
        sm: "row",
      },
      gap: 1,
    }}
  >
    <Button
      onClick={onClose}
      fullWidth={window.innerWidth < 600}
    >
      Cancel
    </Button>

    <Button
      variant="contained"
      disabled={!remarks.trim() || remarks.trim().length < 5}
      onClick={handleConfirmClick}
      fullWidth={window.innerWidth < 600}
    >
      Confirm
    </Button>
  </DialogActions>
</Dialog>