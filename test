package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.time.Duration;
import java.time.Instant;
import java.util.*;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * EXECUTE ADMIN SQL
     */
    @Override
    public Map<String, Object> executeAdminSql(AdminSupportDTO dto, String userId, HttpServletRequest request) {

        Instant start = Instant.now();
        String clientIp = getClientIp(request);
        String rawSql = dto.getSql() == null ? "" : dto.getSql().trim();
        Map<String, Object> response = new HashMap<>();

        try {

            log.info("""
                    
                    ==================================================
                    ADMIN SQL EXECUTION STARTED
                    ==================================================
                    userId={}
                    clientIp={}
                    page={}
                    size={}
                    sql={}
                    ==================================================
                    """, userId, clientIp, dto.getPage(), dto.getSize(), rawSql);

            /**
             * CLEAN SQL
             */
            rawSql = rawSql.replaceAll(";\\s*$", "").trim();

            String[] statements = rawSql.split(";");

            List<String> cleanStatements = new ArrayList<>();

            for (String stmt : statements) {
                String clean = stmt.replaceAll("(?m)^--.*", "").trim();
                if (!clean.isEmpty()) {
                    cleanStatements.add(clean);
                }
            }

            if (cleanStatements.isEmpty()) {

                response.put("error", true);
                response.put("message", "SQL cannot be empty");

                return response;
            }

            /**
             * SINGLE SELECT
             */
            boolean isSingleSelect = cleanStatements.size() == 1 && cleanStatements.get(0).trim().toUpperCase().startsWith("SELECT");
            int page = dto.getPage() != null ? dto.getPage() : 0;
            int size = dto.getSize() != null ? dto.getSize() : 10;

            /**
             * SELECT QUERY
             */
            if (isSingleSelect) {
                String executableSelect = cleanStatements.get(0);
                String countSql = "SELECT COUNT(*) FROM (" + executableSelect + ")";
                Integer total = jdbcTemplate.queryForObject(countSql, Integer.class);

                if (total == null) {
                    total = 0;
                }

                /**
                 * PAGINATION
                 */
                int startRow = page * size;
                int endRow = startRow + size;

                String paginatedSql = """
                        SELECT * FROM
                        (
                            SELECT A.*, ROWNUM RN FROM
                            (
                        """ + executableSelect + """
                            ) A
                            WHERE ROWNUM <= ?
                        )
                        WHERE RN > ?
                        """;

                List<Map<String, Object>> rawRows = jdbcTemplate.queryForList(paginatedSql, endRow, startRow);

                /**
                 * CLEAN ORACLE TYPES
                 */
                List<Map<String, Object>> rows = adminSupportExecutor.cleanOracleRows(rawRows);

                /**
                 * COLUMNS
                 */
                List<Map<String, String>> columns = new ArrayList<>();

                if (!rows.isEmpty()) {
                    for (String key : rows.get(0).keySet()) {
                        columns.add(Map.of("name", key));
                    }
                }

                response.put("error", false);
                response.put("columns", columns);
                response.put("rows", rows);
                response.put("total", total);
                response.put("page", page);
                response.put("size", size);

                /**
                 * LOG SUCCESS
                 */
                adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "SUCCESS",

                        1, 1, 1, 0, 0, 0, 1, null, null, null, null, 1, Duration.between(start, Instant.now()).toSeconds(), rawSql);

                return response;
            }

            /**
             * COMMAND EXECUTION
             */
            int successCount = 0;
            int insertCount = 0;
            int updateCount = 0;
            int deleteCount = 0;
            int otherCount = 0;

            for (int i = 0; i < cleanStatements.size(); i++) {
                String sql = cleanStatements.get(i);

                try {

                    jdbcTemplate.execute(sql);
                    successCount++;
                    String upperSql = sql.toUpperCase();

                    if (upperSql.startsWith("INSERT")) {
                        insertCount++;
                    } else if (upperSql.startsWith("UPDATE")) {
                        updateCount++;
                    } else if (upperSql.startsWith("DELETE")) {
                        deleteCount++;
                    } else {
                        otherCount++;
                    }

                } catch (Exception e) {

                    /**
                     * LOG FAILURE
                     */
                    adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "FAILED",

                            cleanStatements.size(), successCount, successCount, insertCount, updateCount, deleteCount, otherCount, i + 1, sql, e.getClass().getSimpleName(), e.getMessage(), 0, Duration.between(start, Instant.now()).toSeconds(), rawSql);

                    response.put("error", true);
                    response.put("message", "Error at statement " + (i + 1) + " : " + e.getMessage());
                    response.put("failedSql", sql);

                    return response;
                }
            }

            response.put("error", false);
            response.put("message", "Script executed successfully");
            response.put("rows", List.of(Map.of("RESULT", successCount + " statements executed successfully")));
            response.put("columns", List.of(Map.of("name", "RESULT")));
            response.put("total", 1);

            /**
             * LOG SUCCESS
             */
            adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "SUCCESS", successCount, successCount, successCount, insertCount, updateCount, deleteCount, otherCount, null, null, null, null, successCount, Duration.between(start, Instant.now()).toSeconds(), rawSql);

            return response;

        } catch (Exception e) {

            log.error("ADMIN SQL EXECUTION FAILED", e);

            /**
             * LOG FAILURE
             */
            adminSupportExecutor.insertExecutionLog(UUID.randomUUID().toString(), userId, clientIp, null, "COMMAND", "FAILED", 0, 0, 0, 0, 0, 0, 0, null, rawSql, e.getClass().getSimpleName(), e.getMessage(), 0, Duration.between(start, Instant.now()).toSeconds(), rawSql);

            response.put("error", true);
            response.put("message", e.getMessage());
            return response;
        }
    }

    /**
     * UPLOAD SQL FILE
     */
    @Override
    public Map<String, Object> uploadSqlFile(MultipartFile file, String userId, HttpServletRequest request) {

        Map<String, Object> response = new HashMap<>();

        try {

            String jobId = UUID.randomUUID().toString();
            File tempFile = File.createTempFile("admin_support_", ".sql");
            file.transferTo(tempFile);

            adminSupportExecutor.executeScriptAsync(tempFile, jobId, userId, getClientIp(request));

            response.put("jobId", jobId);
            response.put("status", "STARTED");

            return response;

        } catch (Exception e) {
            response.put("error", true);
            response.put("message", e.getMessage());
            return response;
        }
    }

    /**
     * JOB STATUS
     */
    @Override
    public Map<String, Object> getJobStatus(String jobId) {
        Map<String, Object> status = AdminSupportExecutor.JOB_STATUS.get(jobId);
        if (status == null) {
            return Map.of("status", "NOT_FOUND");
        }
        Map<String, Object> response = new LinkedHashMap<>();
        response.putAll(status);
        return response;
    }

    /**
     * CLIENT IP
     */
    private String getClientIp(HttpServletRequest request) {
        String xfHeader = request.getHeader("X-Forwarded-For");
        if (xfHeader == null || xfHeader.isEmpty() || "unknown".equalsIgnoreCase(xfHeader)) {
            return request.getRemoteAddr();
        }
        return xfHeader.split(",")[0];
    }
}



package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportExecutor {

    /**
     * LIVE JOB STATUS CACHE
     */
    public static final Map<String, Map<String, Object>> JOB_STATUS = new ConcurrentHashMap<>();

    /**
     * PERFORMANCE CONFIG
     */
    private static final int COMMIT_BATCH_SIZE = 10000;
    private static final int STATUS_UPDATE_INTERVAL = 100;
    private static final int LOG_INTERVAL = 10000;
    private final JdbcTemplate jdbcTemplate;

    /**
     * CLEAN ORACLE TYPES
     */
    public List<Map<String, Object>> cleanOracleRows(List<Map<String, Object>> rawRows) {
        List<Map<String, Object>> rows = new ArrayList<>();
        for (Map<String, Object> rawRow : rawRows) {
            Map<String, Object> cleanRow = new LinkedHashMap<>();
            for (Map.Entry<String, Object> entry : rawRow.entrySet()) {
                Object value = entry.getValue();
                try {
                    if (value instanceof oracle.sql.TIMESTAMP ts) {
                        cleanRow.put(entry.getKey(), ts.timestampValue().toString());
                    } else if (value instanceof java.sql.Timestamp ts) {
                        cleanRow.put(entry.getKey(), ts.toLocalDateTime().toString());
                    } else if (value instanceof java.sql.Clob clob) {
                        cleanRow.put(entry.getKey(), clob.getSubString(1, (int) clob.length()));
                    } else if (value instanceof java.io.InputStream) {
                        cleanRow.put(entry.getKey(), "[BLOB DATA]");
                    } else if (value != null && value.getClass().getName().startsWith("oracle.sql.")) {
                        cleanRow.put(entry.getKey(), value.toString());
                    } else {
                        cleanRow.put(entry.getKey(), value);
                    }
                } catch (Exception e) {
                    cleanRow.put(entry.getKey(), "[UNSUPPORTED]");
                }
            }
            rows.add(cleanRow);
        }
        return rows;
    }

    /**
     * INSERT EXECUTION LOG
     */
    public void insertExecutionLog(String jobId, String userId, String clientIp, String fileName, String executionType, String status, int totalStatements, int processedCount, int executedCount, int insertCount, int updateCount, int deleteCount, int otherCount, Integer failedStatementNumber, String failedSql, String exceptionType, String exceptionMessage, long executionSpeed, long elapsedSeconds, String sqlText) {
        try {
            jdbcTemplate.update("""
                            INSERT INTO ADMIN_SUPPORT_LOG
                            (
                                ID,
                                JOB_ID,
                                USER_ID,
                                CLIENT_IP,
                                FILE_NAME,
                                EXECUTION_TYPE,
                                STATUS,
                                TOTAL_STATEMENTS,
                                EXECUTED_COUNT,
                                INSERT_COUNT,
                                UPDATE_COUNT,
                                DELETE_COUNT,
                                OTHER_COUNT,
                                FAILED_STATEMENT_NUMBER,
                                FAILED_SQL,
                                EXCEPTION_TYPE,
                                EXCEPTION_MESSAGE,
                                EXECUTION_SPEED,
                                ELAPSED_SECONDS,
                                SQL_TEXT,
                                CREATED_AT
                            )
                            VALUES
                            (
                                ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                                ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
                                ?, ?, ?, ?, ?, ?, ?, SYSTIMESTAMP
                            )
                            """,

                    jobId, userId, clientIp, fileName, executionType, status, totalStatements, executedCount, insertCount, updateCount, deleteCount, otherCount, failedStatementNumber, failedSql, exceptionType, exceptionMessage, executionSpeed, elapsedSeconds, sqlText);
        } catch (Exception e) {
            log.error("FAILED TO INSERT LOG", e);
        }
    }

    /**
     * EXECUTE SCRIPT ASYNC
     */
    @Async("sqlTaskExecutor")
    public void executeScriptAsync(File sqlFile, String jobId, String userId, String clientIp) {

        Instant start = Instant.now();

        long startedAt = System.currentTimeMillis();
        long completedAt = System.currentTimeMillis();
        int totalStatements = 0;
        int processedCount = 0;
        int executedCount = 0;
        int insertCount = 0;
        int updateCount = 0;
        int deleteCount = 0;
        int otherCount = 0;
        int failedLine = 0;
        String failedSql = null;

        try {

            /**
             * INITIAL STATUS
             */
            Map<String, Object> initialStatus = new ConcurrentHashMap<>();

            initialStatus.put("jobId", jobId);
            initialStatus.put("status", "RUNNING");
            initialStatus.put("progress", 0);
            initialStatus.put("processedCount", 0);
            initialStatus.put("executedCount", 0);
            initialStatus.put("insertCount", 0);
            initialStatus.put("updateCount", 0);
            initialStatus.put("deleteCount", 0);
            initialStatus.put("otherCount", 0);
            initialStatus.put("totalStatements", 0);
            initialStatus.put("startedAt", startedAt);
            initialStatus.put("message", "Execution started");
            JOB_STATUS.put(jobId, initialStatus);

            /**
             * COUNT STATEMENTS
             */
            try (BufferedReader counterReader = new BufferedReader(new FileReader(sqlFile))) {
                String line;
                while ((line = counterReader.readLine()) != null) {
                    line = line.trim();
                    if (line.isEmpty() || line.startsWith("--")) {
                        continue;
                    }
                    if (line.endsWith(";")) {
                        totalStatements++;
                    }
                }
            }

            /**
             * UPDATE TOTAL COUNT
             */
            Map<String, Object> countStatus = new ConcurrentHashMap<>(JOB_STATUS.get(jobId));
            countStatus.put("totalStatements", totalStatements);
            JOB_STATUS.put(jobId, countStatus);

            /**
             * EXECUTION
             */
            try (Connection connection = jdbcTemplate.getDataSource().getConnection();

                 BufferedReader reader = new BufferedReader(new FileReader(sqlFile))) {
                connection.setAutoCommit(false);
                Statement statement = connection.createStatement();
                statement.setFetchSize(1000);
                statement.setQueryTimeout(0);
                StringBuilder sqlBuilder = new StringBuilder();
                String line;
                int lineNumber = 0;
                int batchCounter = 0;

                while ((line = reader.readLine()) != null) {

                    lineNumber++;
                    line = line.trim();

                    /**
                     * SKIP COMMENTS
                     */
                    if (line.isEmpty() || line.startsWith("--")) {
                        continue;
                    }
                    sqlBuilder.append(line).append(" ");

                    /**
                     * SQL END
                     */
                    if (line.endsWith(";")) {
                        String sql = sqlBuilder.toString().trim();
                        while (sql.endsWith(";")) {
                            sql = sql.substring(0, sql.length() - 1).trim();
                        }

                        sqlBuilder.setLength(0);
                        failedSql = sql;
                        failedLine = lineNumber;
                        processedCount++;
                        String upperSql = sql.toUpperCase();

                        /**
                         * TYPE COUNTS
                         */
                        if (upperSql.startsWith("INSERT")) {
                            insertCount++;
                        } else if (upperSql.startsWith("UPDATE")) {
                            updateCount++;
                        } else if (upperSql.startsWith("DELETE")) {
                            deleteCount++;
                        } else {
                            otherCount++;
                        }

                        /**
                         * DDL
                         */
                        boolean isDDL = upperSql.startsWith("CREATE") || upperSql.startsWith("ALTER") || upperSql.startsWith("DROP") || upperSql.startsWith("TRUNCATE");

                        if (isDDL) {
                            statement.execute(sql);
                            connection.commit();
                            executedCount++;
                        } else {
                            /**
                             * BATCH DML
                             */
                            statement.addBatch(sql);
                            batchCounter++;

                            /**
                             * EXECUTE BATCH
                             */
                            if (batchCounter >= COMMIT_BATCH_SIZE) {
                                int[] result = statement.executeBatch();
                                connection.commit();
                                statement.clearBatch();
                                executedCount += result.length;
                                batchCounter = 0;
                            }
                        }

                        /**
                         * STATUS UPDATE
                         */

                        if (processedCount % STATUS_UPDATE_INTERVAL == 0 || processedCount == totalStatements) {

                            int progress = totalStatements == 0 ? 0 : (processedCount * 100) / totalStatements;

                            long elapsedMillis = Duration.between(start, Instant.now()).toMillis();

                            long elapsedSeconds = Math.max(elapsedMillis / 1000, 1);

                            long executionSpeed = processedCount <= 0 ? 0 : (processedCount * 1000L) / Math.max(elapsedMillis, 1);

                            long remaining = totalStatements - processedCount;

                            long etaSeconds = executionSpeed <= 0 ? 0 : remaining / executionSpeed;

                            Map<String, Object> status = new ConcurrentHashMap<>();

                            status.put("jobId", jobId);
                            status.put("status", "RUNNING");
                            status.put("progress", progress);
                            status.put("processedCount", processedCount);
                            status.put("executedCount", executedCount);
                            status.put("insertCount", insertCount);
                            status.put("updateCount", updateCount);
                            status.put("deleteCount", deleteCount);
                            status.put("otherCount", otherCount);
                            status.put("totalStatements", totalStatements);
                            status.put("executionSpeed", executionSpeed);
                            status.put("elapsedSeconds", elapsedSeconds);
                            status.put("etaSeconds", etaSeconds);
                            status.put("currentLine", lineNumber);
                            status.put("startedAt", startedAt);
                            status.put("message", "Processing " + processedCount + " / " + totalStatements);

                            JOB_STATUS.put(jobId, status);
                        }

                        /**
                         * LOGGING
                         */
                        if (processedCount % LOG_INTERVAL == 0) {
                            log.info("""
                                            
                                            ==================================================
                                            LIVE EXECUTION STATUS
                                            ==================================================
                                            jobId={}
                                            progress={}%
                                            processed={}
                                            executed={}
                                            ==================================================
                                            """,

                                    jobId, totalStatements == 0 ? 0 : (processedCount * 100) / totalStatements, processedCount, executedCount);
                        }
                    }
                }

                /**
                 * FINAL BATCH
                 */
                if (batchCounter > 0) {
                    int[] result = statement.executeBatch();
                    connection.commit();
                    statement.clearBatch();
                    executedCount += result.length;
                }

                long elapsedSeconds = Duration.between(start, Instant.now()).toSeconds();
                long executionSpeed = elapsedSeconds == 0 ? executedCount : executedCount / Math.max(elapsedSeconds, 1);

                /**
                 * FINAL STATUS
                 */
                Map<String, Object> completedStatus = new ConcurrentHashMap<>();

                completedStatus.put("jobId", jobId);
                completedStatus.put("status", "COMPLETED");
                completedStatus.put("progress", 100);
                completedStatus.put("processedCount", processedCount);
                completedStatus.put("executedCount", executedCount);
                completedStatus.put("insertCount", insertCount);
                completedStatus.put("updateCount", updateCount);
                completedStatus.put("deleteCount", deleteCount);
                completedStatus.put("otherCount", otherCount);
                completedStatus.put("totalStatements", totalStatements);
                completedStatus.put("executionSpeed", executionSpeed);
                completedStatus.put("startedAt", startedAt);
                completedStatus.put("completedAt", completedAt);
                completedStatus.put("elapsedSeconds", Duration.between(start, Instant.now()).toSeconds());
                completedStatus.put("etaSeconds", 0);

                completedStatus.put("completed", true);

                completedStatus.put("message", "Execution completed");

                JOB_STATUS.put(jobId, completedStatus);

                /**
                 * =================================================
                 * SUCCESS LOG
                 * =================================================
                 */
                insertExecutionLog(jobId, userId, clientIp, sqlFile.getName(), "FILE", "SUCCESS", totalStatements, processedCount, executedCount, insertCount, updateCount, deleteCount, otherCount, null, null, null, null, executionSpeed, elapsedSeconds, null);
            }

        } catch (Exception e) {

            long elapsedSeconds = Duration.between(start, Instant.now()).toSeconds();

            Map<String, Object> failedMap = new ConcurrentHashMap<>();

            failedMap.put("jobId", jobId);

            failedMap.put("status", "FAILED");

            failedMap.put("message", e.getMessage());

            failedMap.put("failedLine", failedLine);

            failedMap.put("failedSql", failedSql);

            failedMap.put("processedCount", processedCount);

            failedMap.put("executedCount", executedCount);

            failedMap.put("insertCount", insertCount);

            failedMap.put("updateCount", updateCount);

            failedMap.put("deleteCount", deleteCount);

            failedMap.put("otherCount", otherCount);

            failedMap.put("totalStatements", totalStatements);

            failedMap.put("startedAt", startedAt);

            JOB_STATUS.put(jobId, failedMap);

            insertExecutionLog(jobId, userId, clientIp, sqlFile.getName(), "FILE", "FAILED", totalStatements, processedCount, executedCount, insertCount, updateCount, deleteCount, otherCount, failedLine, failedSql, e.getClass().getSimpleName(), e.getMessage(), 0, elapsedSeconds, null);

            log.error("SQL EXECUTION FAILED", e);

        } finally {

            try {

                if (sqlFile != null && sqlFile.exists()) {

                    sqlFile.delete();
                }

            } catch (Exception ex) {

                log.error("FAILED TO DELETE TEMP FILE", ex);
            }
        }
    }
}



