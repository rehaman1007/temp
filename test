import { memo, useCallback, useState } from "react";
import {
  Box,
  Typography,
  IconButton,
  TextField,
  FormControlLabel,
  Checkbox,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  Button,
  Chip,
} from "@mui/material";

import ExpandMoreIcon from "@mui/icons-material/ExpandMore";
import DeleteIcon from "@mui/icons-material/Delete";
import FormatAlignLeftIcon from "@mui/icons-material/FormatAlignLeft";
import FormatAlignCenterIcon from "@mui/icons-material/FormatAlignCenter";
import FormatAlignRightIcon from "@mui/icons-material/FormatAlignRight";
import AddIcon from "@mui/icons-material/Add";
import FilterAltIcon from "@mui/icons-material/FilterAlt";

import { useDebouncedInput } from "../../hooks/useDebouncedInput";
import { ColumnSourceDialog } from "./ColumnSourceDialog";

/* ------------------------------------------------ */

export const ColumnItem = memo(
  ({ col, isEditing, onToggleEdit, onRemove, onUpdate }) => {

    const [filtersOpen, setFiltersOpen] = useState(false);

    /* Debounced Name */
    const handleNameUpdate = useCallback(
      (value) => onUpdate("name", value),
      [onUpdate],
    );

    const [debouncedName, setDebouncedName] = useDebouncedInput(
      col.name || "",
      handleNameUpdate,
      200,
    );

    /* Count Tables */
    const tableCount =
      col.templateColumnFilters?.length || 0;

    /* ------------------------------------------------ */

    return (
      <Box
        sx={{
          mb: 1,
          p: 1,
          bgcolor: "background.paper",
          borderRadius: 1,
          border: "1px solid #e0e0e0",
        }}
      >
        {/* HEADER */}
        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            mb: 1,
          }}
        >
          <Typography variant="caption" fontWeight={600}>
            {col.id}
          </Typography>

          <Box>
            <IconButton size="small" onClick={onToggleEdit}>
              <ExpandMoreIcon
                fontSize="small"
                sx={{ transform: isEditing ? "rotate(180deg)" : "none" }}
              />
            </IconButton>

            <IconButton size="small" onClick={onRemove}>
              <DeleteIcon fontSize="small" />
            </IconButton>
          </Box>
        </Box>

        {/* EDIT MODE */}
        {isEditing && (
          <Box display="flex" flexDirection="column" gap={1.5}>

            {/* NAME */}
            <TextField
              label="Column Name"
              size="small"
              value={debouncedName}
              onChange={(e) =>
                setDebouncedName(e.target.value)
              }
              fullWidth
            />

            {/* ALIGN */}
            <Box display="flex" gap={1}>
              <Typography variant="caption">Align:</Typography>

              <IconButton
                size="small"
                color={
                  col.format?.align === "LEFT" ||
                  !col.format?.align
                    ? "primary"
                    : "default"
                }
                onClick={() =>
                  onUpdate("format.align", "LEFT")
                }
              >
                <FormatAlignLeftIcon fontSize="small" />
              </IconButton>

              <IconButton
                size="small"
                color={
                  col.format?.align === "CENTER"
                    ? "primary"
                    : "default"
                }
                onClick={() =>
                  onUpdate("format.align", "CENTER")
                }
              >
                <FormatAlignCenterIcon fontSize="small" />
              </IconButton>

              <IconButton
                size="small"
                color={
                  col.format?.align === "RIGHT"
                    ? "primary"
                    : "default"
                }
                onClick={() =>
                  onUpdate("format.align", "RIGHT")
                }
              >
                <FormatAlignRightIcon fontSize="small" />
              </IconButton>
            </Box>

            {/* BOLD */}
            <FormControlLabel
              control={
                <Checkbox
                  checked={col.format?.bold || false}
                  onChange={(e) =>
                    onUpdate(
                      "format.bold",
                      e.target.checked,
                    )
                  }
                />
              }
              label="Bold"
            />

            {/* FORMAT TYPE */}
            <FormControl size="small" fullWidth>
              <InputLabel>Format Type</InputLabel>
              <Select
                value={col.format?.type || "none"}
                label="Format Type"
                onChange={(e) =>
                  onUpdate(
                    "format.type",
                    e.target.value,
                  )
                }
              >
                <MenuItem value="none">None</MenuItem>
                <MenuItem value="currency">
                  Currency
                </MenuItem>
                <MenuItem value="number">Number</MenuItem>
                <MenuItem value="date">Date</MenuItem>
                <MenuItem value="percentage">
                  Percentage
                </MenuItem>
              </Select>
            </FormControl>

            {/* FILTER CONFIG */}
            <Box
              display="flex"
              alignItems="center"
              justifyContent="space-between"
            >
              <Box display="flex" gap={1} alignItems="center">
                <FilterAltIcon fontSize="small" />
                <Typography variant="body2">
                  Column Filters
                </Typography>
              </Box>

              <Button
                size="small"
                variant="outlined"
                startIcon={<AddIcon />}
                onClick={() => setFiltersOpen(true)}
              >
                {tableCount ? "Edit" : "Add"}
              </Button>
            </Box>

            {/* BADGE */}
            {tableCount > 0 && (
              <Chip
                size="small"
                color="primary"
                label={`${tableCount} Tables`}
              />
            )}

            {/* DIALOG */}
            <ColumnSourceDialog
              open={filtersOpen}
              value={col.templateColumnFilters}
              onClose={() => setFiltersOpen(false)}
              onSave={(tables) => {
                onUpdate(
                  "templateColumnFilters",
                  tables,
                );
                setFiltersOpen(false);
              }}
            />

          </Box>
        )}
      </Box>
    );
  },
);

ColumnItem.displayName = "ColumnItem";