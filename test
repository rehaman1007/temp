import { defineConfig } from "vite";
import react from "@vitejs/plugin-react";
import fs from "fs";

/**
 * 1️⃣ Define all services with their individual IPs and ports
 * Each service can have a different host & port
 */
const services = {
  LS: { alias: "/LS", host: "http://10.0.19.100", port: 8081 }, // Anandi server
  UM: { alias: "/UM", host: "http://10.0.242.165", port: 8085 }, // Tejas server
  CL: { alias: "/CL", host: "http://10.0.19.200", port: 8090 }, // Another server
  // Add more services here easily
};

/**
 * 2️⃣ Dynamically generate proxy config for Vite
 */
const generateProxyConfig = (services) => {
  const proxyConfig = {};
  Object.values(services).forEach(({ alias, host, port }) => {
    proxyConfig[alias] = {
      target: `${host}:${port}`,
      changeOrigin: true,
      secure: false,
      rewrite: (path) => path.replace(new RegExp(`^${alias}`), ""),
    };
  });
  return proxyConfig;
};

// 3️⃣ Export Vite config
export default defineConfig({
  plugins: [react()],
  server: {
    host: true,
    port: 1000, // frontend port
    https: {
      key: fs.readFileSync("./localhost-key.pem"),
      cert: fs.readFileSync("./localhost.pem"),
    },
    proxy: generateProxyConfig(services),
  },
});