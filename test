import React from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Box,
  Grid,
  Chip,
  Divider,
  Paper,
  Stack,
  useTheme,
} from "@mui/material";
import {
  AccessTime,
  InfoOutlined,
  CodeOutlined,
  PlayArrow,
  CheckCircle,
  ErrorOutline,
  HourglassEmpty,
} from "@mui/icons-material";

const DagDetailsDialog = ({ open, onClose, dagData }) => {
  const theme = useTheme();

  if (!dagData) return null;

  // Helper to format dates elegantly
  const formatDate = (isoString) => {
    if (!isoString) return "N/A";
    return new Date(isoString).toLocaleString([], {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
  };

  // Helper for Status Icon & Color
  const getStatusProps = (state) => {
    switch (state) {
      case "running":
        return { color: "info", icon: <PlayArrow /> };
      case "success":
        return { color: "success", icon: <CheckCircle /> };
      case "failed":
        return { color: "error", icon: <ErrorOutline /> };
      case "queued":
        return { color: "warning", icon: <HourglassEmpty /> };
      default:
        return { color: "default", icon: <InfoOutlined /> };
    }
  };

  const statusProps = getStatusProps(dagData.state);
  const versionInfo = dagData.dag_versions?.[0] || {};

  // Reusable component for key-value pairs
  const DetailRow = ({ label, value }) => (
    <Box sx={{ display: "flex", justifyContent: "space-between", py: 0.75 }}>
      <Typography variant="body2" color="text.secondary" fontWeight="500">
        {label}
      </Typography>
      <Typography variant="body2" fontWeight="600" color="text.primary" textAlign="right">
        {value || "N/A"}
      </Typography>
    </Box>
  );

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: { borderRadius: 3, boxShadow: theme.shadows[10], overflow: "hidden" },
      }}
    >
      {/* Header */}
      <DialogTitle
        sx={{
          bgcolor: "background.default",
          borderBottom: "1px solid",
          borderColor: "divider",
          px: 3,
          py: 2.5,
        }}
      >
        <Stack direction="row" justifyContent="space-between" alignItems="center">
          <Box>
            <Typography variant="h5" fontWeight="800">
              {dagData.dag_id}
            </Typography>
            <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>
              {dagData.dag_run_id}
            </Typography>
          </Box>
          <Chip
            icon={statusProps.icon}
            label={dagData.state}
            color={statusProps.color}
            sx={{ fontWeight: "bold", textTransform: "capitalize", px: 1 }}
          />
        </Stack>
      </DialogTitle>

      {/* Body */}
      <DialogContent sx={{ p: 3, bgcolor: "background.paper" }}>
        <Grid container spacing={3}>
          {/* Section 1: Overview */}
          <Grid size={{ xs: 12, md: 6 }}>
            <Paper variant="outlined" sx={{ p: 2, borderRadius: 2, height: "100%" }}>
              <Stack direction="row" alignItems="center" spacing={1} mb={2}>
                <InfoOutlined color="primary" fontSize="small" />
                <Typography variant="subtitle1" fontWeight="700">
                  Run Overview
                </Typography>
              </Stack>
              <Divider sx={{ mb: 1.5 }} />
              <DetailRow label="Run Type" value={dagData.run_type} />
              <DetailRow label="Triggered By" value={dagData.triggered_by} />
              <DetailRow label="Note" value={dagData.note} />
            </Paper>
          </Grid>

          {/* Section 2: Versioning */}
          <Grid size={{ xs: 12, md: 6 }}>
            <Paper variant="outlined" sx={{ p: 2, borderRadius: 2, height: "100%" }}>
              <Stack direction="row" alignItems="center" spacing={1} mb={2}>
                <CodeOutlined color="primary" fontSize="small" />
                <Typography variant="subtitle1" fontWeight="700">
                  Version & Build
                </Typography>
              </Stack>
              <Divider sx={{ mb: 1.5 }} />
              <DetailRow label="Version Number" value={`v${versionInfo.version_number}`} />
              <DetailRow label="Bundle Name" value={versionInfo.bundle_name} />
              <DetailRow label="Created At" value={formatDate(versionInfo.created_at)} />
            </Paper>
          </Grid>

          {/* Section 3: Timeline */}
          <Grid size={{ xs: 12 }}>
            <Paper variant="outlined" sx={{ p: 2, borderRadius: 2 }}>
              <Stack direction="row" alignItems="center" spacing={1} mb={2}>
                <AccessTime color="primary" fontSize="small" />
                <Typography variant="subtitle1" fontWeight="700">
                  Execution Timeline
                </Typography>
              </Stack>
              <Divider sx={{ mb: 1.5 }} />
              <Grid container spacing={4}>
                <Grid size={{ xs: 12, sm: 6 }}>
                  <DetailRow label="Queued At" value={formatDate(dagData.queued_at)} />
                  <DetailRow label="Start Date" value={formatDate(dagData.start_date)} />
                  <DetailRow label="End Date" value={formatDate(dagData.end_date)} />
                </Grid>
                <Grid size={{ xs: 12, sm: 6 }}>
                  <DetailRow label="Logical Date" value={formatDate(dagData.logical_date)} />
                  <DetailRow label="Data Interval Start" value={formatDate(dagData.data_interval_start)} />
                  <DetailRow label="Data Interval End" value={formatDate(dagData.data_interval_end)} />
                </Grid>
              </Grid>
            </Paper>
          </Grid>

          {/* Section 4: Raw Payload (Collapsible or just a gray box) */}
          <Grid size={{ xs: 12 }}>
            <Typography variant="subtitle2" fontWeight="700" color="text.secondary" mb={1}>
              Raw Configuration Data
            </Typography>
            <Box
              sx={{
                p: 2,
                bgcolor: "grey.900",
                color: "grey.100",
                borderRadius: 2,
                overflowX: "auto",
                fontFamily: "monospace",
                fontSize: "0.8rem",
              }}
            >
              <pre style={{ margin: 0 }}>
                {JSON.stringify(dagData.conf, null, 2) === "{}"
                  ? "// No additional configuration parameters provided."
                  : JSON.stringify(dagData.conf, null, 2)}
              </pre>
            </Box>
          </Grid>
        </Grid>
      </DialogContent>

      {/* Footer */}
      <DialogActions sx={{ px: 3, py: 2, borderTop: "1px solid", borderColor: "divider" }}>
        <Button onClick={onClose} variant="outlined" color="inherit" sx={{ fontWeight: "bold", borderRadius: 2 }}>
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default DagDetailsDialog;

