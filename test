import React, { useCallback, useMemo } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  alpha,
  Tooltip,
  Stack,
  Divider,
} from "@mui/material";
import { Close, DoneAll, NotificationsNone } from "@mui/icons-material";
import { formatRelativeTime } from "../utils/CommonUtilities";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { useNavigate } from "react-router-dom";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
  markAsRead,
  loadMore,
  hasMore,
}) => {
  const { navigateToPage } = useNavigateToPage();
  const navigate = useNavigate();
  const menuItems = useSelector((state) => state.menus.menus);

  /** Sort notifications latest first */
  const sortedNotifications = useMemo(
    () =>
      [...notifications].sort(
        (a, b) => new Date(b.createdAt) - new Date(a.createdAt)
      ),
    [notifications]
  );

  /** Placeholder: mark all as read (you’ll implement API later) */
  const handleMarkAllAsRead = () => {
    console.log("Marking all notifications as read (placeholder)");
    // TODO: Implement markAllAsRead API later
    // For now, update local state visually
    // sortedNotifications.forEach((n) => markAsRead(n.id));
  };

  const handleMessageClick = useCallback(
    (row) => {
      console.log("handleMessageClick >", row);
      console.log("linkUrl >", row.linkUrl);
      markAsRead(row.id);
      const route = row.linkUrl;
      console.log(route);
      const foundMenu = menuItems.find((menu) => menu.route === route);
      console.log(foundMenu?.route);
      console.log(foundMenu);
      if (foundMenu) {
        navigateToPage(foundMenu);
        setNotificationDrawerOpen(false);
      }
    },
    [markAsRead, navigate]
  );

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          p: 0,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* Header */}
      <Box
        sx={{
          p: 3,
          borderBottom: "1px solid #E2E8F0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography variant="h6" sx={{ fontWeight: 600 }}>
          Notifications
        </Typography>

        <Stack direction="row" alignItems="center" spacing={1}>
          {notifications.length > 0 && (
            <Tooltip title="Mark all as read">
              <IconButton size="small" onClick={handleMarkAllAsRead}>
                <DoneAll /* fontSize="small" */ color="primary" />
              </IconButton>
            </Tooltip>
          )}

          <IconButton
            onClick={() => setNotificationDrawerOpen(false)}
            size="small"
          >
            <Close />
          </IconButton>
        </Stack>
      </Box>

      {/* Notification list */}
      {notifications.length === 0 ? (
        <Box
          sx={{
            flex: 1,
            textAlign: "center",
            mt: 4,
            color: "text.secondary",
          }}
        >
          <NotificationsNone sx={{ fontSize: 50, mb: 1, opacity: 0.6 }} />
          <Typography>No notifications yet</Typography>
        </Box>
      ) : (
        <Box
          sx={{
            flex: 1,
            overflowY: "auto",
            p: 2,
            display: "flex",
            flexDirection: "column",
            gap: 1.6,
          }}
        >
          {sortedNotifications.length === 0 ? (
            <Typography
              variant="body2"
              color="text.secondary"
              align="center"
              sx={{ mt: 4 }}
            >
              No notifications found
            </Typography>
          ) : (
            sortedNotifications.map((n, index) => {
              const isRead = n.read;
              return (
                <Paper
                  key={n.id + index}
                  onClick={() => handleMessageClick(n)}
                  sx={{
                    p: 2,
                    borderRadius: 2,
                    border: isRead ? "1px solid #E2E8F0" : "1px solid #5D3FD3",
                    backgroundColor: isRead
                      ? alpha("#5D3FD3", 0.06)
                      : "#FFFFFF",
                    transition: "all 0.25s ease",
                    cursor: "pointer",
                    "&:hover": {
                      backgroundColor: isRead
                        ? alpha("#5D3FD3", 0.1)
                        : alpha("#A28DF0", 0.15),
                      transform: "translateY(-2px)",
                    },
                  }}
                >
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: isRead ? 500 : 600,
                      color: isRead ? "text.primary" : "#2E2E2E",
                    }}
                  >
                    {n.message}
                  </Typography>

                  <Stack direction="row" spacing={2}>
                    <Box
                      sx={{
                        width: 8,
                        height: 8,
                        borderRadius: "50%",
                        backgroundColor: !isRead ? "#10B981" : "#F59E0B",
                        mt: 1,
                      }}
                    />
                    <Box>
                      <Typography
                        variant="caption"
                        sx={{
                          color: "text.secondary",
                          display: "block",
                          mt: 0.5,
                        }}
                      >
                        {formatRelativeTime(n.createdAt)}
                      </Typography>
                    </Box>
                  </Stack>
                </Paper>
              );
            })
          )}
        </Box>
      )}

      {/* Footer */}
      {notifications.length > 0 && (
        <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
          {hasMore ? (
            <Button fullWidth variant="outlined" onClick={loadMore}>
              Show More
            </Button>
          ) : (
            <Typography
              variant="body2"
              color="text.secondary"
              align="center"
              sx={{ py: 1 }}
            >
              No more notifications
            </Typography>
          )}
        </Box>
      )}
    </Drawer>
  );
};

export default NotificationDrawer;
