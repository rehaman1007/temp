String columnType = meta.getColumnTypeName(i);

if (value == null) {

    values.append("NULL");

} else if (
    columnType.equalsIgnoreCase("NUMBER")
    || columnType.equalsIgnoreCase("INTEGER")
    || columnType.equalsIgnoreCase("FLOAT")
    || columnType.equalsIgnoreCase("BINARY_FLOAT")
    || columnType.equalsIgnoreCase("BINARY_DOUBLE")
) {

    values.append(value.toString());

} else if (columnType.equalsIgnoreCase("DATE")) {

    values.append(
        "TO_DATE('"
            + rs.getDate(i)
            + "','YYYY-MM-DD')"
    );

} else if (columnType.contains("TIMESTAMP")) {

    values.append(
        "TO_TIMESTAMP('"
            + rs.getTimestamp(i).toLocalDateTime()
            + "','YYYY-MM-DD HH24:MI:SS.FF')"
    );

} else {

    values.append("'")
          .append(value.toString().replace("'", "''"))
          .append("'");
}