import { DataGrid } from "@mui/x-data-grid";
import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import InfoIcon from "@mui/icons-material/Info";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";

import { StageStatus } from "../util/StageStatus";
import ProcessStatusChip from "./ProcessStatusChip";

/* ====================================================== */

const buildRowId = (p) => {
  // BEST: backend unique id
  if (p.processId) return String(p.processId);

  // Fallback composite (stable)
  return `${p.type}_${p.dag || ""}_${p.airflowRunId || ""}`;
};

/* ================= MAIN COMPONENT ================= */

const ProcessStatusTable = ({ processes = [], actions, loading }) => {
  const rows = processes.map((p) => {
    const lastStage = p.stageDetails.at(-1);

    const hasSummary =
      p.type === "DIFFERENCE" &&
      p.stageDetails.some(
        (s) =>
          s.processStage === 6 &&
          s.status === StageStatus.COMPLETED
      );

    return {
      id: buildRowId(p), // ✅ STABLE
      processId: p.processId,
      type: p.type,
      status: lastStage?.status,
      stage: lastStage?.stage?.title,
      startTime: lastStage?.startTime,
      endTime: lastStage?.endTime,
      raw: p,
      hasSummary,
    };
  });

  const columns = [
    {
      field: "processId",
      headerName: "ID",
      flex: 0.4,
    },
    {
      field: "type",
      headerName: "Process",
      flex: 1,
    },
    {
      field: "status",
      headerName: "Status",
      flex: 0.7,
      renderCell: (p) => (
        <ProcessStatusChip status={p.value} />
      ),
    },
    {
      field: "stage",
      headerName: "Stage",
      flex: 1,
    },
    {
      field: "startTime",
      headerName: "Started",
      flex: 1,
    },
    {
      field: "endTime",
      headerName: "Ended",
      flex: 1,
    },
    {
      field: "actions",
      headerName: "Actions",
      flex: 0.8,
      sortable: false,
      renderCell: (params) => {
        const row = params.row.raw;
        const lastStage = row.stageDetails.at(-1);

        const showRestart =
          lastStage?.status !== StageStatus.STARTED;

        const showStop =
          lastStage?.status === StageStatus.STARTED;

        return (
          <Stack direction="row" spacing={1}>
            {showRestart && (
              <Tooltip title="Restart">
                <IconButton
                  size="small"
                  onClick={() => actions.onStart(row)}
                >
                  <RestartAltIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}

            {showStop && (
              <Tooltip title="Stop">
                <IconButton
                  size="small"
                  onClick={() => actions.onStop(row)}
                >
                  <StopIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}

            <Tooltip title="View">
              <IconButton
                size="small"
                onClick={() => actions.onView(row.type)}
              >
                <VisibilityIcon fontSize="small" />
              </IconButton>
            </Tooltip>

            {params.row.hasSummary && (
              <Tooltip title="Summary">
                <IconButton
                  size="small"
                  onClick={() => actions.onSummary(row)}
                >
                  <SummarizeOutlinedIcon fontSize="small" />
                </IconButton>
              </Tooltip>
            )}
          </Stack>
        );
      },
    },
  ];

  return (
    <Box sx={{ height: 520 }}>
      <DataGrid
        rows={rows}
        columns={columns}
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: {
            paginationModel: {
              pageSize: 5,
              page: 0,
            },
          },
        }}
        loading={loading}
        disableRowSelectionOnClick
        slots={{
          noRowsOverlay: () => (
            <Stack
              height="100%"
              alignItems="center"
              justifyContent="center"
            >
              <InfoIcon
                sx={{
                  fontSize: 48,
                  color: "text.secondary",
                  mb: 1,
                }}
              />
              <Typography variant="h6">
                No processes available
              </Typography>
              <Typography variant="body2">
                Processes not found for the ETL date.
              </Typography>
            </Stack>
          ),
        }}
      />
    </Box>
  );
};

export default ProcessStatusTable;