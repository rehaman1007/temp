DEFINE TEST_DATE = SYSDATE;
with base as (SELECT
    *
FROM
    currency_master cm
    LEFT JOIN (
        SELECT
            currency_code as crc_code,rate_change_date
        FROM
            currency_rate_change
        WHERE
            rate_change_date BETWEEN &test_date - 7 AND &test_date + 7
    )               crc ON cm.currency_code = crc.crc_code
    ) ,    
pending as (SELECT REQ_DATE,
        TARGET_ID,
        REQ_STATUS,
        REQ_ID FROM COMMON_REQ WHERE REQ_TYPE = 'CURRENCY_RATE_CHANGE' AND REQ_DATE BETWEEN &TEST_DATE - 7 AND &TEST_DATE + 7 and REQ_STATUS='P'),
final_frame as(select * from base left join pending on base.currency_code = pending.target_id)
select CURRENCY_CODE,CURRENCY_NAME,CURRENCY_RATE, UPDATED_AT ,
CASE
    WHEN RATE_CHANGE_DATE is NULL and REQ_STATUS is NULL THEN 'U'
    WHEN REQ_STATUS ='P' THEN 'P'
    ELSE 'A'
END as CHANGE_STATUS    
from final_frame
;


