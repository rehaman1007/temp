import { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Box,
  Typography,
  IconButton,
  RadioGroup,
  FormControlLabel,
  Radio,
  FormControl,
  FormLabel,
  MenuItem,
  Autocomplete,
  Divider,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import { useTableConfig } from "../../hooks/useTableConfig";
import GlobalVariableAutocomplete from "./GlobalVariableAutocomplete";
import { FilterBuilder } from "./FilterBuilder";
import WarningIcon from "@mui/icons-material/Warning";
import { toPascalKebabCase } from "../../../../utils/CommonUtilities";

/* ---------------- CONSTANTS ---------------- */

const dataTypes = ["DATE", "STRING", "NUMBER", "BOOLEAN"];

const modes = ["INPUT", "EXPRESSION", "QUERY"];

const queryTypes = [
  "DB_VALUE",
  "DB_COUNT",
  "DB_SUM",
  "DB_AVG",
  "DB_MIN",
  "DB_MAX",
];

const emptyState = {
  name: "",
  label: "",
  description: "",
  dataType: "DATE",
  mode: "INPUT",
  expression: "",
  source: {
    type: "",
    table: "",
    column: "",
    filters: {},
  },
};

/* ---------------- COMPONENT ---------------- */

export const GlobalVariableDialog = ({
  open,
  globalVariable,
  globals,
  onClose,
  onSave,
}) => {
  const { tableConfigs, getSelectableColumns } = useTableConfig();

  const [form, setForm] = useState(emptyState);
  const [errors, setErrors] = useState({});

  /* Load Edit / Reset */
  useEffect(() => {
    setForm(globalVariable || emptyState);
    setErrors({});
  }, [globalVariable, open]);

  /* Update Helper */
  const update = (key, val) => {
    if (key.startsWith("source.")) {
      const k = key.split(".")[1];
      setForm((p) => ({ ...p, source: { ...p.source, [k]: val } }));
    } else {
      setForm((p) => ({ ...p, [key]: val }));
    }
  };

  /* Validation */
  const validate = () => {
    const e = {};

    if (!form.name) e.name = "Variable name required";
    if (!form.label) e.label = "Label required";
    if (!form.description) e.description = "Description required";
    if (!form.dataType) e.dataType = "Select data type";
    if (!form.mode) e.mode = "Select mode";

    if (form.mode === "EXPRESSION" && !form.expression)
      e.expression = "Expression required";

    if (form.mode === "QUERY") {
      if (!form.source.type) e.type = "Select query type";
      if (!form.source.table) e.table = "Select table";
      if (!form.source.column) e.column = "Select column";
    }

    setErrors(e);
    return Object.keys(e).length === 0;
  };

  const handleSave = () => {
    if (!validate()) return;
    onSave(form);
    onClose();
  };

  /* Derived */
  const selectedTable = tableConfigs?.find(
    (t) => t.tableName === form.source.table,
  );

  const columns = selectedTable ? getSelectableColumns(form.source.table) : [];

  /* ---------------- UI ---------------- */

  return (
    <Dialog open={open} maxWidth="md" fullWidth>
      <DialogTitle>
        {globalVariable ? "Edit Variable" : "Add Global Variable"}
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        {/* NAME + LABEL */}
        <Box display="grid" gridTemplateColumns="1fr 1fr" gap={2}>
          <TextField
            label="Variable Name"
            value={form.name}
            error={!!errors.name}
            helperText={errors.name || "Used as $G{VAR} and G.VAR"}
            onChange={(e) => update("name", e.target.value.toUpperCase())}
          />

          <TextField
            label="Label"
            value={form.label}
            error={!!errors.label}
            helperText={errors.label}
            onChange={(e) => update("label", e.target.value)}
          />
        </Box>

        {/* DESCRIPTION */}
        <TextField
          sx={{ mt: 2 }}
          label="Description"
          fullWidth
          multiline
          rows={2}
          value={form.description}
          error={!!errors.description}
          helperText={errors.description}
          onChange={(e) => update("description", e.target.value)}
        />

        {/* DATA TYPE */}

        <Box width="100%" sx={{ mt: 2 }}>
          <FormControl>
            <FormLabel>Choose Variable Data Type:</FormLabel>
            <RadioGroup
              row
              value={form.dataType}
              onChange={(e) => update("dataType", e.target.value)}
            >
              {dataTypes.map((m) => (
                <FormControlLabel
                  key={m}
                  value={m}
                  control={<Radio />}
                  label={toPascalKebabCase(m)}
                  sx={{ mr: 5 }}
                />
              ))}
            </RadioGroup>
          </FormControl>
        </Box>

        {/* MODE */}
        <Box width="100%" sx={{ mt: 2 }}>
          <FormControl>
            <FormLabel>Choose Variable Mode:</FormLabel>
            <RadioGroup
              row
              value={form.mode}
              onChange={(e) => update("mode", e.target.value)}
            >
              {modes.map((m) => (
                <FormControlLabel
                  key={m}
                  value={m}
                  control={<Radio />}
                  label={toPascalKebabCase(m)}
                  sx={{ mr: 5 }}
                />
              ))}
            </RadioGroup>
          </FormControl>
        </Box>

        <Divider sx={{ my: 2 }} />

        {/* INPUT MODE */}
        {form.mode === "INPUT" && (
          <Box display="flex">
            <WarningIcon color="warning" sx={{ mr: 1 }} />
            <Typography color="text.secondary">
              Selecting <b>Input</b> mode requires the value to be entered by
              the user at runtime.
            </Typography>
          </Box>
        )}

        {/* EXPRESSION MODE */}
        {form.mode === "EXPRESSION" && (
          <>
            <GlobalVariableAutocomplete
              multiline
              globals={globals}
              value={form.expression}
              placeholder="e.g. #{ 1000 * G.USD_RATE }"
              onChange={(v) => update("expression", v)}
            />

            {errors.expression && (
              <Typography color="error" variant="caption">
                {errors.expression}
              </Typography>
            )}
          </>
        )}

        {/* QUERY MODE */}
        {form.mode === "QUERY" && (
          <>
            {/* TYPE */}
            <TextField
              select
              fullWidth
              label="Query Type"
              value={form.source.type}
              error={!!errors.type}
              helperText={errors.type}
              onChange={(e) => update("source.type", e.target.value)}
            >
              {queryTypes.map((q) => (
                <MenuItem key={q} value={q}>
                  {q}
                </MenuItem>
              ))}
            </TextField>

            {/* TABLE + COLUMN */}
            <Box mt={2} display="grid" gridTemplateColumns="1fr 1fr" gap={2}>
              <Autocomplete
                options={tableConfigs || []}
                getOptionLabel={(o) => o?.label || o?.tableName || ""}
                onChange={(_, v) => update("source.table", v?.tableName)}
                renderInput={(p) => (
                  <TextField
                    {...p}
                    label="Table"
                    error={!!errors.table}
                    helperText={errors.table}
                  />
                )}
              />

              <Autocomplete
                options={columns || []}
                getOptionLabel={(o) => o?.label || o?.columnName || ""}
                onChange={(_, v) => update("source.column", v?.columnName)}
                renderInput={(p) => (
                  <TextField
                    {...p}
                    label="Column"
                    error={!!errors.column}
                    helperText={errors.column}
                  />
                )}
              />
            </Box>

            {/* FILTERS */}
            {form.source.column && (
              <Box mt={2}>
                <FilterBuilder
                  tableName={form.source.table}
                  filters={form.source.filters}
                  onFiltersChange={(f) => update("source.filters", f)}
                />
              </Box>
            )}
          </>
        )}
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={handleSave}>
          Save
        </Button>
      </DialogActions>
    </Dialog>
  );
};
