import { useEffect, useState } from "react";
import { Button, Stack } from "@mui/material";
import RolesDialog from "./RolesDialog";
import useApi from "../../../hooks/useApi";

export default function RoleManagement() {
  const { callApi } = useApi();
  const [roles, setRoles] = useState([]);
  const [allPermissions, setAllPermissions] = useState([]);
  const [openDialog, setOpenDialog] = useState(false);
  const [selectedRole, setSelectedRole] = useState({});
  const [canSave, setCanSave] = useState(true);

  /** Fetch all permissions once */
  const getAllPermissions = async () => {
    try {
      const res = await callApi("/UM/role/get-permissions", {}, "GET");
      setAllPermissions(res?.result ?? []);
    } catch (err) {
      console.error("Permissions fetch failed:", err);
      // fallback dummy data
      setAllPermissions([
        { id: 1, title: "Dashboard Access", icon: "Dashboard" },
        { id: 2, title: "User Management", icon: "People" },
        { id: 3, title: "Settings Access", icon: "Settings" },
        { id: 4, title: "Audit Reports", icon: "Assessment" },
        { id: 5, title: "View Analytics", icon: "BarChart" },
      ]);
    }
  };

  /** Create or edit role → fetch permissions first */
  const handleOpenDialog = async (role = {}) => {
    await getAllPermissions();
    setSelectedRole(role);
    setOpenDialog(true);
  };

  const handleCloseDialog = () => {
    setOpenDialog(false);
    setSelectedRole({});
  };

  return (
    <Stack spacing={2}>
      <Button
        variant="contained"
        onClick={() => handleOpenDialog({ roleId: null, roleName: "", description: "", permissions: [] })}
      >
        Create New Role
      </Button>

      {/* Example edit button for existing role */}
      {/* <Button onClick={() => handleOpenDialog(existingRole)}>Edit Role</Button> */}

      <RolesDialog
        open={openDialog}
        onClose={handleCloseDialog}
        form={selectedRole}
        setForm={setSelectedRole}
        canSave={canSave}
        allPermissions={allPermissions}
      />
    </Stack>
  );
}