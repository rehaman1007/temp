const histogramData = useMemo(() => {
    const map = {};
    console.log(data);
    data.forEach((item) => {
      if (item.reqDate) {
        const date = new Date(item.reqDate).toLocaleDateString("en-GB");
        map[date] = (map[date] || 0) + 1;
      }
    });

    return Object.keys(map).map((d) => ({ date: d, count: map[d] }));
  }, [data]);
  
  {/* BAR SECTION */}
          <Box sx={s.barChartArea}>
            <ResponsiveContainer>
              <BarChart data={histogramData}>
                <CartesianGrid
                  strokeDasharray="3 3"
                  stroke="rgba(255,255,255,0.3)"
                />
                <XAxis
                  dataKey="date"
                  stroke="white"
                  fontSize={10}
                  tickMargin={4}
                />
                <YAxis stroke="white" fontSize={10} />
                <Tooltip />
                <Bar
                  dataKey="count"
                  fill="url(#gradient-3)"
                  radius={[6, 6, 0, 0]}
                />
              </BarChart>
            </ResponsiveContainer>
          </Box>
