import React, { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  Box,
  Checkbox,
  Typography,
  Stack,
  Divider,
  Paper,
  FormLabel,
  ToggleButtonGroup,
  ToggleButton,
  Chip,
  useTheme,
  useMediaQuery,
} from "@mui/material";
import { LocalizationProvider, DateTimePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import InfoOutlinedIcon from "@mui/icons-material/InfoOutlined";
import WarningAmberOutlinedIcon from "@mui/icons-material/WarningAmberOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";

export default function AnnouncementFormDialog({
  open,
  onClose,
  onSave,
  initialData,
  roles,
}) {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down("sm"));

  const [form, setForm] = useState({
    title: "",
    message: "",
    severity: "INFO",
    targetRoles: [],
    start_date: null,
    expiry_date: null,
  });

  const [errors, setErrors] = useState({});

  useEffect(() => {
    if (open) {
      if (initialData) {
        setForm({
          id: initialData.id,
          title: initialData.title || "",
          message: initialData.message || "",
          severity: initialData.severity || "INFO",
          targetRoles:
            initialData.targetRoles === "ALL"
              ? roles.map((r) => r.id)
              : Array.isArray(initialData.targetRoles)
              ? initialData.targetRoles.map(String)
              : [],
          start_date: initialData.startDate ? dayjs(initialData.startDate) : null,
          expiry_date: initialData.expiryDate ? dayjs(initialData.expiryDate) : null,
        });
      } else {
        setForm({
          title: "",
          message: "",
          severity: "INFO",
          targetRoles: [],
          start_date: null,
          expiry_date: null,
        });
      }
      setErrors({});
    }
  }, [open, initialData, roles]);

  const handleChange = (e) => {
    setForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
    if (errors[e.target.name]) setErrors((prev) => ({ ...prev, [e.target.name]: null }));
  };

  const handleSeverityChange = (event, newSeverity) => {
    if (newSeverity !== null) {
      setForm((prev) => ({ ...prev, severity: newSeverity }));
    }
  };

  const toggleRole = (id) => {
    setForm((prev) => {
      const updatedRoles = prev.targetRoles.includes(id)
        ? prev.targetRoles.filter((r) => r !== id)
        : [...prev.targetRoles, id];
        
      if (errors.targetRoles && updatedRoles.length > 0) {
        setErrors((errs) => ({ ...errs, targetRoles: null }));
      }
      return { ...prev, targetRoles: updatedRoles };
    });
  };

  const selectAll = () => {
    setForm((p) => ({ ...p, targetRoles: roles.map((r) => r.id) }));
    setErrors((errs) => ({ ...errs, targetRoles: null }));
  };
  
  const clearRoles = () => setForm((p) => ({ ...p, targetRoles: [] }));

  const validate = () => {
    let newErrors = {};

    // 1. Core Text Validations
    if (!form.title.trim()) newErrors.title = "Title is required";
    if (!form.message.trim()) newErrors.message = "Message is required";

    // 2. Role Validation
    if (form.targetRoles.length === 0) {
      newErrors.targetRoles = "At least one target role must be selected";
    }

    // 3. Date Validations
    if (!form.start_date) {
      newErrors.start_date = "Start date is required";
    } else if (!initialData) {
      // If creating new, start date cannot be in the past
      if (form.start_date.isBefore(dayjs(), "minute")) {
        newErrors.start_date = "Start date cannot be in the past";
      }
    }

    if (!form.expiry_date) {
      newErrors.expiry_date = "Expiry date is required";
    } else if (form.start_date && form.expiry_date.isBefore(form.start_date)) {
      newErrors.expiry_date = "Expiry date must be after the start date";
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = () => {
    if (!validate()) return;

    const payload = {
      ...(form.id && { id: form.id }),
      title: form.title.trim(),
      message: form.message.trim(),
      severity: form.severity,
      targetRoles:
        form.targetRoles.length === roles.length
          ? "ALL"
          : form.targetRoles.map((id) => (isNaN(Number(id)) ? id : Number(id))),
      startDate: form.start_date ? form.start_date.format("YYYY-MM-DD HH:mm:ss") : null,
      expiryDate: form.expiry_date ? form.expiry_date.format("YYYY-MM-DD HH:mm:ss") : null,
      isActive: initialData?.isActive ?? "Y",
    };

    onSave(payload);
  };

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: { borderRadius: 3, overflow: "hidden", bgcolor: "background.paper" },
      }}
    >
      {/* HEADER */}
      <Box sx={{ bgcolor: "primary.main", color: "white", px: 4, py: 3 }}>
        <Typography variant="h5" fontWeight="700">
          {initialData ? "Edit Announcement" : "Create New Announcement"}
        </Typography>
        <Typography variant="body2" sx={{ mt: 0.5, opacity: 0.8 }}>
          Fill in the mandatory fields (*) below to broadcast a message to your users.
        </Typography>
      </Box>

      <DialogContent sx={{ px: { xs: 2, sm: 4 }, py: 4, bgcolor: "#fcfcfc" }}>
        <Stack spacing={4}>
          {/* GROUP 1: Core Info & Severity */}
          <Paper elevation={0} sx={{ p: 3, borderRadius: 2, border: "1px solid #e2e8f0" }}>
            <Stack spacing={3}>
              <TextField
                required
                label="Announcement Title"
                name="title"
                fullWidth
                value={form.title}
                onChange={handleChange}
                error={Boolean(errors.title)}
                helperText={errors.title}
                variant="outlined"
              />

              <TextField
                required
                label="Message Content"
                name="message"
                fullWidth
                multiline
                minRows={4}
                value={form.message}
                onChange={handleChange}
                error={Boolean(errors.message)}
                helperText={errors.message}
              />

              <Box>
                <FormLabel required component="legend" sx={{ mb: 1, fontWeight: 600, color: "text.primary" }}>
                  Severity Level
                </FormLabel>
                <ToggleButtonGroup
                  value={form.severity}
                  exclusive
                  onChange={handleSeverityChange}
                  fullWidth
                  size="medium"
                  sx={{ mt: 0.5 }}
                >
                  <ToggleButton value="INFO" color="info" sx={{ fontWeight: 600 }}>
                    <InfoOutlinedIcon sx={{ mr: 1 }} fontSize="small" /> Information
                  </ToggleButton>
                  <ToggleButton value="WARN" color="warning" sx={{ fontWeight: 600 }}>
                    <WarningAmberOutlinedIcon sx={{ mr: 1 }} fontSize="small" /> Warning
                  </ToggleButton>
                  <ToggleButton value="CRITICAL" color="error" sx={{ fontWeight: 600 }}>
                    <ErrorOutlineOutlinedIcon sx={{ mr: 1 }} fontSize="small" /> Critical
                  </ToggleButton>
                </ToggleButtonGroup>
              </Box>
            </Stack>
          </Paper>

          {/* GROUP 2: Targeting Roles */}
          <Paper 
            elevation={0} 
            sx={{ 
              p: 3, 
              borderRadius: 2, 
              border: "1px solid", 
              borderColor: errors.targetRoles ? "error.main" : "#e2e8f0" 
            }}
          >
            <Stack direction="row" justifyContent="space-between" alignItems="center" mb={1}>
              <Box>
                <Typography fontWeight={600} color={errors.targetRoles ? "error.main" : "text.primary"}>
                  Target Roles *
                </Typography>
                <Typography variant="caption" color={errors.targetRoles ? "error.main" : "text.secondary"}>
                  {errors.targetRoles 
                    ? errors.targetRoles 
                    : form.targetRoles.length === roles.length
                      ? "All roles selected"
                      : `${form.targetRoles.length} role(s) selected`}
                </Typography>
              </Box>

              <Stack direction="row" spacing={1}>
                <Button size="small" variant="outlined" onClick={selectAll}>Select All</Button>
                <Button size="small" variant="text" color="error" onClick={clearRoles}>Clear</Button>
              </Stack>
            </Stack>

            {/* Responsive Grid for Checkboxes */}
            <Box
              sx={{
                maxHeight: 220,
                overflowY: "auto",
                display: "grid",
                gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr" },
                gap: 1,
                mt: 2,
                mb: form.targetRoles.length > 0 ? 2 : 0,
                pr: 1, 
              }}
            >
              {roles.map((role) => {
                const isSelected = form.targetRoles.includes(role.id);
                return (
                  <Paper
                    key={role.id}
                    variant="outlined"
                    onClick={() => toggleRole(role.id)}
                    sx={{
                      display: "flex",
                      alignItems: "center",
                      p: 0.5,
                      cursor: "pointer",
                      transition: "0.2s",
                      bgcolor: isSelected ? "primary.50" : "transparent",
                      borderColor: isSelected ? "primary.main" : "divider",
                      "&:hover": { bgcolor: "action.hover" },
                    }}
                  >
                    <Checkbox checked={isSelected} disableRipple color="primary" />
                    <Typography variant="body2" fontWeight={isSelected ? 600 : 400}>
                      {role.name}
                    </Typography>
                  </Paper>
                );
              })}
            </Box>

            {/* Selected Roles Chips */}
            {form.targetRoles.length > 0 && (
              <>
                <Divider sx={{ my: 2 }} />
                <Box display="flex" gap={1} flexWrap="wrap">
                  {form.targetRoles.map((id) => {
                    const role = roles.find((r) => r.id === id);
                    return (
                      <Chip
                        key={id}
                        label={role?.name ?? id}
                        onDelete={() => toggleRole(id)}
                        color="primary"
                        variant="outlined"
                        size="small"
                        sx={{ fontWeight: 500 }}
                      />
                    );
                  })}
                </Box>
              </>
            )}
          </Paper>

          {/* GROUP 3: Scheduling */}
          <Paper elevation={0} sx={{ p: 3, borderRadius: 2, border: "1px solid #e2e8f0" }}>
            <Typography fontWeight={600} color="text.primary" mb={2}>
              Scheduling Details *
            </Typography>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <Stack direction={{ xs: "column", sm: "row" }} spacing={3}>
                <DateTimePicker
                  label="Start Date & Time"
                  value={form.start_date}
                  // Prevent selecting past dates on the calendar only if creating new
                  minDateTime={!initialData ? dayjs() : undefined} 
                  onChange={(val) => {
                    setForm((prev) => ({ ...prev, start_date: val }));
                    setErrors((prev) => ({ ...prev, start_date: null }));
                  }}
                  slotProps={{ 
                    textField: { 
                      fullWidth: true, 
                      required: true,
                      error: Boolean(errors.start_date),
                      helperText: errors.start_date 
                    } 
                  }}
                />
                <DateTimePicker
                  label="Expiry Date & Time"
                  value={form.expiry_date}
                  // Prevent selecting an expiry date before the start date
                  minDateTime={form.start_date ? form.start_date : undefined}
                  onChange={(val) => {
                    setForm((prev) => ({ ...prev, expiry_date: val }));
                    setErrors((prev) => ({ ...prev, expiry_date: null }));
                  }}
                  slotProps={{ 
                    textField: { 
                      fullWidth: true, 
                      required: true,
                      error: Boolean(errors.expiry_date),
                      helperText: errors.expiry_date
                    } 
                  }}
                />
              </Stack>
            </LocalizationProvider>
          </Paper>
        </Stack>
      </DialogContent>

      <Divider />
      
      <DialogActions sx={{ p: 3, bgcolor: "background.paper" }}>
        <Button onClick={onClose} sx={{ color: "text.secondary", px: 3, fontWeight: 600 }}>
          Cancel
        </Button>
        <Button
          variant="contained"
          onClick={handleSubmit}
          sx={{ px: 4, py: 1.2, borderRadius: 2, boxShadow: 2, fontWeight: 600 }}
        >
          {initialData ? "Save Changes" : "Publish Announcement"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
