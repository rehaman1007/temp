import React, { useMemo, useRef } from "react";
import {
  Box,
  Button,
  Chip,
  CircularProgress,
  Divider,
  IconButton,
  Stack,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CleaningServices,
  ContentCopy,
  PlayArrow,
  PlaylistPlay,
  Terminal,
  Timer,
} from "@mui/icons-material";
import CustomChip from "../../../utils/CustomChip";

const quickCommands = [
  "SELECT * FROM USERS;",
  "SELECT * FROM ADMIN_SUPPORT_LOG;",
  "SELECT * FROM PERMISSIONS;",
  "SELECT * FROM ROLES;",
  "SELECT * FROM USER_ROLES;",
  "SELECT * FROM ROLE_PERMISSIONS;",
  "SELECT * FROM GL_BALANCE WHERE BALANCE_DATE = TO_DATE('01/04/2026','DD/MM/YYYY');",
  "SELECT * FROM GL_TRANSACTIONS WHERE TRANSACTION_DATE = TO_DATE('01/04/2026','DD/MM/YYYY');",
];

const CommandPanel = ({
  query,
  setQuery,
  onExecute,
  loading,
  onDangerousExecute,
}) => {
  const theme = useTheme();

  // Ref to track the cursor position in the native textarea
  const inputRef = useRef(null);

  /**
   * =========================================================
   * EXTRACT STATEMENT (SQL DEVELOPER LOGIC)
   * =========================================================
   */
  const getStatementAtCursor = () => {
    if (!inputRef.current || !query) return null;

    const start = inputRef.current.selectionStart;
    const end = inputRef.current.selectionEnd;

    // 1. If user highlighted specific text, run ONLY the highlighted text
    if (start !== end) {
      const selected = query.substring(start, end).trim();
      if (selected) return selected;
    }

    // 2. If it's a standard blinking cursor, find the surrounding statement
    let pos = start;

    // Step backwards past trailing spaces and semicolons to ensure we are "inside" the statement
    while (
      pos > 0 &&
      (query.charAt(pos - 1).match(/\s/) || query.charAt(pos - 1) === ";")
    ) {
      pos--;
    }

    const beforeCursor = query.substring(0, pos);
    const afterCursor = query.substring(pos);

    const startIdx = beforeCursor.lastIndexOf(";");
    const endIdx = afterCursor.indexOf(";");

    const startIndex = startIdx === -1 ? 0 : startIdx + 1;
    const endIndex = endIdx === -1 ? query.length : pos + endIdx;

    const extractedStatement = query.substring(startIndex, endIndex).trim();

    return extractedStatement || null;
  };

  /**
   * =========================================================
   * EXECUTION HANDLERS
   * =========================================================
   */
  const handleRunStatement = () => {
    const statement = getStatementAtCursor();

    if (!statement) {
      // Pass empty string to trigger parent's validation warning, preventing full-script fallback
      onExecute?.(false, "");
      return;
    }
    checkAndExecute(statement);
  };

  const handleRunScript = () => {
    if (!query.trim()) {
      onExecute?.(false, "");
      return;
    }
    checkAndExecute(query);
  };

  const checkAndExecute = (sqlToRun) => {
    const q = sqlToRun.trim().toUpperCase();
    const dangerous = ["DELETE", "DROP", "TRUNCATE", "ALTER"].some((x) =>
      q.startsWith(x),
    );

    if (dangerous) {
      onDangerousExecute?.(sqlToRun);
    } else {
      onExecute?.(false, sqlToRun); // Pass the specific extracted SQL
    }
  };

  /**
   * KEYBOARD SHORTCUTS
   */
  const handleKeyDown = (e) => {
    if (e.ctrlKey && e.key === "Enter") {
      e.preventDefault();
      handleRunStatement();
    }
    if (e.key === "F5") {
      e.preventDefault();
      handleRunScript();
    }
  };

  const isSelect = useMemo(() => {
    const q = query.trim().toUpperCase();
    return q.startsWith("SELECT") || q.startsWith("WITH");
  }, [query]);

  return (
    <Box
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
        bgcolor: "#0b1120",
        display: "flex",
        flexDirection: "column",
        flex: 1,
      }}
    >
      {/* HEADER BAR */}
      <Box
        sx={{
          px: 2,
          py: 1.2,
          bgcolor: "#111827",
          color: "white",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={1}
        >
          <Stack direction="row" spacing={1.5} alignItems="center">
            <Box
              sx={{
                width: 10,
                height: 10,
                borderRadius: "50%",
                bgcolor: "#22c55e",
                boxShadow: "0 0 12px #22c55e",
                animation: "pulse 1.5s infinite",
                "@keyframes pulse": {
                  "0%": { opacity: 0.5 },
                  "50%": { opacity: 1 },
                  "100%": { opacity: 0.5 },
                },
              }}
            />
            <Terminal fontSize="small" />
            <Typography fontWeight={800}>SQL Worksheet</Typography>
            <Typography
              variant="caption"
              sx={{ opacity: 0.7, ml: 2, display: { xs: "none", md: "block" } }}
            >
              Ctrl+Enter: Statement | F5: Script
            </Typography>
          </Stack>

          <Stack direction="row" spacing={1} alignItems="center">
            <Tooltip title="Copy SQL">
              <IconButton
                size="small"
                onClick={() => navigator.clipboard.writeText(query)}
              >
                <ContentCopy sx={{ color: "white" }} />
              </IconButton>
            </Tooltip>

            <Tooltip title="Clear">
              <IconButton size="small" onClick={() => setQuery("")}>
                <CleaningServices sx={{ color: "white" }} />
              </IconButton>
            </Tooltip>

            <Divider
              orientation="vertical"
              flexItem
              sx={{ borderColor: "rgba(255,255,255,0.08)", mx: 1 }}
            />

            <Tooltip title="Run statement at cursor or highlighted text (Ctrl+Enter)">
              <Button
                variant="contained"
                disableElevation
                startIcon={
                  loading ? (
                    <CircularProgress size={16} color="inherit" />
                  ) : (
                    <PlayArrow />
                  )
                }
                onClick={handleRunStatement}
                sx={{
                  borderRadius: 2,
                  px: 2,
                  fontWeight: 700,
                  background: "linear-gradient(135deg,#10b981,#059669)",
                  boxShadow: "0 4px 15px rgba(16,185,129,0.25)",
                  "&:hover": { transform: "translateY(-1px)" },
                }}
              >
                Statement
              </Button>
            </Tooltip>

            <Tooltip title="Run entire script (F5)">
              <Button
                variant="contained"
                disableElevation
                startIcon={
                  loading ? (
                    <CircularProgress size={16} color="inherit" />
                  ) : (
                    <PlaylistPlay />
                  )
                }
                onClick={handleRunScript}
                sx={{
                  borderRadius: 2,
                  px: 2,
                  fontWeight: 700,
                  background: "linear-gradient(135deg,#2563eb,#3b82f6)",
                  boxShadow: "0 4px 15px rgba(37,99,235,0.25)",
                  "&:hover": { transform: "translateY(-1px)" },
                }}
              >
                Script
              </Button>
            </Tooltip>
          </Stack>
        </Stack>
      </Box>

      {/* QUICK COMMANDS - Fixed visual layout */}
      <Box
        sx={{
          px: 2,
          py: 1.5,
          bgcolor: "#0f172a",
          borderBottom: "1px solid rgba(255,255,255,0.05)",
        }}
      >
        <Stack direction="row" useFlexGap flexWrap="wrap" sx={{ gap: 1 }}>
          {quickCommands.map((cmd) => (
            <Chip
              key={cmd}
              label={cmd}
              clickable
              onClick={() => setQuery(query ? query + "\n\n" + cmd : cmd)}
              sx={{
                bgcolor: "rgba(255,255,255,0.06)",
                color: "white",
                border: "1px solid rgba(255,255,255,0.1)",
                "&:hover": { bgcolor: "rgba(255,255,255,0.15)" },
              }}
            />
          ))}
        </Stack>
      </Box>

      {/* NATIVE TEXTAREA - Bulletproof rendering */}
      <Box sx={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <textarea
          ref={inputRef}
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onKeyDown={handleKeyDown}
          spellCheck="false"
          placeholder={`-- Write SQL queries here... \nSELECT * FROM USERS;\nSELECT SYSDATE FROM DUAL;`}
          style={{
            flex: 1,
            width: "100%",
            minHeight: "350px",
            padding: "24px",
            backgroundColor: "#0d1117",
            color: "#e2e8f0", // Light grey text, guaranteed visible
            fontFamily: "'Fira Code', 'Courier New', monospace",
            fontSize: "14px",
            lineHeight: "1.7",
            border: "none",
            outline: "none",
            resize: "none",
          }}
        />
      </Box>

      {/* FOOTER STATUS */}
      <Box
        sx={{
          px: 2,
          py: 1,
          borderTop: "1px solid rgba(255,255,255,0.06)",
          bgcolor: "#111827",
        }}
      >
        <Stack
          direction="row"
          spacing={1}
          alignItems="center"
          flexWrap="wrap"
          sx={{ gap: 1 }}
        >
          <CustomChip
            size="small"
            variant="outlined"
            label={isSelect ? "Read Mode" : "Mixed Mode"}
            color={isSelect ? "success" : "info"}
          />
          <CustomChip
            size="small"
            variant="outlined"
            label={`${query.length} chars`}
            sx={{ color: "white", borderColor: "rgba(255,255,255,0.2)" }}
          />
          <CustomChip
            size="small"
            variant="outlined"
            label={`${query.split(";").filter((x) => x.trim() && !x.trim().startsWith("--")).length} statements`}
            sx={{ color: "white", borderColor: "rgba(255,255,255,0.2)" }}
          />
          <CustomChip
            size="small"
            variant="outlined"
            icon={<Timer />}
            label={loading ? "Executing..." : "Ready"}
            color={loading ? "warning" : "success"}
          />
        </Stack>
      </Box>
    </Box>
  );
};

export default CommandPanel;
