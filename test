<Box
  sx={{
    mb: 3,
    p: 2,
    borderRadius: 2,
    bgcolor: theme.palette.background.paper,
    border: `1px solid ${theme.palette.divider}`,
  }}
>
  <Stack spacing={2}>
    {/* TOP */}
    <Stack
      direction="row"
      justifyContent="space-between"
      alignItems="center"
      flexWrap="wrap"
    >
      <Typography fontWeight={700}>
        Job ID : {jobStatus.jobId}
      </Typography>

      <Chip
        size="small"
        label={jobStatus.status}
        color={
          jobStatus.status === "COMPLETED"
            ? "success"
            : jobStatus.status === "FAILED"
              ? "error"
              : "warning"
        }
      />
    </Stack>

    {/* METRICS */}
    <Box
      sx={{
        display: "grid",
        gridTemplateColumns:
          "repeat(auto-fit,minmax(140px,1fr))",
        gap: 1.5,
      }}
    >
      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Processed
        </Typography>

        <Typography fontWeight={700}>
          {processed.toLocaleString()}
        </Typography>
      </Paper>

      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Executed
        </Typography>

        <Typography fontWeight={700}>
          {executed.toLocaleString()}
        </Typography>
      </Paper>

      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Pending
        </Typography>

        <Typography fontWeight={700}>
          {pending.toLocaleString()}
        </Typography>
      </Paper>

      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Speed
        </Typography>

        <Typography fontWeight={700}>
          {currentSpeed}/sec
        </Typography>
      </Paper>

      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          ETA
        </Typography>

        <Typography fontWeight={700}>
          {jobStatus.status === "COMPLETED"
            ? "0 sec"
            : `${jobStatus.etaSeconds || 0} sec`}
        </Typography>
      </Paper>

      <Paper
        variant="outlined"
        sx={{ p: 1.5 }}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Elapsed
        </Typography>

        <Typography fontWeight={700}>
          {elapsed} sec
        </Typography>
      </Paper>
    </Box>

    {/* PROGRESS */}
    <Box>
      <Stack
        direction="row"
        justifyContent="space-between"
        mb={0.5}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Progress
        </Typography>

        <Typography
          variant="caption"
          fontWeight={700}
        >
          {progress}%
        </Typography>
      </Stack>

      <LinearProgress
        variant="determinate"
        value={progress}
        sx={{
          height: 8,
          borderRadius: 10,
        }}
      />
    </Box>
  </Stack>
</Box>