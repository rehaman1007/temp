package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * CHANGEABLE BATCH SIZE
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * UI STATUS STORE
     */
    private final Map<String, Map<String, Object>> jobStore =
            new ConcurrentHashMap<>();

    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file,
            String userId,
            HttpServletRequest request
    ) {

        try {

            String jobId = UUID.randomUUID().toString();

            String ip =
                    request.getHeader("X-Forwarded-For") != null
                            ? request.getHeader("X-Forwarded-For")
                            : request.getRemoteAddr();

            /**
             * VERY IMPORTANT
             * COPY FILE BEFORE ASYNC
             */
            Path tempFile =
                    Files.createTempFile(
                            "admin_sql_",
                            ".sql"
                    );

            Files.copy(
                    file.getInputStream(),
                    tempFile,
                    StandardCopyOption.REPLACE_EXISTING
            );

            Map<String, Object> status =
                    new ConcurrentHashMap<>();

            status.put("status", "UPLOADING");

            status.put("executedCount", 0);

            status.put("progress", 0);

            status.put("insertCount", 0);

            status.put("updateCount", 0);

            status.put("deleteCount", 0);

            status.put("otherCount", 0);

            status.put(
                    "fileName",
                    file.getOriginalFilename()
            );

            status.put(
                    "fileSizeMb",
                    String.format(
                            "%.2f",
                            file.getSize() / 1024.0 / 1024.0
                    )
            );

            jobStore.put(jobId, status);

            log.info(
                    "SQL UPLOAD RECEIVED | jobId={} | file={} | size={}MB | user={} | ip={}",
                    jobId,
                    file.getOriginalFilename(),
                    String.format(
                            "%.2f",
                            file.getSize() / 1024.0 / 1024.0
                    ),
                    userId,
                    ip
            );

            /**
             * ASYNC START
             */
            adminSupportExecutor.executeScriptAsync(
                    tempFile,
                    jobId,
                    userId,
                    ip,
                    COMMIT_BATCH_SIZE,
                    jobStore,
                    file.getOriginalFilename()
            );

            return Map.of(
                    "error", false,
                    "jobId", jobId,
                    "message", "Execution started"
            );

        } catch (Exception e) {

            log.error(
                    "UPLOAD FAILED",
                    e
            );

            return Map.of(
                    "error", true,
                    "message", e.getMessage()
            );
        }
    }

    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStore.getOrDefault(
                jobId,
                Map.of("status", "NOT_FOUND")
        );
    }
}


package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.io.BufferedReader;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    private final DataSource dataSource;

    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path filePath,
            String jobId,
            String userId,
            String clientIp,
            int commitBatchSize,
            Map<String, Map<String, Object>> jobStore,
            String fileName
    ) {

        Instant startTime = Instant.now();

        int executedCount = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int otherCount = 0;

        int failedLine = 0;

        String failedSql = null;

        try {

            Map<String, Object> status =
                    jobStore.get(jobId);

            if (status == null) {

                log.error(
                        "JOB STATUS OBJECT NULL | jobId={}",
                        jobId
                );

                return;
            }

            /**
             * COUNT TOTAL STATEMENTS
             */
            int totalStatements = 0;

            try (
                    BufferedReader counter =
                            Files.newBufferedReader(filePath)
            ) {

                String line;

                while ((line = counter.readLine()) != null) {

                    if (line.trim().endsWith(";")) {
                        totalStatements++;
                    }
                }
            }

            status.put(
                    "totalStatements",
                    totalStatements
            );

            status.put(
                    "status",
                    "RUNNING"
            );

            log.info(
                    "EXECUTION STARTED | jobId={} | totalStatements={} | batchSize={}",
                    jobId,
                    totalStatements,
                    commitBatchSize
            );

            try (
                    Connection connection =
                            dataSource.getConnection();

                    Statement statement =
                            connection.createStatement();

                    BufferedReader reader =
                            Files.newBufferedReader(filePath)
            ) {

                connection.setAutoCommit(false);

                StringBuilder sqlBuilder =
                        new StringBuilder();

                String line;

                int currentLine = 0;

                while ((line = reader.readLine()) != null) {

                    currentLine++;

                    String trimmed = line.trim();

                    if (
                            trimmed.isBlank()
                                    || trimmed.startsWith("--")
                    ) {
                        continue;
                    }

                    sqlBuilder
                            .append(line)
                            .append("\n");

                    if (trimmed.endsWith(";")) {

                        String sql =
                                sqlBuilder.toString().trim();

                        sql =
                                sql.substring(
                                        0,
                                        sql.lastIndexOf(";")
                                );

                        failedLine = currentLine;

                        failedSql = sql;

                        statement.execute(sql);

                        executedCount++;

                        String upper =
                                sql.toUpperCase();

                        if (upper.startsWith("INSERT")) {
                            insertCount++;
                        }
                        else if (upper.startsWith("UPDATE")) {
                            updateCount++;
                        }
                        else if (upper.startsWith("DELETE")) {
                            deleteCount++;
                        }
                        else {
                            otherCount++;
                        }

                        /**
                         * COMMIT
                         */
                        if (
                                executedCount % commitBatchSize == 0
                        ) {

                            connection.commit();

                            log.info(
                                    "BATCH COMMIT SUCCESS | jobId={} | executed={}",
                                    jobId,
                                    executedCount
                            );
                        }

                        long elapsed =
                                Duration.between(
                                        startTime,
                                        Instant.now()
                                ).toSeconds();

                        long eta = 0;

                        if (
                                executedCount > 0
                                        && elapsed > 0
                        ) {

                            double avg =
                                    (double) elapsed
                                            / executedCount;

                            eta =
                                    (long) (
                                            (totalStatements - executedCount)
                                                    * avg
                                    );
                        }

                        double progress =
                                totalStatements > 0
                                        ? (
                                        (double) executedCount
                                                / totalStatements
                                ) * 100
                                        : 0;

                        status.put(
                                "executedCount",
                                executedCount
                        );

                        status.put(
                                "insertCount",
                                insertCount
                        );

                        status.put(
                                "updateCount",
                                updateCount
                        );

                        status.put(
                                "deleteCount",
                                deleteCount
                        );

                        status.put(
                                "otherCount",
                                otherCount
                        );

                        status.put(
                                "elapsedSeconds",
                                elapsed
                        );

                        status.put(
                                "estimatedRemainingSeconds",
                                eta
                        );

                        status.put(
                                "progress",
                                Math.min(progress, 100)
                        );

                        sqlBuilder.setLength(0);
                    }
                }

                connection.commit();

                status.put(
                        "status",
                        "COMPLETED"
                );

                status.put(
                        "progress",
                        100
                );

                log.info(
                        "EXECUTION COMPLETED | jobId={} | total={} | inserts={} | updates={} | deletes={}",
                        jobId,
                        executedCount,
                        insertCount,
                        updateCount,
                        deleteCount
                );
            }

            /**
             * DELETE TEMP FILE
             */
            Files.deleteIfExists(filePath);

        } catch (Exception e) {

            log.error(
                    "SQL EXECUTION FAILED | jobId={} | line={}",
                    jobId,
                    failedLine,
                    e
            );

            Map<String, Object> status =
                    jobStore.get(jobId);

            if (status != null) {

                status.put("status", "FAILED");

                status.put(
                        "failedLine",
                        failedLine
                );

                status.put(
                        "failedSql",
                        failedSql
                );

                status.put(
                        "message",
                        e.getMessage()
                );

                status.put(
                        "exceptionType",
                        e.getClass().getSimpleName()
                );
            }

            try {

                Files.deleteIfExists(filePath);

            } catch (Exception ex) {

                log.error(
                        "TEMP FILE DELETE FAILED",
                        ex
                );
            }
        }
    }
}