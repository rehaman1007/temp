import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  TextField,
  Typography,
  Grid,
  Stack,
  Divider,
} from "@mui/material";
import useApi from "../../hooks/useApi";

// ICONS
import InfoIcon from "@mui/icons-material/Info";
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import NoteIcon from "@mui/icons-material/Note";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import CancelIcon from "@mui/icons-material/Cancel";
import BookmarkAddedIcon from "@mui/icons-material/BookmarkAdded";
import BookmarkRemoveIcon from "@mui/icons-material/BookmarkRemove";
import GppGoodIcon from "@mui/icons-material/GppGood";
import GppBadIcon from "@mui/icons-material/GppBad";
import CustomChip from "../../utils/CustomChip";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import dayjs from "dayjs";
import customParseFormat from "dayjs/plugin/customParseFormat";
import advancedFormat from "dayjs/plugin/advancedFormat";

dayjs.extend(customParseFormat);
dayjs.extend(advancedFormat);

const formatDateDayjs = (dateString) => {
  console.log("dateString >", dateString);
  if (!dateString) {
    console.log("Input dateString is empty.");
    return "NA";
  }

  const dayjsObject = dayjs(dateString, "DD/MM/YYYY");

  if (!dayjsObject.isValid()) {
    console.error("Failed to parse date");
    return "NA";
  }
  const formattedDate = dayjsObject.format("Do MMMM, YYYY");
  console.log(formattedDate);
  return formattedDate;
};

export default function CglView() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [searchValue, setSearchValue] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search when searchValue changes ----
  useEffect(() => {
    const text = searchValue.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    const fetch = async () => {
      try {
        setLoading(true);
        const res = await callApi(
          "/CM/viewBranch",
          //   { branchCodeOrName: text },
          { branchCodeOrName: text },
          "GET"
        );
        setOptions(res?.data || []);
      } catch (error) {
        console.log("Something went wrong while fetching Branch", error);
        showSnackBar(
          "Something went wrong while fetching Branch's, Kindly try again after sometime",
          "warning"
        );
      } finally {
        setLoading(false);
      }
    };

    fetch();
  }, [searchValue, callApi, showSnackBar]);

  const handleInputChange = (_, value) => {
    console.log("value >", value);
    setSearchValue(value);
  };

  const formatAddressString = (selected) => {
    const parts = [];

    if (selected && selected.address) {
      parts.push(selected.address.trim());
    }
    if (selected && selected.branchCity) {
      parts.push(selected.branchCity.trim());
    }
    if (selected && selected.pinCode) {
      parts.push(selected.pinCode.trim());
    }
    const finalString = parts.join(", ");
    return finalString || "NA";
  };

  return (
    <Box
      sx={{
        p: 3,
        display: "flex",
        justifyContent: "center",
      }}
    >
      <Box sx={{ width: "100%", maxWidth: 1200 }}>
        {/* PAGE HEADING */}
        <Box sx={{ mb: 2 }}>
          <Typography variant="h5" sx={{ fontWeight: 700, mb: 0.5 }}>
            Branch Master Lookup
          </Typography>
          <Typography variant="body1" color="text.secondary">
            Search Branch by number or its name and view key account details in
            a clean, readable layout.
          </Typography>
        </Box>

        {/* SEARCH CARD */}
        <Card
          sx={{
            p: 2.5,
            mb: 3,
            display: "flex",
            flexDirection: "column",
            gap: 1,
          }}
        >
          <Typography
            variant="h5"
            sx={{ fontWeight: 600, color: "text.secondary", mb: 0.5 }}
          >
            Search Branch
          </Typography>
          <Autocomplete
            fullWidth
            value={selected}
            loading={loading}
            options={options}
            onChange={(_, v) => setSelected(v)}
            searchValue={searchValue}
            onInputChange={handleInputChange}
            getOptionLabel={(o) =>
              o ? `${o.branchCode} - ${o.branchName}` : ""
            }
            noOptionsText={
              searchValue.trim().length < 3
                ? "Type at least 3 characters..."
                : "No Branch's found for given input"
            }
            // Improve dropdown layering and look
            slotProps={{
              paper: {
                elevation: 3,
              },
              popper: {
                sx: {
                  zIndex: (theme) => theme.zIndex.modal + 1,
                },
              },
            }}
            renderInput={(params) => (
              <TextField
                {...params}
                label="Search Branch by Number or Description"
                placeholder="e.g. 12345 or abcd"
                size="small"
                InputProps={{
                  ...params.InputProps,
                  endAdornment: (
                    <>
                      {loading && <CircularProgress size={18} />}
                      {params.InputProps.endAdornment}
                    </>
                  ),
                }}
              />
            )}
          />
        </Card>

        {/* DETAILS CARD */}
        <Card sx={{ p: 3 }}>
          {!selected ? (
            <Box
              display="flex"
              alignItems="center"
              justifyContent="center"
              sx={{ minHeight: 220 }}
            >
              <Stack
                height="100%"
                alignItems="center"
                justifyContent="center"
                spacing={1.5}
              >
                <InfoIcon
                  sx={{ fontSize: 40, color: "text.secondary", mb: 0.5 }}
                />
                <Typography variant="subtitle1">
                  No Branch selected yet
                </Typography>
                <Typography
                  variant="body1"
                  color="text.secondary"
                  textAlign="center"
                >
                  Start typing in the search box above and pick a Branch to view
                  its complete details.
                </Typography>
              </Stack>
            </Box>
          ) : (
            <Box>
              <Box
                sx={{
                  mb: 2,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  flexWrap: "wrap",
                  gap: 1,
                }}
              >
                <Box>
                  <Typography
                    variant="h6"
                    sx={{ fontWeight: 700, mb: 0.5, letterSpacing: 0.2 }}
                  >
                    Branch Details
                  </Typography>
                  <Typography variant="body1" color="text.secondary">
                    {selected.branchCode} — {selected.branchName}
                  </Typography>
                </Box>

                <CustomChip
                  label={selected.status == true ? "Active" : "Inactive"}
                  variant="outlined"
                />
              </Box>

              <Divider sx={{ mb: 2 }} />

              <Grid container spacing={3}>
                {/* ROW 1 */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Number
                  </Typography>
                  <Typography variant="body1" sx={{ fontWeight: 600 }}>
                    {selected.branchCode}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Name
                  </Typography>
                  <Typography variant="body1">{selected.branchName}</Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Circle
                  </Typography>
                  <Typography variant="body1">
                    {selected.circleCode || "—"}{" "}
                    {selected.circleName ? `- ${selected.circleName}` : ""}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch State
                  </Typography>
                  <Typography variant="body1">
                    {selected.stateCode || "—"}{" "}
                    {selected.stateName ? `- ${selected.stateName}` : ""}
                  </Typography>
                </Grid>

                {/* ROW 2 */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    NMR Code
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.nmrCode || "NA"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch mail
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.emailId || "NA"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Phone
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.phoneNumber || "NA"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Status
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.status === true ? "Active" : "Inactive"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                {/* ROW 3 */}
                <Grid size={{ xs: 12, sm: 6, md: 12 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Address
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <Typography variant="body1">
                      {formatAddressString(selected)}
                    </Typography>
                  </Box>
                </Grid>

                {/* ROW 4 */}
                <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Open Date
                  </Typography>
                  <Typography variant="body1">
                    {formatDateDayjs(selected.openDate)}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Close Date
                  </Typography>
                  <Typography variant="body1">
                    {formatDateDayjs(selected.closeDate)}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Merged with
                  </Typography>
                  <Typography variant="body1">
                    {selected.mergedWithBranch || "NA"}
                  </Typography>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Merge Date
                  </Typography>
                  <Typography variant="body1">
                    {formatDateDayjs(selected.mergeDate)}
                  </Typography>
                </Grid>

                {/* ROW 5 */}
                <Grid size={{ xs: 6, sm: 6, md: 2 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch CPC
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.cpcFlag || "NA"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 6, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Food Credit
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.foodCreditFlag ? "Yes" : "No"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3.5 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch currChest
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={selected.currChestFlag ? "Yes" : "No"}
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>

                <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    Branch Type
                  </Typography>
                  <Box sx={{ mt: 0.5 }}>
                    <CustomChip
                      label={
                        selected.branchType == "A" ? "Automated" : "Manual"
                      }
                      color="default"
                      variant="outlined"
                    />
                  </Box>
                </Grid>
              </Grid>
            </Box>
          )}
        </Card>
      </Box>
    </Box>
  );
}
