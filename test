package com.fincore.enquiry_service.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.enquiry_service.dto.LedgerEnquiryRequest;
import com.fincore.enquiry_service.dto.MyDownloadsRequestDTO;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFSheet;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;

@Slf4j
@Service
@RequiredArgsConstructor
public class LedgerExportService {

    /*
     * ================================
     * CONFIG
     * ================================
     */

    private static final int FETCH_SIZE = 10000;

    private static final int FLUSH_SIZE = 1000;

    private static final long MAX_EXPORT_RECORDS = 1_000_000;

    /*
     * ================================
     * DEPENDENCIES
     * ================================
     */

    private final JdbcTemplate jdbcTemplate;

    private final MyDownloadsService myDownloadsService;

    /*
     * ================================
     * EXPORT
     * ================================
     */

    public byte[] export(
            LedgerEnquiryRequest dto,
            String userId
    ) {

        validateExportLimit(dto);

        try (

                SXSSFWorkbook workbook =
                        new SXSSFWorkbook(1000);

                ByteArrayOutputStream out =
                        new ByteArrayOutputStream()

        ) {

            workbook.setCompressTempFiles(true);

            SXSSFSheet sheet =
                    workbook.createSheet("Ledger");

            createHeader(workbook, sheet);

            /*
             * ================================
             * DYNAMIC SQL
             * ================================
             */

            StringBuilder sqlBuilder =
                    new StringBuilder("""
                            
                            SELECT
                            
                                g.TRANSACTION_ID,
                                g.BATCH_ID,
                                g.JOURNAL_ID,
                                g.TRANSACTION_DATE,
                                g.POST_DATE,
                            
                                b.CODE as BRANCH_CODE,
                                b.NAME as BRANCH_NAME,
                            
                                c.CIRCLE_CODE,
                                c.CIRCLE_NAME,
                            
                                g.CURRENCY,
                                cu.CURRENCY_NAME,
                            
                                g.CGL,
                                cg.DESCRIPTION,
                            
                                g.NARRATION,
                            
                                g.DEBIT_AMOUNT,
                                g.CREDIT_AMOUNT,
                            
                                NVL(g.TRANSACTION_COUNT,0) as TRANSACTION_COUNT,
                            
                                sf.FLAG_NAME as SOURCE_NAME
                            
                            FROM GL_TRANSACTIONS g
                            
                            JOIN BRANCH_MASTER b
                                ON g.BRANCH_CODE = b.CODE
                            
                            LEFT JOIN CIRCLE_MASTER c
                                ON b.CIRCLE_CODE = c.CIRCLE_CODE
                            
                            LEFT JOIN CURRENCY_MASTER cu
                                ON g.CURRENCY = cu.CURRENCY_CODE
                            
                            LEFT JOIN CGL_MASTER cg
                                ON g.CGL = cg.CGL_NUMBER
                            
                            LEFT JOIN SOURCE_FLAG_MASTER sf
                                ON g.SOURCE_FLAG = sf.FLAG_ID
                            
                            WHERE g.CGL = ?
                            
                            AND (? IS NULL OR g.CURRENCY = ?)
                            
                            AND g.TRANSACTION_DATE BETWEEN
                                TO_DATE(?,'DD/MM/YYYY')
                                AND TO_DATE(?,'DD/MM/YYYY')
                            """);

            /*
             * BRANCH FILTER
             */

            boolean skipBranches =
                    dto.getBranches() == null
                            || dto.getBranches().contains("ALL");

            if (!skipBranches) {

                String branchPlaceholders =
                        dto.getBranches()
                                .stream()
                                .map(b -> "?")
                                .reduce((a, b) -> a + "," + b)
                                .orElse("?");

                sqlBuilder.append(
                        " AND g.BRANCH_CODE IN ("
                ).append(branchPlaceholders)
                        .append(")");
            }

            /*
             * SOURCE FILTER
             */

            boolean skipSource =
                    dto.getSourceFlags() == null
                            || dto.getSourceFlags().contains("ALL");

            if (!skipSource) {

                String sourcePlaceholders =
                        dto.getSourceFlags()
                                .stream()
                                .map(s -> "?")
                                .reduce((a, b) -> a + "," + b)
                                .orElse("?");

                sqlBuilder.append(
                        " AND g.SOURCE_FLAG IN ("
                ).append(sourcePlaceholders)
                        .append(")");
            }

            /*
             * CIRCLE FILTER
             */

            String circle =
                    dto.getCircle() != null
                            && !dto.getCircle().equalsIgnoreCase("ALL")
                            ? dto.getCircle()
                            : null;

            if (circle != null) {

                sqlBuilder.append(
                        " AND c.CIRCLE_CODE = ?"
                );
            }

            /*
             * ORDER
             */

            sqlBuilder.append(
                    " ORDER BY g.TRANSACTION_DATE"
            );

            String sql =
                    sqlBuilder.toString();

            log.info("Final Export SQL : {}", sql);

            /*
             * ================================
             * EXCEL WRITE
             * ================================
             */

            AtomicInteger rowNum =
                    new AtomicInteger(1);

            jdbcTemplate.setFetchSize(FETCH_SIZE);

            jdbcTemplate.query(

                    connection -> {

                        PreparedStatement ps =
                                connection.prepareStatement(sql);

                        ps.setFetchSize(FETCH_SIZE);

                        int index = 1;

                        /*
                         * CGL
                         */

                        ps.setString(
                                index++,
                                dto.getCgl()
                        );

                        /*
                         * CURRENCY
                         */

                        String currency =
                                dto.getCurrencies() != null
                                        && dto.getCurrencies()
                                        .equalsIgnoreCase("ALL")
                                        ? null
                                        : dto.getCurrencies();

                        ps.setString(
                                index++,
                                currency
                        );

                        ps.setString(
                                index++,
                                currency
                        );

                        /*
                         * DATES
                         */

                        ps.setString(
                                index++,
                                dto.getFromDate()
                        );

                        ps.setString(
                                index++,
                                dto.getToDate()
                        );

                        /*
                         * BRANCHES
                         */

                        if (!skipBranches) {

                            for (String branch : dto.getBranches()) {

                                ps.setString(
                                        index++,
                                        branch
                                );
                            }
                        }

                        /*
                         * SOURCE FLAGS
                         */

                        if (!skipSource) {

                            for (String source : dto.getSourceFlags()) {

                                ps.setString(
                                        index++,
                                        source
                                );
                            }
                        }

                        /*
                         * CIRCLE
                         */

                        if (circle != null) {

                            ps.setString(
                                    index++,
                                    circle
                            );
                        }

                        return ps;
                    },

                    (ResultSet rs) -> {

                        while (rs.next()) {

                            Row row =
                                    sheet.createRow(
                                            rowNum.getAndIncrement()
                                    );

                            int col = 0;

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("TRANSACTION_ID"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("BATCH_ID"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("JOURNAL_ID"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("BRANCH_CODE"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("BRANCH_NAME"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("CIRCLE_CODE"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("CIRCLE_NAME"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("CURRENCY"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("CURRENCY_NAME"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("CGL"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("DESCRIPTION"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("NARRATION"))
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getBigDecimal("DEBIT_AMOUNT") != null
                                                    ? rs.getBigDecimal("DEBIT_AMOUNT").doubleValue()
                                                    : 0
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getBigDecimal("CREDIT_AMOUNT") != null
                                                    ? rs.getBigDecimal("CREDIT_AMOUNT").doubleValue()
                                                    : 0
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            rs.getLong("TRANSACTION_COUNT")
                                    );

                            row.createCell(col++)
                                    .setCellValue(
                                            safe(rs.getString("SOURCE_NAME"))
                                    );

                            /*
                             * FLUSH
                             */

                            if (rowNum.get() % FLUSH_SIZE == 0) {

                                try {

                                    sheet.flushRows(FLUSH_SIZE);

                                } catch (Exception e) {

                                    log.error(
                                            "Flush failed",
                                            e
                                    );
                                }

                                log.info(
                                        "Processed Rows : {}",
                                        rowNum.get()
                                );
                            }
                        }
                    }
            );

            /*
             * COLUMN WIDTHS
             */

            setColumnWidths(sheet);

            /*
             * WRITE
             */

            workbook.write(out);

            byte[] bytes =
                    out.toByteArray();

            /*
             * SAVE DOWNLOAD
             */

            sendToMyDownloads(
                    userId,
                    dto,
                    bytes
            );

            workbook.dispose();

            log.info(
                    "Ledger Export Completed Successfully"
            );

            return bytes;

        } catch (Exception e) {

            log.error(
                    "Ledger Export Failed",
                    e
            );

            throw new RuntimeException(
                    "Export failed",
                    e
            );
        }
    }

    /*
     * ================================
     * VALIDATE EXPORT LIMIT
     * ================================
     */

    private void validateExportLimit(
            LedgerEnquiryRequest dto
    ) {

        String countSql = """
                
                SELECT COUNT(*)
                FROM GL_TRANSACTIONS
                WHERE CGL = ?
                AND TRANSACTION_DATE BETWEEN
                    TO_DATE(?,'DD/MM/YYYY')
                    AND TO_DATE(?,'DD/MM/YYYY')
                """;

        Long count =
                jdbcTemplate.queryForObject(
                        countSql,
                        Long.class,
                        dto.getCgl(),
                        dto.getFromDate(),
                        dto.getToDate()
                );

        if (
                count != null
                        && count > MAX_EXPORT_RECORDS
        ) {

            throw new RuntimeException(
                    "Excel export cannot be generated for more than 10 lakh records"
            );
        }
    }

    /*
     * ================================
     * HEADER
     * ================================
     */

    private void createHeader(
            Workbook workbook,
            Sheet sheet
    ) {

        Row header =
                sheet.createRow(0);

        String[] columns = {

                "TRANSACTION ID",
                "BATCH ID",
                "JOURNAL ID",
                "BRANCH CODE",
                "BRANCH NAME",
                "CIRCLE CODE",
                "CIRCLE NAME",
                "CURRENCY",
                "CURRENCY NAME",
                "CGL",
                "DESCRIPTION",
                "NARRATION",
                "DEBIT AMOUNT",
                "CREDIT AMOUNT",
                "TRANSACTION COUNT",
                "SOURCE NAME"
        };

        CellStyle style =
                workbook.createCellStyle();

        Font font =
                workbook.createFont();

        font.setBold(true);

        style.setFont(font);

        for (int i = 0; i < columns.length; i++) {

            Cell cell =
                    header.createCell(i);

            cell.setCellValue(columns[i]);

            cell.setCellStyle(style);
        }
    }

    /*
     * ================================
     * COLUMN WIDTHS
     * ================================
     */

    private void setColumnWidths(
            Sheet sheet
    ) {

        sheet.setColumnWidth(0, 5000);
        sheet.setColumnWidth(1, 5000);
        sheet.setColumnWidth(2, 5000);
        sheet.setColumnWidth(3, 5000);
        sheet.setColumnWidth(4, 10000);
        sheet.setColumnWidth(5, 5000);
        sheet.setColumnWidth(6, 10000);
        sheet.setColumnWidth(7, 4000);
        sheet.setColumnWidth(8, 7000);
        sheet.setColumnWidth(9, 5000);
        sheet.setColumnWidth(10, 10000);
        sheet.setColumnWidth(11, 15000);
        sheet.setColumnWidth(12, 5000);
        sheet.setColumnWidth(13, 5000);
        sheet.setColumnWidth(14, 5000);
        sheet.setColumnWidth(15, 10000);
    }

    /*
     * ================================
     * DOWNLOAD SAVE
     * ================================
     */

    private void sendToMyDownloads(
            String userId,
            LedgerEnquiryRequest dto,
            byte[] content
    ) {

        try {

            String json =
                    new ObjectMapper()
                            .writeValueAsString(dto);

            MyDownloadsRequestDTO request =
                    new MyDownloadsRequestDTO(
                            userId,
                            "LedgerWiseEnquiry.xlsx",
                            51,
                            json,
                            content
                    );

            myDownloadsService.insertRequest(
                    request
            );

        } catch (Exception e) {

            log.error(
                    "Download save failed",
                    e
            );
        }
    }

    /*
     * ================================
     * SAFE VALUE
     * ================================
     */

    private String safe(
            String value
    ) {

        return value != null
                ? value
                : "";
    }
}