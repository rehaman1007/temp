    const [debouncedName, setDebouncedName] = useDebouncedInput(
      col.name || "",
      handleNameUpdate,
      200,
    );

    return (
      <Box
        sx={{
          mb: 1,
          p: 1,
          bgcolor: "background.paper",
          borderRadius: 1,
          border: "1px solid #e0e0e0",
        }}
      >
        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            mb: 1,
