const TextContainer = styled(Box)({
  flex: 1,
  minWidth: 0, // Prevents text from overflowing flex containers
});

const ChevronContainer = styled(MotionBox)({
  flexShrink: 0,
  display: "flex",
  alignItems: "center",
});

