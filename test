export default function RoleManagementTab2() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [confirmDialog, setConfirmialog] = useState(false);
  const [requestId, setRequestId] = useState(null);

  const fetchData = async () => {
    const payload = {};
    const response = await callApi("/UM/role/my-role-requests", payload, "GET");
    if (response?.result?.status) {
      const result = response?.result?.myRequests || [];
      const processedResult = result.map((row) => {
        const parsed = JSON.parse(row.requestPayload) || {};
        return {
          ...row,
          ...parsed,
        };
      });
      setRows(processedResult);
    } else {
      showSnackBar("No requests found", "warning");
      setRows([]);
    }
  };

  const handleCancelRequest = async () => {
    try {
      const payload = {
        requestId,
        actionFlag: "CANCEL",
        remarks: "User canceled this Request",
      };
      const response = await callApi(
        "/UM/role/cancel-role-request",
        payload,
        "POST"
      );
      console.log(response);
      if (response?.result?.status) {
        showSnackBar(response?.result?.message, "success");
      } else {
        showSnackBar(
          response?.result?.message
            ? response?.result?.message
            : "Failed to process your cancel request, Kindly try again",
          "error"
        );
      }
    } catch (error) {
      console.log(error);
    } finally {
      fetchData();
      setConfirmialog(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const columns = [
    { field: "roleName", headerName: "Role Name", flex: 0.5 },
    { field: "description", headerName: "Role Name", flex: 1.2 },
    {
      field: "requestType",
      headerName: "Request Type",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const val = params.value;
        const color =
          val === "ADD" ? "success" : val === "DELETE" ? "error" : "warning";
        const icon =
          val === "ADD" ? (
            <AddBoxIcon />
          ) : val === "DELETE" ? (
            <AutoDeleteIcon />
          ) : (
            <EditDocumentIcon />
          );
        return (
          <Chip
            icon={icon}
            label={
              val === "ADD"
                ? "Added"
                : val === "DELETE"
                ? "Deleted"
                : "Modified"
            }
            // color={color}
            size="small"
          />
        );
      },
    },

    {
      field: "requestDate",
      headerName: "Requested Date",
      flex: 1,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        const isoString = params.value;
        if (!isoString) return null;
        let formattedDate = isoString;
        try {
          const date = new Date(isoString);
          formattedDate = date.toLocaleString("en-IN", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
            timeZone: "Asia/Kolkata",
          });
        } catch (error) {
          console.error("Error formatting date:", error);
        }

        return <Typography component="span">{formattedDate}</Typography>;
      },
    },

    // ... rest of your DataGrid setup

    {
      field: "requestStatus",
      headerName: "Status",
      flex: 0.6,
      sortable: true,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Box>
          <Chip
            icon={
              params.value === "ACCEPTED" ? (
                <CheckCircleIcon />
              ) : params.value === "REJECTED" ? (
                <BlockFlippedIcon />
              ) : params.value === "CANCELED" ? (
                <GppBadIcon />
              ) : (
                <PendingActionsIcon />
              )
            }
            label={toPascalKebabCase(params.value)}
            sx={{
              p: 0.5,
              m: 0,
              width: "90%",
            }}
          />
        </Box>
      ),
    },
    {
      field: "action",
      headerName: "Action",
      flex: 0.7,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => {
        return params.row.requestStatus === "PENDING" ? (
          <Stack
            direction="row"
            spacing={1}
            justifyContent="center"
            sx={{ height: "100%" }}
          >
            <Tooltip title={"Cancel Request"}>
              <IconButton
                size="medium"
                onClick={() => {
                  setConfirmialog(true);
                  setRequestId(params.row.requestId);
                }}
              >
                <CancelIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
          </Stack>
        ) : (
          <Stack
            direction="row"
            spacing={1}
            justifyContent="center"
            sx={{ height: "100%" }}
          >
            NA
          </Stack>
        );
      },
    },
  ];

  return (
    <>
      <Box sx={{ p: { xs: 2, md: 3 } }}>
        <Paper variant="outlined" sx={{ mt: 2 }}>
          <DataGrid
            rows={rows}
            columns={columns}
            disableRowSelectionOnClick
            pageSizeOptions={[5, 10, 25, 50]}
            initialState={{
              pagination: { paginationModel: { pageSize: 10, page: 0 } },
              sorting: { sortModel: [{ field: "reqDate", sort: "asc" }] },
            }}
            getRowId={(row) => row.requestId}
            sx={{
              minHeight: 600,
              "& .MuiDataGrid-cell:focus": { outline: "none" },
            }}
          />
        </Paper>
      </Box>
      <Dialog
        open={confirmDialog}
        onClose={() => {
          setConfirmialog(false);
        }}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>Cancel Request</DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 1 }}>
            Are you sure you want to cancel this request Please confirm ?
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button
            onClick={() => {
              setConfirmialog(false);
            }}
            variant="outlined"
          >
            Cancel
          </Button>
          <Button
            onClick={handleCancelRequest}
            color="error"
            variant="contained"
          >
            Confirm
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
