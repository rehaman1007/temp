/* BIGDECIMAL FILTERS */
if (path.getJavaType().equals(BigDecimal.class)) {

    BigDecimal numberValue =
            new BigDecimal(filter.getValue().toString());

    Expression<BigDecimal> numberPath =
            path.as(BigDecimal.class);

    switch (operator) {

        case "=", "equals", "is" ->
                predicates.add(
                        cb.equal(numberPath, numberValue));

        case "!=", "not" ->
                predicates.add(
                        cb.notEqual(numberPath, numberValue));

        case ">" ->
                predicates.add(
                        cb.greaterThan(
                                numberPath,
                                numberValue));

        case ">=" ->
                predicates.add(
                        cb.greaterThanOrEqualTo(
                                numberPath,
                                numberValue));

        case "<" ->
                predicates.add(
                        cb.lessThan(
                                numberPath,
                                numberValue));

        case "<=" ->
                predicates.add(
                        cb.lessThanOrEqualTo(
                                numberPath,
                                numberValue));

        case "isEmpty" ->
                predicates.add(
                        cb.isNull(path));

        case "isNotEmpty" ->
                predicates.add(
                        cb.isNotNull(path));
    }

    continue;
}


/* LONG FILTERS */
if (path.getJavaType().equals(Long.class)) {

    Long numberValue =
            Long.valueOf(filter.getValue().toString());

    Expression<Long> numberPath =
            path.as(Long.class);

    switch (operator) {

        case "=", "equals", "is" ->
                predicates.add(
                        cb.equal(numberPath, numberValue));

        case "!=", "not" ->
                predicates.add(
                        cb.notEqual(numberPath, numberValue));

        case ">" ->
                predicates.add(
                        cb.greaterThan(numberPath, numberValue));

        case ">=" ->
                predicates.add(
                        cb.greaterThanOrEqualTo(numberPath, numberValue));

        case "<" ->
                predicates.add(
                        cb.lessThan(numberPath, numberValue));

        case "<=" ->
                predicates.add(
                        cb.lessThanOrEqualTo(numberPath, numberValue));
    }

    continue;
}

