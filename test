import React, { useMemo } from "react";
import {
  Box,
  Typography,
  Button,
  CircularProgress,
  Stack,
  Chip,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import FileDownloadIcon from "@mui/icons-material/FileDownload";
import { useTheme, useMediaQuery } from "@mui/material";
import CustomChip from "../../../utils/CustomChip";

const BalanceLedgerDataGrid = ({
  rows,
  loading,
  rowCount,
  paginationModel,
  setPaginationModel,
  sortModel,
  setSortModel,
  filterModel,
  setFilterModel,
  onExcelExport,
  exporting,
  selectedCurrency,
  selectedCircle,
  branchOptions,
  circleOptions,
  currencyOptions,
  enquiryType,
  selectedCgl,
}) => {
  const theme = useTheme();

  const isMobile = useMediaQuery(theme.breakpoints.down("sm"));
  const isTablet = useMediaQuery(theme.breakpoints.between("sm", "lg"));

  console.log("selected currency:", selectedCurrency);

  const collationColumns = useMemo(() => {
    const cols = [
      // {
      //   field: "balanceDate",
      //   headerName: "Balance Date",
      //   flex: 0.8,
      //   minWidth: 130, // slightly reduced to help mobile scrolling
      //   valueFormatter: (v) => (v ? dayjs(v).format("DD/MM/YYYY") : "-"),
      // },
      {
        field: "branchCode",
        headerName: "Branch",
        flex: 1,
        minWidth: 160,
        ...(branchOptions?.length
          ? {
              type: "singleSelect",
              valueOptions: branchOptions,
            }
          : {}),
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.branchCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.branchName}
            </Typography>
          </Box>
        ),
      },
      {
        field: "cgl",
        headerName: "CGL",
        flex: 1,
        minWidth: 160,
        type: selectedCgl.includes("All CGLs") ? "string" : "singleSelect",
        valueOptions: selectedCgl
          .filter((c) => c !== "All CGLs")
          .map((c) => c.split("-")[0].trim(" ")),
        renderCell: (params) => (
          <Box sx={{ lineHeight: 1.2, py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.cgl}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.description}
            </Typography>
          </Box>
        ),
      },
      {
        field: "currency",
        headerName: "Currency",
        flex: 1,
        minWidth: 150,
        type: "singleSelect",
        valueOptions: currencyOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: 1.2, py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.currency}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.currencyName}
            </Typography>
          </Box>
        ),
      },
      {
        field: "balance",
        headerName: "Balance",
        flex: 1,
        minWidth: 200,
        headerAlign: "right",
        align: "right",
        sortable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          const isNegative = val < 0;
          const type = isNegative ? "Dr" : "Cr";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }).format(Math.abs(val));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
                // pr: 2, // Right padding for better spacing
              }}
            >
              {/* Amount with dynamic color */}
              <Typography
                variant="body"
                fontWeight="600"
                sx={{
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  mr: 1,
                }}
              >
                {formattedAmount}
              </Typography>

              {/* Type as a small, subtle chip */}
              <CustomChip
                label={type}
                size="small"
                sx={{
                  height: 20,
                  fontSize: "0.7rem",
                  fontWeight: "700",
                  bgcolor: isNegative
                    ? "rgba(211, 47, 47, 0.08)"
                    : "rgba(46, 125, 50, 0.08)",
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  border: `1px solid ${isNegative ? "rgba(211, 47, 47, 0.2)" : "rgba(46, 125, 50, 0.2)"}`,
                }}
              />
            </Box>
          );
        },
      },

      {
        field: "inrBalance",
        headerName: "INR Balance",
        flex: 1,
        minWidth: 180,
        headerAlign: "right",
        align: "right",
        sortable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          const isNegative = val < 0;
          const type = isNegative ? "Dr" : "Cr";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            minimumFractionDigits: 2,
          }).format(Math.abs(val || 0));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
                // pr: 2, // Right padding for better spacing
              }}
            >
              {/* Amount with dynamic color */}
              <Typography
                variant="body2"
                fontWeight="600"
                sx={{
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  mr: 1,
                }}
              >
                {formattedAmount}
              </Typography>

              {/* Type as a small, subtle chip */}
              <CustomChip
                label={type}
                size="small"
                sx={{
                  height: 20,
                  fontSize: "0.7rem",
                  fontWeight: "700",
                  bgcolor: isNegative
                    ? "rgba(211, 47, 47, 0.08)"
                    : "rgba(46, 125, 50, 0.08)",
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  border: `1px solid ${isNegative ? "rgba(211, 47, 47, 0.2)" : "rgba(46, 125, 50, 0.2)"}`,
                }}
              />
            </Box>
          );
        },
      },
    ];

    if (selectedCircle === "ALL") {
      cols.splice(1, 0, {
        field: "circleCode",
        headerName: "Circle",
        flex: 1,
        minWidth: 150,
        type: "singleSelect",
        valueOptions: circleOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.circleCode}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.circleName}
            </Typography>
          </Box>
        ),
      });
    }

    return cols;
  }, [branchOptions, selectedCircle, circleOptions, selectedCgl]);

  const consolidatedColumns = useMemo(
    () => [
      {
        field: "cgl",
        headerName: "CGL",
        flex: 1,
        minWidth: 160,
        type: selectedCgl.includes("All CGLs") ? "string" : "singleSelect",
        valueOptions: selectedCgl
          .filter((c) => c !== "All CGLs")
          .map((c) => c.split("-")[0].trim(" ")),
        renderCell: (params) => (
          <Box sx={{ lineHeight: 1.2, py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.cgl}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.description}
            </Typography>
          </Box>
        ),
      },
      {
        field: "currency",
        headerName: "Currency",
        flex: 1,
        minWidth: 150,
        type: "singleSelect",
        valueOptions: currencyOptions,
        renderCell: (params) => (
          <Box sx={{ lineHeight: 1.2, py: 0.5 }}>
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, fontSize: "0.8rem" }}
            >
              {params.row.currency}
            </Typography>
            <Typography
              variant="caption"
              sx={{ color: "text.secondary", fontSize: "0.7rem" }}
            >
              {params.row.currencyName}
            </Typography>
          </Box>
        ),
      },
      {
        field: "balance",
        headerName: "Balance",
        flex: 1,
        minWidth: 200,
        headerAlign: "right",
        align: "right",
        sortable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          const isNegative = val < 0;
          const type = isNegative ? "Dr" : "Cr";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }).format(Math.abs(val));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
                pr: 2, // Right padding for better spacing
              }}
            >
              {/* Amount with dynamic color */}
              <Typography
                variant="body2"
                fontWeight="600"
                sx={{
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  mr: 1,
                }}
              >
                {formattedAmount}
              </Typography>

              {/* Type as a small, subtle chip */}
              <CustomChip
                label={type}
                size="small"
                sx={{
                  height: 20,
                  fontSize: "0.7rem",
                  fontWeight: "700",
                  bgcolor: isNegative
                    ? "rgba(211, 47, 47, 0.08)"
                    : "rgba(46, 125, 50, 0.08)",
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  border: `1px solid ${isNegative ? "rgba(211, 47, 47, 0.2)" : "rgba(46, 125, 50, 0.2)"}`,
                }}
              />
            </Box>
          );
        },
      },
      {
        field: "inrBalance",
        headerName: "INR Balance",
        flex: 1,
        minWidth: 180,
        headerAlign: "right",
        align: "right",
        sortable: false,
        renderCell: (params) => {
          const val = Number(params.value);
          const isNegative = val < 0;
          const type = isNegative ? "Dr" : "Cr";

          const formattedAmount = new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            minimumFractionDigits: 2,
          }).format(Math.abs(val || 0));

          return (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                justifyContent: "flex-end",
                height: "100%",
                width: "100%",
                // pr: 2, // Right padding for better spacing
              }}
            >
              {/* Amount with dynamic color */}
              <Typography
                variant="body2"
                fontWeight="600"
                sx={{
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  mr: 1,
                }}
              >
                {formattedAmount}
              </Typography>

              {/* Type as a small, subtle chip */}
              <CustomChip
                label={type}
                size="small"
                sx={{
                  height: 20,
                  fontSize: "0.7rem",
                  fontWeight: "700",
                  bgcolor: isNegative
                    ? "rgba(211, 47, 47, 0.08)"
                    : "rgba(46, 125, 50, 0.08)",
                  color: isNegative ? "#d32f2f" : "#2e7d32",
                  border: `1px solid ${isNegative ? "rgba(211, 47, 47, 0.2)" : "rgba(46, 125, 50, 0.2)"}`,
                }}
              />
            </Box>
          );
        },
      },
    ],
    [branchOptions, selectedCircle, circleOptions, selectedCgl],
  );

  const balanceColumns =
    enquiryType === "CONSOLIDATED" ? consolidatedColumns : collationColumns;

  const columnVisibilityModel = useMemo(
    () => ({
      branchName: false,
      circleName: false,
      ...(isMobile && {
        narration: false,
        circleCode: false,
        inrBalance: false, // Optional: Hiding INR balance on very small screens saves horizontal scroll space
      }),
      ...(isTablet && {
        narration: false,
      }),
    }),
    [isMobile, isTablet],
  );

  const CustomNoRowsOverlay = () => (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100%",
        justifyContent: "center",
        alignItems: "center",
        p: 2,
        textAlign: "center",
      }}
    >
      <ErrorOutlineIcon fontSize="large" color="action" />
      <Typography
        variant="h6"
        fontSize={{ xs: "1rem", sm: "1.2rem" }}
        color="text.secondary"
        mt={1}
      >
        No balances available for the selected criteria
      </Typography>
    </Box>
  );

  return (
    <Box
      sx={{
        width: "100%",
        height: "100%",
        mt: { xs: 2, sm: 3 },
        boxSizing: "border-box",
      }}
    >
      <Box
        sx={{
          p: { xs: 1.5, sm: 2.5 },
          mb: { xs: 2, sm: 3 },
          borderRadius: { xs: "12px", sm: "20px" },
          background: "rgba(255, 255, 255, 0.4)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255, 255, 255, 0.3)",
          boxShadow: "0 8px 32px rgba(0,0,0,0.05)",
          display: "flex",
          flexDirection: "column",
          gap: { xs: 1.5, sm: 2.5 },
        }}
      >
        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={2}
          justifyContent="space-between"
          alignItems={{ xs: "stretch", sm: "center" }}
        >
          <Box
            sx={{
              display: "flex",
              flexDirection: { xs: "column", sm: "row" },
              alignItems: { xs: "flex-start", sm: "baseline" },
              gap: { xs: 1, sm: 1.5 },
            }}
          >
            <Typography
              variant="h6"
              fontWeight={800}
              sx={{
                color: "#1a1a1a",
                letterSpacing: "-0.5px",
                fontSize: { xs: "1.1rem", sm: "1.25rem" },
              }}
            >
              Balance Ledger
            </Typography>

            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString("en-IN")} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
                width: { xs: "fit-content", sm: "auto" },
              }}
            />
          </Box>
          <Button
            variant="contained"
            size={isMobile ? "medium" : "small"}
            startIcon={
              exporting ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={!rowCount || loading || exporting}
            sx={{
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              width: { xs: "100%", sm: "auto" }, // Expands completely on mobile
              "&:hover": { bgcolor: "#45357a" },
            }}
          >
            {exporting ? "Preparing..." : "Export"}
          </Button>
        </Stack>

        <Box
          sx={{
            width: "100%",
            overflowX: "auto",
            height: {
              xs: "55vh",
              sm: "65vh",
              md: 600,
            },
          }}
        >
          <DataGrid
            rows={rows}
            columns={balanceColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) => row.Id}
            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"
            pageSizeOptions={[10, 20, 50, 100]}
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            sortModel={sortModel}
            onSortModelChange={setSortModel}
            filterModel={filterModel}
            onFilterModelChange={setFilterModel}
            rowHeight={50}
            disableRowSelectionOnClick
            slots={{ noRowsOverlay: CustomNoRowsOverlay }}
            initialState={{
              columns: {
                columnVisibilityModel,
              },
            }}
            sx={{
              borderRadius: { xs: "12px", sm: "20px" },
              backgroundColor: "rgba(255,255,255,0.4)",
              border: "1px solid rgba(255,255,255,0.3)",
              "& .MuiDataGrid-columnHeaders": {
                bgcolor: "#f8f9fa",
                fontWeight: 700,
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default BalanceLedgerDataGrid;
