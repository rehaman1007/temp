import { useEffect } from "react";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { Box } from "@mui/material";

const Home = () => {
  const navigate = useNavigate();
  const menus = useSelector((state) => state.menus.menus);

  useEffect(() => {
    // Exact structural navigation check from successful login layout configuration
    if (menus && menus.length > 0 && menus[0]?.route) {
      if (menus[0].hasChildren) {
        // Overwrites history path block using replace: true to prevent back loop traps
        navigate("/choose-option" + menus[0]?.route, { replace: true });
      } else {
        navigate(menus[0]?.route, { replace: true });
      }
    }
  }, [menus, navigate]);

  return <Box sx={{ minHeight: "60vh" }} />;
};

export default Home;
