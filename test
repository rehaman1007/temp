const handleSearch = () => {
    if (!filters.cgl || !filters.fromDate || !filters.toDate) {
      showSnackBar("Please fill all required fields", "warning");

      return;
    }

    if (filters.fromDate.isAfter(filters.toDate)) {
      showSnackBar("From date cannot be greater than To date", "warning");
      return;
    }

    if (filters.toDate.isAfter(etlDate)) {
      showSnackBar(
        `To date cannot be greater than ETL date ${dayjs(etlDate).format("DD-MM-YYYY")}`,
        "warning",
      );
      return;
    }

    if (filters.fromDate.isBefore(dayjs("31/03/2026", "DD/MM/YYYY"))) {
      showSnackBar("From date cannot be lesser than 31-03-2026", "warning");
      return;
    }

    if (filters.toDate.isBefore(dayjs("31/03/2026", "DD/MM/YYYY"))) {
      showSnackBar("To date cannot be lesser than 31-03-2026", "warning");
      return;
    }

    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));

    setSearchQuery({ ...filters });
  };
