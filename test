import React, { useState, useEffect, useMemo } from 'react';
import {
  Box,
  Paper,
  Typography,
  Grid,
  Card,
  CardContent,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Chip,
  Stack,
  InputAdornment,
  Tooltip,
  Skeleton,
  Avatar,
  LinearProgress,
} from '@mui/material';
import { PieChart } from '@mui/x-charts/PieChart';

// Icons
import HourglassEmptyIcon from '@mui/icons-material/HourglassEmpty';
import HowToRegIcon from '@mui/icons-material/HowToReg';
import PersonIcon from '@mui/icons-material/Person';
import SearchIcon from '@mui/icons-material/Search';
import AssessmentIcon from '@mui/icons-material/Assessment';
import LockIcon from '@mui/icons-material/Lock';
import ErrorOutlineIcon from '@mui/icons-material/ErrorOutline';
import PendingActionsIcon from '@mui/icons-material/PendingActions';
import PlayCircleOutlineIcon from '@mui/icons-material/PlayCircleOutline';
import useApi from '../../../../common/hooks/useApi';
import LoadingOverlay from '../../../../common/components/ui/loadingOverlay';
import FormInput from '../../../../common/components/ui/FormInput';
import InboxIcon from '@mui/icons-material/Inbox';

const formatDate = (timestamp) => {
  if (!timestamp) return 'N/A';
  try {
    const d = new Date(Number(timestamp));
    // Check if the timestamp resulted in a valid date
    if (isNaN(d.getTime())) return 'Invalid Date';

    return new Intl.DateTimeFormat('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: true,
    }).format(d);
  } catch (e) {
    return 'N/A';
  }
};

// --- Status Config Function ---
const getStatusConfig = (status) => {
  const configs = {
    null: {
      label: 'Not Initiated',
      color: '#9e9e9e',
      muiColor: 'default',
      icon: <ErrorOutlineIcon fontSize="small" />,
    },
    10: { label: 'Initiated', color: '#0288d1', muiColor: 'info', icon: <PlayCircleOutlineIcon fontSize="small" /> },
    11: { label: 'In Progress', color: '#1976d2', muiColor: 'primary', icon: <HourglassEmptyIcon fontSize="small" /> },
    20: {
      label: 'Pending Approval',
      color: '#ed6c02',
      muiColor: 'warning',
      icon: <PendingActionsIcon fontSize="small" />,
    },
    12: { label: 'Rejected', color: '#d32f2f', muiColor: 'error', icon: <ErrorOutlineIcon fontSize="small" /> },
    53: { label: 'Freezed', color: '#2e7d32', muiColor: 'success', icon: <LockIcon fontSize="small" /> },
  };
  return configs[String(status)] || configs['null'];
};

const DICGCDashboard = () => {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  const { callApi } = useApi();
  const user = JSON.parse(localStorage.getItem('user'));
  const qed = user?.quarterEndDate;

  // --- API CALL ---
  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        const response = await callApi('/bidData/get-dicgc-dashboard', { qed: '30/09/2025' });
        console.log(response);
        setData(response);
      } catch (error) {
        console.error('Failed to fetch dashboard data:', error);
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, [callApi, qed]);

  const filteredData = data.filter(
    (item) =>
      item.CIRCLE_NAME?.toLowerCase().includes(searchTerm.toLowerCase()) || item.CIRCLE_CODE?.includes(searchTerm)
  );

  // --- ANALYTICS LOGIC ---
  const chartData = useMemo(() => {
    const counts = data.reduce((acc, item) => {
      const status = String(item.MISC_STATUS);
      acc[status] = (acc[status] || 0) + 1;
      return acc;
    }, {});

    return [
      { id: 0, value: counts['null'] || 0, label: 'Not Initiated', color: '#9e9e9e' },
      { id: 1, value: counts['11'] || 0, label: 'In Progress', color: '#1976d2' },
      { id: 2, value: counts['20'] || 0, label: 'Pending Approval', color: '#ed6c02' },
      { id: 3, value: counts['53'] || 0, label: 'Freezed', color: '#2e7d32' },
      { id: 4, value: counts['12'] || 0, label: 'Rejected', color: '#d32f2f' },
    ].filter((item) => item.value > 0); // Only show statuses that have data
  }, [data]);

  // ---------- KPI CALC ----------
  const stats = useMemo(() => {
    const total = data.length;
    const freezed = data.filter((d) => d.MISC_STATUS === '53').length;
    const pending = data.filter((d) => d.MISC_STATUS !== '53').length;
    const notInitiated = data.filter((d) => !d.MISC_STATUS).length;
    const checkerPending = data.filter((d) => d.MISC_STATUS === '20').length;
    const makerPending = pending - checkerPending || 0;
    const freezedPct = total ? Math.round((freezed / total) * 100) : 0;
    const pendingPct = total ? Math.round((pending / total) * 100) : 0;
    const notInitiatedPct = total ? Math.round((notInitiated / total) * 100) : 0;
    const checkerPendingPct = pending ? Math.round((checkerPending / pending) * 100) : 0;
    const makerPendingPct = pending && checkerPending ? Math.round(((pending - checkerPending) / pending) * 100) : 0;

    return {
      total,
      freezed,
      pending,
      notInitiated,
      checkerPending,
      makerPending,
      freezedPct,
      pendingPct,
      notInitiatedPct,
      checkerPendingPct,
      makerPendingPct,
    };
  }, [data]);

  const KPI = [
    {
      key: 'ALL',
      label: 'Total',
      value: stats.total,
      pct: 100,
      icon: <AssessmentIcon />,
      color: '#1565c0',
    },

    {
      key: 'FREEZED',
      label: 'Freezed',
      value: stats.freezed,
      pct: stats.freezedPct,
      icon: <LockIcon />,
      color: '#2e7d32',
    },
    {
      key: 'NOT_INITIATED',
      label: 'Not Initiated',
      value: stats.notInitiated,
      pct: stats.notInitiatedPct,
      icon: <ErrorOutlineIcon />,
      color: '#9e9e9e',
    },

    {
      key: 'PENDING',
      label: 'Pending',
      value: stats.pending,
      pct: stats.pendingPct,
      icon: <PendingActionsIcon />,
      color: '#ed6c02',
    },

    {
      key: 'MAKER_PENDING',
      label: 'Pending With Maker',
      value: stats.makerPending,
      pct: stats.makerPendingPct,
      color: '#ed6c02',
      icon: <PendingActionsIcon />,
    },
    {
      key: 'CHECKER_PENDING',
      label: 'Pending With Checker',
      value: stats.checkerPending,
      pct: stats.checkerPendingPct,
      color: '#ed6c02',
      icon: <PendingActionsIcon />,
    },
  ];

  return (
    <>
      <Box sx={{ p: { xs: 2, md: 4 }, minHeight: '100vh' }}>
        <Typography variant="h4" align="center" fontWeight={800} gutterBottom>
          DICGC Compliance Hub
        </Typography>

        <Grid container spacing={3}>
          {/* --- LEFT: CHART --- */}
          <Grid size={{ xs: 12, md: 5 }}>
            <Paper
              sx={{
                p: 3,
                borderRadius: 4,
                height: '100%',
                display: 'flex',
                flexDirection: 'column',
                alignItems: 'center',
              }}
            >
              <Typography variant="h6" fontWeight={700} sx={{ mb: 2, alignSelf: 'flex-start' }}>
                Completion Overview
              </Typography>
              <PieChart
                series={[
                  {
                    data: chartData,
                    innerRadius: 60,
                    outerRadius: 100,
                    paddingAngle: 5,
                    cornerRadius: 5,
                  },
                ]}
                width={400}
                height={250}
                slotProps={{ legend: { direction: 'column', position: { vertical: 'middle', horizontal: 'right' } } }}
              />
            </Paper>
          </Grid>

          {/* --- RIGHT: KPI CARDS --- */}
          <Grid size={{ xs: 12, md: 7 }}>
            <Grid container spacing={2}>
              {KPI.map((k) => (
                <Grid size={{ xs: 12, sm: 4 }} key={k.key}>
                  <Card
                    sx={{
                      cursor: 'pointer',
                      //   border: '1px solid',
                      borderRadius: 3,
                      boxShadow: '0 4px 10px rgba(0,0,0,0.05)',
                    }}
                  >
                    <CardContent>
                      <Stack direction="row" justifyContent="space-between">
                        <Box>
                          <Typography variant="h4">{loading ? <Skeleton width={40} /> : k.value} Circles</Typography>

                          <Typography>{k.label}</Typography>

                          <Typography variant="caption">{k.pct}%</Typography>
                        </Box>

                        <Avatar
                          sx={{
                            bgcolor: k.color,
                          }}
                        >
                          {k.icon}
                        </Avatar>
                      </Stack>

                      <LinearProgress variant="determinate" value={k.pct} sx={{ mt: 2 }} />
                    </CardContent>
                  </Card>
                </Grid>
              ))}
            </Grid>

            {/* --- SEARCH BAR --- */}
            <Paper sx={{ mt: 3, p: 1.5, borderRadius: 3, display: 'flex', alignItems: 'center' }}>
              <FormInput
                fullWidth
                variant="standard"
                inputType="alphaNumeric"
                placeholder="Search by Circle Name or Code..."
                onChange={(e) => setSearchTerm(e.target.value)}
                InputProps={{
                  disableUnderline: true,
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchIcon color="action" />
                    </InputAdornment>
                  ),
                }}
                sx={{ ml: 1 }}
              />
            </Paper>
          </Grid>

          {/* --- TABLE: CIRCLE LIST --- */}
          <Grid size={{ xs: 12 }}>
            <TableContainer component={Paper} sx={{ borderRadius: 4, boxShadow: '0 10px 30px rgba(0,0,0,0.05)' }}>
              <Table stickyHeader>
                <TableHead>
                  <TableRow>
                    <TableCell sx={{ fontWeight: 800 }}>Circle Details</TableCell>
                    <TableCell sx={{ fontWeight: 800 }}>Maker Info</TableCell>
                    <TableCell sx={{ fontWeight: 800 }}>Maker Action Date</TableCell>
                    <TableCell sx={{ fontWeight: 800 }}>Checker Info</TableCell>
                    <TableCell sx={{ fontWeight: 800 }}>Checker Action Date</TableCell>
                    <TableCell sx={{ fontWeight: 800 }}>Current Status</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {filteredData.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={2} align="center">
                        <InboxIcon />
                        No Data Found
                      </TableCell>
                    </TableRow>
                  ) : (
                    filteredData.map((row) => {
                      const status = getStatusConfig(row.MISC_STATUS);
                      return (
                        <TableRow key={row.CIRCLE_CODE} hover>
                          <TableCell>
                            <Typography variant="body2" fontWeight={700}>
                              {row.CIRCLE_NAME}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              Code: {row.CIRCLE_CODE}
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Stack direction="row" alignItems="center" spacing={1}>
                              <PersonIcon
                                sx={{
                                  fontSize: 18,
                                  color: row.MISC_MAKERID ? 'primary.main' : 'action.disabled',
                                }}
                              />
                              <Typography
                                variant="body2"
                                sx={{
                                  fontWeight: row.MISC_MAKERID ? 600 : 400,
                                  color: row.MISC_MAKERID ? 'text.primary' : 'text.secondary',
                                }}
                              >
                                {row.MISC_MAKERID || 'Not Assigned'}
                              </Typography>
                            </Stack>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color="text.secondary">
                              {formatDate(row.MISC_MAKER_UP_DT) || '-'}
                            </Typography>
                          </TableCell>

                          <TableCell>
                            <Stack direction="row" alignItems="center" spacing={1}>
                              <Tooltip
                                title={row.MISC_CHECKERID ? `Verified by ${row.MISC_CHECKERID}` : 'Pending Check'}
                              >
                                <HowToRegIcon
                                  sx={{
                                    fontSize: 18,
                                    color: row.MISC_CHECKERID ? 'success.main' : 'action.disabled',
                                  }}
                                />
                              </Tooltip>
                              <Typography
                                variant="body2"
                                sx={{
                                  fontWeight: row.MISC_CHECKERID ? 600 : 400,
                                  color: row.MISC_CHECKERID ? 'success.dark' : 'text.secondary',
                                }}
                              >
                                {row.MISC_CHECKERID || 'Pending'}
                              </Typography>
                            </Stack>
                          </TableCell>
                          <TableCell>
                            <Typography variant="body2" color="text.secondary">
                              {formatDate(row.MISC_CHECKER_DT) || '-'}
                            </Typography>
                          </TableCell>
                          <TableCell>
                            <Chip icon={status.icon} label={status.label} color={status.muiColor} />
                          </TableCell>
                        </TableRow>
                      );
                    })
                  )}
                </TableBody>
              </Table>
            </TableContainer>
          </Grid>
        </Grid>
      </Box>

      <LoadingOverlay loading={loading} />
    </>
  );
};

export default DICGCDashboard;
