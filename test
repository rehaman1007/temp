import React, { useMemo } from "react";
import { Breadcrumbs, Link, Typography, Box } from "@mui/material";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import { useSelector } from "react-redux";
import { getParentMenu } from "../utils/CommonUtilities";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { getIconComponent } from "../utils/IconUtils";

/**
 * Static breadcrumb definitions for routes
 * that are NOT part of menu configuration
 */
const STATIC_BREADCRUMBS = {
  "/help": {
    id: "help",
    title: "Help",
    icon: "Help",
    route: "/help",
  },
};

const AppBreadcrumbs = () => {
  const selectedMenuItem = useSelector(
    (state) => state.menus.selectedMenuItem
  );
  const menus = useSelector((state) => state.menus.menus);
  const { navigateToPage } = useNavigateToPage();
  const currentPathname = window.location.pathname;

  const breadcrumbs = useMemo(() => {
    /* ------------------------------------
     * 1️⃣ Static routes (Help, About, etc.)
     * ------------------------------------ */
    if (STATIC_BREADCRUMBS[currentPathname]) {
      return [STATIC_BREADCRUMBS[currentPathname]];
    }

    /* ------------------------------------
     * 2️⃣ Menu-driven routes
     * ------------------------------------ */
    if (!selectedMenuItem) return [];

    // If selected menu has children & matches route
    if (
      selectedMenuItem.hasChildren &&
      selectedMenuItem.route === currentPathname
    ) {
      const firstChild = selectedMenuItem.children?.[0];
      return firstChild
        ? [selectedMenuItem, firstChild]
        : [selectedMenuItem];
    }

    // If top-level menu with children
    if (selectedMenuItem.hasChildren) {
      return [selectedMenuItem];
    }

    // If selected menu is child → show parent + child
    const parentMenu = getParentMenu(selectedMenuItem, menus);

    if (!parentMenu) {
      return [selectedMenuItem];
    }

    return [parentMenu, selectedMenuItem];
  }, [selectedMenuItem, currentPathname, menus]);

  if (!breadcrumbs.length) return null;

  return (
    <Breadcrumbs
      separator={<NavigateNextIcon fontSize="small" />}
      aria-label="breadcrumb"
    >
      {breadcrumbs.map((item, index) => {
        const isLast = index === breadcrumbs.length - 1;
        const IconComponent = getIconComponent(item.icon || "Apps");

        const label = (
          <Box display="flex" alignItems="center" gap={0.75}>
            <IconComponent fontSize="small" />
            <span>{item.title}</span>
          </Box>
        );

        return isLast ? (
          <Typography
            key={item.id}
            color="text.primary"
            fontWeight={600}
          >
            {label}
          </Typography>
        ) : (
          <Link
            key={item.id}
            underline="hover"
            color="inherit"
            fontWeight={600}
            sx={{ cursor: "pointer" }}
            onClick={() => navigateToPage(item)}
          >
            {label}
          </Link>
        );
      })}
    </Breadcrumbs>
  );
};

export default AppBreadcrumbs;