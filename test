package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.dto.LedgerWiseRequest;
import com.fincore.enquiry_service.model.LedgerTransaction;

import jakarta.persistence.criteria.CriteriaBuilder;
import jakarta.persistence.criteria.Path;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;

import org.springframework.data.jpa.domain.Specification;

import java.sql.Timestamp;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

public class LedgerSpecification {

    private LedgerSpecification() {
    }

    public static Specification<LedgerTransaction> build(
            LedgerWiseRequest dto
    ) {

        return (root, query, cb) -> {

            List<Predicate> predicates =
                    new ArrayList<>();

            /*
             * =========================
             * STATIC FILTERS
             * =========================
             */

            /*
             * CGL
             */
            predicates.add(
                    cb.equal(
                            root.get("cglMaster")
                                    .get("cglNumber"),
                            dto.getCgl()
                    )
            );

            /*
             * DATE RANGE
             */
            LocalDate fromDate =
                    LocalDate.parse(
                            dto.getFromDate(),
                            DateTimeFormatter.ofPattern("dd/MM/yyyy")
                    );

            LocalDate toDate =
                    LocalDate.parse(
                            dto.getToDate(),
                            DateTimeFormatter.ofPattern("dd/MM/yyyy")
                    );

            predicates.add(
                    cb.between(
                            root.get("transactionDate"),
                            Timestamp.valueOf(fromDate.atStartOfDay()),
                            Timestamp.valueOf(toDate.atTime(23, 59, 59))
                    )
            );

            /*
             * CIRCLE
             */
            if (
                    dto.getCircle() != null &&
                            !"ALL".equalsIgnoreCase(dto.getCircle())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("branch")
                                        .get("circle")
                                        .get("circleCode"),
                                dto.getCircle()
                        )
                );
            }

            /*
             * CURRENCY
             */
            if (
                    dto.getCurrencies() != null &&
                            !"ALL".equalsIgnoreCase(dto.getCurrencies())
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currencyMaster")
                                        .get("currencyCode"),
                                dto.getCurrencies()
                        )
                );
            }

            /*
             * BRANCHES
             */
            if (
                    dto.getBranches() != null &&
                            !dto.getBranches().isEmpty() &&
                            !dto.getBranches().contains("ALL")
            ) {

                CriteriaBuilder.In<Object> branchIn =
                        cb.in(
                                root.get("branch")
                                        .get("code")
                        );

                dto.getBranches()
                        .forEach(branchIn::value);

                predicates.add(branchIn);
            }

            /*
             * SOURCE FLAGS
             */
            if (
                    dto.getSourceFlags() != null &&
                            !dto.getSourceFlags().isEmpty() &&
                            !dto.getSourceFlags().contains("ALL")
            ) {

                CriteriaBuilder.In<Object> sourceIn =
                        cb.in(root.get("sourceFlag"));

                dto.getSourceFlags()
                        .forEach(sourceIn::value);

                predicates.add(sourceIn);
            }

            /*
             * =========================
             * GRID FILTERS
             * =========================
             */

            if (
                    dto.getGridFilters() != null &&
                            !dto.getGridFilters().isEmpty()
            ) {

                for (GridFilter filter : dto.getGridFilters()) {

                    if (
                            filter.getField() == null ||
                                    filter.getOperator() == null
                    ) {
                        continue;
                    }

                    Path<?> path =
                            getPath(
                                    root,
                                    filter.getField()
                            );

                    String operator =
                            filter.getOperator();

                    Object value =
                            filter.getValue();

                    /*
                     * ===================================
                     * BRANCH SEARCH
                     * SEARCH BOTH CODE + NAME
                     * ===================================
                     */
                    if (
                            "branchSearch".equals(filter.getField()) &&
                                    value != null
                    ) {

                        String searchValue =
                                value.toString().toLowerCase();

                        Predicate codePredicate =
                                cb.like(
                                        cb.lower(
                                                root.get("branch")
                                                        .get("code")
                                        ),
                                        "%" + searchValue + "%"
                                );

                        Predicate namePredicate =
                                cb.like(
                                        cb.lower(
                                                root.get("branch")
                                                        .get("name")
                                        ),
                                        "%" + searchValue + "%"
                                );

                        switch (operator) {

                            case "contains" -> predicates.add(
                                    cb.or(
                                            codePredicate,
                                            namePredicate
                                    )
                            );

                            case "doesNotContain" -> predicates.add(
                                    cb.not(
                                            cb.or(
                                                    codePredicate,
                                                    namePredicate
                                            )
                                    )
                            );

                            case "equals", "is" -> predicates.add(
                                    cb.or(
                                            cb.equal(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("code")
                                                    ),
                                                    searchValue
                                            ),
                                            cb.equal(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("name")
                                                    ),
                                                    searchValue
                                            )
                                    )
                            );

                            case "not", "doesNotEqual" -> predicates.add(
                                    cb.not(
                                            cb.or(
                                                    cb.equal(
                                                            cb.lower(
                                                                    root.get("branch")
                                                                            .get("code")
                                                            ),
                                                            searchValue
                                                    ),
                                                    cb.equal(
                                                            cb.lower(
                                                                    root.get("branch")
                                                                            .get("name")
                                                            ),
                                                            searchValue
                                                    )
                                            )
                                    )
                            );

                            case "startsWith" -> predicates.add(
                                    cb.or(
                                            cb.like(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("code")
                                                    ),
                                                    searchValue + "%"
                                            ),
                                            cb.like(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("name")
                                                    ),
                                                    searchValue + "%"
                                            )
                                    )
                            );

                            case "endsWith" -> predicates.add(
                                    cb.or(
                                            cb.like(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("code")
                                                    ),
                                                    "%" + searchValue
                                            ),
                                            cb.like(
                                                    cb.lower(
                                                            root.get("branch")
                                                                    .get("name")
                                                    ),
                                                    "%" + searchValue
                                            )
                                    )
                            );
                        }

                        continue;
                    }

                    switch (operator) {

                        /*
                         * CONTAINS
                         */
                        case "contains" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.like(
                                                cb.lower(path.as(String.class)),
                                                "%" + value.toString().toLowerCase() + "%"
                                        )
                                );
                            }
                        }

                        /*
                         * DOES NOT CONTAIN
                         */
                        case "doesNotContain" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.notLike(
                                                cb.lower(path.as(String.class)),
                                                "%" + value.toString().toLowerCase() + "%"
                                        )
                                );
                            }
                        }

                        /*
                         * EQUALS
                         */
                        case "equals", "is" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.equal(
                                                cb.lower(path.as(String.class)),
                                                value.toString().toLowerCase()
                                        )
                                );
                            }
                        }

                        /*
                         * NOT EQUALS
                         */
                        case "not", "doesNotEqual" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.notEqual(
                                                cb.lower(path.as(String.class)),
                                                value.toString().toLowerCase()
                                        )
                                );
                            }
                        }

                        /*
                         * STARTS WITH
                         */
                        case "startsWith" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.like(
                                                cb.lower(path.as(String.class)),
                                                value.toString().toLowerCase() + "%"
                                        )
                                );
                            }
                        }

                        /*
                         * ENDS WITH
                         */
                        case "endsWith" -> {

                            if (value != null) {

                                predicates.add(
                                        cb.like(
                                                cb.lower(path.as(String.class)),
                                                "%" + value.toString().toLowerCase()
                                        )
                                );
                            }
                        }

                        /*
                         * EMPTY
                         */
                        case "isEmpty" ->

                                predicates.add(
                                        cb.or(
                                                cb.isNull(path),
                                                cb.equal(
                                                        cb.trim(path.as(String.class)),
                                                        ""
                                                )
                                        )
                                );

                        /*
                         * NOT EMPTY
                         */
                        case "isNotEmpty" ->

                                predicates.add(
                                        cb.and(
                                                cb.isNotNull(path),
                                                cb.notEqual(
                                                        cb.trim(path.as(String.class)),
                                                        ""
                                                )
                                        )
                                );

                        /*
                         * MULTI SELECT
                         */
                        case "isAnyOf" -> {

                            if (value instanceof List<?> values) {

                                CriteriaBuilder.In<Object> in =
                                        cb.in(path);

                                values.forEach(in::value);

                                predicates.add(in);
                            }
                        }
                    }
                }
            }

            return cb.and(
                    predicates.toArray(
                            new Predicate[0]
                    )
            );
        };
    }

    private static Path<?> getPath(
            Root<LedgerTransaction> root,
            String field
    ) {

        return switch (field) {

            /*
             * BRANCH
             */
            case "branchCode" -> root.get("branch")
                    .get("code");

            case "branchName" -> root.get("branch")
                    .get("name");

            case "branchSearch" -> root.get("branch")
                    .get("code");

            /*
             * CIRCLE
             */
            case "circleCode" -> root.get("branch")
                    .get("circle")
                    .get("circleCode");

            case "circleName" -> root.get("branch")
                    .get("circle")
                    .get("circleName");

            /*
             * CURRENCY
             */
            case "currency" -> root.get("currencyMaster")
                    .get("currencyCode");

            case "currencyName" -> root.get("currencyMaster")
                    .get("currencyName");

            /*
             * CGL
             */
            case "cgl" -> root.get("cglMaster")
                    .get("cglNumber");

            case "description" -> root.get("cglMaster")
                    .get("description");

            default -> root.get(field);
        };
    }
}