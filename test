import React, { useState } from "react";
import {
  alpha,
  Box,
  Button,
  CircularProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";

import {
  CloudUpload,
  FilePresent,
  UploadFile,
} from "@mui/icons-material";

const UploadScript = ({
  onUpload,
  loading,
  showSnackbar,
}) => {
  const theme = useTheme();

  const [selectedFile, setSelectedFile] =
    useState(null);

  const [dragging, setDragging] =
    useState(false);

  /**
   * VALIDATE FILE
   */
  const validateFile = (file) => {
    if (!file) return;

    const fileName =
      file.name?.toLowerCase() || "";

    if (!fileName.endsWith(".sql")) {
      showSnackbar?.(
        "Only .sql files are supported",
        "error",
      );

      return;
    }

    setSelectedFile(file);
  };

  /**
   * UPLOAD
   */
  const handleUpload = () => {
    if (!selectedFile) {
      showSnackbar?.(
        "Please select SQL file",
        "warning",
      );

      return;
    }

    onUpload?.(selectedFile);
  };

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 2,
        overflow: "hidden",
        border: `1px solid ${theme.palette.divider}`,
      }}
    >
      {/* HEADER */}
      <Box
        sx={{
          px: 3,
          py: 1.5,
          background:
            "linear-gradient(135deg,#111827,#1f2937)",
          color: "white",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
          flexWrap="wrap"
          gap={2}
        >
          <Stack
            direction="row"
            spacing={1.5}
            alignItems="center"
          >
            <UploadFile />

            <Box>
              <Typography fontWeight={800}>
                SQL Script Upload
              </Typography>

              <Typography
                variant="caption"
                sx={{
                  opacity: 0.75,
                }}
              >
                Upload and execute SQL
                scripts
              </Typography>
            </Box>
          </Stack>

          <Button
            variant="contained"
            disableElevation
            startIcon={
              loading ? (
                <CircularProgress
                  size={16}
                  color="inherit"
                />
              ) : (
                <UploadFile />
              )
            }
            onClick={handleUpload}
            disabled={
              !selectedFile || loading
            }
            sx={{
              borderRadius: 2,
              background:
                "linear-gradient(135deg,#2563eb,#3b82f6)",
              minWidth: 160,
            }}
          >
            {loading
              ? "Executing..."
              : "Execute Script"}
          </Button>
        </Stack>
      </Box>

      {/* DROP ZONE */}
      <Box
        onDragOver={(e) => {
          e.preventDefault();
          setDragging(true);
        }}
        onDragLeave={() =>
          setDragging(false)
        }
        onDrop={(e) => {
          e.preventDefault();

          setDragging(false);

          validateFile(
            e.dataTransfer.files?.[0],
          );
        }}
        sx={{
          m: 2,
          p: 3,
          borderRadius: 3,
          border: `2px dashed ${
            dragging
              ? theme.palette.primary.main
              : theme.palette.divider
          }`,
          bgcolor: dragging
            ? alpha(
                theme.palette.primary.main,
                0.08,
              )
            : alpha(
                theme.palette.primary.main,
                0.02,
              ),
          transition: "all .2s ease",
          textAlign: "center",
        }}
      >
        {!selectedFile ? (
          <>
            <CloudUpload
              sx={{
                fontSize: 48,
                color:
                  theme.palette.primary.main,
              }}
            />

            <Typography
              fontWeight={700}
              mt={1}
            >
              Drag & Drop SQL File
            </Typography>

            <Typography
              variant="body2"
              color="text.secondary"
              mt={0.5}
            >
              Or browse from your system
            </Typography>

            <Button
              component="label"
              variant="outlined"
              sx={{
                mt: 2,
                borderRadius: 2,
              }}
            >
              Browse File

              <input
                hidden
                type="file"
                accept=".sql"
                onChange={(e) =>
                  validateFile(
                    e.target.files?.[0],
                  )
                }
              />
            </Button>
          </>
        ) : (
          <Stack
            spacing={1}
            alignItems="center"
          >
            <FilePresent
              color="primary"
              sx={{
                fontSize: 42,
              }}
            />

            <Typography
              fontWeight={700}
            >
              {selectedFile.name}
            </Typography>

            <Typography
              variant="body2"
              color="text.secondary"
            >
              Size :{" "}
              {(
                selectedFile.size /
                1024 /
                1024
              ).toFixed(2)}
              {" "}MB
            </Typography>

            <Button
              size="small"
              color="error"
              onClick={() =>
                setSelectedFile(null)
              }
            >
              Remove File
            </Button>

            <Button
              component="label"
              size="small"
              variant="outlined"
            >
              Change File

              <input
                hidden
                type="file"
                accept=".sql"
                onChange={(e) =>
                  validateFile(
                    e.target.files?.[0],
                  )
                }
              />
            </Button>
          </Stack>
        )}
      </Box>
    </Paper>
  );
};

export default UploadScript;