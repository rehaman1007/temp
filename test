import React, { useMemo } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Container,
  Stack,
  useTheme,
  alpha,
  styled,
} from "@mui/material";
import { motion } from "framer-motion";
import {
  ChevronRight as ChevronRightIcon,
  InfoOutlined as InfoOutlinedIcon,
} from "@mui/icons-material";
import { useNavigate } from "react-router-dom";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { getIconComponent } from "../utils/IconUtils";

// ======================================================================
// Framer Motion Variants
// ======================================================================

const MotionCard = motion.create(Card);
const MotionBox = motion.create(Box);

const pageVariants = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: { staggerChildren: 0.1, delayChildren: 0.1 },
  },
};

const fadeUpVariants = {
  hidden: { opacity: 0, y: 20 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.5, ease: [0.4, 0, 0.2, 1] },
  },
};

const cardMotionVariants = {
  hidden: { opacity: 0, y: 20 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.4, ease: [0.4, 0, 0.2, 1] },
  },
  hover: {
    scale: 1.02,
    y: -6,
    transition: { duration: 0.2, ease: [0.4, 0, 0.2, 1] },
  },
};

const getIconMotionVariants = (theme) => ({
  initial: {
    scale: 1,
    backgroundColor: alpha(theme.palette.background.paper, 0.1),
    boxShadow: `0 0 0px ${alpha(theme.palette.primary.main, 0)}`,
  },
  hover: {
    scale: 1.15,
    backgroundColor: alpha(theme.palette.background.paper, 0.18),
    boxShadow: `0 0 ${theme.spacing(2.5)} ${alpha(theme.palette.primary.main, 0.3)}`,
    transition: {
      scale: { type: "spring", stiffness: 260, damping: 12 },
      default: { duration: 0.2, ease: "easeInOut" },
    },
  },
});

const getChevronMotionVariants = (theme) => ({
  initial: { x: 0, opacity: 0.6 },
  hover: {
    x: theme.spacing(0.75),
    opacity: 1,
    transition: { duration: 0.25, ease: "easeOut" },
  },
});

// ======================================================================
// Main Component
// ======================================================================

const SubmenuSelectionPage = () => {
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const { navigateToPage } = useNavigateToPage();
  const navigate = useNavigate();
  const theme = useTheme();

  // Redirect if accessed directly without selection
  if (!selectedMenuItem) {
    navigate("/");
    return null; // Prevent rendering while redirecting
  }

  const submenuOptions = useMemo(
    () => selectedMenuItem?.children || [],
    [selectedMenuItem]
  );

  const iconVariants = useMemo(() => getIconMotionVariants(theme), [theme]);
  const chevronVariants = useMemo(() => getChevronMotionVariants(theme), [theme]);

  // Format description list safely
  const formattedDescription = useMemo(
    () =>
      submenuOptions
        .map((child) => child?.screenDescription)
        .filter(Boolean)
        .join(", "),
    [submenuOptions]
  );

  return (
    <StyledSubmenuRootCard 
      aria-label={`${selectedMenuItem?.title} submenu`}
      component={motion.div}
      variants={pageVariants}
      initial="hidden"
      animate="visible"
    >
      {/* === Header === */}
      <HeaderBox variants={fadeUpVariants}>
        <HeaderTitle variant="h4" component="h1">
          {selectedMenuItem?.title}
        </HeaderTitle>
        {formattedDescription && (
          <HeaderDescription variant="body1" color="text.secondary">
            {formattedDescription}
          </HeaderDescription>
        )}
      </HeaderBox>

      {/* === Cards Section === */}
      <Container maxWidth="lg" sx={{ mb: { xs: 4, md: 6 } }}>
        <GridContainer>
          {submenuOptions.map((menu) => {
            const MenuIcon = getIconComponent(menu.icon);

            return (
              <StyledMotionCard
                key={menu.id}
                variants={cardMotionVariants}
                whileHover="hover"
                initial="initial" // Triggers children to use 'initial' state
                onClick={() => navigateToPage(menu)}
                tabIndex={0}
                role="button"
                aria-label={`Maps to ${menu.title}`}
                onKeyDown={(e) => {
                  if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    navigateToPage(menu);
                  }
                }}
              >
                <StyledCardContent>
                  <Stack
                    direction="row"
                    alignItems="center"
                    spacing={2}
                    sx={{ width: "100%" }}
                  >
                    {/* Icon */}
                    <IconContainer variants={iconVariants}>
                      {MenuIcon && (
                        <MenuIcon
                          sx={{
                            fontSize: {
                              xs: theme.typography.h4.fontSize,
                              sm: theme.typography.h3.fontSize,
                            },
                          }}
                        />
                      )}
                    </IconContainer>

                    {/* Text */}
                    <TextContainer>
                      <Typography
                        variant="subtitle1"
                        sx={{
                          fontWeight: theme.typography.fontWeightMedium,
                          mb: 0.5,
                          letterSpacing: "-0.01em",
                        }}
                      >
                        {menu.title}
                      </Typography>
                      <Typography
                        variant="body2"
                        color="text.secondary"
                        sx={{ opacity: 0.85 }}
                      >
                        {menu.screenDescription}
                      </Typography>
                    </TextContainer>

                    {/* Chevron */}
                    <ChevronContainer variants={chevronVariants}>
                      <ChevronRightIcon
                        sx={{
                          fontSize: {
                            xs: theme.typography.h5.fontSize,
                            sm: theme.typography.h4.fontSize,
                          },
                        }}
                      />
                    </ChevronContainer>
                  </Stack>
                </StyledCardContent>
              </StyledMotionCard>
            );
          })}
        </GridContainer>
      </Container>

      {/* === Footer === */}
      <InfoFooter variants={fadeUpVariants}>
        <Stack
          direction="row"
          justifyContent="center"
          alignItems="center"
          spacing={1.5}
          flexWrap="wrap"
        >
          <InfoOutlinedIcon
            sx={{
              color: alpha(theme.palette.text.primary, 0.9),
              fontSize: { xs: theme.typography.h6.fontSize, sm: theme.typography.h5.fontSize },
            }}
          />
          <Typography variant="body2" sx={{ opacity: 0.85 }}>
            Click on any of the above options to access the corresponding{" "}
            <Box component="span" sx={{ fontWeight: "medium" }}>
              {selectedMenuItem?.title}
            </Box>{" "}
            features.
          </Typography>
        </Stack>
      </InfoFooter>
    </StyledSubmenuRootCard>
  );
};

export default React.memo(SubmenuSelectionPage);

// ======================================================================
// Styled Components
// ======================================================================

