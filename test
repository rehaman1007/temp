import React, { useState } from "react";
import {
  Box,
  Button,
  Container,
  Paper,
  TextField,
  Typography,
  ToggleButton,
  ToggleButtonGroup,
  Alert,
  CssBaseline,
  ThemeProvider,
  createTheme,
  InputAdornment,
  IconButton,
  Tooltip,
  Snackbar,
  Grid,
} from "@mui/material";

// Icons
import LockOutlinedIcon from "@mui/icons-material/LockOutlined";
import LockOpenOutlinedIcon from "@mui/icons-material/LockOpenOutlined";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import ContentCopyIcon from "@mui/icons-material/ContentCopy";
import DeleteOutlineIcon from "@mui/icons-material/DeleteOutlined";

// Your custom assets (ensure these paths are correct relative to App.jsx)
import LogoImg from "../src/assets/Fincore_logo.svg";
import fTitle from "../src/assets/Fincore_title.png";
import backgroundImage from "../src/assets/Fincore_bg.png";

// Ensure this path matches where you placed your copied crypto utility
import { encryptPayload, decryptPayload } from "./utils/cryptoUtil";

// Custom theme to match the Fincore application styling
const theme = createTheme({
  palette: {
    mode: "light",
    primary: {
      main: "#4a47a3", // Matches the deep purple/blue of the Fincore buttons
    },
    background: {
      default: "#f8f9fa",
    },
  },
  typography: {
    fontFamily: '"Roboto", "Helvetica", "Arial", sans-serif',
  },
  shape: {
    borderRadius: 12,
  },
});

export default function App() {
  const [mode, setMode] = useState("decrypt");
  const [sessionKey, setSessionKey] = useState("");
  const [inputData, setInputData] = useState("");
  const [outputData, setOutputData] = useState("");
  const [showKey, setShowKey] = useState(false);

  // Unified Snackbar State
  const [snackbar, setSnackbar] = useState({
    open: false,
    message: "",
    severity: "success",
  });

  // --- Handlers ---
  const handleCloseSnackbar = (event, reason) => {
    if (reason === "clickaway") return;
    setSnackbar((prev) => ({ ...prev, open: false }));
  };

  const showNotification = (message, severity = "error") => {
    setSnackbar({
      open: true,
      message,
      severity,
    });
  };

  const handleModeChange = (event, newMode) => {
    if (newMode !== null) {
      setMode(newMode);
      setInputData("");
      setOutputData("");
    }
  };

  const handleClearPayload = () => {
    setInputData("");
    setOutputData("");
    showNotification("Payload cleared.", "info");
  };

  const handleCopy = (textToCopy, successMessage = "Copied to clipboard!") => {
    if (textToCopy) {
      navigator.clipboard.writeText(textToCopy);
      showNotification(successMessage, "success");
    }
  };

  // Format output for structured display
  const formatOutput = (data) => {
    if (typeof data === "object") {
      return JSON.stringify(data, null, 2);
    }
    try {
      const parsed = JSON.parse(data);
      return JSON.stringify(parsed, null, 2);
    } catch (e) {
      return String(data);
    }
  };

  const handleProcess = async () => {
    setOutputData("");

    if (!sessionKey.trim()) {
      showNotification("Session Key is required.", "warning");
      return;
    }
    if (!inputData.trim()) {
      showNotification("Please provide a payload to process.", "warning");
      return;
    }

    try {
      if (mode === "decrypt") {
        const decryptedRaw = await decryptPayload(
          inputData.trim(),
          sessionKey.trim(),
        );
        setOutputData(formatOutput(decryptedRaw));
        showNotification("Payload decrypted successfully!", "success");
      } else {
        let parsedInput;
        try {
          parsedInput = JSON.parse(inputData);
        } catch (err) {
          console.error(err);
          showNotification(
            "Invalid JSON format. Please ensure your payload is valid JSON before encrypting.",
            "error",
          );
          return;
        }

        const encryptedString = await encryptPayload(
          parsedInput,
          sessionKey.trim(),
        );
        setOutputData(encryptedString);
        showNotification("Payload encrypted successfully!", "success");
      }
    } catch (err) {
      console.error(err);
      showNotification(
        err.message ||
          `Failed to ${mode} payload. Ensure your key and payload are correct.`,
        "error",
      );
    }
  };

  // The command used to fetch the key from DevTools
  const localStorageCmd = 'localStorage.getItem("payloadEncryptionKey")';

  return (
    <ThemeProvider theme={theme}>
      <CssBaseline />

      {/* Main Container with Background applied directly */}
      <Box
        sx={{
          minHeight: "100vh",
          minWidth: "100%",
          display: "flex",
          py: 12,
          alignitems: "center",
          backgroundImage: `url(${backgroundImage})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
          backgroundRepeat: "no-repeat",
          backgroundAttachment: "fixed",
          overflow: "hidden",
          transition:
            "filter 0.6s ease-in-out, background-image 0.6s ease-in-out",
        }}
      >
        <Container>
          <Grid container spacing={6} gap={8} alignitems="center">
            {/* Left Column: Branding and Instructions */}
            <Grid size={{ xs: 12, md: 6 }}>
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  gap: theme.spacing(2),
                  margin: "0% 0 2% 0",
                }}
              >
                <>
                  <Box
                    component="img"
                    src={LogoImg}
                    alt="Logo Icon"
                    sx={{ width: 150, height: 150, objectFit: "contain" }}
                  />
                  <div>
                    <Box
                      component="img"
                      src={fTitle}
                      alt="FinCore"
                      sx={{
                        height: 35, // Adjust height to match your icon's scale
                        width: "auto",
                        display: "block",
                        mt: 5,
                        mb: 1,
                      }}
                    />
                    {/* <BrandTitle>{content?.brand?.title}</BrandTitle> */}
                    <Typography
                      sx={{
                        fontSize: "1rem",
                        color: theme.palette.text.secondary,
                      }}
                    >
                      Insight Driven General Ledger
                    </Typography>
                  </div>
                </>
              </Box>

              <Box>
                <Box
                  sx={{
                    flex: "1 1 50%",
                    display: "flex",
                    flexDirection: "column",
                    gap: theme.spacing(3),
                    justifyContent: "center",
                    [theme.breakpoints.down("md")]: {
                      flex: "1 1 100%",
                    },
                  }}
                >
                  <Box sx={{ mb: 1 }}>
                    <Typography
                      sx={{
                        fontWeight: 800,
                        fontSize: "1.5rem",
                        lineHeight: 1.3,
                        color: "#402b7f",
                        marginBottom: theme.spacing(0.4),
                        [theme.breakpoints.down("sm")]: { fontSize: 24 },
                      }}
                    >
                      Welcome to FinCore utility
                    </Typography>

                    <Typography
                      sx={{
                        fontSize: "1.2rem",
                        fontWeight: 500,
                        color: "#402b7f",
                        display: "block",
                      }}
                    >
                      Secure Decryptor or Encryptor for FinCore application
                    </Typography>
                  </Box>

                  <Typography
                    sx={{
                      fontSize: "1rem",
                      fontWeight: 500,
                      color: "#402b7f",
                      display: "block",
                    }}
                  >
                    FinCore Application Utility provides a centralized platform
                    for this localized utility which allows you to securely
                    decrypt responses and encrypt payloads for the FinCore
                    application.
                  </Typography>
                </Box>
              </Box>

              {/* Guiding Steps Panel */}
              <Paper
                elevation={0}
                sx={{
                  p: 3,
                  borderRadius: 3,
                  backgroundColor: "rgba(255, 255, 255, 0.9)",
                  border: "1px solid #e0e0e0",
                  mt: 4,
                  textAlign: "left",
                }}
              >
                <Typography variant="h6" fontWeight="bold" gutterBottom>
                  Guiding Steps to Obtain Session Key
                </Typography>
                <ol
                  style={{
                    paddingLeft: "1.2rem",
                    color: "#444",
                    lineHeight: 1.8,
                    margin: "1rem 0",
                  }}
                >
                  <li>Open your main FinCore application in a new tab.</li>
                  <li>
                    Press <strong>F12</strong> (or right-click → Inspect) to
                    open Developer Tools.
                  </li>
                  <li>
                    Navigate to the <strong>'Console'</strong> tab.
                  </li>
                  <li>
                    Copy and paste the command below into the console, hit
                    Enter, and copy the string it returns.
                  </li>
                </ol>

                <Box
                  sx={{
                    display: "flex",
                    alignitems: "center",
                    mt: 2,
                    backgroundColor: "#1e1e1e",
                    borderRadius: 2,
                    p: 1,
                    pl: 2,
                  }}
                >
                  <Typography
                    variant="body2"
                    sx={{
                      fontFamily: "monospace",
                      color: "#a5d6ff",
                      flexGrow: 1,
                      overflowX: "auto",
                      pt: 1,
                      pl: 1,
                    }}
                  >
                    {localStorageCmd}
                  </Typography>
                  <Tooltip title="Copy Command">
                    <IconButton
                      onClick={() =>
                        handleCopy(localStorageCmd, "Command copied!")
                      }
                      sx={{ color: "#fff", pr: 1 }}
                    >
                      <ContentCopyIcon fontSize="small" />
                    </IconButton>
                  </Tooltip>
                </Box>
              </Paper>
            </Grid>

            {/* Right Column: The Utility Tool */}
            <Grid size={{ xs: 12, md: 6 }}>
              <Paper
                elevation={6}
                sx={{
                  p: { xs: 3, sm: 4 },
                  borderRadius: 4,
                  backgroundColor: "#fff",
                }}
              >
                <Box sx={{ display: "flex", justifyContent: "center", mb: 4 }}>
                  <ToggleButtonGroup
                    color="primary"
                    value={mode}
                    exclusive
                    onChange={handleModeChange}
                    aria-label="Operation Mode"
                    fullWidth
                  >
                    <ToggleButton
                      value="decrypt"
                      aria-label="decrypt"
                      sx={{ py: 1.5, fontWeight: "bold" }}
                    >
                      <LockOpenOutlinedIcon sx={{ mr: 1 }} />
                      Decrypt Response
                    </ToggleButton>
                    <ToggleButton
                      value="encrypt"
                      aria-label="encrypt"
                      sx={{ py: 1.5, fontWeight: "bold" }}
                    >
                      <LockOutlinedIcon sx={{ mr: 1 }} />
                      Encrypt Request
                    </ToggleButton>
                  </ToggleButtonGroup>
                </Box>

                {/* Hidden Session Key with Hold-to-View */}
                <TextField
                  fullWidth
                  label="Session Key (payloadEncryptionKey)"
                  variant="outlined"
                  type={showKey ? "text" : "password"}
                  value={sessionKey}
                  onChange={(e) => setSessionKey(e.target.value)}
                  sx={{ mb: 3 }}
                  autoComplete="off"
                  slotProps={{
                    input: {
                      endAdornment: (
                        <InputAdornment position="end">
                          <Tooltip
                            title="Hold to view key"
                            placement="top"
                            arrow
                          >
                            <IconButton
                              onPointerDown={() => setShowKey(true)}
                              onPointerUp={() => setShowKey(false)}
                              onPointerLeave={() => setShowKey(false)}
                              sx={{
                                cursor: "grab",
                                "&:active": { cursor: "grabbing" },
                              }}
                            >
                              {showKey ? (
                                <VisibilityIcon />
                              ) : (
                                <VisibilityOffIcon />
                              )}
                            </IconButton>
                          </Tooltip>
                        </InputAdornment>
                      ),
                    },
                  }}
                />

                <TextField
                  fullWidth
                  multiline
                  rows={5}
                  label={
                    mode === "decrypt" ? "Encrypted String" : "JSON Payload"
                  }
                  variant="outlined"
                  value={inputData}
                  onChange={(e) => setInputData(e.target.value)}
                  placeholder={
                    mode === "decrypt"
                      ? "Paste the encrypted string here..."
                      : '{\n  "key": "value"\n}'
                  }
                  sx={{ mb: 3 }}
                  autoComplete="off"
                  spellCheck="false"
                />

                {/* Action Buttons */}
                <Box sx={{ display: "flex", gap: 2, mb: 4 }}>
                  <Button
                    variant="outlined"
                    size="large"
                    color="inherit"
                    onClick={handleClearPayload}
                    startIcon={<DeleteOutlineIcon />}
                    sx={{ flex: 1, py: 1.5 }}
                  >
                    Clear Payload
                  </Button>
                  <Button
                    variant="contained"
                    size="large"
                    onClick={handleProcess}
                    sx={{ flex: 2, py: 1.5, fontWeight: "bold" }}
                  >
                    {mode === "decrypt"
                      ? "Decrypt / Execute"
                      : "Encrypt / Execute"}
                  </Button>
                </Box>

                {/* Structured Output Section */}
                <Box
                  sx={{
                    backgroundColor: "#1e1e1e",
                    borderRadius: 2,
                    overflow: "hidden",
                    border: "1px solid #333",
                  }}
                >
                  <Box
                    sx={{
                      display: "flex",
                      justifyContent: "space-between",
                      alignitems: "center",
                      backgroundColor: "#2d2d2d",
                      px: 2,
                      py: 1,
                      borderBottom: "1px solid #444",
                    }}
                  >
                    <Typography
                      variant="body2"
                      sx={{ color: "#e0e0e0", fontWeight: 500 }}
                    >
                      Output Result
                    </Typography>
                    <Tooltip title="Copy Result">
                      <span>
                        <IconButton
                          size="small"
                          onClick={() =>
                            handleCopy(
                              outputData,
                              "Result copied to clipboard!",
                            )
                          }
                          disabled={!outputData}
                          sx={{ color: "#aaa", "&:hover": { color: "#fff" } }}
                        >
                          <ContentCopyIcon fontSize="small" />
                        </IconButton>
                      </span>
                    </Tooltip>
                  </Box>
                  <Box
                    sx={{
                      p: 2,
                      minHeight: "140px",
                      maxHeight: "300px",
                      overflow: "auto",
                      textAlign: "left",
                    }}
                  >
                    {outputData ? (
                      <pre
                        style={{
                          margin: 0,
                          color: "#4caf50",
                          fontFamily: "monospace",
                          whiteSpace: "pre-wrap",
                          wordBreak: "break-all",
                        }}
                      >
                        {outputData}
                      </pre>
                    ) : (
                      <Typography
                        variant="body2"
                        sx={{ color: "#666", fontStyle: "italic" }}
                      >
                        Awaiting execution...
                      </Typography>
                    )}
                  </Box>
                </Box>
              </Paper>
            </Grid>
          </Grid>
        </Container>
      </Box>

      {/* Global Snackbar Notification */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: "bottom", horizontal: "center" }}
      >
        <Alert
          onClose={handleCloseSnackbar}
          severity={snackbar.severity}
          variant="filled"
          sx={{ width: "100%", boxShadow: 3 }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}
