public static Specification<GlTransactions> strictlyBefore(LocalDate date, String id, String sortOrder) {
    return (root, query, cb) -> {
        boolean isDesc = "DESC".equalsIgnoreCase(sortOrder);

        // If descending, "before" in the list means chronologically AFTER in time.
        Predicate dateCondition = isDesc ? 
                cb.greaterThan(root.get("transactionDate"), date) : 
                cb.lessThan(root.get("transactionDate"), date);

        Predicate sameDateCondition = cb.equal(root.get("transactionDate"), date);
        
        // Tie-breaker using transactionId
        Predicate idCondition = isDesc ? 
                cb.greaterThan(root.get("transactionId").as(String.class), id) : 
                cb.lessThan(root.get("transactionId").as(String.class), id);

        return cb.or(dateCondition, cb.and(sameDateCondition, idCondition));
    };
}



