import { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Box,
  Typography,
  IconButton,
  RadioGroup,
  FormControlLabel,
  Radio,
  FormControl,
  FormLabel,
  MenuItem,
  Autocomplete,
  Divider,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import FilterBuilder from "../filter-builder/FilterBuilder";
import { useTableConfig } from "../../hooks/useTableConfig";

const variableModeOptions = [
  { value: "INPUT", label: "Input" },
  { value: "EXPRESSION", label: "Expression" },
  { value: "QUERY", label: "Query" },
];

const variableTypeOptions = [
  { value: "DB_VALUE", label: "DB Value" },
  { value: "DB_COUNT", label: "DB Count" },
  { value: "DB_SUM", label: "DB Sum" },
  { value: "DB_AVG", label: "DB Average" },
  { value: "DB_MIN", label: "DB Min" },
  { value: "DB_MAX", label: "DB Max" },
];

const defaultState = {
  variable: "",
  variableName: "",
  variableDescription: "",
  mode: "INPUT",
  type: "",
  source: {
    table: "",
    column: "",
    aggFunc: "",
    filters: {},
  },
};

export const GlobalVariableDailog = ({
  open,
  globalVariable,
  onClose,
  onSave,
}) => {
  const { tableConfigs, getSelectableColumns, getAllowedAggFuncs } =
    useTableConfig();

  const [form, setForm] = useState(defaultState);
  const [errors, setErrors] = useState({});

  useEffect(() => {
    setForm(globalVariable || defaultState);
    setErrors({});
  }, [globalVariable, open]);

  const update = (path, value) => {
    if (path.startsWith("source.")) {
      const key = path.split(".")[1];
      setForm((p) => ({ ...p, source: { ...p.source, [key]: value } }));
    } else {
      setForm((p) => ({ ...p, [path]: value }));
    }
  };

  /* ---------------- VALIDATION ---------------- */

  const validate = () => {
    const e = {};

    if (!form.variable) e.variable = "Required";
    if (!form.variableName) e.variableName = "Required";

    if (form.mode === "QUERY") {
      if (!form.type) e.type = "Select type";
      if (!form.source.table) e.table = "Select table";
      if (!form.source.column) e.column = "Select column";
    }

    setErrors(e);
    return Object.keys(e).length === 0;
  };

  const handleSave = () => {
    if (!validate()) return;
    onSave(form);
    onClose();
  };

  const selectedTable =
    tableConfigs?.find((t) => t.tableName === form.source.table) || null;

  const columns = selectedTable
    ? getSelectableColumns(selectedTable.tableName)
    : [];

  const aggFuncs =
    form.source.column && selectedTable
      ? getAllowedAggFuncs(
          selectedTable.tableName,
          form.source.column,
        )
      : [];

  /* ---------------- UI ---------------- */

  return (
    <Dialog open={open} onClose={onClose} maxWidth="md" fullWidth>
      <DialogTitle>
        <Typography fontWeight={600}>
          {globalVariable ? "Edit Variable" : "Add Global Variable"}
        </Typography>
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 16, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: { xs: "1fr", md: "1fr 1fr" },
            gap: 2,
          }}
        >
          {/* Variable */}
          <TextField
            label="Variable"
            required
            value={form.variable}
            inputProps={{ maxLength: 30 }}
            error={!!errors.variable}
            helperText={errors.variable || "Used as {{VAR_NAME}}"}
            onChange={(e) =>
              update(
                "variable",
                e.target.value.replace(/\s/g, "_").toUpperCase(),
              )
            }
          />

          {/* Name */}
          <TextField
            label="Variable Name"
            required
            value={form.variableName}
            inputProps={{ maxLength: 50 }}
            error={!!errors.variableName}
            helperText={errors.variableName}
            onChange={(e) => update("variableName", e.target.value)}
          />

          {/* Description */}
          <TextField
            label="Description"
            multiline
            rows={2}
            value={form.variableDescription}
            inputProps={{ maxLength: 200 }}
            onChange={(e) =>
              update("variableDescription", e.target.value)
            }
            sx={{ gridColumn: "1/-1" }}
          />

          {/* Mode */}
          <FormControl sx={{ gridColumn: "1/-1" }}>
            <FormLabel>Variable Mode</FormLabel>
            <RadioGroup
              row
              value={form.mode}
              onChange={(e) => update("mode", e.target.value)}
            >
              {variableModeOptions.map((m) => (
                <FormControlLabel
                  key={m.value}
                  value={m.value}
                  control={<Radio />}
                  label={m.label}
                />
              ))}
            </RadioGroup>
          </FormControl>
        </Box>

        {/* QUERY SECTION */}
        {form.mode === "QUERY" && (
          <>
            <Divider sx={{ my: 2 }} />

            <Box
              sx={{
                display: "grid",
                gridTemplateColumns: { xs: "1fr", md: "1fr 1fr" },
                gap: 2,
              }}
            >
              {/* Type */}
              <TextField
                select
                label="Variable Type"
                value={form.type}
                error={!!errors.type}
                helperText={errors.type}
                onChange={(e) => update("type", e.target.value)}
              >
                {variableTypeOptions.map((t) => (
                  <MenuItem key={t.value} value={t.value}>
                    {t.label}
                  </MenuItem>
                ))}
              </TextField>

              {/* Table */}
              {form.type && (
                <Autocomplete
                  options={tableConfigs || []}
                  getOptionLabel={(o) => o.label || ""}
                  value={selectedTable}
                  onChange={(_, v) =>
                    update("source.table", v?.tableName || "")
                  }
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Table"
                      error={!!errors.table}
                      helperText={errors.table}
                    />
                  )}
                />
              )}

              {/* Column */}
              {form.source.table && (
                <Autocomplete
                  options={columns || []}
                  getOptionLabel={(o) => o.label || ""}
                  onChange={(_, v) =>
                    update("source.column", v?.columnName || "")
                  }
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Column"
                      error={!!errors.column}
                      helperText={errors.column}
                    />
                  )}
                />
              )}

              {/* Aggregation */}
              {aggFuncs?.length > 0 && (
                <TextField
                  select
                  label="Aggregation"
                  value={form.source.aggFunc}
                  onChange={(e) =>
                    update("source.aggFunc", e.target.value)
                  }
                >
                  {aggFuncs.map((a) => (
                    <MenuItem key={a} value={a}>
                      {a}
                    </MenuItem>
                  ))}
                </TextField>
              )}
            </Box>

            {/* Filters */}
            {form.source.table && (
              <Box sx={{ mt: 2 }}>
                <Typography fontWeight={600} mb={1}>
                  Filter Conditions
                </Typography>

                <FilterBuilder
                  filters={form.source.filters}
                  tableName={form.source.table}
                  onFiltersChange={(f) =>
                    update("source.filters", f)
                  }
                />
              </Box>
            )}
          </>
        )}
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={handleSave}>
          {globalVariable ? "Save Changes" : "Add Variable"}
        </Button>
      </DialogActions>
    </Dialog>
  );
};