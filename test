import React, { useEffect, useState } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  Chip,
  List,
  ListItem,
  ListItemText,
  Divider,
  Grid,
} from "@mui/material";

import {
  PieChart,
  Pie,
  Cell,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  Legend,
} from "recharts";
import useApi from "../../hooks/useApi";
import { DashboardHead } from "./components/DashboardHead";

const COLORS = ["#7b61ff", "#a6a5ff", "#82ca9d", "#ffc658", "#ff7f50"];

function getSeverityColor(severity) {
  switch (severity) {
    case "WARN":
      return "warning";
    case "ERROR":
      return "error";
    case "INFO":
    default:
      return "info";
  }
}

function mapLabelMap(key) {
  const labelMap = {
    BRANCH: "Branch",
    CURRENCY: "Currency",
    ROLE_MANAGEMENT: "Role Management",
    SEGMENT: "Segment",
    CGL: "CGL",
    STATE: "State",
    USER_MANAGEMENT: "User Management",
    CALENDER: "Calendar",
    CIRCLE: "Circle",
  };
  return labelMap[key] || key;
}

const DashboardPage = () => {
  const { callApi } = useApi();
  const [rawData, setRawData] = useState(null);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const load = async () => {
      setLoading(true);
      try {
        const res = await callApi("/DS/dashboard/init", null, "GET");
        console.log(res);

        if (res?.success) setRawData(res.data);
      } catch (e) {
        console.error("Failed to load dashboard", e);
      } finally {
        setLoading(false);
      }
    };
    load();
  }, [callApi]);

  if (loading || !rawData) {
    return (
      <Box p={3}>
        <Typography variant="body1">Loading dashboard…</Typography>
      </Box>
    );
  }

  const stats = rawData.stats || {};

  const buildPieFromDetailObj = (detailObj) =>
    Object.entries(detailObj || {}).map(([k, v]) => ({
      label: mapLabelMap(k),
      value: v,
    }));

  const myPendingPie = buildPieFromDetailObj(stats.myPendingDetails);
  const myApprovedPie = buildPieFromDetailObj(stats.myApprovedDetails);
  const myRejectedPie = buildPieFromDetailObj(stats.myRejectedDetails);
  const pendingForMePie = buildPieFromDetailObj(stats.pendingForMeDetails);

  // bar data: Pending vs Approved vs Rejected (module-wise)
  const allModules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {}),
  ]);
  const statusByModule = Array.from(allModules).map((m) => ({
    module: mapLabelMap(m),
    pending: stats.myPendingDetails?.[m] || 0,
    approved: stats.myApprovedDetails?.[m] || 0,
    rejected: stats.myRejectedDetails?.[m] || 0,
  }));

  return (
    <Box p={3}>
      {/* Row 1 & Row 2: user Info cards (Financial Year / Circle / Branch) full width */}
      <DashboardHead />
      {/* Row 3: Module-wise bar chart - full width single row */}
      <Grid container spacing={2} mb={3}>
        <Grid size={{ xs: 12 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Pending vs Approved vs Rejected (Module-wise)
              </Typography>

              <Box sx={{ width: "100%", height: 320 }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={statusByModule}>
                    <XAxis dataKey="module" />
                    <YAxis />
                    <Tooltip />
                    <Legend />
                    <Bar dataKey="pending" name="Pending" fill="#7b61ff" />
                    <Bar dataKey="approved" name="Approved" fill="#82ca9d" />
                    <Bar dataKey="rejected" name="Rejected" fill="#ff7f50" />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* Row 4: Four small charts (two rows visually, but in a single Grid with 4 cols) */}
      <Grid container spacing={2} mb={3}>
        <Grid size={{ xs: 12, md: 3 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                My Approved (Module-wise)
              </Typography>
              <Box sx={{ width: "100%", height: 220 }}>
                {myApprovedPie && myApprovedPie.length ? (
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={myApprovedPie}
                        dataKey="value"
                        nameKey="label"
                        innerRadius="30%"
                        outerRadius="70%"
                        label
                      >
                        {myApprovedPie.map((entry, idx) => (
                          <Cell key={idx} fill={COLORS[idx % COLORS.length]} />
                        ))}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                ) : (
                  <EmptyState text="No data" />
                )}
              </Box>
            </CardContent>
          </Card>
        </Grid>

        <Grid size={{ xs: 12, md: 3 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                My Pending (Module-wise)
              </Typography>
              <Box sx={{ width: "100%", height: 220 }}>
                {myPendingPie && myPendingPie.length ? (
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={myPendingPie}
                        dataKey="value"
                        nameKey="label"
                        innerRadius="30%"
                        outerRadius="70%"
                        label
                      >
                        {myPendingPie.map((entry, idx) => (
                          <Cell key={idx} fill={COLORS[idx % COLORS.length]} />
                        ))}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                ) : (
                  <EmptyState text="No data" />
                )}
              </Box>
            </CardContent>
          </Card>
        </Grid>

        <Grid size={{ xs: 12, md: 3 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                My Rejected (Module-wise)
              </Typography>
              <Box sx={{ width: "100%", height: 220 }}>
                {myRejectedPie && myRejectedPie.length ? (
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={myRejectedPie}
                        dataKey="value"
                        nameKey="label"
                        innerRadius="30%"
                        outerRadius="70%"
                        label
                      >
                        {myRejectedPie.map((entry, idx) => (
                          <Cell key={idx} fill={COLORS[idx % COLORS.length]} />
                        ))}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                ) : (
                  <EmptyState text="No data" />
                )}
              </Box>
            </CardContent>
          </Card>
        </Grid>

        <Grid size={{ xs: 12, md: 3 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Pending For My Approval (Module-wise)
              </Typography>
              <Box sx={{ width: "100%", height: 220 }}>
                {pendingForMePie && pendingForMePie.length ? (
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={pendingForMePie}
                        dataKey="value"
                        nameKey="label"
                        innerRadius="30%"
                        outerRadius="70%"
                        label
                      >
                        {pendingForMePie.map((entry, idx) => (
                          <Cell key={idx} fill={COLORS[idx % COLORS.length]} />
                        ))}
                      </Pie>
                      <Tooltip />
                    </PieChart>
                  </ResponsiveContainer>
                ) : (
                  <EmptyState text="No data" />
                )}
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* Row 5: Announcements and Recent Activity - two blocks in one row full width */}
      <Grid container spacing={2} m={3}>
        <Grid size={{ xs: 12, md: 6 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Recent Activity
              </Typography>
              <List dense sx={{ maxHeight: 320, overflow: "auto" }}>
                {(rawData.recentActivity || []).slice(0, 20).map((r, idx) => (
                  <React.Fragment key={r.timestamp + idx}>
                    {idx > 0 && <Divider component="li" />}
                    <ListItem alignItems="flex-start">
                      <ListItemText
                        primary={
                          <Stack
                            direction="row"
                            spacing={1}
                            alignItems="center"
                          >
                            <Typography variant="body2" fontWeight={600}>
                              {r.action}
                            </Typography>
                            <Chip
                              label={r.status}
                              size="small"
                              color={
                                r.status === "PENDING"
                                  ? "warning"
                                  : r.status === "REJECTED"
                                  ? "error"
                                  : "success"
                              }
                              variant="outlined"
                            />
                          </Stack>
                        }
                        secondary={
                          <>
                            <Typography
                              component="span"
                              variant="caption"
                              color="text.secondary"
                              display="block"
                            >
                              {r.displayTime}
                            </Typography>
                            <Typography variant="body2">{r.details}</Typography>
                          </>
                        }
                      />
                    </ListItem>
                  </React.Fragment>
                ))}
                {(!rawData.recentActivity ||
                  rawData.recentActivity.length === 0) && (
                  <EmptyState text="No activity" />
                )}
              </List>
            </CardContent>
          </Card>
        </Grid>

        <Grid size={{ xs: 12, md: 6 }}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Announcements
              </Typography>
              <List dense sx={{ maxHeight: 320, overflow: "auto" }}>
                {(rawData.announcements || []).map((a, idx) => (
                  <React.Fragment key={a.id || idx}>
                    {idx > 0 && <Divider component="li" />}
                    <ListItem alignItems="flex-start">
                      <ListItemText
                        primary={
                          <Stack
                            direction="row"
                            spacing={1}
                            alignItems="center"
                          >
                            <Typography variant="body2" fontWeight={600}>
                              {a.title}
                            </Typography>
                            <Chip
                              label={a.severity}
                              size="small"
                              color={getSeverityColor(a.severity)}
                              variant="outlined"
                            />
                          </Stack>
                        }
                        secondary={
                          <>
                            <Typography
                              component="span"
                              variant="caption"
                              color="text.secondary"
                              display="block"
                            >
                              {a.date}
                            </Typography>
                            <Typography variant="body2">{a.message}</Typography>
                          </>
                        }
                      />
                    </ListItem>
                  </React.Fragment>
                ))}
                {(!rawData.announcements ||
                  rawData.announcements.length === 0) && (
                  <EmptyState text="No announcements" />
                )}
              </List>
            </CardContent>
          </Card>
        </Grid>
      </Grid>
    </Box>
  );
};

export default DashboardPage;

/* -------------------- small helpers -------------------- */

function EmptyState({ text }) {
  return (
    <Stack alignItems="center" justifyContent="center" sx={{ height: "100%" }}>
      <Typography variant="caption" color="text.secondary">
        {text}
      </Typography>
    </Stack>
  );
}
