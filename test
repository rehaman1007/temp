import React from "react";
import { useSelector } from "react-redux";
import {
  Card,
  CardContent,
  Typography,
  Stack,
  Box,
  Chip,
  Grid,
  useTheme
} from "@mui/material";

// Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import LocationCityIcon from "@mui/icons-material/LocationCity";
import PersonIcon from "@mui/icons-material/Person";
import CodeIcon from "@mui/icons-material/Code";

/**
 * Reusable info card used for Financial Period / Circle / Branch
 * Accepts icon (react node), title, rows: [{label, value, optionalPill}]
 */
const InfoCard = ({ icon, title, rows = [] }) => {
  const theme = useTheme();

  return (
    <Card
      variant="outlined"
      sx={{
        borderRadius: 3,
        bgcolor: "rgba(255,255,255,0.9)",
        transition: "transform .18s ease, box-shadow .18s ease",
        "&:hover": {
          transform: "translateY(-6px)",
          boxShadow: 6
        },
        cursor: "default",
        height: "100%"
      }}
      aria-label={title}
    >
      <CardContent>
        <Stack direction="row" spacing={1} alignItems="center" mb={1}>
          <Box
            sx={{
              width: 44,
              height: 44,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              borderRadius: "10px",
              bgcolor: "rgba(0,0,0,0.04)",
              flexShrink: 0
            }}
          >
            {icon}
          </Box>

          <Typography variant="subtitle1" fontWeight={700}>
            {title}
          </Typography>
        </Stack>

        <Stack spacing={0.7}>
          {rows.map((r) => (
            <Box key={r.label} sx={{ display: "flex", flexDirection: "column" }}>
              <Typography variant="caption" color="text.secondary" sx={{ lineHeight: 1.1 }}>
                {r.label}
              </Typography>

              <Stack direction="row" spacing={1} alignItems="center" sx={{ mt: 0.4 }}>
                <Typography variant="body2" fontWeight={700}>
                  {r.value}
                </Typography>

                {/* optional pill (like circle code) */}
                {r.pill && (
                  <Chip
                    icon={<CodeIcon fontSize="small" />}
                    label={r.pill}
                    size="small"
                    sx={{
                      ml: 1,
                      bgcolor: "rgba(0,0,0,0.04)",
                      borderRadius: 2,
                      fontWeight: 700
                    }}
                    variant="filled"
                  />
                )}
              </Stack>
            </Box>
          ))}
        </Stack>
      </CardContent>
    </Card>
  );
};

/**
 * Top header card (Welcomer + small user pill)
 * Accepts user object to show name/role
 */
const HeaderCard = ({ user }) => {
  return (
    <Card
      variant="outlined"
      sx={{
        borderRadius: 3,
        bgcolor: "rgba(255,255,255,0.95)",
        transition: "transform .18s ease, box-shadow .18s ease",
        "&:hover": {
          transform: "translateY(-4px)",
          boxShadow: 4
        }
      }}
    >
      <CardContent sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 2 }}>
        <Box>
          <Typography variant="h4" sx={{ fontWeight: 800 }}>
            Welcome To FinCore
          </Typography>
        </Box>

        <Stack direction="row" spacing={1} alignItems="center">
          <Chip
            icon={<PersonIcon />}
            label={user.displayName || `${user.firstName || "User"} ${user.lastName || ""}`}
            variant="outlined"
            sx={{ fontWeight: 700 }}
          />
        </Stack>
      </CardContent>
    </Card>
  );
};

/**
 * Right side user info pill (rounded)
 */
const UserInfoPill = ({ user }) => {
  return (
    <Card
      variant="outlined"
      sx={{
        borderRadius: 3,
        bgcolor: "rgba(255,255,255,0.94)",
        px: 1,
        py: 0.5,
        height: "100%",
        display: "flex",
        alignItems: "center",
        transition: "transform .12s ease",
        "&:hover": { transform: "translateY(-2px)" }
      }}
    >
      <CardContent sx={{ p: 1.2 }}>
        <Stack spacing={0.4}>
          <Typography variant="caption" color="text.secondary">
            Name:
          </Typography>
          <Typography variant="body1" fontWeight={700}>
            {user.displayName || `${user.firstName || "User"} ${user.lastName || ""}`}
          </Typography>

          <Typography variant="caption" color="text.secondary" sx={{ mt: 0.7 }}>
            Role:
          </Typography>
          <Typography variant="body1" fontWeight={700}>
            {user.roleName || user.role || "UCO"}
          </Typography>
        </Stack>
      </CardContent>
    </Card>
  );
};

/**
 * Main exported component (classic Grid)
 */
export const DashboardHead = () => {
  const user = useSelector((state) => state.auth.user) || {};
  const fy = user.financialYear || {};

  return (
    <Box sx={{ px: { xs: 1, md: 3 }, py: { xs: 1, md: 2 } }}>
      {/* Row 1: Greeting left + user pill right */}
      <Grid container spacing={2} alignItems="center" sx={{ mb: 2 }}>
        <Grid item xs={12} md={8}>
          <HeaderCard user={user} />
        </Grid>

        <Grid item xs={12} md={4}>
          <UserInfoPill user={user} />
        </Grid>
      </Grid>

      {/* Row 2: Info cards */}
      <Grid container spacing={2}>
        <Grid item xs={12} md={4}>
          <InfoCard
            icon={<CalendarMonthIcon fontSize="small" />}
            title="Current Financial Period"
            rows={[
              { label: "Start date", value: fy.startDate || "01-04-2025" },
              { label: "End date", value: fy.endDate || "31-03-2026" }
            ]}
          />
        </Grid>

        <Grid item xs={12} md={4}>
          <InfoCard
            icon={<LocationCityIcon fontSize="small" />}
            title="Circle Information"
            rows={[
              { label: "Circle Name", value: user.circleName || "CO-AU II, MUMBAI" },
              { label: "Circle Code", value: user.circleCode || "020", pill: user.circleCode || "020" }
            ]}
          />
        </Grid>

        <Grid item xs={12} md={4}>
          <InfoCard
            icon={<AccountBalanceIcon fontSize="small" />}
            title="Branch Information"
            rows={[
              { label: "Branch Name", value: user.branchName || "Main Branch Name" },
              { label: "Branch Code", value: user.branchCode || "12345", pill: user.branchCode || "12345" }
            ]}
          />
        </Grid>
      </Grid>
    </Box>
  );
};

export default DashboardHead;