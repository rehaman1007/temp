onStart={(p) =>
  setConfirmConfig({
    action: "restart",
    severity: "warning",   // 👈 add
    process: p,
  })
}

onStop={(p) =>
  setConfirmConfig({
    action: "stop",
    severity: "error",     // 👈 add
    process: p,
  })
}

actions={{
  onStart: (p) =>
    setConfirmConfig({
      action: "restart",
      severity: "warning",
      process: p,
    }),

  onStop: (p) =>
    setConfirmConfig({
      action: "stop",
      severity: "error",
      process: p,
    }),

  onView: setSelectedProcessType,
  onSummary: handleOpenSummary,
}}


<ActionConfirmDialog
  open={!!confirmConfig}
  actionType={confirmConfig?.action}
  severity={confirmConfig?.severity}   // 👈 add
  processName={confirmConfig?.process?.type}
  onConfirm={handleConfirmAction}
  onClose={() => setConfirmConfig(null)}
/>

<Button
  variant="contained"
  color={
    severity === "error"
      ? "error"
      : severity === "warning"
      ? "warning"
      : "primary"
  }
  onClick={handleSubmit}
>
  Confirm
</Button>

<Typography
  variant="h6"
  color={
    severity === "error"
      ? "error.main"
      : severity === "warning"
      ? "warning.main"
      : "primary.main"
  }
>
  {actionType === "stop" && "Stop Process (Mark as Error)"}
  {actionType === "restart" && "Restart Process"}
  {actionType === "start" && "Start Process"}
  {actionType === "finishEod" && "Finish EOD"}
</Typography>