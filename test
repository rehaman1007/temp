package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;

import jakarta.validation.Valid;

import java.util.Map;

public interface AdminSupportService {

    Map<String, Object> executeAdminSql(
            @Valid
            AdminSupportDTO adminSupportDTO
    );
}

package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;

import org.springframework.stereotype.Service;

import java.sql.ResultSetMetaData;

import java.util.*;

@Slf4j
@Service("AdminSupportService")
@RequiredArgsConstructor
public class AdminSupportServiceImpl
        implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    @Override
    public Map<String, Object> executeAdminSql(
            AdminSupportDTO dto
    ) {

        try {

            String sql =
                    dto.getSql().trim();

            if (sql.isBlank()) {

                return Map.of(
                        "error",
                        true,
                        "message",
                        "SQL cannot be empty"
                );
            }

            validateDangerousSql(sql);

            boolean isSelect =
                    isSelectQuery(sql);

            int page =
                    dto.getPage() != null
                            ? dto.getPage()
                            : 0;

            int size =
                    dto.getSize() != null
                            ? dto.getSize()
                            : 5;

            if (isSelect) {

                return executeSelect(
                        sql,
                        page,
                        size
                );
            }

            return executeDml(sql);

        } catch (Exception e) {

            log.error(
                    "Execution failed",
                    e
            );

            return Map.of(
                    "error",
                    true,
                    "message",
                    e.getMessage()
            );
        }
    }

    /**
     * Execute SELECT query
     */
    private Map<String, Object> executeSelect(
            String sql,
            int page,
            int size
    ) {

        try {

            jdbcTemplate.execute(
                    "EXPLAIN PLAN FOR " + sql
            );

        } catch (Exception e) {

            return Map.of(
                    "error",
                    true,
                    "message",
                    "Syntax Error: " +
                            e.getMessage()
            );
        }

        String countSql =
                "SELECT COUNT(*) FROM (" +
                        sql +
                        ")";

        Integer total =
                jdbcTemplate.queryForObject(
                        countSql,
                        Integer.class
                );

        String paginatedSql =
                sql +
                        " OFFSET " +
                        (page * size) +
                        " ROWS FETCH NEXT " +
                        size +
                        " ROWS ONLY";

        return jdbcTemplate.query(
                paginatedSql,
                rs -> {

                    ResultSetMetaData meta =
                            rs.getMetaData();

                    int columnCount =
                            meta.getColumnCount();

                    List<Map<String, String>>
                            columns =
                            new ArrayList<>();

                    for (
                            int i = 1;
                            i <= columnCount;
                            i++
                    ) {

                        columns.add(
                                Map.of(
                                        "name",
                                        meta.getColumnLabel(i)
                                )
                        );
                    }

                    List<Map<String, Object>>
                            rows =
                            new ArrayList<>();

                    while (rs.next()) {

                        Map<String, Object>
                                row =
                                new HashMap<>();

                        for (
                                int i = 1;
                                i <= columnCount;
                                i++
                        ) {

                            Object value =
                                    rs.getObject(i);

                            if (
                                    value instanceof java.io.InputStream
                            ) {

                                value =
                                        "[BLOB DATA]";
                            }

                            row.put(
                                    meta.getColumnLabel(i),
                                    value
                            );
                        }

                        rows.add(row);
                    }

                    return Map.of(
                            "error",
                            false,
                            "columns",
                            columns,
                            "rows",
                            rows,
                            "total",
                            total,
                            "page",
                            page,
                            "size",
                            size
                    );
                }
        );
    }

    /**
     * Execute DML/DDL
     */
    private Map<String, Object> executeDml(
            String sql
    ) {

        try {

            jdbcTemplate.execute(sql);

            return Map.of(
                    "error",
                    false,
                    "columns",
                    List.of(
                            Map.of(
                                    "name",
                                    "RESULT"
                            )
                    ),
                    "rows",
                    List.of(
                            Map.of(
                                    "RESULT",
                                    "Execution completed successfully"
                            )
                    ),
                    "total",
                    1
            );

        } catch (DataAccessException e) {

            return Map.of(
                    "error",
                    true,
                    "message",
                    e.getMostSpecificCause()
                            .getMessage()
            );
        }
    }

    /**
     * SELECT / WITH checker
     */
    private boolean isSelectQuery(
            String sql
    ) {

        String clean =
                sql.trim().toUpperCase();

        return clean.startsWith("SELECT")
                || clean.startsWith("WITH");
    }

    /**
     * Dangerous query blocker
     */
    private void validateDangerousSql(
            String sql
    ) {

        String upper =
                sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        || upper.contains("ALTER SYSTEM")
                        || upper.contains("SHUTDOWN")
                        || upper.contains("CREATE USER")
                        || upper.contains("DROP USER")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL blocked"
            );
        }
    }
}

package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.beans.factory.annotation.Autowired;

import org.springframework.scheduling.annotation.Async;

import org.springframework.stereotype.Service;

import javax.sql.DataSource;

import java.io.BufferedReader;

import java.nio.file.Files;
import java.nio.file.Path;

import java.sql.Connection;
import java.sql.Statement;

import java.util.Map;

import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    @Autowired
    private DataSource dataSource;

    /**
     * Job tracker
     */
    private final Map<String, Map<String, Object>>
            jobStatusMap =
            new ConcurrentHashMap<>();

    /**
     * Execute uploaded SQL asynchronously
     */
    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path path,
            String jobId
    ) {

        jobStatusMap.put(
                jobId,
                Map.of(
                        "status",
                        "RUNNING",
                        "executedCount",
                        0
                )
        );

        Connection connection = null;

        BufferedReader reader = null;

        try {

            connection =
                    dataSource.getConnection();

            /**
             * Manual transaction
             */
            connection.setAutoCommit(false);

            Statement statementExecutor =
                    connection.createStatement();

            reader =
                    Files.newBufferedReader(path);

            StringBuilder sqlBuilder =
                    new StringBuilder();

            String line;

            int count = 0;

            while ((line = reader.readLine()) != null) {

                String trimmed =
                        line.trim();

                /**
                 * Ignore empty
                 */
                if (trimmed.isBlank()) {
                    continue;
                }

                /**
                 * Ignore comments
                 */
                if (
                        trimmed.startsWith("--")
                ) {
                    continue;
                }

                sqlBuilder
                        .append(line)
                        .append("\n");

                /**
                 * Statement completed
                 */
                if (
                        trimmed.endsWith(";")
                ) {

                    String sql =
                            sqlBuilder.toString();

                    sql =
                            sql.substring(
                                    0,
                                    sql.lastIndexOf(";")
                            );

                    validateDangerousSql(sql);

                    statementExecutor.execute(sql);

                    count++;

                    jobStatusMap.put(
                            jobId,
                            Map.of(
                                    "status",
                                    "RUNNING",
                                    "executedCount",
                                    count
                            )
                    );

                    sqlBuilder.setLength(0);

                    /**
                     * Batch commit
                     */
                    if (count % 1000 == 0) {

                        connection.commit();

                        log.info(
                                "Committed batch {}",
                                count
                        );
                    }

                    log.info(
                            "Executed statement {}",
                            count
                    );
                }
            }

            /**
             * Final commit
             */
            connection.commit();

            jobStatusMap.put(
                    jobId,
                    Map.of(
                            "status",
                            "COMPLETED",
                            "executedCount",
                            count
                    )
            );

            log.info(
                    "SQL execution completed"
            );

        } catch (Exception e) {

            log.error(
                    "SQL execution failed",
                    e
            );

            /**
             * Rollback everything
             */
            try {

                if (connection != null) {

                    connection.rollback();

                    log.error(
                            "Transaction rolled back"
                    );
                }

            } catch (Exception rollbackEx) {

                log.error(
                        "Rollback failed",
                        rollbackEx
                );
            }

            jobStatusMap.put(
                    jobId,
                    Map.of(
                            "status",
                            "FAILED",
                            "message",
                            e.getMessage()
                    )
            );

        } finally {

            try {

                if (reader != null) {
                    reader.close();
                }

                if (connection != null) {
                    connection.close();
                }

            } catch (Exception e) {

                log.error(
                        "Cleanup failed",
                        e
                );
            }
        }
    }

    /**
     * Prevent dangerous statements
     */
    private void validateDangerousSql(
            String sql
    ) {

        String upper =
                sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        || upper.contains("ALTER SYSTEM")
                        || upper.contains("SHUTDOWN")
                        || upper.contains("CREATE USER")
                        || upper.contains("DROP USER")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL blocked"
            );
        }
    }

    /**
     * Get execution status
     */
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStatusMap.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }
}

package com.fincore.transactions_service.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import org.springframework.scheduling.annotation.EnableAsync;

import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

@Configuration
@EnableAsync
public class AsyncConfig {

    @Bean(name = "sqlExecutor")
    public Executor sqlExecutor() {

        ThreadPoolTaskExecutor executor =
                new ThreadPoolTaskExecutor();

        executor.setCorePoolSize(2);

        executor.setMaxPoolSize(5);

        executor.setQueueCapacity(10);

        executor.setThreadNamePrefix(
                "SQL-EXECUTOR-"
        );

        executor.initialize();

        return executor;
    }
}

