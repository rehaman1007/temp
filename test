import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Grid,
  IconButton,
  Typography,
  List,
  ListItem,
  ListItemText,
  ListItemButton,
  Paper,
} from "@mui/material";
import { useEffect, useState } from "react";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import LockOutlineIcon from "@mui/icons-material/LockOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import { validations } from "../../../utils/Validations";

export default function RolesDialog({ open, onClose, form, setForm, canSave, fetchRoles }) {
  const user = JSON.parse(sessionStorage.getItem("user"));
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [allPermissions, setAllPermissions] = useState([]);
  const [assignedPermissions, setAssignedPermissions] = useState([]);

  // Load permissions when dialog opens
  useEffect(() => {
    if (open) {
      (async () => {
        const res = await callApi("/UM/permissions/list", {}, "GET");
        if (res?.result?.status) {
          setAllPermissions(res.result.data || []);
        } else {
          setAllPermissions([]);
        }

        // Initialize assigned permissions from form if editing
        setAssignedPermissions(form.permissions || []);
      })();
    }
  }, [open, form.permissions]);

  const onSave = async (type) => {
    if (!form.roleName || !form.description) {
      snackbar("Kindly fill all the required fields.", "error");
      return;
    }

    let subDialog = {
      roleId: form.roleId,
      roleName: form.roleName,
      description: form.description,
      permissions: assignedPermissions.map((p) => p.id),
    };

    let payload = {
      requestType: type,
      targetRoleId: form.roleId,
      requestorUserId: user.userId,
      requestPayload: JSON.stringify(subDialog),
    };

    let res = await callApi("/UM/role/create-role-request", payload, "POST");
    if (res?.result?.status) {
      snackbar(res?.result?.message, "success");
      onClose();
      fetchRoles();
    }
  };

  const handleChange = (data, key, e, type) => {
    let result = validations(type, e.target.value);
    if (result === "") {
      setForm({ ...data, [key]: e.target.value });
    } else {
      snackbar(result, "error");
    }
  };

  // Move permission from available to assigned
  const assignPermission = (permission) => {
    setAssignedPermissions([...assignedPermissions, permission]);
  };

  // Remove permission from assigned
  const removePermission = (permission) => {
    setAssignedPermissions(assignedPermissions.filter((p) => p.id !== permission.id));
  };

  // Filter available permissions
  const availablePermissions = allPermissions.filter(
    (p) => !assignedPermissions.some((ap) => ap.id === p.id)
  );

  return (
    <Dialog
      open={open}
      onClose={onClose}
      fullWidth
      maxWidth="md"
      PaperProps={{ sx: { minWidth: 800, maxWidth: "45vw" } }}
    >
      <DialogTitle>{form.roleId ? "Edit Role" : "Add New Role"}</DialogTitle>

      {form.roleId && (
        <IconButton
          aria-label="role status"
          sx={(theme) => ({
            position: "absolute",
            right: 10,
            top: 8,
            color: theme.palette.grey[500],
          })}
          onClick={() => {
            onSave(form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK");
          }}
        >
          {form.status === "ACTIVE" ? (
            <LockOutlineIcon color="error" />
          ) : (
            <LockOpenIcon color="success" />
          )}
          <Typography variant="caption">
            {form.status === "ACTIVE" ? "BLOCK" : "UNBLOCK"}
          </Typography>
        </IconButton>
      )}

      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          <Grid container spacing={2}>
            <Grid item xs={12} md={4}>
              <TextField
                label="Role Name *"
                slotProps={{ htmlInput: { maxLength: 50 } }}
                value={form.roleName}
                onChange={(e) => handleChange(form, "roleName", e, "inputValue")}
                fullWidth
                size="medium"
              />
            </Grid>
            <Grid item xs={12} md={8}>
              <TextField
                label="Description *"
                slotProps={{ htmlInput: { maxLength: 100 } }}
                value={form.description}
                onChange={(e) => handleChange(form, "description", e, "certainSpecialChars")}
                fullWidth
                size="medium"
              />
            </Grid>
          </Grid>

          {/* Permissions Transfer List */}
          <Grid container spacing={2}>
            <Grid item xs={6}>
              <Typography variant="subtitle1">Available Permissions</Typography>
              <Paper sx={{ maxHeight: 200, overflow: "auto" }}>
                <List dense>
                  {availablePermissions.map((p) => (
                    <ListItem key={p.id} disablePadding>
                      <ListItemButton onClick={() => assignPermission(p)}>
                        <ListItemText primary={p.title} />
                      </ListItemButton>
                    </ListItem>
                  ))}
                </List>
              </Paper>
            </Grid>
            <Grid item xs={6}>
              <Typography variant="subtitle1">Assigned Permissions</Typography>
              <Paper sx={{ maxHeight: 200, overflow: "auto" }}>
                <List dense>
                  {assignedPermissions.map((p) => (
                    <ListItem key={p.id} disablePadding>
                      <ListItemButton onClick={() => removePermission(p)}>
                        <ListItemText primary={p.title} />
                      </ListItemButton>
                    </ListItem>
                  ))}
                </List>
              </Paper>
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose}>Cancel</Button>
        <Button
          variant="contained"
          disabled={!canSave}
          onClick={() => onSave(form.roleId ? "MODIFY" : "CREATE")}
        >
          {form.roleId ? "Save Changes" : "Create Role"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}