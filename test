import React from "react";
import { Paper, Typography, Button, Box, useTheme } from "@mui/material";
import DownloadIcon from "@mui/icons-material/Download";
import SupportAgentIcon from "@mui/icons-material/SupportAgent";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import useApi from "../../hooks/useApi";
import downloadFile from "../../utils/DownloadUtils";

const Help = () => {
  const theme = useTheme();
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const handleDownload = async () => {
    try {
      const response = await callApi(
        "/Security/downloadDocs",
        " ",
        "POST",
        "arraybuffer"
      );
      if (!response) {
        showSnackBar("Failed to download the help document", "error");
      } else {
        downloadFile(response, "zip", "FinCore_Help_Doc");
      }
    } catch (error) {
      showSnackBar("Failed to download the help document : " + error, "error");
      console.error("Error downloading the file:", error);
    }
  };

  return (
    <Box
      maxWidth="md"
      sx={{
        mt: 4,
        mx: "auto",
        boxShadow: 8,
        borderRadius: 4,
      }}
    >
      <Paper
        elevation={0}
        sx={{
          p: 6,
          borderRadius: 4,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          gap: 4,
        }}
      >
        {/* Help icon */}
        <SupportAgentIcon
          sx={{ fontSize: 80, color: theme.palette.primary.dark }}
        />

        <Typography
          variant="h4"
          fontWeight="bold"
          gutterBottom
          color={theme.palette.primary.dark}
        >
          Need Assistance?
        </Typography>

        <Typography
          variant="body1"
          color="text.secondary"
          align="center"
          maxWidth="80%"
        >
          Our comprehensive help document is available for download. Click the
          button below to get started.
        </Typography>

        <Button
          // variant="contained"
          size="large"
          type="submit"
          startIcon={<DownloadIcon />}
          onClick={handleDownload}
          sx={{
            mt: 3,
            px: 5,
            color: "#FFF",
            py: 1.8,
            fontWeight: "bold",
            fontSize: "1.1rem",
            background: `linear-gradient(135deg, ${theme.palette.primary.dark} 0%, ${theme.palette.primary.dark})`,
            boxShadow: " rgb(38, 57, 77) 0px 20px 30px -10px",
            "&:hover": {
              background: `linear-gradient(135deg, ${theme.palette.primary.dark} 0%, ${theme.palette.primary.dark})`,
              boxShadow: "0 6px 20px rgba(30, 60, 114, 0.4)",
            },
            transition: "all 0.3s ease",
          }}
        >
          Download Help Document
        </Button>
      </Paper>
    </Box>
  );
};

export default Help;



import React, { useMemo, Suspense } from "react";
import { createBrowserRouter, RouterProvider } from "react-router-dom";
import { useSelector } from "react-redux";
import PrivateRouter from "./PrivateRouter";

// Page Components
import Login from "../features/auth/pages/Login";
import Home from "../pages/Home";
import NotFound from "../pages/NotFound";
import ServerError from "../pages/ServerError";
import CommonLayout from "../layout/CommonLayout";
import FullscreenLayout from "../layout/FullscreenLayout";
import SubmenuSelectionPage from "../pages/SubmenuSelectionPage";

import { generateRouteObjects } from "./RouteGenerator";

const PageLoader = () => (
  <div
    style={{
      display: "flex",
      height: "100vh",
      justifyContent: "center",
      alignItems: "center",
    }}
  >
    Loading...
  </div>
);

const DynamicLayout = () => {
  const isComponentFullscreen = useSelector(
    (state) => state.ui.isComponentFullscreen
  );
  return !isComponentFullscreen ? <CommonLayout /> : <FullscreenLayout />;
};

const AppRouter = () => {
  const menus = useSelector((state) => state.menus.menus);

  const router = useMemo(() => {
    const dynamicRoutes = generateRouteObjects(menus || []);

    const routeConfig = [
      {
        path: "/",
        element: <Login />,
        errorElement: <ServerError />,
      },
      {
        path: "/server-error",
        element: <ServerError />,
      },
      // Protected Routes
      {
        element: <PrivateRouter />,
        children: [
          {
            element: <DynamicLayout />,
            children: [
              { path: "/home", element: <Home /> },
              {
                path: "/choose-option/:mainMenuTitle",
                element: <SubmenuSelectionPage />,
              },
              ...dynamicRoutes,
            ],
          },
        ].filter(Boolean),
      },
      {
        path: "*",
        element: <NotFound />,
      },
    ];

    return createBrowserRouter(routeConfig);
  }, [menus]);

  return (
    <Suspense fallback={<PageLoader />}>
      <RouterProvider router={router} />
    </Suspense>
  );
};

export default AppRouter;
