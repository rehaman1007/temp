import React, { useState, useEffect, lazy, Suspense } from "react";
import { BrowserRouter as Router, Routes, Route, Navigate } from "react-router-dom";
import { Box, CircularProgress } from "@mui/material";
import SideMenu from "./SideMenu";

const HomePage = lazy(() => import("./pages/HomePage"));

export default function App() {
  const [routesConfig, setRoutesConfig] = useState([]);
  const [role, setRole] = useState("");
  const [loading, setLoading] = useState(true);
  const [defaultPage, setDefaultPage] = useState("");

  useEffect(() => {
    // Simulate API after login
    setTimeout(() => {
      const response = {
        role: "admin",
        menu: [
          { title: "Dashboard", path: "dashboard", component: "Dashboard" },
          { title: "Reports", path: "reports", component: "Reports" }
        ],
        defaultPage: "homepage"
      };

      setRole(response.role);
      setRoutesConfig(response.menu);
      setDefaultPage(response.defaultPage);
      setLoading(false);
    }, 1000);
  }, []);

  const renderRoutes = (routes, rolePrefix) =>
    routes.map((route) => {
      const Component = lazy(() => import(`./pages/${route.component}`));
      const fullPath = `/${rolePrefix}/${route.path}`;
      return <Route key={fullPath} path={fullPath} element={<Component />} />;
    });

  if (loading) return <CircularProgress />;

  return (
    <Router>
      <Box sx={{ display: "flex" }}>
        {routesConfig.length > 0 && <SideMenu menuItems={routesConfig} role={role} />}
        <Box sx={{ flex: 1, p: 2 }}>
          <Suspense fallback={<CircularProgress />}>
            <Routes>
              {renderRoutes(routesConfig, role)}

              {/* Default Page */}
              <Route path={`/${role}/${defaultPage}`} element={<HomePage />} />

              {/* Redirect to first allowed route or default page */}
              <Route
                path="*"
                element={
                  <Navigate
                    to={
                      routesConfig.length > 0
                        ? `/${role}/${routesConfig[0].path}`
                        : `/${role}/${defaultPage}`
                    }
                  />
                }
              />
            </Routes>
          </Suspense>
        </Box>
      </Box>
    </Router>
  );
}