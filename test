const ProcessStatusPage = () => {
  const snackbar = useCustomSnackbar();
  const token = useSelector((s) => s.auth.token);
  const { callApi } = useApi();
  const DEFAULT_DAG = "orchestrator_v2_dag";
  const INITIAL_DATA_URL = "/PS/process/processes/data";
  const TRIGGER_DAG_URL = "/PS/airflow/trigger/";
  const FINISH_EOD_URL = "/PS/process/finish-eod";
  const service = resolveConfig("/PS");
  const STREAM_URL = `${service}/process/processes`;

  const [currentEtlDate, setCurrentEtlDate] = useState(null);
  const [selectedDate, setSelectedDate] = useState(null);

  const [processes, setProcesses] = useState([]);
  const [loading, setLoading] = useState(true);
  const [apiLoading, setApiLoading] = useState(false);

  const [selectedProcessType, setSelectedProcessType] = useState(null);
  const [summaryData, setSummaryData] = useState(null);

  const initialFetchDone = useRef(false);

  /* ================= LOAD BY DATE ================= */

  const loadByDate = useCallback(
    async (date) => {
      setLoading(true);
      try {
        const res = await callApi(
          INITIAL_DATA_URL,
          {
            etlDate: date ? date.format("YYYY-MM-DD") : "",
          },
          "GET",
        );

        setCurrentEtlDate(res?.fincoreDate?.etlDate);
        setSelectedDate(dayjs(res?.fincoreDate?.etlDate) || "");

        setProcesses(normalizeProcesses(res?.initialData || []));
      } catch (e) {
        console.error(e);
        snackbar("Failed to load processes", "error");
      } finally {
        setLoading(false);
      }
    },
    [callApi, snackbar],
  );

  /* ================= HANDLING STARTING OF PROCESS/EOD ================= */

  const handleStartProcess = useCallback(async () => {
    setApiLoading(true);
    try {
      const response = await callApi(
        TRIGGER_DAG_URL + DEFAULT_DAG,
        {
          conf: {},
        },
        "POST",
      );
      console.log(response);
      if (response.success) {
        snackbar("Started EOD successfully", "success");
      }
    } catch (e) {
      console.error(e);
      snackbar(e.message, "error");
    } finally {
      setApiLoading(false);
    }
  }, [callApi, snackbar]);

  /* ================= HANDLING STOPING OF PROCESS/EOD ================= */

  const handleStopProcess = useCallback(async () => {
    setApiLoading(true);
    try {
      const response = await callApi(
        TRIGGER_DAG_URL + DEFAULT_DAG,
        {
          conf: {},
        },
        "POST",
      );
      console.log(response);
      if (response.success) {
        snackbar("Started EOD successfully", "success");
      }
    } catch (e) {
      console.error(e);
      snackbar(e.message, "error");
    } finally {
      setApiLoading(false);
    }
  }, [callApi, snackbar]);

  /* ================= HANDLING FINISH EOD ================= */

  const handleFinishEod = useCallback(async () => {
    setApiLoading(true);
    try {
      const response = await callApi(
        FINISH_EOD_URL,
        {
          conf: {},
        },
        "POST",
      );
      console.log(response);
      if (response.success) {
        snackbar("Finished EOD successfully", "success");
      }
    } catch (e) {
      console.error(e);
      snackbar(e.message, "error");
    } finally {
      setApiLoading(false);
    }
  }, [callApi, snackbar]);

  /* ================= INITIAL LOAD ================= */

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    loadByDate(null);
  }, [loadByDate]);
  /* ================= SSE (ONLY FOR CURRENT DATE) ================= */

  useEffect(() => {
    if (loading) return;

    if (
      selectedDate &&
      currentEtlDate &&
      selectedDate.format("YYYY-MM-DD") !== currentEtlDate
    ) {
      return; // past date → no streaming
    }

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },
      onmessage(e) {
        if (e.event === "connected") return;
        const raw = JSON.parse(e.data);
        setProcesses((prev) => mergeProcesses(prev, normalizeProcesses(raw)));
      },
    });

    return () => controller.abort();
  }, [STREAM_URL, loading, token, selectedDate, currentEtlDate]);

  /* ================= LIVE SELECTED PROCESS ================= */

  const selectedProcess = useMemo(() => {
    if (!selectedProcessType) return null;
    return processes.find((p) => p.type === selectedProcessType);
  }, [processes, selectedProcessType]);

  /* ================= FLAGS ================= */

  const isCurrentDate =
    selectedDate &&
    currentEtlDate &&
    selectedDate.format("YYYY-MM-DD") === currentEtlDate;

  const allCompleted = useMemo(
    () =>
      processes.length &&
      processes.every((p) => p.stageDetails.every((s) => s.status === 2)),
    [processes],
  );

  /* ================= TABLE SUMMARY HANDLER ================= */

  const handleOpenSummary = (row) => {
    const stage6 = [...row.stageDetails]
      .sort((a, b) => b.id - a.id)
      .find((s) => s.processStage === 6);

    if (stage6?.status === 2 && stage6?.differenceSummary) {
      setSummaryData(stage6.differenceSummary);
    } else {
      snackbar("Summary not available");
    }
  };

  /* ===================================================== */

  return (
    <>
      <Paper sx={{ p: 3, minHeight: "75vh" }}>
        <ProcessStatusHeader processes={processes} />

        {/* ================= ETL DATE CARD ================= */}

        {currentEtlDate && (
          <Tooltip
            title={`ETL processs run date ${formatDate(currentEtlDate)}`}
          >
            <Stack alignItems="center" mt={2} mb={3}>
              <Paper
                elevation={3}
                sx={{
                  px: 3,
                  py: 1.5,
                  display: "flex",
                  alignItems: "center",
                  gap: 1.5,
                  borderRadius: 2,
                }}
              >
                <EventOutlinedIcon color="primary" />
                <Box>
                  <Typography variant="caption" color="text.secondary">
                    ETL Date (System Generated)
                  </Typography>
                  <Typography fontWeight={600}>
                    {currentEtlDate.split("-").reverse().join("-")}
                  </Typography>
                </Box>
              </Paper>
            </Stack>
          </Tooltip>
        )}

        {/* ================= DATE SELECTOR ================= */}

        <Stack alignItems="center" mt={3}>
          <LocalizationProvider dateAdapter={AdapterDayjs}>
            <DatePicker
              label="Select ETL Date"
              value={selectedDate}
              onChange={(d) => {
                setSelectedDate(d);
                loadByDate(d);
              }}
              renderInput={(p) => <TextField {...p} />}
            />
          </LocalizationProvider>
        </Stack>

        {/* ================= EOD BUTTONS (ONLY CURRENT DATE) ================= */}

        {isCurrentDate && (
          <Grid container justifyContent="center" spacing={2} my={3}>
            <Grid>
              <Button
                variant="contained"
                startIcon={<PlayArrowIcon />}
                disabled={processes.length > 0}
                onClick={handleStartProcess}
              >
                Start EOD
              </Button>
            </Grid>

            <Grid>
              <Button
                variant="contained"
                startIcon={<PlayArrowIcon />}
                disabled={processes.length == 0}
                onClick={handleStopProcess}
              >
                Start EOD
              </Button>
            </Grid>

            <Grid>
              <Button
                variant="contained"
                color="success"
                startIcon={<TaskAltIcon />}
                disabled={!allCompleted}
                onClick={handleFinishEod}
              >
                Finish EOD
              </Button>
            </Grid>
          </Grid>
        )}

        {/* ================= DIALOGS ================= */}

        <ProcessDetailsDialog
          process={selectedProcess}
          onClose={() => setSelectedProcessType(null)}
        />

        <ProcessSummaryDialog
          open={!!summaryData}
          data={summaryData}
          onClose={() => setSummaryData(null)}
        />

        {/* ================= TABLE ================= */}

        <Box mt={2}>
          <ProcessStatusTable
            loading={loading}
            processes={processes}
            actions={{
              onStop: handleStopProcess,
              onStart: handleStartProcess,
              onView: setSelectedProcessType,
              onSummary: handleOpenSummary,
            }}
          />
        </Box>
      </Paper>
      <LoadingOverlay loading={apiLoading} />
    </>
  );
};

export default ProcessStatusPage;


import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Tooltip,
  Typography,
  CircularProgress,
  TablePagination,
  Box,
  Stack,
} from "@mui/material";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";
import ProcessStatusChip from "./ProcessStatusChip";
import { StageStatus } from "../util/StageStatus";
import { useState, useMemo, useEffect } from "react";

const MIN_PAGE_SIZE = 5;

/* ---------------- ACTION BUTTON ---------------- */
const Action = ({ title, icon, onClick }) => (
  <Tooltip title={title}>
    <span>
      <IconButton size="small" onClick={onClick}>
        {icon}
      </IconButton>
    </span>
  </Tooltip>
);

const ProcessStatusTable = ({ processes = [], actions, loading }) => {
  console.log(processes);
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(MIN_PAGE_SIZE);

  /* ================= FILTER ================= */
  const validProcesses = useMemo(
    () => processes.filter((p) => p.stageDetails?.length),
    [processes],
  );

  /* ================= TOTAL PAGES ================= */
  const totalPages = Math.max(
    1,
    Math.ceil(validProcesses.length / rowsPerPage),
  );

  useEffect(() => {
    if (page > totalPages - 1) {
      setPage(0);
    }
  }, [page, totalPages]);

  /* ================= PAGINATED DATA ================= */
  const paginatedData = useMemo(
    () =>
      validProcesses.slice(
        page * rowsPerPage,
        page * rowsPerPage + rowsPerPage,
      ),
    [validProcesses, page, rowsPerPage],
  );

  /* ================= SUMMARY CHECK ================= */
  const hasDifferenceSummary = (process) => {
    if (process.type !== "DIFFERENCE") return false;

    const stage6 = [...process.stageDetails]
      .sort((a, b) => b.id - a.id)
      .find((s) => s.processStage === 6);

    return stage6?.status === StageStatus.COMPLETED;
  };

  /* ================================================= */

  return (
    <Paper elevation={1}>
      <TableContainer component={Paper} sx={{ maxHeight: 320 }}>
        <Table stickyHeader size="small">
          {/* ================= HEADER ================= */}
          <TableHead
            sx={{
              position: "sticky",
              top: 0,
              zIndex: 2,
              backgroundColor: "#b4a7d6",
              backdropFilter: "blur(8px)",
            }}
          >
            <TableRow>
              <TableCell>Process ID</TableCell>
              <TableCell>Process</TableCell>
              <TableCell align="center">Status</TableCell>
              <TableCell align="center">Stage</TableCell>
              <TableCell align="center">Started</TableCell>
              <TableCell align="center">Ended</TableCell>
              <TableCell align="center">Actions</TableCell>
            </TableRow>
          </TableHead>

          {/* ================= BODY ================= */}
          <TableBody>
            {/* ---------- LOADING ---------- */}
            {loading && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Box py={2}>
                    <CircularProgress size={20} />
                    <Typography variant="caption" ml={1}>
                      Loading processes…
                    </Typography>
                  </Box>
                </TableCell>
              </TableRow>
            )}

            {/* ---------- DATA ---------- */}
            {!loading &&
              paginatedData.map((p) => {
                const lastStage = p.stageDetails.at(-1);

                return (
                  <TableRow
                    key={p.type + p.processId}
                    hover
                    sx={{
                      bgcolor:
                        lastStage.status === StageStatus.STARTED
                          ? "action.hover"
                          : "inherit",
                    }}
                  >
                    <TableCell fontWeight={500}>{p.processId}</TableCell>
                    <TableCell fontWeight={500}>{p.type}</TableCell>

                    <TableCell align="center">
                      <ProcessStatusChip status={lastStage.status} />
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.stage?.title}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.startTime || "—"}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.endTime || "—"}
                    </TableCell>

                    {/* ================= ACTIONS ================= */}
                    <TableCell align="center">
                      <Stack
                        direction="row"
                        spacing={1}
                        justifyContent="center"
                      >
                        {/* START */}
                        <Action
                          title="View Details"
                          icon={<VisibilityIcon fontSize="small" />}
                          onClick={() => actions.onView(p.type)}
                        />{" "}
                        {/* RESTART */}
                        <Action
                          title="View Details"
                          icon={<VisibilityIcon fontSize="small" />}
                          onClick={() => actions.onView(p.type)}
                        />{" "}
                        {/* VIEW */}
                        <Action
                          title="View Details"
                          icon={<VisibilityIcon fontSize="small" />}
                          onClick={() => actions.onView(p.type)}
                        />
                        {/* SUMMARY (ONLY DIFFERENCE STAGE-6 COMPLETED) */}
                        {hasDifferenceSummary(p) && (
                          <Action
                            title="View Summary"
                            icon={<SummarizeOutlinedIcon fontSize="small" />}
                            onClick={() => actions.onSummary(p)}
                          />
                        )}
                      </Stack>
                    </TableCell>
                  </TableRow>
                );
              })}

            {/* ---------- EMPTY ---------- */}
            {!loading && validProcesses.length === 0 && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Typography color="error.light">
                    Processes Not Available
                  </Typography>
                </TableCell>
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ================= PAGINATION ================= */}
      {!loading && validProcesses.length > MIN_PAGE_SIZE && (
        <TablePagination
          component="div"
          count={validProcesses.length}
          page={page}
          onPageChange={(_, p) => setPage(p)}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={(e) => {
            setRowsPerPage(parseInt(e.target.value, 10));
            setPage(0);
          }}
          rowsPerPageOptions={[5, 10, 25]}
          labelRowsPerPage="Rows"
        />
      )}
    </Paper>
  );
};

export default ProcessStatusTable;


import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  IconButton,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";
import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex((s) => s.status === StageStatus.STARTED);
  if (started !== -1) return started;

  const error = stages.findIndex((s) => s.status === StageStatus.ERROR);
  if (error !== -1) return error;

  const completedIndexes = stages
    .map((s, i) => (s.status === StageStatus.COMPLETED ? i : -1))
    .filter((i) => i !== -1);

  if (completedIndexes.length > 0) {
    return completedIndexes[completedIndexes.length - 1];
  }

  return 0;
};

const ProcessDetailsDialog = ({ process, onClose }) => {
  console.log(process);
  const stages = useMemo(() => process?.stageDetails || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    if (stages.length) {
      setActiveStep(resolveInitialActiveStep(stages));
    }
  }, [stages, process]);

  if (!process) return null;

  const lastStatus = stages[stages.length - 1]?.status;

  return (
    <Dialog open={!!process} fullWidth maxWidth="md" onClose={onClose}>
      <DialogTitle>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        <Stack direction="row" gap={1}>
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />

          <StageDetails stages={stages} activeStep={activeStep} />
        </Stack>
      </DialogContent>

      <DialogActions>
        <Button
          startIcon={<StopIcon />}
          disabled={lastStatus !== StageStatus.STARTED}
        >
          Stop
        </Button>
        <Button
          startIcon={<RestartAltIcon />}
          disabled={lastStatus !== StageStatus.ERROR}
        >
          Restart
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ProcessDetailsDialog;
