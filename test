import React, { createContext, useEffect, useRef, useCallback, useState } from "react";
import { useDispatch, useSelector } from "react-redux";
import axios from "axios";
import SessionDialog from "../components/SessionDialog";
import SessionWarningDialog from "../components/SessionWarningDialog";
import { logout as reduxLogout } from "../store/slices/authSlice";
import { throttle } from "lodash"; // Highly recommended: npm install lodash

export const AuthContext = createContext();

const INACTIVITY_TIMEOUT = 5 * 60 * 1000; 
const WARNING_SECONDS = 30;
const LOGIN_GRACE_PERIOD = 3000;

export const AuthProvider = ({ children }) => {
  const dispatch = useDispatch();
  const user = useSelector((state) => state.auth.user);

  const [warningOpen, setWarningOpen] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(WARNING_SECONDS);
  const [sessionDialogOpen, setSessionDialogOpen] = useState(false);
  const [sessionReason, setSessionReason] = useState("");

  const inactivityTimerRef = useRef(null);
  const warningTimerRef = useRef(null);
  const countdownRef = useRef(null);
  const logoutInProgressRef = useRef(false);
  const loginTimeRef = useRef(0);

  const clearAllTimers = useCallback(() => {
    if (inactivityTimerRef.current) clearTimeout(inactivityTimerRef.current);
    if (warningTimerRef.current) clearTimeout(warningTimerRef.current);
    if (countdownRef.current) clearInterval(countdownRef.current);
  }, []);

  const logout = useCallback(async (reason = "SESSION_EXPIRED") => {
    if (Date.now() - loginTimeRef.current < LOGIN_GRACE_PERIOD) return;
    if (logoutInProgressRef.current) return;
    
    logoutInProgressRef.current = true;
    clearAllTimers();
    
    setWarningOpen(false);
    setSessionReason(reason);
    setSessionDialogOpen(true);

    try {
      await axios.post("/auth/logout", {}, { withCredentials: true });
    } catch (err) {
      console.error("Logout API failed", err);
    }

    dispatch(reduxLogout());
    sessionStorage.clear();
  }, [dispatch, clearAllTimers]);

  const startInactivity = useCallback(() => {
    clearAllTimers();
    
    // Only reset these if they aren't already at default to prevent unnecessary renders
    setWarningOpen(false);
    
    // Timer to show the warning
    warningTimerRef.current = setTimeout(() => {
      setWarningOpen(true);
      setSecondsLeft(WARNING_SECONDS);

      let counter = WARNING_SECONDS;
      countdownRef.current = setInterval(() => {
        counter -= 1;
        setSecondsLeft(counter);
        if (counter <= 0) clearInterval(countdownRef.current);
      }, 1000);
    }, INACTIVITY_TIMEOUT - WARNING_SECONDS * 1000);

    // Timer to perform the actual logout
    inactivityTimerRef.current = setTimeout(() => {
      logout("SESSION_EXPIRED");
    }, INACTIVITY_TIMEOUT);
  }, [logout, clearAllTimers]);

  // Throttled activity handler to prevent 100s of updates per second
  const onActivity = useCallback(
    throttle(() => {
      if (!user || logoutInProgressRef.current) return;
      startInactivity();
    }, 2000), // Only reset timers at most every 2 seconds
    [user, startInactivity]
  );

  useEffect(() => {
    if (!user) {
      clearAllTimers();
      logoutInProgressRef.current = false;
      return;
    }

    loginTimeRef.current = Date.now();
    startInactivity();

    const events = ["mousemove", "keydown", "click", "scroll", "touchstart"];
    events.forEach((e) => window.addEventListener(e, onActivity));

    return () => {
      events.forEach((e) => window.removeEventListener(e, onActivity));
      onActivity.cancel(); // Cleanup throttle
      clearAllTimers();
    };
  }, [user, onActivity, startInactivity, clearAllTimers]);

  return (
    <AuthContext.Provider value={{ logout, triggerSessionDialog: logout }}>
      {children}
      <SessionWarningDialog
        open={warningOpen}
        secondsLeft={secondsLeft}
        onContinue={onActivity}
      />
      <SessionDialog
        open={sessionDialogOpen}
        reason={sessionReason}
        onConfirm={() => window.location.replace("/")}
      />
    </AuthContext.Provider>
  );
};
