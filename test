import { DataGrid } from "@mui/x-data-grid";
import { Box, IconButton, Stack, Tooltip, Typography } from "@mui/material";
import InfoIcon from "@mui/icons-material/Info";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import SummarizeOutlinedIcon from "@mui/icons-material/SummarizeOutlined";
import TableRowsIcon from "@mui/icons-material/TableRows";
import MemoryIcon from "@mui/icons-material/Memory";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import ApprovalIcon from "@mui/icons-material/Approval";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import AdsClickIcon from "@mui/icons-material/AdsClick";

import { StageStatus } from "../util/StageStatus";
import ProcessStatusChip from "./ProcessStatusChip";
import { useMemo } from "react";
import { timeStampFormatter } from "../../../utils/CommonUtilities";
import CustomChip from "../../../utils/CustomChip";
import { getIconComponent } from "../../../utils/IconUtils";

/* =====================================================
   ORDINAL FORMATTER
===================================================== */

const getOrdinal = (n) => {
  if (!n || n <= 1) return "";

  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;

  return `${n}${s[(v - 20) % 10] || s[v] || s[0]} run`;
};

/* =====================================================
   MAIN COMPONENT
===================================================== */

const ProcessStatusTable = ({
  processes = [],
  actions,
  loading,
  permissions = {},
}) => {
  const SUMMARY_STAGES = new Set([
    "CNTR_Report_generated",
    "INTR_Report_generated",
    "balance_Compare_generated",
  ]);

  /* =====================================================
     FIND LATEST RUN FOR EACH PROCESS
  ===================================================== */

  const latestRunMap = useMemo(() => {
    const map = new Map();

    processes.forEach((p) => {
      const key = `${p.processType}_${p.processId}`;

      const existing = map.get(key);

      if (!existing || p.runId > existing.runId) {
        map.set(key, p);
      }
    });

    return map;
  }, [processes]);

  /* =====================================================
     ROWS
  ===================================================== */

  const rows = useMemo(
    () =>
      processes.map((p) => {
        const lastStage = p.stages?.at(-1);

        const key = `${p.processType}_${p.processId}`;
        const latestProcess = latestRunMap.get(key);

        const isLatestRun =
          latestProcess && latestProcess.runId === p.runId;

        const hasSummary =
          p.processType?.toUpperCase() === "DIFFERENCE" &&
          p.stages?.some(
            (s) =>
              s.stageStatus === StageStatus.COMPLETED &&
              SUMMARY_STAGES.has(s.stageId),
          );

        const ordinal = getOrdinal(p.runId);

        return {
          id: `${p.processType}_${p.processId}_${p.runId}`,

          processId: p.processId,

          processType: p.processType,

          /* DISPLAY NAME */
          processDisplayName:
            p.runId > 1
              ? `${p.processType} (${ordinal})`
              : p.processType,

          runId: p.runId,

          status: p.status,

          stageTitle: lastStage?.stageTitle ?? "N/A",

          stageIcon: lastStage?.stageIcon,

          startTime: p.processStartTime,

          endTime: p.processEndTime,

          raw: p,

          hasSummary,

          isLatestRun,
        };
      }),
    [processes, latestRunMap],
  );

  /* =====================================================
     COLUMNS
  ===================================================== */

  const columns = useMemo(
    () => [
      {
        field: "processId",
        flex: 0.4,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <TableRowsIcon />
            <Typography variant="subtitle1">ID</Typography>
          </Box>
        ),
      },

      {
        field: "processDisplayName",
        flex: 1,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <MemoryIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">
              Process Name
            </Typography>
          </Box>
        ),
      },

      {
        field: "status",
        flex: 0.8,
        align: "center",
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AnalyticsIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Status</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <ProcessStatusChip status={p.value} />
        ),
      },

      {
        field: "stageTitle",
        flex: 1,
        align: "center",
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <ApprovalIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">Stage</Typography>
          </Box>
        ),
        renderCell: (params) => {
          const Icon = getIconComponent(
            params.row?.stageIcon,
          );

          return (
            <CustomChip
              label={params.row?.stageTitle}
              icon={<Icon />}
              variant="outlined"
            />
          );
        },
      },

      {
        field: "startTime",
        flex: 1,
        align: "center",
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">
              Started
            </Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography fontSize="0.9rem">
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },

      {
        field: "endTime",
        flex: 1,
        align: "center",
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">
              Ended
            </Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography fontSize="0.9rem">
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },

      {
        field: "actions",
        flex: 0.8,
        align: "center",

        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AdsClickIcon sx={{ mr: 1 }} />
            <Typography variant="subtitle1">
              Actions
            </Typography>
          </Box>
        ),

        renderCell: (params) => {
          const row = params.row.raw;
          const isLatest = params.row.isLatestRun;

          const showRestart =
            isLatest &&
            row.status !== StageStatus.STARTED;

          const showStop =
            isLatest &&
            row.status === StageStatus.STARTED;

          return (
            <Stack direction="row" spacing={1}>
              {(permissions.restart ||
                permissions.start) &&
                showRestart && (
                  <Tooltip title="Restart">
                    <IconButton
                      size="small"
                      onClick={() =>
                        actions.onStart(row)
                      }
                    >
                      <RestartAltIcon />
                    </IconButton>
                  </Tooltip>
                )}

              {permissions.stop && showStop && (
                <Tooltip title="Stop">
                  <IconButton
                    size="small"
                    onClick={() =>
                      actions.onStop(row)
                    }
                  >
                    <StopIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    size="small"
                    onClick={() =>
                      actions.onView(row)
                    }
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view &&
                params.row.hasSummary && (
                  <Tooltip title="Summary">
                    <IconButton
                      size="small"
                      onClick={() =>
                        actions.onSummary(row)
                      }
                    >
                      <SummarizeOutlinedIcon />
                    </IconButton>
                  </Tooltip>
                )}
            </Stack>
          );
        },
      },
    ],
    [actions, permissions],
  );

  /* =====================================================
     FINAL RENDER
  ===================================================== */

  return (
    <Box
      sx={{
        height: 372,

        "& .MuiDataGrid-columnHeaders": {
          backgroundColor: "#b4a7d6",
          fontWeight: 600,
        },

        "& .latest-run-row": {
          backgroundColor:
            "rgba(76,175,80,0.08)",
        },
      }}
    >
      <DataGrid
        rows={rows}
        columns={columns}
        loading={loading}
        getRowClassName={(params) =>
          params.row.isLatestRun
            ? "latest-run-row"
            : ""
        }
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: {
            paginationModel: {
              pageSize: 5,
              page: 0,
            },
          },
        }}
        disableRowSelectionOnClick
        slots={{
          noRowsOverlay: () => (
            <Stack
              height="100%"
              alignItems="center"
              justifyContent="center"
            >
              <InfoIcon sx={{ fontSize: 48 }} />
              <Typography variant="h6">
                No processes available
              </Typography>
            </Stack>
          ),
        }}
      />
    </Box>
  );
};

export default ProcessStatusTable;