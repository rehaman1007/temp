import React from "react";
import {
  Box,
  Grid,
  Typography,
  Stack,
} from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ResponsiveContainer,
} from "recharts";

const COLORS = [
  "#1976d2", // primary
  "#9c27b0", // secondary
  "#2e7d32", // success
  "#ed6c02", // warning
  "#0288d1", // info
  "#d32f2f", // extra
];

export default function CombinedCharts({ requestData = [] }) {
  const total = requestData.length;
  const hasData = total > 0;

  // Request Type Counts (Removed Approved/Rejected)
  const typeCounts = [
    { name: "Add", value: requestData.filter((r) => r.changeType === "ADD").length },
    { name: "Modify", value: requestData.filter((r) => r.changeType === "MODIFY").length },
    { name: "Delete", value: requestData.filter((r) => r.changeType === "DELETE").length },
  ];

  // Trend Data grouped by Date
  const trendData = requestData.reduce((acc, curr) => {
    const date = curr.reqDate?.split("T")[0] || "Unknown";
    const existing = acc.find((item) => item.date === date);
    if (existing) existing.requests++;
    else acc.push({ date, requests: 1 });
    return acc;
  }, []);

  return (
    <Box sx={{ p: 2 }}>
      <Grid container spacing={3}>
        {/* Donut Chart - Request Types */}
        <Grid item xs={12} md={6} sx={{ display: "flex", alignItems: "center", justifyContent: "center" }}>
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <PieChart width={280} height={280}>
              <Pie
                data={hasData ? typeCounts : [{ name: "No Data", value: 1 }]}
                dataKey="value"
                nameKey="name"
                innerRadius={70}
                outerRadius={110}
                startAngle={90}
                endAngle={-270}
                paddingAngle={3}
              >
                {(hasData ? typeCounts : [{ name: "No Data", value: 1 }]).map((_, i) => (
                  <Cell key={i} fill={hasData ? COLORS[i % COLORS.length] : "#e0e0e0"} />
                ))}
              </Pie>
            </PieChart>

            {/* Center Text */}
            <Box
              sx={{
                position: "absolute",
                textAlign: "center",
                transform: "translate(-50%, -50%)",
                left: "50%",
                top: "50%",
              }}
            >
              {hasData ? (
                <>
                  <Typography variant="h5" fontWeight="bold">{total}</Typography>
                  <Typography variant="body2" color="text.secondary">Requests</Typography>
                </>
              ) : (
                <Typography variant="body2" color="text.secondary">No Data</Typography>
              )}
            </Box>

            {/* Legend on right side */}
            <Stack spacing={1} sx={{ ml: 3 }}>
              {(hasData ? typeCounts : [{ name: "No Data", value: 0 }]).map((entry, index) => (
                <Box key={index} sx={{ display: "flex", alignItems: "center" }}>
                  <Box
                    sx={{
                      width: 14,
                      height: 14,
                      backgroundColor: hasData ? COLORS[index % COLORS.length] : "#e0e0e0",
                      mr: 1,
                    }}
                  />
                  <Typography variant="body2">{entry.name}: {entry.value}</Typography>
                </Box>
              ))}
            </Stack>
          </Box>
        </Grid>

        {/* Trend Chart */}
        <Grid item xs={12} md={6}>
          {hasData ? (
            <ResponsiveContainer width="100%" height={250}>
              <LineChart data={trendData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="date" />
                <YAxis />
                <Tooltip />
                <Line type="monotone" dataKey="requests" stroke="#0288d1" strokeWidth={2} />
              </LineChart>
            </ResponsiveContainer>
          ) : (
            <Box sx={{ textAlign: "center", mt: 6 }}>
              <Typography color="text.secondary">No Trend Data Available</Typography>
            </Box>
          )}
        </Grid>
      </Grid>
    </Box>
  );
}