@Repository
public interface LedgerWiseRepository
        extends JpaRepository<LedgerTransaction, BigInteger>,
        JpaSpecificationExecutor<LedgerTransaction> {

}

public class LedgerWiseSpecification {

    public static Specification<LedgerTransaction>
    filter(LedgerWiseRequest dto) {

        return (root, query, cb) -> {

            List<Predicate> predicates =
                    new ArrayList<>();

            if (dto.getCgl() != null) {

                predicates.add(
                        cb.equal(
                                root.get("cgl"),
                                dto.getCgl()
                        )
                );
            }

            if (
                    dto.getCurrencies() != null &&
                    !"ALL".equalsIgnoreCase(
                            dto.getCurrencies()
                    )
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currency"),
                                dto.getCurrencies()
                        )
                );
            }

            if (
                    dto.getBranches() != null &&
                    !dto.getBranches()
                            .contains("ALL")
            ) {

                predicates.add(
                        root.get("branchCode")
                                .in(dto.getBranches())
                );
            }

            if (
                    dto.getSourceFlags() != null &&
                    !dto.getSourceFlags()
                            .contains("ALL")
            ) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags())
                );
            }

            return cb.and(
                    predicates.toArray(
                            new Predicate[0]
                    )
            );
        };
    }
}

