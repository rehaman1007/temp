import React, { useState, useCallback, useEffect } from "react";
import { useSelector } from "react-redux";
import { Box } from "@mui/material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";

import LedgerForm from "./components/LedgerForm";
import LedgerDataGrid from "./components/LedgerDataGrid";

import { getPermissions } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const LedgerWiseEnquiry = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const user = useSelector((state) => state.auth.user);
  const menu = useSelector((state) => state.menus.selectedMenuItem);

  const permissions = getPermissions(menu);

  const hasWholeBank = !!permissions.wholebank;
  const hasCircle = user?.isCircle === "Y" || !!permissions.circle;
  const isCircleUser = user?.isCircle === "Y" && !hasWholeBank;

  // ================= MASTER DATA =================
  const [circles, setCircles] = useState([]);
  const [currencies, setCurrencies] = useState([]);
  const [sourceOptions, setSourceOptions] = useState([]);
  const [etlDate, setEtlDate] = useState(null);

  // ================= GRID DATA =================
  const [rows, setRows] = useState([]);
  const [rowCount, setRowCount] = useState(0);

  // ================= LOADING =================
  const [loading, setLoading] = useState(false);
  const [exporting, setExporting] = useState(false);

  // ================= GRID CONTROLS =================
  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 20,
  });

  const [sortModel, setSortModel] = useState([
    {
      field: "transactionDate",
      sort: "desc",
    },
  ]);

  const [filterModel, setFilterModel] = useState({
    items: [],
  });

  // ================= FILTER STATE =================
  const initialState = {
    level: hasWholeBank ? "BANK" : isCircleUser ? "CIRCLE" : "BRANCH",

    circle: hasWholeBank ? "ALL" : user?.circleCode,

    branches:
      user?.isCircle === "N" && !hasWholeBank
        ? [user?.branchCode]
        : ["ALL"],

    currencies: "ALL",

    sourceFlags: [],

    cgl: "",

    fromDate: null,

    toDate: null,
  };

  const [filters, setFilters] = useState(initialState);

  const [searchQuery, setSearchQuery] = useState(null);

  // ================= FETCH MASTERS =================
  const fetchMasters = useCallback(async () => {
    try {
      const [dateRes, currRes, flagRes] = await Promise.all([
        callApi("/PS/file/fincore-date", {}, "GET"),

        callApi("/CM/common-master/currency-code-name-only", null, "GET"),

        callApi("/CM/common-master/source-flag", null, "GET"),
      ]);

      if (dateRes?.data?.etlDate) {
        setEtlDate(dayjs(dateRes.data.etlDate, "DD-MM-YYYY"));
      }

      const formattedCurrencies =
        currRes?.data?.map(
          (c) => `${c.currencyCode} (${c.currencyName})`,
        ) || [];

      setCurrencies(
        formattedCurrencies.sort((a, b) => a.localeCompare(b)),
      );

      if (flagRes?.data) {
        setSourceOptions(flagRes.data);

        setFilters((prev) => ({
          ...prev,
          sourceFlags: flagRes.data,
        }));
      }

      if (hasWholeBank) {
        const circleRes = await callApi(
          "/CM/common-master/circle-codes",
          null,
          "GET",
        );

        setCircles(circleRes?.data || []);
      }
    } catch (error) {
      showSnackBar(
        "Failed to load master configuration",
        "error",
      );
    }
  }, [callApi, hasWholeBank, showSnackBar]);

  useEffect(() => {
    fetchMasters();
  }, [fetchMasters]);

  // ================= RESET PAGE WHEN GRID CHANGES =================
  useEffect(() => {
    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));
  }, [sortModel, filterModel, searchQuery]);

  // ================= PAYLOAD BUILDER =================
  const buildPayload = useCallback(() => {
    if (!searchQuery) return null;

    const gridFilters = filterModel.items
      .filter(
        (item) =>
          item.field &&
          item.operator &&
          item.value !== undefined &&
          item.value !== null &&
          item.value !== "",
      )
      .map((item) => ({
        field: item.field,
        operator: item.operator,
        value: item.value,
      }));

    return {
      circle:
        searchQuery.circle === "ALL"
          ? "ALL"
          : searchQuery.circle.split(" - ")[0],

      cgl: searchQuery.cgl.split(" - ")[0],

      currencies:
        searchQuery.currencies === "ALL"
          ? "ALL"
          : searchQuery.currencies.split(" (")[0],

      branches: searchQuery.branches.includes("ALL")
        ? ["ALL"]
        : searchQuery.branches.map((b) => b.split("-")[0]),

      sourceFlags: searchQuery.sourceFlags.map(
        (f) => f.flagId,
      ),

      fromDate: searchQuery.fromDate.format("DD/MM/YYYY"),

      toDate: searchQuery.toDate.format("DD/MM/YYYY"),

      page: paginationModel.page,

      size: paginationModel.pageSize,

      sortField:
        sortModel?.[0]?.field || "transactionDate",

      sortOrder:
        sortModel?.[0]?.sort || "desc",

      gridFilters,
    };
  }, [
    searchQuery,
    paginationModel,
    sortModel,
    filterModel,
  ]);

  // ================= FETCH ROWS =================
  const fetchRows = useCallback(async () => {
    const payload = buildPayload();

    if (!payload) return;

    try {
      setLoading(true);

      const res = await callApi(
        "/ES/ledger-enquiries/search",
        payload,
        "POST",
      );

      setRows(res?.data?.content || []);

      setRowCount(res?.data?.totalElements || 0);
    } catch (error) {
      showSnackBar("Enquiry failed", "error");
    } finally {
      setLoading(false);
    }
  }, [callApi, buildPayload, showSnackBar]);

  useEffect(() => {
    fetchRows();
  }, [fetchRows]);

  // ================= SEARCH =================
  const handleSearch = () => {
    if (
      !filters.cgl ||
      !filters.fromDate ||
      !filters.toDate
    ) {
      showSnackBar(
        "Please fill all required fields",
        "warning",
      );

      return;
    }

    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));

    setSearchQuery({ ...filters });
  };

  // ================= RESET =================
  const handleReset = () => {
    setFilters(initialState);

    setSearchQuery(null);

    setRows([]);

    setRowCount(0);

    setPaginationModel({
      page: 0,
      pageSize: 20,
    });

    setSortModel([
      {
        field: "transactionDate",
        sort: "desc",
      },
    ]);

    setFilterModel({
      items: [],
    });
  };

  // ================= EXCEL EXPORT =================
  const handleExcelExport = async () => {
    const payload = buildPayload();

    if (!payload) return;

    try {
      setExporting(true);

      const exportPayload = {
        ...payload,
        page: 0,
        size: 100000,
      };

      const response = await callApi(
        "/ES/ledger-enquiries/export",
        exportPayload,
        "POST",
        {
          responseType: "blob",
        },
      );

      const url = window.URL.createObjectURL(
        new Blob([response.data]),
      );

      const link = document.createElement("a");

      link.href = url;

      link.setAttribute(
        "download",
        `Ledger_${
          searchQuery.cgl.split(" - ")[0]
        }_${dayjs().format("YYYYMMDD")}.xlsx`,
      );

      document.body.appendChild(link);

      link.click();

      link.remove();
    } catch (error) {
      showSnackBar("Export failed", "error");
    } finally {
      setExporting(false);
    }
  };

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Box sx={{ p: 3 }}>
        <LedgerForm
          filters={filters}
          onFilterChange={(field, value) =>
            setFilters((prev) => ({
              ...prev,
              [field]: value,
            }))
          }
          onFetch={handleSearch}
          onReset={handleReset}
          permissions={{
            hasWholeBank,
            hasCircle,
          }}
          user={user}
          circles={circles}
          currencies={currencies}
          sourceOptions={sourceOptions}
          etlDate={etlDate}
        />

        <LedgerDataGrid
          rows={rows}
          loading={loading}
          rowCount={rowCount}
          paginationModel={paginationModel}
          setPaginationModel={setPaginationModel}
          sortModel={sortModel}
          setSortModel={setSortModel}
          filterModel={filterModel}
          setFilterModel={setFilterModel}
          onExcelExport={handleExcelExport}
          exporting={exporting}
          selectedCurrency={
            searchQuery?.currencies || "ALL"
          }
          circles={circles}
        />
      </Box>
    </LocalizationProvider>
  );
};

export default LedgerWiseEnquiry;

import React, { useMemo } from "react";

import {
  Box,
  Typography,
  Button,
  CircularProgress,
  Stack,
  Chip,
} from "@mui/material";

import { DataGrid } from "@mui/x-data-grid";

import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import FileDownloadIcon from "@mui/icons-material/FileDownload";

import dayjs from "dayjs";

const sourceFlagNames = {
  J: "Journal Entry",
  S: "System Generated",
  M: "Manual Entry",
  P: "PPF",
  F: "FCNB",
  T: "Profit Transfer",
  V: "Provision",
};

const LedgerDataGrid = ({
  rows,
  loading,
  rowCount,

  paginationModel,
  setPaginationModel,

  sortModel,
  setSortModel,

  filterModel,
  setFilterModel,

  onExcelExport,
  exporting,

  selectedCurrency,

  circles,
}) => {
  const transactionColumns = useMemo(() => {
    const cols = [
      {
        field: "transactionId",
        headerName: "ID",
        width: 120,
        filterable: false,
      },

      {
        field: "transactionDate",
        headerName: "Transaction Date",
        width: 140,

        valueFormatter: ({ value }) =>
          value
            ? dayjs(value).format("DD/MM/YYYY")
            : "-",
      },

      {
        field: "postDate",
        headerName: "Post Date",
        width: 140,

        valueFormatter: ({ value }) =>
          value
            ? dayjs(value).format("DD/MM/YYYY")
            : "-",
      },

      {
        field: "circleName",
        headerName: "Circle",
        width: 170,
      },

      {
        field: "branchName",
        headerName: "Branch",
        width: 220,
      },

      {
        field: "currency",
        headerName: "Currency",
        width: 120,
      },

      {
        field: "cgl",
        headerName: "CGL",
        width: 150,
      },

      {
        field: "description",
        headerName: "Description",
        minWidth: 250,
        flex: 1,
      },

      {
        field: "narration",
        headerName: "Narration",
        minWidth: 300,
        flex: 1.2,
      },

      {
        field: "debitAmount",
        headerName: "Debit Amount",
        width: 160,
        type: "number",
        align: "right",
        headerAlign: "right",

        valueFormatter: ({ value }) =>
          new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
          }).format(value || 0),
      },

      {
        field: "creditAmount",
        headerName: "Credit Amount",
        width: 160,
        type: "number",
        align: "right",
        headerAlign: "right",

        valueFormatter: ({ value }) =>
          new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
          }).format(value || 0),
      },

      {
        field: "sourceFlag",
        headerName: "Source",
        width: 170,

        valueGetter: ({ value }) =>
          sourceFlagNames[value] || value,
      },
    ];

    if (selectedCurrency === "ALL") {
      cols.splice(5, 0, {
        field: "currencyName",
        headerName: "Currency Name",
        width: 180,
      });
    }

    return cols;
  }, [selectedCurrency, circles]);

  const CustomNoRowsOverlay = () => (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        justifyContent: "center",
        alignItems: "center",
        height: "100%",
      }}
    >
      <ErrorOutlineIcon
        fontSize="large"
        color="action"
      />

      <Typography
        variant="body1"
        sx={{
          mt: 1,
          color: "text.secondary",
        }}
      >
        Data is not available
      </Typography>
    </Box>
  );

  return (
    <Box sx={{ width: "100%", mt: 3 }}>
      <Box
        sx={{
          p: 2.5,
          mb: 3,
          borderRadius: "20px",
          background:
            "rgba(255,255,255,0.4)",
          backdropFilter: "blur(12px)",
          border:
            "1px solid rgba(255,255,255,0.3)",
          boxShadow:
            "0 8px 32px rgba(0,0,0,0.05)",
          display: "flex",
          flexDirection: "column",
          gap: 2.5,
        }}
      >
        {/* HEADER */}
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
        >
          <Box
            sx={{
              display: "flex",
              alignItems: "baseline",
              gap: 1.5,
            }}
          >
            <Typography
              variant="h6"
              fontWeight={800}
            >
              Transactions Ledger
            </Typography>

            <Chip
              label={
                rowCount > 0
                  ? `${rowCount.toLocaleString()} Records Found`
                  : "No Records"
              }
              size="small"
            />
          </Box>

          <Button
            variant="contained"
            size="small"
            startIcon={
              exporting ? (
                <CircularProgress
                  size={16}
                  color="inherit"
                />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onExcelExport}
            disabled={
              !rowCount ||
              loading ||
              exporting
            }
            sx={{
              textTransform: "none",
              fontWeight: 700,
            }}
          >
            {exporting
              ? "Preparing..."
              : "Export"}
          </Button>
        </Stack>

        {/* GRID */}
        <Box sx={{ height: 650 }}>
          <DataGrid
            rows={rows}
            columns={transactionColumns}
            rowCount={rowCount}
            loading={loading}
            getRowId={(row) =>
              row.transactionId
            }

            pagination
            paginationMode="server"
            sortingMode="server"
            filterMode="server"

            pageSizeOptions={[
              10,
              20,
              50,
              100,
            ]}

            paginationModel={
              paginationModel
            }
            onPaginationModelChange={
              setPaginationModel
            }

            sortModel={sortModel}
            onSortModelChange={
              setSortModel
            }

            filterModel={filterModel}
            onFilterModelChange={
              setFilterModel
            }

            disableRowSelectionOnClick

            rowHeight={58}

            slots={{
              noRowsOverlay:
                CustomNoRowsOverlay,
            }}

            sx={{
              borderRadius: "20px",

              backgroundColor:
                "rgba(255,255,255,0.4)",

              border:
                "1px solid rgba(255,255,255,0.3)",

              "& .MuiDataGrid-columnHeaders":
                {
                  backgroundColor:
                    "#f8f9fa",
                  fontWeight: 700,
                },

              "& .MuiDataGrid-cell:focus":
                {
                  outline: "none",
                },

              "& .MuiDataGrid-columnHeader:focus":
                {
                  outline: "none",
                },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
};

export default LedgerDataGrid;