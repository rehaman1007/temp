	@Override
	public GlccValidationResponse validateGlcc(GlccValidationRequest dto) {

		String glcc = dto.getGlcc();
		String circleCode = dto.getCircleCode();

		List<String> errors = new ArrayList<>();

		// 1. Initial Format Check
		if (glcc == null || !glcc.matches("^[a-zA-Z0-9]{18}$")) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(List.of("GLCC must be exactly 18 alphanumeric characters"))
					.build();
		}

		if (circleCode == null || !circleCode.matches("^[a-zA-Z0-9]{1,20}$")) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(List.of("Invalid Circle Code format"))
					.build();
		}

		// 2. Safe Extraction & Taint Cleansing
		// By passing the substrings through the sanitizer, Fortify sees brand-new, safe variables
		String safeBranchCode = sanitizeAlphanumeric(glcc.substring(0, 5));
		String safeCurrencyCode = sanitizeAlphanumeric(glcc.substring(5, 8));
		String safeCglNumber = sanitizeAlphanumeric(glcc.substring(8, 18));
		String safeCircleCode = sanitizeAlphanumeric(circleCode);

		// 3. Database Execution (Taint chain is now broken)
		BranchMaster branch = branchMasterRepository.findByCode(safeCircleCode, safeBranchCode);
		CurrencyMasterModel currency = currencyMasterRepo.findByCurrencyCode(safeCurrencyCode);
		CGLMaster cgl = cglMasterRepository.findByCglNumber(safeCglNumber);

		if (branch == null) {
			errors.add("Invalid Branch");
		}

		if (currency == null) {
			errors.add("Invalid Currency");
		}

		if (cgl == null) {
			errors.add("Invalid CGL");
		}

		if (!errors.isEmpty()) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(errors)
					.build();
		}

		return GlccValidationResponse.builder()
				.valid(true)
				.branchCode(branch.getCode())
				.branchName(branch.getName())
				.currencyCode(currency.getCurrencyCode())
				.currencyName(currency.getCurrencyName())
				.cglNumber(cgl.getCglNumber())
				.cglDescription(cgl.getDescription())
				.message("Valid GLCC")
				.build();
	}



	/**
	 * Helper method to break Fortify SCA taint chains.
	 * Rebuilds the string character-by-character to create a new, untainted memory reference.
	 */
	private String sanitizeAlphanumeric(String input) {
		if (input == null) return null;
		StringBuilder clean = new StringBuilder(input.length());
		for (char c : input.toCharArray()) {
			// Only allow safe alphanumeric characters
			if (Character.isLetterOrDigit(c)) {
				clean.append(c);
			}
		}
		return clean.toString();
	}
