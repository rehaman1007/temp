import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Entity
@Table(name = "ROLE_ACCESS")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class RoleAccess {

    @Id
    @Column(name = "ACCESS_FLAG", length = 5)
    private String accessFlag;

    @Column(name = "ACCESS_NAME", length = 100)
    private String accessName;

    @Column(name = "ACCESS_DESCRIPTION", length = 255)
    private String accessDescription;

    @Column(name = "ACCESS_STATUS", length = 20)
    private String accessStatus;
}



import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface RoleAccessRepository extends JpaRepository<RoleAccess, String> {
    
    // Spring JPA automatically translates this to: 
    // SELECT * FROM ROLE_ACCESS WHERE ACCESS_STATUS = ?
    List<RoleAccess> findByAccessStatusIgnoreCase(String accessStatus);
}



import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class RoleAccessService {

    private final RoleAccessRepository roleAccessRepository;

    public List<RoleAccessDTO> getActiveRoleAccessList() {
        // Fetch only rows where ACCESS_STATUS is 'Active'
        List<RoleAccess> activeAccessList = roleAccessRepository.findByAccessStatusIgnoreCase("Active");

        // Convert the Entities into DTOs
        return activeAccessList.stream()
            .map(access -> new RoleAccessDTO(
                    access.getAccessFlag(),
                    access.getAccessName(),
                    access.getAccessDescription()
            ))
            .collect(Collectors.toList());
    }
}


import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import java.util.List;

@RestController
@RequestMapping("/UM/role")
@RequiredArgsConstructor
public class RoleController {

    private final RoleAccessService roleAccessService;

    @GetMapping("/get-role-access-list")
    public ResponseEntity<ApiResponse<List<RoleAccessDTO>>> getRoleAccessList() {
        
        List<RoleAccessDTO> result = roleAccessService.getActiveRoleAccessList();
        
        // Wrap response exactly how frontend expects it
        ApiResponse<List<RoleAccessDTO>> response = new ApiResponse<>(
                HttpStatus.OK.value(),
                "Role access list fetched successfully",
                result
        );

        return ResponseEntity.ok(response);
    }
}


import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
public class RoleAccessDTO {
    private String accessFlag;
    private String accessName;
    private String accessDescription;
}

