<DatePicker
  value={filters.fromDate}
  format="DD/MM/YYYY"
  minDate={minLimit}
  maxDate={maxLimit}
  views={["year", "month", "day"]}
  onChange={(v) => {
    onFilterChange("fromDate", v);

    if (
      v &&
      filters.toDate &&
      v.isValid() &&
      filters.toDate.isValid()
    ) {
      if (v.isAfter(filters.toDate, "day")) {
        setFromDateError("fromGreaterThanTo");
        setToDateError("toLessThanFrom");
      } else {
        setFromDateError(null);
        setToDateError(null);
      }
    }
  }}
  onError={(error) => {
    if (error) {
      setFromDateError(error);
      return;
    }

    setFromDateError(null);
  }}
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",
      onChange: (e) => setFromDateInput(e.target.value),
      error: fromDateInput.length === 10 && !!fromDateError,
      helperText:
        fromDateInput.length === 10
          ? getDateErrorMessage(fromDateError)
          : "",
      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>



<DatePicker
  value={filters.toDate}
  format="DD/MM/YYYY"
  minDate={minLimit}
  maxDate={maxLimit}
  views={["year", "month", "day"]}
  onChange={(v) => {
    onFilterChange("toDate", v);

    if (
      filters.fromDate &&
      v &&
      filters.fromDate.isValid() &&
      v.isValid()
    ) {
      if (v.isBefore(filters.fromDate, "day")) {
        setToDateError("toLessThanFrom");
        setFromDateError("fromGreaterThanTo");
      } else {
        setToDateError(null);
        setFromDateError(null);
      }
    }
  }}
  onError={(error) => {
    if (error) {
      setToDateError(error);
      return;
    }

    setToDateError(null);
  }}
  slotProps={{
    textField: {
      size: "small",
      fullWidth: true,
      placeholder: "DD/MM/YYYY",
      onChange: (e) => setToDateInput(e.target.value),
      error: toDateInput.length === 10 && !!toDateError,
      helperText:
        toDateInput.length === 10
          ? getDateErrorMessage(toDateError)
          : "",
      sx: {
        bgcolor: "white",
        borderRadius: 2,
        flex: 1,
      },
    },
  }}
/>



const [fromDateError, setFromDateError] = useState(null);
const [toDateError, setToDateError] = useState(null);

const [fromDateInput, setFromDateInput] = useState("");
const [toDateInput, setToDateInput] = useState("");


const getDateErrorMessage = (error) => {
  switch (error) {
    case "maxDate":
      return "Date cannot be in future";

    case "minDate":
      return `Date cannot be before ${minLimit.format("DD/MM/YYYY")}`;

    case "invalidDate":
      return "Please enter a valid date";

    case "fromGreaterThanTo":
      return "From Date cannot be greater than To Date";

    case "toLessThanFrom":
      return "To Date cannot be less than From Date";

    default:
      return "";
  }
};