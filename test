package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import javax.sql.DataSource;

import java.io.BufferedReader;
import java.io.InputStreamReader;

import java.sql.Connection;
import java.sql.Statement;

import java.time.Duration;
import java.time.Instant;

import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    private final DataSource dataSource;

    private final JdbcTemplate jdbcTemplate;

    /**
     * CHANGE THIS FOR PERFORMANCE
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * JOB STATUS STORE
     */
    private final Map<String, Map<String, Object>> jobStatusMap =
            new ConcurrentHashMap<>();

    /**
     * ASYNC SQL EXECUTION
     */
    @Async("sqlExecutor")
    public void executeScriptAsync(
            byte[] fileBytes,
            String fileName,
            String jobId,
            String userId,
            String clientIp
    ) {

        Instant start = Instant.now();

        Connection connection = null;

        BufferedReader reader = null;

        int executed = 0;

        int insertCount = 0;
        int updateCount = 0;
        int deleteCount = 0;
        int otherCount = 0;

        int totalStatements = 0;

        int failedStatementNumber = 0;

        double executionSpeed = 0;

        String failedSql = null;

        try {

            log.info("""
                    SQL EXECUTION STARTED
                    | jobId={}
                    | file={}
                    | user={}
                    | ip={}
                    | batchCommit={}
                    """,
                    jobId,
                    fileName,
                    userId,
                    clientIp,
                    COMMIT_BATCH_SIZE
            );

            /**
             * INITIAL STATUS
             */
            jobStatusMap.put(jobId, new ConcurrentHashMap<>());

            jobStatusMap.get(jobId).put("status", "RUNNING");
            jobStatusMap.get(jobId).put("executedCount", 0);
            jobStatusMap.get(jobId).put("insertCount", 0);
            jobStatusMap.get(jobId).put("updateCount", 0);
            jobStatusMap.get(jobId).put("deleteCount", 0);
            jobStatusMap.get(jobId).put("otherCount", 0);
            jobStatusMap.get(jobId).put("progress", 0);

            connection = dataSource.getConnection();

            connection.setAutoCommit(false);

            Statement statement = connection.createStatement();

            reader = new BufferedReader(
                    new InputStreamReader(
                            new java.io.ByteArrayInputStream(fileBytes)
                    )
            );

            /**
             * PRECOUNT TOTAL STATEMENTS
             */
            BufferedReader counterReader = new BufferedReader(
                    new InputStreamReader(
                            new java.io.ByteArrayInputStream(fileBytes)
                    )
            );

            String counterLine;

            while ((counterLine = counterReader.readLine()) != null) {

                if (counterLine.trim().endsWith(";")) {
                    totalStatements++;
                }
            }

            log.info(
                    "TOTAL STATEMENTS DETECTED | jobId={} | total={}",
                    jobId,
                    totalStatements
            );

            StringBuilder sqlBuilder = new StringBuilder();

            String line;

            int currentLine = 0;

            while ((line = reader.readLine()) != null) {

                currentLine++;

                String trimmed = line.trim();

                /**
                 * IGNORE COMMENTS
                 */
                if (trimmed.startsWith("--")
                        || trimmed.isBlank()) {
                    continue;
                }

                sqlBuilder.append(line).append("\n");

                /**
                 * END OF SQL
                 */
                if (trimmed.endsWith(";")) {

                    String sql = sqlBuilder.toString().trim();

                    sql = sql.substring(0, sql.lastIndexOf(";"));

                    failedSql = sql;

                    failedStatementNumber = executed + 1;

                    /**
                     * SQL TYPE COUNTER
                     */
                    String upperSql = sql.toUpperCase();

                    if (upperSql.startsWith("INSERT")) {

                        insertCount++;

                    } else if (upperSql.startsWith("UPDATE")) {

                        updateCount++;

                    } else if (upperSql.startsWith("DELETE")) {

                        deleteCount++;

                    } else {

                        otherCount++;
                    }

                    /**
                     * EXECUTE
                     */
                    statement.execute(sql);

                    executed++;

                    /**
                     * EXECUTION SPEED
                     */
                    long elapsedSeconds =
                            Duration.between(start, Instant.now())
                                    .toSeconds();

                    if (elapsedSeconds > 0) {

                        executionSpeed =
                                (double) executed / elapsedSeconds;
                    }

                    /**
                     * PROGRESS %
                     */
                    double progress = totalStatements == 0
                            ? 0
                            : ((double) executed / totalStatements) * 100;

                    /**
                     * ETA
                     */
                    long etaSeconds = 0;

                    if (executionSpeed > 0) {

                        etaSeconds =
                                (long) ((totalStatements - executed)
                                        / executionSpeed);
                    }

                    /**
                     * UPDATE UI STATUS
                     */
                    jobStatusMap.get(jobId).put(
                            "status",
                            "RUNNING"
                    );

                    jobStatusMap.get(jobId).put(
                            "executedCount",
                            executed
                    );

                    jobStatusMap.get(jobId).put(
                            "insertCount",
                            insertCount
                    );

                    jobStatusMap.get(jobId).put(
                            "updateCount",
                            updateCount
                    );

                    jobStatusMap.get(jobId).put(
                            "deleteCount",
                            deleteCount
                    );

                    jobStatusMap.get(jobId).put(
                            "otherCount",
                            otherCount
                    );

                    jobStatusMap.get(jobId).put(
                            "progress",
                            progress
                    );

                    jobStatusMap.get(jobId).put(
                            "totalStatements",
                            totalStatements
                    );

                    jobStatusMap.get(jobId).put(
                            "executionSpeed",
                            String.format("%.2f", executionSpeed)
                    );

                    jobStatusMap.get(jobId).put(
                            "etaSeconds",
                            etaSeconds
                    );

                    jobStatusMap.get(jobId).put(
                            "currentStatement",
                            failedStatementNumber
                    );

                    /**
                     * COMMIT BATCH
                     */
                    if (executed % COMMIT_BATCH_SIZE == 0) {

                        connection.commit();

                        log.info("""
                                BATCH COMMIT
                                | jobId={}
                                | committed={}
                                | progress={}%
                                | speed={} stmt/sec
                                """,
                                jobId,
                                executed,
                                String.format("%.2f", progress),
                                String.format("%.2f", executionSpeed)
                        );
                    }

                    /**
                     * CLEAR
                     */
                    sqlBuilder.setLength(0);
                }
            }

            /**
             * FINAL COMMIT
             */
            connection.commit();

            long totalSeconds =
                    Duration.between(start, Instant.now())
                            .toSeconds();

            /**
             * FINAL STATUS
             */
            jobStatusMap.get(jobId).put(
                    "status",
                    "COMPLETED"
            );

            jobStatusMap.get(jobId).put(
                    "completedAt",
                    Instant.now().toString()
            );

            jobStatusMap.get(jobId).put(
                    "elapsedSeconds",
                    totalSeconds
            );

            /**
             * INSERT FINAL LOG
             */
            insertExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    "UPLOAD_SCRIPT",
                    "COMPLETED",
                    totalStatements,
                    executed,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    null,
                    null,
                    null,
                    null,
                    executionSpeed,
                    totalSeconds,
                    "SCRIPT EXECUTION COMPLETED"
            );

            log.info("""
                    SQL EXECUTION COMPLETED
                    | jobId={}
                    | total={}
                    | inserts={}
                    | updates={}
                    | deletes={}
                    | others={}
                    | time={} sec
                    | speed={} stmt/sec
                    """,
                    jobId,
                    executed,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    totalSeconds,
                    String.format("%.2f", executionSpeed)
            );

        } catch (Exception e) {

            log.error("""
                    SQL EXECUTION FAILED
                    | jobId={}
                    | failedStatement={}
                    | executed={}
                    | failedSql={}
                    """,
                    jobId,
                    failedStatementNumber,
                    executed,
                    failedSql,
                    e
            );

            try {

                if (connection != null) {

                    connection.rollback();

                    log.error(
                            "ROLLBACK COMPLETED | jobId={}",
                            jobId
                    );
                }

            } catch (Exception rollbackEx) {

                log.error(
                        "ROLLBACK FAILED | jobId={}",
                        jobId,
                        rollbackEx
                );
            }

            long totalSeconds =
                    Duration.between(start, Instant.now())
                            .toSeconds();

            /**
             * UPDATE STATUS
             */
            if (jobStatusMap.containsKey(jobId)) {

                jobStatusMap.get(jobId).put(
                        "status",
                        "FAILED"
                );

                jobStatusMap.get(jobId).put(
                        "message",
                        e.getMessage()
                );

                jobStatusMap.get(jobId).put(
                        "failedStatement",
                        failedStatementNumber
                );

                jobStatusMap.get(jobId).put(
                        "failedSql",
                        failedSql
                );
            }

            /**
             * INSERT FAILURE LOG
             */
            insertExecutionLog(
                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    "UPLOAD_SCRIPT",
                    "FAILED",
                    totalStatements,
                    executed,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedStatementNumber,
                    failedSql,
                    e.getClass().getSimpleName(),
                    e.getMessage(),
                    executionSpeed,
                    totalSeconds,
                    failedSql
            );

        } finally {

            try {

                if (reader != null) {
                    reader.close();
                }

                if (connection != null) {
                    connection.close();
                }

            } catch (Exception ex) {

                log.error("RESOURCE CLEANUP FAILED", ex);
            }
        }
    }

    /**
     * INSERT EXECUTION LOG
     */
    private void insertExecutionLog(
            String jobId,
            String userId,
            String clientIp,
            String fileName,
            String executionType,
            String status,
            int totalStatements,
            int executedCount,
            int insertCount,
            int updateCount,
            int deleteCount,
            int otherCount,
            Integer failedStatementNumber,
            String failedSql,
            String exceptionType,
            String exceptionMessage,
            double executionSpeed,
            long elapsedSeconds,
            String sqlText
    ) {

        try {

            jdbcTemplate.update("""
                    
                    INSERT INTO ADMIN_SUPPORT_LOG
                    (
                        ID,
                        JOB_ID,
                        USER_ID,
                        CLIENT_IP,
                        FILE_NAME,
                        EXECUTION_TYPE,
                        STATUS,
                        TOTAL_STATEMENTS,
                        EXECUTED_COUNT,
                        INSERT_COUNT,
                        UPDATE_COUNT,
                        DELETE_COUNT,
                        OTHER_COUNT,
                        FAILED_STATEMENT_NUMBER,
                        FAILED_SQL,
                        EXCEPTION_TYPE,
                        EXCEPTION_MESSAGE,
                        EXECUTION_SPEED,
                        ELAPSED_SECONDS,
                        SQL_TEXT,
                        STARTED_AT,
                        CREATED_AT
                    )
                    VALUES
                    (
                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        ?,
                        SYSTIMESTAMP,
                        SYSTIMESTAMP
                    )
                    """,

                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    executionType,
                    status,
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedStatementNumber,
                    failedSql,
                    exceptionType,
                    exceptionMessage,
                    executionSpeed,
                    elapsedSeconds,
                    sqlText
            );

        } catch (Exception e) {

            log.error("FAILED TO INSERT EXECUTION LOG", e);
        }
    }

    /**
     * STATUS API
     */
    public Map<String, Object> getJobStatus(String jobId) {

        return jobStatusMap.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }
}