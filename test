import React from "react";

import {
  Box,
  Button,
  Divider,
  IconButton,
  Paper,
  Stack,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";

import {
  CleaningServices,
  ContentCopy,
  PlayArrow,
  Terminal,
} from "@mui/icons-material";

const CommandPanel = ({
  query,
  setQuery,
  handleExecute,
  isDangerous,
  setConfirmOpen,
}) => {
  /**
   * =========================================
   * CTRL + ENTER
   * =========================================
   */

  const handleKeyDown = (e) => {
    if (e.ctrlKey && e.key === "Enter") {
      e.preventDefault();

      if (isDangerous) {
        setConfirmOpen(true);
      } else {
        handleExecute(true);
      }
    }
  };

  /**
   * =========================================
   * EXECUTE CLICK
   * =========================================
   */

  const onExecute = () => {
    if (isDangerous) {
      setConfirmOpen(true);
    } else {
      handleExecute(true);
    }
  };

  return (
    <Paper
      elevation={0}
      sx={{
        borderRadius: 3,
        overflow: "hidden",
        border: "1px solid #e5e7eb",
      }}
    >
      {/* HEADER */}

      <Box
        sx={{
          px: 2,
          py: 1.2,
          bgcolor: "#111827",
          color: "white",
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          alignItems="center"
        >
          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
          >
            <Terminal fontSize="small" />

            <Typography fontWeight={700}>
              SQL Worksheet
            </Typography>
          </Stack>

          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
          >
            <Typography variant="caption">
              Ctrl + Enter
            </Typography>

            <Tooltip title="Copy SQL">
              <IconButton
                size="small"
                onClick={() =>
                  navigator.clipboard.writeText(
                    query,
                  )
                }
              >
                <ContentCopy
                  sx={{
                    color: "white",
                  }}
                />
              </IconButton>
            </Tooltip>

            <Divider
              orientation="vertical"
              flexItem
            />

            <Tooltip title="Clear">
              <IconButton
                size="small"
                onClick={() =>
                  setQuery("")
                }
              >
                <CleaningServices
                  sx={{
                    color: "white",
                  }}
                />
              </IconButton>
            </Tooltip>

            <Divider
              orientation="vertical"
              flexItem
            />

            <Button
              variant="contained"
              color={
                isDangerous
                  ? "error"
                  : "primary"
              }
              startIcon={<PlayArrow />}
              onClick={onExecute}
            >
              Execute
            </Button>
          </Stack>
        </Stack>
      </Box>

      {/* SQL INPUT */}

      <TextField
        multiline
        fullWidth
        minRows={14}
        value={query}
        onChange={(e) =>
          setQuery(e.target.value)
        }
        onKeyDown={handleKeyDown}
        variant="standard"
        InputProps={{
          disableUnderline: true,

          sx: {
            p: 3,
            bgcolor: "#0d1117",
            color: "#d4d4d4",
            fontFamily:
              "'Fira Code', monospace",
            fontSize: 14,
          },
        }}
      />
    </Paper>
  );
};

export default CommandPanel;