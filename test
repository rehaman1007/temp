import React, { useMemo } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  alpha,
  Tooltip,
  Stack,
  Divider,
} from "@mui/material";
import { Close, DoneAll, NotificationsNone } from "@mui/icons-material";
import useNotifications from "../hooks/useNotifications";
import { formatRelativeTime } from "../utils/CommonUtilities";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
}) => {
  const { notifications, markAsRead, loadMore, hasMore } = useNotifications();

  /** Sort notifications latest first */
  const sortedNotifications = useMemo(
    () =>
      [...notifications].sort(
        (a, b) => new Date(b.createdAt) - new Date(a.createdAt)
      ),
    [notifications]
  );

  /** Placeholder: mark all as read (you’ll implement API later) */
  const handleMarkAllAsRead = () => {
    console.log("Marking all notifications as read (placeholder)");
    // TODO: Implement markAllAsRead API later
    // For now, update local state visually
    sortedNotifications.forEach((n) => markAsRead(n.id));
  };

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          p: 0,
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* Header */}
      <Box
        sx={{
          p: 3,
          borderBottom: "1px solid #E2E8F0",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography variant="h6" sx={{ fontWeight: 600 }}>
          Notifications
        </Typography>

        <Stack direction="row" alignItems="center" spacing={1}>
          {notifications.length > 0 && (
            <Tooltip title="Mark all as read">
              <IconButton size="small" onClick={handleMarkAllAsRead}>
                <DoneAll /* fontSize="small" */ color="primary" />
              </IconButton>
            </Tooltip>
          )}

          <IconButton
            onClick={() => setNotificationDrawerOpen(false)}
            size="small"
          >
            <Close />
          </IconButton>
        </Stack>
      </Box>

      <Divider sx={{ my: 1 }} />
      {/* Notification list */}
      {notifications.length === 0 ? (
        <Box
          sx={{
            textAlign: "center",
            mt: 4,
            color: "text.secondary",
          }}
        >
          <NotificationsNone sx={{ fontSize: 50, mb: 1, opacity: 0.6 }} />
          <Typography>No notifications yet</Typography>
        </Box>
      ) : (
        <Box
          sx={{
            flex: 1,
            overflowY: "auto",
            p: 2,
            display: "flex",
            flexDirection: "column",
            gap: 1.5,
          }}
        >
          {sortedNotifications.length === 0 ? (
            <Typography
              variant="body2"
              color="text.secondary"
              align="center"
              sx={{ mt: 4 }}
            >
              No notifications found
            </Typography>
          ) : (
            sortedNotifications.map((n) => {
              const isRead = n.isRead;
              return (
                <Paper
                  key={n.id}
                  onClick={() => markAsRead(n.id)}
                  sx={{
                    p: 2,
                    borderRadius: 2,
                    border: isRead ? "1px solid #E2E8F0" : "1px solid #5D3FD3",
                    backgroundColor: isRead
                      ? alpha("#5D3FD3", 0.06)
                      : "#FFFFFF",
                    transition: "all 0.25s ease",
                    cursor: "pointer",
                    "&:hover": {
                      backgroundColor: isRead
                        ? alpha("#5D3FD3", 0.1)
                        : alpha("#A28DF0", 0.15),
                      transform: "translateY(-2px)",
                    },
                  }}
                >
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: isRead ? 500 : 600,
                      color: isRead ? "text.primary" : "#2E2E2E",
                    }}
                  >
                    {n.message}
                  </Typography>

                  <Typography
                    variant="caption"
                    sx={{
                      color: "text.secondary",
                      display: "block",
                      mt: 0.5,
                    }}
                  >
                    {formatRelativeTime(n.createdAt)}
                  </Typography>
                </Paper>
              );
            })
          )}
        </Box>
      )}

      {/* Footer */}
      <Divider />
      <Box sx={{ p: 2 }}>
        {hasMore ? (
          <Button fullWidth variant="outlined" onClick={loadMore}>
            Show More
          </Button>
        ) : (
          <Typography
            variant="body2"
            color="text.secondary"
            align="center"
            sx={{ py: 1 }}
          >
            No more notifications
          </Typography>
        )}
      </Box>
    </Drawer>
  );
};

export default NotificationDrawer;
