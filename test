const [fromDateError, setFromDateError] = useState(null);
const [toDateError, setToDateError] = useState(null);

const MIN_ALLOWED_DATE = dayjs("2026-03-31");


const getDateErrorMessage = (field, error) => {
  switch (error) {
    case "invalidDate":
      return `Please enter a valid ${field}`;

    case "minDate":
      return `${field} cannot be earlier than ${MIN_ALLOWED_DATE.format(
        "DD-MM-YYYY"
      )}`;

    case "maxDate":
      return `${field} cannot exceed ETL Date`;

    case "fromGreaterThanTo":
      return "From Date cannot be greater than To Date";

    case "toLessThanFrom":
      return "To Date cannot be less than From Date";

    case "rangeExceeds12Months":
      return "Date range cannot exceed 12 months";

    case "afterEtlDate":
      return `To Date cannot exceed ETL Date ${etlDate?.format(
        "DD-MM-YYYY"
      )}`;

    default:
      return "";
  }
};

const validateDateRange = (fromDate, toDate) => {
  setFromDateError(null);
  setToDateError(null);

  if (
    !fromDate?.isValid?.() ||
    !toDate?.isValid?.()
  ) {
    return;
  }

  if (fromDate.isAfter(toDate, "day")) {
    setFromDateError("fromGreaterThanTo");
    setToDateError("toLessThanFrom");
    return;
  }

  if (toDate.isAfter(fromDate.add(1, "year"), "day")) {
    setToDateError("rangeExceeds12Months");
    return;
  }

  if (
    etlDate?.isValid?.() &&
    toDate.isAfter(etlDate, "day")
  ) {
    setToDateError("afterEtlDate");
  }
};

const validationMessages = [
  fromDateError &&
    getDateErrorMessage("From Date", fromDateError),

  toDateError &&
    getDateErrorMessage("To Date", toDateError),
].filter(Boolean);



<StyledFormControl sx={{ width: { xs: "100%", md: 180 } }}>
  <DatePicker
    value={start}
    format="DD-MM-YYYY"
    minDate={MIN_ALLOWED_DATE}
    maxDate={etlDate}
    disableHighlightToday
    onChange={(value) => {
      setStart(value);

      if (end) {
        validateDateRange(value, end);
      }
    }}
    onError={(error) => {
      if (error) {
        setFromDateError(error);
      }
    }}
    slotProps={{
      textField: {
        label: "From Date*",
        InputLabelProps: { shrink: true },
        placeholder: "DD-MM-YYYY",
        error: !!fromDateError,
        helperText: "",
        fullWidth: true,
      },
    }}
  />
</StyledFormControl>


<StyledFormControl sx={{ width: { xs: "100%", md: 180 } }}>
  <DatePicker
    value={start}
    format="DD-MM-YYYY"
    minDate={MIN_ALLOWED_DATE}
    maxDate={etlDate}
    disableHighlightToday
    onChange={(value) => {
      setStart(value);

      if (end) {
        validateDateRange(value, end);
      }
    }}
    onError={(error) => {
      if (error) {
        setFromDateError(error);
      }
    }}
    slotProps={{
      textField: {
        label: "From Date*",
        InputLabelProps: { shrink: true },
        placeholder: "DD-MM-YYYY",
        error: !!fromDateError,
        helperText: "",
        fullWidth: true,
      },
    }}
  />
</StyledFormControl>


<StyledFormControl sx={{ width: { xs: "100%", md: 180 } }}>
  <DatePicker
    value={end}
    format="DD-MM-YYYY"
    minDate={start || MIN_ALLOWED_DATE}
    maxDate={etlDate}
    disableHighlightToday
    disabled={!start}
    onChange={(value) => {
      setEnd(value);

      if (start) {
        validateDateRange(start, value);
      }
    }}
    onError={(error) => {
      if (error) {
        setToDateError(error);
      }
    }}
    slotProps={{
      textField: {
        label: "To Date*",
        InputLabelProps: { shrink: true },
        placeholder: "DD-MM-YYYY",
        error: !!toDateError,
        helperText: "",
        fullWidth: true,
      },
    }}
  />
</StyledFormControl>


{validationMessages.length > 0 && (
  <Box
    sx={{
      mt: 2,
      mb: 1,
      p: 1.5,
      borderRadius: 2,
      border: "1px solid #ff4d4f",
      bgcolor: "#fff1f0",
    }}
  >
    <Stack spacing={0.5}>
      {validationMessages.map((msg, index) => (
        <Typography
          key={index}
          variant="body2"
          sx={{
            color: "#d32f2f",
            fontWeight: 600,
          }}
        >
          • {msg}
        </Typography>
      ))}
    </Stack>
  </Box>
)}


disabled={
  !(
    cgl &&
    currency &&
    branch &&
    start &&
    end
  ) ||
  fromDateError ||
  toDateError
}