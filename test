export const findBreadcrumbPath = (menus, target, path = []) => {
  for (const menu of menus) {
    const newPath = [...path, menu];

    // Match by unique property (path / id / key)
    if (menu.path === target.path) {
      return newPath;
    }

    if (menu.children?.length) {
      const childPath = findBreadcrumbPath(
        menu.children,
        target,
        newPath
      );

      if (childPath) return childPath;
    }
  }

  return null;
};

import React, { useMemo } from "react";
import { Breadcrumbs, Link, Typography } from "@mui/material";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { findBreadcrumbPath } from "../utils/menuBreadcrumbUtils";

const AppBreadcrumbs = () => {
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);
  const menus = useSelector((state) => state.menus.menus);
  const { navigateToPage } = useNavigateToPage();

  const breadcrumbs = useMemo(() => {
    if (!selectedMenuItem || !menus?.length) return [];

    return findBreadcrumbPath(menus, selectedMenuItem) || [];
  }, [menus, selectedMenuItem]);

  if (!breadcrumbs.length) return null;

  return (
    <Breadcrumbs
      separator={<NavigateNextIcon fontSize="small" />}
      sx={{ mb: 1 }}
    >
      {breadcrumbs.map((item, index) => {
        const isLast = index === breadcrumbs.length - 1;

        return isLast ? (
          <Typography
            key={item.path}
            color="text.primary"
            fontWeight={600}
          >
            {item.title}
          </Typography>
        ) : (
          <Link
            key={item.path}
            underline="hover"
            color="inherit"
            sx={{ cursor: "pointer" }}
            onClick={() => navigateToPage(item)}
          >
            {item.title}
          </Link>
        );
      })}
    </Breadcrumbs>
  );
};

export default AppBreadcrumbs;