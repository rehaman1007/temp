import React from "react";
import { Navigate, useLocation } from "react-router-dom";

const ProtectedRoute = ({ children }) => {
  const authorizedScreens = JSON.parse(sessionStorage.getItem("authorizedScreens") || "[]");
  const location = useLocation();

  // Get the last segment of the path (e.g., "/user-management" -> "user-management")
  const currentScreen = location.pathname.split("/").pop();

  // Check if user has permission
  if (authorizedScreens.length > 0 && !authorizedScreens.includes(currentScreen)) {
    return <Navigate to="/access-denied" replace />;
  }

  // If authorized, render the actual screen
  return children;
};

export default ProtectedRoute;