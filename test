package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;

import java.io.BufferedReader;

import java.nio.file.Files;
import java.nio.file.Path;

import java.sql.Connection;
import java.sql.Statement;

import java.time.LocalDateTime;

import java.util.HashMap;
import java.util.Map;

import java.util.concurrent.ConcurrentHashMap;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdminSupportExecutor {

    /**
     * COMMIT AFTER EVERY N STATEMENTS
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * JOB STATUS STORE
     */
    private final Map<String, Map<String, Object>>
            jobStatusMap =
            new ConcurrentHashMap<>();

    private final DataSource dataSource;

    /**
     * ASYNC SQL EXECUTION
     */
    @Async("sqlExecutor")
    public void executeScriptAsync(
            Path path,
            String jobId
    ) {

        long startTime =
                System.currentTimeMillis();

        log.info(
                "=================================================="
        );

        log.info(
                "SQL EXECUTION STARTED"
        );

        log.info(
                "JobId={}",
                jobId
        );

        log.info(
                "File={}",
                path
        );

        log.info(
                "CommitBatchSize={}",
                COMMIT_BATCH_SIZE
        );

        log.info(
                "StartedAt={}",
                LocalDateTime.now()
        );

        log.info(
                "=================================================="
        );

        Connection connection = null;

        BufferedReader reader = null;

        int executedCount = 0;

        int totalStatements = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int selectCount = 0;

        int otherCount = 0;

        String currentSql = "";

        try {

            /**
             * PRE-SCAN FILE
             */
            log.info(
                    "Scanning SQL file for metadata..."
            );

            BufferedReader counterReader =
                    Files.newBufferedReader(path);

            String counterLine;

            StringBuilder counterSql =
                    new StringBuilder();

            while (
                    (counterLine = counterReader.readLine())
                            != null
            ) {

                String trimmed =
                        counterLine.trim();

                if (
                        trimmed.isBlank()
                                ||
                                trimmed.startsWith("--")
                                ||
                                trimmed.startsWith("//")
                ) {

                    continue;
                }

                counterSql
                        .append(counterLine)
                        .append("\n");

                if (trimmed.endsWith(";")) {

                    totalStatements++;

                    String sql =
                            counterSql
                                    .toString()
                                    .trim()
                                    .toUpperCase();

                    if (sql.startsWith("INSERT")) {

                        insertCount++;

                    } else if (sql.startsWith("UPDATE")) {

                        updateCount++;

                    } else if (sql.startsWith("DELETE")) {

                        deleteCount++;

                    } else if (sql.startsWith("SELECT")) {

                        selectCount++;

                    } else {

                        otherCount++;
                    }

                    counterSql.setLength(0);
                }
            }

            counterReader.close();

            log.info(
                    "=================================================="
            );

            log.info(
                    "SQL FILE ANALYSIS"
            );

            log.info(
                    "Total Statements={}",
                    totalStatements
            );

            log.info(
                    "INSERT Statements={}",
                    insertCount
            );

            log.info(
                    "UPDATE Statements={}",
                    updateCount
            );

            log.info(
                    "DELETE Statements={}",
                    deleteCount
            );

            log.info(
                    "SELECT Statements={}",
                    selectCount
            );

            log.info(
                    "OTHER Statements={}",
                    otherCount
            );

            log.info(
                    "=================================================="
            );

            Map<String, Object> initialStatus =
                    new HashMap<>();

            initialStatus.put(
                    "status",
                    "RUNNING"
            );

            initialStatus.put(
                    "executedCount",
                    0
            );

            initialStatus.put(
                    "totalStatements",
                    totalStatements
            );

            initialStatus.put(
                    "startTime",
                    LocalDateTime.now().toString()
            );

            jobStatusMap.put(
                    jobId,
                    initialStatus
            );

            /**
             * DB CONNECTION
             */
            connection =
                    dataSource.getConnection();

            connection.setAutoCommit(false);

            Statement statementExecutor =
                    connection.createStatement();

            reader =
                    Files.newBufferedReader(path);

            StringBuilder sqlBuilder =
                    new StringBuilder();

            String line;

            /**
             * EXECUTION START
             */
            while (
                    (line = reader.readLine())
                            != null
            ) {

                String trimmed =
                        line.trim();

                /**
                 * SKIP EMPTY
                 */
                if (
                        trimmed.isBlank()
                ) {

                    continue;
                }

                /**
                 * SKIP COMMENTS
                 */
                if (
                        trimmed.startsWith("--")
                                ||
                                trimmed.startsWith("//")
                ) {

                    continue;
                }

                sqlBuilder
                        .append(line)
                        .append("\n");

                /**
                 * SQL COMPLETE
                 */
                if (trimmed.endsWith(";")) {

                    currentSql =
                            sqlBuilder
                                    .toString()
                                    .trim();

                    /**
                     * REMOVE ;
                     */
                    currentSql =
                            currentSql.substring(
                                    0,
                                    currentSql.lastIndexOf(";")
                            );

                    validateDangerousSql(currentSql);

                    try {

                        long sqlStart =
                                System.currentTimeMillis();

                        statementExecutor.execute(
                                currentSql
                        );

                        long sqlEnd =
                                System.currentTimeMillis();

                        executedCount++;

                        /**
                         * COMMIT
                         */
                        if (
                                executedCount
                                        %
                                        COMMIT_BATCH_SIZE
                                        ==
                                        0
                        ) {

                            connection.commit();

                            log.info(
                                    "BATCH COMMIT SUCCESS"
                            );

                            log.info(
                                    "Committed Statements={}",
                                    executedCount
                            );

                            log.info(
                                    "Remaining Statements={}",
                                    totalStatements
                                            -
                                            executedCount
                            );
                        }

                        /**
                         * ESTIMATED TIME
                         */
                        long elapsed =
                                (
                                        System.currentTimeMillis()
                                                -
                                                startTime
                                )
                                        /
                                        1000;

                        long avgTime =
                                executedCount == 0
                                        ? 0
                                        : elapsed / executedCount;

                        long estimatedRemaining =
                                avgTime
                                        *
                                        (
                                                totalStatements
                                                        -
                                                        executedCount
                                        );

                        /**
                         * UPDATE STATUS
                         */
                        Map<String, Object> status =
                                new HashMap<>();

                        status.put(
                                "status",
                                "RUNNING"
                        );

                        status.put(
                                "executedCount",
                                executedCount
                        );

                        status.put(
                                "totalStatements",
                                totalStatements
                        );

                        status.put(
                                "remainingStatements",
                                totalStatements
                                        -
                                        executedCount
                        );

                        status.put(
                                "estimatedRemainingSeconds",
                                estimatedRemaining
                        );

                        jobStatusMap.put(
                                jobId,
                                status
                        );

                        /**
                         * LOG EVERY 100
                         */
                        if (
                                executedCount % 100 == 0
                        ) {

                            log.info(
                                    "=================================================="
                            );

                            log.info(
                                    "PROGRESS UPDATE"
                            );

                            log.info(
                                    "Executed={}/{}",
                                    executedCount,
                                    totalStatements
                            );

                            log.info(
                                    "Current Execution Time={} ms",
                                    (
                                            sqlEnd
                                                    -
                                                    sqlStart
                                    )
                            );

                            log.info(
                                    "Estimated Remaining={} sec",
                                    estimatedRemaining
                            );

                            log.info(
                                    "=================================================="
                            );
                        }

                    } catch (Exception sqlEx) {

                        log.error(
                                "=================================================="
                        );

                        log.error(
                                "SQL EXECUTION FAILED"
                        );

                        log.error(
                                "Failed Statement Number={}",
                                executedCount + 1
                        );

                        log.error(
                                "Executed Successfully Before Failure={}",
                                executedCount
                        );

                        log.error(
                                "FAILED SQL BELOW"
                        );

                        log.error(
                                "\n{}\n",
                                currentSql
                        );

                        log.error(
                                "ERROR MESSAGE={}",
                                sqlEx.getMessage()
                        );

                        log.error(
                                "==================================================",
                                sqlEx
                        );

                        try {

                            connection.rollback();

                            log.error(
                                    "ROLLBACK SUCCESS"
                            );

                        } catch (Exception rollbackEx) {

                            log.error(
                                    "ROLLBACK FAILED",
                                    rollbackEx
                            );
                        }

                        Map<String, Object> failedStatus =
                                new HashMap<>();

                        failedStatus.put(
                                "status",
                                "FAILED"
                        );

                        failedStatus.put(
                                "executedCount",
                                executedCount
                        );

                        failedStatus.put(
                                "failedStatementNumber",
                                executedCount + 1
                        );

                        failedStatus.put(
                                "failedSql",
                                currentSql
                        );

                        failedStatus.put(
                                "message",
                                sqlEx.getMessage()
                        );

                        jobStatusMap.put(
                                jobId,
                                failedStatus
                        );

                        return;
                    }

                    /**
                     * RESET
                     */
                    sqlBuilder.setLength(0);
                }
            }

            /**
             * FINAL COMMIT
             */
            connection.commit();

            long totalTime =
                    (
                            System.currentTimeMillis()
                                    -
                                    startTime
                    )
                            /
                            1000;

            log.info(
                    "=================================================="
            );

            log.info(
                    "SQL EXECUTION COMPLETED"
            );

            log.info(
                    "Total Executed={}",
                    executedCount
            );

            log.info(
                    "Total Time={} sec",
                    totalTime
            );

            log.info(
                    "Average Time Per Statement={} ms",
                    executedCount == 0
                            ? 0
                            :
                            (
                                    (
                                            System.currentTimeMillis()
                                                    -
                                                    startTime
                                    )
                                            /
                                            executedCount
                            )
            );

            log.info(
                    "=================================================="
            );

            Map<String, Object> completedStatus =
                    new HashMap<>();

            completedStatus.put(
                    "status",
                    "COMPLETED"
            );

            completedStatus.put(
                    "executedCount",
                    executedCount
            );

            completedStatus.put(
                    "totalStatements",
                    totalStatements
            );

            completedStatus.put(
                    "completedAt",
                    LocalDateTime.now().toString()
            );

            completedStatus.put(
                    "timeTakenSeconds",
                    totalTime
            );

            jobStatusMap.put(
                    jobId,
                    completedStatus
            );

        } catch (Exception e) {

            log.error(
                    "=================================================="
            );

            log.error(
                    "FATAL SQL EXECUTION FAILURE"
            );

            log.error(
                    "JobId={}",
                    jobId
            );

            log.error(
                    "Last SQL={}",
                    currentSql
            );

            log.error(
                    "==================================================",
                    e
            );

            try {

                if (connection != null) {

                    connection.rollback();

                    log.error(
                            "ROLLBACK SUCCESS"
                    );
                }

            } catch (Exception rollbackEx) {

                log.error(
                        "ROLLBACK FAILED",
                        rollbackEx
                );
            }

            Map<String, Object> failedStatus =
                    new HashMap<>();

            failedStatus.put(
                    "status",
                    "FAILED"
            );

            failedStatus.put(
                    "executedCount",
                    executedCount
            );

            failedStatus.put(
                    "message",
                    e.getMessage()
            );

            failedStatus.put(
                    "failedSql",
                    currentSql
            );

            jobStatusMap.put(
                    jobId,
                    failedStatus
            );

        } finally {

            try {

                if (reader != null) {

                    reader.close();
                }

                if (connection != null) {

                    connection.close();
                }

                Files.deleteIfExists(path);

                log.info(
                        "Temporary SQL file deleted={}",
                        path
                );

            } catch (Exception cleanupEx) {

                log.error(
                        "Cleanup failed",
                        cleanupEx
                );
            }
        }
    }

    /**
     * BLOCK DANGEROUS SQL
     */
    private void validateDangerousSql(
            String sql
    ) {

        String upper =
                sql.toUpperCase();

        if (
                upper.contains("DROP DATABASE")
                        ||
                        upper.contains("ALTER SYSTEM")
                        ||
                        upper.contains("SHUTDOWN")
                        ||
                        upper.contains("CREATE USER")
                        ||
                        upper.contains("DROP USER")
        ) {

            throw new RuntimeException(
                    "Dangerous SQL blocked"
            );
        }
    }

    /**
     * STATUS API
     */
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return jobStatusMap.getOrDefault(
                jobId,
                Map.of(
                        "status",
                        "NOT_FOUND"
                )
        );
    }
}