                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={"Enter atleast 3 digits..."}
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ mb: 0.5 }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches.includes("ALL")
                                            ? "All Branches"
                                            : `${filters.branches.length} Selected`
                                        }
                                        color={
                                          filters.branches.includes("ALL")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {!filters.branches.includes("ALL") &&
                                        filters.branches.length > 0 && (
                                          <IconButton
                                            size="small"
                                            onClick={() =>
                                              setViewBranchList(!viewBranchList)
                                            }
                                            color={
                                              viewBranchList
                                                ? "primary"
                                                : "default"
                                            }
                                            sx={{
                                              transition: "0.2s",
                                              bgcolor: viewBranchList
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                            }}
                                          >
                                            {viewBranchList ? (
                                              <VisibilityOffIcon fontSize="small" />
                                            ) : (
                                              <VisibilityIcon fontSize="small" />
                                            )}
                                          </IconButton>
                                        )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: isCircleVisible || isBranchVisible ? 6 : 12 }}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                      forcePopupIcon={false}
                      autoHighlight
                      value={filters.cgl}
                      options={cgls}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.cgl && filters.cgl < 3
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                      onInputChange={(e, v) => {
                        if (v.length >= 3) fetchSearchData("cgl", v);
                      }}
                      onChange={(_, v) => onFilterChange("cgl", v)}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          label="CGL"
                          required
                          InputLabelProps={{ shrink: true }}
                          placeholder={
                            "Enter atleast 3 characters (eg. 9999999999)"
                          }
                          variant="standard"
                          inputProps={{ ...params.inputProps, maxLength: 30 }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>
                  <Grid size={{ xs: 12, sm: 5 }}>
                    <Autocomplete
                      size="small"
                      options={["All Currencies", ...currencies]}
                      value={filters.currencies}
                      onChange={(_, v) =>
                        onFilterChange("currencies", v || "ALL")
                      }
                      renderInput={(p) => (
                        <TextField
                          {...p}
                          label="Currency"
                          required
                          variant="standard"
                          inputProps={{ ...p.inputProps, maxLength: 30 }}
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* BRANCH TRAY */}
            {viewBranchList && hasSelectedBranches && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewBranchList && hasSelectedBranches}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED BRANCHES
                        </Typography>
                        <CustomChip
                          label={filters.branches.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
