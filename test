private static final int FETCH_SIZE = 20000;

private static final int EXCEL_WINDOW_SIZE = 1000;

private static final long MAX_EXPORT_LIMIT = 1_000_000;


private long validateExportLimit(String sql) {

    String countSql =
            "SELECT COUNT(*) FROM (" + sql + ")";

    Long count =
            jdbcTemplate.queryForObject(
                    countSql,
                    Long.class
            );

    if (count == null) {
        count = 0L;
    }

    if (count > MAX_EXPORT_LIMIT) {

        throw new RuntimeException(
                "Export limit exceeded. Maximum "
                        + MAX_EXPORT_LIMIT
                        + " rows allowed."
        );
    }

    return count;
}


private ResponseEntity<Resource> exportExcel(
        String sql
) {

    try (

            SXSSFWorkbook workbook =
                    new SXSSFWorkbook(
                            EXCEL_WINDOW_SIZE
                    );

            ByteArrayOutputStream out =
                    new ByteArrayOutputStream()

    ) {

        workbook.setCompressTempFiles(true);

        Sheet sheet =
                workbook.createSheet("Export");

        AtomicInteger rowNum =
                new AtomicInteger(0);

        jdbcTemplate.query(

                connection -> {

                    var ps =
                            connection.prepareStatement(
                                    sql
                            );

                    ps.setFetchSize(
                            FETCH_SIZE
                    );

                    return ps;
                },

                rs -> {

                    ResultSetMetaData meta =
                            rs.getMetaData();

                    int cols =
                            meta.getColumnCount();

                    if (rowNum.get() == 0) {

                        Row header =
                                sheet.createRow(0);

                        for (
                                int i = 1;
                                i <= cols;
                                i++
                        ) {

                            header.createCell(
                                    i - 1
                            ).setCellValue(
                                    meta.getColumnLabel(i)
                            );
                        }

                        rowNum.incrementAndGet();
                    }

                    Row row =
                            sheet.createRow(
                                    rowNum.getAndIncrement()
                            );

                    for (
                            int i = 1;
                            i <= cols;
                            i++
                    ) {

                        Object value =
                                rs.getObject(i);

                        row.createCell(i - 1)
                                .setCellValue(
                                        value == null
                                                ? ""
                                                : value.toString()
                                );
                    }

                    if (
                            rowNum.get() % 5000
                                    == 0
                    ) {

                        ((SXSSFSheet) sheet)
                                .flushRows(500);
                    }
                }
        );

        workbook.write(out);

        workbook.dispose();

        return downloadFile(
                out.toByteArray(),
                "export.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        );

    } catch (Exception e) {

        throw new RuntimeException(
                "Excel export failed",
                e
        );
    }
}

private ResponseEntity<Resource> exportCsv(
        String sql
) {

    try {

        StringBuilder csv =
                new StringBuilder(
                        1024 * 1024
                );

        AtomicBoolean headerDone =
                new AtomicBoolean(
                        false
                );

        jdbcTemplate.query(

                connection -> {

                    var ps =
                            connection.prepareStatement(
                                    sql
                            );

                    ps.setFetchSize(
                            FETCH_SIZE
                    );

                    return ps;
                },

                rs -> {

                    ResultSetMetaData meta =
                            rs.getMetaData();

                    int cols =
                            meta.getColumnCount();

                    if (
                            !headerDone.get()
                    ) {

                        for (
                                int i = 1;
                                i <= cols;
                                i++
                        ) {

                            if (i > 1) {
                                csv.append(",");
                            }

                            csv.append(
                                    meta.getColumnLabel(i)
                            );
                        }

                        csv.append("\n");

                        headerDone.set(
                                true
                        );
                    }

                    for (
                            int i = 1;
                            i <= cols;
                            i++
                    ) {

                        if (i > 1) {
                            csv.append(",");
                        }

                        csv.append(
                                csvEscape(
                                        rs.getObject(i)
                                )
                        );
                    }

                    csv.append("\n");
                }
        );

        return downloadFile(
                csv.toString()
                        .getBytes(
                                StandardCharsets.UTF_8
                        ),
                "export.csv",
                "text/csv"
        );

    } catch (Exception e) {

        throw new RuntimeException(
                "CSV export failed",
                e
        );
    }
}

private String csvEscape(
        Object value
) {

    if (value == null) {
        return "";
    }

    String text =
            value.toString();

    if (
            text.contains(",")
                    || text.contains("\"")
                    || text.contains("\n")
    ) {

        text =
                text.replace(
                        "\"",
                        "\"\""
                );

        return "\"" +
                text +
                "\"";
    }

    return text;
}


