const handleNameChange = (name, value, mandatory) => {
  // Allow empty for optional fields
  if (!value && !mandatory) {
    clearFieldError(name);
    setForm((p) => ({ ...p, [name]: "" }));
    return;
  }

  if (!NAME_REGEX.test(value)) {
    snackbar("Only alphabet, space and dot allowed", "error");
    return; // 🚫 STOP
  }

  if (mandatory && value.length < 3) {
    setFieldError(name, "Minimum 3 characters required");
    return; // 🚫 STOP
  }

  if (!mandatory && value.length < 1) {
    setFieldError(name, "Minimum 1 character required");
    return; // 🚫 STOP
  }

  if (value.length > 30) {
    setFieldError(name, "Maximum 30 characters allowed");
    return; // 🚫 STOP
  }

  clearFieldError(name);
  setForm((p) => ({ ...p, [name]: value })); // ✅ ONLY valid data
};

const handleMobileChange = (value) => {
  // Allow clearing
  if (!value) {
    clearFieldError("PHONE_NUMBER");
    setForm((p) => ({ ...p, PHONE_NUMBER: "" }));
    return;
  }

  if (!DIGITS_REGEX.test(value)) {
    snackbar("Only digits are allowed", "error");
    return; // 🚫 STOP
  }

  if (value.length !== 10) {
    setFieldError("PHONE_NUMBER", "Mobile Number must be exactly 10 digits");
    return; // 🚫 STOP
  }

  clearFieldError("PHONE_NUMBER");
  setForm((p) => ({ ...p, PHONE_NUMBER: value })); // ✅ valid only
};