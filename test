import React, {
  createContext,
  useState,
  useEffect,
  useRef,
  useCallback,
} from "react";
import SessionDialog from "../components/SessionDialog";
import SessionWarningDialog from "../components/SessionWarningDialog";
import axios from "axios";

export const AuthContext = createContext();

const INACTIVITY_TIMEOUT = 5 * 60 * 1000;
const WARNING_TIME = 30 * 1000;
const KEEP_ALIVE_INTERVAL = 2 * 60 * 1000;

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [warningOpen, setWarningOpen] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(30);
  const [sessionError, setSessionError] = useState("");

  const inactivityTimerRef = useRef(null);
  const warningTimerRef = useRef(null);
  const countdownRef = useRef(null);
  const sessionInvalidatedRef = useRef(false);

  /** -------------------- Load User -------------------- */
  useEffect(() => {
    const savedUser = localStorage.getItem("user");
    if (savedUser) setUser(JSON.parse(savedUser));
  }, []);

  /** -------------------- Logout -------------------- */
  const logout = useCallback(() => {
    localStorage.clear();
    setUser(null);
    setDialogOpen(false);
    setWarningOpen(false);
    sessionInvalidatedRef.current = false;
    window.location.href = "/";
  }, []);

  /** -------------------- Trigger Session Dialog -------------------- */
  const triggerSessionDialog = useCallback((reason) => {
    if (sessionInvalidatedRef.current) return;
    sessionInvalidatedRef.current = true;
    setSessionError(reason);
    setDialogOpen(true);
  }, []);

  /** -------------------- Reset Inactivity Timers -------------------- */
  const resetInactivityTimer = useCallback(() => {
    if (!user) return;

    clearTimeout(inactivityTimerRef.current);
    clearTimeout(warningTimerRef.current);
    clearInterval(countdownRef.current);

    setWarningOpen(false);
    setSecondsLeft(30);

    // Warning timer
    warningTimerRef.current = setTimeout(() => {
      setWarningOpen(true);

      let counter = 30;
      setSecondsLeft(counter);

      countdownRef.current = setInterval(() => {
        counter -= 1;
        setSecondsLeft(counter);
      }, 1000);
    }, INACTIVITY_TIMEOUT - WARNING_TIME);

    // Final logout timer
    inactivityTimerRef.current = setTimeout(() => {
      triggerSessionDialog("SESSION_EXPIRED");
    }, INACTIVITY_TIMEOUT);
  }, [user, triggerSessionDialog]);

  /** -------------------- Activity Listener -------------------- */
  useEffect(() => {
    if (!user) return;

    const events = ["mousemove", "keydown", "click", "scroll"];
    const handleActivity = () => {
      resetInactivityTimer();
      localStorage.setItem("LAST_ACTIVITY", Date.now());
    };

    events.forEach((e) => window.addEventListener(e, handleActivity));
    resetInactivityTimer();

    return () => {
      events.forEach((e) => window.removeEventListener(e, handleActivity));
      clearTimeout(inactivityTimerRef.current);
      clearTimeout(warningTimerRef.current);
      clearInterval(countdownRef.current);
    };
  }, [user, resetInactivityTimer]);

  /** -------------------- Multi-Tab Sync -------------------- */
  useEffect(() => {
    const handleStorage = (e) => {
      if (e.key === "LAST_ACTIVITY") {
        resetInactivityTimer();
      }
      if (e.key === "LOGOUT_EVENT") {
        logout();
      }
    };

    window.addEventListener("storage", handleStorage);
    return () => window.removeEventListener("storage", handleStorage);
  }, [logout, resetInactivityTimer]);

  /** -------------------- Background Keep-Alive Ping -------------------- */
  useEffect(() => {
    if (!user) return;

    const interval = setInterval(() => {
      axios.get("/auth/keep-alive", { withCredentials: true }).catch(() => {});
    }, KEEP_ALIVE_INTERVAL);

    return () => clearInterval(interval);
  }, [user]);

  /** -------------------- Login -------------------- */
  const login = (userData, tokens) => {
    localStorage.setItem("accessToken", tokens.accessToken);
    localStorage.setItem("refreshToken", tokens.refreshToken);
    localStorage.setItem("user", JSON.stringify(userData));
    localStorage.setItem("LAST_ACTIVITY", Date.now());
    setUser(userData);
    sessionInvalidatedRef.current = false;
  };

  return (
    <AuthContext.Provider value={{ user, login, logout, triggerSessionDialog }}>
      {children}

      <SessionWarningDialog
        open={warningOpen}
        secondsLeft={secondsLeft}
        onContinue={resetInactivityTimer}
      />

      <SessionDialog
        open={dialogOpen}
        reason={sessionError}
        onConfirm={logout}
      />
    </AuthContext.Provider>
  );
};

import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
} from "@mui/material";

const SessionWarningDialog = ({ open, secondsLeft, onContinue }) => {
  return (
    <Dialog open={open} disableEscapeKeyDown>
      <DialogTitle color="warning.main">
        Session Expiring Soon
      </DialogTitle>

      <DialogContent>
        <Typography>
          You will be logged out due to inactivity in{" "}
          <strong>{secondsLeft}</strong> seconds.
        </Typography>
      </DialogContent>

      <DialogActions>
        <Button onClick={onContinue} variant="contained">
          Continue Session
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default SessionWarningDialog;

const INACTIVITY_TIMEOUT = 5 * 60 * 1000; // 5 min
const WARNING_TIME = 30 * 1000;           // 30 sec before logout
const KEEP_ALIVE_INTERVAL = 2 * 60 * 1000; // 2 min ping