  return (
    <motion.div
      whileHover={{ y: -6, transition: { duration: 0.2 } }}
      whileTap={{ scale: 0.98 }}
      style={{ height: "100%" }}
    >
      <Paper
        onClick={onClick}
        elevation={0}
        tabIndex={0}
        onKeyDown={(e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            onClick();
          }
        }}
        sx={{
          p: 2.5,
          borderRadius: 2.5,
          height: "100%",
          display: "flex",
          flexDirection: "column",
          cursor: "pointer",
          position: "relative",
          overflow: "hidden",
          transition: "all 0.25s cubic-bezier(0.4, 0, 0.2, 1)",
          bgcolor: "background.paper",
          "&:hover": {
            boxShadow: "0 12px 32px rgba(0,0,0,0.08)",
            "& .card-icon-bg": {
              bgcolor: "primary.light",
              color: "primary.contrastText",
            },
            "& .action-arrow": {
              transform: "translateX(4px)",
              opacity: 1,
            },
          },
        }}
      >
        <Box sx={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", mb: 2 }}>
          <Box
            className="card-icon-bg"
            sx={{
              p: 1.25,
              borderRadius: 2,
              bgcolor: "grey.100",
              color: "text.secondary",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              transition: "all 0.25s ease",
            }}
          >
            <DescriptionRounded fontSize="medium" />
          </Box>
          <Tooltip title="Download Report" arrow>
            <IconButton
              size="small"
              color="primary"
              onClick={(e) => {
                e.stopPropagation();
                onClick();
              }}
              sx={{ bgcolor: "primary.50", color: "primary.main", "&:hover": { bgcolor: "primary.100" } }}
            >
              <DownloadRoundedIcon fontSize="small" />
            </IconButton>
          </Tooltip>
        </Box>

        <Box sx={{ flexGrow: 1, mb: 2 }}>
          <Typography variant="h6" fontWeight="700" color="text.primary" gutterBottom sx={{ fontSize: { xs: "1rem", sm: "1.125rem" }, lineHeight: 1.3, mb: 1 }}>
            {report.reportName}
          </Typography>
          <Typography
            variant="body2"
            color="text.secondary"
