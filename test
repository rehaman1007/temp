                  autoComplete="off"
                  spellCheck={false}
                  sx={{
                    flexShrink: 0,
                    "& .MuiInputBase-root": {
                      fontFamily: '"Fira Code", "Roboto Mono", monospace',
                      fontSize: { xs: "0.9rem", lg: "clamp(0.85rem, 1.3vh, 1rem)" },
                    },
                  }}
                />

                {/* ACTIONS */}
                <Box
                  sx={{
                    display: "flex",
                    gap: 2,
                    flexWrap: "wrap",
                    flexShrink: 0,
                  }}
                >
                  <Button
                    variant="outlined"
                    color="inherit"
                    onClick={handleClearPayload}
                    startIcon={<DeleteOutlineIcon />}
                    sx={{
                      flex: { xs: "1 1 100%", sm: 1 },
                      color: "#5D596D",
                      borderColor: "rgba(74,71,163,0.25)",
                      "&:hover": {
                        borderColor: "rgba(74,71,163,0.45)",
                        background: "rgba(74,71,163,0.06)",
                      },
                    }}
                  >
                    Clear
                  </Button>
                  <Button
                    variant="contained"
                    onClick={handleProcess}
                    endIcon={<ArrowForwardIcon />}
                    sx={{
                      flex: { xs: "1 1 100%", sm: 2 },
                      background: "linear-gradient(90deg, #4A47A3, #5D56B8)",
                      "&:hover": {
                        background: "linear-gradient(90deg, #39347F, #4F49A5)",
                      },
                    }}
                  >
                    {mode === "decrypt" ? "Decrypt Payload" : "Encrypt Payload"}
                  </Button>
                </Box>

                {/* OUTPUT TERMINAL */}
                <Box
                  sx={{
                    flex: 1, // On desktop, this flexes to take up remaining height perfectly
                    display: "flex",
                    flexDirection: "column",
                    borderRadius: 2,
                    overflow: "hidden",
                    background: "rgba(40,36,67,0.97)",
                    border: "1px solid rgba(74,71,163,0.20)",
                    boxShadow: "0 8px 22px rgba(45,36,86,0.12)",
                    // On mobile this has a min-height. On desktop, minHeight is 0 so it dynamically bounds itself to remaining space.
                    minHeight: { xs: 220, sm: 280, lg: 0 }, 
                  }}
                >
                  <Box
                    sx={{
                      height: "clamp(35px, 4.5vh, 42px)",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "space-between",
                      px: 2,
                      background: "rgba(25,22,43,0.5)",
                      borderBottom: "1px solid rgba(255,255,255,0.08)",
                    }}
                  >
                    <Box sx={{ display: "flex", alignItems: "center" }}>
                      <Box sx={{ display: "flex", gap: 0.8, mr: 2 }}>
                        <Box sx={{ width: 10, height: 10, borderRadius: "50%", background: "#E58A8A" }} />
                        <Box sx={{ width: 10, height: 10, borderRadius: "50%", background: "#D9B96E" }} />
                        <Box sx={{ width: 10, height: 10, borderRadius: "50%", background: "#7CBF83" }} />
                      </Box>
                      <TerminalIcon sx={{ fontSize: "clamp(14px, 1.8vh, 18px)", color: "#C9C3E6", mr: 1 }} />
                      <Typography
                        sx={{
                          color: "#D6D1EB",
                          fontSize: "clamp(0.7rem, 1vh, 0.8rem)",
                          fontWeight: 700,
                          letterSpacing: "0.5px",
                        }}
                      >
                        OUTPUT RESULT
                      </Typography>
                    </Box>
                    <Tooltip title="Copy result" arrow>
                      <span>
                        <IconButton
                          disabled={!outputData}
                          onClick={() => handleCopy(outputData, "Result copied to clipboard!")}
                          sx={{
                            color: "#C8C2DF",
                            "&:hover": { color: "#FFFFFF" },
                            "&.Mui-disabled": { color: "#5A566B" },
                          }}
                        >
                          <ContentCopyIcon sx={{ fontSize: "clamp(14px, 2vh, 18px)" }} />
                        </IconButton>
                      </span>
                    </Tooltip>
                  </Box>
                  <Box
                    sx={{
                      flex: 1,
                      overflowY: "auto", // SCROLLBAR ONLY APPEARS INSIDE TERMINAL ON DESKTOP
                      overflowX: "auto",
                      p: 2,
                      "&::-webkit-scrollbar": { width: 8, height: 8 },
                      "&::-webkit-scrollbar-track": { background: "rgba(255,255,255,0.03)" },
                      "&::-webkit-scrollbar-thumb": { background: "rgba(196,188,231,0.35)", borderRadius: 10 },
                      "&::-webkit-scrollbar-thumb:hover": { background: "rgba(196,188,231,0.55)" },
                    }}
                  >
                    {outputData ? (
                      <pre
                        style={{
                          margin: 0,
                          color: "#BDE5C5",
                          fontFamily: '"Fira Code", "Roboto Mono", monospace',
                          fontSize: "0.9rem",
                          lineHeight: 1.6,
                          whiteSpace: "pre-wrap",
                          wordBreak: "break-all",
                        }}
                      >
                        {outputData}
                      </pre>
                    ) : (
                      <Box
                        sx={{
                          height: "100%",
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "center",
                          flexDirection: "column",
                          gap: 1.5,
                          opacity: 0.6,
                        }}
                      >
                        <TerminalIcon sx={{ fontSize: "clamp(24px, 4vh, 40px)", color: "rgba(205,198,235,0.4)" }} />
                        <Typography sx={{ color: "rgba(215,209,235,0.7)", fontSize: "0.9rem", fontStyle: "italic" }}>
                          Output will appear here
                        </Typography>
                      </Box>
                    )}
                  </Box>
                </Box>
              </Box>
            </Paper>
          </Box>
        </Box>

        {/* ====================================================
            FOOTER
        ===================================================== */}
        <Box
          sx={{
            py: { xs: 3, lg: "clamp(12px, 1.5vh, 24px)" },
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            flexShrink: 0,
            mt: "auto",
          }}
        >
          <Typography
            sx={{
              color: "rgba(72,68,105,0.65)",
              fontSize: "clamp(0.7rem, 1vh, 0.85rem)",
              fontWeight: 500,
            }}
          >
            FinCore Application Utility
          </Typography>
        </Box>
      </Box>

      {/* ========================================================
          SNACKBAR
      ========================================================= */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: "bottom", horizontal: "center" }}
      >
        <Alert
          onClose={handleCloseSnackbar}
          severity={snackbar.severity}
          variant="filled"
          sx={{ width: "100%", borderRadius: 2, boxShadow: "0 8px 25px rgba(40,35,80,0.20)" }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}
