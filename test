import React, { useMemo } from "react";
import {
  Box,
  Typography,
  Stack,
  Chip,
  useTheme,
  Divider,
} from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
} from "recharts";

// Gradient colors (consistent theme)
const COLORS = ["#6a5acd", "#d87093", "#6495ed", "#20b2aa"];

const RequestAnalytics = ({ data = [] }) => {
  const theme = useTheme();

  // ----- Compute Pie Chart Data -----
  const pieData = useMemo(() => {
    const counts = { total: 0, add: 0, modify: 0, delete: 0 };
    data.forEach((item) => {
      counts.total++;
      if (item.changeType === "ADD") counts.add++;
      if (item.changeType === "UPDATE") counts.modify++;
      if (item.changeType === "DELETE") counts.delete++;
    });

    return [
      { name: "Total Pending", value: counts.total },
      { name: "Add Requests", value: counts.add },
      { name: "Modify Requests", value: counts.modify },
      { name: "Delete Requests", value: counts.delete },
    ];
  }, [data]);

  // ----- Compute Histogram Data -----
  const histogramData = useMemo(() => {
    const map = {};
    data.forEach((item) => {
      if (item.reqDate) {
        const date = new Date(item.reqDate).toLocaleDateString("en-GB");
        map[date] = (map[date] || 0) + 1;
      }
    });
    return Object.keys(map)
      .sort(
        (a, b) =>
          new Date(a.split("/").reverse().join("-")) -
          new Date(b.split("/").reverse().join("-"))
      )
      .map((date) => ({ date, count: map[date] }));
  }, [data]);

  return (
    <Box
      sx={{
        width: "100%",
        bgcolor: "transparent",
        color: theme.palette.text.primary,
        p: 2,
        borderRadius: 2,
      }}
    >
      <Typography
        variant="h6"
        sx={{
          mb: 0.5,
          fontWeight: 600,
          color: theme.palette.text.primary,
        }}
      >
        Request Analytics Overview
      </Typography>
      <Typography
        variant="body2"
        sx={{ color: theme.palette.text.secondary, mb: 3 }}
      >
        Visual overview of request distribution and frequency
      </Typography>

      {/* --- CHARTS CONTAINER --- */}
      <Stack
        direction={{ xs: "column", md: "row" }}
        spacing={3}
        justifyContent="space-between"
        alignItems="stretch"
        sx={{
          width: "100%",
          mb: 4,
        }}
      >
        {/* Pie Chart Section */}
        <Box
          sx={{
            flex: 1,
            bgcolor: "rgba(255,255,255,0.05)",
            borderRadius: 3,
            p: 2,
            backdropFilter: "blur(6px)",
          }}
        >
          <Typography variant="subtitle1" sx={{ mb: 1.5 }}>
            Request Breakdown
          </Typography>
          <Box sx={{ width: "100%", height: 250 }}>
            <ResponsiveContainer>
              <PieChart>
                <defs>
                  {COLORS.map((color, index) => (
                    <linearGradient
                      key={index}
                      id={`gradient-${index}`}
                      x1="0"
                      y1="0"
                      x2="1"
                      y2="1"
                    >
                      <stop offset="0%" stopColor={color} stopOpacity={0.9} />
                      <stop offset="100%" stopColor={color} stopOpacity={0.4} />
                    </linearGradient>
                  ))}
                </defs>
                <Pie
                  data={pieData}
                  cx="50%"
                  cy="50%"
                  innerRadius={60}
                  outerRadius={90}
                  paddingAngle={5}
                  dataKey="value"
                >
                  {pieData.map((entry, index) => (
                    <Cell
                      key={`cell-${index}`}
                      fill={`url(#gradient-${index})`}
                      stroke="none"
                    />
                  ))}
                </Pie>
                <Tooltip
                  contentStyle={{
                    backgroundColor: "#2a2a3a",
                    borderRadius: 10,
                    border: "none",
                    color: "#fff",
                  }}
                />
              </PieChart>
            </ResponsiveContainer>
          </Box>

          {/* Legend */}
          <Box sx={{ mt: 2 }}>
            {pieData.map((item, i) => (
              <Stack
                key={item.name}
                direction="row"
                justifyContent="space-between"
                alignItems="center"
                sx={{
                  p: 1,
                  borderRadius: 2,
                  mb: 1,
                  bgcolor: "rgba(255,255,255,0.04)",
                }}
              >
                <Stack direction="row" spacing={1.5} alignItems="center">
                  <Box
                    sx={{
                      width: 14,
                      height: 14,
                      borderRadius: "50%",
                      bgcolor: COLORS[i],
                    }}
                  />
                  <Typography variant="body2">{item.name}</Typography>
                </Stack>
                <Chip
                  label={item.value}
                  size="small"
                  sx={{
                    bgcolor: COLORS[i],
                    color: "white",
                    fontWeight: "bold",
                  }}
                />
              </Stack>
            ))}
          </Box>
        </Box>

        {/* Histogram Section */}
        <Box
          sx={{
            flex: 1,
            bgcolor: "rgba(255,255,255,0.05)",
            borderRadius: 3,
            p: 2,
            backdropFilter: "blur(6px)",
          }}
        >
          <Typography variant="subtitle1" sx={{ mb: 1.5 }}>
            Request Frequency by Date
          </Typography>
          <Box sx={{ width: "100%", height: 300 }}>
            <ResponsiveContainer>
              <BarChart data={histogramData}>
                <CartesianGrid
                  strokeDasharray="3 3"
                  stroke="rgba(255,255,255,0.1)"
                />
                <XAxis dataKey="date" stroke="#ccc" />
                <YAxis stroke="#ccc" />
                <Tooltip
                  contentStyle={{
                    backgroundColor: "#2a2a3a",
                    borderRadius: 10,
                    border: "none",
                    color: "#fff",
                  }}
                />
                <Bar
                  dataKey="count"
                  fill="url(#gradient-0)"
                  radius={[6, 6, 0, 0]}
                />
              </BarChart>
            </ResponsiveContainer>
          </Box>
        </Box>
      </Stack>

      <Divider sx={{ borderColor: "rgba(255,255,255,0.1)", mb: 2 }} />

      {/* --- DATAGRID PLACEHOLDER --- */}
      <Box sx={{ width: "100%", mt: 2 }}>
        {/* Replace this with your actual DataGrid component */}
        <Typography
          variant="subtitle1"
          sx={{
            textAlign: "center",
            color: theme.palette.text.secondary,
            py: 4,
            border: "1px dashed rgba(255,255,255,0.2)",
            borderRadius: 2,
          }}
        >
          ⬇️ DataGrid Appears Here ⬇️
        </Typography>
      </Box>
    </Box>
  );
};

export default RequestAnalytics;