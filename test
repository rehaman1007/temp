package com.fincore.enquiry_service.service;

import com.fincore.enquiry_service.dto.LedgerEnquiryRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFSheet;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.springframework.jdbc.core.ResultSetExtractor;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.math.BigDecimal;
import java.sql.ResultSet;
import java.sql.Timestamp;
import java.text.SimpleDateFormat;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;

@Slf4j
@Service
@RequiredArgsConstructor
public class LedgerExportService {

    /*
     * =========================================================
     * PERFORMANCE CONFIG
     * =========================================================
     */

    /*
     * Keep 20K rows in memory
     * Change only here in future if needed
     */
    private static final int SXSSF_WINDOW_SIZE = 20_000;

    /*
     * Flush every 20K rows
     */
    private static final int FLUSH_BATCH_SIZE = 20_000;

    /*
     * Hard limit
     */
    private static final int MAX_EXPORT_RECORDS = 1_000_000;

    private final NamedParameterJdbcTemplate jdbcTemplate;

    public byte[] export(
            LedgerEnquiryRequest dto
    ) {

        /*
         * =========================================================
         * COUNT VALIDATION
         * =========================================================
         */

        String countSql = """
                SELECT COUNT(*)
                FROM GL_TRANSACTIONS g
                JOIN BRANCH_MASTER b
                    ON g.BRANCH_CODE = b.CODE
                LEFT JOIN CIRCLE_MASTER cr
                    ON b.CIRCLE_CODE = cr.CIRCLE_CODE
                WHERE g.CGL = :cgl
                  AND (
                        :skipSource = 1
                        OR g.SOURCE_FLAG IN (:source)
                  )
                  AND (
                        :currency IS NULL
                        OR g.CURRENCY = :currency
                  )
                  AND g.TRANSACTION_DATE BETWEEN
                        TO_DATE(:fromDate, 'dd/MM/yyyy')
                        AND TO_DATE(:toDate, 'dd/MM/yyyy')
                  AND (
                        :skipBranches = 1
                        OR g.BRANCH_CODE IN (:branches)
                  )
                  AND (
                        :circle IS NULL
                        OR b.CIRCLE_CODE = :circle
                  )
                """;

        MapSqlParameterSource params =
                buildParams(dto);

        Integer totalCount =
                jdbcTemplate.queryForObject(
                        countSql,
                        params,
                        Integer.class
                );

        if (
                totalCount != null &&
                totalCount > MAX_EXPORT_RECORDS
        ) {

            throw new RuntimeException(
                    "Excel cannot be exported because record count exceeds "
                            + MAX_EXPORT_RECORDS
            );
        }

        log.info(
                "Starting ledger export for {} rows",
                totalCount
        );

        /*
         * =========================================================
         * MAIN QUERY
         * =========================================================
         */

        String sql = """
                SELECT
                    g.TRANSACTION_ID,
                    g.BATCH_ID,
                    g.JOURNAL_ID,
                    g.TRANSACTION_DATE,
                    g.POST_DATE,
                    g.BRANCH_CODE,
                    b.NAME AS BRANCH_NAME,
                    b.CIRCLE_CODE,
                    cr.CIRCLE_NAME,
                    g.CURRENCY,
                    cu.CURRENCY_NAME,
                    g.CGL,
                    c.DESCRIPTION,
                    g.NARRATION,
                    g.DEBIT_AMOUNT,
                    g.CREDIT_AMOUNT,
                    NVL(g.TRANSACTION_COUNT,0) AS TRANSACTION_COUNT,
                    sf.FLAG_NAME AS SOURCE_NAME
                FROM GL_TRANSACTIONS g
                JOIN BRANCH_MASTER b
                    ON g.BRANCH_CODE = b.CODE
                LEFT JOIN CIRCLE_MASTER cr
                    ON b.CIRCLE_CODE = cr.CIRCLE_CODE
                LEFT JOIN CGL_MASTER c
                    ON c.CGL_NUMBER = g.CGL
                LEFT JOIN CURRENCY_MASTER cu
                    ON g.CURRENCY = cu.CURRENCY_CODE
                LEFT JOIN SOURCE_FLAG_MASTER sf
                    ON sf.FLAG_CODE = g.SOURCE_FLAG
                WHERE g.CGL = :cgl
                  AND (
                        :skipSource = 1
                        OR g.SOURCE_FLAG IN (:source)
                  )
                  AND (
                        :currency IS NULL
                        OR g.CURRENCY = :currency
                  )
                  AND g.TRANSACTION_DATE BETWEEN
                        TO_DATE(:fromDate, 'dd/MM/yyyy')
                        AND TO_DATE(:toDate, 'dd/MM/yyyy')
                  AND (
                        :skipBranches = 1
                        OR g.BRANCH_CODE IN (:branches)
                  )
                  AND (
                        :circle IS NULL
                        OR b.CIRCLE_CODE = :circle
                  )
                ORDER BY
                    g.TRANSACTION_DATE,
                    b.CIRCLE_CODE,
                    g.BRANCH_CODE
                """;

        return jdbcTemplate.query(
                sql,
                params,
                exportExtractor(dto)
        );
    }

    private ResultSetExtractor<byte[]> exportExtractor(
            LedgerEnquiryRequest dto
    ) {

        return rs -> {

            SXSSFWorkbook workbook =
                    new SXSSFWorkbook(
                            SXSSF_WINDOW_SIZE
                    );

            workbook.setCompressTempFiles(true);

            SXSSFSheet sheet =
                    workbook.createSheet(
                            "TransactionsData"
                    );

            createHeaders(
                    workbook,
                    sheet
            );

            CellStyle dateStyle =
                    createDateStyle(workbook);

            AtomicInteger rowNum =
                    new AtomicInteger(1);

            while (rs.next()) {

                Row row =
                        sheet.createRow(
                                rowNum.getAndIncrement()
                        );

                int col = 0;

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("TRANSACTION_ID")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("BATCH_ID")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("JOURNAL_ID")
                        );

                Cell transactionDateCell =
                        row.createCell(col++);

                Timestamp transactionDate =
                        rs.getTimestamp("TRANSACTION_DATE");

                if (transactionDate != null) {

                    transactionDateCell.setCellValue(
                            transactionDate
                    );

                    transactionDateCell.setCellStyle(
                            dateStyle
                    );
                }

                Cell postDateCell =
                        row.createCell(col++);

                Timestamp postDate =
                        rs.getTimestamp("POST_DATE");

                if (postDate != null) {

                    postDateCell.setCellValue(
                            postDate
                    );

                    postDateCell.setCellStyle(
                            dateStyle
                    );
                }

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("BRANCH_CODE")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("BRANCH_NAME")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("CIRCLE_CODE")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("CIRCLE_NAME")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("CURRENCY")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("CURRENCY_NAME")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("CGL")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("DESCRIPTION")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("NARRATION")
                        );

                BigDecimal debit =
                        rs.getBigDecimal("DEBIT_AMOUNT");

                row.createCell(col++)
                        .setCellValue(
                                debit != null
                                        ? debit.doubleValue()
                                        : 0
                        );

                BigDecimal credit =
                        rs.getBigDecimal("CREDIT_AMOUNT");

                row.createCell(col++)
                        .setCellValue(
                                credit != null
                                        ? credit.doubleValue()
                                        : 0
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getLong("TRANSACTION_COUNT")
                        );

                row.createCell(col++)
                        .setCellValue(
                                rs.getString("SOURCE_NAME")
                        );

                /*
                 * =================================================
                 * FLUSH MEMORY
                 * =================================================
                 */

                if (
                        rowNum.get() % FLUSH_BATCH_SIZE == 0
                ) {

                    flushSheet(
                            sheet,
                            SXSSF_WINDOW_SIZE
                    );

                    log.info(
                            "Processed rows : {}",
                            rowNum.get()
                    );
                }
            }

            /*
             * =====================================================
             * AUTO SIZE
             * =====================================================
             */

            for (int i = 0; i < 17; i++) {

                sheet.trackAllColumnsForAutoSizing();
                sheet.autoSizeColumn(i);
            }

            /*
             * =====================================================
             * WRITE
             * =====================================================
             */

            ByteArrayOutputStream out =
                    new ByteArrayOutputStream();

            workbook.write(out);

            workbook.dispose();
            workbook.close();

            log.info(
                    "Ledger export completed successfully"
            );

            return out.toByteArray();
        };
    }

    private void createHeaders(
            Workbook workbook,
            Sheet sheet
    ) {

        CellStyle headerStyle =
                workbook.createCellStyle();

        Font font =
                workbook.createFont();

        font.setBold(true);

        headerStyle.setFont(font);

        headerStyle.setAlignment(
                HorizontalAlignment.CENTER
        );

        Row headerRow =
                sheet.createRow(0);

        String[] headers = {
                "TRANSACTION ID",
                "BATCH ID",
                "JOURNAL ID",
                "TRANSACTION DATE",
                "POST DATE",
                "BRANCH CODE",
                "BRANCH NAME",
                "CIRCLE CODE",
                "CIRCLE NAME",
                "CURRENCY",
                "CURRENCY NAME",
                "CGL",
                "DESCRIPTION",
                "NARRATION",
                "DEBIT AMOUNT",
                "CREDIT AMOUNT",
                "TRANSACTION COUNT",
                "SOURCE NAME"
        };

        for (int i = 0; i < headers.length; i++) {

            Cell cell =
                    headerRow.createCell(i);

            cell.setCellValue(headers[i]);

            cell.setCellStyle(headerStyle);
        }
    }

    private CellStyle createDateStyle(
            Workbook workbook
    ) {

        CellStyle dateStyle =
                workbook.createCellStyle();

        CreationHelper helper =
                workbook.getCreationHelper();

        dateStyle.setDataFormat(
                helper.createDataFormat()
                        .getFormat("dd/MM/yyyy")
        );

        return dateStyle;
    }

    private void flushSheet(
            SXSSFSheet sheet,
            int keepRows
    ) {

        try {

            sheet.flushRows(keepRows);

        } catch (IOException e) {

            throw new RuntimeException(
                    "Error flushing excel rows",
                    e
            );
        }
    }

    private MapSqlParameterSource buildParams(
            LedgerEnquiryRequest dto
    ) {

        String currency =
                "ALL".equalsIgnoreCase(
                        dto.getCurrencies()
                )
                        ? null
                        : dto.getCurrencies();

        String circle =
                "ALL".equalsIgnoreCase(
                        dto.getCircle()
                )
                        ? null
                        : dto.getCircle();

        int skipSource =
                dto.getSourceFlags()
                        .contains("ALL")
                        ? 1
                        : 0;

        int skipBranches =
                dto.getBranches()
                        .contains("ALL")
                        ? 1
                        : 0;

        return new MapSqlParameterSource()
                .addValue("cgl", dto.getCgl())
                .addValue("source", dto.getSourceFlags())
                .addValue("currency", currency)
                .addValue("fromDate", dto.getFromDate())
                .addValue("toDate", dto.getToDate())
                .addValue("branches", dto.getBranches())
                .addValue("circle", circle)
                .addValue("skipSource", skipSource)
                .addValue("skipBranches", skipBranches);
    }
}