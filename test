// src/utils/buildDashboardConfig.js

const labelMap = {
  BRANCH: "Branch",
  CURRENCY: "Currency",
  ROLE_MANAGEMENT: "Role Management",
  SEGMENT: "Segment",
  CGL: "CGL",
  STATE: "State",
  USER_MANAGEMENT: "User Management",
  CALENDER: "Calendar",
  CIRCLE: "Circle"
};

function mapLabel(key) {
  return labelMap[key] || key;
}

export function buildDashboardConfig(apiData) {
  if (!apiData || !apiData.stats) return { sections: [] };

  const {
    stats,
    announcements = [],
    recentActivity = []
  } = apiData;

  // ---------- arrays for charts ----------

  const myPendingDetailsArr = Object.entries(stats.myPendingDetails || {}).map(
    ([k, v]) => ({ label: mapLabel(k), value: v })
  );

  const pendingForMeDetailsArr = Object.entries(
    stats.pendingForMeDetails || {}
  ).map(([k, v]) => ({ label: mapLabel(k), value: v }));

  const allModules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {})
  ]);

  const statusByModule = Array.from(allModules).map((m) => ({
    module: mapLabel(m),
    pending: (stats.myPendingDetails && stats.myPendingDetails[m]) || 0,
    approved: (stats.myApprovedDetails && stats.myApprovedDetails[m]) || 0,
    rejected: (stats.myRejectedDetails && stats.myRejectedDetails[m]) || 0
  }));

  const overallStatus = [
    { label: "Pending", value: stats.totalPending || 0 },
    { label: "Approved", value: stats.totalApproved || 0 },
    { label: "Rejected", value: stats.totalRejected || 0 }
  ];

  return {
    sections: [
      {
        id: "overallStatus",
        title: "Overall Requests Status",
        widgets: [
          {
            id: "overallStatusPie",
            title: "Pending vs Approved vs Rejected",
            type: "pie",
            data: overallStatus
          }
        ]
      },
      {
        id: "overview",
        title: "My Summary",
        widgets: [
          {
            id: "totalPending",
            title: "Total Pending Requests",
            type: "stat",
            data: {
              value: stats.totalPending || 0,
              secondary: [
                { label: "Approved", value: stats.totalApproved || 0 },
                { label: "Rejected", value: stats.totalRejected || 0 }
              ]
            }
          },
          {
            id: "myPending",
            title: "My Pending",
            type: "stat",
            data: {
              value: stats.myPending || 0,
              secondary: myPendingDetailsArr
            }
          },
          {
            id: "pendingForMe",
            title: "Pending For Me",
            type: "stat",
            data: {
              value: stats.pendingForMe || 0,
              secondary: pendingForMeDetailsArr
            }
          }
        ]
      },
      {
        id: "myPendingByModule",
        title: "My Requests by Module",
        widgets: [
          {
            id: "myPendingPie",
            title: "My Pending (Module-wise)",
            type: "pie",
            data: myPendingDetailsArr
          },
          {
            id: "myStatusByModule",
            title: "Pending vs Approved vs Rejected (Module-wise)",
            type: "bar",
            data: statusByModule
          }
        ]
      },
      {
        id: "announcements",
        title: "Announcements",
        widgets: [
          {
            id: "annList",
            title: "Important Messages",
            type: "list-announcements",
            data: announcements
          }
        ]
      },
      {
        id: "recentActivity",
        title: "Recent Activity",
        widgets: [
          {
            id: "activityList",
            title: "Latest Requests / Actions",
            type: "list-activity",
            data: recentActivity
          }
        ]
      }
    ]
  };
}