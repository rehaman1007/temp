import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import IconButton from "@mui/material/IconButton";

/* ================= NUMBER FORMAT ================= */
const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : "—";

/* ================= MAIN COMPONENT ================= */
const ProcessSummary = ({ open, data, onClose }) => {
  if (!data) return null;

  console.log(data);

  const { RECON_RUN_DATE, summary = [] } = data;

  const totalEntries = summary.reduce(
    (sum, row) => sum + (row.Total_no_of_entries || 0),
    0,
  );
  const totalNewEntries = summary.reduce(
    (sum, row) => sum + (row["new entry"] || 0),
    0,
  );

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>
        Difference Summary
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        {/* ================= META ================= */}
        <Box mb={2}>
          <Typography variant="caption" color="text.secondary">
            Reconciliation of ETL date
          </Typography>
          <Typography fontWeight={600}>{RECON_RUN_DATE}</Typography>
        </Box>

        {/* ================= TABLE ================= */}
        <TableContainer component={Paper} sx={{ maxHeight: 420 }}>
          <Table stickyHeader>
            <TableHead>
              <TableRow>
                <TableCell>Head</TableCell>
                <TableCell align="right">Total Entries</TableCell>
                <TableCell align="right">New Entries</TableCell>
              </TableRow>
            </TableHead>

            <TableBody>
              {summary.map((row, idx) => (
                <TableRow key={idx} hover>
                  <TableCell sx={{ fontWeight: 500 }}>{row.HEAD}</TableCell>
                  <TableCell align="right">
                    {formatAmount(row.Total_no_of_entries)}
                  </TableCell>
                  <TableCell align="right">
                    {formatAmount(row["new entry"])}
                  </TableCell>
                </TableRow>
              ))}

              {/* ================= TOTAL ================= */}
              <TableRow>
                <TableCell sx={{ fontWeight: 700 }}>TOTAL</TableCell>
                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalEntries)}
                </TableCell>
                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalNewEntries)}
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </TableContainer>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose} variant="outlined">
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ProcessSummary;
