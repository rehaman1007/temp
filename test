      updated.input2XXIII =
        Math.abs(updated.input2XVI - updated.input26bid) <= 5 ? 'OK' : Math.abs(updated.input26bid - updated.input2XVI);

      if (!bidDataFlag) {
        updated.input2XXIV =
          Math.abs(updated.input2XVII - (updated.input1bid + updated.input5t - updated.inputIt - updated.inputXIIIt)) <=
          5
            ? 'OK'
            : Math.abs(updated.input1bid + updated.input5t - updated.inputIt - updated.inputXIIIt - updated.input2XVII);
      } else {
        updated.input2XXIV =
          Math.abs(updated.input2XVII - (updated.input1bid - updated.inputIt - updated.inputXIIIt)) <= 5
            ? 'OK'
            : Math.abs(updated.input1bid - updated.inputIt - updated.inputXIIIt - updated.input2XVII);
      }

      console.log('updated.input2XXIV >', updated.input2XXIV);
      console.log(
        'condition >',
        Math.abs(updated.input2XVII - (updated.input1bid + updated.input5t - updated.inputIt - updated.inputXIIIt)) <= 5
      );

      /*Section 2 calculations ends*/

      /* Section 4: Calculations Starts */

      actualInput4aamount = !bidDataFlag ? updated.input4aamount : actualInput4aamount;

      updated.input4aamount =
        toValue(actualInput4aamount) +
        (toValue(updated.inputIa) + toValue(updated.inputXIIIa) + toValue(updated.inputXIVa)) +
        toValue(updated.inputIVa) +
        (toValue(updated.inputXIa) - toValue(updated.inputXIIa) - toValue(updated.inputXIIba));

      updated.input4haccount =
        toValue(updated.input4aaccount) +
        toValue(updated.input4baccount) +
        toValue(updated.input4caccount) +
        toValue(updated.input4daccount);

      updated.input4hamount =
        toValue(updated.input4aamount) +
        toValue(updated.input4bamount) +
        toValue(updated.input4camount) +
        toValue(updated.input4damount);

      updated.input4aamountTot = toValue(updated.input4aamount) + toValue(updated.input4aamountAdj);
      updated.input4bamountTot = toValue(updated.input4bamount) + toValue(updated.input4bamountAdj);
      updated.input4camountTot = toValue(updated.input4camount) + toValue(updated.input4camountAdj);
      updated.input4damountTot = toValue(updated.input4damount) + toValue(updated.input4damountAdj);

      updated.input4hamountAdj =
        toValue(updated.input4aamountAdj) +
        toValue(updated.input4bamountAdj) +
        toValue(updated.input4camountAdj) +
        toValue(updated.input4damountAdj);

      updated.input4hamountTot =
        toValue(updated.input4aamountTot) +
        toValue(updated.input4bamountTot) +
        toValue(updated.input4camountTot) +
        toValue(updated.input4damountTot);

      // Check Points Table -I
      updated.input4xi = (toValue(updated.input4aaccount) * 1).toFixed(0);
      updated.input4xiv = (toValue(updated.input4baccount) * 500001).toFixed(0);
      updated.input4xvii = (toValue(updated.input4caccount) * 750001).toFixed(0);
      updated.input4xx = (toValue(updated.input4daccount) * 1000001).toFixed(0);

      updated.input4xii = (toValue(updated.input4aaccount) * 500000).toFixed(0);
      updated.input4xv = (toValue(updated.input4baccount) * 750000).toFixed(0);
      updated.input4xviii = (toValue(updated.input4caccount) * 1000000).toFixed(0);

      // Check i
      updated.input4xiii =
        toValue(updated.input4xi) <= toValue(updated.input4aamount) &&
        toValue(updated.input4aamount) <= toValue(updated.input4xii)
          ? 'OK'
          : 'INCORRECT';

      // Check ii
      updated.input4xvi =
        toValue(updated.input4xiv) <= toValue(updated.input4bamount) &&
        toValue(updated.input4bamount) <= toValue(updated.input4xv)
          ? 'OK'
          : 'INCORRECT';

      // Check iii
      updated.input4xix =
        toValue(updated.input4xvii) <= toValue(updated.input4camount) &&
        toValue(updated.input4camount) <= toValue(updated.input4xviii)
          ? 'OK'
          : 'INCORRECT';

      // Check iv
      updated.input4xxii = toValue(updated.input4xx) - 1 <= toValue(updated.input4damount) ? 'OK' : 'INCORRECT';

      // Check Points Table -II
      updated.input4xxiii = Math.abs(toValue(updated.input38));

      updated.input4xxiv = bidDataFlag
        ? Math.abs(toValue(updated.input4hamountTot))
        : Math.abs(toValue(updated.input4hamount));

      updated.input4xxv =
        toValue(updated.input4xxiii) === toValue(updated.input4xxiv)
          ? 'OK'
          : toValue(updated.input4xxiii) - toValue(updated.input4xxiv);
      /* Section 4: Calculations Ends */
    }
    return updated;
  };

  const handleGoWorklist = () => {
    navigate('../');
  };

  const handleEditIdentifier = (identifier, action) => {
    const check = ['120', '160', '170', '180'];
    setSelectedIdentifier(identifier);
    if (action === 'upload') {
      setdailogName('upload');
    } else {
      check.includes(identifier) ? setdailogName('adjustment') : setdailogName('granular');
    }
    setOpenIdentifierDailog(true);
  };

  const handleDailogClose = () => {
    if (reFetchFlag) {
      fetchData();
    }
    setOpenIdentifierDailog(false);
  };

  const handleRequestRevisedData = async (confirm) => {
    if (confirm) {
      const currentRemark = requestRemarks || '';
      if (currentRemark.trim() === '') {
        setRemarksError(true);
        setRemarksHelper('Remarks are mandatory');
        return;
      }
      setRemarksError(false);
      setRemarksHelper('');
      try {
        const payload = {
          circleCode,
          qed,
          userId,
          requestRemarks,
        };
        const data = await callApi('/dicgcReport/requestRevisedData', payload);
        if (data) {
          handleGoWorklist();
        } else {
          showSnackBar('Failed to request revised data, Kindly try again', 'error');
        }
      } catch (error) {
        console.error(error);
        showSnackBar('Failed to request revised data, Kindly try again', 'error');
      }
    } else {
      setOpenRequestRevisedDataModal(true);
    }
  };

  return (
    <>
      <SkeletonWrapper
        isLoading={skeletonLoading}
        skeletonType="form"
        skeletonConfig={{
          fields: 0,
          hasTitle: true,
          fieldHeight: 10,
          buttonsCount: 4,
        }}
      />
      <SkeletonWrapper
        isLoading={skeletonLoading}
        skeletonType="table"
        skeletonConfig={{
          rows: 5,
          columns: 6,
          hasHeader: true,
          hasActions: false,
        }}
      />
      <SkeletonWrapper
        isLoading={skeletonLoading}
        skeletonType="table"
        skeletonConfig={{
          rows: 5,
          columns: 6,
          hasHeader: true,
          hasActions: false,
        }}
      />

      {!skeletonLoading && (
        <Box sx={{ display: 'flex', flexDirection: 'column', p: 2 }}>
          <Box align="center">
            <Button
              variant="contained"
              startIcon={<HistoryIcon />}
              sx={{ maxWidth: 200 }}
              onClick={() => handleRequestRevisedData(false)}
            >
              Request Revised Data
            </Button>
          </Box>

          <CustomStepper activeStep={currentView} />

          <Typography variant="h6" gutterBottom align="center" mt={2}>
            {SectionHeader[currentView]}
          </Typography>

          {currentView === 2 && (
            <Typography variant="body" gutterBottom align="center" mt={2}>
              It is requested to furnish the reasons for difference between the DICGC figures and QSA figures, if any,
              in the format given below. The difference amount of Reconciliation Statement should match with
              corresponding difference amount above. Additional rows, if required, may be added.
            </Typography>
          )}

          <Paper elevation={2} sx={{ flex: 1, display: 'flex', flexDirection: 'column', mt: 2 }}>
            {currentView === 0 && (
              <DICGCSection1
                dicgcReport={dicgcReport}
                handleInputChange={handleInputChange}
                bidDataFlag={bidDataFlag}
                onAction={(id, actionType) => handleEditIdentifier(id, actionType)}
              />
            )}
            {currentView === 1 && (
              <DICGCSection2
                dicgcReport={dicgcReport}
                handleInputChange={handleInputChange}
                bidDataFlag={bidDataFlag}
              />
            )}
            {currentView === 2 && (
              <DICGCSection3
                reportSts={reportStatus}
                reportID={reportId}
                input5t={dicgcReport.input5t}
                setSec3TotalDifference={setSec3TotalDifference}
              />
            )}
            {currentView === 3 && (
              <DICGCSection4
                dicgcReport={dicgcReport}
                handleInputChange={handleInputChange}
                bidDataFlag={bidDataFlag}
              />
            )}
          </Paper>

          <Box mt={2} display="flex" justifyContent="center">
            <Button variant="outlined" onClick={handlePrev} disabled={currentView === 0} sx={{ mr: 2 }}>
              Previous
            </Button>
            <Button variant="outlined" onClick={handleNext}>
              Save & {currentView < TOTAL_VIEWS - 1 ? 'Next' : 'Submit'}
            </Button>
          </Box>
        </Box>
      )}

      <LoadingOverlay loading={loading} />

      {/* Dialog for Save and Submit */}
      <Dialog open={openDailog} maxWidth="md">
        <DialogTitle>
          <Box display="flex" justifyContent="space-between" alignItems="center">
            <Typography variant="h6" align="center" width="100%">
              {dailog.head}
            </Typography>
            {dailog.head !== 'Submitted !' && (
              <IconButton
                onClick={() => {
                  setOpenDailog(false);
                }}
              >
                <CloseIcon />
              </IconButton>
            )}
          </Box>
        </DialogTitle>

        <DialogContent dividers sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
          <Box>
            <Typography variant="subtitle1" gutterBottom>
              {dailog.message}
            </Typography>
          </Box>
        </DialogContent>

        {dailog.head === 'Success !' && (
          <DialogActions sx={{ justifyContent: 'right', p: 2 }}>
            <Button variant="contained" onClick={() => submitReport(true)}>
              Submit Report
            </Button>
          </DialogActions>
        )}
        {dailog.head === 'Submitted !' && (
          <DialogActions sx={{ justifyContent: 'right', p: 2 }}>
            <Button variant="contained" onClick={() => handleGoWorklist()}>
              Go to worklist
            </Button>
          </DialogActions>
        )}
      </Dialog>

      {/* Dialog for Adjustment , Granular and Bulk upload */}
      <Dialog
        open={openIdentifierDailog}
        onClose={handleDailogClose}
        fullWidth
        maxWidth="xl"
        fullScreen={fullScreen}
        PaperProps={{
          sx: {
            display: 'flex',
            flexDirection: 'column',
          },
        }}
      >
        {/* Header */}
        <DialogTitle sx={{ p: 2, pb: 1 }}>
          <Box display="flex" justifyContent="space-between" alignItems="center">
            <Typography variant="h6" align="center" width="100%">
              {dailogName === 'upload'
                ? 'Upload File For Bulk Data Entry'
                : dailogName === 'adjustment'
                ? 'Modification of Statement Showing Distribution of Deposit Accounts'
                : 'Modify in Granular Data'}
            </Typography>
            <IconButton onClick={handleDailogClose} sx={{ position: 'absolute', right: 16 }}>
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>

        {/* Body */}
        <DialogContent
          dividers
          sx={{
            flex: 1,
            overflow: 'auto',
            outline: 'auto',
            outlineColor: `${theme.palette.divider}`,
            margin: 3,
          }}
        >
          {/* Dialog for Bulk upload entries on granular data */}
          {dailogName === 'upload' && (
            <DICGCUpload reportId={reportId} identifier={selectedIdentifier} setReFetchFlag={setReFetchFlag} />
          )}
          {/* Dialog for Adjustment of statement table */}
          {dailogName === 'adjustment' && (
            <DICGCAdustment reportId={reportId} identifier={selectedIdentifier} setReFetchFlag={setReFetchFlag} />
          )}
          {/* Dialog for Granular data */}
          {dailogName === 'granular' && (
            <Box sx={{ minHeight: '75vh' }}>
              <DICGCGranular reportId={reportId} identifier={selectedIdentifier} setReFetchFlag={setReFetchFlag} />
            </Box>
          )}
        </DialogContent>
      </Dialog>

      {/* Dialog for Request Revised Data */}
      <Dialog
        open={openRequestRevisedDataModal}
        maxWidth="sm"
        fullWidth
        PaperProps={{
          sx: {
            display: 'flex',
            flexDirection: 'column',
          },
        }}
      >
        {/* Header */}
        <DialogTitle sx={{ p: 2, pb: 1 }}>
          <Box display="flex" justifyContent="space-between" gap="80px" alignItems="center">
            <Typography variant="h6" align="center">
              Add remarks for requesting revised data
            </Typography>
            <IconButton onClick={() => setOpenRequestRevisedDataModal(false)}>
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>
        <Divider />
        {/* Body     */}
        <DialogContent>
          <Typography variant="body" align="center" mt={2}>
            Do you want to request revised data for DICGC, after confirming this request DICGC report for this circle
            will be on hold. Please fill remarks and confirm your request.
          </Typography>
          <Typography variant="body2" mt={3} mb={1}>
            Enter your remarks here :
          </Typography>

          <Box sx={{ width: '100%' }}>
            {/* <ThemeProvider theme={defaultTheme}> */}
            <FormInput
              // fullWidth
              id="filled-multiline-flexible"
              multiline
              minRows={3}
              size="full"
              minLength={8}
              maxLength={95}
              inputType={'alphaNumWithSpaceTrim'}
              // rows={3}
              // multiline
              // sx={{ height: '100%' }}
              // inputProps={{ minLength: 8, maxLength: 95 }}
              value={requestRemarks}
              onChange={(e) => {
                setRequestRemarks(e.target.value);
              }}
              error={remarksError}
              helperText={remarksHelper}
            ></FormInput>
            {/* </ThemeProvider> */}
          </Box>
        </DialogContent>
        <Divider />
        <DialogActions>
          <CustomButton onClick={() => handleRequestRevisedData(true)} buttonType={'submit'} label={'Submit Remarks'} />
        </DialogActions>
      </Dialog>
    </>
  );
};

export default DICGCReport;
