import { useEffect, useRef, useState } from "react";
import * as THREE from "three";
import NET from "vanta/dist/vanta.net.min";

export default function SplashScreen() {
  const vantaRef = useRef(null);
  const [vantaEffect, setVantaEffect] = useState(null);

  useEffect(() => {
    if (!vantaEffect) {
      setVantaEffect(
        NET({
          el: vantaRef.current,
          THREE: THREE,
          mouseControls: true,
          touchControls: true,
          gyroControls: false,
          minHeight: 200.0,
          minWidth: 200.0,
          scale: 1.0,
          scaleMobile: 1.0,
          color: 0x1e90ff,
          backgroundColor: 0x000000,
          points: 12.0,
          maxDistance: 22.0,
          spacing: 18.0,
        })
      );
    }
    return () => {
      if (vantaEffect) vantaEffect.destroy();
    };
  }, [vantaEffect]);

  return (
    <div
      ref={vantaRef}
      style={{
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        minHeight: "100vh",
        fontFamily: "'Orbitron', sans-serif",
        color: "#fff",
        margin: 0,
        padding: 0,
        position: "relative",
        overflow: "hidden",
        textAlign: "center",
      }}
    >
      {/* Load custom Google font */}
      <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&display=swap"
        rel="stylesheet"
      />

      <style>{`
        @keyframes shimmer {
          0% { background-position: -500px 0; }
          100% { background-position: 500px 0; }
        }

        @keyframes floaty {
          0% { transform: scale(1) translateY(0); }
          50% { transform: scale(1.05) translateY(-8px); }
          100% { transform: scale(1) translateY(0); }
        }

        .title {
          font-size: 100px;
          font-weight: 800;
          text-transform: uppercase;
          background: linear-gradient(90deg, #00eaff, #1e90ff, #00ffcc, #1e90ff);
          background-size: 400% 100%;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          animation: shimmer 6s linear infinite, floaty 4s ease-in-out infinite;
          text-shadow: 0px 0px 30px rgba(0, 200, 255, 0.4);
          letter-spacing: 6px;
        }

        .subtitle {
          font-size: 20px;
          font-weight: 400;
          margin-top: 15px;
          color: rgba(255, 255, 255, 0.85);
          animation: floaty 6s ease-in-out infinite;
        }
      `}</style>

      {/* Animated title */}
      <div className="title">Tranche</div>

      {/* Subtitle */}
      <div className="subtitle">Welcome to Tranche Module…</div>
    </div>
  );
}