int startRow = page * size;

String paginatedSql =
        executableSelect +
        """
        
        OFFSET ? ROWS
        FETCH NEXT ? ROWS ONLY
        """;


jdbcTemplate.query(
        paginatedSql,
        rs -> {

            ResultSetMetaData metaData = rs.getMetaData();
            int columnCount = metaData.getColumnCount();

            if (columns.isEmpty()) {

                for (int i = 1; i <= columnCount; i++) {

                    columns.add(
                            Map.of(
                                    "name",
                                    metaData.getColumnLabel(i)
                            )
                    );
                }
            }

            while (rs.next()) {

                Map<String, Object> row =
                        new LinkedHashMap<>();

                for (int i = 1; i <= columnCount; i++) {

                    row.put(
                            metaData.getColumnLabel(i),
                            rs.getObject(i)
                    );
                }

                rawRows.add(row);
            }

            return null;
        },
        startRow,
        size
);

