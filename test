import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControl,
  Grid,
  InputAdornment,
  InputLabel,
  MenuItem,
  Select,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import PersonIcon from "@mui/icons-material/Person";
import VerifiedUserIcon from "@mui/icons-material/VerifiedUser";
import GppBadIcon from "@mui/icons-material/GppBad";
import { useState } from "react";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import _ from "lodash";

/* ================= CONSTANTS ================= */

const USERID_REGEX = /^(?:\d{7}|v\d{7}|tcs\d{7}|tcsv\d{7})$/i;
const NAME_REGEX = /^[a-zA-Z\s.]*$/;
const DIGITS_REGEX = /^[0-9]*$/;

const EMAIL_DOMAIN = "@sbi.co.in";
const EMAIL_PREFIX_MAX = 50;

const STATUS_OPTIONS = [
  {
    value: "ACTIVE",
    label: "Active",
    icon: <VerifiedUserIcon color="success" />,
  },
  {
    value: "INACTIVE",
    label: "Inactive",
    icon: <GppBadIcon color="warning" />,
  },
];

/* ================= COMPONENT ================= */

export default function UserDialog({
  open,
  onClose,
  roles,
  form,
  setForm,
  initialState,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const [errors, setErrors] = useState({});
  const isEdit = Boolean(form.id);

  /* ================= HELPERS ================= */

  const setFieldError = (name, msg) =>
    setErrors((p) => ({ ...p, [name]: msg }));

  const clearFieldError = (name) => setErrors((p) => ({ ...p, [name]: "" }));

  /* ================= USER ID ================= */

  const handleUserIdChange = (raw) => {
    if (isEdit) return;

    let value = raw.replace(/\s+/g, "");
    const match = value.match(/^([A-Za-z]*)(.*)$/);

    let prefix = match?.[1] || "";
    let digits = (match?.[2] || "").replace(/\D/g, "");

    const allowedPrefixes = ["", "t", "tc", "tcs", "tcsv", "v"];
    if (!allowedPrefixes.some((p) => prefix.toLowerCase().startsWith(p))) {
      setFieldError("USERID", "Invalid prefix");
      return;
    }

    if (digits.length > 7) {
      setFieldError("USERID", "User ID must be 7 digits");
      return;
    }

    clearFieldError("USERID");
    setForm((p) => ({ ...p, USERID: prefix + digits }));
  };

  const fetchUserOnBlur = async () => {
    if (!USERID_REGEX.test(form.USERID)) {
      setFieldError("USERID", "Invalid User ID format");
      return;
    }

    try {
      const res = await callApi(
        "/UM/user/get-user-by-id",
        { userId: form.USERID },
        "POST"
      );

      const u = res?.result?.user;
      if (!u) return;

      snackbar("User already exists. Loaded details.", "warning");
      setForm({
        id: u.userId,
        USERID: u.userId,
        FIRST_NAME: u.firstName,
        MIDDLE_NAME: u.middleName || "",
        LAST_NAME: u.lastName,
        EMAIL: u.email,
        PHONE_NUMBER: u.phoneNumber || "",
        ROLE_ID: u.roleId,
        ROLE_NAME: u.roleName,
        ACCOUNT_STATUS: u.accountStatus,
      });
    } catch {
      snackbar("User lookup failed", "error");
    }
  };

  /* ================= NAME FIELDS ================= */

  const handleNameChange = (name, value, mandatory) => {
    if (!NAME_REGEX.test(value)) {
      setFieldError(name, "Only alphabets allowed");
      return;
    }

    if (value && value.length < 3) {
      setFieldError(name, "Minimum 3 characters required");
    } else if (value.length > 20) {
      setFieldError(name, "Maximum 20 characters allowed");
    } else if (!value && mandatory) {
      setFieldError(name, "This field is required");
    } else {
      clearFieldError(name);
    }

    setForm((p) => ({ ...p, [name]: value }));
  };

  /* ================= EMAIL ================= */

  const handleEmailChange = (raw) => {
    let prefix = raw.replace(EMAIL_DOMAIN, "");
    if (prefix.includes("@")) return;
    if (prefix.length > EMAIL_PREFIX_MAX) return;

    clearFieldError("EMAIL");
    setForm((p) => ({ ...p, EMAIL: prefix + EMAIL_DOMAIN }));
  };

  /* ================= MOBILE ================= */

  const handleMobileChange = (value) => {
    if (!DIGITS_REGEX.test(value)) return;

    if (value && value.length !== 10) {
      setFieldError("PHONE_NUMBER", "Mobile must be 10 digits");
    } else {
      clearFieldError("PHONE_NUMBER");
    }

    if (value.length <= 10) setForm((p) => ({ ...p, PHONE_NUMBER: value }));
  };

  /* ================= FINAL VALIDATION ================= */

  const validateFinal = () => {
    const e = {};

    if (!USERID_REGEX.test(form.USERID)) e.USERID = "Valid User ID required";

    if (!form.FIRST_NAME || form.FIRST_NAME.length < 3)
      e.FIRST_NAME = "First Name is required";

    if (!form.EMAIL?.endsWith(EMAIL_DOMAIN))
      e.EMAIL = "Email must end with @sbi.co.in";

    if (form.PHONE_NUMBER && form.PHONE_NUMBER.length !== 10)
      e.PHONE_NUMBER = "Mobile must be 10 digits";

    if (!form.ROLE_ID) e.ROLE_ID = "Role is required";
    if (isEdit && !form.ACCOUNT_STATUS) e.ACCOUNT_STATUS = "Status is required";

    setErrors(e);
    return Object.keys(e).length === 0;
  };

  /* ================= SAVE ================= */

  const onSave = async () => {
    if (!validateFinal()) {
      snackbar("Please fix validation errors", "error");
      return;
    }

    if (_.isEqual(form, initialState)) {
      snackbar("No Changes detected, Kindly modify before saving", "warning");
      return;
    }
    const payload = {
      targetUserId: form.USERID,
      requestType: isEdit ? "MODIFY" : "CREATE",
      requestPayload: JSON.stringify({
        userId: form.USERID,
        firstName: form.FIRST_NAME,
        middleName: form.MIDDLE_NAME,
        lastName: form.LAST_NAME,
        email: form.EMAIL,
        phoneNumber: form.PHONE_NUMBER,
        roleName: form.ROLE_NAME,
        roleId: form.ROLE_ID,
        accountStatus: form.ACCOUNT_STATUS,
      }),
    };

    try {
      const response = await callApi(
        "/UM/user/create-request",
        payload,
        "POSt"
      );
      if (response) {
        snackbar(
          form.id
            ? "User update request submitted successfully"
            : "User creation request submitted successfully",
          "success"
        );
        onClose();
      }

      snackbar("Request submitted successfully", "success");
      onClose();
    } catch (error) {
      snackbar(
        error?.response?.data?.message ||
          "Something went wrong, Kindly try again",
        "error"
      );
    }
  };

  /* ================= RENDER ================= */

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle>{isEdit ? "Edit User" : "Create User"}</DialogTitle>

      <DialogContent>
        <Stack spacing={2} mt={1}>
          {/* Row 1 */}
          <Grid container spacing={2}>
            <Grid size={{ xs: 6 }}>
              <TextField
                label="User ID *"
                value={form.USERID}
                onChange={(e) => handleUserIdChange(e.target.value)}
                onBlur={fetchUserOnBlur}
                disabled={isEdit}
                error={!!errors.USERID}
                helperText={errors.USERID}
                InputProps={{
                  startAdornment: (
                    <InputAdornment position="start">
                      <PersonIcon />
                    </InputAdornment>
                  ),
                }}
                fullWidth
              />
            </Grid>

            {isEdit && (
              <Grid size={{ xs: 6 }}>
                <FormControl fullWidth error={!!errors.ACCOUNT_STATUS}>
                  <InputLabel>Status *</InputLabel>
                  <Select
                    label="Status *"
                    value={form.ACCOUNT_STATUS || ""}
                    onChange={(e) =>
                      setForm({ ...form, ACCOUNT_STATUS: e.target.value })
                    }
                  >
                    {STATUS_OPTIONS.map((s) => (
                      <MenuItem key={s.value} value={s.value}>
                        <Stack direction="row" spacing={1}>
                          {s.icon}
                          <Typography>{s.label}</Typography>
                        </Stack>
                      </MenuItem>
                    ))}
                  </Select>
                  <Typography variant="caption" color="error">
                    {errors.ACCOUNT_STATUS}
                  </Typography>
                </FormControl>
              </Grid>
            )}
          </Grid>

          {/* Row 2 */}
          <Grid container spacing={2}>
            <Grid size={{ xs: 4 }}>
              <TextField
                label="First Name *"
                value={form.FIRST_NAME}
                error={!!errors.FIRST_NAME}
                helperText={errors.FIRST_NAME}
                onChange={(e) =>
                  handleNameChange("FIRST_NAME", e.target.value, true)
                }
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 4 }}>
              <TextField
                label="Middle Name"
                value={form.MIDDLE_NAME}
                error={!!errors.MIDDLE_NAME}
                helperText={errors.MIDDLE_NAME}
                onChange={(e) =>
                  handleNameChange("MIDDLE_NAME", e.target.value, false)
                }
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 4 }}>
              <TextField
                label="Last Name"
                value={form.LAST_NAME}
                error={!!errors.LAST_NAME}
                helperText={errors.LAST_NAME}
                onChange={(e) =>
                  handleNameChange("LAST_NAME", e.target.value, true)
                }
                fullWidth
              />
            </Grid>
          </Grid>

          {/* Row 3 */}
          <Grid container spacing={2}>
            <Grid size={{ xs: 6 }}>
              <TextField
                label="Email *"
                value={form.EMAIL || EMAIL_DOMAIN}
                error={!!errors.EMAIL}
                helperText={errors.EMAIL}
                onChange={(e) => handleEmailChange(e.target.value)}
                fullWidth
              />
            </Grid>

            <Grid size={{ xs: 6 }}>
              <TextField
                label="Mobile Number"
                value={form.PHONE_NUMBER}
                error={!!errors.PHONE_NUMBER}
                helperText={errors.PHONE_NUMBER}
                onChange={(e) => handleMobileChange(e.target.value)}
                inputProps={{ maxLength: 10 }}
                fullWidth
              />
            </Grid>
          </Grid>

          {/* Row 4 */}
          <Grid container spacing={2}>
            <Grid size={{ xs: 6 }}>
              <FormControl fullWidth error={!!errors.ROLE_ID}>
                <InputLabel>Role *</InputLabel>
                <Select
                  label="Role *"
                  value={form.ROLE_ID || ""}
                  onChange={(e) => {
                    const r = roles.find((x) => x.id === e.target.value);
                    setForm({ ...form, ROLE_ID: r.id, ROLE_NAME: r.name });
                    clearFieldError("ROLE_ID");
                  }}
                >
                  {roles.map((r) => (
                    <MenuItem key={r.id} value={r.id}>
                      {r.name}
                    </MenuItem>
                  ))}
                </Select>
                <Typography variant="caption" color="error">
                  {errors.ROLE_ID}
                </Typography>
              </FormControl>
            </Grid>
          </Grid>
        </Stack>
      </DialogContent>

      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button variant="contained" onClick={onSave}>
          {isEdit ? "Update User" : "Create User"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
