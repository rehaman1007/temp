  useEffect(() => {
    let cancelled = false;

    const run = async () => {
      setError(null);

      if (!debouncedSearch || debouncedSearch.trim().length < MIN_SEARCH_LEN) {
        setOptions([]);
        return;
      }

      setOptionsLoading(true);
      try {
        const res = await searchCglFromApi(debouncedSearch.trim());
        if (!cancelled) {
          setOptions(res || []);
        }
      } catch (e: any) {
        if (!cancelled) {
          setError(e?.message || "Unable to fetch results");
          setOptions([]);
        }
      } finally {
        if (!cancelled) setOptionsLoading(false);
      }
    };

    run();
    return () => {
      cancelled = true;
    };
  }, [debouncedSearch]);

