import React, { useMemo } from "react";
import { Box, Typography, Card, Stack, Chip, useTheme } from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
} from "recharts";

// Gradient colors (matching your design)
const COLORS = [
  "#d87093", // Add Requests
  "#6a5acd", // Modify Requests
  "#20b2aa", // Delete Requests
];

const RequestAnalytics = ({ data = [] }) => {
  const theme = useTheme();

  // ----- Compute Pie Chart Data -----
  const { total, pieData } = useMemo(() => {
    const counts = { total: 0, add: 0, modify: 0, delete: 0 };

    data.forEach((item) => {
      counts.total++;
      if (item.changeType === "ADD") counts.add++;
      if (item.changeType === "UPDATE") counts.modify++;
      if (item.changeType === "DELETE") counts.delete++;
    });

    const pieData = [
      { name: "Add Requests", value: counts.add },
      { name: "Modify Requests", value: counts.modify },
      { name: "Delete Requests", value: counts.delete },
    ];

    return { total: counts.total, pieData };
  }, [data]);

  // ----- Compute Histogram Data -----
  const histogramData = useMemo(() => {
    const map = {};
    data.forEach((item) => {
      if (item.reqDate) {
        const date = new Date(item.reqDate).toLocaleDateString("en-GB");
        map[date] = (map[date] || 0) + 1;
      }
    });
    return Object.keys(map)
      .sort(
        (a, b) =>
          new Date(a.split("/").reverse().join("-")) -
          new Date(b.split("/").reverse().join("-"))
      )
      .map((date) => ({ date, count: map[date] }));
  }, [data]);

  return (
    <Card
      sx={{
        bgcolor: "transparent",
        color: "white",
        p: 2,
        borderRadius: 3,
        mb: 3,
        boxShadow: "none",
      }}
    >
      {/* Header */}
      <Typography variant="h6" sx={{ mb: 1 }}>
        Request Analytics Overview
      </Typography>
      <Typography variant="body2" sx={{ color: "gray", mb: 2 }}>
        Requests compared by type and frequency
      </Typography>

      <Box
        sx={{
          display: "flex",
          flexDirection: { xs: "column", lg: "row" },
          gap: 3,
          alignItems: "flex-start",
        }}
      >
        {/* Pie Chart Section */}
        <Box
          sx={{
            flex: 1,
            position: "relative",
            height: 300,
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
          }}
        >
          <Box sx={{ width: "100%", height: 250 }}>
            <ResponsiveContainer>
              <PieChart>
                <defs>
                  {COLORS.map((color, index) => (
                    <linearGradient
                      key={index}
                      id={`gradient-${index}`}
                      x1="0"
                      y1="0"
                      x2="1"
                      y2="1"
                    >
                      <stop offset="0%" stopColor={color} stopOpacity={0.9} />
                      <stop offset="100%" stopColor={color} stopOpacity={0.5} />
                    </linearGradient>
                  ))}
                </defs>
                <Pie
                  data={pieData}
                  cx="50%"
                  cy="50%"
                  innerRadius={70}
                  outerRadius={100}
                  paddingAngle={4}
                  dataKey="value"
                >
                  {pieData.map((entry, index) => (
                    <Cell
                      key={`cell-${index}`}
                      fill={`url(#gradient-${index})`}
                      stroke="none"
                    />
                  ))}
                </Pie>
                <Tooltip
                  contentStyle={{
                    backgroundColor: "#2a2a3a",
                    borderRadius: 10,
                    border: "none",
                    color: "#fff",
                  }}
                />
              </PieChart>
            </ResponsiveContainer>

            {/* Center Label */}
            <Box
              sx={{
                position: "absolute",
                top: "50%",
                left: "50%",
                transform: "translate(-50%, -50%)",
                textAlign: "center",
              }}
            >
              <Typography
                variant="body2"
                sx={{ color: "gray", fontWeight: 500, lineHeight: 1 }}
              >
                Total
              </Typography>
              <Typography
                variant="h6"
                sx={{
                  fontWeight: "bold",
                  color: "white",
                  lineHeight: 1.2,
                }}
              >
                Requests: {total}
              </Typography>
            </Box>
          </Box>

          {/* ✅ Legend row (always visible below chart) */}
          <Stack
            direction="row"
            justifyContent="center"
            alignItems="center"
            spacing={2}
            sx={{ mt: 2, flexWrap: "wrap", width: "100%" }}
          >
            {pieData.map((item, i) => (
              <Stack
                key={item.name}
                direction="row"
                alignItems="center"
                spacing={1}
                sx={{
                  bgcolor: "rgba(255,255,255,0.05)",
                  borderRadius: 2,
                  px: 1.5,
                  py: 0.5,
                }}
              >
                <Box
                  sx={{
                    width: 12,
                    height: 12,
                    borderRadius: "50%",
                    bgcolor: COLORS[i],
                  }}
                />
                <Typography variant="body2">{item.name}</Typography>
                <Chip
                  label={item.value}
                  size="small"
                  sx={{
                    bgcolor: COLORS[i],
                    color: "white",
                    fontWeight: "bold",
                    height: 22,
                  }}
                />
              </Stack>
            ))}
          </Stack>
        </Box>

        {/* Histogram Section */}
        <Box sx={{ flex: 1, width: "100%", height: 300 }}>
          <ResponsiveContainer>
            <BarChart data={histogramData}>
              <CartesianGrid
                strokeDasharray="3 3"
                stroke="rgba(255,255,255,0.1)"
              />
              <XAxis dataKey="date" stroke="white" />
              <YAxis stroke="white" />
              <Tooltip
                contentStyle={{
                  backgroundColor: "#2a2a3a",
                  borderRadius: 10,
                  border: "none",
                  color: "#fff",
                }}
              />
              <Bar
                dataKey="count"
                fill="url(#gradient-0)"
                radius={[6, 6, 0, 0]}
              />
            </BarChart>
          </ResponsiveContainer>
        </Box>
      </Box>
    </Card>
  );
};

export default RequestAnalytics;
