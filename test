WITH filteredbranches AS (
    SELECT branch_code
    FROM bs_branch
    WHERE branch_circle = '002'
)

SELECT
    TO_CHAR(cd_identifier) AS id,
    SUM(cd_amount)         AS amt
FROM bs_dicgc_bid_con
WHERE cd_date = DATE '2025-12-31'
  AND cd_branch IN (SELECT branch_code FROM filteredbranches)
  AND cd_identifier < 1000
  AND cd_identifier NOT IN (
        220,230,250,260,280,
        290,310,320,340,350,
        360,370,380,390,400,
        410,420,430
  )
GROUP BY cd_identifier

UNION ALL

SELECT
    TO_CHAR(gd_identifier) AS id,
    SUM(
        CASE 
            WHEN gd_identifier = 340
                 AND TRIM(UPPER(gd_modified_flag)) = 'Y'
            THEN NVL(gd_final_amount,0)
            WHEN gd_identifier = 340
            THEN 0
            ELSE NVL(gd_final_amount,0)
        END
    ) AS amt
FROM bs_dicgc_bid_granular
WHERE gd_quarter_end_date = DATE '2025-12-31'
  AND gd_branch_no IN (SELECT branch_code FROM filteredbranches)
  AND gd_identifier IN (
        220,230,250,260,280,
        290,310,320,340,350,
        360,370,380,390,400,
        410,420,430
  )
GROUP BY gd_identifier

ORDER BY 1;