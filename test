import React, { useState } from "react";
import PropTypes from "prop-types";
import { Tabs, Tab, Box } from "@mui/material";
import BadgeIcon from "@mui/icons-material/Badge";
import PendingActionsIcon from "@mui/icons-material/PendingActions";
import RoleManagementTab1 from "./RoleManagementTab1";
import RoleManagementTab2 from "./RoleManagementTab2";

function CustomTabPanel(props) {
  const { children, value, index, ...other } = props;

  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`simple-tabpanel-${index}`}
      aria-labelledby={`simple-tab-${index}`}
      {...other}
    >
      {value === index && <Box sx={{ py: 2 }}>{children}</Box>}
    </div>
  );
}

CustomTabPanel.propTypes = {
  children: PropTypes.node,
  index: PropTypes.number.isRequired,
  value: PropTypes.number.isRequired,
};

function a11yProps(index) {
  return {
    id: `simple-tab-${index}`,
    "aria-controls": `simple-tabpanel-${index}`,
  };
}

export default function RoleManagement() {
  const [value, setValue] = useState(0);

  const handleChange = (event, newValue) => {
    setValue(newValue);
  };

  return (
    <Box>
      <Box
        sx={{
          borderBottom: 1,
          borderColor: "divider",
        }}
        fullwidth
      >
        <Tabs
          sx={{
            width: "100%",
          }}
          value={value}
          onChange={handleChange}
          aria-label="basic tabs example"
          variant="fullWidth"
        >
          <Tab
            label="Manage Roles"
            icon={<BadgeIcon />}
            iconPosition="start"
            {...a11yProps(0)}
          />
          <Tab
            icon={<PendingActionsIcon />}
            iconPosition="start"
            label="My Requests"
            {...a11yProps(1)}
          />
        </Tabs>
      </Box>
      <CustomTabPanel value={value} index={0}>
        <RoleManagementTab1 />
      </CustomTabPanel>
      <CustomTabPanel value={value} index={1}>
        <RoleManagementTab2 />
      </CustomTabPanel>
    </Box>
  );
}


import { useCallback, useEffect, useState } from "react";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import { Box, Fab, Paper } from "@mui/material";
import RolesTable from "../components/RolesTable";
import RolesDialog from "../components/RolesDialog";
import AddIcon from "@mui/icons-material/Add";
import PermissionsDialog from "../components/PermissionsDialog";
import _ from "lodash";

export default function RoleManagementTab1() {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const emptyForm = {
    roleId: "",
    roleName: "",
    description: "",
    roleStatus: "ACTIVE",
    permissions: [],
  };
  const [rows, setRows] = useState([]);
  const [form, setForm] = useState(emptyForm);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [permDialogOpen, setPermDialogOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const fetchRoles = useCallback(async () => {
    setIsLoading(true);
    setPermDialogOpen(false);
    setDialogOpen(false);
    try {
      const data = await callApi(
        "/UM/role/get-roles",
        { permissions: true },
        "GET"
      );

      const roles = data?.result?.roles ?? [];
      setRows(roles);
    } catch (e) {
      console.error(e);
      setRows([]);
      snackbar("Failed to fetch roles. Check API or network.", "error");
    } finally {
      setIsLoading(false);
    }
  }, [callApi]);

  useEffect(() => {
    fetchRoles();
  }, [fetchRoles]);

  const canSave =
    (form.roleName || "").trim() && (form.description || "").trim();

  const handleEditRow = (row, isEdit) => {
    setForm({ ...row });
    isEdit ? setDialogOpen(true) : setPermDialogOpen(true);
  };

  const handleSavePermissionOrder = async (ordered) => {
    const isSameOrder = _.isEqual(form.permissions, ordered);
    console.log("isChanged :>", !isSameOrder);

    if (isSameOrder) {
      snackbar("Kindly Change the order before saving it", "warning");
      return;
    }

    try {
      const payload = {
        selectedRole: form?.roleId,
        permissions: ordered,
      };
      const response = await callApi(
        "/UM/role/save-permission-order",
        payload,
        "PATCH"
      );
      snackbar(response?.message, "success");
    } catch (err) {
      console.error(err);
      snackbar("Error while processing request", "error");
    }
    fetchRoles();
  };

  return (
    <Box sx={{ p: { xs: 2, md: 3 } }}>
      <Paper variant="outlined" sx={{ mt: 2 }}>
        <RolesTable
          rows={rows}
          isLoading={isLoading}
          onEditRow={(row, isEdit) => handleEditRow(row, isEdit)}
        />
      </Paper>

      <RolesDialog
        open={dialogOpen}
        onClose={() => setDialogOpen(false)}
        form={form}
        setForm={setForm}
        canSave={canSave}
        fetchRoles={fetchRoles}
      />

      <PermissionsDialog
        open={permDialogOpen}
        handleSavePermissionOrder={handleSavePermissionOrder}
        onClose={() => {
          setPermDialogOpen(false);
        }}
        permissions={form?.permissions || []}
        roleName={form?.roleName || ""}
      />

      <Fab
        onClick={() => {
          setForm(emptyForm);
          setDialogOpen(true);
        }}
        color="primary"
        variant="extended"
        sx={{
          position: "fixed",
          borderRadius: 1,
          fontSize: "15px",
          bottom: (theme) => theme.spacing(8),
          right: (theme) => theme.spacing(4),
        }}
      >
        <AddIcon sx={{ mr: 1 }} />
        Create Role
      </Fab>
    </Box>
  );
}
