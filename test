// src/utils/buildDashboardConfig.js

const labelMap = {
  BRANCH: "Branch",
  CURRENCY: "Currency",
  ROLE_MANAGEMENT: "Role Management",
  SEGMENT: "Segment",
  CGL: "CGL",
  STATE: "State",
  USER_MANAGEMENT: "User Management",
  CALENDER: "Calendar",
  CIRCLE: "Circle"
};

export function buildDashboardConfig(apiData) {
  if (!apiData || !apiData.stats) return { sections: [] };

  const { stats, announcements = [], recentActivity = [] } = apiData;

  const pendingForMeDetailsArr = Object.entries(stats.pendingForMeDetails || {}).map(
    ([key, value]) => ({
      label: labelMap[key] || key,
      value
    })
  );

  const myPendingDetailsArr = Object.entries(stats.myPendingDetails || {}).map(
    ([key, value]) => ({
      label: labelMap[key] || key,
      value
    })
  );

  const modules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {})
  ]);

  const barData = Array.from(modules).map((m) => ({
    module: labelMap[m] || m,
    pending: (stats.myPendingDetails && stats.myPendingDetails[m]) || 0,
    approved: (stats.myApprovedDetails && stats.myApprovedDetails[m]) || 0,
    rejected: (stats.myRejectedDetails && stats.myRejectedDetails[m]) || 0
  }));

  return {
    sections: [
      // Overview
      {
        id: "overview",
        title: "My Overview",
        widgets: [
          {
            id: "totalPending",
            title: "Total Pending Requests",
            type: "stat",
            data: {
              value: stats.totalPending,
              secondary: [
                { label: "Approved", value: stats.totalApproved },
                { label: "Rejected", value: stats.totalRejected }
              ]
            }
          },
          {
            id: "myPending",
            title: "My Pending",
            type: "stat",
            data: {
              value: stats.myPending,
              secondary: myPendingDetailsArr
            }
          },
          {
            id: "pendingForMe",
            title: "Pending For Me",
            type: "stat",
            data: {
              value: stats.pendingForMe,
              secondary: pendingForMeDetailsArr
            }
          }
        ]
      },

      // My pending by module
      {
        id: "myPendingByModule",
        title: "My Pending by Module",
        widgets: [
          {
            id: "myPendingPie",
            title: "Pending by Module",
            type: "pie",
            data: myPendingDetailsArr
          },
          {
            id: "myStatusByModule",
            title: "Pending vs Approved vs Rejected",
            type: "bar",
            data: barData
          }
        ]
      },

      // Announcements
      {
        id: "announcements",
        title: "Announcements",
        widgets: [
          {
            id: "annList",
            type: "list-announcements",
            data: announcements
          }
        ]
      },

      // Recent activity
      {
        id: "recentActivity",
        title: "Recent Activity",
        widgets: [
          {
            id: "activityList",
            type: "list-activity",
            data: recentActivity
          }
        ]
      }
    ]
  };
}