import { useCallback, useEffect, useState } from "react";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { Box, Fab, Paper, Typography, styled } from "@mui/material";
import _ from "lodash";
import PermissionsDialog from "./components/PermissionsDialog";
import RolesTable from "./components/RolesTable";
import RolesDialog from "./components/RolesDialog";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import { RollTab1Addicon } from "./roleManagementStyles";

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => {
  return (
    <OverlayBox>
      <ErrorOutlineIcon fontSize="large" />
      <Typography variant="h5" fontSize="1.2rem">
        Data is not available
      </Typography>
    </OverlayBox>
  );
};

export default function RoleManagementTab1(props) {
  const screenActions = props?.permissions || {};
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const emptyForm = {
    roleId: "",
    roleName: "",
    description: "",
    roleAccess: null, // Initialized roleAccess
    roleStatus: "ACTIVE",
    permissions: [],
  };
  const [rows, setRows] = useState([]);
  const [form, setForm] = useState(emptyForm);
  const [initialForm, setInitialForm] = useState(emptyForm);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [permDialogOpen, setPermDialogOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [roleAccessList, setRoleAccessList] = useState([]); // New State

  // Fetch Roles Table Data
  const fetchRoles = useCallback(async () => {
    setIsLoading(true);
    setPermDialogOpen(false);
    setDialogOpen(false);
    try {
      const data = await callApi(
        "/UM/role/get-roles",
        { permissions: true },
        "GET",
      );

      const roles = data?.result?.roles ?? [];
      setRows(roles);
    } catch (e) {
      console.error(e);
      setRows([]);
      snackbar("Failed to fetch roles. Check API or network.", "error");
    } finally {
      setIsLoading(false);
    }
  }, [callApi, snackbar]);

  // Fetch Role Access Dropdown Data
  const fetchRoleAccessList = useCallback(async () => {
    try {
      const response = await callApi("/UM/role/get-role-access-list", {}, "GET");
      const list = response?.result ?? [];
      setRoleAccessList(list);
    } catch (error) {
      console.error("Failed to fetch role access list:", error);
      setRoleAccessList([]);
    }
  }, [callApi]);

  useEffect(() => {
    fetchRoles();
    fetchRoleAccessList(); // Trigger access list fetch on mount
  }, [fetchRoles, fetchRoleAccessList]);

  const handleEditRow = (row, isEdit) => {
    setForm({ ...row });
    setInitialForm({ ...row });
    isEdit ? setDialogOpen(true) : setPermDialogOpen(true);
  };

  const handleSavePermissionOrder = async (ordered, original) => {
    const isSameOrder = _.isEqual(original, ordered);

    if (isSameOrder) {
      snackbar("Kindly Change the order before saving it", "warning");
      return;
    }

    try {
      const payload = {
        selectedRole: form?.roleId,
        permissions: ordered,
      };
      const response = await callApi(
        "/UM/role/save-permission-order",
        payload,
        "PATCH",
      );
      snackbar(response?.message, "success");
    } catch (err) {
      console.error(err);
      snackbar("Error while processing request", "error");
    }
    fetchRoles();
  };

  return (
    <Box>
      <RolesTable
        rows={rows}
        isLoading={isLoading}
        onEditRow={(row, isEdit) => handleEditRow(row, isEdit)}
        screenActions={screenActions}
        roleAccessList={roleAccessList} // Pass to table component
      />

      <RolesDialog
        open={dialogOpen}
        form={form}
        setForm={setForm}
        fetchRoles={fetchRoles}
        initialForm={initialForm}
        screenActions={screenActions}
        onClose={() => setDialogOpen(false)}
        roles={rows}
        roleAccessList={roleAccessList} // Pass to dialog component
      />

      <PermissionsDialog
        open={permDialogOpen}
        handleSavePermissionOrder={(ordered, original) =>
          handleSavePermissionOrder(ordered, original)
        }
        onClose={() => {
          setPermDialogOpen(false);
        }}
        permissions={form?.permissions || []}
        roleName={form?.roleName || ""}
      />

      {screenActions.create && (
        <Fab
          color="primary"
          variant="extended"
          onClick={() => {
            setForm(emptyForm);
            setDialogOpen(true);
          }}
          sx={{
            position: "fixed",
            bottom: 15,
            right: 30,
            borderRadius: 1,
          }}
        >
          <RollTab1Addicon />
          Create Role
        </Fab>
      )}
    </Box>
  );
}
