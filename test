
import React, { useState, useEffect, useRef, useCallback } from "react";
import {
  Typography,
  Button,
  Box,
  InputBase,
  Stack,
  CircularProgress,
} from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import PersonIcon from "@mui/icons-material/Person";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  userId,
  otpData,
  onBackToHome,
  onSessionEstablished,
}) => {
  const showSnackbar = useCustomSnackbar();

  const inputRefs = useRef([]);
  const sessionCheckInterval = useRef(null);
  const lastActivityRef = useRef(Date.now());
  const sessionExpiredRef = useRef(false);

  const config = otpData?.otpConfig || {};

  const otpLength = Number(config.otpLength ?? 6);

  // Fixed 15-minute inactivity timeout
  const INACTIVITY_TIMEOUT_SECONDS = 15 * 60;

  const MAX_RESENDS = Number(
    config.maxResends ?? otpData?.resendsRemaining ?? 3
  );

  const INITIAL_RESENDS = Number(
    otpData?.resendsRemaining ?? MAX_RESENDS
  );

  const [otpValues, setOtpValues] = useState(() =>
    Array(otpLength).fill("")
  );

  const [transactionId, setTransactionId] = useState(
    otpData?.transactionId || ""
  );

  const [expiresIn, setExpiresIn] = useState(
    otpData?.expiresInSeconds ?? config.expirySeconds ?? 300
  );

  const [cooldown, setCooldown] = useState(
    otpData?.resendCooldownSeconds ??
      config.resendCooldownSeconds ??
      60
  );

  const [resendsLeft, setResendsLeft] = useState(INITIAL_RESENDS);

  const [sessionRemaining, setSessionRemaining] = useState(
    INACTIVITY_TIMEOUT_SECONDS
  );

  const [isLoading, setIsLoading] = useState(false);
  const [isLocked, setIsLocked] = useState(false);
  const [isOtpExpired, setIsOtpExpired] = useState(false);
  const [isSessionExpired, setIsSessionExpired] = useState(false);
  const [errorMessage, setErrorMessage] = useState("");

  const otp = otpValues.join("");
  const isOtpComplete = otp.length === otpLength;
  const isExpired = isOtpExpired || expiresIn <= 0;

  // Format seconds as MM:SS
  const formatTime = (seconds) => {
    const minutes = Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0");

    const remainingSeconds = (seconds % 60)
      .toString()
      .padStart(2, "0");

    return `${minutes}:${remainingSeconds}`;
  };

  // Focus first OTP field
  const focusFirstInput = useCallback(() => {
    requestAnimationFrame(() => {
      inputRefs.current[0]?.focus();
    });
  }, []);

  // Clear OTP fields
  const clearOtp = useCallback(() => {
    setOtpValues(Array(otpLength).fill(""));
  }, [otpLength]);

  // Automatically focus first field whenever OTP is cleared
  useEffect(() => {
    const isOtpCleared = otpValues.every(
      (value) => value === ""
    );

    if (
      isOtpCleared &&
      !isLocked &&
      !isExpired &&
      !isSessionExpired
    ) {
      focusFirstInput();
    }
  }, [
    otpValues,
    isLocked,
    isExpired,
    isSessionExpired,
    focusFirstInput,
  ]);

  // Handle actual session expiration
  const expireSession = useCallback((message) => {
    if (sessionExpiredRef.current) return;

    sessionExpiredRef.current = true;

    setErrorMessage(
      message ||
        "Your session has timed out. Please log in again."
    );

    setIsSessionExpired(true);
    setOtpValues(Array(otpLength).fill(""));
    setSessionRemaining(0);

    clearInterval(sessionCheckInterval.current);
  }, [otpLength]);

  // =========================================================
  // 15-MINUTE IDLE SESSION TIMEOUT
  // =========================================================
  useEffect(() => {
    const timeoutMilliseconds =
      INACTIVITY_TIMEOUT_SECONDS * 1000;

    lastActivityRef.current = Date.now();

    // Capture user activity
    const handleUserActivity = () => {
      if (sessionExpiredRef.current) return;

      const currentTime = Date.now();

      const inactiveTime =
        currentTime - lastActivityRef.current;

      // Do not reset an already expired session
      if (inactiveTime >= timeoutMilliseconds) {
        expireSession(
          "Your session has timed out due to inactivity. Please log in again."
        );
        return;
      }

      // Reset inactivity timer
      lastActivityRef.current = currentTime;
    };

    const activityEvents = [
      "mousemove",
      "pointermove",
      "mousedown",
      "click",
      "keydown",
      "touchstart",
      "touchmove",
      "scroll",
    ];

    activityEvents.forEach((event) => {
      window.addEventListener(event, handleUserActivity, {
        passive: true,
      });
    });

    // Continuously check inactivity every second
    sessionCheckInterval.current = setInterval(() => {
      if (sessionExpiredRef.current) return;

      const inactiveTime =
        Date.now() - lastActivityRef.current;

      const remainingSeconds = Math.max(
        0,
        Math.ceil(
          (timeoutMilliseconds - inactiveTime) / 1000
        )
      );

      setSessionRemaining(remainingSeconds);

      if (inactiveTime >= timeoutMilliseconds) {
        expireSession(
          "Your session has timed out due to inactivity. Please log in again."
        );
      }
    }, 1000);

    return () => {
      clearInterval(sessionCheckInterval.current);

      activityEvents.forEach((event) => {
        window.removeEventListener(
          event,
          handleUserActivity
        );
      });
    };
  }, [INACTIVITY_TIMEOUT_SECONDS, expireSession]);

  // =========================================================
  // OTP EXPIRY AND RESEND COOLDOWN
  // =========================================================
  useEffect(() => {
    const timer = setInterval(() => {
      if (sessionExpiredRef.current) return;

      setExpiresIn((prev) => {
        if (prev <= 1) {
          setIsOtpExpired(true);

          setErrorMessage(
            "The code is invalid or has expired. Please request a new code."
          );

          return 0;
        }

        return prev - 1;
      });

      setCooldown((prev) => Math.max(0, prev - 1));
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  // Initial focus
  useEffect(() => {
    focusFirstInput();
  }, [focusFirstInput]);

  // Update values from backend
  const updateOtpData = (data) => {
    if (!data) return;

    if (data.transactionId) {
      setTransactionId(data.transactionId);
    }

    if (data.expiresInSeconds !== undefined) {
      setExpiresIn(data.expiresInSeconds);
      setIsOtpExpired(data.expiresInSeconds <= 0);
    }

    if (data.resendCooldownSeconds !== undefined) {
      setCooldown(data.resendCooldownSeconds);
    }

    if (data.resendsRemaining !== undefined) {
      setResendsLeft(data.resendsRemaining);
    }
  };

  // Check whether backend has expired the complete session
  const handleBackendSessionError = (err) => {
    const data = err.response?.data?.data || {};
    const message = err.response?.data?.message || "";

    if (
      data.sessionExpired === true ||
      message.toLowerCase().includes("session has timed out") ||
      message.toLowerCase().includes("session timed out")
    ) {
      expireSession(message);
      return true;
    }

    return false;
  };

  // =========================================================
  // RESEND OTP
  // =========================================================
  const handleResendOTP = async () => {
    if (
      isLoading ||
      cooldown > 0 ||
      resendsLeft <= 0 ||
      isSessionExpired
    ) {
      return;
    }

    setIsLoading(true);
    setErrorMessage("");

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        { transactionId }
      );

      if (sessionExpiredRef.current) return;

      const data = response?.data?.data || {};

      const nextResendsLeft =
        data.resendsRemaining !== undefined
          ? Number(data.resendsRemaining)
          : Math.max(0, resendsLeft - 1);

      const resendCount =
        data.resendsUsed !== undefined
          ? Number(data.resendsUsed)
          : MAX_RESENDS - nextResendsLeft;

      updateOtpData(data);

      setResendsLeft(nextResendsLeft);

      setExpiresIn(
        data.expiresInSeconds ??
          config.expirySeconds ??
          300
      );

      setCooldown(
        data.resendCooldownSeconds ??
          config.resendCooldownSeconds ??
          60
      );

      setIsOtpExpired(false);
      setIsLocked(false);
      setErrorMessage("");

      // Clear fields and automatically focus first input
      clearOtp();

      // Preserve backend success message and append count
      const successMessage =
        response?.data?.message ||
        data.message ||
        "OTP sent successfully.";

      showSnackbar(
        `${successMessage} Resend attempts: ${resendCount}/${MAX_RESENDS}.`,
        "success"
      );
    } catch (err) {
      if (!handleBackendSessionError(err)) {
        const data = err.response?.data?.data || {};

        updateOtpData(data);

        if (data.otpExpired === true) {
          setIsOtpExpired(true);
        }

        setErrorMessage(
          err.response?.data?.message ||
            "Unable to resend OTP. Please try again."
        );
      }
    } finally {
      setIsLoading(false);
    }
  };

  // =========================================================
  // VERIFY OTP
  // =========================================================
  const handleVerifyOTP = async () => {
    if (
      isLoading ||
      !isOtpComplete ||
      isLocked ||
      isExpired ||
      isSessionExpired
    ) {
      return;
    }

    setIsLoading(true);
    setErrorMessage("");

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          transactionId,
          otp,
        }
      );

      if (sessionExpiredRef.current) return;

      const result = response?.data?.data || {};

      if (!result.payloadEncryptionKey) {
        result.payloadEncryptionKey =
          response.headers["x-payload-key"];
      }

      if (response?.data?.success) {
        clearInterval(sessionCheckInterval.current);

        onSessionEstablished?.(result);
      } else {
        setErrorMessage(
          response?.data?.message || ""
        );

        clearOtp();
      }
    } catch (err) {
      const status = err.response?.status;
      const message = err.response?.data?.message || "";
      const backendData = err.response?.data?.data || {};

      if (handleBackendSessionError(err)) {
        return;
      }

      if (status === 401) {
        if (
          message.toLowerCase().includes(
            "too many incorrect attempts"
          ) ||
          backendData.attemptsRemaining === 0
        ) {
          // Fifth failed attempt: remain on OTP screen
          // User can resend OTP when cooldown permits
          setIsLocked(true);
          setErrorMessage(message);

          clearOtp();
        } else if (
          backendData.otpExpired === true ||
          message.toLowerCase().includes(
            "invalid or has expired"
          )
        ) {
          setIsOtpExpired(true);
          setErrorMessage(message);

          clearOtp();
        } else {
          // Incorrect OTP
          setErrorMessage(message);

          clearOtp();
        }
      } else if (status === 400) {
        setErrorMessage(message);

        clearOtp();
      } else {
        setErrorMessage(
          message || "Verification request failed."
        );
      }
    } finally {
      setIsLoading(false);
    }
  };

  // =========================================================
  // OTP INPUT HANDLING
  // =========================================================
  const handleChange = (index, event) => {
    if (isSessionExpired || isLocked || isExpired) return;

    const digits = event.target.value.replace(/\D/g, "");

    if (!digits) {
      const updated = [...otpValues];
      updated[index] = "";
      setOtpValues(updated);
      return;
    }

    const updated = [...otpValues];

    digits.split("").forEach((digit, offset) => {
      if (index + offset < otpLength) {
        updated[index + offset] = digit;
      }
    });

    setOtpValues(updated);

    inputRefs.current[
      Math.min(index + digits.length, otpLength - 1)
    ]?.focus();
  };

  // Paste OTP
  const handlePaste = (event) => {
    event.preventDefault();

    if (isSessionExpired || isLocked || isExpired) return;

    const digits = event.clipboardData
      .getData("text")
      .replace(/\D/g, "")
      .slice(0, otpLength);

    if (!digits) return;

    const updated = Array(otpLength).fill("");

    digits.split("").forEach((digit, index) => {
      updated[index] = digit;
    });

    setOtpValues(updated);

    inputRefs.current[
      Math.min(digits.length, otpLength - 1)
    ]?.focus();
  };

  // Keyboard navigation
  const handleKeyDown = (index, event) => {
    if (event.key === "Backspace") {
      event.preventDefault();

      const updated = [...otpValues];

      if (updated[index]) {
        updated[index] = "";
      } else if (index > 0) {
        updated[index - 1] = "";
        inputRefs.current[index - 1]?.focus();
      }

      setOtpValues(updated);
    } else if (
      event.key === "ArrowLeft" &&
      index > 0
    ) {
      inputRefs.current[index - 1]?.focus();
    } else if (
      event.key === "ArrowRight" &&
      index < otpLength - 1
    ) {
      inputRefs.current[index + 1]?.focus();
    } else if (event.key === "Enter") {
      handleVerifyOTP();
    }
  };

  return (
    <Box sx={{ width: "100%", maxWidth: "420px", mx: "auto" }}>
      {/* SESSION EXPIRED SCREEN */}
      {isSessionExpired ? (
        <Box
          sx={{
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            textAlign: "center",
            py: 3,
            px: 1,
          }}
        >
          <WarningAmberIcon
            sx={{
              fontSize: 52,
              color: "error.main",
              mb: 1.5,
            }}
          />

          <Typography
            variant="h6"
            fontWeight={700}
            gutterBottom
          >
            Session Expired
          </Typography>

          <Typography
            variant="body2"
            color="error.main"
            sx={{
              mb: 3,
              maxWidth: 320,
              lineHeight: 1.6,
            }}
          >
            {errorMessage ||
              "Your session has timed out. Please log in again."}
          </Typography>

          <PrimaryButton
            fullWidth
            variant="contained"
            startIcon={<ArrowBackIcon />}
            onClick={onBackToHome}
            sx={{ py: 1.25 }}
          >
            Back to Sign In
          </PrimaryButton>
        </Box>
      ) : (
        <>
          {/* OTP INFORMATION */}
          <Box
            sx={{
              mb: 3,
              p: { xs: 1.5, sm: 2 },
              borderRadius: 2,
              bgcolor: "rgba(0,0,0,0.03)",
              border: "1px solid rgba(0,0,0,0.06)",
            }}
          >
            <Typography
              variant="body2"
              color="text.secondary"
              sx={{ mb: 1.5 }}
            >
              OTP sent to below registered contact details
            </Typography>

            <Stack spacing={0.75}>
              {userId && (
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.25,
                  }}
                >
                  <PersonIcon
                    sx={{
                      fontSize: 18,
                      color: "text.secondary",
                    }}
                  />

                  <Typography variant="subtitle2">
                    {userId}
                  </Typography>
                </Box>
              )}

              {otpData?.maskedMobile && (
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.25,
                  }}
                >
                  <PhoneAndroidIcon
                    sx={{
                      fontSize: 18,
                      color: "text.secondary",
                    }}
                  />

                  <Typography variant="subtitle2">
                    {otpData.maskedMobile?.toString()}
                  </Typography>
                </Box>
              )}

              {otpData?.maskedEmail && (
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.25,
                  }}
                >
                  <EmailIcon
                    sx={{
                      fontSize: 18,
                      color: "text.secondary",
                    }}
                  />

                  <Typography
                    variant="subtitle2"
                    sx={{ wordBreak: "break-all" }}
                  >
                    {otpData.maskedEmail?.toString()}
                  </Typography>
                </Box>
              )}
            </Stack>

            {/* TEMPORARY TIMER DIAGNOSTICS */}
            {/*
            <Box
              sx={{
                mt: 2,
                p: 1.5,
                borderRadius: 1.5,
                bgcolor: "rgba(25,118,210,0.06)",
              }}
            >
              <Typography
                variant="caption"
                display="block"
                sx={{ fontWeight: 600, mb: 0.5 }}
              >
                Temporary timer diagnostics
              </Typography>

              <Typography variant="caption" display="block">
                Session inactivity: {formatTime(sessionRemaining)}
              </Typography>

              <Typography variant="caption" display="block">
                OTP validity: {formatTime(expiresIn)}
              </Typography>

              <Typography variant="caption" display="block">
                Resend cooldown: {formatTime(cooldown)}
              </Typography>
            </Box>
            */}
          </Box>

          {/* OTP INPUTS */}
          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: `repeat(${otpLength}, 1fr)`,
              gap: { xs: 0.75, sm: 1.25 },
              mb: 2,
            }}
          >
            {otpValues.map((value, index) => (
              <Box
                key={index}
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  borderRadius: 2,
                  bgcolor: "background.paper",
                  border: "1.5px solid",
                  borderColor: value
                    ? "primary.main"
                    : "rgba(0,0,0,0.15)",
                  height: { xs: 48, sm: 54, md: 58 },
                  "&:focus-within": {
                    borderColor: "primary.main",
                    boxShadow:
                      "0 0 0 3px rgba(25,118,210,0.15)",
                  },
                }}
              >
                <InputBase
                  inputRef={(element) => {
                    inputRefs.current[index] = element;
                  }}
                  value={value}
                  onChange={(event) =>
                    handleChange(index, event)
                  }
                  onKeyDown={(event) =>
                    handleKeyDown(index, event)
                  }
                  onPaste={handlePaste}
                  disabled={
                    isLoading || isLocked || isExpired
                  }
                  inputProps={{
                    maxLength: otpLength,
                    inputMode: "numeric",
                    pattern: "[0-9]*",
                    style: {
                      textAlign: "center",
                      fontSize: "1.25rem",
                      fontWeight: 700,
                      padding: 0,
                      width: "100%",
                    },
                  }}
                />
              </Box>
            ))}
          </Box>

          {/* FIXED HEIGHT ERROR AREA */}
          <Box
            sx={{
              minHeight: 48,
              display: "flex",
              alignItems: "flex-start",
              justifyContent: "center",
              mb: 1,
            }}
          >
            {errorMessage && (
              <Typography
                variant="body2"
                color="error.main"
                sx={{
                  textAlign: "center",
                  width: "100%",
                }}
              >
                {errorMessage}
              </Typography>
            )}
          </Box>

          {/* VERIFY BUTTON */}
          <PrimaryButton
            fullWidth
            variant="contained"
            onClick={handleVerifyOTP}
            disabled={
              isLoading ||
              !isOtpComplete ||
              isLocked ||
              isExpired ||
              isSessionExpired
            }
            sx={{
              py: 1.25,
              fontSize: "0.95rem",
            }}
          >
            {isLoading ? (
              <CircularProgress
                size={22}
                color="inherit"
              />
            ) : (
              "Verify OTP & Sign In"
            )}
          </PrimaryButton>

          {/* NAVIGATION AND RESEND */}
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              mt: 2.5,
            }}
          >
            <Button
              startIcon={<ArrowBackIcon />}
              onClick={onBackToHome}
              size="small"
              sx={{
                textTransform: "none",
                color: "text.secondary",
                fontSize: {
                  xs: "0.75rem",
                  sm: "0.85rem",
                },
                p: 0.5,
              }}
            >
              Back To Sign In
            </Button>

            <Button
              onClick={handleResendOTP}
              disabled={
                isLoading ||
                cooldown > 0 ||
                resendsLeft <= 0 ||
                isSessionExpired
              }
              startIcon={
                isLoading ? (
                  <CircularProgress size={15} />
                ) : (
                  <RefreshIcon />
                )
              }
              size="small"
              sx={{
                fontWeight: 600,
                px: 1.5,
              }}
            >
              {cooldown > 0
                ? `Resend in ${cooldown}s`
                : "Resend OTP"}
            </Button>
          </Box>
        </>
      )}
    </Box>
  );
};

export default LoginWithOTP;
