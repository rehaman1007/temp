<Autocomplete
          sx={{
            gridColumn: { xs: "span 12", sm: "span 6", md: dynamicMdSpan },
          }}
          autoHighlight
          disabled={glccValidated || user?.roleAccess === "B"}
          value={branch}
          forcePopupIcon={false}
          clearIcon={branchInput ? undefined : null}
          options={branches || []}
          noOptionsText={
            req.branch ? "Please enter at least 3 characters" : "No Options"
          }
          inputValue={branchInput}
          loading={!req.branch && loading.branch}
          onClose={(e, reason) => {
            if (reason === "blur") {
              handleSearchChange(branchInput, "blur", "branch");
            }
          }}
          onInputChange={(e, value, reason) => {
            if (reason === "input" && !BRANCH_REGEX.test(value)) {
              showSnackBar(INVALID_BRANCH_MSG, "warning");
              return;
            }

            setBranchInput(value);
            handleSearchChange(value, reason, "branch");
          }}
          onChange={(e, value) => setBranch(value)}
          renderInput={(params) => (
            <TextField
              {...params}
              label="Branch Code or Name*"
              fullWidth
              InputLabelProps={{ shrink: true }}
              placeholder="eg. 12345 or ABC"
              slotProps={{
                htmlInput: {
                  ...params.inputProps,
                  maxLength: isNumeric(params.inputProps.value) ? 5 : 15,
                },
              }}
            />
          )}
        />
