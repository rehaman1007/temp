const getSuggestedTableName = (sql) => {
  if (!sql) return "export_table";

  const normalized = sql.replace(/\s+/g, " ").trim();

  // FROM table
  let match = normalized.match(
    /\bFROM\s+([A-Z0-9_$.]+)/i,
  );

  if (match?.[1]) {
    return match[1].split(".").pop().toLowerCase();
  }

  // INSERT INTO table
  match = normalized.match(
    /\bINSERT\s+INTO\s+([A-Z0-9_$.]+)/i,
  );

  if (match?.[1]) {
    return match[1].split(".").pop().toLowerCase();
  }

  // UPDATE table
  match = normalized.match(
    /\bUPDATE\s+([A-Z0-9_$.]+)/i,
  );

  if (match?.[1]) {
    return match[1].split(".").pop().toLowerCase();
  }

  return "export_table";
};


const tableName =
  variables.tableName?.trim() ||
  getSuggestedTableName(variables.sql);

const timestamp = new Date()
  .toISOString()
  .replace(/[:.]/g, "-");

const filename = `${tableName}_${timestamp}`;

