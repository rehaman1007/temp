@Override
public ResponseEntity<Resource>
exportData(
        AdminSupportDTO dto,
        String userId,
        HttpServletRequest request
) {

    String sql =
            dto.getSql().trim();

    long count =
            validateExportLimit(
                    sql
            );

    log.info("""
        ==================================
        EXPORT STARTED
        ==================================
        user={}
        type={}
        rows={}
        ==================================
        """,
            userId,
            dto.getExportType(),
            count
    );

    return switch (
            dto.getExportType()
                    .toUpperCase()
    ) {

        case "EXCEL" ->
                exportExcel(sql);

        case "JSON" ->
                exportJson(sql);

        case "INSERT" ->
                exportInsert(dto);

        default ->
                exportCsv(sql);
    };
}