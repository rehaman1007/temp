import React, {
  createContext,
  useEffect,
  useRef,
  useCallback,
  useState,
} from "react";
import { useDispatch, useSelector } from "react-redux";
import axios from "axios";
import SessionDialog from "../components/SessionDialog";
import SessionWarningDialog from "../components/SessionWarningDialog";
import { logout as reduxLogout } from "../store/slices/authSlice";

export const AuthContext = createContext();

const INACTIVITY_TIMEOUT = 5 * 60 * 1000;
const WARNING_TIME = 30 * 1000;

export const AuthProvider = ({ children }) => {
  const dispatch = useDispatch();
  const user = useSelector((state) => state.auth.user);

  const [sessionDialogOpen, setSessionDialogOpen] = useState(false);
  const [warningOpen, setWarningOpen] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(30);
  const [sessionReason, setSessionReason] = useState("");

  const inactivityTimerRef = useRef(null);
  const warningTimerRef = useRef(null);
  const countdownRef = useRef(null);
  const sessionEndedRef = useRef(false);

  /** -------------------- SINGLE LOGOUT ENTRY -------------------- */
  const endSession = useCallback(
    async (reason) => {
      if (sessionEndedRef.current) return;
      sessionEndedRef.current = true;

      clearTimeout(inactivityTimerRef.current);
      clearTimeout(warningTimerRef.current);
      clearInterval(countdownRef.current);

      setWarningOpen(false);

      // Show dialog only for forced logout
      if (reason !== "MANUAL_LOGOUT") {
        setSessionReason(reason);
        setSessionDialogOpen(true);
      }

      try {
        await axios.post("/auth/logout", {}, { withCredentials: true });
      } catch {
        /* ignore */
      }

      dispatch(reduxLogout());
      sessionStorage.clear();
      sessionStorage.setItem("LOGOUT_EVENT", Date.now());

      if (reason === "MANUAL_LOGOUT") {
        window.location.href = "/";
      }
    },
    [dispatch]
  );

  /** -------------------- INACTIVITY RESET -------------------- */
  const resetInactivityTimers = useCallback(() => {
    if (!user || sessionEndedRef.current) return;

    clearTimeout(inactivityTimerRef.current);
    clearTimeout(warningTimerRef.current);
    clearInterval(countdownRef.current);

    setWarningOpen(false);
    setSecondsLeft(30);

    warningTimerRef.current = setTimeout(() => {
      setWarningOpen(true);

      let counter = 30;
      setSecondsLeft(counter);

      countdownRef.current = setInterval(() => {
        counter -= 1;
        if (counter <= 0) {
          clearInterval(countdownRef.current);
          setSecondsLeft(0);
        } else {
          setSecondsLeft(counter);
        }
      }, 1000);
    }, INACTIVITY_TIMEOUT - WARNING_TIME);

    inactivityTimerRef.current = setTimeout(() => {
      endSession("SESSION_EXPIRED");
    }, INACTIVITY_TIMEOUT);
  }, [user, endSession]);

  /** -------------------- START ON LOGIN -------------------- */
  useEffect(() => {
    if (user) {
      sessionEndedRef.current = false;
      resetInactivityTimers();
    }
  }, [user, resetInactivityTimers]);

  /** -------------------- USER ACTIVITY -------------------- */
  useEffect(() => {
    if (!user) return;

    const handleActivity = () => resetInactivityTimers();
    const events = ["mousemove", "keydown", "click", "scroll", "touchstart"];

    events.forEach((e) => window.addEventListener(e, handleActivity));
    return () =>
      events.forEach((e) =>
        window.removeEventListener(e, handleActivity)
      );
  }, [user, resetInactivityTimers]);

  /** -------------------- MULTI TAB LOGOUT -------------------- */
  useEffect(() => {
    const handleStorage = (e) => {
      if (e.key === "LOGOUT_EVENT") {
        endSession("SESSION_EXPIRED");
      }
    };

    window.addEventListener("storage", handleStorage);
    return () => window.removeEventListener("storage", handleStorage);
  }, [endSession]);

  return (
    <AuthContext.Provider
      value={{
        logout: () => endSession("MANUAL_LOGOUT"),
        triggerSessionDialog: endSession,
      }}
    >
      {children}

      <SessionWarningDialog
        open={warningOpen}
        secondsLeft={secondsLeft}
        onContinue={resetInactivityTimers}
      />

      <SessionDialog
        open={sessionDialogOpen}
        reason={sessionReason}
        onConfirm={() => (window.location.href = "/")}
      />
    </AuthContext.Provider>
  );
};

import { useContext } from "react";
import { AuthContext } from "../context/AuthContext";

const ProfileDrawer = () => {
  const { logout } = useContext(AuthContext);

  return (
    <Button color="error" onClick={logout}>
      Sign Out
    </Button>
  );
};