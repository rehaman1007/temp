private void insertExecutionLog(
        String jobId,
        String userId,
        String clientIp,
        String fileName,
        String executionType,
        String status,
        int totalStatements,
        int executedCount,
        int insertCount,
        int updateCount,
        int deleteCount,
        int otherCount,
        Integer failedStatementNumber,
        String failedSql,
        String exceptionType,
        String exceptionMessage,
        double executionSpeed,
        long elapsedSeconds,
        String sqlText
) {

    try {

        jdbcTemplate.update("""
            INSERT INTO ADMIN_SUPPORT_LOG
            (
                JOB_ID,
                USER_ID,
                CLIENT_IP,
                FILE_NAME,
                EXECUTION_TYPE,
                STATUS,
                TOTAL_STATEMENTS,
                EXECUTED_COUNT,
                INSERT_COUNT,
                UPDATE_COUNT,
                DELETE_COUNT,
                OTHER_COUNT,
                FAILED_STATEMENT_NUMBER,
                FAILED_SQL,
                EXCEPTION_TYPE,
                EXCEPTION_MESSAGE,
                EXECUTION_SPEED,
                ELAPSED_SECONDS,
                SQL_TEXT,
                STARTED_AT,
                CREATED_AT
            )
            VALUES
            (
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                SYSTIMESTAMP,
                SYSTIMESTAMP
            )
        """,

        jobId,
        userId,
        clientIp,
        fileName,
        executionType,
        status,
        totalStatements,
        executedCount,
        insertCount,
        updateCount,
        deleteCount,
        otherCount,
        failedStatementNumber,
        failedSql,
        exceptionType,
        exceptionMessage,
        executionSpeed,
        elapsedSeconds,
        sqlText
        );

    } catch (Exception e) {

        log.error("FAILED TO INSERT LOG", e);
    }
}