const allowedYear = nextFYInfo?.expectedStart?.year();
const [selectedYear, setSelectedYear] = useState(null);
const [yearError, setYearError] = useState("");

<LocalizationProvider dateAdapter={AdapterDayjs}>
  <DatePicker
    views={["year"]}
    label="Financial Year*"
    value={selectedYear ? dayjs(`${selectedYear}-01-01`) : null}
    minDate={dayjs("2025-01-01")}
    maxDate={nextFYInfo?.expectedStart?.endOf("year")}
    disabled={!nextFYInfo?.expectedStart}

    shouldDisableYear={(year) =>
      allowedYear ? year.year() !== allowedYear : true
    }

    onChange={(val) => {
      if (!val || !val.isValid()) return;

      const enteredYear = val.year();

      if (enteredYear !== allowedYear) {
        setYearError(
          `Only Financial Year ${allowedYear}-${allowedYear + 1} is allowed`
        );
        return;
      }

      setYearError("");
      setSelectedYear(enteredYear);
    }}

    onError={(reason) => {
      if (reason) {
        setYearError("Invalid year format. Use YYYY.");
      }
    }}

    sx={{ mt: 1 }}

    slotProps={{
      textField: {
        size: "small",
        fullWidth: true,
        error: Boolean(yearError),
        helperText: yearError
          ? yearError
          : selectedYear
          ? `Selected Financial Year : ${selectedYear} – ${
              selectedYear + 1
            } (April to March)`
          : allowedYear
          ? `Requests are permitted only for Financial Year ${allowedYear}-${
              allowedYear + 1
            }.`
          : "",

        inputProps: {
          maxLength: 4,
          inputMode: "numeric",
          pattern: "[0-9]{4}",
        },

        FormHelperTextProps: {
          sx: {
            mt: 1,
            fontSize: "0.9rem",
            fontWeight: 500,
            color: yearError ? "#d32f2f" : "#6500caff",
          },
        },
      },
    }}
  />
</LocalizationProvider>