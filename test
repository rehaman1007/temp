import React from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
  Paper,
  useTheme,
} from "@mui/material";
import { timeStampFormatter } from "../../utils/CommonUtilities";

// Format keys like "segmentCode" → "Segment Code"
const formatKeyForDisplay = (key) => {
  const result = key.replace(/([A-Z])/g, " $1").trim();
  return result.charAt(0).toUpperCase() + result.slice(1);
};

const ViewRequestDialog = ({ open, handleClose, data }) => {
  const theme = useTheme();

  if (!data || !data.payload) return null;

  const { payload } = data;

  const mainDetails = [
    { label: "Request Type", value: data.changeType },
    { label: "Status", value: data.reqStatus },
    { label: "Requested Date", value: timeStampFormatter(data.reqDate) },
    { label: "Creator ID", value: data.creatorId },
  ];

  return (
    <Dialog
      open={open}
      onClose={handleClose}
      maxWidth="md"
      fullWidth
      PaperProps={{
        sx: {
          borderRadius: 3,
          boxShadow: 10,
          overflow: "hidden",
        },
      }}
    >
      {/* Header */}
      <DialogTitle
        sx={{
          backgroundColor: theme.palette.primary.main,
          color: theme.palette.primary.contrastText,
          fontWeight: 600,
          fontSize: "1.2rem",
          py: 1.5,
        }}
      >
        Request Details — <b>ID: {data.id}</b>
      </DialogTitle>

      {/* Content */}
      <DialogContent sx={{ backgroundColor: "#fafafa", p: 3 }}>
        {/* Main Details Section */}
        <Paper
          variant="outlined"
          sx={{
            p: 2.5,
            mb: 3,
            borderRadius: 2,
            backgroundColor: "#fff",
          }}
        >
          <Typography
            variant="h6"
            sx={{ mb: 2, fontWeight: 600, color: theme.palette.primary.dark }}
          >
            Main Details
          </Typography>

          <Grid container spacing={2}>
            {mainDetails.map((item) => (
              <Grid item xs={12} sm={6} key={item.label}>
                <Box sx={{ display: "flex", flexDirection: "column" }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 600, color: "text.secondary" }}
                  >
                    {item.label}
                  </Typography>
                  <Typography variant="body1" sx={{ color: "text.primary" }}>
                    {item.value || "N/A"}
                  </Typography>
                </Box>
              </Grid>
            ))}
          </Grid>
        </Paper>

        {/* Payload Section */}
        <Paper
          variant="outlined"
          sx={{
            p: 2.5,
            borderRadius: 2,
            backgroundColor: "#fff",
          }}
        >
          <Typography
            variant="h6"
            sx={{ mb: 2, fontWeight: 600, color: theme.palette.primary.dark }}
          >
            Payload Data
          </Typography>

          <Grid container spacing={2}>
            {Object.entries(payload).map(([key, value]) => (
              <Grid item xs={12} sm={6} key={key}>
                <Box sx={{ display: "flex", flexDirection: "column" }}>
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: 600,
                      color: "text.secondary",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                    }}
                  >
                    {formatKeyForDisplay(key)}
                  </Typography>
                  <Typography
                    variant="body1"
                    sx={{
                      color: "text.primary",
                      wordBreak: "break-word",
                    }}
                  >
                    {value === null || value === undefined ? "N/A" : String(value)}
                  </Typography>
                </Box>
              </Grid>
            ))}
          </Grid>
        </Paper>
      </DialogContent>

      {/* Footer */}
      <Divider />
      <DialogActions sx={{ p: 2, justifyContent: "flex-end" }}>
        <Button
          onClick={handleClose}
          variant="contained"
          color="primary"
          sx={{ textTransform: "none", borderRadius: 2, px: 3 }}
        >
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ViewRequestDialog;