import React, { useState, useEffect, useRef } from 'react';
import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Box,
  Typography,
} from '@mui/material';
import { tableCellClasses } from '@mui/material/TableCell';
import { styled } from '@mui/material/styles';
import { Edit, Delete, Save, Cancel } from '@mui/icons-material';
import useCustomSnackbar from '../../../../../common/hooks/useCustomSnackbar';
import useApi from '../../../../../common/hooks/useApi';
import FormInput from '../../../../../common/components/ui/FormInput';
import { CustomButton } from '../../../../../common/components/ui/Buttons';

// Styled Cells
const StyledTableCell = styled(TableCell)(({ theme }) => ({
  fontSize: '1rem',
  [`&.${tableCellClasses.head}`]: {
    backgroundColor: 'hsl(220, 20%, 35%)',
    color: theme.palette.common.white,
  },
}));

const StyledTableRow = styled(TableRow)(({ error }) => ({
  ...(error && { backgroundColor: '#fdd' }),
}));

const DICGCSection3 = ({ reportSts, reportID, input5t = 0, setSec3TotalDifference }) => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const toValue = (val) => parseFloat(val) || 0;
  const user = JSON.parse(localStorage.getItem('user') || '{}');
  const { circleCode, quarterEndDate } = user;

  const [rows, setRows] = useState([]);
  const [prevValues, setPrevValues] = useState({});
  const inputRefs = useRef({});
  const [totalDifference, setTotalDifference] = useState(0);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    const payload = { circleCode, quarterEndDate, reportID, reportSts };
    try {
      const responseData = await callApi('/dicgcReport/getSec3Val', payload, 'POST');
      if (responseData) {
        const formatted = responseData.map((row) => ({
          text: row.text,
          amt1: row.amt1,
          amt2: row.amt2,
          totalAmt: row.totalAmt,
          remark: row.remark,
          flag: row.flag,
          srno: row.srno,
          isEdit: false,
          difference: row.amt1 - row.amt2,
        }));
        setRows(formatted || []);
        const total = formatted.reduce((sum, r) => sum + toValue(r.difference), 0);
        setTotalDifference(total);
        setSec3TotalDifference(total);
      } else {
        showSnackBar('Error while fetching data', 'error');
      }
    } catch (error) {
      if (error.code === 'ERR_CANCELED') return;
      console.error('Error fetching report data:', error.message);
    }
  };

  const handleAddRow = () => {
    if (rows.some((r) => r.isEdit)) {
      showSnackBar('Please save or cancel the current row before adding a new one.', 'warning');
      return;
    }
    const newRow = {
      text: '',
      amt1: '',
      amt2: '',
      totalAmt: 0,
      remark: '',
      srno: '0',
      flag: '',
      isEdit: true,
    };
    setRows((prev) => [...prev, newRow]);
    setTimeout(() => inputRefs.current[0]?.focus(), 100);
  };

  const handleChange = (rowId, field, value) => {
    setRows((prev) => {
      const updatedRows = prev.map((row) => {
        if (row.srno === rowId) {
          const updatedRow = { ...row, [field]: value };
          const amt1 = toValue(field === 'amt1' ? value : row.amt1);
          const amt2 = toValue(field === 'amt2' ? value : row.amt2);
          updatedRow.totalAmt = toValue(amt1 - amt2);
          return updatedRow;
        }
        return row;
      });
      const total = updatedRows.reduce((sum, r) => sum + toValue(r.totalAmt), 0);
      setTotalDifference(total);
      setSec3TotalDifference(total);
      return updatedRows;
    });
  };

  const validateFields = (row) => {
    if (!row.text?.trim()) return showSnackBar('Particulars cannot be empty.', 'warning');
    if (!row.amt1?.trim()) return showSnackBar('Amount Reported cannot be empty.', 'warning');
    if (!row.amt2?.trim()) return showSnackBar('Adjusted QSA Figures cannot be empty.', 'warning');
    if (!row.remark?.trim()) return showSnackBar('Reasons cannot be empty.', 'warning');
    return true;
  };

  const handleUpdate = async (rowId) => {
    const row = rows.find((r) => r.srno === rowId);
    if (!validateFields(row)) return;
    const payload = {
      circleCode,
      srno: rowId,
      qed: quarterEndDate,
      dataFlag: rowId === '0' ? 'I' : 'U',
      difference: row.totalAmt,
      Amt1: row.amt1,
      Amt2: row.amt2,
      remark: row.remark,
      particular: row.text,
      isEdit: true,
    };

    try {
      const response = await callApi('/dicgcReport/saveRowNew', payload, 'POST');
      if (response.result) {
        let id = response.action === 'insert' ? response.id : rowId;
        setRows((prev) => prev.map((r) => (r.srno === rowId ? { ...r, srno: id, isEdit: false } : r)));
        showSnackBar('Data Saved Successfully.', 'success');
      } else showSnackBar('Error while saving data.', 'error');
    } catch {
      showSnackBar('Error while saving data, Kindly try again', 'error');
    }
  };

  const handleDelete = async (rowId) => {
    const row = rows.find((r) => r.srno === rowId);
    if (!row) return;
    if (rowId === 0) {
      setRows((prev) => prev.filter((r) => r.srno !== rowId));
      showSnackBar('New row discarded.', 'info');
      return;
    }
    const payload = { rowId, circleCode, qed: quarterEndDate };
    try {
      const response = await callApi('/dicgcReport/deleteRow', payload, 'POST');
      if (response === true) {
        const updatedRows = rows.filter((r) => r.srno !== rowId);
        setRows(updatedRows);
        const total = updatedRows.reduce((sum, r) => sum + (toValue(r.totalAmt) || 0), 0);
        setTotalDifference(total);
        setSec3TotalDifference(total);
        showSnackBar('Data deleted successfully.', 'success');
      } else showSnackBar('Failed to delete data.', 'error');
    } catch {
      showSnackBar('Error while deleting data.', 'error');
    }
  };

  // Color logic for total difference field
  const diffColor =
    totalDifference === 0 || totalDifference === null ? 'green' : 'orangered';

  return (
    <Box p={2}>
      <CustomButton buttonType={'create'} label={'Add Row'} sx={{ mb: 2 }} onClickHandler={handleAddRow} />

      <TableContainer component={Paper}>
        <Table>
          <TableHead>
            <StyledTableRow>
              <StyledTableCell align="center"><strong>Particulars</strong></StyledTableCell>
              <StyledTableCell align="center"><strong>Amount Reported for DI&CGC Premium Payable</strong></StyledTableCell>
              <StyledTableCell align="center"><strong>Adjusted QSA Figures for DI&CGC</strong></StyledTableCell>
              <StyledTableCell align="center"><strong>Difference</strong></StyledTableCell>
              <StyledTableCell align="center"><strong>Reasons</strong></StyledTableCell>
              <StyledTableCell align="center"><strong>Actions</strong></StyledTableCell>
            </StyledTableRow>
          </TableHead>

          <TableBody>
            {rows.length > 0 ? (
              rows.map((row) => (
                <StyledTableRow key={row.srno}>
                  <StyledTableCell>
                    <FormInput
                      name={'text'}
                      value={row.text}
                      onChange={(e) => handleChange(row.srno, 'text', e.target.value)}
                      readOnly={!row.isEdit}
                    />
                  </StyledTableCell>
                  <StyledTableCell>
                    <FormInput
                      name={'amt1'}
                      value={row.amt1}
                      onChange={(e) => handleChange(row.srno, 'amt1', e.target.value)}
                      readOnly={!row.isEdit}
                    />
                  </StyledTableCell>
                  <StyledTableCell>
                    <FormInput
                      name={'amt2'}
                      value={row.amt2}
                      onChange={(e) => handleChange(row.srno, 'amt2', e.target.value)}
                      readOnly={!row.isEdit}
                    />
                  </StyledTableCell>
                  <StyledTableCell>
                    <FormInput name={'totalAmt'} value={row.totalAmt} readOnly={true} />
                  </StyledTableCell>
                  <StyledTableCell>
                    <FormInput
                      name={'remark'}
                      value={row.remark}
                      onChange={(e) => handleChange(row.srno, 'remark', e.target.value)}
                      readOnly={!row.isEdit}
                    />
                  </StyledTableCell>
                  <StyledTableCell align="center">
                    {row.isEdit ? (
                      <>
                        <IconButton color="success" onClick={() => handleUpdate(row.srno)}><Save /></IconButton>
                        <IconButton color="error" onClick={() => handleDelete(row.srno)}><Delete /></IconButton>
                        <IconButton color="warning" onClick={() => handleCancel(row.srno)}><Cancel /></IconButton>
                      </>
                    ) : (
                      <IconButton color="primary" onClick={() => handleEdit(row.srno)}><Edit /></IconButton>
                    )}
                  </StyledTableCell>
                </StyledTableRow>
              ))
            ) : (
              <StyledTableRow>
                <StyledTableCell colSpan={6} align="center">
                  No data available
                </StyledTableCell>
              </StyledTableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ✅ Total Difference always visible below the table */}
      <Box mt={3} textAlign="right">
        <Typography variant="h6" sx={{ fontWeight: 'bold', color: diffColor }}>
          Total Difference: {totalDifference ?? 0}
        </Typography>
      </Box>
    </Box>
  );
};

export default DICGCSection3;