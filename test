private LedgerEnquiryResponse mapEntityToDto(
        GlTransactions entity
) {

    return new LedgerEnquiryResponse(

            entity.getTransactionId(),
            entity.getBatchId(),
            entity.getJournalId(),
            entity.getTransactionDate(),
            entity.getPostDate(),
            entity.getBranchCode(),
            entity.getBranchName(),
            entity.getCircleCode(),
            entity.getCircleName(),
            entity.getCurrency(),
            entity.getCurrencyName(),
            entity.getCgl(),
            entity.getDescription(),
            entity.getNarration(),
            entity.getDebitAmount(),
            entity.getCreditAmount(),
            entity.getTransactionCount(),
            entity.getSourceFlag()
    );
}

