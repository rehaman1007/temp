/*==========================================================
  UPDATE TEMPLATES
==========================================================*/

-- Mark Run Completed
UPDATE FINCORE.PROCESS_RUN
SET STATUS = 2,
    END_TIME = SYSTIMESTAMP
WHERE PROCESS_RUN_ID = :process_run_id;

-- Mark Run Failed
UPDATE FINCORE.PROCESS_RUN
SET STATUS = 3,
    END_TIME = SYSTIMESTAMP
WHERE PROCESS_RUN_ID = :process_run_id;

-- Update Stage Status
UPDATE FINCORE.PROCESS_RUN_STAGE
SET STATUS = 2,
    REMARKS = 'Completed successfully'
WHERE PROCESS_RUN_STAGE_ID = :run_stage_id;

/*==========================================================
  SELECT QUERIES
==========================================================*/

-- Timeline For One Run
SELECT
  prs.PROCESS_RUN_STAGE_ID,
  prs.STAGE_ID,
  prs.STATUS,
  prs.EVENT_TIME,
  prs.SOURCE,
  prs.REMARKS
FROM FINCORE.PROCESS_RUN_STAGE prs
WHERE prs.PROCESS_RUN_ID = :process_run_id
ORDER BY prs.EVENT_TIME;

-- Latest Run Per Process
SELECT *
FROM (
  SELECT pr.*,
         ROW_NUMBER() OVER
           (PARTITION BY PROCESS_ID ORDER BY PROCESS_RUN_ID DESC) rn
  FROM FINCORE.PROCESS_RUN pr
)
WHERE rn = 1;

-- Dashboard Summary
SELECT
  pm.PROCESS_NAME,
  SUM(CASE WHEN pr.STATUS = 1 THEN 1 ELSE 0 END) RUNNING,
  SUM(CASE WHEN pr.STATUS = 2 THEN 1 ELSE 0 END) SUCCESS,
  SUM(CASE WHEN pr.STATUS = 3 THEN 1 ELSE 0 END) FAILED
FROM FINCORE.PROCESS_RUN pr
JOIN FINCORE.PROCESS_MASTER pm
 ON pm.PROCESS_ID = pr.PROCESS_ID
GROUP BY pm.PROCESS_NAME;

COMMIT;

COMMENT ON TABLE FINCORE.PROCESS_RUN
IS 'Stores one execution instance of a business process';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.PROCESS_RUN_ID
IS 'Primary key. Unique identifier for each process execution';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.PROCESS_ID
IS 'Foreign key referencing PROCESS_MASTER.PROCESS_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.ETL_DATE
IS 'Business date for which the process is executed';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.RUN_ID
IS 'Run sequence number for a process on a given ETL_DATE';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.STATUS
IS '0 = Not Started, 1 = Running, 2 = Success, 3 = Failed';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.START_TIME
IS 'Timestamp when the process execution started';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.END_TIME
IS 'Timestamp when the process execution ended';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.TRIGGERED_BY
IS 'User or system which triggered the process';

COMMENT ON COLUMN FINCORE.PROCESS_RUN.AIRFLOW_RUN_ID
IS 'Execution id generated by Airflow for this run';

COMMENT ON TABLE FINCORE.PROCESS_RUN_STAGE
IS 'Stores stage-level execution events for a process run';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.PROCESS_RUN_STAGE_ID
IS 'Primary key. Unique identifier for each stage event';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.PROCESS_RUN_ID
IS 'Foreign key referencing PROCESS_RUN.PROCESS_RUN_ID';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.STAGE_ID
IS 'Stage identifier from PROCESS_STAGE_MASTER';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.PARENT_STAGE_ID
IS 'Optional parent stage id for hierarchical stages';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.STATUS
IS '0 = Not Started, 1 = Running, 2 = Success, 3 = Failed';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.EVENT_TIME
IS 'Timestamp when this stage event occurred';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.SOURCE
IS 'Source of event (SYSTEM, AIRFLOW, USER)';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.REMARKS
IS 'Remarks or error message for the stage';

COMMENT ON COLUMN FINCORE.PROCESS_RUN_STAGE.SUMMARY
IS 'Large text or JSON summary related to this stage';