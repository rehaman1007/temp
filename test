import React, { useEffect, useState, useCallback, useMemo, useRef } from "react";
import { Box, Fab, IconButton, Tooltip, Typography } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import AddIcon from "@mui/icons-material/Add";
import EditIcon from "@mui/icons-material/Edit";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import styled from "@emotion/styled";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import BranchFormDialog from "./BranchFormDialog";
import { FabStyle, ChipStyle, Box1Style, StackStyle } from "./BranchMasterStyle";
import { getIconComponent } from "../../utils/IconUtils";

/* ================= NO ROWS OVERLAY ================= */

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" />
    <Typography fontSize="1.1rem">Data is not available</Typography>
  </OverlayBox>
);

/* ================= COMPONENT ================= */

export default function BranchMasterTab() {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [rows, setRows] = useState([]);
  const [rowCount, setRowCount] = useState(0);
  const [loading, setLoading] = useState(false);

  const [openDialog, setOpenDialog] = useState(false);
  const [editRow, setEditRow] = useState(null);

  /* ===== SERVER GRID STATE ===== */

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 20,
  });
  const [sortModel, setSortModel] = useState([]);
  const [filterModel, setFilterModel] = useState({ items: [] });

  /* ===== DUPLICATE CALL PREVENTION ===== */

  const lastQueryRef = useRef("");
  const lastFilterRef = useRef("");

  const ActiveIcon = useMemo(() => getIconComponent("FiberManualRecord"), []);
  const InActiveIcon = useMemo(() => getIconComponent("FiberManualRecord"), []);

  /* ================= FETCH ================= */

  const fetchBranches = useCallback(async () => {
    const sortField = sortModel[0]?.field;
    const sortOrder = sortModel[0]?.sort;

    const filters = filterModel.items
      .filter(
        (f) =>
          f.operator &&
          f.value !== undefined &&
          f.value !== null &&
          f.value !== ""
      )
      .map((f) => ({
        field: f.field,
        operator: f.operator,
        value: f.value,
      }));

    const querySignature = JSON.stringify({
      page: paginationModel.page,
      size: paginationModel.pageSize,
      sortField,
      sortOrder,
      filters,
    });

    if (lastQueryRef.current === querySignature) return;
    lastQueryRef.current = querySignature;

    try {
      setLoading(true);

      const payload = {
        page: paginationModel.page,
        size: paginationModel.pageSize,
        sortField,
        sortOrder,
        filters,
      };

      const resp = await callApi("/CM/branchesNewAPI", payload, "POST");

      setRows(resp?.data?.data || []);
      setRowCount(resp?.data?.totalElements || 0);
    } catch (err) {
      snackbar(err?.message || "Failed to load branches", "error");
      setRows([]);
      setRowCount(0);
    } finally {
      setLoading(false);
    }
  }, [callApi, snackbar, paginationModel, sortModel, filterModel]);

  /* ================= EFFECTS ================= */

  useEffect(() => {
    fetchBranches();
  }, [fetchBranches]);

  useEffect(() => {
    const current = JSON.stringify(filterModel.items || []);
    if (current === lastFilterRef.current) return;

    lastFilterRef.current = current;
    setPaginationModel((p) => (p.page === 0 ? p : { ...p, page: 0 }));
  }, [filterModel]);

  /* ================= ACTIONS ================= */

  const handleOpenCreate = () => {
    setEditRow(null);
    setOpenDialog(true);
  };

  const handleOpenEdit = (row) => {
    setEditRow(row);
    setOpenDialog(true);
  };

  const handleSaved = () => {
    setOpenDialog(false);
    setEditRow(null);
    lastQueryRef.current = "";
    fetchBranches();
  };

  /* ================= COLUMNS ================= */

  const columns = useMemo(
    () => [
      { field: "code", headerName: "Branch Code", flex: 1 },
      { field: "name", headerName: "Branch Name", flex: 2 },
      { field: "circleCode", headerName: "Circle Code", flex: 1 },
      {
        field: "status",
        headerName: "Status",
        flex: 1,
        type: "singleSelect",
        valueOptions: [
          { value: true, label: "Active" },
          { value: false, label: "In-Active" },
        ],
        align: "center",
        headerAlign: "center",
        renderCell: ({ row }) => (
          <Box1Style>
            <ChipStyle
              size="small"
              icon={row.status ? <ActiveIcon /> : <InActiveIcon />}
              label={row.status ? "Active" : "In-Active"}
            />
          </Box1Style>
        ),
      },
      {
        field: "actions",
        headerName: "Actions",
        flex: 0.6,
        sortable: false,
        filterable: false,
        align: "center",
        headerAlign: "center",
        renderCell: ({ row }) => (
          <Tooltip title="Edit">
            <IconButton onClick={() => handleOpenEdit(row)}>
              <EditIcon />
            </IconButton>
          </Tooltip>
        ),
      },
    ],
    [ActiveIcon, InActiveIcon]
  );

  /* ================= RENDER ================= */

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={columns}
        getRowId={(row) => row.code}
        loading={loading}
        paginationMode="server"
        sortingMode="server"
        filterMode="server"
        rowCount={rowCount}
        paginationModel={paginationModel}
        onPaginationModelChange={setPaginationModel}
        sortModel={sortModel}
        onSortModelChange={setSortModel}
        filterModel={filterModel}
        onFilterModelChange={setFilterModel}
        pageSizeOptions={[10, 20, 50, 100]}
        disableRowSelectionOnClick
        slots={{ noRowsOverlay: CustomNoRowsOverlay }}
      />

      <FabStyle onClick={handleOpenCreate} variant="extended">
        <AddIcon sx={{ mr: 1 }} />
        Create
      </FabStyle>

      <BranchFormDialog
        open={openDialog}
        onClose={() => setOpenDialog(false)}
        editingRow={editRow}
        onSuccess={handleSaved}
      />
    </Box>
  );
}

import {
  Dialog,
  DialogActions,
  DialogContent,
  Button,
} from "@mui/material";
import { Add, Edit } from "@mui/icons-material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import { useEffect, useRef, useState } from "react";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { DialogTitleStyle } from "./BranchMasterStyle";

/* ================= INITIAL FORM ================= */

const emailDomain = "@sbi.co.in";

const getInitialForm = () => ({
  code: "",
  name: "",
  circleCode: "",
  state: "",
  city: "",
  address: "",
  pinCode: "",
  phoneNumber: "",
  emailId: emailDomain,
  nmrCode: "",
  status: "Active",
  openDate: dayjs(),
  closeDate: null,
  mergeDate: null,
  mergedWithBranch: "",
  cpcFlag: false,
  foodCreditFlag: false,
  currChestFlag: false,
  branchType: "A",
});

/* ================= COMPONENT ================= */

export default function BranchFormDialog({
  open,
  onClose,
  editingRow,
  onSuccess,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const [form, setForm] = useState(getInitialForm());
  const originalRef = useRef(null);

  /* ===== LOAD EDIT DATA ===== */

  useEffect(() => {
    if (editingRow) {
      const mapped = {
        ...editingRow,
        status: editingRow.status ? "Active" : "InActive",
      };
      setForm(mapped);
      originalRef.current = mapped;
    } else {
      setForm(getInitialForm());
      originalRef.current = null;
    }
  }, [editingRow]);

  /* ===== AUTO BRANCH TYPE RULE ===== */

  useEffect(() => {
    const isManual =
      form.status !== "Active" ||
      form.closeDate ||
      form.mergeDate ||
      form.mergedWithBranch;

    setForm((p) => ({ ...p, branchType: isManual ? "M" : "A" }));
  }, [form.status, form.closeDate, form.mergeDate, form.mergedWithBranch]);

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (
      editingRow &&
      JSON.stringify(form) === JSON.stringify(originalRef.current)
    ) {
      snackbar("No changes detected", "warning");
      return;
    }

    try {
      const payload = {
        requestType: "BRANCH",
        changeType: editingRow ? "UPDATE" : "ADD",
        targetId: form.code,
        payload: {
          ...form,
          status: form.status === "Active",
          openDate: dayjs(form.openDate).format("DD/MM/YYYY"),
          closeDate: form.closeDate
            ? dayjs(form.closeDate).format("DD/MM/YYYY")
            : null,
          mergeDate: form.mergeDate
            ? dayjs(form.mergeDate).format("DD/MM/YYYY")
            : null,
        },
      };

      await callApi("/CR/create-request", payload, "POST");
      snackbar(editingRow ? "Branch updated" : "Branch created", "success");
      onClose();
      onSuccess();
    } catch (err) {
      snackbar("Request failed", "error");
    }
  };

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Dialog
        open={open}
        onClose={onClose}
        maxWidth="md"
        fullWidth
        component="form"
        onSubmit={handleSubmit}
      >
        <DialogTitleStyle>
          {editingRow ? "Edit Branch" : "Add Branch"}
        </DialogTitleStyle>

        <DialogContent dividers>
          {/* 👉 Paste your FULL existing form JSX here unchanged */}
        </DialogContent>

        <DialogActions>
          <Button
            type="submit"
            variant="contained"
            startIcon={editingRow ? <Edit /> : <Add />}
          >
            {editingRow ? "Update" : "Add"}
          </Button>
        </DialogActions>
      </Dialog>
    </LocalizationProvider>
  );
}