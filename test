import React from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
} from "@mui/material";

import {
  timeStampFormatter,
  toPascalKebabCase,
  formatKeyForDisplay,
} from "../../utils/CommonUtilities";

import { ViewCommonDynamicTable } from "./ViewCommonDynamicTable";

const ViewRequestDialog = ({
  open,
  handleClose,
  data,
  screenConfig,
  handleDownload,
}) => {
  if (!data || !data.payload) return null;
  const { payload } = data;
  const tableColumns = screenConfig?.columns || [];
  const mainDetails = [
    { label: "Creator ID", value: data.creatorId, size: 2 },
    {
      label: "Request Type",
      value: data.changeType === "ADD" ? "Added" : "Modified",
      size: 2.5,
    },
    {
      label: "Request Status",
      value: toPascalKebabCase(data.reqStatus),
      size: 2.5,
    },
    {
      label: "Requested Date",
      value: timeStampFormatter(data.reqDate),
      size: 5,
    },
  ];

  const otherKeys = Object.keys(payload).filter(
    (key) => !["ShowCustomTable", "summaryData", "ShowDownload"].includes(key),
  );

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="md" fullWidth>
      <DialogTitle>
        Request Details - <b>ID: {data.id}</b>
      </DialogTitle>
      <Divider />
      <DialogContent>
        <Grid container spacing={2}>
          {mainDetails.map((item) => (
            <Grid size={{ xs: 12, sm: item.size }} key={item.label}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 800,
                    color: "text.secondary",
                  }}
                >
                  {item.label}
                </Typography>
                <Typography variant="body1">{item.value ?? "N/A"}</Typography>
              </Box>
            </Grid>
          ))}
        </Grid>
        <Divider sx={{ m: 2 }} />
        <Grid container spacing={2}>
          {Object.entries(payload).map(([key, value]) =>
            key !== "ShowCustomTable" &&
            key !== "ShowDownload" &&
            !(key === "summaryData" && payload.ShowCustomTable) ? (
              <Grid size={{ xs: 12, sm: 4 }} key={key}>
                <Box sx={{ display: "flex", flexDirection: "column" }}>
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: 800,
                      color: "text.secondary",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                    }}
                  >
                    {formatKeyForDisplay(key)}
                  </Typography>
                  <Typography variant="body1" sx={{ wordBreak: "break-word" }}>
                    {String(value ?? "N/A")}
                  </Typography>
                </Box>
              </Grid>
            ) : null,
          )}

          {"ShowCustomTable" in payload && otherKeys.length > 0 && (
            <Grid size={{ xs: 12 }}>
              <Divider sx={{ m: 1 }} />
            </Grid>
          )}

          {"ShowCustomTable" in payload &&
            (tableColumns.length > 0 ||
              payload?.summaryData?.data?.length > 0) && (
              <Grid size={{ xs: 12 }}>
                <ViewCommonDynamicTable data={payload} />
              </Grid>
            )}
        </Grid>
      </DialogContent>
      <Divider sx={{ m: 2 }} />
      <DialogActions sx={{ p: 2, justifyContent: "flex-end" }}>
        {payload.ShowDownload && (
          <Button
            onClick={handleDownload}
            variant="contained"
            color="primary"
            sx={{ textTransform: "none", borderRadius: 2, px: 3 }}
          >
            Download
          </Button>
        )}
        <Button
          onClick={handleClose}
          variant="contained"
          color="primary"
          sx={{ textTransform: "none", borderRadius: 2, px: 3 }}
        >
          Close
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ViewRequestDialog;
