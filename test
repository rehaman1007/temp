import axios from "axios";

class DownloadManager {
  constructor() {
    this.activeDownloads = {};
  }

  startDownload({ id, url, payload, onProgress, onComplete, onError }) {
    if (this.activeDownloads[id]) return;

    const controller = new AbortController();
    this.activeDownloads[id] = controller;

    axios.post(url, payload, {
      responseType: "blob",
      signal: controller.signal,
      onDownloadProgress: (event) => {
        if (event?.loaded) {
          onProgress(event.loaded);
        }
      },
    })
      .then((response) => {
        onComplete(response);
        delete this.activeDownloads[id];
      })
      .catch((err) => {
        if (!axios.isCancel(err)) {
          onError(err);
        }
        delete this.activeDownloads[id];
      });
  }

  cancelDownload(id) {
    this.activeDownloads[id]?.abort();
    delete this.activeDownloads[id];
  }

  isDownloading(id) {
    return Boolean(this.activeDownloads[id]);
  }
}

export default new DownloadManager();

import { createSlice } from "@reduxjs/toolkit";

const initialState = {
  active: false,
  downloadedBytes: 0,
  meta: null, // reportName, date, fileName
};

const downloadSlice = createSlice({
  name: "download",
  initialState,
  reducers: {
    startDownload(state, action) {
      state.active = true;
      state.downloadedBytes = 0;
      state.meta = action.payload;
    },
    updateProgress(state, action) {
      state.downloadedBytes = action.payload;
    },
    finishDownload(state) {
      state.active = false;
      state.downloadedBytes = 0;
      state.meta = null;
    },
  },
});

export const {
  startDownload,
  updateProgress,
  finishDownload,
} = downloadSlice.actions;

export default downloadSlice.reducer;

