        private void sendToMyDownloads(
                        String userId,
                        LedgerWiseBalanceRequest requestDto,
                        SearchCriteriaDTO dto,
                        byte[] content) {

                try {

                        String json = new ObjectMapper()
                                        .writeValueAsString(dto);

                        String fileName = requestDto.getEnquiryType() == ReportType.CONSOLIDATED
                                        ? "Ledger_Wise_Balance_Consolidated.xlsx"
                                        : "Ledger_Wise_Balance_Collation.xlsx";

                        int menuId = requestDto.getMenuId();

                        if (!(menuId == 58 || menuId == 59)) {
                                menuId = 59;
                        }
                        MyDownloadsRequestDTO request = new MyDownloadsRequestDTO(
                                        userId,
                                        fileName,
                                        menuId,
                                        json,
                                        content);

                        myDownloadsService.insertRequest(request);

                } catch (JsonProcessingException e) {
                        log.error("Failed to serialize download request", e);

                } catch (DataAccessException e) {
                        log.error("Failed to save download request", e);
                }
        }

        private String safeString(
                        Object value) {

                return value != null
                                ? value.toString()
                                : "";
        }

}
