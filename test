import React, { useEffect, useState } from "react";
import {
  Alert,
  AlertTitle,
  Box,
  Chip,
  Divider,
  LinearProgress,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import {
  CheckCircle,
  ErrorOutline,
  Info,
  Terminal,
  WarningAmber,
} from "@mui/icons-material";

const LogsPanel = ({ lastResponse, jobStatus }) => {
  const theme = useTheme();
  const [elapsed, setElapsed] = useState(0);

  useEffect(() => {
    if (!jobStatus?.startedAt) return;

    if (jobStatus.status === "COMPLETED" || jobStatus.status === "FAILED") {
      setElapsed(Number(jobStatus?.elapsedSeconds || 0));
      return;
    }

    const updateElapsed = () => {
      const seconds = Math.floor(
        (Date.now() - Number(jobStatus.startedAt)) / 1000
      );
      setElapsed(seconds > 0 ? seconds : 0);
    };

    updateElapsed();
    const interval = setInterval(updateElapsed, 1000);
    return () => clearInterval(interval);
  }, [
    jobStatus?.startedAt,
    jobStatus?.completedAt,
    jobStatus?.status,
    jobStatus?.elapsedSeconds,
  ]);

  const SectionTitle = ({ title }) => (
    <Typography
      variant="subtitle2"
      sx={{
        fontWeight: 700,
        mb: 1.5,
        color: "text.primary",
        borderLeft: `4px solid ${theme.palette.primary.main}`,
        pl: 1.2,
      }}
    >
      {title}
    </Typography>
  );

  const InfoRow = ({ label, value }) => (
    <Stack direction="row" justifyContent="space-between" alignItems="center">
      <Typography variant="body2" color="text.secondary">
        {label}
      </Typography>
      <Typography variant="body2" fontWeight={600}>
        {value}
      </Typography>
    </Stack>
  );

  if (!lastResponse && !jobStatus) return <div>No logs</div>;

  const processed = Number(jobStatus?.processedCount || 0);
  const executed = Number(jobStatus?.executedCount || 0);
  const total = Number(jobStatus?.totalStatements || 0);
  const progress = Number(jobStatus?.progress || 0);
  const pending = Math.max(total - executed, 0);
  const currentSpeed = Number(jobStatus?.executionSpeed || 0);

  return <Paper>...</Paper>;
};

export default LogsPanel;
