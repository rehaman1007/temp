// --- Main Screen ---
export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [etlDate, setEtlDate] = useState("");
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(false);
  const [reports, setReports] = useState([]);
  const [loading, setLoading] = useState(false);
  const [isDownloading, setIsDownloading] = useState(false);
  
  // Preview States
  const [reportPreview, setReportPreview] = useState(false);
  const [reportPreviewData, setReportPreviewData] = useState(null);
  const [selectedReport, setSelectedReport] = useState(null);

  const fetchData = async () => {
    try {
      const etlDetails = await callApi("/PS/process/waiting-for-approval", {}, "GET");
      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.inWaitingState || true;
      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(availableFlag);

      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/adhoc-types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        setReports(reportsData);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar("Failed to load report data. Kindly try again after sometime.", "error");
      setEtlDate(dayjs().format("DD-MM-YYYY"));
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = async (reportId, formatType) => {
    setIsDownloading(true);
    showSnackBar(`Generating fresh ${formatType} data...`, "info");

    try {
      const fileName = `${selectedReport.fileName}_${etlDate}`;
      const payload = {
        reportId: selectedReport.fileName || "nwsa_report",
        variantCode: "DATE_WISE",
        params: { balanceDate: "2026-03-30" }, // Note: Verify if balanceDate should be dynamic
      };

      const REPORT_DOWNLOAD_BASE_URL = "/RB/report-builder/view";
      let endpoint = `${REPORT_DOWNLOAD_BASE_URL}/pdf`; // Default fallback

      if (formatType === "excel") endpoint = `${REPORT_DOWNLOAD_BASE_URL}/xlsx`;
      if (formatType === "test" || formatType === "psv") endpoint = `${REPORT_DOWNLOAD_BASE_URL}/txt`;

      const response = await callApi(endpoint, payload, "POST", "arraybuffer");
      const blobData = response?.data || response;

      if (formatType === "view") {
        setReportPreviewData(blobData);
        setReportPreview(true);
        // Optimization: Do NOT set selectedReport to null here, otherwise Preview loses the title!
      } else {
        downloadFile(blobData, formatType, fileName);
        setSelectedReport(null);
        showSnackBar(`${fileName} downloaded successfully!`, "success");
      }
    } catch (error) {
      console.error("Download Error:", error);
      showSnackBar("Failed to process the report. Please try again.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  const handleClosePreview = () => {
    setReportPreview(false);
    setReportPreviewData(null);
    setSelectedReport(null);
  };

  return (
    <>
      <LoadingOverlay loading={loading || isDownloading} />

      <AdhocReportsPreview
        selectedReport={selectedReport}
        reportPreview={reportPreview}
        data={reportPreviewData}
        onClose={handleClosePreview}
      />

      <AdhocReportsDownloadDialog
        selectedReport={selectedReport && !reportPreview ? selectedReport : null}
        setSelectedReport={setSelectedReport}
        handleDownload={handleDownload}
        isAvailableToDownload={!loading}
      />

      <Grow in timeout={500}>
        <Stack spacing={4}>
          <Box sx={{ width: "100%", p: { xs: 2, sm: 3, md: 4 } }}>
            <Stack spacing={3} direction="column" alignItems="center" justifyContent="center">
              <Card sx={{ width: "100%", borderRadius: 3, boxShadow: 6, overflow: "hidden" }}>
                
                {/* Header */}
                <Box
                  sx={{
                    display: "flex",
                    flexDirection: { xs: "column", md: "row" },
                    alignItems: { xs: "flex-start", md: "center" },
                    justifyContent: "space-between",
                    gap: 3,
                    px: { xs: 3, md: 4 },
                    py: { xs: 3, md: 3 },
                    background: "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 100%)",
                    color: "white",
                  }}
                >
                  <Box sx={{ display: "flex", alignItems: "center", gap: 2, flex: 1 }}>
                    <Box sx={{ borderRadius: "50%", p: 1.5, bgcolor: "rgba(255,255,255,0.15)", display: "flex" }}>
                      <DescriptionIcon sx={{ width: { xs: 35, md: 45 }, height: { xs: 35, md: 45 } }} />
                    </Box>
                    <Box>
                      <Typography variant="h5" fontWeight="bold">Adhoc Reports Generation</Typography>
                      <Typography variant="body2" sx={{ opacity: 0.9, maxWidth: 600, mt: 0.5 }}>
                        View and download your monthly reports. Data is generated freshly upon request when the month-end ETL processing has completed.
                      </Typography>
                    </Box>
                  </Box>

                  <Box sx={{ bgcolor: "rgba(0,0,0,0.2)", borderRadius: 3, p: 2, display: "flex", flexDirection: "column", alignItems: { xs: "flex-start", md: "flex-end" }, gap: 1, minWidth: "fit-content" }}>
                    <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                      <CalendarMonthIcon fontSize="small" sx={{ opacity: 0.8 }} />
                      <Typography variant="caption" fontWeight="bold" sx={{ opacity: 0.9, letterSpacing: 0.5 }}>
                        ETL Date : {etlDate}
                      </Typography>
                    </Box>
                  </Box>
                </Box>

                {/* Content Area */}
                <Box sx={{ p: { xs: 2, md: 4 } }}>
                  {!loading && etlDate && !isLastDayOfMonth(etlDate) ? (
                    <Container maxWidth="sm" sx={{ py: 6 }}>
                      <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.5 }}>
                        <Paper elevation={0} sx={{ p: 6, borderRadius: 4, textAlign: "center", border: "1px solid", borderColor: "divider", bgcolor: "white", boxShadow: "0 4px 20px rgba(0,0,0,0.03)" }}>
                          <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} transition={{ delay: 0.2, type: "spring", stiffness: 150 }}>
                            <EventBusyIcon sx={{ fontSize: 80, color: "text.secondary", mb: 3, opacity: 0.3 }} />
                          </motion.div>
                          <Typography variant="h5" fontWeight="bold" gutterBottom color="text.primary">Not a Month-End Cycle</Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>Adhoc Reports are strictly generated as part of the month-end activity.</Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>The current ETL Date processed is <strong>{etlDate}</strong>.</Typography>
                          <Typography variant="body1" color="text.secondary">Please check back during the month-end processing cycle.</Typography>
                        </Paper>
                      </motion.div>
                    </Container>
                  ) : (
                    <Grid container spacing={3}>
                      {reports.map((report, index) => (
                        <Grid item xs={12} sm={6} md={4} key={report.id || index}>
                          <motion.div initial={{ opacity: 0, y: 30 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.4, delay: index * 0.1 }} style={{ height: "100%" }}>
                            <ReportCard report={report} onClick={() => setSelectedReport(report)} />
                          </motion.div>
                        </Grid>
                      ))}
                      {reports.length === 0 && (
                        <Grid item xs={12}>
                          <Typography align="center" color="text.secondary" sx={{ py: 8 }}>No reports configured for this date.</Typography>
                        </Grid>
                      )}
                    </Grid>
                  )}
                </Box>
              </Card>
            </Stack>
          </Box>
        </Stack>
      </Grow>
    </>
  );
}


import React, { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  Dialog,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Typography,
  Box,
  Grid,
  Paper,
} from "@mui/material";
import {
  Close,
  DescriptionRounded,
  PictureAsPdfRounded,
  TableChartRounded,
  InsertDriveFileRounded,
  DownloadRounded,
  VisibilityRounded,
  ArticleRounded,
  PreviewRounded,
} from "@mui/icons-material";

const getFormatIcon = (format) => {
  switch (format?.toLowerCase()) {
    case "pdf":
      return <PictureAsPdfRounded fontSize="large" color="error" />;
    case "excel":
    case "xlsx":
      return <TableChartRounded fontSize="large" color="success" />;
    case "psv":
      return <ArticleRounded fontSize="large" color="info" />;
    case "view":
      return <PreviewRounded fontSize="large" color="secondary" />;
    default:
      return <InsertDriveFileRounded fontSize="large" color="action" />;
  }
};

const AdhocReportsDownloadDialog = ({
  selectedReport,
  setSelectedReport,
  isAvailableToDownload,
  handleDownload,
}) => {
  const [selectedFormat, setSelectedFormat] = useState("view");

  useEffect(() => {
    if (selectedReport) setSelectedFormat("view");
  }, [selectedReport]);

  const formatOptions = [
    { id: "view", label: "Preview Document", ext: "view" },
    { id: "pdf", label: "PDF Document", ext: ".pdf" },
    { id: "excel", label: "Excel Spreadsheet", ext: ".xlsx" },
    { id: "psv", label: "PSV Data", ext: ".psv" },
  ];

  return (
    <AnimatePresence>
      {selectedReport && (
        <Dialog
          open={Boolean(selectedReport)}
          onClose={() => setSelectedReport(null)}
          maxWidth="md"
          fullWidth
          PaperProps={{
            component: motion.div,
            initial: { opacity: 0, scale: 0.95, y: 10 },
            animate: { opacity: 1, scale: 1, y: 0 },
            exit: { opacity: 0, scale: 0.95, y: 10 },
            transition: { duration: 0.2 },
            sx: { borderRadius: 3, overflow: "hidden", boxShadow: "0 20px 60px rgba(0,0,0,0.15)" },
          }}
        >
          <Box sx={{ p: 2.5, pb: 1, display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
            <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
              <Box sx={{ p: 1.5, borderRadius: 2, bgcolor: "primary.50", color: "primary.main", display: "flex" }}>
                <DescriptionRounded fontSize="large" />
              </Box>
              <Box>
                <Typography variant="h6" fontWeight="700" lineHeight={1.2}>
                  {selectedReport.reportName}
                </Typography>
                <Typography variant="body2" color="text.secondary" noWrap>
                  Choose Report Actions
                </Typography>
              </Box>
            </Box>
            <IconButton onClick={() => setSelectedReport(null)} size="small" sx={{ color: "text.secondary" }}>
              <Close />
            </IconButton>
          </Box>

          <DialogContent sx={{ pt: 2, pb: 3 }}>
            <Box>
              <Typography variant="h6" component="h2" color="text.secondary">Description</Typography>
              <Typography variant="body2" color="text.secondary" sx={{ mb: 3 }}>
                {selectedReport?.reportDescription || "No description available for this report."}
              </Typography>

              <Typography variant="h6" component="h3" sx={{ mt: 2 }}>Export Options</Typography>
              <Typography variant="body1" mb={3}>Choose a file format to generate fresh data for this report.</Typography>
            </Box>

            <Grid container spacing={2}>
              {formatOptions.map((option) => (
                <Grid item xs={12} sm={3} key={option.id}>
                  <Paper
                    onClick={() => setSelectedFormat(option.id)}
                    sx={{
                      p: 2,
                      height: "100%",
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      justifyContent: "center",
                      gap: 1.5,
                      cursor: "pointer",
                      border: "2px solid",
                      borderColor: selectedFormat === option.id ? "primary.main" : "divider",
                      bgcolor: selectedFormat === option.id ? "primary.50" : "background.paper",
                      transition: "all 0.2s ease",
                      "&:hover": { borderColor: "primary.light", bgcolor: "primary.50", transform: "translateY(-2px)" },
                    }}
                  >
                    {getFormatIcon(option.id)}
                    <Box textAlign="center">
                      <Typography variant="subtitle2" fontWeight="700">
                        {option.ext.toUpperCase()}
                      </Typography>
                      <Typography variant="caption" color="text.secondary">
                        {option.label}
                      </Typography>
                    </Box>
                  </Paper>
                </Grid>
              ))}
            </Grid>

            {!isAvailableToDownload && (
              <Box sx={{ mt: 3, p: 2, bgcolor: "warning.light", borderRadius: 2, color: "warning.contrastText" }}>
                <Typography variant="body2" fontWeight="600">⚠️ Data not available</Typography>
                <Typography variant="caption" display="block">This report cannot be generated at this time. Please try again later.</Typography>
              </Box>
            )}
          </DialogContent>

          <DialogActions sx={{ p: 1.5, gap: 1.5, borderTop: "1px solid", borderColor: "divider" }}>
            <Button onClick={() => setSelectedReport(null)} variant="outlined" color="inherit" disabled={!isAvailableToDownload}>
              Cancel
            </Button>
            <Button
              variant="contained"
              disabled={!selectedFormat || !isAvailableToDownload}
              onClick={() => handleDownload(selectedReport.id, selectedFormat)}
              startIcon={selectedFormat === "view" ? <VisibilityRounded /> : <DownloadRounded />}
              sx={{ px: 3, py: 1.2 }}
            >
              {selectedFormat === "view" ? "Preview Document" : `Download ${selectedFormat.toUpperCase()}`}
            </Button>
          </DialogActions>
        </Dialog>
      )}
    </AnimatePresence>
  );
};

export default AdhocReportsDownloadDialog;


