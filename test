import React, {
  useState,
  useEffect,
  useMemo,
} from "react";

import {
  Box,
  Paper,
  Typography,
  Button,
  Stack,
  Tabs,
  Tab,
  TextField,
  IconButton,
  Tooltip,
  Divider,
  LinearProgress,
  Alert,
  AlertTitle,
  Chip,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  useTheme,
  alpha,
} from "@mui/material";

import {
  UploadFile,
  PlayArrow,
  CleaningServices,
  ContentCopy,
  CloudUpload,
  TableChart,
  ListAlt,
  Terminal,
} from "@mui/icons-material";

import {
  DataGrid,
  GridToolbar,
} from "@mui/x-data-grid";

import {
  useMutation,
} from "@tanstack/react-query";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const AdminSupport = () => {

  const theme = useTheme();

  const { callApi } =
    useApi();

  const showSnackbar =
    useCustomSnackbar();

  /**
   * MAIN TAB
   * 0 = SQL COMMAND
   * 1 = FILE UPLOAD
   */
  const [mainTab, setMainTab] =
    useState(0);

  /**
   * OUTPUT TAB
   * 0 = GRID
   * 1 = LOGS
   */
  const [
    outputTab,
    setOutputTab,
  ] = useState(0);

  /**
   * SQL COMMAND
   */
  const [query, setQuery] =
    useState(
      "SELECT * FROM USERS"
    );

  /**
   * FILE UPLOAD
   */
  const [selectedFile, setSelectedFile] =
    useState(null);

  const [dragging, setDragging] =
    useState(false);

  /**
   * GRID DATA
   */
  const [results, setResults] =
    useState({
      rows: [],
      columns: [],
      total: 0,
    });

  /**
   * PAGINATION
   */
  const [
    paginationModel,
    setPaginationModel,
  ] = useState({
    page: 0,
    pageSize: 5,
  });

  /**
   * LOGS
   */
  const [
    lastResponse,
    setLastResponse,
  ] = useState(null);

  /**
   * JOB TRACKING
   */
  const [jobId, setJobId] =
    useState(null);

  const [
    jobStatus,
    setJobStatus,
  ] = useState(null);

  /**
   * CONFIRM DIALOG
   */
  const [
    confirmOpen,
    setConfirmOpen,
  ] = useState(false);

  /**
   * QUERY TYPE
   */
  const isSelect = useMemo(() => {

    const q =
      query.trim().toUpperCase();

    return (
      q.startsWith("SELECT") ||
      q.startsWith("WITH")
    );

  }, [query]);

  /**
   * DANGEROUS CHECK
   */
  const isDestructive =
    useMemo(() => {

      const q =
        query.trim().toUpperCase();

      return [
        "UPDATE",
        "DELETE",
        "DROP",
        "TRUNCATE",
        "ALTER",
      ].some((k) =>
        q.startsWith(k)
      );

    }, [query]);

  /**
   * EXECUTE SQL
   */
  const {
    mutate: executeSql,
    isPending,
  } = useMutation({

    mutationFn: async ({
      sql,
      page,
      size,
    }) => {

      return await callApi(
        "/api/admin-support/admin-execute",
        {
          sql,
          page,
          size,
        },
        "POST"
      );
    },

    onSuccess: (data) => {

      setLastResponse(data);

      if (data?.error) {

        setOutputTab(1);

        return;
      }

      /**
       * SELECT
       */
      if (isSelect) {

        const formattedCols =
          (
            data?.columns || []
          ).map((col) => ({
            field: col.name,
            headerName: col.name,
            flex: 1,
            minWidth: 150,
          }));

        setResults({
          rows:
            data?.rows || [],
          columns:
            formattedCols,
          total:
            data?.total || 0,
        });

        setOutputTab(0);

      } else {

        /**
         * DML LOG
         */
        setResults({
          rows: [],
          columns: [],
          total: 0,
        });

        setOutputTab(1);
      }
    },

    onError: (err) => {

      setLastResponse({
        error: true,
        message:
          err?.message ||
          "Execution failed",
      });

      setOutputTab(1);
    },
  });

  /**
   * EXECUTE COMMAND
   */
  const handleRun = (
    resetPage = false
  ) => {

    const trimmed =
      query.trim();

    if (!trimmed) {

      showSnackbar(
        "Enter query",
        "warning"
      );

      return;
    }

    const targetPage =
      resetPage
        ? 0
        : paginationModel.page;

    if (resetPage) {

      setPaginationModel(
        (p) => ({
          ...p,
          page: 0,
        })
      );
    }

    executeSql({
      sql: query,
      page: targetPage,
      size:
        paginationModel.pageSize,
    });
  };

  /**
   * PAGINATION
   */
  useEffect(() => {

    if (
      results.columns.length >
        0 &&
      isSelect
    ) {

      handleRun();
    }

  }, [
    paginationModel.page,
    paginationModel.pageSize,
  ]);

  /**
   * DRAG DROP
   */
  const handleDrop = (e) => {

    e.preventDefault();

    setDragging(false);

    const file =
      e.dataTransfer.files[0];

    validateFile(file);
  };

  /**
   * VALIDATE FILE
   */
  const validateFile = (
    file
  ) => {

    if (!file) return;

    if (
      !file.name.endsWith(
        ".sql"
      )
    ) {

      showSnackbar(
        "Only .sql files allowed",
        "error"
      );

      return;
    }

    setSelectedFile(file);
  };

  /**
   * UPLOAD SCRIPT
   */
  const handleUpload =
    async () => {

      try {

        if (!selectedFile) {

          showSnackbar(
            "Select SQL file",
            "warning"
          );

          return;
        }

        const formData =
          new FormData();

        formData.append(
          "file",
          selectedFile
        );

        const data =
          await callApi(
            "/api/admin-support/upload-script",
            formData,
            "POST",
            true
          );

        if (data.error) {

          showSnackbar(
            data.message,
            "error"
          );

          return;
        }

        setJobId(data.jobId);

        setOutputTab(1);

        showSnackbar(
          "Upload started",
          "success"
        );

      } catch (e) {

        showSnackbar(
          e.message ||
          "Upload failed",
          "error"
        );
      }
    };

  /**
   * JOB POLLING
   */
  useEffect(() => {

    if (!jobId) return;

    const interval =
      setInterval(
        async () => {

          try {

            const data =
              await callApi(
                `/api/admin-support/job-status/${jobId}`,
                {},
                "GET"
              );

            setJobStatus(data);

            if (
              data.status ===
                "COMPLETED" ||
              data.status ===
                "FAILED"
            ) {

              clearInterval(
                interval
              );
            }

          } catch (e) {

            console.error(e);
          }
        },
        2000
      );

    return () =>
      clearInterval(interval);

  }, [jobId]);

  /**
   * SHORTCUT
   */
  const handleKeyDown = (
    e
  ) => {

    if (
      e.ctrlKey &&
      e.key === "Enter"
    ) {

      e.preventDefault();

      handleRun(true);
    }
  };

  return (

    <Box
      sx={{
        display: "flex",
        flexDirection:
          "column",
        height: "100%",
        overflow: "hidden",
        p: 1,
      }}
    >

      {/* HEADER */}
      <Paper
        elevation={0}
        sx={{
          px: 3,
          py: 1,
          borderRadius: 1,
          display: "flex",
          alignItems:
            "center",
          justifyContent:
            "space-between",
        }}
      >

        <Typography
          fontWeight={800}
        >
          FINCORE ADMIN SUPPORT
        </Typography>

        <Chip
          label="CTRL + ENTER"
          size="small"
        />

      </Paper>

      {/* MAIN TABS */}
      <Paper
        sx={{ mt: 1 }}
      >

        <Tabs
          value={mainTab}
          onChange={(
            e,
            v
          ) =>
            setMainTab(v)
          }
        >

          <Tab
            icon={<Terminal />}
            label="SQL Command"
          />

          <Tab
            icon={
              <UploadFile />
            }
            label="SQL Upload"
          />

        </Tabs>

      </Paper>

      {/* COMMAND PANEL */}
      {mainTab === 0 && (

        <Paper
          sx={{
            mt: 1,
            p: 0,
            overflow: "hidden",
            borderRadius: 1,
          }}
        >

          {/* TOOLBAR */}
          <Box
            sx={{
              px: 2,
              py: 1,
              bgcolor:
                "#2d2d2d",
              display: "flex",
              justifyContent:
                "space-between",
              alignItems:
                "center",
            }}
          >

            <Typography
              variant="caption"
              sx={{
                color:
                  "#d4d4d4",
              }}
            >
              SQL Worksheet
            </Typography>

            <Stack
              direction="row"
              spacing={1}
            >

              <Tooltip title="Clear">
                <IconButton
                  size="small"
                  onClick={() =>
                    setQuery("")
                  }
                >
                  <CleaningServices
                    sx={{
                      color:
                        "white",
                    }}
                  />
                </IconButton>
              </Tooltip>

              <Tooltip title="Copy">
                <IconButton
                  size="small"
                  onClick={() =>
                    navigator.clipboard.writeText(
                      query
                    )
                  }
                >
                  <ContentCopy
                    sx={{
                      color:
                        "white",
                    }}
                  />
                </IconButton>
              </Tooltip>

              <Divider
                orientation="vertical"
                flexItem
              />

              <Button
                size="small"
                variant="contained"
                color={
                  isDestructive
                    ? "error"
                    : "primary"
                }
                startIcon={
                  <PlayArrow />
                }
                onClick={() =>
                  isDestructive
                    ? setConfirmOpen(
                        true
                      )
                    : handleRun(
                        true
                      )
                }
              >
                Execute
              </Button>

            </Stack>

          </Box>

          {/* SQL AREA */}
          <TextField
            multiline
            minRows={12}
            fullWidth
            value={query}
            onChange={(e) =>
              setQuery(
                e.target.value
              )
            }
            onKeyDown={
              handleKeyDown
            }
            variant="standard"
            InputProps={{
              disableUnderline: true,
              sx: {
                p: 2,
                bgcolor:
                  "#1e1e1e",
                color:
                  "#d4d4d4",
                fontFamily:
                  "'Fira Code', monospace",
              },
            }}
          />

        </Paper>

      )}

      {/* FILE UPLOAD */}
      {mainTab === 1 && (

        <Paper
          sx={{
            mt: 1,
            p: 3,
          }}
        >

          {/* DRAG DROP */}
          <Box
            onDragOver={(e) => {

              e.preventDefault();

              setDragging(
                true
              );
            }}
            onDragLeave={() =>
              setDragging(
                false
              )
            }
            onDrop={handleDrop}
            sx={{
              border:
                dragging
                  ? `2px dashed ${theme.palette.primary.main}`
                  : `2px dashed ${theme.palette.divider}`,
              borderRadius: 2,
              p: 6,
              textAlign:
                "center",
              bgcolor:
                dragging
                  ? alpha(
                      theme
                        .palette
                        .primary
                        .main,
                      0.08
                    )
                  : "transparent",
              transition:
                "all 0.2s",
            }}
          >

            <CloudUpload
              sx={{
                fontSize: 60,
                color:
                  theme.palette
                    .primary
                    .main,
              }}
            />

            <Typography
              mt={2}
              fontWeight={700}
            >
              Drag & Drop SQL File
            </Typography>

            <Typography
              variant="body2"
              color="text.secondary"
              mt={1}
            >
              Supports huge SQL
              files
            </Typography>

            <Button
              component="label"
              variant="outlined"
              sx={{ mt: 3 }}
            >
              Browse File

              <input
                hidden
                type="file"
                accept=".sql"
                onChange={(
                  e
                ) =>
                  validateFile(
                    e.target
                      .files[0]
                  )
                }
              />

            </Button>

          </Box>

          {/* FILE INFO */}
          {selectedFile && (

            <Alert
              severity="info"
              sx={{ mt: 2 }}
            >

              <AlertTitle>
                Selected File
              </AlertTitle>

              {selectedFile.name}

              <br />

              Size:
              {" "}
              {(
                selectedFile.size /
                1024 /
                1024
              ).toFixed(2)}
              {" "}
              MB

            </Alert>

          )}

          {/* UPLOAD BTN */}
          <Stack
            direction="row"
            justifyContent="flex-end"
            mt={2}
          >

            <Button
              variant="contained"
              startIcon={
                <UploadFile />
              }
              onClick={
                handleUpload
              }
            >
              Submit Script
            </Button>

          </Stack>

        </Paper>

      )}

      {/* LOADER */}
      {isPending && (
        <LinearProgress
          sx={{ mt: 1 }}
        />
      )}

      {/* JOB STATUS */}
      {jobStatus && (

        <Paper
          sx={{
            mt: 1,
            p: 2,
          }}
        >

          <Typography
            fontWeight={700}
          >
            Upload Execution
          </Typography>

          <Typography>
            Status:
            {" "}
            {
              jobStatus.status
            }
          </Typography>

          <Typography>
            Executed:
            {" "}
            {
              jobStatus.executedCount ||
              0
            }
          </Typography>

          <LinearProgress
            sx={{ mt: 1 }}
          />

        </Paper>

      )}

      {/* OUTPUT */}
      <Paper
        sx={{
          mt: 1,
          flex: 1,
          overflow: "hidden",
        }}
      >

        {/* OUTPUT TABS */}
        <Tabs
          value={outputTab}
          onChange={(
            e,
            v
          ) =>
            setOutputTab(v)
          }
        >

          <Tab
            icon={
              <TableChart />
            }
            label="Data Grid"
          />

          <Tab
            icon={<ListAlt />}
            label="Logs"
          />

        </Tabs>

        {/* GRID */}
        {outputTab === 0 && (

          <DataGrid
            rows={results.rows}
            columns={
              results.columns
            }
            rowCount={
              results.total
            }
            paginationMode="server"
            paginationModel={
              paginationModel
            }
            onPaginationModelChange={
              setPaginationModel
            }
            loading={isPending}
            pageSizeOptions={[
              5,
              10,
              25,
              50,
            ]}
            disableRowSelectionOnClick
            slots={{
              toolbar:
                GridToolbar,
            }}
            getRowId={(
              row
            ) =>
              row.ID ||
              row.id ||
              Math.random()
            }
            sx={{
              border: "none",
              height: 500,
              "& .MuiDataGrid-columnHeaders":
                {
                  bgcolor:
                    alpha(
                      theme
                        .palette
                        .action
                        .hover,
                      0.4
                    ),
                },
            }}
          />

        )}

        {/* LOGS */}
        {outputTab === 1 && (

          <Box
            sx={{ p: 2 }}
          >

            {!lastResponse &&
              !jobStatus && (

                <Typography
                  color="text.secondary"
                >
                  Waiting for
                  execution...
                </Typography>

              )}

            {lastResponse
              ?.error && (

              <Alert severity="error">

                <AlertTitle>
                  Error
                </AlertTitle>

                {
                  lastResponse.message
                }

              </Alert>

            )}

            {lastResponse &&
              !lastResponse
                ?.error && (

                <Alert severity="success">

                  <AlertTitle>
                    Execution Log
                  </AlertTitle>

                  {lastResponse
                    ?.rows?.[0]
                    ?.RESULT ||
                    "Completed"}

                </Alert>

              )}

            {jobStatus
              ?.status ===
              "FAILED" && (

              <Alert
                severity="error"
                sx={{ mt: 2 }}
              >

                <AlertTitle>
                  Upload Failed
                </AlertTitle>

                {
                  jobStatus.message
                }

              </Alert>

            )}

            {jobStatus
              ?.status ===
              "COMPLETED" && (

              <Alert
                severity="success"
                sx={{ mt: 2 }}
              >

                <AlertTitle>
                  Upload Completed
                </AlertTitle>

                Total Executed:
                {" "}
                {
                  jobStatus.executedCount
                }

              </Alert>

            )}

          </Box>

        )}

      </Paper>

      {/* CONFIRM */}
      <Dialog
        open={confirmOpen}
        onClose={() =>
          setConfirmOpen(
            false
          )
        }
      >

        <DialogTitle>
          Confirm Query
        </DialogTitle>

        <DialogContent>

          <Typography>
            Execute
            destructive query?
          </Typography>

        </DialogContent>

        <DialogActions>

          <Button
            onClick={() =>
              setConfirmOpen(
                false
              )
            }
          >
            Cancel
          </Button>

          <Button
            variant="contained"
            color="error"
            onClick={() => {

              setConfirmOpen(
                false
              );

              handleRun(true);
            }}
          >
            Execute
          </Button>

        </DialogActions>

      </Dialog>

    </Box>
  );
};

export default AdminSupport;