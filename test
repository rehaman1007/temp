import React, {
  useState,
  useEffect,
  useMemo,
} from "react";

import {
  Box,
  Paper,
  Typography,
  Button,
  Stack,
  Tabs,
  Tab,
  TextField,
  IconButton,
  Tooltip,
  Divider,
  LinearProgress,
  Alert,
  AlertTitle,
  Chip,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  useTheme,
  alpha,
  Grid,
  Card,
  CardContent,
  Fade,
} from "@mui/material";

import {
  UploadFile,
  PlayArrow,
  CleaningServices,
  ContentCopy,
  CloudUpload,
  TableChart,
  ListAlt,
  Terminal,
  Timer,
  Speed,
  WarningAmber,
  CheckCircle,
  Error,
  DataObject,
} from "@mui/icons-material";

import {
  DataGrid,
  GridToolbar,
} from "@mui/x-data-grid";

import { useMutation } from "@tanstack/react-query";

import useApi from "../../hooks/useApi";

import useCustomSnackbar from "../../utils/useCustomSnackbar";

const AdminSupport = () => {
  const theme = useTheme();

  const { callApi } = useApi();

  const showSnackbar = useCustomSnackbar();

  /**
   * MAIN TAB
   */
  const [mainTab, setMainTab] = useState(0);

  /**
   * OUTPUT TAB
   */
  const [outputTab, setOutputTab] = useState(0);

  /**
   * SQL
   */
  const [query, setQuery] = useState(
    "SELECT * FROM USERS",
  );

  /**
   * FILE
   */
  const [selectedFile, setSelectedFile] =
    useState(null);

  const [dragging, setDragging] =
    useState(false);

  /**
   * RESULTS
   */
  const [results, setResults] = useState({
    rows: [],
    columns: [],
    total: 0,
  });

  /**
   * PAGINATION
   */
  const [paginationModel, setPaginationModel] =
    useState({
      page: 0,
      pageSize: 5,
    });

  /**
   * LOGS
   */
  const [lastResponse, setLastResponse] =
    useState(null);

  /**
   * JOB
   */
  const [jobId, setJobId] = useState(null);

  const [jobStatus, setJobStatus] =
    useState(null);

  /**
   * DIALOG
   */
  const [confirmOpen, setConfirmOpen] =
    useState(false);

  /**
   * SELECT CHECK
   */
  const isSelect = useMemo(() => {
    const q = query.trim().toUpperCase();

    return (
      q.startsWith("SELECT") ||
      q.startsWith("WITH")
    );
  }, [query]);

  /**
   * DANGEROUS
   */
  const isDestructive = useMemo(() => {
    const q = query.trim().toUpperCase();

    return [
      "UPDATE",
      "DELETE",
      "DROP",
      "TRUNCATE",
      "ALTER",
    ].some((k) => q.startsWith(k));
  }, [query]);

  /**
   * EXECUTE SQL
   */
  const {
    mutate: executeSql,
    isPending,
  } = useMutation({
    mutationFn: async ({
      sql,
      page,
      size,
    }) => {
      return await callApi(
        "/TS/admin-support/admin-execute",
        {
          sql,
          page,
          size,
        },
        "POST",
      );
    },

    onSuccess: (data) => {
      setLastResponse(data);

      if (data?.error) {
        setOutputTab(1);

        return;
      }

      if (isSelect) {
        const formattedCols = (
          data?.columns || []
        ).map((col) => ({
          field: col.name,
          headerName: col.name,
          flex: 1,
          minWidth: 150,
        }));

        setResults({
          rows: data?.rows || [],
          columns: formattedCols,
          total: data?.total || 0,
        });

        setOutputTab(0);
      } else {
        setResults({
          rows: [],
          columns: [],
          total: 0,
        });

        setOutputTab(1);
      }
    },

    onError: (err) => {
      setLastResponse({
        error: true,
        message:
          err?.message ||
          "Execution failed",
      });

      setOutputTab(1);
    },
  });

  /**
   * RUN
   */
  const handleRun = (
    resetPage = false,
  ) => {
    const trimmed = query.trim();

    if (!trimmed) {
      showSnackbar(
        "Enter query",
        "warning",
      );

      return;
    }

    const targetPage = resetPage
      ? 0
      : paginationModel.page;

    if (resetPage) {
      setPaginationModel((p) => ({
        ...p,
        page: 0,
      }));
    }

    executeSql({
      sql: query,
      page: targetPage,
      size: paginationModel.pageSize,
    });
  };

  /**
   * PAGINATION
   */
  useEffect(() => {
    if (
      results.columns.length > 0 &&
      isSelect
    ) {
      handleRun();
    }
  }, [
    paginationModel.page,
    paginationModel.pageSize,
  ]);

  /**
   * WARN USER
   */
  useEffect(() => {
    const beforeUnload = (e) => {
      if (
        jobStatus?.status === "RUNNING"
      ) {
        e.preventDefault();

        e.returnValue =
          "SQL execution is running.";
      }
    };

    window.addEventListener(
      "beforeunload",
      beforeUnload,
    );

    return () => {
      window.removeEventListener(
        "beforeunload",
        beforeUnload,
      );
    };
  }, [jobStatus]);

  /**
   * DROP
   */
  const handleDrop = (e) => {
    e.preventDefault();

    setDragging(false);

    const file =
      e.dataTransfer.files[0];

    validateFile(file);
  };

  /**
   * VALIDATE
   */
  const validateFile = (file) => {
    if (!file) return;

    if (!file.name.endsWith(".sql")) {
      showSnackbar(
        "Only .sql files allowed",
        "error",
      );

      return;
    }

    setSelectedFile(file);
  };

  /**
   * UPLOAD
   */
  const handleUpload = async () => {
    try {
      if (!selectedFile) {
        showSnackbar(
          "Select SQL file",
          "warning",
        );

        return;
      }

      const formData =
        new FormData();

      formData.append(
        "file",
        selectedFile,
      );

      const data = await callApi(
        "/TS/admin-support/upload-script",
        formData,
        "POST",
        "json",
        "multipart/form-data",
      );

      if (data.error) {
        showSnackbar(
          data.message,
          "error",
        );

        return;
      }

      setJobId(data.jobId);

      setOutputTab(1);

      showSnackbar(
        "Execution started",
        "success",
      );
    } catch (e) {
      showSnackbar(
        e.message ||
          "Upload failed",
        "error",
      );
    }
  };

  /**
   * POLLING
   */
  useEffect(() => {
    if (!jobId) return;

    const interval =
      setInterval(async () => {
        try {
          const data =
            await callApi(
              `/TS/admin-support/job-status/${jobId}`,
              {},
              "GET",
            );

          setJobStatus(data);

          if (
            data.status ===
              "COMPLETED" ||
            data.status ===
              "FAILED"
          ) {
            clearInterval(interval);
          }
        } catch (e) {
          console.error(e);
        }
      }, 1000);

    return () =>
      clearInterval(interval);
  }, [jobId]);

  /**
   * SHORTCUT
   */
  const handleKeyDown = (e) => {
    if (
      e.ctrlKey &&
      e.key === "Enter"
    ) {
      e.preventDefault();

      handleRun(true);
    }
  };

  /**
   * PROGRESS %
   */
  const progress =
    jobStatus?.totalStatements > 0
      ? Math.min(
          (
            (jobStatus.executedCount ||
              0) /
            jobStatus.totalStatements
          ) * 100,
          100,
        )
      : 0;

  return (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        gap: 1,
        height: "100%",
        overflow: "hidden",
        p: 1,
      }}
    >
      {/* HEADER */}
      <Paper
        elevation={0}
        sx={{
          p: 2,
          borderRadius: 3,
          background: `linear-gradient(135deg,
          ${theme.palette.primary.main},
          ${theme.palette.primary.dark})`,
          color: "white",
        }}
      >
        <Stack
          direction={{
            xs: "column",
            md: "row",
          }}
          justifyContent="space-between"
          spacing={2}
        >
          <Box>
            <Typography
              variant="h5"
              fontWeight={900}
            >
              FINCORE ADMIN SUPPORT
            </Typography>

            <Typography
              variant="body2"
              sx={{ opacity: 0.8 }}
            >
              SQL Console + Massive
              Script Executor
            </Typography>
          </Box>

          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
          >
            <Chip
              label="CTRL + ENTER"
              sx={{
                bgcolor:
                  "rgba(255,255,255,0.2)",
                color: "white",
              }}
            />

            {jobStatus?.status ===
              "RUNNING" && (
              <Chip
                icon={<WarningAmber />}
                label="DO NOT CLOSE SCREEN"
                color="warning"
              />
            )}
          </Stack>
        </Stack>
      </Paper>

      {/* TABS */}
      <Paper
        sx={{
          borderRadius: 3,
          overflow: "hidden",
        }}
      >
        <Tabs
          value={mainTab}
          onChange={(e, v) =>
            setMainTab(v)
          }
          variant="fullWidth"
        >
          <Tab
            icon={<Terminal />}
            label="SQL COMMAND"
          />

          <Tab
            icon={<UploadFile />}
            label="SQL UPLOAD"
          />
        </Tabs>
      </Paper>

      {/* SQL PANEL */}
      {mainTab === 0 && (
        <Paper
          sx={{
            overflow: "hidden",
            borderRadius: 3,
          }}
        >
          <Box
            sx={{
              px: 2,
              py: 1,
              bgcolor: "#1e1e1e",
              display: "flex",
              justifyContent:
                "space-between",
              alignItems: "center",
              flexWrap: "wrap",
              gap: 1,
            }}
          >
            <Typography
              variant="caption"
              sx={{
                color: "#d4d4d4",
              }}
            >
              SQL Worksheet
            </Typography>

            <Stack
              direction="row"
              spacing={1}
            >
              <Tooltip title="Clear">
                <IconButton
                  size="small"
                  onClick={() =>
                    setQuery("")
                  }
                >
                  <CleaningServices
                    sx={{
                      color:
                        "white",
                    }}
                  />
                </IconButton>
              </Tooltip>

              <Tooltip title="Copy">
                <IconButton
                  size="small"
                  onClick={() =>
                    navigator.clipboard.writeText(
                      query,
                    )
                  }
                >
                  <ContentCopy
                    sx={{
                      color:
                        "white",
                    }}
                  />
                </IconButton>
              </Tooltip>

              <Button
                variant="contained"
                color={
                  isDestructive
                    ? "error"
                    : "primary"
                }
                startIcon={
                  <PlayArrow />
                }
                onClick={() =>
                  isDestructive
                    ? setConfirmOpen(
                        true,
                      )
                    : handleRun(
                        true,
                      )
                }
              >
                Execute
              </Button>
            </Stack>
          </Box>

          <TextField
            multiline
            minRows={14}
            fullWidth
            value={query}
            onChange={(e) =>
              setQuery(
                e.target.value,
              )
            }
            onKeyDown={
              handleKeyDown
            }
            variant="standard"
            InputProps={{
              disableUnderline: true,
              sx: {
                p: 2,
                bgcolor:
                  "#1e1e1e",
                color:
                  "#d4d4d4",
                fontFamily:
                  "'Fira Code', monospace",
              },
            }}
          />
        </Paper>
      )}

      {/* FILE UPLOAD */}
      {mainTab === 1 && (
        <Paper
          sx={{
            p: 3,
            borderRadius: 3,
          }}
        >
          <Box
            onDragOver={(e) => {
              e.preventDefault();

              setDragging(true);
            }}
            onDragLeave={() =>
              setDragging(false)
            }
            onDrop={handleDrop}
            sx={{
              border: dragging
                ? `2px dashed ${theme.palette.primary.main}`
                : `2px dashed ${theme.palette.divider}`,
              borderRadius: 3,
              p: {
                xs: 4,
                md: 8,
              },
              textAlign: "center",
              bgcolor: dragging
                ? alpha(
                    theme.palette
                      .primary.main,
                    0.08,
                  )
                : "transparent",
              transition:
                "all 0.2s",
            }}
          >
            <CloudUpload
              sx={{
                fontSize: 70,
                color:
                  theme.palette
                    .primary.main,
              }}
            />

            <Typography
              mt={2}
              fontWeight={800}
              variant="h6"
            >
              Drag & Drop SQL
              File
            </Typography>

            <Typography
              variant="body2"
              color="text.secondary"
              mt={1}
            >
              Supports huge SQL
              execution with
              realtime tracking
            </Typography>

            <Button
              component="label"
              variant="contained"
              sx={{ mt: 3 }}
            >
              Browse File
              <input
                hidden
                type="file"
                accept=".sql"
                onChange={(e) =>
                  validateFile(
                    e.target
                      .files[0],
                  )
                }
              />
            </Button>
          </Box>

          {selectedFile && (
            <Fade in>
              <Alert
                severity="info"
                sx={{ mt: 2 }}
              >
                <AlertTitle>
                  Selected File
                </AlertTitle>

                <Typography>
                  {
                    selectedFile.name
                  }
                </Typography>

                <Typography variant="body2">
                  Size :
                  <b>
                    {" "}
                    {(
                      selectedFile.size /
                      1024 /
                      1024
                    ).toFixed(2)}
                    MB
                  </b>
                </Typography>
              </Alert>
            </Fade>
          )}

          <Stack
            direction="row"
            justifyContent="flex-end"
            mt={2}
          >
            <Button
              variant="contained"
              startIcon={
                <UploadFile />
              }
              onClick={
                handleUpload
              }
            >
              Submit Script
            </Button>
          </Stack>
        </Paper>
      )}

      {/* LOADER */}
      {isPending && (
        <LinearProgress />
      )}

      {/* STATUS DASHBOARD */}
      {jobStatus && (
        <Paper
          sx={{
            p: 2,
            borderRadius: 3,
          }}
        >
          <Stack
            direction={{
              xs: "column",
              md: "row",
            }}
            justifyContent="space-between"
            alignItems="center"
            spacing={2}
          >
            <Typography
              fontWeight={800}
              variant="h6"
            >
              SQL Execution
              Monitor
            </Typography>

            <Chip
              icon={
                jobStatus.status ===
                "COMPLETED" ? (
                  <CheckCircle />
                ) : jobStatus.status ===
                  "FAILED" ? (
                  <Error />
                ) : (
                  <Timer />
                )
              }
              label={
                jobStatus.status
              }
              color={
                jobStatus.status ===
                "COMPLETED"
                  ? "success"
                  : jobStatus.status ===
                      "FAILED"
                    ? "error"
                    : "warning"
              }
            />
          </Stack>

          <Divider
            sx={{ my: 2 }}
          />

          <Grid
            container
            spacing={2}
          >
            {[
              {
                title:
                  "Executed",
                value:
                  jobStatus.executedCount ||
                  0,
                icon: (
                  <DataObject />
                ),
              },
              {
                title: "Total",
                value:
                  jobStatus.totalStatements ||
                  0,
                icon: (
                  <TableChart />
                ),
              },
              {
                title:
                  "Remaining",
                value:
                  jobStatus.remainingStatements ||
                  0,
                icon: (
                  <Speed />
                ),
              },
              {
                title:
                  "ETA (sec)",
                value:
                  jobStatus.estimatedRemainingSeconds ||
                  0,
                icon: (
                  <Timer />
                ),
              },
            ].map((item) => (
              <Grid
                item
                xs={12}
                sm={6}
                md={3}
                key={item.title}
              >
                <Card
                  elevation={0}
                  sx={{
                    borderRadius: 3,
                    bgcolor:
                      alpha(
                        theme
                          .palette
                          .primary
                          .main,
                        0.05,
                      ),
                  }}
                >
                  <CardContent>
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                    >
                      <Box>
                        <Typography
                          variant="body2"
                        >
                          {
                            item.title
                          }
                        </Typography>

                        <Typography
                          variant="h5"
                          fontWeight={
                            800
                          }
                        >
                          {
                            item.value
                          }
                        </Typography>
                      </Box>

                      {
                        item.icon
                      }
                    </Stack>
                  </CardContent>
                </Card>
              </Grid>
            ))}
          </Grid>

          <Box sx={{ mt: 3 }}>
            <LinearProgress
              variant="determinate"
              value={progress}
              sx={{
                height: 12,
                borderRadius: 10,
              }}
            />

            <Typography
              variant="body2"
              sx={{ mt: 1 }}
            >
              {progress.toFixed(
                2,
              )}
              % Completed
            </Typography>
          </Box>
        </Paper>
      )}

      {/* OUTPUT */}
      <Paper
        sx={{
          flex: 1,
          overflow: "hidden",
          borderRadius: 3,
        }}
      >
        <Tabs
          value={outputTab}
          onChange={(e, v) =>
            setOutputTab(v)
          }
        >
          <Tab
            icon={<TableChart />}
            label="GRID"
          />

          <Tab
            icon={<ListAlt />}
            label="LOGS"
          />
        </Tabs>

        {/* GRID */}
        {outputTab === 0 && (
          <DataGrid
            rows={results.rows}
            columns={
              results.columns
            }
            rowCount={
              results.total
            }
            paginationMode="server"
            paginationModel={
              paginationModel
            }
            onPaginationModelChange={
              setPaginationModel
            }
            loading={isPending}
            pageSizeOptions={[
              5,
              10,
              25,
              50,
            ]}
            disableRowSelectionOnClick
            slots={{
              toolbar:
                GridToolbar,
            }}
            getRowId={(row) =>
              row.ID ||
              row.id ||
              Math.random()
            }
            sx={{
              border: "none",
              height: 500,
            }}
          />
        )}

        {/* LOGS */}
        {outputTab === 1 && (
          <Box sx={{ p: 2 }}>
            {!lastResponse &&
              !jobStatus && (
                <Typography color="text.secondary">
                  Waiting for
                  execution...
                </Typography>
              )}

            {lastResponse?.error && (
              <Alert severity="error">
                <AlertTitle>
                  Error
                </AlertTitle>

                {
                  lastResponse.message
                }
              </Alert>
            )}

            {lastResponse &&
              !lastResponse?.error && (
                <Alert severity="success">
                  <AlertTitle>
                    Execution
                    Log
                  </AlertTitle>

                  {lastResponse
                    ?.rows?.[0]
                    ?.RESULT ||
                    "Completed"}
                </Alert>
              )}

            {jobStatus?.status ===
              "FAILED" && (
              <Alert
                severity="error"
                sx={{ mt: 2 }}
              >
                <AlertTitle>
                  Upload Failed
                </AlertTitle>

                <Typography variant="body2">
                  Failed Line :
                  <b>
                    {" "}
                    {
                      jobStatus.failedStatementNumber
                    }
                  </b>
                </Typography>

                <Box
                  sx={{
                    mt: 1,
                    p: 1,
                    bgcolor:
                      "#1e1e1e",
                    color:
                      "#ffb4b4",
                    borderRadius: 1,
                    overflow:
                      "auto",
                    maxHeight: 250,
                    fontFamily:
                      "monospace",
                  }}
                >
                  {
                    jobStatus.failedSql
                  }
                </Box>
              </Alert>
            )}

            {jobStatus?.status ===
              "COMPLETED" && (
              <Alert
                severity="success"
                sx={{ mt: 2 }}
              >
                <AlertTitle>
                  Upload
                  Completed
                </AlertTitle>

                Total Executed :
                <b>
                  {" "}
                  {
                    jobStatus.executedCount
                  }
                </b>
              </Alert>
            )}
          </Box>
        )}
      </Paper>

      {/* CONFIRM */}
      <Dialog
        open={confirmOpen}
        onClose={() =>
          setConfirmOpen(false)
        }
      >
        <DialogTitle>
          Confirm Query
        </DialogTitle>

        <DialogContent>
          <Typography>
            Execute destructive
            query?
          </Typography>
        </DialogContent>

        <DialogActions>
          <Button
            onClick={() =>
              setConfirmOpen(false)
            }
          >
            Cancel
          </Button>

          <Button
            variant="contained"
            color="error"
            onClick={() => {
              setConfirmOpen(
                false,
              );

              handleRun(true);
            }}
          >
            Execute
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default AdminSupport;