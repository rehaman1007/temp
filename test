import { createSlice, createAsyncThunk } from "@reduxjs/toolkit";
import axios from "axios";

export const startDownload = createAsyncThunk(
  "download/start",
  async (
    { url, payload, headers = {}, fileName },
    { dispatch }
  ) => {
    const downloadId = `${fileName}_${Date.now()}`;

    dispatch(downloadStarted({ downloadId, fileName }));

    const response = await axios({
      method: "POST",
      url,
      data: payload,
      responseType: "blob",
      headers,
      onDownloadProgress: (event) => {
        dispatch(
          downloadProgress({
            downloadId,
            loaded: event.loaded || 0,
          })
        );
      },
    });

    dispatch(downloadCompleted({ downloadId }));

    // trigger browser download
    const blobUrl = window.URL.createObjectURL(response.data);
    const a = document.createElement("a");
    a.href = blobUrl;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    a.remove();
    window.URL.revokeObjectURL(blobUrl);

    return downloadId;
  }
);

const downloadSlice = createSlice({
  name: "download",
  initialState: {
    active: {}, // { [downloadId]: { fileName, loaded, status } }
  },
  reducers: {
    downloadStarted: (state, action) => {
      const { downloadId, fileName } = action.payload;
      state.active[downloadId] = {
        fileName,
        loaded: 0,
        status: "DOWNLOADING",
      };
    },
    downloadProgress: (state, action) => {
      const { downloadId, loaded } = action.payload;
      if (state.active[downloadId]) {
        state.active[downloadId].loaded = loaded;
      }
    },
    downloadCompleted: (state, action) => {
      if (state.active[action.payload]) {
        state.active[action.payload].status = "COMPLETED";
      }
    },
    clearDownload: (state, action) => {
      delete state.active[action.payload];
    },
  },
});

export const {
  downloadStarted,
  downloadProgress,
  downloadCompleted,
  clearDownload,
} = downloadSlice.actions;

export default downloadSlice.reducer;

downloadStarted: (state, action) => {
  const { downloadId, fileName } = action.payload;
  state.active[downloadId] = {
    fileName,
    loaded: 0,
    lastLoaded: 0,
    lastTs: Date.now(),
    speed: 0,
    status: "DOWNLOADING",
    completedAt: null,
  };
},

downloadProgress: (state, action) => {
  const { downloadId, loaded } = action.payload;
  const d = state.active[downloadId];
  if (!d) return;

  const now = Date.now();
  const deltaBytes = loaded - d.lastLoaded;
  const deltaTime = (now - d.lastTs) / 1000; // sec

  d.speed =
    deltaTime > 0 ? deltaBytes / (1024 * 1024) / deltaTime : d.speed;

  d.lastLoaded = loaded;
  d.lastTs = now;
  d.loaded = loaded;
},

downloadCompleted: (state, action) => {
  const d = state.active[action.payload];
  if (d) {
    d.status = "COMPLETED";
    d.completedAt = Date.now();
  }
},

import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import {
  Popover,
  LinearProgress,
  Tooltip,
  Fade,
} from "@mui/material";

const downloads = useSelector((state) => state.download.active);

const activeDownloads = Object.values(downloads).filter(
  (d) => d.status === "DOWNLOADING"
);

const completedDownloads = Object.values(downloads).filter(
  (d) =>
    d.status === "COMPLETED" &&
    Date.now() - d.completedAt < 3000 // auto-hide after 3s
);

const [anchorEl, setAnchorEl] = useState(null);
const open = Boolean(anchorEl);

{(activeDownloads.length > 0 || completedDownloads.length > 0) && (
  <Tooltip
    title={
      activeDownloads.length > 0
        ? `${activeDownloads[0].fileName} • ${activeDownloads[0].speed.toFixed(
            2
          )} MB/s`
        : "Download completed"
    }
    arrow
  >
    <IconButton onClick={(e) => setAnchorEl(e.currentTarget)}>
      {activeDownloads.length > 0 ? (
        <CloudDownloadTwoToneIcon
          sx={{ color: "warning.main", animation: "pulse 1.4s infinite" }}
        />
      ) : (
        <CheckCircleIcon sx={{ color: "success.main" }} />
      )}
    </IconButton>
  </Tooltip>
)}

<style>
  {`
    @keyframes pulse {
      0% { opacity: 1 }
      50% { opacity: 0.6 }
      100% { opacity: 1 }
    }
  `}
</style>

<Popover
  open={open}
  anchorEl={anchorEl}
  onClose={() => setAnchorEl(null)}
  anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
  transformOrigin={{ vertical: "top", horizontal: "right" }}
>
  <Box sx={{ p: 2, width: 320 }}>
    <Typography variant="subtitle2" sx={{ mb: 1 }}>
      Downloads
    </Typography>

    {activeDownloads.map((d) => {
      const mb = (d.loaded / (1024 * 1024)).toFixed(2);

      return (
        <Box key={d.fileName} sx={{ mb: 2 }}>
          <Typography variant="body2" fontWeight={600}>
            {d.fileName}
          </Typography>
          <Typography variant="caption" color="text.secondary">
            {mb} MB • {d.speed.toFixed(2)} MB/s
          </Typography>
          <LinearProgress
            variant="indeterminate"
            sx={{ mt: 1, height: 6, borderRadius: 999 }}
          />
        </Box>
      );
    })}

    {completedDownloads.length > 0 && (
      <Fade in>
        <Typography
          variant="caption"
          color="success.main"
          sx={{ mt: 1, display: "block" }}
        >
          ✓ Download completed
        </Typography>
      </Fade>
    )}
  </Box>
</Popover>