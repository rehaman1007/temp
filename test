@Override
public ResponseEntity<Resource> exportData(
        AdminSupportDTO dto,
        String userId,
        HttpServletRequest request) {

    String sql = dto.getSql().trim();

    log.info("""
            
            =====================================
            EXPORT REQUEST RECEIVED
            =====================================
            User      : {}
            Type      : {}
            TableName : {}
            SQL       : {}
            =====================================
            """,
            userId,
            dto.getExportType(),
            dto.getTableName(),
            sql
    );

    if (!sql.toUpperCase().startsWith("SELECT")) {
        throw new RuntimeException(
                "Only SELECT queries can be exported"
        );
    }

    String exportType =
            dto.getExportType() == null
                    ? "CSV"
                    : dto.getExportType()
                    .trim()
                    .toUpperCase();

    log.info(
            "Resolved Export Type = {}",
            exportType
    );

    return switch (exportType) {

        case "INSERT" -> exportInsert(dto);

        case "JSON" -> exportJson(sql);

        case "EXCEL" -> exportExcel(sql);

        case "CSV" -> exportCsv(sql);

        default -> {
            log.warn(
                    "Unknown export type {}, defaulting to CSV",
                    exportType
            );

            yield exportCsv(sql);
        }
    };
}