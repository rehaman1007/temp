const { mutate: exportData, isPending: exportLoading } = useMutation({
  mutationFn: async ({
    sql,
    exportType,
    tableName,
  }) => {

    return await callApi(
      "/TS/admin-support/export-data",
      {
        sql,
        exportType,
        tableName,
      },
      "POST",
      "blob"
    );
  },

  onSuccess: (response) => {

    console.log(response);

    let format = "csv";

    switch (exportType) {
      case "EXCEL":
        format = "xlsx";
        break;

      case "JSON":
        format = "json";
        break;

      case "INSERT":
        format = "sql";
        break;

      default:
        format = "csv";
    }

    downloadFile(
      response,
      format,
      `export_${Date.now()}`
    );

    showSnackbar(
      "Export completed successfully",
      "success"
    );
  },

  onError: (e) => {
    showSnackbar(
      e?.message || "Export failed",
      "error"
    );
  },
});


case "csv":
  fileType = "text/csv";
  fileExtension = "csv";
  break;

case "json":
  fileType = "application/json";
  fileExtension = "json";
  break;

case "sql":
  fileType = "text/plain";
  fileExtension = "sql";
  break;

case "psv":
  fileType = "text/plain";
  fileExtension = "psv";
  break;