import React, { useState, useEffect } from "react";
import {
  Box,
  AppBar,
  Toolbar,
  Typography,
  IconButton,
  Button,
  CircularProgress,
  Dialog,
  Slide,
} from "@mui/material";
import {
  Close as CloseIcon,
  Download as DownloadIcon,
} from "@mui/icons-material";

// React PDF Viewer Imports
import { Worker, Viewer } from "@react-pdf-viewer/core";
import { defaultLayoutPlugin } from "@react-pdf-viewer/default-layout";

// React PDF Viewer Styles
import "@react-pdf-viewer/core/lib/styles/index.css";
import "@react-pdf-viewer/default-layout/lib/styles/index.css";

// Assuming you have this utility available for the download button
import downloadFile from "../../utils/DownloadUtils";

// Slide animation for the full-screen dialog
const Transition = React.forwardRef(function Transition(props, ref) {
  return <Slide direction="up" ref={ref} {...props} />;
});

const AdhocReportsPreview = ({
  selectedReport,
  reportPreview,
  data, // ArrayBuffer or Blob
  onClose,
}) => {
  // Initialize the default layout plugin (adds toolbar, zoom, pagination, etc.)
  const defaultLayoutPluginInstance = defaultLayoutPlugin();
  
  const [pdfUrl, setPdfUrl] = useState(null);

  useEffect(() => {
    // Convert ArrayBuffer/Blob to a readable URL for the PDF Viewer
    if (data && reportPreview) {
      let blob;
      if (data instanceof Blob) {
        blob = data;
      } else {
        blob = new Blob([data], { type: "application/pdf" });
      }

      const url = URL.createObjectURL(blob);
      setPdfUrl(url);

      // Cleanup function to avoid memory leaks
      return () => {
        URL.revokeObjectURL(url);
      };
    } else {
      setPdfUrl(null);
    }
  }, [data, reportPreview]);

  // Handle direct download from the Preview Header
  const handleDownload = () => {
    if (data) {
      const fileName = selectedReport?.fileName || selectedReport?.reportName || "Report";
      downloadFile(data, "pdf", fileName);
    }
  };

  return (
    <Dialog
      fullScreen
      open={reportPreview}
      onClose={onClose}
      TransitionComponent={Transition}
      PaperProps={{
        sx: {
          bgcolor: "#f5f5f5", // Light grey background behind the PDF viewer
        },
      }}
    >
      <AppBar sx={{ position: "relative", bgcolor: "primary.main" }}>
        <Toolbar>
          <IconButton
            edge="start"
            color="inherit"
            onClick={onClose}
            aria-label="close"
          >
            <CloseIcon />
          </IconButton>
          <Typography sx={{ ml: 2, flex: 1 }} variant="h6" component="div" noWrap>
            {selectedReport?.reportName || "PDF Preview"}
          </Typography>
          <Button
            autoFocus
            color="inherit"
            onClick={handleDownload}
            startIcon={<DownloadIcon />}
            sx={{ px: 2 }}
          >
            Download
          </Button>
        </Toolbar>
      </AppBar>

      <Box
        sx={{
          flexGrow: 1,
          overflow: "hidden",
          display: "flex",
          flexDirection: "column",
          height: "calc(100vh - 64px)", // Total height minus AppBar height
        }}
      >
        {pdfUrl ? (
          <Worker workerUrl="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js">
            <Viewer
              fileUrl={pdfUrl}
              plugins={[defaultLayoutPluginInstance]}
            />
          </Worker>
        ) : (
          <Box
            sx={{
              display: "flex",
              justifyContent: "center",
              alignItems: "center",
              height: "100%",
              flexDirection: "column",
              gap: 2,
            }}
          >
            <CircularProgress size={40} />
            <Typography color="text.secondary">
              Preparing document...
            </Typography>
          </Box>
        )}
      </Box>
    </Dialog>
  );
};

export default AdhocReportsPreview;



