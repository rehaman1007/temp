import React, { useMemo, Suspense } from "react";
import { createBrowserRouter, RouterProvider } from "react-router-dom";
import { useSelector } from "react-redux";
import PrivateRouter from "./PrivateRouter";

// Page Components
import Login from "../features/auth/pages/Login";
import Home from "../pages/Home";
import NotFound from "../pages/NotFound";
import ServerError from "../pages/ServerError";
import CommonLayout from "../layout/CommonLayout";
import FullscreenLayout from "../layout/FullscreenLayout";
import SubmenuSelectionPage from "../pages/SubmenuSelectionPage";

import { generateRouteObjects } from "./RouteGenerator";
import Help from "../features/help/Help";
import LaunchScreen from "../components/live-countdown/components/LaunchScreen";

const PageLoader = () => (
  <div
    style={{
      display: "flex",
      height: "100vh",
      justifyContent: "center",
      alignItems: "center",
    }}
  >
    Loading...
  </div>
);

const DynamicLayout = () => {
  const isComponentFullscreen = useSelector(
    (state) => state.ui.isComponentFullscreen,
  );
  return !isComponentFullscreen ? <CommonLayout /> : <FullscreenLayout />;
};

const AppRouter = () => {
  const menus = useSelector((state) => state.menus.menus);

  const router = useMemo(() => {
    const dynamicRoutes = generateRouteObjects(menus || []);

    const routeConfig = [
      {
        path: "/",
        element: <LaunchScreen />, // <-- CHANGED: Replaced <Login /> with <LaunchScreen />
        errorElement: <ServerError />,
      },
      {
        path: "/server-error",
        element: <ServerError />,
      },
      // Protected Routes
      {
        element: <PrivateRouter />,
        children: [
          {
            element: <DynamicLayout />,
            children: [
              { path: "/home", element: <Home /> },
              { path: "/help", element: <Help /> },
              {
                path: "/choose-option/:mainMenuTitle",
                element: <SubmenuSelectionPage />,
              },
              ...dynamicRoutes,
            ],
          },
        ].filter(Boolean),
      },
      {
        path: "*",
        element: <NotFound />,
      },
    ];

    return createBrowserRouter(routeConfig);
  }, [menus]);

  return (
    <Suspense fallback={<PageLoader />}>
      <RouterProvider router={router} />
    </Suspense>
  );
};

export default AppRouter;


import "./App.css";
import AppRouter from "./routes/AppRouter";
import {
  Box,
  CssBaseline,
  StyledEngineProvider,
  useColorScheme,
} from "@mui/material";
import { useEffect } from "react";
import { SnackbarProviderComponent } from "./utils/SnackbarContext";
import GlobalBackground from "./theme/GlobalBackground";
import AppTheme from "./theme/AppTheme";
import { AuthProvider } from "./context/AuthContext";

// component to handle color scheme logic
const ColorSchemeInitializer = () => {
  const { mode, setMode } = useColorScheme();

  useEffect(() => {
    // Only log and set mode if it's not undefined
    if (mode === "system" || mode === undefined) {
      setMode("light");
    }
  }, [mode, setMode]);

  // This component doesn't render anything visible, it just manages the state
  return null;
};

function App() {
  return (
    <>
      <AppTheme>
        <StyledEngineProvider enableCssLayer>
          <ColorSchemeInitializer />
          <CssBaseline enableColorScheme />
          <GlobalBackground />
          <Box
            sx={{
              transition:
                "background-color 0.6s ease, color 0.6s ease, filter 0.6s ease",
            }}
          >
            <AuthProvider>
              <SnackbarProviderComponent>
                <AppRouter />
              </SnackbarProviderComponent>
            </AuthProvider>
          </Box>
        </StyledEngineProvider>
      </AppTheme>
    </>
  );
}

export default App;
