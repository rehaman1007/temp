SELECT
    *
FROM
    users      u
    LEFT JOIN user_roles ur ON u.user_id = ur.user_id
    LEFT JOIN roles      r ON ur.role_id = r.role_id
WHERE
        u.is_deleted = 'N'
    AND r.role_id IN (
        SELECT
            role_id
        FROM
            role_permissions
        WHERE
            permission_id = 25
    );
