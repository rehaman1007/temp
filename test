import { useEffect, useRef, useState } from "react";
import * as THREE from "three";
import NET from "vanta/dist/vanta.net.min";

export default function SplashScreen() {
  const vantaRef = useRef(null);
  const [vantaEffect, setVantaEffect] = useState(null);

  useEffect(() => {
    if (!vantaEffect) {
      setVantaEffect(
        NET({
          el: vantaRef.current,
          THREE: THREE,
          mouseControls: true,
          touchControls: true,
          minHeight: 200.0,
          minWidth: 200.0,
          scale: 1.0,
          scaleMobile: 1.0,
          color: 0x00eaff,
          backgroundColor: 0x000000,
          points: 10.0,
          maxDistance: 20.0,
          spacing: 18.0,
        })
      );
    }
    return () => {
      if (vantaEffect) vantaEffect.destroy();
    };
  }, [vantaEffect]);

  return (
    <div
      ref={vantaRef}
      style={{
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        minHeight: "100vh",
        fontFamily: "'Orbitron', sans-serif",
        color: "#fff",
        textAlign: "center",
      }}
    >
      {/* Movie Title Font */}
      <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap"
        rel="stylesheet"
      />

      <style>{`
        @keyframes movieZoom {
          0% { transform: scale(0.5); filter: blur(10px); opacity: 0; }
          50% { transform: scale(1.2); filter: blur(2px); opacity: 1; }
          100% { transform: scale(1); filter: blur(0); opacity: 1; }
        }

        @keyframes shine {
          0% { background-position: -200px; }
          100% { background-position: 200px; }
        }

        @keyframes pulse {
          0%, 100% { text-shadow: 0 0 15px #00eaff, 0 0 30px #00eaff; }
          50% { text-shadow: 0 0 25px #00ffff, 0 0 50px #00ffff; }
        }

        .title {
          font-size: 120px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 8px;
          background: linear-gradient(90deg, #00ffff, #00eaff, #0077ff);
          background-size: 400%;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          animation: movieZoom 2.5s ease-out forwards, pulse 3s infinite 2.5s;
          position: relative;
        }

        .title::after {
          content: "";
          position: absolute;
          top: 0;
          left: -100%;
          width: 100%;
          height: 100%;
          background: linear-gradient(
            120deg,
            transparent 0%,
            rgba(255, 255, 255, 0.8) 50%,
            transparent 100%
          );
          animation: shine 3s linear infinite;
        }

        .subtitle {
          font-size: 22px;
          margin-top: 20px;
          opacity: 0;
          animation: fadeIn 2s ease forwards;
          animation-delay: 2.5s;
        }

        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(20px); }
          to { opacity: 1; transform: translateY(0); }
        }
      `}</style>

      <div className="title">Tranche</div>
      <div className="subtitle">The Next Generation Finance Module</div>
    </div>
  );
}