import { useCallback, useState } from "react";

export const useTaskProgress = () => {
  const [tasks, setTasks] = useState({}); 
  // { taskId: { percentage, status, message } }

  const upsertTask = useCallback((task) => {
    setTasks((prev) => ({
      ...prev,
      [task.taskId]: task,
    }));
  }, []);

  const removeTask = useCallback((taskId) => {
    setTasks((prev) => {
      const copy = { ...prev };
      delete copy[taskId];
      return copy;
    });
  }, []);

  const activeCount = Object.values(tasks).filter(
    (t) => t.percentage < 100
  ).length;

  return { tasks, upsertTask, removeTask, activeCount };
};

import {
  Box,
  Badge,
  CircularProgress,
  IconButton,
  Tooltip,
} from "@mui/material";
import AutorenewIcon from "@mui/icons-material/Autorenew";

const TaskProgressIcon = ({ activeCount, onClick }) => {
  if (!activeCount) return null;

  return (
    <Tooltip title={`${activeCount} task(s) running`}>
      <IconButton onClick={onClick}>
        <Badge badgeContent={activeCount} color="warning">
          <Box sx={{ position: "relative" }}>
            <AutorenewIcon sx={{ animation: "spin 1.2s linear infinite" }} />
            <CircularProgress
              size={36}
              sx={{
                position: "absolute",
                top: -6,
                left: -6,
                zIndex: -1,
              }}
            />
          </Box>
        </Badge>

        <style>
          {`@keyframes spin { 100% { transform: rotate(360deg); } }`}
        </style>
      </IconButton>
    </Tooltip>
  );
};

export default TaskProgressIcon;

import {
  Box,
  Drawer,
  LinearProgress,
  Stack,
  Typography,
} from "@mui/material";

const TaskProgressDrawer = ({ open, onClose, tasks }) => (
  <Drawer anchor="right" open={open} onClose={onClose}>
    <Box sx={{ width: 360, p: 2 }}>
      <Typography variant="h6" mb={2}>
        Running Tasks
      </Typography>

      <Stack spacing={2}>
        {Object.values(tasks).map((task) => (
          <Box key={task.taskId}>
            <Typography variant="body2" fontWeight={600}>
              {task.taskId}
            </Typography>
            <Typography variant="caption" color="text.secondary">
              {task.message}
            </Typography>
            <LinearProgress
              variant="determinate"
              value={task.percentage}
              sx={{ height: 8, borderRadius: 1, mt: 1 }}
            />
            <Typography variant="caption">
              {task.percentage}%
            </Typography>
          </Box>
        ))}
      </Stack>
    </Box>
  </Drawer>
);

export default TaskProgressDrawer;

const [taskDrawerOpen, setTaskDrawerOpen] = useState(false);
const {
  tasks,
  activeCount,
} = useTaskProgress(); // lift to context in real app

<TaskProgressIcon
  activeCount={activeCount}
  onClick={() => setTaskDrawerOpen(true)}
/>

<TaskProgressDrawer
  open={taskDrawerOpen}
  onClose={() => setTaskDrawerOpen(false)}
  tasks={tasks}
/>

if (event.event === "task_progress") {
  const data = JSON.parse(event.data);

  upsertTask({
    taskId: data.taskId,
    percentage: data.percentage,
    status: data.status,
    message: data.message,
  });

  if (data.percentage === 100) {
    setTimeout(() => removeTask(data.taskId), 3000);
  }
}