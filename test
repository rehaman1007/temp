import React, { useEffect } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
} from "@mui/material";
import { Close } from "@mui/icons-material";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
}) => {
  // --- API base URL ---
  const token = useSelector((state) => state.auth.token);
  console.log("token", token);


  useEffect(() => {
    const controller = new AbortController();

    fetchEventSource("/NS/notifications/stream", {
      method: "GET",
      headers: {
        Authorization: `Bearer ${token}`,
      },
      signal: controller.signal,

      onopen(response) {
        console.log("response", response);
        if (response.ok && response.status === 200) {
          console.log("SSE Connection established");
        } else if (
          response.status >= 400 &&
          response.status < 500 &&
          response.status !== 429
        ) {
          // Client-side errors (like 401) - usually fatal
          console.error("SSE Connection failed:", response.status);
        }
      },

      onmessage(event) {
        // 1. Handle the initial connection message
        if (event.event === "connected") {
          console.log("Server says:", event.data);
          return;
        }

        // 2. Handle actual notifications
        if (event.event === "new_notification") {
          const newNotification = JSON.parse(event.data);
          console.log("newNotification", newNotification);
          // setNotifications((prev) => [newNotification, ...prev]);

          // Optional: Trigger a toast or badge update here
          // toast.info(newNotification.message);
        }
      },

      onerror(err) {
        console.error("SSE Error:", err);
        // You can implement retry logic here if needed,
        // though the library handles basic retries automatically.
      },
    });

    return () => {
      controller.abort(); // Close connection on unmount
    };
  }, [token]);

  return (
    <Drawer
      anchor="right"
      open={notificationDrawerOpen}
      onClose={() => setNotificationDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: 400,
          p: 0,
        },
      }}
    >
      <Box sx={{ p: 3, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Notifications
          </Typography>
          <IconButton
            onClick={() => setNotificationDrawerOpen(false)}
            size="small"
          >
            <Close />
          </IconButton>
        </Box>
      </Box>

      <Box sx={{ p: 2 }}>
        {notifications.map((notification) => (
          <Paper
            key={notification.id}
            sx={{
              p: 2,
              mb: 2,
              border: notification.unread
                ? "1px solid #1565C0"
                : "1px solid #E2E8F0",
              backgroundColor: notification.unread ? "#F0F9FF" : "white",
              cursor: "pointer",
              "&:hover": {
                backgroundColor: "#F8FAFC",
              },
            }}
          >
            <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
              <Box
                sx={{
                  width: 8,
                  height: 8,
                  borderRadius: "50%",
                  backgroundColor:
                    notification.type === "success"
                      ? "#10B981"
                      : notification.type === "warning"
                      ? "#F59E0B"
                      : "#1565C0",
                  mt: 1,
                }}
              />
              <Box sx={{ flex: 1 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 600, mb: 0.5 }}
                >
                  {notification.title}
                </Typography>
                <Typography
                  variant="body2"
                  sx={{ color: "text.secondary", mb: 1 }}
                >
                  {notification.message}
                </Typography>
                <Typography variant="caption" sx={{ color: "text.secondary" }}>
                  {notification.time}
                </Typography>
              </Box>
            </Box>
          </Paper>
        ))}
      </Box>

      <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
        <Button fullWidth variant="outlined">
          View All Notifications
        </Button>
      </Box>
    </Drawer>
  );
};

export default NotificationDrawer;
