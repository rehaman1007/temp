import {
  Box,
  Drawer,
  LinearProgress,
  Stack,
  Typography,
  IconButton,
  Chip,
  Collapse,
} from "@mui/material";
import { Close, CheckCircle, Error } from "@mui/icons-material";
import { useState } from "react";

const statusColor = {
  PROCESSING: "info",
  COMPLETED: "success",
  FAILED: "error",
};

const TaskProgressDrawer = ({ open, onClose, tasks }) => {
  const [expanded, setExpanded] = useState(null);

  return (
    <Drawer anchor="right" open={open} onClose={onClose}>
      {/* HEADER */}
      <Box
        sx={{
          p: 3,
          borderBottom: "1px solid",
          borderColor: "divider",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Typography variant="h6" fontWeight={700}>
          Background Tasks
        </Typography>
        <IconButton size="small" onClick={onClose}>
          <Close />
        </IconButton>
      </Box>

      {/* CONTENT */}
      <Box sx={{ width: 380, p: 2 }}>
        <Stack spacing={2}>
          {Object.values(tasks).map((task) => {
            const isDone = task.percentage === 100;
            const elapsed = task.startedAt
              ? Math.floor((Date.now() - task.startedAt) / 1000)
              : null;

            const speed =
              task.lastUpdated && task.startedAt
                ? task.percentage / elapsed
                : null;

            const eta =
              speed && task.percentage < 100
                ? Math.ceil((100 - task.percentage) / speed)
                : null;

            return (
              <Box
                key={task.taskId}
                sx={{
                  p: 2,
                  borderRadius: 2,
                  bgcolor: "background.paper",
                  boxShadow: 1,
                  cursor: "pointer",
                }}
                onClick={() =>
                  setExpanded(expanded === task.taskId ? null : task.taskId)
                }
              >
                {/* HEADER ROW */}
                <Stack direction="row" justifyContent="space-between">
                  <Typography fontWeight={600}>
                    {task.taskId.replace(/_/g, " ")}
                  </Typography>

                  <Chip
                    size="small"
                    color={statusColor[task.status] || "default"}
                    label={task.status}
                    icon={
                      isDone ? (
                        <CheckCircle fontSize="small" />
                      ) : task.status === "FAILED" ? (
                        <Error fontSize="small" />
                      ) : null
                    }
                  />
                </Stack>

                {/* PROGRESS */}
                <LinearProgress
                  variant="determinate"
                  value={task.percentage}
                  sx={{
                    mt: 1.5,
                    height: 10,
                    borderRadius: 5,
                    transition: "all 0.4s ease",
                  }}
                  color={isDone ? "success" : "primary"}
                />

                {/* META */}
                <Stack
                  direction="row"
                  justifyContent="space-between"
                  mt={0.5}
                >
                  <Typography variant="caption">
                    {task.percentage}%
                  </Typography>
                  {eta && (
                    <Typography variant="caption">
                      ETA: ~{eta}s
                    </Typography>
                  )}
                </Stack>

                {/* DETAILS */}
                <Collapse in={expanded === task.taskId}>
                  <Box mt={1}>
                    <Typography variant="caption" color="text.secondary">
                      {task.message}
                    </Typography>
                    {elapsed && (
                      <Typography variant="caption" display="block">
                        Elapsed: {elapsed}s
                      </Typography>
                    )}
                  </Box>
                </Collapse>
              </Box>
            );
          })}
        </Stack>
      </Box>
    </Drawer>
  );
};

export default TaskProgressDrawer;

