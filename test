import React from "react";
import { DataGrid } from "@mui/x-data-grid";
import {
  Button,
  Typography,
  Stack,
  Box,
  styled,
  Grid,
} from "@mui/material";
import FileDownloadIcon from "@mui/icons-material/FileDownload";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import EventIcon from "@mui/icons-material/Event";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import { StyledDataBox } from "./TransactionStyles";
import CircularProgress from "@mui/material/CircularProgress";

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" color="action" />
    <Typography variant="h5" fontSize="1.2rem" color="text.secondary">
      No transactions available for the selected criteria
    </Typography>
  </OverlayBox>
);

const TransactionTable = ({
  data,
  loading,
  onDownload,
  rowCount,
  paginationModel,
  setPaginationModel,
  sortModel,
  setSortModel,
  filterModel,
  setFilterModel,
  userInputs,
  sourceOptions,
  exportLoading,
}) => {
  const rows = data?.data || [];
  const balances = data?.extraData || {};

  // =========================================================
  // FRONTEND GUARDRAIL: Check if sort is chronological
  // =========================================================
  // If sortModel is empty, the backend defaults to Date ASC.
  const isChronologicalSort =
    !sortModel ||
    sortModel.length === 0 ||
    sortModel[0]?.field === "date" ||
    sortModel[0]?.field === "postDate";

  // Hide the top summary cards if not sorted chronologically
  const showBalances =
    userInputs?.sourceFlags?.length === sourceOptions?.length &&
    !userInputs?.minAmount &&
    !userInputs?.maxAmount &&
    rows.length > 0 &&
    isChronologicalSort; // <-- Appended check here

  const transactionColumns = [
    {
      field: "date",
      headerName: "Date",
      flex: 1,
      minWidth: 120,
      filterable: false,
    },
    {
      field: "batchId",
      headerName: "Batch Id",
      flex: 0.7,
      minWidth: 100,
      filterable: true,
      valueFormatter: (value) => (value == null ? "-" : value),
    },
    {
      field: "journalNumber",
      headerName: "Journal No.",
      flex: 0.8,
      minWidth: 150,
      filterable: true,
      valueFormatter: (value) => (value == null ? "-" : value),
    },
    {
      field: "particulars",
      headerName: "Narration",
      flex: 1.5,
      minWidth: 200,
      filterable: true,
    },
    {
      field: "debitAmount",
      headerName: "Debit",
      flex: 1,
      minWidth: 150,
      headerAlign: "left",
      align: "right",
      filterable: false,
      valueFormatter: (value) => Number(value || 0).toFixed(4),
    },
    {
      field: "creditAmount",
      headerName: "Credit",
      flex: 1,
      minWidth: 150,
      headerAlign: "left",
      align: "right",
      filterable: false,
      valueFormatter: (value) => Number(value || 0).toFixed(4),
    },
    {
      field: "runningBalance",
      headerName: "Balance",
      flex: 1,
      minWidth: 170,
      headerAlign: "left",
      align: "right",
      filterable: false,
      valueFormatter: (value) => (value == null ? "-" : value),
    },
    {
      field: "sourceFlag",
      headerName: "Transaction Type",
      flex: 1,
      minWidth: 150,
      filterable: true,
      valueGetter: (value) => sourceOptions[value] || value,
    },
  ];

  // =========================================================
  // DYNAMIC COLUMNS: Remove "Balance" column if not chronological
  // =========================================================
  const activeColumns = isChronologicalSort
    ? transactionColumns
    : transactionColumns.filter((col) => col.field !== "runningBalance");

  return (
    <StyledDataBox
      sx={{
        mt: 2,
        height: "100%",
        display: "flex",
        flexDirection: "column",
        overflow: "hidden",
      }}
    >
      <Box
        sx={{
          p: { xs: 1, sm: 1.2 },
          mb: 3,
          mt: { xs: 0, sm: -2 },
          borderRadius: "16px",
          background: "rgba(255,255,255,0.1)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255,255,255,0.3)",
          boxShadow: "0 4px 20px rgba(0,0,0,0.03)",
          display: "flex",
          flexDirection: "column",
          gap: 1,
        }}
      >
        <Stack
          direction={{ xs: "column", sm: "row" }}
          justifyContent="space-between"
          alignItems={{ xs: "stretch", sm: "center" }}
          spacing={2}
        >
          <Box
            sx={{
              display: "flex",
              flexWrap: "wrap",
              alignItems: "center",
              gap: 1,
            }}
          >
            <Typography
              sx={{
                fontWeight: 800,
                color: "#1a1a1a",
                letterSpacing: "-0.5px",
                fontSize: {
                  xs: "0.95rem",
                  sm: "1rem",
                  md: "1.05rem",
                },
              }}
            >
              Transaction Ledger
            </Typography>

            <Typography
              variant="caption"
              fontWeight={700}
              sx={{
                color: "#58469f",
                textTransform: "uppercase",
                bgcolor: "rgba(88,70,159,0.1)",
                px: 1.2,
                py: 0.3,
                borderRadius: 1.5,
                fontSize: {
                  xs: "0.6rem",
                  sm: "0.65rem",
                },
              }}
            >
              {rowCount > 0
                ? `${rowCount.toLocaleString()} Records Found`
                : "No Records"}
            </Typography>
          </Box>

          <Button
            variant="contained"
            startIcon={
              exportLoading ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onDownload}
            disabled={!rowCount || loading || exportLoading}
            sx={{
              width: {
                xs: "100%",
                sm: "auto",
              },
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              minHeight: 38,
              boxShadow: "0 4px 12px rgba(88,70,159,0.3)",
              "&:hover": {
                bgcolor: "#45357a",
              },
            }}
          >
            {exportLoading ? "Exporting..." : "Export"}
          </Button>
        </Stack>

        {showBalances && balances && (
          <Grid container spacing={2}>
            {[
              {
                label: "Opening Balance",
                date: balances.openingDate || balances.OpeningDate,
                amt: balances.openingBalance,
                icon: <AccountBalanceWalletIcon />,
              },
              {
                label: "Closing Balance",
                date: balances.closingDate || balances.ClosingDate,
                amt: balances.closingBalance,
                icon: <AccountBalanceWalletIcon />,
              },
            ].map((item, index) => {
              const isNeg = item.amt < 0;
              const indicator = isNeg ? "DR" : "CR";
              const absVal = Math.abs(item.amt || 0).toFixed(4);

              const activeColor = isNeg ? "#b84646f3" : "#427a44";
              const activeBg = isNeg
                ? "linear-gradient(135deg, #fff5f5 0%, #fed7d759 100%)"
                : "linear-gradient(135deg, #f6fdf9 0%, #c6f6d556 100%)";

              return (
                <Grid
                  key={index}
                  size={{
                    xs: 12,
                    sm: 6,
                  }}
                >
                  <Box
                    sx={{
                      p: { xs: 1, sm: 0.8 },
                      borderRadius: "12px",
                      background: activeBg,
                      border: "1px solid rgba(255,255,255,0.3)",
                      borderBottom: `4px solid ${activeColor}`,
                      display: "flex",
                      flexDirection: {
                        xs: "column",
                        sm: "row",
                      },
                      alignItems: {
                        xs: "flex-start",
                        sm: "center",
                      },
                      justifyContent: "space-between",
                      gap: 1.5,
                      position: "relative",
                      overflow: "hidden",
                    }}
                  >
                    <Stack
                      direction="row"
                      spacing={2}
                      justifyContent="space-between"
                      alignItems={{ xs: "stretch", sm: "center" }}
                      sx={{ zIndex: 1 }}
                    >
                      <Box
                        sx={{
                          p: 0.6,
                          borderRadius: "10px",
                          bgcolor: "#fff",
                          display: "flex",
                          mr: 1.5,
                          boxShadow: "0 2px 6px rgba(0,0,0,0.05)",
                          color: activeColor,
                        }}
                      >
                        {item.icon}
                      </Box>
                      <Box>
                        <Typography
                          variant="caption"
                          color="text.secondary"
                          fontWeight={700}
                          sx={{
                            textTransform: "uppercase",
                            fontSize: "0.72rem",
                          }}
                        >
                          {item.label}
                        </Typography>
                        <Typography
                          variant="body2"
                          fontWeight={800}
                          sx={{ color: "#2c3e50", lineHeight: 1 }}
                        >
                          {absVal}
                          <Box
                            component="span"
                            sx={{
                              fontSize: "0.7rem",
                              ml: 0.5,
                              color: activeColor,
                              fontWeight: 900,
                            }}
                          >
                            {indicator}
                          </Box>
                        </Typography>
                      </Box>
                    </Stack>

                    {isNeg ? (
                      <TrendingDownIcon
                        sx={{
                          position: "absolute",
                          left: "50%",
                          top: "50%",
                          transform: "translate(-50%, -50%)",
                          fontSize: "2.8rem",
                          opacity: 0.25,
                          color: activeColor,
                          zIndex: 0,
                        }}
                      />
                    ) : (
                      <TrendingUpIcon
                        sx={{
                          position: "absolute",
                          left: "50%",
                          top: "50%",
                          transform: "translate(-50%, -50%)",
                          fontSize: "2.8rem",
                          opacity: 0.25,
                          color: activeColor,
                          zIndex: 0,
                        }}
                      />
                    )}

                    <Box sx={{ textAlign: "right", zIndex: 1 }}>
                      <Stack
                        direction="row"
                        alignItems="center"
                        spacing={0.5}
                        justifyContent="flex-end"
                      >
                        <EventIcon
                          sx={{ fontSize: "0.8rem", color: "text.secondary" }}
                        />
                        <Typography
                          variant="caption"
                          sx={{
                            color: "text.secondary",
                            fontWeight: 700,
                            fontSize: "0.72rem",
                          }}
                        >
                          AS OF
                        </Typography>
                      </Stack>
                      <Typography
                        variant="caption"
                        sx={{
                          color: "#2c3e50",
                          fontWeight: 700,
                          display: "block",
                        }}
                      >
                        {item.date || "N/A"}
                      </Typography>
                    </Box>
                  </Box>
                </Grid>
              );
            })}
          </Grid>
        )}
      </Box>

      <Box sx={{ flex: 1 }}>
        <DataGrid
          density="compact"
          rows={rows}
          columns={activeColumns} // <-- Pass the dynamic columns here
          loading={loading}
          disableRowSelectionOnClick
          getRowId={(row) => row.transactionId}
          paginationMode="server"
          sortingMode="server"
          filterMode="server"
          rowCount={rowCount}
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[25, 50, 75, 100]}
          sortModel={sortModel}
          onSortModelChange={setSortModel}
          filterModel={filterModel}
          onFilterModelChange={setFilterModel}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
          sx={{
            mt: -2,
            backgroundColor: "#ffffff6b",
            border: "none",
            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#f5f5f5 !important",
              fontWeight: 700,
              borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
              position: "sticky",
              top: 0,
              zIndex: 1,
            },
            "& .MuiDataGrid-virtualScroller": {
              overflowY: "auto",
            },
            "& .MuiDataGrid-main": {
              border: "none",
            },
          }}
        />
      </Box>
    </StyledDataBox>
  );
};

export default TransactionTable;
