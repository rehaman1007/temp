import React, { useState, useMemo } from "react";
import {
  Box,
  Paper,
  TextField,
  Button,
  Typography,
  Divider,
  IconButton,
  Tooltip,
  Stack,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogContentText,
  DialogActions,
  Chip,
  LinearProgress,
  useTheme,
  alpha,
} from "@mui/material";
import {
  PlayArrow,
  Storage,
  Warning,
  Terminal,
  CleaningServices,
  ContentCopy,
  FileDownload,
} from "@mui/icons-material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { useMutation } from "@tanstack/react-query";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const AdminSupport = () => {
  const theme = useTheme();
  const [query, setQuery] = useState("SELECT * FROM USERS");
  const [results, setResults] = useState({ rows: [], columns: [] });
  const [confirmOpen, setConfirmOpen] = useState(false);

  const showSnackbar = useCustomSnackbar();
  const { callApi } = useApi();

  const isDestructive = useMemo(() => {
    const q = query.toUpperCase();
    return ["DELETE", "DROP", "TRUNCATE", "UPDATE", "ALTER"].some((k) =>
      q.includes(k),
    );
  }, [query]);

  const { mutate: executeSql, isPending } = useMutation({
    mutationFn: async (sql) => {
      return await callApi(
        "/TS/transaction-con/admin-execute",
        { sql },
        "POST",
      );
    },
    onSuccess: (data) => {
      const formattedCols = (data?.columns || []).map((col) => ({
        field: col.name,
        headerName: col.name.toUpperCase(),
        flex: 1,
        minWidth: 150,
      }));
      setResults({ rows: data?.rows || [], columns: formattedCols });
      showSnackbar("Query Successful", "success");
    },
    onError: (err) => showSnackbar(err?.message || "Execution Error", "error"),
  });

  const handleRun = () => {
    if (!query.trim()) return;
    isDestructive ? setConfirmOpen(true) : executeSql(query);
  };

  return (
    <Box
      sx={{
        display: "flex",
        flexDirection: "column",
        height: "100vh",
        bgcolor: theme.palette.background.default,
        p: 2,
        gap: 2,
      }}
    >
      {/* MERGED EDITOR & EXECUTE BAR */}
      <Paper
        elevation={0}
        sx={{
          display: "flex",
          flexDirection: "column",
          border: `1px solid ${theme.palette.divider}`,
          borderRadius: 2,
          overflow: "hidden",
          bgcolor: theme.palette.background.paper,
        }}
      >
        <Box
          sx={{
            px: 2,
            py: 1,
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            bgcolor: alpha(theme.palette.action.hover, 0.5),
            borderBottom: `1px solid ${theme.palette.divider}`,
          }}
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <Terminal fontSize="small" color="primary" />
            <Typography variant="caption" fontWeight="bold">
              SQL COMMAND CENTER
            </Typography>
            {isDestructive && (
              <Chip
                label="DESTRUCTIVE"
                size="small"
                color="error"
                variant="filled"
                sx={{ height: 18, fontSize: 9 }}
              />
            )}
          </Stack>

          <Stack direction="row" spacing={1}>
            <Tooltip title="Clear Content">
              <IconButton size="small" onClick={() => setQuery("")}>
                <CleaningServices fontSize="inherit" />
              </IconButton>
            </Tooltip>
            <Tooltip title="Copy SQL">
              <IconButton
                size="small"
                onClick={() => navigator.clipboard.writeText(query)}
              >
                <ContentCopy fontSize="inherit" />
              </IconButton>
            </Tooltip>
            <Divider orientation="vertical" flexItem sx={{ mx: 0.5 }} />
            <Button
              variant="contained"
              disableElevation
              size="small"
              color={isDestructive ? "error" : "primary"}
              startIcon={<PlayArrow />}
              onClick={handleRun}
              disabled={isPending}
              sx={{ px: 2, fontWeight: "bold", textTransform: "none" }}
            >
              Execute
            </Button>
          </Stack>
        </Box>

        <TextField
          multiline
          fullWidth
          rows={6}
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onKeyDown={(e) => e.ctrlKey && e.key === "Enter" && handleRun()}
          variant="standard"
          InputProps={{
            disableUnderline: true,
            sx: {
              fontFamily: "monospace",
              fontSize: "14px",
              p: 2,
              color: theme.palette.text.primary,
            },
          }}
        />
      </Paper>

      {/* RESULTS GRID WITH EXPORT */}
      <Paper
        elevation={0}
        sx={{
          flex: 1,
          border: `1px solid ${theme.palette.divider}`,
          overflow: "hidden",
          position: "relative",
          bgcolor: theme.palette.background.paper,
          borderRadius: 2,
        }}
      >
        {isPending && (
          <LinearProgress
            sx={{ position: "absolute", top: 0, width: "100%", zIndex: 1 }}
          />
        )}
        <DataGrid
          rows={results.rows}
          columns={results.columns}
          getRowId={(row) => row.ID || row.id || Math.random()}
          loading={isPending}
          density="compact"
          // GridToolbar includes "Export" button by default (CSV and Print)
          slots={{ toolbar: GridToolbar }}
          slotProps={{
            toolbar: {
              showQuickFilter: true,
              printOptions: { disableToolbarButton: false },
              csvOptions: { fileName: `sql_export_${new Date().getTime()}` },
            },
          }}
          sx={{
            border: "none",
            "& .MuiDataGrid-columnHeaders": {
              bgcolor: alpha(theme.palette.action.hover, 0.3),
              borderBottom: `1px solid ${theme.palette.divider}`,
            },
            "& .MuiDataGrid-footerContainer": {
              borderTop: `1px solid ${theme.palette.divider}`,
            },
            "& .MuiDataGrid-toolbarContainer": {
              p: 1,
              borderBottom: `1px solid ${theme.palette.divider}`,
              gap: 1,
            },
          }}
        />
      </Paper>

      {/* CONFIRMATION DIALOG */}
      <Dialog open={confirmOpen} onClose={() => setConfirmOpen(false)}>
        <DialogTitle
          sx={{
            display: "flex",
            alignItems: "center",
            gap: 1,
            color: theme.palette.error.main,
          }}
        >
          <Warning /> Confirm Destructive Run
        </DialogTitle>
        <DialogContent>
          <DialogContentText>
            Warning: This SQL contains data-modifying statements. Execute on
            Production?
          </DialogContentText>
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button onClick={() => setConfirmOpen(false)} color="inherit">
            Abort
          </Button>
          <Button
            onClick={() => {
              setConfirmOpen(false);
              executeSql(query);
            }}
            variant="contained"
            color="error"
          >
            Proceed
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default AdminSupport;
