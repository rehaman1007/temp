    processViewData: (data) => {
      if (!data || typeof data !== "object") {
        return data;
      }
      const {
        type = "",
        filePattern = "",
        stream = "",
        frequency = "",
        includeFile = "",
        subType = "",
        key = "",
      } = data;
      /* ---------- Lookups & Mappings ---------- */

      const yesNo = (val) => (val == "Y" ? "Yes" : "No");
      const frequencyDMY = (val) => {
        if (!val) return "N/A";

        return val
          .split(/[,/|]/)
          .map((v) => v.trim())
          .filter((v) => v)
          .map((v) => {
            switch (v.toUpperCase()) {
              case "D":
                return "Daily";
              case "M":
                return "Monthly";
              case "Y":
                return "Yearly";
              default:
                return v;
            }
          })
          .join("/");
      };

      /* ---------- View Payload ---------- */

      const viewPayload = {
        type,
        filePattern,
        Stream: yesNo(stream),
        Frequency: frequencyDMY(frequency),
        includeFile,
        subType,
        "Target ID": key,
      };

      return {
        ...data,
        payload: viewPayload,
      };
    },
  },

