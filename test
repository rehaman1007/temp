package com.fincore.enquiry_service.model;

import java.util.Date;
import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
@Builder
@Table(name = "GL_BALANCE")
@Entity
public class GLBalance {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "ID")
    private Integer id;

    @Column(name = "BRANCH_CODE", nullable = false)
    private String branch;

    @Column(name = "CGL", nullable = false)
    private String cgl;

    @Column(name = "CURRENCY", nullable = false)
    private String currency;

    @Column(name = "BALANCE", nullable = false)
    private Double balance;

    @Temporal(TemporalType.DATE)
    @Column(name = "BALANCE_DATE", nullable = false)
    private Date date;
}



Page<GLBalance> records = glBalanceRepository.findByBranchAndCglAndCurrencyAndDateBetween(
				request.getBranch(), request.getCgl(), request.getCurrency(),
				adjustedStartDate, adjustedEndDate,
				pageRequest);

Page<GLBalance> findByBranchAndCglAndCurrencyAndDateBetween(String branch, String cgl, String currency,
																LocalDate startDate, LocalDate endDate, Pageable pageable);

	@Query(value = """  
		SELECT 
			c.CIRCLE_CODE,
			c.CIRCLE_NAME,
			b.NAME AS BRANCH_NAME, 
			b.CODE AS BRANCH_CODE,
			g.CGL,  
			d.DESCRIPTION AS CGL_DESCRIPTION,
			g.BALANCE_DATE,
			g.CURRENCY,
			SUM(g.BALANCE) AS TOTAL_BALANCE, 
			SUM(g.INR_BALANCE) AS TOTAL_INR_BALANCE
		FROM 
			GL_BALANCE g
		INNER JOIN 
			BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
		LEFT JOIN
			CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
		LEFT JOIN
			CGL_MASTER d ON g.CGL = d.CGL_NUMBER
		WHERE 
			g.BALANCE_DATE >= TO_DATE(:startDate,'DD/MM/YYYY') 
			AND g.BALANCE_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
			AND g.CURRENCY = :currency
			AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
			AND (:v_branch IS NULL OR b.CODE = :v_branch)
			AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
		GROUP BY 
			c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, 
			g.CGL, d.DESCRIPTION, g.BALANCE_DATE, g.CURRENCY
    """, 
    countQuery = """
        SELECT count(*) FROM (
            SELECT g.CGL FROM GL_BALANCE g
            INNER JOIN BRANCH_MASTER b ON g.BRANCH_CODE = b.CODE
            LEFT JOIN CIRCLE_MASTER c ON b.CIRCLE_CODE = c.CIRCLE_CODE
            WHERE g.BALANCE_DATE >= TO_DATE(:startDate,'DD/MM/YYYY') 
                AND g.BALANCE_DATE < TO_DATE(:endDate,'DD/MM/YYYY')
				AND g.CURRENCY = :currency
                AND (:v_circle IS NULL OR c.CIRCLE_CODE = :v_circle)
                AND (:v_branch IS NULL OR b.CODE = :v_branch)
                AND (:v_cgl IS NULL OR g.CGL = :v_cgl)
            GROUP BY c.CIRCLE_CODE, c.CIRCLE_NAME, b.NAME, b.CODE, g.CGL, g.BALANCE_DATE, g.CURRENCY
        )
    """, nativeQuery = true)
	Page<GLBalanceProjection> findGlBalances(
		@Param("startDate") String startDate,
		@Param("endDate") String endDate,
		@Param("currency") String currency,
		@Param("v_circle") String circle,
		@Param("v_branch") String branch,
		@Param("v_cgl") String cgl,
		Pageable pageable
    );
