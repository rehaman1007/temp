import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/transaction-con")
public class TransactionEnquiryController {

	public final EnquiryService service;
	private final JwtUtil jwtUtil;

	@PostMapping("/transactions")
	public PaginatedResponseDTO<GetResponseDTO> getTransactionsData(
			@RequestBody @Valid GetPayloadDTO dto) {

		return service.getTransactionsData(dto);
	}

	@PostMapping("/transactions-download")
	public ResponseEntity<byte[]> getTransactionsFile(
			@RequestHeader("Authorization") String token,
			@RequestBody @Valid GetPayloadDTO dto)
			throws IOException {

		String userId = jwtUtil.getUserIdFromToken(token);

		byte[] file = service.getTransactionsFile(dto, userId);

		HttpHeaders headers = new HttpHeaders();

		headers.setContentType(
				MediaType.parseMediaType(
						"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"));

		headers.setContentDisposition(
				ContentDisposition.builder("attachment")
						.filename("transactions.xlsx")
						.build());

		headers.setContentLength(file.length);

		return new ResponseEntity<>(
				file,
				headers,
				HttpStatus.OK);
	}

}

	
	
