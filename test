const getDateErrorMessage = (field, error) => {
  switch (error) {
    case "invalidDate":
      return `Please enter a valid ${field}`;

    case "minDate":
      return `${field} cannot be before ${MIN_ALLOWED_DATE.format(
        "DD-MM-YYYY"
      )}`;

    case "maxDate":
      return `${field} cannot exceed ETL Date`;

    case "fromGreaterThanTo":
      return "From Date must be ≤ To Date";

    case "toLessThanFrom":
      return "To Date must be ≥ From Date";

    case "rangeExceeds12Months":
      return "Range cannot exceed 12 months";

    case "afterEtlDate":
      return `Cannot exceed ETL Date (${etlDate?.format(
        "DD-MM-YYYY"
      )})`;

    default:
      return "";
  }
};

slotProps={{
  textField: {
    label: "From Date*",
    fullWidth: true,
    InputLabelProps: { shrink: true },

    error: !!fromDateError,

    helperText: fromDateError
      ? getDateErrorMessage(
          "From Date",
          fromDateError
        )
      : " ",

    FormHelperTextProps: {
      sx: {
        minHeight: 20,
        marginLeft: 0,
      },
    },

    sx: {
      "& .MuiInputLabel-root": {
        fontWeight: 500,
      },
    },
  },
}}

