  );
};

// --- Main Screen ---
export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // All states strictly initialized to null
  const [etlDate, setEtlDate] = useState(null);
  const [isAvailableToDownload, setIsAvailableToDownload] = useState(null);
  const [reports, setReports] = useState(null);
  const [loading, setLoading] = useState(null);
  const [isDownloading, setIsDownloading] = useState(null);
  
  // Preview handling states
  const [reportPreviewData, setReportPreviewData] = useState(null);
  const [previewReportDetails, setPreviewReportDetails] = useState(null);
  const [selectedReport, setSelectedReport] = useState(null);

  const fetchData = async () => {
    setLoading(true);
    try {
      const etlDetails = await callApi("/PS/process/waiting-for-approval", {}, "GET");
      const etlRaw = etlDetails?.data?.etlDate;
      const availableFlag = etlDetails?.data?.inWaitingState || true;

      const formattedEtlDate = etlRaw
        ? dayjs(etlRaw.split("T")[0]).format("DD-MM-YYYY")
        : dayjs().format("DD-MM-YYYY");

      setEtlDate(formattedEtlDate);
      setIsAvailableToDownload(availableFlag);

      if (isLastDayOfMonth(formattedEtlDate)) {
        const reportsRes = await callApi("/RS/reports/adhoc-types", {}, "GET");
        const reportsData = reportsRes?.data || reportsRes || [];
        setReports(reportsData);
      } else {
        setReports([]);
      }
    } catch (e) {
      console.error("Data fetch error:", e);
      showSnackBar("Failed to load report data. Kindly try again after sometime.", "error");
      setEtlDate(dayjs().format("DD-MM-YYYY"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleDownload = async (reportId, formatType) => {
    setIsDownloading(true);
    showSnackBar(`Generating fresh ${formatType} data...`, "info");

    try {
      const fileName = `${selectedReport.fileName}_${etlDate}`;
      const payload = {
        reportId: selectedReport.fileName || "nwsa_report",
        variantCode: "DATE_WISE",
        params: { balanceDate: "2026-03-30" },
      };

      const REPORT_DOWNLOAD_BASE_URL = "/RB/report-builder/view";
      let endpoint = `${REPORT_DOWNLOAD_BASE_URL}/pdf`; // default fallback

      if (formatType === "excel") endpoint = `${REPORT_DOWNLOAD_BASE_URL}/xlsx`;
      if (formatType === "test" || formatType === "psv") endpoint = `${REPORT_DOWNLOAD_BASE_URL}/txt`;

      const response = await callApi(endpoint, payload, "POST", "arraybuffer");
      const blobData = response?.data || response;

      if (formatType === "view") {
        setReportPreviewData(blobData);
        setPreviewReportDetails(selectedReport); // Preserve details for the inline viewer
        setSelectedReport(null); // Closes the dialog instantly
        
        // Smooth scroll to the PDF viewer container
        setTimeout(() => {
          document.getElementById('inline-pdf-viewer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 300);
      } else {
        downloadFile(blobData, formatType, fileName);
        setSelectedReport(null);
        showSnackBar(`${fileName} downloaded successfully!`, "success");
      }
    } catch (error) {
      console.error("Download Error:", error);
      showSnackBar("Failed to download the report. Please try again.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  return (
    <>
      {/* Boolean coercion used here because states initialized as null */}
      <LoadingOverlay loading={!!loading || !!isDownloading} />

      {/* Download Dialog Modal */}
      <AdhocReportsDownloadDialog
        selectedReport={selectedReport}
        setSelectedReport={setSelectedReport}
        handleDownload={handleDownload}
        isAvailableToDownload={!!isAvailableToDownload}
      />

      <Grow in timeout={500}>
        <Stack spacing={4}>
          <Box sx={{ width: "100%", p: { xs: 2, sm: 3, md: 4 } }}>
            <Stack spacing={4} direction="column" alignItems="center" justifyContent="center">
              
              {/* Main Report Container */}
              <Card sx={{ width: "100%", borderRadius: 3, boxShadow: 6, overflow: "hidden" }}>
                <Box
                  sx={{
                    display: "flex",
                    flexDirection: { xs: "column", md: "row" },
                    alignItems: { xs: "flex-start", md: "center" },
                    justifyContent: "space-between",
                    gap: 3,
                    px: { xs: 3, md: 4 },
                    py: { xs: 3, md: 3 },
                    background: "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 100%)",
                    color: "white",
                  }}
                >
                  <Box sx={{ display: "flex", alignItems: "center", gap: 2, flex: 1 }}>
                    <Box sx={{ borderRadius: "50%", p: 1.5, bgcolor: "rgba(255,255,255,0.15)", display: "flex" }}>
                      <DescriptionIcon sx={{ width: { xs: 35, md: 45 }, height: { xs: 35, md: 45 } }} />
                    </Box>
                    <Box>
                      <Typography variant="h5" fontWeight="bold">Adhoc Reports Generation</Typography>
                      <Typography variant="body2" sx={{ opacity: 0.9, maxWidth: 600, mt: 0.5 }}>
                        View and download your monthly reports. Data is generated freshly upon request when the month-end ETL processing has completed.
                      </Typography>
                    </Box>
                  </Box>

                  <Box sx={{ bgcolor: "rgba(0,0,0,0.2)", borderRadius: 3, p: 2, display: "flex", flexDirection: "column", alignItems: { xs: "flex-start", md: "flex-end" }, gap: 1, minWidth: "fit-content" }}>
                    <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                      <CalendarMonthIcon fontSize="small" sx={{ opacity: 0.8 }} />
                      <Typography variant="caption" fontWeight="bold" sx={{ opacity: 0.9, letterSpacing: 0.5 }}>
                        ETL Date : {etlDate || "--"}
                      </Typography>
                    </Box>
                  </Box>
                </Box>

                <Box sx={{ p: { xs: 2, md: 4 } }}>
                  {!loading && etlDate && !isLastDayOfMonth(etlDate) ? (
                    <Container maxWidth="sm" sx={{ py: 6 }}>
                      <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.5 }}>
                        <Paper elevation={0} sx={{ p: 6, borderRadius: 4, textAlign: "center", border: "1px solid", borderColor: "divider", bgcolor: "white", boxShadow: "0 4px 20px rgba(0,0,0,0.03)" }}>
                          <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} transition={{ delay: 0.2, type: "spring", stiffness: 150 }}>
                            <EventBusyIcon sx={{ fontSize: 80, color: "text.secondary", mb: 3, opacity: 0.3 }} />
                          </motion.div>
                          <Typography variant="h5" fontWeight="bold" gutterBottom color="text.primary">Not a Month-End Cycle</Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>Adhoc Reports are strictly generated as part of the month-end activity.</Typography>
                          <Typography variant="body1" color="text.secondary" sx={{ mb: 1 }}>The current ETL Date processed is <strong>{etlDate}</strong>.</Typography>
                          <Typography variant="body1" color="text.secondary">Please check back during the month-end processing cycle.</Typography>
                        </Paper>
                      </motion.div>
                    </Container>
                  ) : (
                    <Grid container spacing={3}>
                      {reports?.map((report, index) => (
                        // Size prop is used directly on Grid
                        <Grid size={{ xs: 12, sm: 6, md: 4 }} key={report.id || index}>
                          <motion.div initial={{ opacity: 0, y: 30 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.4, delay: index * 0.1 }} style={{ height: "100%" }}>
                            <ReportCard report={report} onClick={() => setSelectedReport(report)} />
                          </motion.div>
                        </Grid>
                      ))}

                      {reports?.length === 0 && (
                        <Grid size={{ xs: 12 }}>
                          <Typography align="center" color="text.secondary" sx={{ py: 8 }}>
                            No reports configured for this date.
                          </Typography>
                        </Grid>
                      )}
                    </Grid>
                  )}
                </Box>
              </Card>

              {/* Inline PDF Preview Component below Reports */}
              {reportPreviewData && previewReportDetails && (
                <AdhocReportsPreview
                  selectedReport={previewReportDetails}
                  data={reportPreviewData}
                  onClose={() => {
                    setReportPreviewData(null);
                    setPreviewReportDetails(null);
                  }}
                />
              )}

            </Stack>
          </Box>
        </Stack>
      </Grow>
    </>
  );
}

import React from "react";
import {
  Box,
  Typography,
  IconButton,
  Card,
  Paper
} from "@mui/material";
import { Close as CloseIcon, PictureAsPdfRounded } from "@mui/icons-material";
import { motion } from "framer-motion";
import PDFView from "../../utils/PDFView"; 

const AdhocReportsPreview = ({
  selectedReport,
  data, // ArrayBuffer or Blob
  onClose,
}) => {
  if (!data) return null;

  return (
    <motion.div
      id="inline-pdf-viewer"
      initial={{ opacity: 0, y: 50 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: -20 }}
      transition={{ duration: 0.5, type: "spring" }}
      style={{ width: "100%" }}
    >
      <Card sx={{ width: "100%", borderRadius: 3, boxShadow: 6, overflow: "hidden" }}>
        
        {/* Inline Header mimicking the Main Card */}
        <Box
          sx={{
            display: "flex",
            flexDirection: { xs: "column", md: "row" },
            alignItems: "center",
            justifyContent: "space-between",
            px: { xs: 3, md: 4 },
            py: 2,
            background: "linear-gradient(90deg, #5D3FD3 0%, #7b1fa2 100%)",
            color: "white",
          }}
        >
          <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
             <Box sx={{ borderRadius: "50%", p: 1, bgcolor: "rgba(255,255,255,0.15)", display: "flex" }}>
               <PictureAsPdfRounded sx={{ fontSize: 28 }} />
             </Box>
             <Box>
                <Typography variant="h6" fontWeight="bold">
                  {selectedReport?.reportName || "Document Preview"}
                </Typography>
             </Box>
          </Box>

          <IconButton onClick={onClose} sx={{ color: "white", bgcolor: "rgba(0,0,0,0.2)", '&:hover': { bgcolor: "rgba(0,0,0,0.4)" } }}>
            <CloseIcon />
          </IconButton>
        </Box>

        {/* PDF Container Box */}
        <Box
          sx={{
            height: "800px", // Fixed viewer height mapping
            width: "100%",
            bgcolor: "#e0e0e0", // Slight grey boundary behind the pdf
            p: { xs: 1, md: 2 } 
          }}
        >
          <Paper elevation={3} sx={{ height: "100%", width: "100%", borderRadius: 2, overflow: "hidden" }}>
            <PDFView reportName={selectedReport?.reportName} data={data} />
          </Paper>
        </Box>
        
      </Card>
    </motion.div>
  );
};

export default AdhocReportsPreview;

