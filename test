import { useEffect, useState, useRef, useMemo } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ProcessStatusTable from "./components/ProcessStatusTable";
import ProcessDetailsDialog from "./components/ProcessDetailsDialog";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";
import {
  Grid,
  Box,
  Button,
  Paper,
  Stack,
  Tooltip,
  Typography,
} from "@mui/material";
import PlayArrowIcon from "@mui/icons-material/PlayArrow";
import TaskAltIcon from "@mui/icons-material/TaskAlt";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import EventOutlinedIcon from "@mui/icons-material/EventOutlined";
import ProcessSummaryDialog from "./components/ProcessSummaryDialog";
import ProcessStatusHeader from "./components/ProcessStatusHeader";

/* ================= NORMALIZERS ================= */
const normalizeStageDetails = (stageDetails = []) => {
  return Array.from(stageDetails.values()).map((s) => ({
    ...s,
    _START_TIME_RAW: s.startTime,
    _END_TIME_RAW: s.endTime,
    startTime: s.startTime ? timeStampFormatter(s.startTime) : null,
    endTime: s.endTime ? timeStampFormatter(s.endTime) : null,
  }));
};

const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType,
    stageDetails: normalizeStageDetails(p.stageDetails),
  }));

const mergeProcesses = (prev = [], incoming = []) => {
  const map = new Map(prev.map((p) => [p.type, p]));
  incoming.forEach((p) => map.set(p.type, p));
  return Array.from(map.values());
};

const formattedDate = (dateString) =>
  new Intl.DateTimeFormat("en-GB")
    .format(new Date(dateString))
    .replace(/\//g, "-");

function formatCustomDate(dateString) {
  const date = new Date(dateString);

  const getOrdinalSuffix = (day) => {
    if (day > 3 && day < 21) return "th";
    switch (day % 10) {
      case 1:
        return "st";
      case 2:
        return "nd";
      case 3:
        return "rd";
      default:
        return "th";
    }
  };

  const monthNames = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];
  const dayNames = [
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
  ];

  const dayOfMonth = date.getDate();
  const month = monthNames[date.getMonth()];
  const year = date.getFullYear();
  const dayOfWeek = dayNames[date.getDay()];

  return `${dayOfMonth}${getOrdinalSuffix(dayOfMonth)} ${month} ${year} (${dayOfWeek})`;
}

const ProcessStatusPage = () => {
  const [fincoreDate, setFincoreDate] = useState(null);
  const [processes, setProcesses] = useState([]);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [loading, setLoading] = useState(true);
  const [summaryData, setSummaryData] = useState(null);

  const snackbar = useCustomSnackbar();
  const token = useSelector((state) => state.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const INITIAL_URL = "/PS/process/processes/data";
  const STREAM_URL = `${service}/process/processes`;

  /* ================= INITIAL LOAD ================= */
  const initialFetchDone = useRef(false);

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    callApi(INITIAL_URL)
      .then((data) => {
        setFincoreDate(data?.fincoreDate || null);
        setProcesses(normalizeProcesses(data?.initialData || []));
      })
      .catch(() => snackbar("Failed to load processes"))
      .finally(() => setLoading(false));
  }, [callApi, snackbar]);

  /* ================= SSE ================= */
  useEffect(() => {
    if (loading) return;

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },
      onmessage(e) {
        if (e.event === "connected") return;
        const raw = JSON.parse(e.data);
        setProcesses((prev) =>
          mergeProcesses(prev, normalizeProcesses(raw?.initialData)),
        );
      },
    });

    return () => controller.abort();
  }, [STREAM_URL, loading, token]);

  /* ================= DERIVED UI STATES ================= */
  const hasProcesses = processes.length > 0;

  const allCompleted = useMemo(
    () =>
      processes.length > 0 &&
      processes.every((p) => p.stageDetails.every((s) => s.status === 2)),
    [processes],
  );

  const differenceSummary = useMemo(() => {
    const diff = processes.find((p) => p.type === "DIFFERENCE");
    if (!diff) return null;

    const latestStage = [...(diff.stageDetails || [])]
      .sort((a, b) => b.id - a.id)
      .find((s) => s.processStage === "6");

    if (latestStage?.status === 2 && latestStage?.differenceSummary) {
      setSummaryData(latestStage.differenceSummary);
      return latestStage.differenceSummary;
    }
    return null;
  }, [processes]);

  return (
    <Paper sx={{ p: 3, minHeight: "75vh" }}>
      <ProcessStatusHeader processes={processes} />

      {/* ================= ETL DATE CARD ================= */}
      {fincoreDate?.etlDate && (
        <Tooltip
          title={`ETL run date for ${formatCustomDate(fincoreDate.etlDate)}`}
        >
          <Stack alignItems="center" mt={2} mb={3}>
            <Paper
              elevation={3}
              sx={{
                px: 3,
                py: 1.5,
                display: "flex",
                alignItems: "center",
                gap: 1.5,
                borderRadius: 2,
                bgcolor: "background.paper",
              }}
            >
              <EventOutlinedIcon color="primary" />
              <Box>
                <Typography variant="caption" color="text.secondary">
                  ETL Date (System Generated)
                </Typography>
                <Typography fontWeight={600}>
                  {formattedDate(fincoreDate.etlDate)}
                </Typography>
              </Box>
            </Paper>
          </Stack>
        </Tooltip>
      )}

      {/* ================= ACTION BUTTONS ================= */}
      <Grid container spacing={2} justifyContent="center" mb={3}>
        <Grid>
          <Tooltip title={hasProcesses ? "EOD already started" : ""}>
            <span>
              <Button
                variant="contained"
                size="large"
                startIcon={<PlayArrowIcon />}
                disabled={hasProcesses}
              >
                Start EOD
              </Button>
            </span>
          </Tooltip>
        </Grid>

        {differenceSummary && (
          <Grid>
            <Button
              variant="outlined"
              size="large"
              startIcon={<VisibilityOutlinedIcon />}
              onClick={() => setSummaryData(differenceSummary)}
            >
              View Summary
            </Button>
          </Grid>
        )}

        <Grid>
          <Tooltip title={!allCompleted ? "Processes still running" : ""}>
            <span>
              <Button
                variant="contained"
                size="large"
                startIcon={<TaskAltIcon />}
                disabled={!allCompleted}
                color="success"
              >
                Finish EOD
              </Button>
            </span>
          </Tooltip>
        </Grid>
      </Grid>

      {/* ================= DIALOGS ================= */}
      <ProcessDetailsDialog
        process={selectedProcess}
        onClose={() => setSelectedProcess(null)}
      />

      <ProcessSummaryDialog
        open={!!summaryData}
        data={summaryData}
        onClose={() => setSummaryData(null)}
      />

      {/* ================= TABLE ================= */}
      <Box mt={4}>
        <ProcessStatusTable
          loading={loading}
          processes={processes}
          actions={{
            onView: setSelectedProcess,
            onStop: () => {},
            onRestart: () => {},
          }}
        />
      </Box>
    </Paper>
  );
};

export default ProcessStatusPage;


import {
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  IconButton,
  Tooltip,
  Typography,
  CircularProgress,
  TablePagination,
  Box,
  Stack,
} from "@mui/material";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import VisibilityIcon from "@mui/icons-material/Visibility";
import ProcessStatusChip from "./ProcessStatusChip";
import { StageStatus } from "../util/StageStatus";
import { useState, useMemo } from "react";

/* ------------------ Action Button ------------------ */
const Action = ({ title, icon, disabled, onClick }) => (
  <Tooltip title={title}>
    <span>
      <IconButton size="small" disabled={disabled} onClick={onClick}>
        {icon}
      </IconButton>
    </span>
  </Tooltip>
);

const ProcessStatusTable = ({ processes = [], actions, loading }) => {
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(5);

  /* ======================================================
     FILTER FIRST (IMPORTANT FIX)
  ====================================================== */
  const validProcesses = useMemo(
    () => processes.filter((p) => p.stageDetails && p.stageDetails.length > 0),
    [processes],
  );

  /* ======================================================
     PAGINATE AFTER FILTER
  ====================================================== */
  const paginatedData = useMemo(
    () =>
      validProcesses.slice(
        page * rowsPerPage,
        page * rowsPerPage + rowsPerPage,
      ),
    [validProcesses, page, rowsPerPage],
  );

  const handleChangePage = (_, newPage) => {
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  return (
    <Paper elevation={1}>
      <TableContainer
        component={Paper}
        sx={{
          maxHeight: 420,
        }}
      >
        <Table stickyHeader size="small">
          <TableHead>
            <TableRow>
              <TableCell>Process</TableCell>
              <TableCell align="center">Status</TableCell>
              <TableCell align="center">Stage</TableCell>
              <TableCell align="center">Started</TableCell>
              <TableCell align="center">Ended</TableCell>
              <TableCell align="center">Actions</TableCell>
            </TableRow>
          </TableHead>

          <TableBody>
            {/* ------------------ Loading ------------------ */}
            {loading && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Box
                    sx={{
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      py: 2,
                    }}
                  >
                    <CircularProgress size={20} />
                    <Typography variant="caption" ml={1}>
                      Loading processes, please wait…
                    </Typography>
                  </Box>
                </TableCell>
              </TableRow>
            )}

            {/* ------------------ Data ------------------ */}
            {!loading &&
              paginatedData.map((p) => {
                const lastStage = p.stageDetails[p.stageDetails.length - 1];

                return (
                  <TableRow
                    key={p.processType}
                    hover
                    sx={{
                      bgcolor:
                        lastStage.status === StageStatus.STARTED
                          ? "action.hover"
                          : "inherit",
                    }}
                  >
                    <TableCell
                      sx={{
                        fontWeight: 500,
                        whiteSpace: "nowrap",
                      }}
                    >
                      {p.processType}
                    </TableCell>

                    <TableCell align="center">
                      <ProcessStatusChip status={lastStage.status} />
                    </TableCell>

                    <TableCell align="center" sx={{ whiteSpace: "nowrap" }}>
                      {lastStage.stage.title}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.startTime || "—"}
                    </TableCell>

                    <TableCell align="center">
                      {lastStage.endTime || "—"}
                    </TableCell>

                    <TableCell align="center">
                      <Stack direction="row" spacing={1}>
                        <Action
                          title="Stop"
                          icon={<StopIcon fontSize="small" />}
                          disabled={lastStage.status !== StageStatus.STARTED}
                          onClick={actions.onStop}
                        />
                        <Action
                          title="Restart"
                          icon={<RestartAltIcon fontSize="small" />}
                          disabled={lastStage.status !== StageStatus.ERROR}
                          onClick={actions.onRestart}
                        />
                        <Action
                          title="View"
                          icon={<VisibilityIcon fontSize="small" />}
                          onClick={() => actions.onView(p)}
                        />
                      </Stack>
                    </TableCell>
                  </TableRow>
                );
              })}

            {/* ------------------ Empty State ------------------ */}
            {!loading && validProcesses.length === 0 && (
              <TableRow>
                <TableCell colSpan={6} align="center">
                  <Typography color="error.light">
                    Processes Not Available
                  </Typography>
                </TableCell>
              </TableRow>
            )}
          </TableBody>
        </Table>
      </TableContainer>

      {/* ------------------ Pagination ------------------ */}
      {!loading && validProcesses.length > rowsPerPage && (
        <TablePagination
          component="div"
          count={validProcesses.length}
          page={page}
          onPageChange={handleChangePage}
          rowsPerPage={rowsPerPage}
          onRowsPerPageChange={handleChangeRowsPerPage}
          rowsPerPageOptions={[5, 10, 25]}
          labelRowsPerPage="Rows"
        />
      )}
    </Paper>
  );
};

export default ProcessStatusTable;


