import React, { useState, useEffect, useMemo } from "react";
import { Box, Fab } from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

import CGLGrid from "./CGLGrid";
import CGLForm from "./CGLForm";
import BlockDialog from "./BlockDialog";

export default function CGLMasterTab() {
  const [rows, setRows] = useState([]);
  const [openForm, setOpenForm] = useState(false);
  const [editingData, setEditingData] = useState(null);
  const [openBlockDialog, setOpenBlockDialog] = useState(false);
  const [selectedCGL, setSelectedCGL] = useState(null);

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const fetchData = async () => {
    const response = await callApi("/CM/cgls", { requestType: "CGL_CODE" }, "GET");
    if (response) setRows(response.data || []);
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleEdit = (row) => {
    setEditingData(row);
    setOpenForm(true);
  };

  const handleCreate = () => {
    setEditingData(null);
    setOpenForm(true);
  };

  const handleBlockClick = (row) => {
    setSelectedCGL(row);
    setOpenBlockDialog(true);
  };

  const handleBlocked = () => {
    fetchData();
    setOpenBlockDialog(false);
  };

  return (
    <Box sx={{ width: "100%" }}>
      <CGLGrid rows={rows} onEdit={handleEdit} onBlock={handleBlockClick} />

      <Fab
        onClick={handleCreate}
        color="primary"
        variant="extended"
        sx={{
          position: "fixed",
          bottom: 80,
          right: 40,
          borderRadius: 1,
        }}
      >
        <AddIcon sx={{ mr: 1 }} />
        Create
      </Fab>

      {openForm && (
        <CGLForm
          open={openForm}
          onClose={() => setOpenForm(false)}
          editingData={editingData}
          refresh={fetchData}
        />
      )}

      <BlockDialog
        open={openBlockDialog}
        onClose={() => setOpenBlockDialog(false)}
        cgl={selectedCGL}
        onBlocked={handleBlocked}
      />
    </Box>
  );
}

import React from "react";
import { DataGrid } from "@mui/x-data-grid";
import { IconButton, Tooltip, Stack } from "@mui/material";
import EditIcon from "@mui/icons-material/Edit";
import CustomChip from "../../utils/CustomChip";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import NoteIcon from "@mui/icons-material/Note";
import OnlinePredictionIcon from "@mui/icons-material/OnlinePrediction";

const classificationIcons = {
  A: <AccountBalanceIcon fontSize="small" />,
  L: <AccountBalanceWalletIcon fontSize="small" />,
  I: <TrendingUpIcon fontSize="small" />,
  E: <TrendingDownIcon fontSize="small" />,
  M: <NoteIcon fontSize="small" />,
};

const ACCOUNT_CLASSIFICATIONS = {
  A: "Asset",
  L: "Liability",
  I: "Income",
  E: "Expense",
  M: "Memo A/c",
};

export default function CGLGrid({ rows, onEdit, onBlock }) {
  const columns = [
    { field: "cglNumber", headerName: "CGL CODE", flex: 1 },
    { field: "description", headerName: "Description", flex: 3 },

    {
      field: "acClassification",
      headerName: "Account Classification",
      flex: 1,
      align: "center",
      headerAlign: "center",
      renderCell: ({ row }) => (
        <CustomChip
          icon={classificationIcons[row.acClassification]}
          label={ACCOUNT_CLASSIFICATIONS[row.acClassification]}
          variant="outlined"
          size="small"
        />
      ),
    },

    {
      field: "defBalType",
      headerName: "Type",
      flex: 1,
      align: "center",
      renderCell: ({ row }) => {
        const isDebit = row.defBalType === "D";
        return (
          <CustomChip
            icon={isDebit ? <TrendingDownIcon /> : <TrendingUpIcon />}
            label={isDebit ? "Debit" : "Credit"}
            variant="outlined"
            size="small"
          />
        );
      },
    },

    {
      field: "status",
      headerName: "Status",
      flex: 1,
      align: "center",
      renderCell: ({ row }) => (
        <CustomChip
          icon={<OnlinePredictionIcon />}
          label={row.status === 1 ? "Active" : "Inactive"}
          variant="outlined"
          size="small"
        />
      ),
    },

    {
      field: "actions",
      headerName: "Actions",
      flex: 1,
      align: "center",
      renderCell: ({ row }) => (
        <Stack direction="row" spacing={1}>
          <Tooltip title="Edit">
            <IconButton size="small" onClick={() => onEdit(row)}>
              <EditIcon fontSize="small" />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <DataGrid
      rows={rows}
      columns={columns}
      getRowId={(row) => row.cglNumber}
      disableRowSelectionOnClick
      pageSizeOptions={[5, 10, 25]}
      initialState={{
        pagination: { paginationModel: { pageSize: 10, page: 0 } },
      }}
    />
  );
}

import React, { useEffect, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  IconButton,
  Typography,
  Box,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

import CGLFormFields from "./CGLFormFields";
import { initialCGLState } from "./constants";

export default function CGLForm({ open, onClose, editingData, refresh }) {
  const [cglData, setCglData] = useState(initialCGLState);
  const [errors, setErrors] = useState({});
  const snackbar = useCustomSnackbar();
  const { callApi } = useApi();

  useEffect(() => {
    if (editingData) {
      setCglData({
        ...editingData,
        comp1: String(editingData.comp1).padStart(4, "0"),
        comp2: String(parseInt(editingData.comp2)).padStart(1),
      });
    } else {
      setCglData(initialCGLState);
    }
  }, [editingData]);

  const handleSubmit = async () => {
    const payload = {
      requestType: "CGL_CODE",
      changeType: editingData ? "UPDATE" : "ADD",
      payload: {
        ...cglData,
        balFwd: cglData.balFwd ? 1 : 0,
      },
    };

    const res = await callApi("/CR/create-request", payload, "POST");
    if (res) {
      snackbar("Saved successfully", "success");
      refresh();
      onClose();
    }
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="sm">
      <DialogTitle>
        <Box display="flex" justifyContent="space-between">
          <Typography variant="h6" color="primary">
            {editingData ? "Edit CGL" : "Add CGL"}
          </Typography>
          <IconButton onClick={onClose}>
            <CloseIcon />
          </IconButton>
        </Box>
      </DialogTitle>

      <DialogContent>
        <CGLFormFields
          data={cglData}
          setData={setCglData}
          errors={errors}
          setErrors={setErrors}
          editing={!!editingData}
        />
      </DialogContent>

      <DialogActions>
        <Button variant="contained" onClick={handleSubmit}>
          {editingData ? "Update" : "Add"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}

import React from "react";
import { Dialog, DialogTitle, DialogContent, DialogActions, Button } from "@mui/material";

export default function BlockDialog({ open, onClose, cgl, onBlocked }) {
  if (!cgl) return null;

  return (
    <Dialog open={open} onClose={onClose}>
      <DialogTitle>Block CGL</DialogTitle>
      <DialogContent>
        Are you sure you want to block CGL <b>{cgl.cglNumber}</b>?
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose}>Cancel</Button>
        <Button color="error" variant="contained" onClick={onBlocked}>
          Block
        </Button>
      </DialogActions>
    </Dialog>
  );
}
import React, { useEffect, useRef, useCallback } from "react";
import {
  Grid,
  Box,
  TextField,
  MenuItem,
  Paper,
  Typography,
  FormControlLabel,
  Checkbox,
  FormHelperText,
  FormControl,
  FormLabel,
  RadioGroup,
  FormControlLabel as RadioControlLabel,
  Radio,
} from "@mui/material";
import {
  TrendingUp as TrendingUpIcon,
  TrendingDown as TrendingDownIcon,
  AccountBalance as AccountBalanceIcon,
  AccountBalanceWallet as AccountBalanceWalletIcon,
  Note as NoteIcon,
} from "@mui/icons-material";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const ACCOUNT_CLASSIFICATIONS = [
  { value: "A", label: "Asset", icon: <AccountBalanceIcon fontSize="small" /> },
  { value: "L", label: "Liability", icon: <AccountBalanceWalletIcon fontSize="small" /> },
  { value: "I", label: "Income", icon: <TrendingUpIcon fontSize="small" /> },
  { value: "E", label: "Expense", icon: <TrendingDownIcon fontSize="small" /> },
  { value: "M", label: "Memo A/c", icon: <NoteIcon fontSize="small" /> },
];

/**
 * Props:
 *  - data: object (cglData)
 *  - setData: function to update cglData
 *  - errors: object
 *  - setErrors: function
 *  - editing: boolean (true when editing)
 *  - segments: array of segment objects (optional) - if you want to pass from parent
 */
export default function CGLFormFields({
  data,
  setData,
  errors,
  setErrors,
  editing = false,
  segments = [],
}) {
  const snackbar = useCustomSnackbar();
  const snackGateRef = useRef(true);
  const notifyOnce = (msg, variant = "warning") => {
    if (!snackGateRef.current) return;
    snackGateRef.current = false;
    snackbar(msg, variant);
    setTimeout(() => (snackGateRef.current = true), 700);
  };

  // Helper: first digit of comp1 if present
  const comp1FirstDigit = (val) => {
    if (!val) return "";
    return String(val).charAt(0);
  };

  // Auto-classify when comp1 changes (works on edit too)
  useEffect(() => {
    const comp1 = data.comp1 || "";
    if (!comp1) return;

    const first = comp1FirstDigit(comp1);
    let autoClass = "";
    if (["1", "6"].includes(first)) autoClass = "A";
    else if (["2", "3", "4"].includes(first)) autoClass = "L";
    else if (first === "5") autoClass = "M";
    else if (first === "7") autoClass = "I";
    else if (first === "8") autoClass = "E";
    else autoClass = "";

    // Only set if different; if autoClass empty, do not override user selection
    if (autoClass && autoClass !== data.acClassification) {
      setData((prev) => ({ ...prev, acClassification: autoClass }));
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [data.comp1]);

  // Auto-set defBalType + enforce balFwd & balCompare when classification changes
  useEffect(() => {
    const cls = data.acClassification;
    if (!cls) return;

    let defBalType = data.defBalType;
    // Default balance mapping:
    // Asset -> Debit (D)
    // Liability -> Credit (C)
    // Memo -> Memo (M)
    // Income -> Credit (C)
    // Expense -> Debit (D)
    if (cls === "A") defBalType = "D";
    else if (cls === "L") defBalType = "C";
    else if (cls === "M") defBalType = "M";
    else if (cls === "I") defBalType = "C";
    else if (cls === "E") defBalType = "D";

    // Balance carry forward:
    // A,L -> checked & disabled
    // I,E -> unchecked & disabled
    // M/other -> leave as-is (enabled)
    let balFwd = data.balFwd;
    if (["A", "L"].includes(cls)) balFwd = true;
    else if (["I", "E"].includes(cls)) balFwd = false;

    // Balance compare: disable for I/E and force exclude "0"
    let balCompare = data.balCompare;
    if (["I", "E"].includes(cls)) balCompare = "0";

    setData((prev) => ({
      ...prev,
      defBalType,
      balFwd,
      balCompare,
    }));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [data.acClassification]);

  // Single-field validation
  const validateField = useCallback((name, value) => {
    switch (name) {
      case "comp1":
        if (!value) return "Comp1 is required";
        if (!/^\d{4}$/.test(value)) return "Comp1 must be exactly 4 digits";
        if (parseInt(value, 10) < 1000) return "Comp1 must be ≥ 1000";
        return "";
      case "segmentCode":
        if (!value) return "Segment code is required";
        return "";
      case "comp2":
        if (!value) return "Comp2 is required";
        if (!/^\d{1,2}$/.test(value)) return "Comp2 must be 1 or 2 digits";
        if (parseInt(value, 10) < 1 || parseInt(value, 10) > 99)
          return "Comp2 must be between 01 and 99";
        return "";
      case "description":
        if (!value) return "Description is required";
        if (!/^[A-Za-z0-9 /&()\-]+$/.test(value))
          return "Only letters, digits, spaces, / & ( ) -";
        return "";
      case "acClassification":
        if (!value) return "Account classification is required";
        return "";
      default:
        return "";
    }
  }, []);

  // Generic onChange handler for all form controls
  const handleChange = useCallback(
    (e) => {
      const { name, value, type, checked } = e.target;

      // input blocking / sanitization
      if (name === "comp1") {
        // allow only digits
        if (!/^\d*$/.test(value)) {
          notifyOnce("Comp1 accepts digits only");
          return;
        }
        if (value.length > 4) {
          notifyOnce("Comp1 must be exactly 4 digits");
          return;
        }
        // update comp1; auto-classification effect will run
        setData((prev) => ({ ...prev, comp1: value }));
        setErrors((prev) => ({ ...prev, comp1: validateField("comp1", value) }));
        return;
      }

      if (name === "comp2") {
        if (!/^\d*$/.test(value)) {
          notifyOnce("Comp2 accepts digits only");
          return;
        }
        if (value.length > 2) {
          notifyOnce("Comp2 max 2 digits");
          return;
        }
      }

      if (name === "description") {
        if (!/^[A-Za-z0-9 /&()\-]*$/.test(value)) {
          notifyOnce("Invalid character in Description");
          return;
        }
      }

      // For checkbox values
      const newVal = type === "checkbox" ? checked : value;

      setData((prev) => ({ ...prev, [name]: newVal }));
      setErrors((prev) => ({ ...prev, [name]: validateField(name, newVal) }));
    },
    [setData, setErrors, validateField]
  );

  // helpers to determine disabled states
  const isAccountClassificationAutoLocked = () => {
    const first = comp1FirstDigit(data.comp1);
    return ["1", "2", "3", "4", "5", "6", "7", "8"].includes(first);
  };

  const isBalFwdDisabled = ["A", "L", "I", "E"].includes(data.acClassification);
  const isBalCompareDisabled = ["I", "E"].includes(data.acClassification);

  // UI
  return (
    <Box component="div" sx={{ mt: 1 }}>
      <Grid container spacing={2}>
        {/* comp1 / segment / comp2 row */}
        <Grid item xs={12}>
          <Box display="flex" gap={1}>
            <TextField
              fullWidth
              label="Comp1 *"
              name="comp1"
              value={data.comp1}
              onChange={handleChange}
              error={!!errors.comp1}
              helperText={errors.comp1 || "Exactly 4 digits (≥1000)"}
              placeholder="1000 to 9999"
              disabled={editing} // disable comp1 during edit
              inputProps={{ maxLength: 4, inputMode: "numeric" }}
            />

            <TextField
              fullWidth
              select
              label="Segment Code *"
              name="segmentCode"
              value={data.segmentCode}
              onChange={handleChange}
              error={!!errors.segmentCode}
              helperText={errors.segmentCode}
              disabled={editing} // disable during edit
            >
              <MenuItem value="">Select Segment</MenuItem>
              {segments.map((seg) => (
                <MenuItem key={seg.segmentCode} value={seg.segmentCode}>
                  {seg.segmentCode} - {seg.description}
                </MenuItem>
              ))}
            </TextField>

            <TextField
              fullWidth
              label="Comp2 *"
              name="comp2"
              value={data.comp2}
              onChange={handleChange}
              error={!!errors.comp2}
              helperText={errors.comp2 || "01 - 99"}
              placeholder="01-99"
              disabled={editing} // disable comp2 during edit
              inputProps={{ maxLength: 2, inputMode: "numeric" }}
            />
          </Box>
        </Grid>

        {/* CGL Number preview */}
        <Grid item xs={12}>
          <Paper variant="outlined" sx={{ p: 2, width: 550 }}>
            <Typography variant="body2" color="textSecondary">
              CGL Number
            </Typography>
            <Typography variant="h6">
              {data.comp1 && data.segmentCode && data.comp2
                ? `${String(data.comp1)}${String(data.segmentCode)}${String(
                    data.comp2
                  ).padStart(2, "0")}`
                : ""}
            </Typography>
          </Paper>
        </Grid>

        {/* Description */}
        <Grid item xs={12} sx={{ width: 600 }}>
          <TextField
            fullWidth
            label="Description *"
            name="description"
            value={data.description}
            onChange={handleChange}
            error={!!errors.description}
            inputProps={{ maxLength: 100 }}
            helperText={errors.description || "Allowed: letters, numbers, spaces, / & ( ) -"}
            multiline
            rows={3}
          />
        </Grid>

        {/* Account Classification + (hidden) Default Balance Type */}
        <Grid item xs={12} sx={{ width: 600 }}>
          <Box display="flex" gap={2}>
            <TextField
              select
              fullWidth
              label="Account Classification *"
              name="acClassification"
              value={data.acClassification}
              onChange={handleChange}
              error={!!errors.acClassification}
              helperText={
                errors.acClassification ||
                (data.acClassification ? "" : "Will be auto-set based on Comp1 if possible")
              }
              // disable when comp1 clearly determines classification
              disabled={isAccountClassificationAutoLocked()}
            >
              <MenuItem value="">Select Classification</MenuItem>
              {ACCOUNT_CLASSIFICATIONS.map((option) => (
                <MenuItem key={option.value} value={option.value}>
                  <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                    {option.icon}
                    <span>{option.label}</span>
                  </Box>
                </MenuItem>
              ))}
            </TextField>

            {/* Default Balance Type is intentionally NOT rendered (hidden) */}
          </Box>
        </Grid>

        {/* Balance Carry Forward */}
        <Grid item xs={12} sx={{ width: 550 }}>
          <FormControlLabel
            control={
              <Checkbox
                name="balFwd"
                checked={!!data.balFwd}
                onChange={handleChange}
                disabled={isBalFwdDisabled}
              />
            }
            label="Balance Carry Forward to next year"
          />
          <FormHelperText>
            {["I", "E"].includes(data.acClassification)
              ? "Not applicable for Income/Expense accounts"
              : ["A", "L"].includes(data.acClassification)
              ? "Auto-enabled for Asset & Liability"
              : ""}
          </FormHelperText>
        </Grid>

        {/* Balance Compare Flag */}
        <Grid item xs={12} md={6}>
          <FormControl component="fieldset">
            <FormLabel component="legend">Balance Compare Flag</FormLabel>
            <RadioGroup
              row
              name="balCompare"
              value={isBalCompareDisabled ? "0" : data.balCompare}
              onChange={handleChange}
            >
              <RadioControlLabel
                value="1"
                control={<Radio />}
                label="Include"
                disabled={isBalCompareDisabled}
              />
              <RadioControlLabel
                value="0"
                control={<Radio />}
                label="Exclude"
                disabled={isBalCompareDisabled}
              />
            </RadioGroup>
          </FormControl>
        </Grid>

        {/* Manual Posting Flag */}
        <Grid item xs={12} md={6}>
          <FormControl component="fieldset">
            <FormLabel component="legend">Manual Posting Flag</FormLabel>
            <RadioGroup row name="manualPosting" value={data.manualPosting} onChange={handleChange}>
              <RadioControlLabel value="1" control={<Radio />} label="Allowed" />
              <RadioControlLabel value="0" control={<Radio />} label="Not Allowed" />
            </RadioGroup>
          </FormControl>
        </Grid>
      </Grid>
    </Box>
  );
}
