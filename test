const validationMessages = [
  fromDateError && getDateErrorMessage(fromDateError),
  toDateError && getDateErrorMessage(toDateError),
].filter(Boolean);


<Grid size={{ xs: 12 }}>
  {validationMessages.length > 0 && (
    <Paper
      elevation={0}
      sx={{
        mt: 1,
        p: 1.5,
        borderRadius: 2,
        border: "1px solid",
        borderColor: "#ff4d4f",
        bgcolor: "#fff1f0",
      }}
    >
      <Stack spacing={0.5}>
        {validationMessages.map((msg, index) => (
          <Typography
            key={index}
            variant="body2"
            sx={{
              color: "#d32f2f",
              fontWeight: 600,
            }}
          >
            • {msg}
          </Typography>
        ))}
      </Stack>
    </Paper>
  )}
</Grid>



const getDateErrorMessage = (field, error) => {
  switch (error) {
    case "maxDate":
      return `${field} cannot be in future`;

    case "minDate":
      return `${field} cannot be before ${minLimit.format("DD/MM/YYYY")}`;

    case "invalidDate":
      return `Please enter a valid ${field}`;

    case "fromGreaterThanTo":
      return "From Date cannot be greater than To Date";

    case "toLessThanFrom":
      return "To Date cannot be less than From Date";

    default:
      return "";
  }
};

const validationMessages = [
  fromDateError &&
    getDateErrorMessage("From Date", fromDateError),

  toDateError &&
    getDateErrorMessage("To Date", toDateError),
].filter(Boolean);