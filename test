<DatePicker
  label="ETL Date (DD-MM-YYYY)"
  format="DD-MM-YYYY"
  views={["year", "month", "day"]}
  minDate={dayjs("2025-11-01")}
  maxDate={dayjs(currentEtlDate)}
  value={selectedDate}
  disabled={loading || apiLoading}
  onChange={(d) => {
    setSelectedDate(d);
    setIsTypingDate(true); // user is interacting
  }}
  onAccept={(d) => {
    // fires only when user selects a valid date
    if (!dateError && d?.isValid()) {
      setIsTypingDate(false);
      loadByDate(d); // ✅ SAFE API CALL
    }
  }}
  onError={(err) => {
    setDateError(err); // 'maxDate' | 'minDate' | 'invalidDate' | null
  }}
  slotProps={{
    textField: {
      error: Boolean(dateError),
      helperText: dateError
        ? getDateErrorMessage(dateError, currentEtlDate)
        : "Select or type a valid ETL date",
      placeholder: "DD-MM-YYYY",
    },
  }}
/>