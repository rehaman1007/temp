import { useEffect, useRef, useState, useCallback } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import { resolveConfig } from "../config/EnvironmentConfig";

const useStreamApi = () => {
  const token = useSelector((state) => state.auth.token);
  const controllerRef = useRef(null);

  const [connected, setConnected] = useState(false);

  const startStream = useCallback(
    (
      url,
      {
        onNotification,
        onTaskProgress,
        onOpen,
        onError,
      } = {}
    ) => {
      if (!token) {
        console.warn("No token, cannot start SSE stream");
        return;
      }

      // resolve service
      const parts = url.split("/");
      const resolved = resolveConfig(`/${parts[1]}`);
      parts[1] = resolved;
      const finalUrl = parts.slice(1).join("/");

      // abort old connection
      controllerRef.current?.abort();
      controllerRef.current = new AbortController();

      fetchEventSource(finalUrl, {
        method: "GET",
        headers: { Authorization: `Bearer ${token}` },
        signal: controllerRef.current.signal,

        onopen(response) {
          if (response.ok) {
            setConnected(true);
            onOpen?.();
          } else {
            throw new Error("SSE connection failed");
          }
        },

        onmessage(event) {
          if (!event.data) return;

          // 🔹 CONNECT EVENT
          if (event.event === "connected") return;

          // 🔔 NOTIFICATIONS
          if (event.event === "new_notification") {
            onNotification?.(JSON.parse(event.data));
            return;
          }

          // ⚙️ TASK PROGRESS
          if (event.event === "task_progress") {
            onTaskProgress?.(JSON.parse(event.data));
          }
        },

        onerror(err) {
          console.error("SSE error", err);
          setConnected(false);
          onError?.(err);
        },
      });
    },
    [token]
  );

  const stopStream = useCallback(() => {
    controllerRef.current?.abort();
    controllerRef.current = null;
    setConnected(false);
  }, []);

  useEffect(() => stopStream, [stopStream]);

  return { connected, startStream, stopStream };
};

export default useStreamApi;

import { useCallback, useState } from "react";

export const useTaskProgress = () => {
  const [tasks, setTasks] = useState({});

  const upsertTask = useCallback((task) => {
    setTasks((prev) => ({
      ...prev,
      [task.taskId]: {
        ...prev[task.taskId],
        ...task,
      },
    }));
  }, []);

  const removeTask = useCallback((taskId) => {
    setTasks((prev) => {
      const copy = { ...prev };
      delete copy[taskId];
      return copy;
    });
  }, []);

  const activeCount = Object.values(tasks).filter(
    (t) => t.percentage < 100
  ).length;

  return { tasks, upsertTask, removeTask, activeCount };
};

import { useEffect, useState } from "react";
import useStreamApi from "./useStreamApi";
import { useTaskProgress } from "./useTaskProgress";

const useNotifications = () => {
  const { upsertTask, removeTask } = useTaskProgress();

  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [popNotification, setPopNotification] = useState(null);

  const { startStream } = useStreamApi();

  useEffect(() => {
    startStream("/notifications/stream", {
      onNotification: (data) => {
        setNotifications((prev) => [data, ...prev]);
        setUnreadCount((c) => c + 1);
        setPopNotification(data);
      },

      onTaskProgress: (data) => {
        upsertTask({
          taskId: data.taskId,
          percentage: data.percentage,
          status: data.status,
          message: data.message,
        });

        // 🧹 cleanup after completion
        if (data.percentage === 100) {
          setTimeout(() => removeTask(data.taskId), 3000);
        }
      },
    });
  }, [startStream, upsertTask, removeTask]);

  return {
    notifications,
    unreadCount,
    popNotification,
    setPopNotification,
  };
};

export default useNotifications;