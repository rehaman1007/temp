import React, { useEffect, useMemo, useState } from "react";
import { Backdrop, Typography, Fade, Box } from "@mui/material";

// Reusable animated dots using keyframes
const dotStyle = {
  width: "12px",
  height: "12px",
  borderRadius: "50%",
  backgroundColor: "#fff",
  animation: "bounce 1.4s infinite ease-in-out both",
  margin: "0 5px",
};

const dotContainerStyle = {
  display: "flex",
  justifyContent: "center",
  alignItems: "center",
  mt: 2,
};

const LoadingOverlay = ({ loading, messages }) => {
  const defaultMessages = [
    "Fincore processing your request...",
    "Just a moment...",
  ];

  const loadingMessages = useMemo(() => {
    return Array.isArray(messages) && messages.length > 0
      ? messages
      : defaultMessages;
  }, [messages]);

  const [messageIndex, setMessageIndex] = useState(0);

  useEffect(() => {
    let interval;
    if (loading && loadingMessages.length > 1) {
      interval = setInterval(() => {
        setMessageIndex((prev) => (prev + 1) % loadingMessages.length);
      }, 2000);
    }
    return () => clearInterval(interval);
  }, [loading, loadingMessages]);

  return (
    <>
      <style>
        {`
          @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1.0); }
          }
        `}
      </style>
      <Backdrop
        open={loading}
        sx={{
          color: "#fff",
          zIndex: (theme) => theme.zIndex.drawer + 10000,
          flexDirection: "column",
          display: "flex",
          backdropFilter: "blur(0.5px)",
        }}
      >
        {/* Animated dot loader */}
        <Box sx={dotContainerStyle}>
          {[0, 1, 2].map((i) => (
            <Box
              key={i}
              sx={{
                ...dotStyle,
                animationDelay: `${i * 0.2}s`,
              }}
            />
          ))}
        </Box>

        {/* Rotating messages */}
        <Fade in={true} key={messageIndex} timeout={500}>
          <Typography
            variant="h6"
            sx={{ userSelect: "none", padding: "10px", mt: 2 }}
          >
            {loadingMessages[messageIndex]}
          </Typography>
        </Fade>
      </Backdrop>
    </>
  );
};

export default LoadingOverlay;
