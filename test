import React, {
  useContext,
  useEffect,
  useState,
  useMemo,
  useCallback,
} from "react";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { AuthContext } from "../context/AuthContext";
import { userAvatarCreator } from "../utils/userUtilities";

// MUI Icons
import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  Link as LinkIcon,
  ContentCopy,
  VisibilityOff,
  Home,
  Visibility,
  Check,
  Public,
  CellTower,
  Security,
  Badge,
  ExpandMore,
} from "@mui/icons-material";

// MUI Components
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Drawer,
  IconButton,
  Button,
  Stack,
  Typography,
  useTheme,
  useMediaQuery,
  Tooltip,
  Divider,
  Accordion,
  AccordionSummary,
  AccordionDetails,
} from "@mui/material";
import CustomChip from "../utils/CustomChip";

// --- Helper Functions ---
const formatCode = (code, length) => {
  if (code === undefined || code === null || code === "") return "N/A";
  return String(code).padStart(length, "0");
};

const maskPhoneNumber = (phone, isVisible) => {
  if (!phone) return "N/A";
  if (isVisible) return phone;
  const visibleDigits = phone.slice(-4);
  const maskedSection = "X".repeat(Math.max(0, phone.length - 4));
  return `${maskedSection}${visibleDigits}`;
};

// --- Reusable UI Component for Info Rows ---
// eslint-disable-next-line no-unused-vars
const DetailRow = ({ icon: Icon, label, value }) => (
  <Box sx={{ display: "flex", alignItems: "flex-start", gap: 2 }}>
    <Icon sx={{ color: "text.secondary", fontSize: 20, mt: 0.5 }} />
    <Box>
      {label && (
        <Typography
          variant="caption"
          color="text.secondary"
          sx={{ display: "block", mb: 0.25 }}
        >
          {label}
        </Typography>
      )}
      <Typography variant="body2" sx={{ fontWeight: 500, lineHeight: 1.4 }}>
        {value}
      </Typography>
    </Box>
  </Box>
);

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);
  const theme = useTheme();
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));

  // States
  const [showPhone, setShowPhone] = useState(false);
  const [emailCopied, setEmailCopied] = useState(false);

  // Memoized Display Values
  const userName = useMemo(
    () =>
      [user?.firstName, user?.middleName, user?.lastName]
        .filter(Boolean)
        .join(" "),
    [user],
  );

  const branchDisplay = useMemo(
    () =>
      user?.branchName
        ? `${formatCode(user.branch, 5)} - ${user.branchName}`
        : "N/A",
    [user?.branchName, user?.branch],
  );

  const circleDisplay = useMemo(
    () =>
      user?.circleName
        ? `${formatCode(user.circleCode, 3)} - ${user.circleName}`
        : "N/A",
    [user?.circleName, user?.circleCode],
  );

  // Dynamically combine address (Removed Zone and NMR as per request)
  const combinedAddress = useMemo(() => {
    const parts = [
      user?.address,
      user?.city,
      user?.stateName,
      user?.pincode ? `PIN: ${user.pincode}` : null,
    ].filter(Boolean);

    return parts.length > 0 ? parts.join(", ") : "N/A";
  }, [user]);

  // Handlers
  const handleCopyEmail = () => {
    if (user?.email) {
      navigator.clipboard.writeText(user.email);
      setEmailCopied(true);
      setTimeout(() => setEmailCopied(false), 2000);
    }
  };

  const closeDrawer = useCallback(
    () => setProfileDrawerOpen(false),
    [setProfileDrawerOpen],
  );

  useEffect(() => {
    const handleKeyDown = (event) => {
      if (
        !isMobileOrTablet &&
        event.code === "KeyL" &&
        (event.altKey || event.getModifierState("AltGraph"))
      ) {
        event.preventDefault();
        logout();
      }
      if (event.key === "Escape" && profileDrawerOpen) {
        closeDrawer();
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, isMobileOrTablet, closeDrawer]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={closeDrawer}
      sx={{
        "& .MuiDrawer-paper": {
          // THIS IS THE FIX: Responsive width layout
          width: { xs: "85vw", sm: 350, md: 400 },
          maxWidth: "100vw",
          boxSizing: "border-box",
          display: "flex",
          flexDirection: "column",
        },
      }}
    >
      {/* HEADER */}
      <Box sx={{ p: 1.5, borderBottom: "1px solid #E2E8F0" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Content */}
      <Box sx={{ p: { xs: 2, sm: 3 }, overflowY: "auto", flex: 1 }}>
        {/* User Identity Section */}
        {/* <Box sx={{ display: "flex", alignItems: "center", gap: 2, mb: 2 }}>
          <Avatar
            sx={{
              width: 60,
              height: 60,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "2rem",
              fontWeight: 600,
              boxShadow: theme.shadows[2],
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Box sx={{ flex: 1, minWidth: 0 }}>
            <Typography
              variant="h6"
              sx={{ fontWeight: 700, lineHeight: 1.2, mb: 0.25 }}
            >
              {userName}
            </Typography>
            <Typography
              variant="body2"
              color="text.primary"
              noWrap
              sx={{ fontWeight: 500, mb: 1 }}
            >
              User ID: <strong>{user?.userId || "N/A"}</strong>
            </Typography>
          </Box>
        </Box> */}

        <Box sx={{ textAlign: "center", mb: 2 }}>
          <Avatar
            sx={{
              width: 60,
              height: 60,
              mx: "auto",
              mb: 2,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "2rem",
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Typography
            variant="h6"
            sx={{ fontWeight: 700, lineHeight: 1.2, mb: 0.25 }}
          >
            {userName}
          </Typography>
          <Typography
            variant="body2"
            color="text.primary"
            noWrap
            sx={{ fontWeight: 500, mb: 1 }}
          >
            User ID: <strong>{user?.userId || "N/A"}</strong>
          </Typography>
        </Box>

        <Box sx={{ display: "flex", flexDirection: "column", mb: 1 }}>
          {/* Role Box */}
          <Box
            sx={{
              p: 1.5,
              mb: 1.5,
              borderRadius: 2,
              backgroundColor: (theme) => `${theme.palette.info.main}14`,
              borderLeft: "5px solid",
              borderColor: "info.main",
              display: "flex",
              alignItems: "center", // You may want to change this to "flex-start" if the text gets very long
              gap: 1.5,
            }}
          >
            <Badge
              sx={{ fontSize: 22, color: "info.main", flexShrink: 0, mt: 0.5 }}
            />
            <Box sx={{ minWidth: 0 }}>
              <Typography
                variant="body2"
                sx={{ fontWeight: 700, lineHeight: 1.3 }}
                noWrap
              >
                {user?.roleName || "UNKNOWN"}
              </Typography>
              {user?.roleDescription && (
                <Typography
                  variant="caption"
                  color="text.secondary"
                  // Removed noWrap here
                  sx={{
                    lineHeight: 1.3,
                    display: "block",
                    wordBreak: "break-word",
                  }}
                >
                  {user.roleDescription}
                </Typography>
              )}
            </Box>
          </Box>

          {/* Access Box */}
          <Box
            sx={{
              p: 1.5,
              mb: 1,
              borderRadius: 2,
              backgroundColor: (theme) => `${theme.palette.warning.main}14`,
              borderLeft: "5px solid",
              borderColor: "warning.main",
              display: "flex",
              alignItems: "center", // Consider "flex-start" here too if wrapping spans multiple lines
              gap: 1.5,
            }}
          >
            <Security
              sx={{
                fontSize: 22,
                color: "warning.main",
                flexShrink: 0,
                mt: 0.5,
              }}
            />
            <Box sx={{ minWidth: 0 }}>
              <Typography
                variant="body2"
                sx={{ fontWeight: 700, lineHeight: 1.3 }}
                noWrap
              >
                {user?.accessName || "UNASSIGNED"}
              </Typography>
              {user?.accessDescription && (
                <Typography
                  variant="caption"
                  color="text.secondary"
                  // Removed noWrap here
                  sx={{
                    lineHeight: 1.3,
                    display: "block",
                    wordBreak: "break-word",
                  }}
                >
                  {user.accessDescription}
                </Typography>
              )}
            </Box>
          </Box>
        </Box>

        {/* Service Information */}
        <Card sx={{ mb: 2, boxShadow: "none", border: "1px solid #E2E8F0" }}>
          <CardContent sx={{ p: 2, "&:last-child": { pb: 2 } }}>
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              SERVICE INFORMATION
            </Typography>
            <Divider sx={{ mt: 1, mb: 1 }} />
            <Stack spacing={2}>
              <DetailRow icon={Business} label="Branch" value={branchDisplay} />
              <DetailRow
                icon={AccountTree}
                label="Circle"
                value={circleDisplay}
              />
              <DetailRow
                icon={Public}
                label="Zone"
                value={user?.zoneName || "N/A"}
              />
              <DetailRow
                icon={CellTower}
                label="NMR Code"
                value={user?.nmrCode || "N/A"}
              />
              <DetailRow
                icon={Home}
                label="Address & Location"
                value={combinedAddress}
              />
            </Stack>
          </CardContent>
        </Card>

        {/* Contact Information */}
        <Accordion
          disableGutters
          elevation={0}
          sx={{
            mb: 2,
            border: "1px solid #E2E8F0",
            borderRadius: "12px",
            "&:before": {
              display: "none",
            },
            "&:first-of-type": {
              borderTopLeftRadius: "12px",
              borderTopRightRadius: "12px",
            },
            "&:last-of-type": {
              borderBottomLeftRadius: "12px",
              borderBottomRightRadius: "12px",
            },
          }}
        >
          <AccordionSummary
            expandIcon={<ExpandMore />}
            aria-controls="contact-content"
            id="contact-header"
            sx={{ px: 2, py: 1 }}
          >
            <Typography
              variant="subtitle2"
              color="primary"
              sx={{
                fontWeight: 700,
                fontSize: "0.7rem",
                letterSpacing: "1px",
              }}
            >
              CONTACT INFORMATION
            </Typography>
          </AccordionSummary>
          <AccordionDetails sx={{ px: 2, pb: 2, pt: 0 }}>
            <Divider sx={{ mb: 2 }} />
            <Stack spacing={2}>
              {/* Email Row */}
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  gap: 1.5,
                }}
              >
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1.5,
                    overflow: "hidden",
                  }}
                >
                  <Email sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box sx={{ minWidth: 0 }}>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Email
                    </Typography>
                    <Typography variant="body2" sx={{ wordBreak: "break-all" }}>
                      {user?.email || "N/A"}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title={emailCopied ? "Copied!" : "Copy Email"}>
                  <IconButton
                    onClick={handleCopyEmail}
                    size="small"
                    sx={{
                      color: emailCopied ? "success.main" : "text.secondary",
                    }}
                  >
                    {emailCopied ? (
                      <Check fontSize="small" />
                    ) : (
                      <ContentCopy fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>

              {/* Phone Row */}
              <Box
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                }}
              >
                <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
                  <Phone sx={{ color: "text.secondary", fontSize: 18 }} />
                  <Box>
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ display: "block", lineHeight: 1 }}
                    >
                      Contact No
                    </Typography>
                    <Typography
                      variant="body2"
                      sx={{ fontSize: "0.875rem", letterSpacing: "2px" }}
                    >
                      {maskPhoneNumber(user?.phoneNumber, showPhone)}
                    </Typography>
                  </Box>
                </Box>
                <Tooltip title="Hold to reveal">
                  <IconButton
                    onMouseDown={() => setShowPhone(true)}
                    onMouseUp={() => setShowPhone(false)}
                    onMouseLeave={() => setShowPhone(false)}
                    onTouchStart={() => setShowPhone(true)}
                    onTouchEnd={() => setShowPhone(false)}
                    size="small"
                    sx={{ color: "text.secondary" }}
                  >
                    {showPhone ? (
                      <Visibility fontSize="small" />
                    ) : (
                      <VisibilityOff fontSize="small" />
                    )}
                  </IconButton>
                </Tooltip>
              </Box>
            </Stack>
          </AccordionDetails>
        </Accordion>

        {/* Footer Actions */}
        <Box>
          {/* Help & SCORE */}
          <Stack direction="row" spacing={1} sx={{ mb: 2 }}>
            <Box
              onClick={() => {
                navigate("/help");
                closeDrawer();
              }}
              sx={{
                flex: 1,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 0.75,
                py: 1,
                px: 1,
                borderRadius: "10px",
                cursor: "pointer",
                border: "1px solid #E2E8F0",
                color: "text.primary",
                fontWeight: 600,
                fontSize: "0.8rem",
                transition: "all 0.2s ease",
                "&:hover": {
                  borderColor: "primary.main",
                  backgroundColor: (theme) => `${theme.palette.primary.main}0A`,
                },
              }}
            >
              <Help sx={{ fontSize: 18, color: "primary.main" }} />
              Help
            </Box>

            <Box
              component="a"
              href="https://score.sbi/"
              target="_blank"
              rel="noopener noreferrer"
              sx={{
                flex: 1,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: 0.75,
                py: 1,
                px: 1.5,
                borderRadius: "10px",
                cursor: "pointer",
                border: "1px solid #E2E8F0",
                color: "text.primary",
                fontWeight: 600,
                fontSize: "0.8rem",
                transition: "all 0.2s ease",
                textDecoration: "none",
                "&:hover": {
                  borderColor: "primary.main",
                  backgroundColor: (theme) => `${theme.palette.primary.main}0A`,
                },
              }}
            >
              <LinkIcon sx={{ fontSize: 18, color: "primary.main" }} />
              SCORE
            </Box>
          </Stack>

          {/* Sign Out */}
          <Box
            onClick={logout}
            sx={{
              display: "flex",
              alignItems: "center",
              gap: 1,
              p: 1.5,
              borderRadius: "12px",
              cursor: "pointer",
              borderLeft: "4px solid transparent",
              transition: "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
              color: "error.main",
              "&:hover": {
                backgroundColor: (theme) => `${theme.palette.error.main}14`,
                borderLeftColor: "error.main",
                "& .logout-icon": {
                  transform: "translateX(3px)",
                  color: "error.dark",
                },
                "& .shortcut-hint": {
                  opacity: 1,
                  transform: "scale(1.05)",
                  backgroundColor: "error.main",
                  color: "white",
                },
              },
            }}
          >
            <Logout
              className="logout-icon"
              sx={{
                fontSize: 18,
                color: "error.light",
                transition: "transform 0.3s ease",
              }}
            />
            <Typography
              variant="body2"
              sx={{ fontWeight: 700, letterSpacing: "0.3px", flex: 1 }}
            >
              Sign Out
            </Typography>
            {!isMobileOrTablet && (
              <Box
                className="shortcut-hint"
                sx={{
                  fontSize: "9px",
                  fontWeight: 800,
                  px: 1,
                  py: 0.3,
                  borderRadius: "6px",
                  border: "1px solid",
                  borderColor: "divider",
                  opacity: 0.6,
                  transition: "all 0.3s ease",
                  textTransform: "uppercase",
                }}
              >
                Alt + L
              </Box>
            )}
          </Box>
        </Box>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
