import React, { useState, useEffect, useRef } from "react";
import { useDispatch, useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { Typography, Button, Box, TextField } from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import api from "../../../config/axiosConfig";
import { parseJwt } from "../../../utils/EncryptionUtilities";
import { loginSuccess } from "../../../store/slices/authSlice";
import { setMenus, setSelectedMenuItem } from "../../../store/slices/menuSlice";
import { setTabId } from "../../../store/slices/tabSlice";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  userId,
  otpData,
  openLoginErrorDialog,
  onBackToHome,
}) => {
  const showSnackbar = useCustomSnackbar();
  
  const [otpValues, setOtpValues] = useState(new Array(6).fill(""));
  const [isLoading, setIsLoading] = useState(false);
  const [wrongAttempts, setWrongAttempts] = useState(0);

  // --- API Driven Timers & Limits ---
  const [currentTxnId, setCurrentTxnId] = useState(otpData?.transactionId || "");
  const [expiresIn, setExpiresIn] = useState(otpData?.expiresInSeconds || 300);
  const [cooldown, setCooldown] = useState(otpData?.resendCooldownSeconds || 30);
  const [resendsLeft, setResendsLeft] = useState(otpData?.resendsRemaining ?? 5);

  const navigate = useNavigate();
  const dispatch = useDispatch();
  const menus = useSelector((state) => state.menus.menus);
  const inputRefs = useRef([]);

  // Focus the first input box when the component mounts
  useEffect(() => {
    if (inputRefs.current[0]) {
      inputRefs.current[0].focus();
    }
  }, []);

  // Global Countdown Timer
  useEffect(() => {
    const timer = setInterval(() => {
      setExpiresIn((prev) => (prev > 0 ? prev - 1 : 0));
      setCooldown((prev) => (prev > 0 ? prev - 1 : 0));
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  // Formats seconds into MM:SS
  const formatTime = (seconds) => {
    const m = Math.floor(seconds / 60).toString().padStart(2, "0");
    const s = (seconds % 60).toString().padStart(2, "0");
    return `${m}:${s}`;
  };

  useEffect(() => {
    if (menus && menus.length > 0 && menus[0]?.route) {
      if (menus[0].hasChildren) {
        navigate("/choose-option" + menus[0]?.route);
      } else {
        navigate(menus[0]?.route);
      }
    }
  }, [menus, navigate]);

  const otpString = otpValues.join("");

  // Helper to extract timer limits from any fresh OTP API response
  const updateTimersFromResponse = (data) => {
    if (data?.transactionId) setCurrentTxnId(data.transactionId);
    if (data?.expiresInSeconds) setExpiresIn(data.expiresInSeconds);
    if (data?.resendCooldownSeconds) setCooldown(data.resendCooldownSeconds);
    if (data?.resendsRemaining !== undefined) setResendsLeft(data.resendsRemaining);
  };

  const forceResendOTP = async () => {
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(new Array(6).fill(""));
      showSnackbar("3 invalid attempts. A new OTP has been forcefully sent.", "warning");
      inputRefs.current[0]?.focus();
    } catch (err) {
      console.error("Forced OTP generation fault:", err);
      // Hard failures still use the dialog to stop user progression
      openLoginErrorDialog(
        "System Error",
        "Failed to cycle a new validation token automatically.",
      );
    }
  };

  const handleResendClick = async () => {
    if (resendsLeft <= 0) {
      showSnackbar("Maximum manual resend limit reached.", "error");
      return;
    }

    setIsLoading(true);
    try {
      const res = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        {
          userId,
          transactionId: currentTxnId,
        },
      );

      updateTimersFromResponse(res?.data?.data);
      setWrongAttempts(0);
      setOtpValues(new Array(6).fill(""));
      showSnackbar(res?.data?.message || "A new OTP has been dispatched.", "success");
      inputRefs.current[0]?.focus();
    } catch (err) {
      const msg = err.response?.data?.message || "Failed to resend authentication code.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  const handleVerifyOTP = async () => {
    if (otpString.length !== 6) {
      showSnackbar("Please complete the 6-digit verification code.", "warning");
      return;
    }

    setIsLoading(true);

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          userId,
          transactionId: currentTxnId,
          otp: otpString,
        },
      );

      const isSuccess = response?.data?.success === true;
      const result = response?.data?.data || {};

      if (isSuccess) {
        if (result?.roleData?.root_menus?.length === 0) {
          openLoginErrorDialog(
            "Access Denied",
            "You don't have enough permissions to access this application.",
          );
          return;
        }

        const user = parseJwt(result.accessToken);
        const tabId = crypto.randomUUID();

        dispatch(loginSuccess({ token: result.accessToken, user }));
        localStorage.setItem("payloadEncryptionKey", result.payloadEncryptionKey);

        dispatch(setTabId(tabId));
        dispatch(setMenus(result.roleData.root_menus));
        dispatch(setSelectedMenuItem(result.roleData.root_menus[0]));

        const bc = new BroadcastChannel("auth");
        setTimeout(() => {
          bc.postMessage({
            type: "USER_LOGGED_IN",
            tabId,
            userId: user.userId,
          });
        }, 1000);
      } else {
        const targetFailures = wrongAttempts + 1;
        setWrongAttempts(targetFailures);

        if (targetFailures >= 3) {
          await forceResendOTP();
        } else {
          // Uses the backend message (e.g., "Invalid OTP. Attempts remaining: 4")
          showSnackbar(
            response?.data?.message || `Invalid code. Attempt ${targetFailures} of 3.`,
            "error"
          );
        }
      }
    } catch (e) {
      console.error("OTP Verification Exception:", e);
      const msg = e.response?.data?.message || "Network exception during verification layer lookup.";
      showSnackbar(msg, "error");
    } finally {
      setIsLoading(false);
    }
  };

  // === OTP INPUT LOGIC ===
  const handleOtpChange = (index, e) => {
    const val = e.target.value;
    if (/[^0-9]/.test(val)) return;

    const newOtpValues = [...otpValues];
    newOtpValues[index] = val.substring(val.length - 1);
    setOtpValues(newOtpValues);

    if (val && index < 5) {
      inputRefs.current[index + 1].focus();
    }
  };

  const handleOtpKeyDown = (index, e) => {
    if (e.key === "Backspace") {
      if (!otpValues[index] && index > 0) {
        const newOtpValues = [...otpValues];
        newOtpValues[index - 1] = "";
        setOtpValues(newOtpValues);
        inputRefs.current[index - 1].focus();
      } else if (otpValues[index]) {
        const newOtpValues = [...otpValues];
        newOtpValues[index] = "";
        setOtpValues(newOtpValues);
      }
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (!isLoading && otpString.length === 6 && expiresIn > 0) {
        handleVerifyOTP();
      }
    }
  };

  const handleOtpPaste = (e) => {
    e.preventDefault();
    const pasteData = e.clipboardData.getData("text/plain").replace(/\D/g, "").slice(0, 6);
    if (!pasteData) return;

    const newOtpValues = [...otpValues];
    for (let i = 0; i < pasteData.length; i++) {
      newOtpValues[i] = pasteData[i];
    }
    setOtpValues(newOtpValues);

    const focusIndex = pasteData.length < 6 ? pasteData.length : 5;
    inputRefs.current[focusIndex]?.focus();
  };

  return (
    <>
      <Box
        sx={{
          mb: 3,
          p: 2,
          bgcolor: "rgba(0,0,0,0.03)",
          borderRadius: 2,
          border: "1px solid rgba(0,0,0,0.06)",
        }}
      >
        <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", mb: 1 }}>
          <Typography variant="body2" color="text.secondary" sx={{ fontWeight: 500 }}>
            Verification code sent securely to:
          </Typography>
          
          {/* Live Expiry Timer */}
          <Box sx={{ display: "flex", alignItems: "center", gap: 0.5, color: expiresIn > 60 ? "primary.main" : "error.main" }}>
            <AccessTimeIcon sx={{ fontSize: 16 }} />
            <Typography variant="caption" sx={{ fontWeight: 700 }}>
              {formatTime(expiresIn)}
            </Typography>
          </Box>
        </Box>

        {otpData?.maskedMobile && (
          <Box sx={{ display: "flex", alignItems: "center", gap: 1.5, mb: 0.75 }}>
            <PhoneAndroidIcon sx={{ fontSize: 18, color: "text.secondary" }} />
            <Typography variant="subtitle2" color="text.primary">
              {otpData.maskedMobile}
            </Typography>
          </Box>
        )}

        {otpData?.maskedEmail && (
          <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
            <EmailIcon sx={{ fontSize: 18, color: "text.secondary" }} />
            <Typography variant="subtitle2" color="text.primary">
              {otpData.maskedEmail}
            </Typography>
          </Box>
        )}
      </Box>

      {/* STYLISH 6-BOX OTP RENDER */}
      <Box sx={{ display: "flex", justifyContent: "space-between", gap: { xs: 0.5, sm: 1 }, mb: 2 }}>
        {otpValues.map((val, idx) => (
          <TextField
            key={idx}
            inputRef={(el) => (inputRefs.current[idx] = el)}
            value={val}
            onChange={(e) => handleOtpChange(idx, e)}
            onKeyDown={(e) => handleOtpKeyDown(idx, e)}
            onPaste={handleOtpPaste}
            disabled={isLoading || expiresIn === 0}
            variant="outlined"
            inputProps={{
              inputMode: "numeric",
              pattern: "[0-9]*",
            }}
            sx={{
              flex: 1,
              "& .MuiOutlinedInput-root": {
                borderRadius: 2,
                bgcolor: "background.paper",
                height: { xs: "50px", sm: "60px" },
              },
              "& .MuiOutlinedInput-input": {
                textAlign: "center",
                fontSize: { xs: "1.2rem", sm: "1.5rem" },
                fontWeight: 700,
                padding: 0,
                color: expiresIn === 0 ? "text.disabled" : "text.primary",
              },
              "& .MuiOutlinedInput-root.Mui-focused .MuiOutlinedInput-notchedOutline":
                {
                  borderWidth: "2px",
                  borderColor: "primary.main",
                },
            }}
          />
        ))}
      </Box>

      <PrimaryButton
        fullWidth
        variant="contained"
        onClick={handleVerifyOTP}
        disabled={isLoading || otpString.length !== 6 || expiresIn === 0}
      >
        {isLoading ? "Verifying..." : expiresIn === 0 ? "Code Expired" : "Verify & Sign In"}
      </PrimaryButton>

      <Box
        display="flex"
        justifyContent="space-between"
        alignItems="center"
        mt={3}
      >
        <Button
          startIcon={<ArrowBackIcon />}
          onClick={onBackToHome}
          sx={{ textTransform: "none", color: "text.secondary" }}
          size="small"
        >
          Restart Login
        </Button>

        {/* Dynamic Resend Button based on limits and cooldown */}
        <Button
          startIcon={<RefreshIcon />}
          onClick={handleResendClick}
          disabled={cooldown > 0 || resendsLeft <= 0 || isLoading}
          sx={{ textTransform: "none" }}
          size="small"
        >
          {resendsLeft <= 0
            ? "Limit Reached"
            : cooldown > 0
            ? `Resend in ${cooldown}s`
            : `Resend OTP (${resendsLeft})`}
        </Button>
      </Box>
    </>
  );
};

export default LoginWithOTP;



