import React from "react";
import {
  PieChart,
  Pie,
  Cell,
  ResponsiveContainer,
  Tooltip as ReTooltip,
  Legend,
} from "recharts";
import { Box, Paper, Stack, Typography } from "@mui/material";
import { BarChart, Bar, Line, XAxis, YAxis, CartesianGrid, Legend as ReLegend } from "recharts";

// Colors
const STATUS_COLORS = ["#FF0000", "#4CAF50", "#FFC107"];
const TYPE_COLORS = ["#2196F3", "#FF5722", "#9C27B0"];

const CustomCenterLabel = ({ viewBox, total }) => {
  const { cx, cy } = viewBox;
  return (
    <text
      x={cx}
      y={cy}
      textAnchor="middle"
      dominantBaseline="middle"
      style={{ fontSize: "16px", fontWeight: "bold" }}
    >
      {total}
    </text>
  );
};

export default function RequestCharts({ summaryData }) {
  const statusData = [
    { name: "Pending", value: summaryData.pending },
    { name: "Approved", value: summaryData.approved },
    { name: "Rejected", value: summaryData.rejected },
  ];

  const typeData = [
    { name: "Add", value: summaryData.add },
    { name: "Delete", value: summaryData.delete },
    { name: "Modify", value: summaryData.modify },
  ];

  const totalStatus = statusData.reduce((acc, d) => acc + d.value, 0);
  const totalTypes = typeData.reduce((acc, d) => acc + d.value, 0);
  const totalDaily = summaryData.daily.reduce((acc, d) => acc + d.requests, 0);

  return (
    <Stack direction="row" spacing={2} mb={2}>
      {/* Left Donut: Status */}
      <Paper sx={{ p: 2, flex: 1, textAlign: "center" }}>
        <Typography variant="subtitle1">Request Status</Typography>
        <ResponsiveContainer width="100%" height={250}>
          <PieChart>
            <Pie
              data={statusData}
              dataKey="value"
              innerRadius={50}
              outerRadius={80}
              label
            >
              {STATUS_COLORS.map((c, i) => (
                <Cell key={i} fill={c} />
              ))}
              <CustomCenterLabel total={totalStatus} viewBox={{ cx: 150, cy: 120 }} />
            </Pie>
            <ReTooltip />
            <Legend />
          </PieChart>
        </ResponsiveContainer>
      </Paper>

      {/* Middle Chart: Daily Requests (Bar + Line) */}
      <Paper sx={{ p: 2, flex: 2, textAlign: "center" }}>
        <Typography variant="subtitle1">Requests per Day</Typography>
        <ResponsiveContainer width="100%" height={250}>
          <BarChart data={summaryData.daily}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey="day" />
            <YAxis />
            <ReTooltip />
            <ReLegend />
            <Bar dataKey="requests" fill="#2196F3" />
            <Line type="monotone" dataKey="requests" stroke="#FF9800" strokeWidth={2} />
          </BarChart>
        </ResponsiveContainer>
        <Typography variant="h6" mt={1}>Total: {totalDaily}</Typography>
      </Paper>

      {/* Right Donut: Request Types */}
      <Paper sx={{ p: 2, flex: 1, textAlign: "center" }}>
        <Typography variant="subtitle1">Request Types</Typography>
        <ResponsiveContainer width="100%" height={250}>
          <PieChart>
            <Pie
              data={typeData}
              dataKey="value"
              innerRadius={50}
              outerRadius={80}
              label
            >
              {TYPE_COLORS.map((c, i) => (
                <Cell key={i} fill={c} />
              ))}
              <CustomCenterLabel total={totalTypes} viewBox={{ cx: 150, cy: 120 }} />
            </Pie>
            <ReTooltip />
            <Legend />
          </PieChart>
        </ResponsiveContainer>
      </Paper>
    </Stack>
  );
}