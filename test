WITH pending_reqs AS (
    SELECT DISTINCT target_id
    FROM common_req
    WHERE req_type = 'CURRENCY_RATE_CHANGE'
      AND req_status = 'P'
      AND req_date >= TRUNC(:testDate, 'MM')
      AND req_date < ADD_MONTHS(TRUNC(:testDate, 'MM'), 1)
),
approved_changes AS (
    SELECT DISTINCT currency_code
    FROM currency_rate_change
    WHERE rate_change_date >= TRUNC(:testDate, 'MM')
      AND rate_change_date < ADD_MONTHS(TRUNC(:testDate, 'MM'), 1)
)
SELECT
    cm.currency_code,
    cm.currency_name,
    cm.currency_rate,
    cm.rate_date,
    cm.updated_at,
    CASE
        WHEN p.target_id IS NOT NULL THEN 'P'
        WHEN a.currency_code IS NOT NULL THEN 'A'
        ELSE 'U'
    END AS change_status
FROM currency_master cm
LEFT JOIN pending_reqs p
       ON p.target_id = cm.currency_code
LEFT JOIN approved_changes a
       ON a.currency_code = cm.currency_code
ORDER BY cm.currency_code;






