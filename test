import React, { useMemo } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  Chip,
  useTheme,
  Avatar,
  IconButton,
} from "@mui/material";
import PropTypes from "prop-types";

// icons
import PersonIcon from "@mui/icons-material/Person";
import HistoryEduIcon from "@mui/icons-material/HistoryEdu";
import RequestQuoteIcon from "@mui/icons-material/RequestQuote";
import MoreHorizIcon from "@mui/icons-material/MoreHoriz";
import DoneIcon from "@mui/icons-material/Done";
import CloseIcon from "@mui/icons-material/Close";
import HourglassBottomIcon from "@mui/icons-material/HourglassBottom";

// keep your CustomChip if you prefer; fallback to MUI Chip if missing
// import CustomChip from "../../../utils/CustomChip";
const StatusChip = ({ status }) => {
  // map to colors or variants (you can replace with CustomChip)
  const map = {
    PENDING: { label: "PENDING", color: "warning", icon: <HourglassBottomIcon fontSize="small" /> },
    APPROVED: { label: "APPROVED", color: "success", icon: <DoneIcon fontSize="small" /> },
    REJECTED: { label: "REJECTED", color: "error", icon: <CloseIcon fontSize="small" /> },
  };
  const s = (status || "").toUpperCase();
  const cfg = map[s] || { label: s || "UNKNOWN", color: "default", icon: null };

  return (
    <Chip
      size="small"
      label={cfg.label}
      color={cfg.color}
      icon={cfg.icon}
      variant="outlined"
      sx={{ fontWeight: 700 }}
    />
  );
};

StatusChip.propTypes = {
  status: PropTypes.string,
};

// helper: pick icon for action
function actionIcon(action) {
  if (!action) return <MoreHorizIcon />;
  const a = action.toLowerCase();
  if (a.includes("user")) return <PersonIcon />;
  if (a.includes("request") || a.includes("raised")) return <RequestQuoteIcon />;
  if (a.includes("history") || a.includes("activity")) return <HistoryEduIcon />;
  return <MoreHorizIcon />;
}

// relative time (simple, no deps)
function relativeTimeFromTimestamp(tsOrDisplay) {
  try {
    let date;
    if (typeof tsOrDisplay === "number") date = new Date(Number(tsOrDisplay));
    else if (typeof tsOrDisplay === "string") {
      // try ISO or displayTime, fallback to now
      const parsed = Date.parse(tsOrDisplay);
      date = isNaN(parsed) ? new Date() : new Date(parsed);
    } else date = new Date();

    const diff = Date.now() - date.getTime();
    const sec = Math.round(diff / 1000);
    if (sec < 60) return `${sec}s ago`;
    const min = Math.round(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.round(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const days = Math.round(hr / 24);
    if (days < 7) return `${days}d ago`;
    return date.toLocaleDateString();
  } catch {
    return "";
  }
}

// truncate helper
const truncate = (text, n = 120) => (text && text.length > n ? `${text.slice(0, n).trim()}…` : text || "");

/**
 * DashboardRecentActivity
 *
 * Props:
 * - recentActivity: array of activity objects (action, displayTime, timestamp, details, status, user)
 */
export const DashboardRecentActivity = ({ recentActivity = [] }) => {
  const theme = useTheme();

  // prepare data (limit to 20)
  const items = useMemo(() => (recentActivity || []).slice(0, 20), [recentActivity]);

  // container styles: masonry via CSS columns
  const containerSx = {
    columnCount: { xs: 1, sm: 1, md: 2, lg: 3 }, // responsive columns
    columnGap: theme.spacing(2),
  };

  const cardSx = {
    display: "inline-block", // necessary for column layout
    width: "100%",
    margin: `${theme.spacing(0.5)} 0`,
    breakInside: "avoid",
    transition: "transform .16s ease, box-shadow .16s ease",
    "&:hover": {
      transform: "translateY(-6px)",
      boxShadow: 6,
    },
  };

  return (
    <Card variant="outlined" sx={{ borderRadius: 3 }}>
      <CardContent>
        <Typography variant="subtitle2" fontWeight={600} mb={1}>
          Recent Activity
        </Typography>

        {items.length === 0 ? (
          <Box sx={{ py: 3, textAlign: "center" }}>
            <Typography variant="body2" color="text.secondary">
              No recent activity
            </Typography>
          </Box>
        ) : (
          <Box sx={{ ...containerSx }}>
            {items.map((r, idx) => {
              const key = `${r.timestamp ?? r.displayTime ?? idx}-${idx}`;
              const rel = relativeTimeFromTimestamp(r.timestamp ?? r.displayTime);
              return (
                <Box key={key} sx={cardSx}>
                  <Card variant="outlined" sx={{ borderRadius: 2 }}>
                    <CardContent sx={{ p: 2 }}>
                      <Stack direction="row" spacing={1} alignItems="flex-start" justifyContent="space-between">
                        <Stack direction="row" spacing={1} alignItems="center">
                          <Avatar sx={{ bgcolor: "rgba(0,0,0,0.06)", width: 36, height: 36 }}>
                            {actionIcon(r.action)}
                          </Avatar>
                          <Stack>
                            <Typography variant="body2" fontWeight={700}>
                              {r.action}
                            </Typography>
                            <Typography variant="caption" color="text.secondary">
                              {r.user ? `By ${r.user}` : ""} • {rel}
                            </Typography>
                          </Stack>
                        </Stack>

                        <Stack direction="row" spacing={1} alignItems="center">
                          <StatusChip status={r.status} />
                        </Stack>
                      </Stack>

                      <Typography variant="body2" sx={{ mt: 1 }}>
                        {truncate(r.details, 140)}
                      </Typography>

                      {/* optional actions / meta row */}
                      <Stack direction="row" spacing={1} alignItems="center" justifyContent="space-between" sx={{ mt: 1 }}>
                        <Typography variant="caption" color="text.secondary">
                          {r.source || ""}
                        </Typography>

                        {/* simple action (placeholder) */}
                        <IconButton size="small" aria-label="more" sx={{ ml: 1 }}>
                          <MoreHorizIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </CardContent>
                  </Card>
                </Box>
              );
            })}
          </Box>
        )}
      </CardContent>
    </Card>
  );
};

DashboardRecentActivity.propTypes = {
  recentActivity: PropTypes.arrayOf(
    PropTypes.shape({
      action: PropTypes.string,
      timestamp: PropTypes.oneOfType([PropTypes.number, PropTypes.string]),
      displayTime: PropTypes.string,
      details: PropTypes.string,
      status: PropTypes.string,
      user: PropTypes.string,
      source: PropTypes.string,
    })
  ),
};

export default DashboardRecentActivity;