import React, { useState, useEffect } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  MenuItem,
  Select,
  InputLabel,
  FormControl,
  Box,
  Checkbox,
  ListItemText,
  Typography,
  Stack,
  Divider,
  Paper,
  FormLabel,
  RadioGroup,
  FormControlLabel,
  Radio,
} from "@mui/material";
import { LocalizationProvider, DateTimePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import CustomChip from "../../../utils/CustomChip";

export default function AnnouncementFormDialog({
  open,
  onClose,
  onSave,
  initialData,
  roles,
}) {
  const [form, setForm] = useState({
    title: "",
    message: "",
    severity: "INFO",
    targetRoles: [],
    start_date: null,
    expiry_date: null,
  });

  const [errors, setErrors] = useState({});

  useEffect(() => {
    if (open) {
      if (initialData) {
        setForm({
          id: initialData.id,
          title: initialData.title || "",
          message: initialData.message || "",
          severity: initialData.severity || "INFO",
          targetRoles:
            initialData.targetRoles === "ALL"
              ? roles.map((r) => r.id)
              : Array.isArray(initialData.targetRoles)
                ? initialData.targetRoles.map(String)
                : [],
          start_date: initialData.startDate
            ? dayjs(initialData.startDate)
            : null,
          expiry_date: initialData.expiryDate
            ? dayjs(initialData.expiryDate)
            : null,
        });
      } else {
        setForm({
          title: "",
          message: "",
          severity: "INFO",
          targetRoles: [],
          start_date: null,
          expiry_date: null,
        });
      }
      setErrors({});
    }
  }, [open, initialData, roles]);

  const handleChange = (e) => {
    setForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
    if (errors[e.target.name])
      setErrors((prev) => ({ ...prev, [e.target.name]: null }));
  };

  const handleRoleChange = (event) => {
    const value = event.target.value;
    if (value.includes("all")) {
      setForm((prev) => ({
        ...prev,
        targetRoles:
          prev.targetRoles.length === roles.length
            ? []
            : roles.map((r) => r.id),
      }));
      return;
    }
    setForm((prev) => ({ ...prev, targetRoles: value }));
  };

  const validate = () => {
    let newErrors = {};
    if (!form.title.trim()) newErrors.title = "Title is required";
    if (!form.message.trim()) newErrors.message = "Message is required";
    if (
      form.start_date &&
      form.expiry_date &&
      form.expiry_date.isBefore(form.start_date)
    ) {
      newErrors.date = "Expiry date cannot be before start date";
    }
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = () => {
    if (!validate()) return;

    const payload = {
      ...(form.id && { id: form.id }), // Include ID only if editing
      title: form.title.trim(),
      message: form.message.trim(),
      severity: form.severity,
      targetRoles:
        form.targetRoles.length === roles.length ||
        form.targetRoles.length === 0
          ? "ALL"
          : form.targetRoles.map((id) => (isNaN(Number(id)) ? id : Number(id))),
      startDate: form.start_date
        ? form.start_date.format("YYYY-MM-DD HH:mm:ss")
        : null,
      expiryDate: form.expiry_date
        ? form.expiry_date.format("YYYY-MM-DD HH:mm:ss")
        : null,
      isActive: initialData?.isActive ?? "Y",
    };

    onSave(payload);
  };

  const isAllSelected =
    roles.length > 0 && form.targetRoles.length === roles.length;
  const isIndeterminate =
    form.targetRoles.length > 0 && form.targetRoles.length < roles.length;

  const toggleRole = (id) => {
    setForm((prev) => ({
      ...prev,
      targetRoles: prev.targetRoles.includes(id)
        ? prev.targetRoles.filter((r) => r !== id)
        : [...prev.targetRoles, id],
    }));
  };

  const selectAll = () =>
    setForm((p) => ({ ...p, targetRoles: roles.map((r) => r.id) }));

  const clearRoles = () => setForm((p) => ({ ...p, targetRoles: [] }));

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="md"
      fullWidth
      PaperProps={{ sx: { borderRadius: 3 } }}
    >
      <DialogTitle sx={{ pb: 1, pt: 3, px: 4 }}>
        <Typography variant="h5" fontWeight="700" color="text.primary">
          {initialData ? "Edit Announcement" : "Create New Announcement"}
        </Typography>
        <Typography variant="body2" color="text.secondary" sx={{ mt: 0.5 }}>
          Fill in the details below to broadcast a message to your users.
        </Typography>
      </DialogTitle>

      <Divider sx={{ mx: 4, mb: 2 }} />

      <DialogContent component={Paper} sx={{ px: 4, pb: 4 }}>
        <Stack spacing={3}>
          {/* Group 1: Core Info */}
          <Box
            p={2.5}
            sx={{
              bgcolor: "#f8fafc",
              borderRadius: 2,
              border: "1px solid #e2e8f0",
            }}
          >
            <Stack spacing={2.5}>
              <TextField
                label="Announcement Title"
                name="title"
                fullWidth
                value={form.title}
                onChange={handleChange}
                error={Boolean(errors.title)}
                helperText={errors.title}
                variant="outlined"
                sx={{ bgcolor: "white" }}
              />

              <TextField
                label="Message Content"
                name="message"
                fullWidth
                multiline
                minRows={4}
                value={form.message}
                onChange={handleChange}
                error={Boolean(errors.message)}
                helperText={errors.message}
                sx={{ bgcolor: "white" }}
              />
            </Stack>

            <Stack mt={3} size={{ xs: 12 }}>
              <FormControl component="fieldset" fullWidth>
                <FormLabel component="legend">
                  Severity level of announcement :
                </FormLabel>
                <RadioGroup
                  row
                  name="severity"
                  value={form.severity}
                  onChange={handleChange}
                >
                  <FormControlLabel
                    value="INFO"
                    control={<Radio />}
                    label="Information"
                  />
                  <FormControlLabel
                    value="WARN"
                    control={<Radio />}
                    label="Warning"
                  />
                  <FormControlLabel
                    value="CRITICAL"
                    control={<Radio />}
                    label="Critical / Important"
                  />
                </RadioGroup>
              </FormControl>
            </Stack>
          </Box>

          {/* Group 2: Targeting roles */}
          <Paper variant="outlined" sx={{ p: 2, mt: 2 }}>
            <Stack direction="row" justifyContent="space-between">
              <Typography fontWeight={600}>
                Choose roles to publish announcement
              </Typography>

              <Stack direction="row" spacing={1}>
                <Button size="small" onClick={selectAll}>
                  Select All
                </Button>
                <Button size="small" onClick={clearRoles}>
                  Clear
                </Button>
              </Stack>
            </Stack>

            <Box
              sx={{
                maxHeight: 200,
                overflow: "auto",
                display: "grid",
                gridTemplateColumns: "1fr 1fr",
                mt: 1,
              }}
            >
              {roles.map((role) => (
                <Stack
                  key={role.id}
                  direction="row"
                  alignItems="center"
                  spacing={1}
                  sx={{
                    cursor: "pointer",
                    p: 1,
                    "&:hover": { bgcolor: "action.hover" },
                  }}
                  onClick={() => toggleRole(role.id)}
                >
                  <Checkbox checked={form.targetRoles.includes(role.id)} />
                  <Typography>{role.name}</Typography>
                </Stack>
              ))}
            </Box>

            {form.targetRoles.length > 0 && (
              <Box mt={1} display="flex" gap={1} flexWrap="wrap">
                {form.targetRoles.map((id) => {
                  const role = roles.find((r) => r.id === id);
                  return (
                    <CustomChip
                      key={id}
                      variant="outlined"
                      label={role?.name ?? id}
                    />
                  );
                })}
              </Box>
            )}
          </Paper>

          {/* Group 3: Scheduling */}
          <LocalizationProvider dateAdapter={AdapterDayjs}>
            <Stack direction={{ xs: "column", sm: "row" }} spacing={3}>
              <DateTimePicker
                label="Start Date & Time"
                value={form.start_date}
                onChange={(val) => {
                  setForm((prev) => ({ ...prev, start_date: val }));
                  setErrors((prev) => ({ ...prev, date: null }));
                }}
                slotProps={{ textField: { fullWidth: true } }}
              />
              <DateTimePicker
                label="Expiry Date & Time"
                value={form.expiry_date}
                onChange={(val) => {
                  setForm((prev) => ({ ...prev, expiry_date: val }));
                  setErrors((prev) => ({ ...prev, date: null }));
                }}
                slotProps={{ textField: { fullWidth: true } }}
              />
            </Stack>
            {errors.date && (
              <Typography color="error" variant="caption">
                {errors.date}
              </Typography>
            )}
          </LocalizationProvider>
        </Stack>
      </DialogContent>

      <DialogActions sx={{ p: 3 }}>
        <Box
          sx={{
            mt: 3,
            display: "flex",
            gap: 1,
            justifyContent: "flex-end",
          }}
        >
          <Button onClick={onClose} sx={{ color: "text.secondary", px: 3 }}>
            Cancel
          </Button>
          <Button
            variant="contained"
            onClick={handleSubmit}
            sx={{ px: 4, py: 1, borderRadius: 2, boxShadow: 2 }}
          >
            {initialData ? "Save Changes" : "Publish Announcement"}
          </Button>
        </Box>
      </DialogActions>
    </Dialog>
  );
}
