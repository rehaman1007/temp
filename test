package com.fincore.transactions_service.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.sql.Connection;
import java.sql.Statement;
import java.time.Duration;
import java.time.Instant;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportExecutor {

    private final JdbcTemplate jdbcTemplate;

    /**
     * LIVE JOB STATUS CACHE
     */
    public static final Map<String, Map<String, Object>> JOB_STATUS =
            new ConcurrentHashMap<>();

    /**
     * COMMIT BATCH SIZE
     */
    private static final int COMMIT_BATCH_SIZE = 1000;

    /**
     * ============================================
     * EXECUTE SQL SCRIPT ASYNC
     * ============================================
     */
    @Async("sqlTaskExecutor")
    public void executeScriptAsync(
            File sqlFile,
            String jobId,
            String userId,
            String clientIp
    ) {

        Instant start = Instant.now();

        long startedAt = System.currentTimeMillis();

        int totalStatements = 0;

        int executedCount = 0;

        int insertCount = 0;

        int updateCount = 0;

        int deleteCount = 0;

        int otherCount = 0;

        int failedLine = 0;

        String failedSql = null;

        try {

            log.info("""

                    ==================================================
                    SQL SCRIPT EXECUTION STARTED
                    ==================================================
                    jobId={}
                    userId={}
                    clientIp={}
                    file={}
                    batchCommitSize={}
                    ==================================================
                    """,
                    jobId,
                    userId,
                    clientIp,
                    sqlFile.getAbsolutePath(),
                    COMMIT_BATCH_SIZE
            );

            /**
             * INITIAL JOB STATUS
             */
            Map<String, Object> status =
                    new ConcurrentHashMap<>();

            status.put("jobId", jobId);
            status.put("status", "RUNNING");
            status.put("progress", 0);
            status.put("executedCount", 0);
            status.put("insertCount", 0);
            status.put("updateCount", 0);
            status.put("deleteCount", 0);
            status.put("otherCount", 0);
            status.put("startedAt", startedAt);
            status.put("message", "Execution started");

            JOB_STATUS.put(jobId, status);

            /**
             * ============================================
             * COUNT STATEMENTS
             * ============================================
             */
            try (
                    BufferedReader counterReader =
                            new BufferedReader(
                                    new FileReader(sqlFile)
                            )
            ) {

                String line;

                while ((line = counterReader.readLine()) != null) {

                    line = line.trim();

                    if (line.isEmpty()
                            || line.startsWith("--")) {

                        continue;
                    }

                    if (line.endsWith(";")) {

                        totalStatements++;
                    }
                }
            }

            status.put("totalStatements", totalStatements);

            log.info("""

                    ==================================================
                    SQL STATEMENT COUNT COMPLETED
                    ==================================================
                    jobId={}
                    totalStatements={}
                    ==================================================
                    """,
                    jobId,
                    totalStatements
            );

            /**
             * ============================================
             * EXECUTION
             * ============================================
             */
            try (
                    Connection connection =
                            jdbcTemplate
                                    .getDataSource()
                                    .getConnection();

                    BufferedReader reader =
                            new BufferedReader(
                                    new FileReader(sqlFile)
                            )
            ) {

                connection.setAutoCommit(false);

                Statement statement =
                        connection.createStatement();

                StringBuilder sqlBuilder =
                        new StringBuilder();

                String line;

                int lineNumber = 0;

                while ((line = reader.readLine()) != null) {

                    lineNumber++;

                    line = line.trim();

                    /**
                     * SKIP EMPTY/COMMENT
                     */
                    if (line.isEmpty()
                            || line.startsWith("--")) {

                        continue;
                    }

                    sqlBuilder.append(line).append(" ");

                    /**
                     * SQL END
                     */
                    if (line.trim().endsWith(";")) {

                        String sql =
                                sqlBuilder.toString().trim();

                        /**
                         * REMOVE TRAILING ;
                         * JDBC DOES NOT SUPPORT IT
                         */
                        while (sql.endsWith(";")) {

                            sql =
                                    sql.substring(
                                            0,
                                            sql.length() - 1
                                    ).trim();
                        }

                        sqlBuilder.setLength(0);

                        failedSql = sql;

                        failedLine = lineNumber;

                        long queryStart =
                                System.currentTimeMillis();

                        /**
                         * EXECUTE
                         */
                        statement.execute(sql);

                        long queryEnd =
                                System.currentTimeMillis();

                        executedCount++;

                        /**
                         * QUERY TYPE COUNTS
                         */
                        String upperSql =
                                sql.toUpperCase();

                        if (upperSql.startsWith("INSERT")) {

                            insertCount++;

                        } else if (upperSql.startsWith("UPDATE")) {

                            updateCount++;

                        } else if (upperSql.startsWith("DELETE")) {

                            deleteCount++;

                        } else {

                            otherCount++;
                        }

                        /**
                         * COMMIT BATCH
                         */
                        if (executedCount % COMMIT_BATCH_SIZE == 0) {

                            connection.commit();

                            log.info("""

                                    ==================================================
                                    BATCH COMMIT SUCCESS
                                    ==================================================
                                    jobId={}
                                    executed={}
                                    elapsed={} sec
                                    ==================================================
                                    """,
                                    jobId,
                                    executedCount,
                                    Duration.between(
                                            start,
                                            Instant.now()
                                    ).toSeconds()
                            );
                        }

                        /**
                         * ETA CALCULATION
                         */
                        long elapsedSeconds =
                                Duration.between(
                                        start,
                                        Instant.now()
                                ).toSeconds();

                        long avgPerStatement =
                                executedCount == 0
                                        ? 0
                                        : Math.max(
                                                1,
                                                elapsedSeconds
                                                        / executedCount
                                        );

                        long remaining =
                                totalStatements
                                        - executedCount;

                        long etaSeconds =
                                avgPerStatement
                                        * remaining;

                        int progress =
                                totalStatements == 0
                                        ? 0
                                        : (executedCount * 100)
                                        / totalStatements;

                        /**
                         * UPDATE LIVE STATUS
                         */
                        status.put("status", "RUNNING");
                        status.put("progress", progress);
                        status.put("executedCount", executedCount);
                        status.put("insertCount", insertCount);
                        status.put("updateCount", updateCount);
                        status.put("deleteCount", deleteCount);
                        status.put("otherCount", otherCount);
                        status.put("elapsedSeconds", elapsedSeconds);
                        status.put("etaSeconds", etaSeconds);
                        status.put("currentLine", lineNumber);

                        /**
                         * DEBUG LOG
                         */
                        if (executedCount % 100 == 0) {

                            log.info("""

                                    ==================================================
                                    LIVE EXECUTION STATUS
                                    ==================================================
                                    jobId={}
                                    progress={}%
                                    executed={}
                                    inserts={}
                                    updates={}
                                    deletes={}
                                    others={}
                                    currentLine={}
                                    eta={} sec
                                    queryTime={} ms
                                    ==================================================
                                    """,
                                    jobId,
                                    progress,
                                    executedCount,
                                    insertCount,
                                    updateCount,
                                    deleteCount,
                                    otherCount,
                                    lineNumber,
                                    etaSeconds,
                                    (queryEnd - queryStart)
                            );
                        }
                    }
                }

                /**
                 * FINAL COMMIT
                 */
                connection.commit();

                long totalElapsedSeconds =
                        Duration.between(
                                start,
                                Instant.now()
                        ).toSeconds();

                long executionSpeed =
                        totalElapsedSeconds == 0
                                ? executedCount
                                : executedCount
                                / totalElapsedSeconds;

                /**
                 * FINAL STATUS
                 */
                status.put("status", "COMPLETED");
                status.put("progress", 100);
                status.put("executedCount", executedCount);
                status.put("insertCount", insertCount);
                status.put("updateCount", updateCount);
                status.put("deleteCount", deleteCount);
                status.put("otherCount", otherCount);
                status.put("elapsedSeconds",
                        totalElapsedSeconds);
                status.put("executionSpeed",
                        executionSpeed);
                status.put("completed", true);
                status.put("message",
                        "Execution completed");

                log.info("""

                        ==================================================
                        SQL SCRIPT EXECUTION COMPLETED
                        ==================================================
                        jobId={}
                        totalStatements={}
                        executed={}
                        inserts={}
                        updates={}
                        deletes={}
                        others={}
                        elapsed={} sec
                        executionSpeed={} stmt/sec
                        ==================================================
                        """,
                        jobId,
                        totalStatements,
                        executedCount,
                        insertCount,
                        updateCount,
                        deleteCount,
                        otherCount,
                        totalElapsedSeconds,
                        executionSpeed
                );
            }

        } catch (Exception e) {

            long elapsedSeconds =
                    Duration.between(
                            start,
                            Instant.now()
                    ).toSeconds();

            Map<String, Object> failedStatus =
                    JOB_STATUS.get(jobId);

            if (failedStatus != null) {

                failedStatus.put("status", "FAILED");
                failedStatus.put("message",
                        e.getMessage());
                failedStatus.put("failedLine",
                        failedLine);
                failedStatus.put("failedSql",
                        failedSql);
                failedStatus.put("executedCount",
                        executedCount);
                failedStatus.put("insertCount",
                        insertCount);
                failedStatus.put("updateCount",
                        updateCount);
                failedStatus.put("deleteCount",
                        deleteCount);
                failedStatus.put("otherCount",
                        otherCount);
                failedStatus.put("elapsedSeconds",
                        elapsedSeconds);
            }

            log.error("""

                    ==================================================
                    SQL EXECUTION FAILED
                    ==================================================
                    jobId={}
                    failedLine={}
                    failedSql={}
                    executedCount={}
                    elapsed={} sec
                    exception={}
                    ==================================================
                    """,
                    jobId,
                    failedLine,
                    failedSql,
                    executedCount,
                    elapsedSeconds,
                    e.getMessage(),
                    e
            );

        } finally {

            /**
             * DELETE TEMP FILE
             */
            try {

                if (sqlFile != null
                        && sqlFile.exists()) {

                    boolean deleted =
                            sqlFile.delete();

                    log.info("""

                            ==================================================
                            TEMP FILE CLEANUP
                            ==================================================
                            file={}
                            deleted={}
                            ==================================================
                            """,
                            sqlFile.getAbsolutePath(),
                            deleted
                    );
                }

            } catch (Exception ex) {

                log.error(
                        "FAILED TO DELETE TEMP FILE",
                        ex
                );
            }
        }
    }
}