import {
  Dialog,
  DialogActions,
  DialogContent,
  Button,
  Stack,
  MenuItem,
  TextField,
} from "@mui/material";
import { Add, Edit } from "@mui/icons-material";
import { LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import { useEffect, useRef, useState, useCallback } from "react";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

import {
  DialogTitleStyle,
  TextFieldStyle,
  TextField1Style,
  DatePickerStyle,
  DatePicker1Style,
} from "./BranchMasterStyle";

/* ================= CONSTANTS ================= */

const emailDomain = "@sbi.co.in";
const emailPrefix = 50;

const branchType = [
  { value: "A", label: "Automated" },
  { value: "M", label: "Manual" },
];

/* ================= INITIAL FORM ================= */

const getInitialForm = () => ({
  code: "",
  name: "",
  circleCode: "",
  state: "",
  city: "",
  address: "",
  pinCode: "",
  phoneNumber: "",
  emailId: emailDomain,
  nmrCode: "",
  status: "Active",
  openDate: dayjs(),
  closeDate: null,
  mergeDate: null,
  mergedWithBranch: "",
  cpcFlag: false,
  foodCreditFlag: false,
  currChestFlag: false,
  branchType: "A",
});

/* ================= COMPONENT ================= */

export default function BranchFormDialog({
  open,
  onClose,
  editingRow,
  onSuccess,
}) {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const isEdit = !!editingRow;

  const [form, setForm] = useState(getInitialForm());
  const [errors, setErrors] = useState({});
  const [states, setStates] = useState([]);
  const [circles, setCircles] = useState([]);

  const originalRef = useRef(null);

  /* ================= LOAD MASTER DATA ================= */

  useEffect(() => {
    const loadMasters = async () => {
      try {
        const s = await callApi("/CM/states", null, "GET");
        const c = await callApi("/CM/circle-codes", null, "GET");
        setStates(s?.data || []);
        setCircles(c?.data || []);
      } catch {
        snackbar("Failed to load master data", "error");
      }
    };
    loadMasters();
  }, [callApi, snackbar]);

  /* ================= LOAD EDIT DATA ================= */

  useEffect(() => {
    if (editingRow) {
      const mapped = {
        ...editingRow,
        status: editingRow.status ? "Active" : "InActive",
      };
      setForm(mapped);
      originalRef.current = mapped;
    } else {
      setForm(getInitialForm());
      originalRef.current = null;
    }
  }, [editingRow]);

  /* ================= AUTO BRANCH TYPE ================= */

  useEffect(() => {
    const manual =
      form.status !== "Active" ||
      !!form.closeDate ||
      !!form.mergeDate ||
      !!form.mergedWithBranch;

    setForm((p) => ({ ...p, branchType: manual ? "M" : "A" }));
  }, [form.status, form.closeDate, form.mergeDate, form.mergedWithBranch]);

  /* ================= HANDLERS ================= */

  const handleChange = useCallback((e) => {
    const { name, value } = e.target;
    setForm((p) => ({ ...p, [name]: value }));
  }, []);

  /* ================= SUBMIT ================= */

  const handleSubmit = async (e) => {
    e.preventDefault();

    if (
      isEdit &&
      JSON.stringify(form) === JSON.stringify(originalRef.current)
    ) {
      snackbar("No changes detected", "warning");
      return;
    }

    try {
      const payload = {
        requestType: "BRANCH",
        changeType: isEdit ? "UPDATE" : "ADD",
        targetId: form.code,
        payload: {
          ...form,
          status: form.status === "Active",
          openDate: dayjs(form.openDate).format("DD/MM/YYYY"),
          closeDate: form.closeDate
            ? dayjs(form.closeDate).format("DD/MM/YYYY")
            : null,
          mergeDate: form.mergeDate
            ? dayjs(form.mergeDate).format("DD/MM/YYYY")
            : null,
        },
      };

      await callApi("/CR/create-request", payload, "POST");
      snackbar(isEdit ? "Branch updated" : "Branch created", "success");
      onClose();
      onSuccess();
    } catch {
      snackbar("Request failed", "error");
    }
  };

  /* ================= RENDER ================= */

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <Dialog
        open={open}
        onClose={onClose}
        maxWidth="md"
        fullWidth
        component="form"
        onSubmit={handleSubmit}
      >
        <DialogTitleStyle>
          {isEdit ? "Edit Branch" : "Add Branch"}
        </DialogTitleStyle>

        <DialogContent dividers>
          <Stack spacing={2}>
            <Stack direction="row" spacing={1}>
              <TextFieldStyle
                fullWidth
                label="Branch Code *"
                name="code"
                value={form.code}
                onChange={handleChange}
                disabled={isEdit}
              />
              <TextFieldStyle
                fullWidth
                label="Branch Name *"
                name="name"
                value={form.name}
                onChange={handleChange}
              />
              <TextFieldStyle
                select
                fullWidth
                label="Circle Code *"
                name="circleCode"
                value={form.circleCode}
                onChange={handleChange}
              >
                {circles.map((c) => (
                  <MenuItem key={c.circleCode} value={c.circleCode}>
                    {c.circleCode} - {c.circleName}
                  </MenuItem>
                ))}
              </TextFieldStyle>
            </Stack>

            <Stack direction="row" spacing={1}>
              <TextFieldStyle
                select
                fullWidth
                label="State *"
                name="state"
                value={form.state}
                onChange={handleChange}
              >
                {states.map((s) => (
                  <MenuItem key={s.stateCode} value={s.stateCode}>
                    {s.stateCode} - {s.stateName}
                  </MenuItem>
                ))}
              </TextFieldStyle>
              <TextFieldStyle
                fullWidth
                label="City *"
                name="city"
                value={form.city}
                onChange={handleChange}
              />
              <TextFieldStyle
                fullWidth
                label="Pin Code *"
                name="pinCode"
                value={form.pinCode}
                onChange={handleChange}
              />
            </Stack>

            <TextField
              fullWidth
              label="Address *"
              name="address"
              value={form.address}
              onChange={handleChange}
              multiline
              maxRows={2}
            />

            <Stack direction="row" spacing={1}>
              <TextField1Style
                fullWidth
                label="Phone Number *"
                name="phoneNumber"
                value={form.phoneNumber}
                onChange={handleChange}
              />
              <TextField1Style
                fullWidth
                label="Email ID *"
                name="emailId"
                value={form.emailId}
                onChange={handleChange}
              />
            </Stack>

            <Stack direction="row" spacing={1}>
              <TextFieldStyle
                fullWidth
                label="NMR Code *"
                name="nmrCode"
                value={form.nmrCode}
                onChange={handleChange}
              />
              <TextFieldStyle
                select
                fullWidth
                label="Status *"
                name="status"
                value={form.status}
                onChange={handleChange}
              >
                <MenuItem value="Active">Active</MenuItem>
                <MenuItem value="InActive">InActive</MenuItem>
              </TextFieldStyle>
              <DatePickerStyle
                label="Open Date *"
                value={form.openDate}
                onChange={(v) =>
                  handleChange({ target: { name: "openDate", value: v } })
                }
              />
            </Stack>

            <Stack direction="row" spacing={1}>
              <TextFieldStyle
                select
                fullWidth
                label="Branch Type *"
                name="branchType"
                value={form.branchType}
                onChange={handleChange}
              >
                {branchType.map((b) => (
                  <MenuItem key={b.value} value={b.value}>
                    {b.label}
                  </MenuItem>
                ))}
              </TextFieldStyle>
            </Stack>
          </Stack>
        </DialogContent>

        <DialogActions>
          <Button
            type="submit"
            variant="contained"
            startIcon={isEdit ? <Edit /> : <Add />}
          >
            {isEdit ? "Update" : "Add"}
          </Button>
        </DialogActions>
      </Dialog>
    </LocalizationProvider>
  );
}