import {
  Dialog,
  DialogContent,
  Button,
  Table,
  TableHead,
  TableRow,
  TableCell,
  TableBody,
  TableContainer,
  Paper,
  Typography,
  Box,
  Stack,
  IconButton,
  Tooltip,
  RadioGroup,
  FormControlLabel,
  Radio,
  LinearProgress,
} from "@mui/material";

import CloseIcon from "@mui/icons-material/Close";
import PictureAsPdfOutlinedIcon from "@mui/icons-material/PictureAsPdfOutlined";
import ImageOutlinedIcon from "@mui/icons-material/ImageOutlined";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";

import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import { toPng } from "html-to-image";
import { useRef, useState } from "react";

import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import useApi from "../../../hooks/useApi";

/* ================= FORMAT ================= */
const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : "—";

/* ================= SUMMARY → REPORT MAP ================= */
const SUMMARY_FILE_MAP = {
  BALANCE: "balance_compare_report",
  SIBA: "intr_report",
  SUSPENSE: "cntr_report",
};

const ProcessSummaryDialog = ({ open, data, onClose }) => {
  /* hooks */
  const reportRef = useRef(null);
  const copyTimeoutRef = useRef(null);

  const [copied, setCopied] = useState(false);
  const [summaryType, setSummaryType] = useState("BALANCE");

  const [isDownloading, setIsDownloading] = useState(false);
  const [downloadedBytes, setDownloadedBytes] = useState(0);

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  if (!data) return null;

  const { RECON_RUN_DATE, summary = [] } = data;

  const totalEntries = summary.reduce(
    (sum, r) => sum + (r.Total_no_of_entries || 0),
    0,
  );
  const totalNewEntries = summary.reduce(
    (sum, r) => sum + (r["new entry"] || 0),
    0,
  );

  /* ================= EXPORT SUMMARY PDF ================= */
  const exportPDF = () => {
    const doc = new jsPDF("p", "pt");

    doc.setFontSize(14);
    doc.text("Difference Summary Report", 40, 40);
    doc.setFontSize(10);
    doc.text(`Reconciliation Date: ${RECON_RUN_DATE}`, 40, 58);

    autoTable(doc, {
      startY: 80,
      head: [["HEAD", "TOTAL ENTRIES", "NEW ENTRIES"]],
      body: [
        ...summary.map((r) => [
          r.HEAD,
          formatAmount(r.Total_no_of_entries),
          formatAmount(r["new entry"]),
        ]),
        ["TOTAL", formatAmount(totalEntries), formatAmount(totalNewEntries)],
      ],
      styles: { halign: "right", fontSize: 9 },
      headStyles: { fillColor: [33, 150, 243] },
      columnStyles: { 0: { halign: "left" } },
      didParseCell: (d) => {
        if (d.row.index === summary.length) {
          d.cell.styles.fontStyle = "bold";
        }
      },
    });

    doc.save(`Difference_Summary_${RECON_RUN_DATE}.pdf`);
  };

  /* ================= COPY PNG ================= */
  const copyPNGToClipboard = async () => {
    if (!reportRef.current) return;

    const node = reportRef.current;
    const originalOverflow = node.style.overflow;
    const originalHeight = node.style.height;

    node.style.overflow = "visible";
    node.style.height = `${node.scrollHeight}px`;

    try {
      const dataUrl = await toPng(node, {
        cacheBust: true,
        backgroundColor: "#ffffff",
        pixelRatio: 2,
      });

      const blob = await (await fetch(dataUrl)).blob();

      await navigator.clipboard.write([
        new ClipboardItem({ "image/png": blob }),
      ]);

      setCopied(true);
      clearTimeout(copyTimeoutRef.current);
      copyTimeoutRef.current = setTimeout(() => setCopied(false), 2000);
    } catch (err) {
      console.error(err);
      snackbar("Copy failed", "error");
    } finally {
      node.style.overflow = originalOverflow;
      node.style.height = originalHeight;
    }
  };

  /* ================= DOWNLOAD FULL REPORT ================= */
  const handleDownloadReport = async () => {
    const fileName = SUMMARY_FILE_MAP[summaryType];

    setIsDownloading(true);
    setDownloadedBytes(0);

    try {
      const payload = {
        moduleType: "WHOLE_BANK",
        fileName,
        date: RECON_RUN_DATE,
      };

      const response = await callApi(
        "/RS/reports/download",
        payload,
        "POST",
        "blob",
        "application/json",
        {
          onDownloadProgress: (e) => {
            if (e?.loaded) setDownloadedBytes(e.loaded);
          },
        },
        false,
      );

      if (response?.data?.size > 20) {
        const url = window.URL.createObjectURL(response.data);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${fileName}_${RECON_RUN_DATE}.zip`;
        a.click();
        window.URL.revokeObjectURL(url);
        snackbar("Report downloaded", "success");
      } else {
        snackbar("No data found", "warning");
      }
    } catch {
      snackbar("Download failed", "error");
    } finally {
      setIsDownloading(false);
      setDownloadedBytes(0);
    }
  };

  const downloadedMB =
    downloadedBytes > 0 ? (downloadedBytes / (1024 * 1024)).toFixed(2) : null;

  /* ================================================= */

  return (
    <Dialog open={open} fullWidth maxWidth="md">
      {/* ================= HEADER ================= */}
      <Box
        sx={{
          px: 3,
          py: 2,
          borderBottom: 1,
          borderColor: "divider",
          display: "flex",
          justifyContent: "space-between",
        }}
      >
        <Box>
          <Typography variant="h6" fontWeight={700}>
            Difference Summary Report
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Reconciliation Date: {RECON_RUN_DATE}
          </Typography>
        </Box>

        <Stack direction="row" spacing={1} alignItems="center">
          {/* PDF */}
          <Tooltip title="Export summary to PDF">
            <IconButton onClick={exportPDF}>
              <PictureAsPdfOutlinedIcon />
            </IconButton>
          </Tooltip>

          {/* COPY */}
          <Tooltip
            title={copied ? "Summary image copied!" : "Copy summary as image"}
          >
            <IconButton
              onClick={copyPNGToClipboard}
              sx={{ color: copied ? "success.main" : "inherit" }}
            >
              {copied ? <CheckCircleOutlineIcon /> : <ImageOutlinedIcon />}
            </IconButton>
          </Tooltip>

          <IconButton onClick={onClose}>
            <CloseIcon />
          </IconButton>
        </Stack>
      </Box>

      {/* ================= BODY ================= */}
      <DialogContent sx={{ p: 2 }}>
        {/* SUMMARY TYPE + DOWNLOAD */}
        <Paper sx={{ p: 2, mb: 2 }}>
          {/* Flex container to align items horizontally */}
          <Box
            sx={{
              display: "flex",
              alignItems: "center", // Aligns items vertically center
              justifyContent: "space-between", // Pushes radio to left, button to right
              gap: 2, // Adds space between items
              flexWrap: "wrap", // Allows wrapping on small screens
            }}
          >
            <RadioGroup
              row
              value={summaryType}
              onChange={(e) => setSummaryType(e.target.value)}
              sx={{ flexWrap: "nowrap" }} // Keeps radio buttons in one line
            >
              <FormControlLabel
                value="BALANCE"
                control={<Radio />}
                label="Balance Compare"
              />
              <FormControlLabel value="SIBA" control={<Radio />} label="SIBA" />
              <FormControlLabel
                value="SUSPENSE"
                control={<Radio />}
                label="Suspense"
              />
            </RadioGroup>

            <Button
              startIcon={<CloudDownloadTwoToneIcon />}
              variant="contained"
              onClick={handleDownloadReport}
              disabled={isDownloading}
              sx={{ whiteSpace: "nowrap" }} // Prevents button text from breaking
            >
              Download Full Report
            </Button>
          </Box>

          {/* Progress bar remains below the row */}
          {isDownloading && (
            <Box mt={1}>
              <LinearProgress />
              {downloadedMB && (
                <Typography variant="caption">
                  {downloadedMB} MB downloaded
                </Typography>
              )}
            </Box>
          )}
        </Paper>

        {/* SUMMARY TABLE */}
        <TableContainer
          component={Paper}
          sx={{ height: "100%" }}
          ref={reportRef}
        >
          <Table stickyHeader size="small">
            <TableHead
              sx={{
                position: "sticky",
                top: 0,
                zIndex: 2,
                backgroundColor: "primary.light",
              }}
            >
              <TableRow>
                <TableCell sx={{ fontWeight: 600 }}>HEAD</TableCell>
                <TableCell align="right" sx={{ fontWeight: 600 }}>
                  TOTAL ENTRIES
                </TableCell>
                <TableCell align="right" sx={{ fontWeight: 600 }}>
                  NEW ENTRIES
                </TableCell>
              </TableRow>
            </TableHead>

            <TableBody>
              {summary.map((row, i) => (
                <TableRow key={i}>
                  <TableCell>{row.HEAD}</TableCell>
                  <TableCell align="right">
                    {formatAmount(row.Total_no_of_entries)}
                  </TableCell>
                  <TableCell align="right">
                    {formatAmount(row["new entry"])}
                  </TableCell>
                </TableRow>
              ))}

              <TableRow sx={{ bgcolor: "#eee" }}>
                <TableCell sx={{ fontWeight: 700 }}>TOTAL</TableCell>
                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalEntries)}
                </TableCell>
                <TableCell align="right" sx={{ fontWeight: 700 }}>
                  {formatAmount(totalNewEntries)}
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </TableContainer>
      </DialogContent>

      {/* ================= FOOTER ================= */}
      <Box
        sx={{
          px: 3,
          py: 2,
          borderTop: 1,
          borderColor: "divider",
          display: "flex",
          justifyContent: "flex-end",
        }}
      >
        <Button onClick={onClose} variant="outlined">
          Close
        </Button>
      </Box>
    </Dialog>
  );
};

export default ProcessSummaryDialog;
