      } catch (e: any) {
        if (!cancelled) {
          setError(e?.message || "Unable to fetch CGL details");
          setDetails(null);
        }
      } finally {
        if (!cancelled) setDetailsLoading(false);
      }
    };

    run();
    return () => {
      cancelled = true;
    };
