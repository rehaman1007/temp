Object value = rs.getObject(i);

/**
 * NULL handling
 */
if (value == null) {

    row.put(
            meta.getColumnLabel(i),
            null
    );

    continue;
}

/**
 * Oracle TIMESTAMP
 */
if (
        value instanceof java.sql.Timestamp
) {

    value =
            value.toString();
}

/**
 * Oracle DATE
 */
else if (
        value instanceof java.sql.Date
) {

    value =
            value.toString();
}

/**
 * Oracle CLOB
 */
else if (
        value instanceof java.sql.Clob
) {

    java.sql.Clob clob =
            (java.sql.Clob) value;

    value =
            clob.getSubString(
                    1,
                    (int) clob.length()
            );
}

/**
 * Oracle BLOB
 */
else if (
        value instanceof java.sql.Blob
) {

    value = "[BLOB DATA]";
}

/**
 * Streams
 */
else if (
        value instanceof java.io.InputStream
) {

    value = "[STREAM DATA]";
}

/**
 * Oracle proprietary objects
 */
else if (
        value.getClass()
                .getName()
                .startsWith("oracle.sql.")
) {

    value =
            value.toString();
}

/**
 * Final assignment
 */
row.put(
        meta.getColumnLabel(i),
        value
);