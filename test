package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.dto.LedgerEnquiryRequest;
import com.fincore.enquiry_service.model.GlTransactions;

import jakarta.persistence.criteria.Predicate;

import org.springframework.data.jpa.domain.Specification;

import java.util.ArrayList;
import java.util.List;

public class LedgerEnquirySpecification {

    public static Specification<GlTransactions> filter(
            LedgerEnquiryRequest dto
    ) {

        return (root, query, cb) -> {

            List<Predicate> predicates =
                    new ArrayList<>();

            // ================= CGL =================

            predicates.add(
                    cb.equal(
                            root.get("cgl"),
                            dto.getCgl()
                    )
            );

            // ================= CURRENCY =================

            if (
                    dto.getCurrencies() != null &&
                    !"ALL".equalsIgnoreCase(
                            dto.getCurrencies()
                    )
            ) {

                predicates.add(
                        cb.equal(
                                root.get("currency"),
                                dto.getCurrencies()
                        )
                );
            }

            // ================= SOURCE FLAGS =================

            if (
                    dto.getSourceFlags() != null &&
                    !dto.getSourceFlags().contains(
                            "ALL"
                    )
            ) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags())
                );
            }

            // ================= BRANCHES =================

            if (
                    dto.getBranches() != null &&
                    !dto.getBranches().contains(
                            "ALL"
                    )
            ) {

                predicates.add(
                        root.get("branchCode")
                                .in(dto.getBranches())
                );
            }

            // ================= DATE RANGE =================

            predicates.add(
                    cb.between(
                            root.get(
                                    "transactionDate"
                            ),
                            java.sql.Date.valueOf(
                                    dto.getFromDate()
                            ),
                            java.sql.Date.valueOf(
                                    dto.getToDate()
                            )
                    )
            );

            // ================= GRID FILTERS =================

            if (
                    dto.getGridFilters() != null
            ) {

                for (GridFilter filter :
                        dto.getGridFilters()) {

                    if (
                            filter.getValue() == null ||
                            filter.getValue().isBlank()
                    ) {
                        continue;
                    }

                    String field =
                            filter.getField();

                    String value =
                            filter.getValue();

                    switch (
                            filter.getOperator()
                    ) {

                        case "contains":

                            predicates.add(
                                    cb.like(
                                            cb.lower(
                                                    root.get(
                                                            field
                                                    )
                                            ),
                                            "%" +
                                            value.toLowerCase() +
                                            "%"
                                    )
                            );

                            break;

                        case "equals":

                            predicates.add(
                                    cb.equal(
                                            root.get(
                                                    field
                                            ),
                                            value
                                    )
                            );

                            break;

                        case "startsWith":

                            predicates.add(
                                    cb.like(
                                            cb.lower(
                                                    root.get(
                                                            field
                                                    )
                                            ),
                                            value.toLowerCase() +
                                            "%"
                                    )
                            );

                            break;
                    }
                }
            }

            return cb.and(
                    predicates.toArray(
                            new Predicate[0]
                    )
            );
        };
    }
}

