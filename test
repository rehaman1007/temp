{
  field: "acClassification",
  headerName: "Account Classification",
  flex: 1.2,
  type: "singleSelect",
  valueOptions: ACCOUNT_CLASSIFICATIONS.map((a) => ({
    value: a.value,   // ✅ A, L, I, E, M
    label: a.label,
  })),
  align: "center",
  headerAlign: "center",
  renderCell: (params) => {
    const found = ACCOUNT_CLASSIFICATIONS.find(
      (x) => x.value === params.value
    );
    return (
      <CustomChip
        label={found?.label}
        icon={found?.icon}
        variant="outlined"
      />
    );
  },
},

{
  field: "status",
  headerName: "CGL Status",
  flex: 1,
  type: "singleSelect",
  valueOptions: [
    { value: 1, label: "Active" },
    { value: 0, label: "In Active" },
  ],
  align: "center",
  headerAlign: "center",
  renderCell: (params) => (
    <CustomChip
      icon={<OnlinePredictionIcon />}
      label={params.value === 1 ? "Active" : "In Active"}
      variant="outlined"
    />
  ),
},

const filters = filterModel.items
  .filter((f) => f.value !== undefined && f.value !== "")
  .map((f) => ({
    field: f.field,
    operator: f.operator,
    value: f.value,
  }));