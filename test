// ------------------------------------------------------
export default function CglView() {
  const [cglNoQuery, setCglNoQuery] = useState("");
  const [descQuery, setDescQuery] = useState("");

  const debouncedCglNo = useDebouncedValue(cglNoQuery);
  const debouncedDesc = useDebouncedValue(descQuery);

  const [searchResults, setSearchResults] = useState([]);
  const [searchLoading, setSearchLoading] = useState(false);

  const [selectedOption, setSelectedOption] = useState(null);
  const [details, setDetails] = useState(null);
  const [detailsLoading, setDetailsLoading] = useState(false);

  const [error, setError] = useState("");

  // Decide which query to use
  const activeQuery = useMemo(
    () => ({
      cglCode: debouncedCglNo.trim(),
      description: debouncedDesc.trim(),
    }),
    [debouncedCglNo, debouncedDesc]
  );

  // Trigger search when either query reaches >= 4 chars
  useEffect(() => {
    const hasEnoughCgl = activeQuery.cglCode.length >= 4;
    const hasEnoughDesc = activeQuery.description.length >= 4;

    if (!hasEnoughCgl && !hasEnoughDesc) {
      setSearchResults([]);
      setSelectedOption(null);
      setDetails(null);
      return;
    }

    let cancelled = false;

    const fetchData = async () => {
      try {
        setSearchLoading(true);
        setError("");
        const data = await searchCgl(activeQuery);
        if (!cancelled) {
          setSearchResults(data);
          if (data.length === 0) {
            setSelectedOption(null);
            setDetails(null);
          }
        }
      } catch (e) {
        if (!cancelled) {
          setError("Unable to fetch CGL list. Please try again.");
        }
      } finally {
        if (!cancelled) setSearchLoading(false);
      }
    };

    fetchData();
    return () => {
      cancelled = true;
    };
  }, [activeQuery]);

  // Fetch full details when user selects an option
  useEffect(() => {
    if (!selectedOption) {
      setDetails(null);
      return;
    }

    let cancelled = false;
    const loadDetails = async () => {
      try {
        setDetailsLoading(true);
        const d = await getCglDetails(selectedOption.id);
        if (!cancelled) setDetails(d);
      } finally {
        if (!cancelled) setDetailsLoading(false);
      }
    };

    loadDetails();
    return () => {
      cancelled = true;
    };
  }, [selectedOption]);

  const showSearchHint =
    cglNoQuery.length < 4 && descQuery.length < 4 && !searchLoading;

  return (
    <Box
      sx={{
        p: 3,
        minHeight: "100vh",
        bgcolor: "linear-gradient(135deg, #f3f4ff 0%, #f9fbff 40%, #eef2ff 100%)",
      }}
    >
      {/* Header */}
      <Stack direction="row" justifyContent="space-between" mb={3}>
        <Box>
          <Typography variant="h5" fontWeight={700}>
            CGL View
          </Typography>
          <Typography variant="body2" color="text.secondary">
            Search using CGL number or description and inspect full configuration.
          </Typography>
        </Box>
        <Chip label="Advanced Search" variant="outlined" />
      </Stack>

      {/* Search Card */}
      <Card
        elevation={4}
        sx={{
          mb: 3,
          p: 3,
          borderRadius: 3,
          border: "1px solid",
          borderColor: "divider",
        }}
      >
        <Typography variant="subtitle1" fontWeight={600} mb={2}>
          Search Criteria
        </Typography>

        <Grid container spacing={2} alignItems="center">
          <Grid item xs={12} md={4}>
            <TextField
              label="CGL Number"
              placeholder="Type at least 4 digits"
              fullWidth
              size="small"
              value={cglNoQuery}
              onChange={(e) => setCglNoQuery(e.target.value)}
              inputProps={{ maxLength: 20 }}
            />
          </Grid>
          <Grid item xs={12} md={4}>
            <TextField
              label="CGL Description"
              placeholder="Type at least 4 characters"
              fullWidth
              size="small"
              value={descQuery}
              onChange={(e) => setDescQuery(e.target.value)}
              inputProps={{ maxLength: 100 }}
            />
          </Grid>

          <Grid item xs={12} md={4}>
            <Autocomplete
              fullWidth
              size="small"
              options={searchResults}
              getOptionLabel={formatOptionLabel}
              value={selectedOption}
              onChange={(_, value) => setSelectedOption(value)}
              loading={searchLoading}
              noOptionsText={
                showSearchHint
                  ? "Start typing above (min 4 characters)…"
                  : "No matching CGL found"
              }
              renderInput={(params) => (
                <TextField
                  {...params}
                  label="Matching CGLs"
                  placeholder="Choose a CGL from results"
                  InputProps={{
                    ...params.InputProps,
                    endAdornment: (
                      <>
                        {searchLoading ? (
                          <CircularProgress size={18} sx={{ mr: 1 }} />
                        ) : null}
                        {params.InputProps.endAdornment}
                      </>
                    ),
                  }}
                />
              )}
            />
          </Grid>
        </Grid>

        {error && (
          <Typography mt={2} color="error" variant="body2">
            {error}
          </Typography>
        )}

        {showSearchHint && (
          <Typography mt={2} variant="caption" color="text.secondary">
            Tip: You can type in either CGL Number or Description; once you enter
            at least <b>4</b> characters, matching records will be fetched
            automatically.
          </Typography>
        )}
      </Card>

      {/* Details Card */}
      <Card
        elevation={selectedOption ? 6 : 1}
        sx={{
          p: 3,
          borderRadius: 3,
          border: "1px dashed",
          borderColor: selectedOption ? "primary.light" : "divider",
          minHeight: 220,
        }}
      >
        {!selectedOption && (
          <Box
            sx={{
              py: 6,
              textAlign: "center",
              color: "text.secondary",
            }}
