import { useState, useRef } from "react";
import {
  TextField,
  Popper,
  Paper,
  List,
  ListItemButton,
  Box,
} from "@mui/material";

/**
 * Triggers suggestions when user types:
 *  - G.
 *  - {{
 * Inserts variable at cursor position
 */
export default function ExpressionEditorWithVariables({
  value,
  onChange,
  globals = [],
  placeholder,
}) {
  const textAreaRef = useRef(null); // actual textarea
  const wrapperRef = useRef(null); // anchor for popper

  const [open, setOpen] = useState(false);
  const [trigger, setTrigger] = useState(null);

  const handleChange = (e) => {
    const val = e.target.value;
    const cursor = e.target.selectionStart;

    onChange(val);

    const lastTwo = val.slice(cursor - 2, cursor);

    if (lastTwo === "G." || lastTwo === "g.") {
      setTrigger("G.");
      setOpen(true);
      return;
    }

    if (
      lastTwo === "$G" ||
      lastTwo === "$g" ||
      lastTwo === "G{" ||
      lastTwo === "g{"
    ) {
      setTrigger("$G");
      setOpen(true);
      return;
    }

    setOpen(false);
  };

  const insertVariable = (variable) => {
    const textarea = textAreaRef.current;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;

    let insertText = "";

    if (trigger === "G.") insertText = variable.name;
    if (trigger === "$G") insertText = `{${variable.name}}`;

    const newValue =
      value.substring(0, start) + insertText + value.substring(end);

    onChange(newValue);
    setOpen(false);

    // restore caret
    setTimeout(() => {
      textarea.focus();
      textarea.setSelectionRange(
        start + insertText.length,
        start + insertText.length,
      );
    }, 0);
  };

  return (
    <Box ref={wrapperRef}>
      <TextField
        fullWidth
        multiline
        rows={3}
        placeholder={placeholder}
        value={value}
        onChange={handleChange}
        InputProps={{
          inputRef: textAreaRef,
        }}
      />

      <Popper
        open={open}
        anchorEl={wrapperRef.current}
        placement="bottom-start"
        disablePortal // IMPORTANT inside dialogs
      >
        <Paper sx={{ width: 280, maxHeight: 220, overflow: "auto" }}>
          <List dense>
            {globals.map((v) => (
              <ListItemButton key={v.name} onClick={() => insertVariable(v)}>
                {v.name} ({v.dataType})
              </ListItemButton>
            ))}
          </List>
        </Paper>
      </Popper>
    </Box>
  );
}
