WITH approved AS
(
    SELECT DISTINCT currency_code
    FROM currency_rate_change
    WHERE rate_change_date BETWEEN :fromDate AND :toDate
),
pending AS
(
    SELECT DISTINCT target_id
    FROM common_req
    WHERE req_type='CURRENCY_RATE_CHANGE'
      AND req_status='P'
      AND req_date BETWEEN :fromDate AND :toDate
)

SELECT
    cm.currency_code,
    cm.currency_name,
    cm.currency_rate,
    cm.updated_at,
    CASE
        WHEN p.target_id IS NOT NULL THEN 'P'
        WHEN a.currency_code IS NOT NULL THEN 'A'
        ELSE 'U'
    END change_status
FROM currency_master cm
LEFT JOIN approved a
       ON a.currency_code=cm.currency_code
LEFT JOIN pending p
       ON p.target_id=cm.currency_code
ORDER BY cm.currency_code;




WITH pending_reqs AS (
    -- 1. Identify currencies with AT LEAST ONE pending request this month
    SELECT DISTINCT TARGET_ID
    FROM COMMON_REQ
    WHERE REQ_TYPE = 'CURRENCY_RATE_CHANGE'
      AND REQ_STATUS = 'P'
      -- Using TRUNC to check the current month. 
      -- (Change back to your +/- 7 days logic if that specific window is strictly required)
      AND REQ_DATE >= TRUNC(SYSDATE, 'MM') 
),
approved_changes AS (
    -- 2. Identify currencies with AT LEAST ONE approved change this month
    SELECT DISTINCT currency_code
    FROM currency_rate_change
    WHERE rate_change_date >= TRUNC(SYSDATE, 'MM')
)
SELECT 
    cm.CURRENCY_CODE,
    cm.CURRENCY_NAME,
    cm.CURRENCY_RATE,
    cm.UPDATED_AT,
    CASE
        -- Order matters: If it's pending right now, mark as 'P' even if it was previously 'A' this month
        WHEN p.TARGET_ID IS NOT NULL THEN 'P' 
        WHEN a.currency_code IS NOT NULL THEN 'A'
        ELSE 'U'
    END AS CHANGE_STATUS
FROM 
    CURRENCY_MASTER cm
LEFT JOIN 
    pending_reqs p ON cm.CURRENCY_CODE = p.TARGET_ID
LEFT JOIN 
    approved_changes a ON cm.CURRENCY_CODE = a.currency_code;
