import api from "../config/axiosConfig";
import { resolveConfig } from "../config/EnvironmentConfig";
import { tokenRefreshed, logoutSuccess } from "../store/slices/authSlice";
import { parseJwt } from "../utils/EncryptionUtilities";

let refreshPromise = null;
let storeRef = null;

// Inject Redux store once
export const injectAuthStore = (store) => {
  storeRef = store;
};

export const refreshTokenShared = () => {
  if (!refreshPromise) {
    refreshPromise = api
      .post(`${resolveConfig("/LS")}/auth/refresh-token`)
      .then((res) => {
        const { accessToken } = res.data;
        if (!accessToken) throw new Error("No token returned");

        const user = parseJwt(accessToken);
        storeRef.dispatch(tokenRefreshed({ token: accessToken, user }));
        return accessToken;
      })
      .finally(() => {
        refreshPromise = null;
      });
  }
  return refreshPromise;
};

export const hardLogout = (reason = "SESSION_EXPIRED") => {
  storeRef.dispatch(logoutSuccess());
  window.dispatchEvent(
    new CustomEvent("auth:session-expired", { detail: { reason } })
  );
};

import axios from "axios";
import { resolveConfig } from "../config/EnvironmentConfig";
import { logoutSuccess } from "../store/slices/authSlice";
import { refreshTokenShared, hardLogout } from "../auth/authRefreshManager";

let store;

// Inject store
export const injectStore = (_store) => {
  store = _store;
};

const api = axios.create({
  baseURL: "",
  withCredentials: true,
  headers: { "Content-Type": "application/json" },
});

// REQUEST
api.interceptors.request.use((config) => {
  const state = store?.getState();
  const token = state?.auth?.token;

  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }

  if (!config.headers["X-Request-Type"]) {
    config.headers["X-Request-Type"] = "*";
  }

  return config;
});

// RESPONSE
api.interceptors.response.use(
  (res) => res,
  async (error) => {
    const originalRequest = error.config;
    const status = error.response?.status;
    const errorCode = error.response?.data?.error || error.response?.data?.code;

    if (!originalRequest || originalRequest._retry) {
      return Promise.reject(error);
    }

    // 🚫 Hard invalid session
    if (
      status === 401 &&
      ["CONCURRENT_LOGIN", "SESSION_EXPIRED", "INVALID_TOKEN"].includes(errorCode)
    ) {
      hardLogout(errorCode);
      return Promise.reject(error);
    }

    // 🔁 Token expired → shared refresh
    if (status === 401 && errorCode === "TOKEN_EXPIRED") {
      originalRequest._retry = true;
      try {
        const token = await refreshTokenShared();
        originalRequest.headers.Authorization = `Bearer ${token}`;
        return api(originalRequest);
      } catch {
        hardLogout("SESSION_EXPIRED");
        return Promise.reject(error);
      }
    }

    return Promise.reject(error);
  }
);

export default api;

import { useState, useCallback, useRef, useEffect } from "react";
import { useSelector } from "react-redux";
import { useLocation } from "react-router-dom";
import api from "../config/axiosConfig";
import { resolveConfig } from "../config/EnvironmentConfig";
import useCustomSnackbar from "../utils/useCustomSnackbar";
import { convertToKebabCase } from "../utils/CommonUtilities";

const useApi = () => {
  const [data, setData] = useState(null);
  const [error, setError] = useState(null);
  const [loading, setLoading] = useState(false);

  const activeRequests = useRef(new Set());
  const snackbar = useCustomSnackbar();
  const location = useLocation();

  const menus = useSelector((state) => state.menus.menus);
  const selectedMenuItem = useSelector((state) => state.menus.selectedMenuItem);

  const findMenuItem = useCallback((items, route) => {
    for (const item of items || []) {
      if (item.route === route) return item;
      if (item.children) {
        const found = findMenuItem(item.children, route);
        if (found) return found;
      }
    }
    return null;
  }, []);

  const xRequestType =
    findMenuItem(menus, location.pathname)?.requestType ||
    selectedMenuItem?.requestType ||
    "*";

  const cancelAllRequests = useCallback(() => {
    activeRequests.current.forEach((c) => c.abort());
    activeRequests.current.clear();
  }, []);

  useEffect(() => () => cancelAllRequests(), [cancelAllRequests]);

  const callApi = useCallback(
    async (
      url,
      payload = null,
      method = "GET",
      responseType = "json",
      contentType = "application/json",
      extraConfig = {},
      returnDataOnly = true
    ) => {
      setLoading(true);
      setError(null);

      const parts = url.split("/");
      parts[1] = resolveConfig(`/${parts[1]}`);
      const finalUrl = parts.slice(1).join("/");

      const controller = new AbortController();
      activeRequests.current.add(controller);

      try {
        const response = await api({
          method,
          url: finalUrl,
          data: method !== "GET" ? payload : undefined,
          params: method === "GET" ? payload : undefined,
          responseType,
          signal: controller.signal,
          headers: {
            "Content-Type": contentType,
            "X-Request-Type": xRequestType,
            ...(extraConfig.headers || {}),
          },
          ...extraConfig,
        });

        setData(response.data);
        return returnDataOnly ? response.data : response;
      } catch (err) {
        if (err.response?.status !== 401) {
          snackbar("An error occurred", "error");
        }
        throw err;
      } finally {
        activeRequests.current.delete(controller);
        setLoading(false);
      }
    },
    [xRequestType, snackbar]
  );

  return { data, error, loading, callApi, cancelAllRequests };
};

export default useApi;

import { useEffect, useRef, useState, useCallback } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../utils/useCustomSnackbar";
import { resolveConfig } from "../config/EnvironmentConfig";
import { refreshTokenShared, hardLogout } from "../auth/authRefreshManager";

const useStreamApi = () => {
  const token = useSelector((state) => state.auth.token);
  const snackbar = useCustomSnackbar();

  const controllerRef = useRef(null);
  const reconnectingRef = useRef(false);

  const [connected, setConnected] = useState(false);
  const [lastMessage, setLastMessage] = useState(null);

  const stopStream = useCallback(() => {
    controllerRef.current?.abort();
    controllerRef.current = null;
    setConnected(false);
  }, []);

  const startStream = useCallback(
    async (url, handlers = {}) => {
      if (!token) return;

      const parts = url.split("/");
      parts[1] = resolveConfig(`/${parts[1]}`);
      const finalUrl = parts.slice(1).join("/");

      stopStream();

      const controller = new AbortController();
      controllerRef.current = controller;

      fetchEventSource(finalUrl, {
        method: "GET",
        headers: { Authorization: `Bearer ${token}` },
        signal: controller.signal,

        onopen: () => {
          reconnectingRef.current = false;
          setConnected(true);
          handlers.onOpen?.();
        },

        onmessage: (event) => {
          if (event.event === "new_notification") {
            const data = JSON.parse(event.data);
            setLastMessage(data);
            handlers.onMessage?.(data);
          }
        },

        onerror: async () => {
          setConnected(false);
          if (reconnectingRef.current) return;

          reconnectingRef.current = true;
          try {
            await refreshTokenShared();
            startStream(url, handlers);
          } catch {
            hardLogout("SESSION_EXPIRED");
          }
        },
      });
    },
    [token, stopStream]
  );

  useEffect(() => stopStream, [stopStream]);

  return { connected, lastMessage, startStream, stopStream };
};

export default useStreamApi;

