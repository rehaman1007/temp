if (
    processedCount % STATUS_UPDATE_INTERVAL == 0 ||
    processedCount == totalStatements
) {

    int progress =
        totalStatements == 0
            ? 0
            : (processedCount * 100) / totalStatements;

    long elapsedMillis =
        Duration.between(start, Instant.now()).toMillis();

    long elapsedSeconds =
        Math.max(elapsedMillis / 1000, 1);

    /**
     * =========================================
     * SPEED
     * =========================================
     */
    long executionSpeed =
        processedCount <= 0
            ? 0
            : (processedCount * 1000L) / Math.max(elapsedMillis, 1);

    /**
     * =========================================
     * ETA
     * =========================================
     */
    long remaining =
        totalStatements - processedCount;

    long etaSeconds =
        executionSpeed <= 0
            ? 0
            : remaining / executionSpeed;

    Map<String, Object> status =
        new ConcurrentHashMap<>();

    status.put("jobId", jobId);

    status.put("status", "RUNNING");

    status.put("progress", progress);

    status.put("processedCount", processedCount);

    status.put("executedCount", executedCount);

    status.put("insertCount", insertCount);

    status.put("updateCount", updateCount);

    status.put("deleteCount", deleteCount);

    status.put("otherCount", otherCount);

    status.put("totalStatements", totalStatements);

    status.put("executionSpeed", executionSpeed);

    status.put("elapsedSeconds", elapsedSeconds);

    status.put("etaSeconds", etaSeconds);

    status.put("currentLine", lineNumber);

    status.put("startedAt", startedAt);

    status.put(
        "message",
        "Processing " +
        processedCount +
        " / " +
        totalStatements
    );

    JOB_STATUS.put(jobId, status);
}