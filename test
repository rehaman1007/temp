const AdminSupport = () => {
  const [paginationModel, setPaginationModel] = useState({ page: 0, pageSize: 50 });
  const [query, setQuery] = useState("SELECT * FROM USERS_MASTER");
  const [results, setResults] = useState({ rows: [], columns: [] });

  const { mutate: executeSql, isPending } = useMutation({
    mutationFn: async ({ sql, page, size }) => {
      return await callApi("/api/transaction-con/admin-execute", { 
        sql, 
        page, 
        size 
      }, "POST");
    },
    onSuccess: (data) => {
      if (data.error) {
        showSnackbar(data.message, "error"); // Shows Oracle Syntax Error
        return;
      }
      
      // Map columns...
      const formattedCols = (data?.columns || []).map(col => ({
        field: col.name,
        headerName: col.name,
        flex: 1,
        minWidth: 150,
      }));
      
      setResults({ rows: data?.rows || [], columns: formattedCols });
    }
  });

  // Re-run when page changes
  const handlePaginationChange = (newModel) => {
    setPaginationModel(newModel);
    executeSql({ sql: query, page: newModel.page, size: newModel.pageSize });
  };

  return (
    <Box sx={{ height: '100vh', display: 'flex', flexDirection: 'column', p: 2, gap: 2 }}>
      {/* ... Editor Section ... */}
      
      <DataGrid
        rows={results.rows}
        columns={results.columns}
        loading={isPending}
        paginationMode="server" // Crucial for large data
        rowCount={1000000} // You can implement a count query for total rows
        paginationModel={paginationModel}
        onPaginationModelChange={handlePaginationChange}
        pageSizeOptions={[25, 50, 100]}
        // ... styling ...
      />
    </Box>
  );
};
