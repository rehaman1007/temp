import { useState, useEffect, useCallback } from "react";
import useApi from "./useApi";
import useStreamApi from "./useStreamApi";
import useCustomSnackbar from "../utils/useCustomSnackbar";

const BASE_URL = "/NS/notifications";

const useNotifications = () => {
  const { callApi } = useApi();
  const { showSnackbar } = useCustomSnackbar();
  const { startStream, stopStream, lastMessage, connected } = useStreamApi();

  const [pageNumber, setPageNumber] = useState(0);
  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [hasMore, setHasMore] = useState(true);
  const size = 10;

  /** --- Fetch unread count --- **/
  const fetchUnreadCount = useCallback(async () => {
    try {
      const data = await callApi(`${BASE_URL}/unread-count`);
      if (data?.count !== undefined) setUnreadCount(data.count);
    } catch (err) {
      console.error("Failed to fetch unread count:", err);
    }
  }, [callApi]);

  /** --- Fetch notification history (paged) --- **/
  const fetchHistory = useCallback(
    async (page = 0) => {
      try {
        const data = await callApi(`${BASE_URL}?page=${page}&size=${size}`);
        const newItems = data?.content || [];
        setNotifications((prev) => [...prev, ...newItems]);
        setHasMore(!data?.last);
        setPageNumber(page);
      } catch (err) {
        console.error("Failed to fetch notifications:", err);
        showSnackbar("Failed to load notifications", "error");
      }
    },
    [callApi, size, showSnackbar]
  );

  /** --- Mark as read --- **/
  const markAsRead = useCallback(
    async (id) => {
      try {
        const response = await callApi(`${BASE_URL}/${id}/read`, {}, "POST");
        if (response) {
          setNotifications((prev) =>
            prev.map((n) => (n.id === id ? { ...n, read: true } : n))
          );
          setUnreadCount((prev) => prev - 1);
        } else {
          showSnackbar("Failed to mark as read", "error");
        }
      } catch (err) {
        console.error("Mark as read failed:", err);
      }
    },
    [callApi, showSnackbar]
  );

  /** --- Mark as read --- **/
  const markAllAsRead = useCallback(async () => {
    try {
      const response = await callApi(`${BASE_URL}/read-all`, {}, "POST");
      if (response) {
        setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));
        setUnreadCount(0);
      } else {
        showSnackbar("Failed to mark all notifications as read", "error");
      }
    } catch (err) {
      console.error("Mark as read failed:", err);
    }
  }, [callApi, showSnackbar]);

  /** --- SSE stream: receive live notifications --- **/
  useEffect(() => {
    fetchUnreadCount();
    fetchHistory(0); // load first page

    startStream(`${BASE_URL}/stream`, {
      onMessage: (newNotification) => {
        console.log("newNotification >", newNotification);
      },
    });

    return () => stopStream();
  }, [fetchUnreadCount, fetchHistory, startStream, stopStream]);

  /** --- When new message arrives externally --- **/
  useEffect(() => {
    if (lastMessage) {
      setNotifications((prev) => [lastMessage, ...prev]);
      setUnreadCount((prev) => prev + 1);
    }
  }, [lastMessage]);

  /** --- Pagination helper --- **/
  const loadMore = useCallback(() => {
    if (hasMore) fetchHistory(pageNumber + 1);
  }, [hasMore, fetchHistory, pageNumber]);

  return {
    connected,
    notifications,
    unreadCount,
    fetchUnreadCount,
    fetchHistory,
    markAsRead,
    markAllAsRead,
    stopStream,
    loadMore,
    hasMore,
  };
};

export default useNotifications;

import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  Box,
  Drawer,
  Typography,
  IconButton,
  Button,
  Paper,
  Tooltip,
  Stack,
  Chip,
} from "@mui/material";
import { Close, DoneAll, NotificationsNone } from "@mui/icons-material";
import { formatRelativeTime } from "../utils/CommonUtilities";
import { useSelector } from "react-redux";
import useNavigateToPage from "../hooks/useNavigateToPage";
import { styles } from "./NotificationStyles";
import ListAltIcon from "@mui/icons-material/ListAlt";
import MarkEmailUnreadIcon from "@mui/icons-material/MarkEmailUnread";
import MarkEmailReadIcon from "@mui/icons-material/MarkEmailRead";
import { getIconComponent } from "../utils/IconUtils";
import NotificationPopup from "./NotificationPopup";

const NotificationDrawer = ({
  notificationDrawerOpen,
  setNotificationDrawerOpen,
  notifications,
  markAsRead,
  markAllAsRead,
  loadMore,
  hasMore,
}) => {
  const { navigateToPage } = useNavigateToPage();
  const menuItems = useSelector((state) => state.menus.menus);
  const [popNotification, setPopNotification] = useState(null);

  /** FILTER STATE */
  const [filter, setFilter] = useState("all");

  /** SORT FIRST ALWAYS */
  const sorted = useMemo(() => {
    return [...notifications].sort(
      (a, b) => new Date(b.createdAt) - new Date(a.createdAt)
    );
  }, [notifications]);

  /** APPLY FILTER ON SORTED LIST */
  const filteredList = useMemo(() => {
    if (filter === "read") return sorted.filter((n) => n.read);
    if (filter === "unread") return sorted.filter((n) => !n.read);
    return sorted;
  }, [filter, sorted]);

  const handleMessageClick = useCallback(
    (row) => {
      console.log(row);
      markAsRead(row.id);

      const menu = menuItems.find((m) => m.route === row.linkUrl);
      if (menu) {
        navigateToPage(menu);
        setNotificationDrawerOpen(false);
      }
    },
    [markAsRead, menuItems]
  );

  return (
    <>
      <Drawer
        anchor="right"
        open={notificationDrawerOpen}
        onClose={() => setNotificationDrawerOpen(false)}
        sx={{
          "& .MuiDrawer-paper": {
            width: 400,
            display: "flex",
            flexDirection: "column",
          },
        }}
      >
        {/* Header */}
        <Box
          sx={{
            p: 3,
            borderBottom: "1px solid #E2E8F0",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Notifications
          </Typography>

          <Stack direction="row" alignItems="center" spacing={1}>
            {filteredList.length > 0 && (
              <Tooltip title="Mark all as read">
                <IconButton size="small">
                  <DoneAll color="primary" onClick={markAllAsRead} />
                </IconButton>
              </Tooltip>
            )}
            <IconButton
              size="small"
              onClick={() => setNotificationDrawerOpen(false)}
            >
              <Close />
            </IconButton>
          </Stack>
        </Box>

        {/* FILTER CHIPS (ONE ROW) */}
        <Box
          sx={{
            display: "flex",
            // flex: 1,
            justifyContent: "space-between",
            gap: { xs: 12, sm: 4 },
            m: 1.5,
          }}
        >
          <Chip
            label="All"
            icon={<ListAltIcon />}
            variant={filter === "all" ? "filled" : "outlined"}
            onClick={() => setFilter("all")}
            color={filter === "all" ? "default" : "default"}
            // Optional: for same-width chips
            sx={{ flexGrow: 1 }}
          />
          <Chip
            label="Unread"
            icon={<MarkEmailUnreadIcon />}
            color="primary"
            variant={filter === "unread" ? "filled" : "outlined"}
            onClick={() => setFilter("unread")}
            // Optional: for same-width chips
            sx={{ flexGrow: 1 }}
          />
          <Chip
            label="Read"
            icon={<MarkEmailReadIcon />}
            color="success"
            variant={filter === "read" ? "filled" : "outlined"}
            onClick={() => setFilter("read")}
            // Optional: for same-width chips
            sx={{ flexGrow: 1 }}
          />
        </Box>
        {/* LIST */}
        {filteredList.length === 0 ? (
          <Box
            sx={{
              flex: 1,
              textAlign: "center",
              mt: 4,
              color: "text.secondary",
            }}
          >
            <NotificationsNone sx={{ fontSize: 50, mb: 1, opacity: 0.6 }} />
            <Typography>No notifications yet</Typography>
          </Box>
        ) : (
          <>
            <Box sx={{ display: "flex", flexDirection: "column", flex: 1 }}>
              {filteredList.map((n, index) => {
                console.log();
                const isRead = n?.read || false;
                const menu = menuItems.find((m) => m.route === n.linkUrl);
                const menuTitle = menu?.title || "General";
                const IconComponent = getIconComponent(
                  menu?.icon || "NotificationsNone"
                );

                return (
                  <Paper
                    key={index}
                    onClick={() => handleMessageClick(n)}
                    sx={styles.notificationPaper(isRead)}
                  >
                    {/* MESSAGE */}
                    <Typography
                      variant="subtitle2"
                      sx={{
                        fontWeight: isRead ? 500 : 600,
                        mb: 1,
                      }}
                    >
                      {n.message}
                    </Typography>

                    {/* ICON + MENU TITLE */}
                    <Stack
                      direction="row"
                      alignItems="center"
                      spacing={1}
                      sx={{ mb: 0.5 }}
                    >
                      <IconComponent sx={{ fontSize: 18, opacity: 0.8 }} />
                      <Typography variant="body2" sx={{ opacity: 0.8 }}>
                        {menuTitle}
                      </Typography>
                    </Stack>

                    {/* TIME */}
                    <Typography variant="caption" color="text.secondary">
                      {formatRelativeTime(n.createdAt)}
                    </Typography>
                  </Paper>
                );
              })}
            </Box>
          </>
        )}

        {/* Footer */}
        {filteredList.length > 0 && (
          <Box sx={{ p: 2, borderTop: "1px solid #E2E8F0" }}>
            {hasMore ? (
              <Button fullWidth variant="outlined" onClick={loadMore}>
                Show More
              </Button>
            ) : (
              <Typography
                variant="body2"
                color="text.secondary"
                align="center"
                sx={{ py: 1 }}
              >
                No more notifications
              </Typography>
            )}
          </Box>
        )}
      </Drawer>
      {popNotification && <NotificationPopup popup={popNotification} />}
    </>
  );
};

export default NotificationDrawer;
import React from "react";
import { Box, Typography, Avatar, Slide, Paper } from "@mui/material";
import NotificationsActiveIcon from "@mui/icons-material/NotificationsActive";

const NotificationPopup = ({ popup }) => {
  if (!popup) return null;

  return (
    <Slide in={!!popup} direction="left" mountOnEnter unmountOnExit>
      <Paper
        elevation={6}
        sx={{
          position: "fixed",
          top: 16,
          right: 16,
          zIndex: 2000,
          p: 2,
          borderRadius: 2,
          display: "flex",
          alignItems: "center",
          gap: 1.5,
          width: { xs: "90%", sm: 360 },
          backgroundColor: "#ffffffcc",
          backdropFilter: "blur(10px)",
        }}
      >
        <Avatar sx={{ bgcolor: "#5D3FD3" }}>
          <NotificationsActiveIcon />
        </Avatar>
        <Box flex={1}>
          <Typography fontWeight={600}>Crysta App</Typography>
          <Typography variant="body2" noWrap>
            {popup.message}
          </Typography>
          <Typography
            variant="caption"
            color="text.secondary"
            sx={{ display: "block", mt: 0.3 }}
          >
            {new Date(popup.createdAt || popup.receivedAt).toLocaleTimeString()}
          </Typography>
        </Box>
      </Paper>
    </Slide>
  );
};

export default NotificationPopup;
