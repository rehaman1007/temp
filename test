package com.fincore.enquiry_service.exception;

import java.time.LocalDateTime;
import java.util.LinkedHashMap;
import java.util.Map;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.context.request.WebRequest;

import com.fincore.enquiry_service.ResponseVO;
import com.fincore.enquiry_service.dto.ApiResponse;

import lombok.extern.slf4j.Slf4j;

@RestControllerAdvice
@Slf4j
public class GlobalException {

	@ExceptionHandler(MethodArgumentNotValidException.class)
	public ResponseEntity<ResponseVO<Object>> handleMethodArgumentNotValidException(
			MethodArgumentNotValidException ex) {

		// FIX (Internal Leak): Replaced ex.getMessage() with a safe, generic log statement
		log.error("Validation failed due to invalid request arguments");

		// Extract the first error message
		String errorMessage = ex.getBindingResult()
				.getFieldErrors()
				.stream()
				.map(error -> error.getField() + ": " + error.getDefaultMessage())
				.findFirst()
				.orElse("Validation failed");

		ResponseVO<Object> responseVo = new ResponseVO<>();
		responseVo.setData(null);
		responseVo.setMessage(errorMessage); // Show actual field + message
		responseVo.setStatus(HttpStatus.BAD_REQUEST); // Use direct constant
		responseVo.setLocalDatetime(LocalDateTime.now());

		return new ResponseEntity<>(responseVo, HttpStatus.BAD_REQUEST);
	}

	@ExceptionHandler({ IllegalArgumentException.class, IllegalStateException.class })
	public ResponseEntity<ResponseVO<Object>> handleIllegalArgumentException(IllegalArgumentException ex) {
		ResponseVO<Object> responseVo = new ResponseVO<>();
		responseVo.setData(null);
		responseVo.setMessage("Provided Id Doesn't exists");
		responseVo.setStatus(HttpStatus.valueOf(HttpStatus.NOT_FOUND.value()));
		responseVo.setLocalDatetime(LocalDateTime.now());
		return new ResponseEntity<>(responseVo, responseVo.getStatus());
	}

	@ExceptionHandler(Exception.class)
	public ResponseEntity<ResponseVO<Object>> handleGlobalException(
			Exception ex,
			WebRequest request) {
		// FIX (Internal Leak): Removed ex.getMessage() and the 'ex' stack trace printout
		log.error("An unexpected internal server error occurred.");
		ResponseVO<Object> responseVo = new ResponseVO<>();
		responseVo.setData(null);
		responseVo.setMessage("An internal server error occurred.");
		responseVo.setStatus(HttpStatus.valueOf(HttpStatus.INTERNAL_SERVER_ERROR.value()));
		responseVo.setLocalDatetime(LocalDateTime.now());
		return new ResponseEntity<>(responseVo, responseVo.getStatus());
	}

	/*
	 * exception to be raised when provided id doesn't exists
	 */
	@ExceptionHandler(NullPointerException.class)
	public ResponseEntity<ResponseVO<Object>> handleNullPointerException(NullPointerException ex) {
		ResponseVO<Object> responseVo = new ResponseVO<>();
		responseVo.setData(null);
		responseVo.setMessage("Provided Id Doesn't exists");
		responseVo.setStatus(HttpStatus.valueOf(HttpStatus.NOT_FOUND.value()));
		responseVo.setLocalDatetime(LocalDateTime.now());
		return new ResponseEntity<>(responseVo, responseVo.getStatus());
	}

	@ExceptionHandler(NoDataFoundException.class)
	public ResponseEntity<ApiResponse<?>> handleNoData(NoDataFoundException e) {
		// FIX (External Leak): Replaced e.getMessage() with a static safe message
		return ResponseEntity.ok(ApiResponse.error("No data found for the requested criteria."));
	}

	/*
	 * exception to be raised when userid of request id is not matched with token id
	 */
	@ExceptionHandler({ UserIdMismatchException.class })
	public ResponseEntity<ApiResponse<Object>> handleUserIdMisMatch(UserIdMismatchException e) {
		// FIX (External Leak): Replaced e.getMessage() with a static safe message
		return ResponseEntity.ok(ApiResponse.error("User ID mismatch detected."));
	}

	/*
	 * exception to be raised when userid of request id is not matched with token id
	 */
	@ExceptionHandler(ExportLimitException.class)
	public ResponseEntity<ApiResponse<Object>> handleLimitExceed(ExportLimitException e) {
		log.info("Export limit exceeded");
		// FIX (Internal Leak): Removed e.getMessage() from the logger
		log.error("A user attempted to exceed the allowed export limit.");
		// FIX (External Leak): Replaced e.getMessage() with a static safe message
		return new ResponseEntity<>(ApiResponse.error("Export limit exceeded."), HttpStatus.EXPECTATION_FAILED);
	}

	/**
	 *          Exception to be raised when wrong values being passed in parameters.
	 */
	@ExceptionHandler(BadRequestException.class)
	public ResponseEntity<Map<String, Object>> handleBadRequest(
			BadRequestException ex) {

		Map<String, Object> response = new LinkedHashMap<>();

		response.put("success", false);
		// FIX (External Leak): Replaced ex.getMessage() with a static safe message
		response.put("message", "Invalid request parameters provided.");

		return ResponseEntity.status(HttpStatus.BAD_REQUEST)
				.body(response);
	}
}
