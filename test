const handleFieldChange = (field, value) => {
  setCurrentRow((prev) => {
    const updated = {
      ...prev,
      [field]: value?.toUpperCase(),
    };

    updated.GD_FINAL_AMOUNT = (
      parseFloat(updated.GD_AMOUNT || 0) + parseFloat(updated.GD_INTT_ACCRUED || 0)
    ).toFixed(2);

    return updated;
  });
};