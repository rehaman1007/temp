// src/pages/DashboardPage.jsx
import React, { useEffect, useState } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  Chip,
  List,
  ListItem,
  ListItemText,
  Divider
} from "@mui/material";
import Grid from "@mui/material/Grid";

import { ResponsiveContainer, BarChart, Bar, XAxis, YAxis, Tooltip, Legend } from "recharts";
import useApi from "../../hooks/useApi";
import { DashboardHead } from "./components/DashboardHead";
import CustomMiniPie from "../components/CustomMiniPie";

const COLORS = ["#7b61ff", "#a6a5ff", "#82ca9d", "#ffc658", "#ff7f50"];

function getSeverityColor(severity) {
  switch (severity) {
    case "WARN":
      return "warning";
    case "ERROR":
      return "error";
    case "INFO":
    default:
      return "info";
  }
}

function mapLabelMap(key) {
  const labelMap = {
    BRANCH: "Branch",
    CURRENCY: "Currency",
    ROLE_MANAGEMENT: "Role Management",
    SEGMENT: "Segment",
    CGL: "CGL",
    STATE: "State",
    USER_MANAGEMENT: "User Management",
    CALENDER: "Calendar",
    CIRCLE: "Circle"
  };
  return labelMap[key] || key;
}

const EmptyState = ({ text }) => (
  <Stack alignItems="center" justifyContent="center" sx={{ height: "100%" }}>
    <Typography variant="caption" color="text.secondary">
      {text}
    </Typography>
  </Stack>
);

const DashboardPage = () => {
  const { callApi } = useApi();
  const [rawData, setRawData] = useState(null);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const load = async () => {
      setLoading(true);
      try {
        const res = await callApi("/DS/dashboard/init", null, "GET");
        // adapt to your callApi return shape
        const payload = res?.data ? res.data : res;
        if (payload?.success || payload?.stats) {
          const data = payload.data ? payload.data : payload;
          setRawData(data);
        }
      } catch (e) {
        console.error("Failed to load dashboard", e);
      } finally {
        setLoading(false);
      }
    };
    load();
  }, [callApi]);

  if (loading || !rawData) {
    return (
      <Box p={3}>
        <Typography variant="body1">Loading dashboard…</Typography>
      </Box>
    );
  }

  const stats = rawData.stats || {};

  // transform functions
  const buildPieFromDetailObj = (detailObj) =>
    Object.entries(detailObj || {}).map(([k, v]) => ({ label: mapLabelMap(k), value: Number(v) || 0 }));

  const myPendingPie = buildPieFromDetailObj(stats.myPendingDetails);
  const myApprovedPie = buildPieFromDetailObj(stats.myApprovedDetails);
  const myRejectedPie = buildPieFromDetailObj(stats.myRejectedDetails);
  const pendingForMePie = buildPieFromDetailObj(stats.pendingForMeDetails);

  // bar data: Pending vs Approved vs Rejected (module-wise)
  const allModules = new Set([
    ...Object.keys(stats.myPendingDetails || {}),
    ...Object.keys(stats.myApprovedDetails || {}),
    ...Object.keys(stats.myRejectedDetails || {})
  ]);
  const statusByModule = Array.from(allModules).map((m) => ({
    module: mapLabelMap(m),
    pending: stats.myPendingDetails?.[m] || 0,
    approved: stats.myApprovedDetails?.[m] || 0,
    rejected: stats.myRejectedDetails?.[m] || 0
  }));

  return (
    <Box p={3}>
      {/* Rows 1 & 2 */}
      <DashboardHead />

      {/* Row 3: Module-wise bar chart */}
      <Grid container spacing={2} mb={3}>
        <Grid item xs={12}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Pending vs Approved vs Rejected (Module-wise)
              </Typography>

              <Box sx={{ width: "100%", height: 320 }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={statusByModule}>
                    <XAxis dataKey="module" />
                    <YAxis />
                    <Tooltip />
                    <Legend />
                    <Bar dataKey="pending" name="Pending" fill="#7b61ff" />
                    <Bar dataKey="approved" name="Approved" fill="#82ca9d" />
                    <Bar dataKey="rejected" name="Rejected" fill="#ff7f50" />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* Row 4: Four small charts using CustomMiniPie */}
      <Grid container spacing={2} mb={3}>
        <Grid item xs={12} md={3}>
          <CustomMiniPie title="My Approved (Module-wise)" seriesData={myApprovedPie} width={220} height={180} />
        </Grid>

        <Grid item xs={12} md={3}>
          <CustomMiniPie title="My Pending (Module-wise)" seriesData={myPendingPie} width={220} height={180} />
        </Grid>

        <Grid item xs={12} md={3}>
          <CustomMiniPie title="My Rejected (Module-wise)" seriesData={myRejectedPie} width={220} height={180} />
        </Grid>

        <Grid item xs={12} md={3}>
          <CustomMiniPie title="Pending For My Approval (Module-wise)" seriesData={pendingForMePie} width={220} height={180} />
        </Grid>
      </Grid>

      {/* Row 5: Recent Activity and Announcements */}
      <Grid container spacing={2} mb={3}>
        <Grid item xs={12} md={6}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Recent Activity
              </Typography>

              <List dense sx={{ maxHeight: 320, overflow: "auto" }}>
                {(rawData.recentActivity || []).slice(0, 20).map((r, idx) => (
                  <React.Fragment key={r.timestamp + idx}>
                    {idx > 0 && <Divider component="li" />}
                    <ListItem alignItems="flex-start">
                      <ListItemText
                        primary={
                          <Stack direction="row" spacing={1} alignItems="center">
                            <Typography variant="body2" fontWeight={600}>
                              {r.action}
                            </Typography>
                            <Chip
                              label={r.status}
                              size="small"
                              color={r.status === "PENDING" ? "warning" : r.status === "REJECTED" ? "error" : "success"}
                              variant="outlined"
                            />
                          </Stack>
                        }
                        secondary={
                          <>
                            <Typography component="span" variant="caption" color="text.secondary" display="block">
                              {r.displayTime}
                            </Typography>
                            <Typography variant="body2">{r.details}</Typography>
                          </>
                        }
                      />
                    </ListItem>
                  </React.Fragment>
                ))}
                {(!rawData.recentActivity || rawData.recentActivity.length === 0) && <EmptyState text="No activity" />}
              </List>
            </CardContent>
          </Card>
        </Grid>

        <Grid item xs={12} md={6}>
          <Card variant="outlined" sx={{ borderRadius: 3 }}>
            <CardContent>
              <Typography variant="subtitle2" fontWeight={600} mb={1}>
                Announcements
              </Typography>

              <List dense sx={{ maxHeight: 320, overflow: "auto" }}>
                {(rawData.announcements || []).map((a, idx) => (
                  <React.Fragment key={a.id || idx}>
                    {idx > 0 && <Divider component="li" />}
                    <ListItem alignItems="flex-start">
                      <ListItemText
                        primary={
                          <Stack direction="row" spacing={1} alignItems="center">
                            <Typography variant="body2" fontWeight={600}>
                              {a.title}
                            </Typography>
                            <Chip label={a.severity} size="small" color={getSeverityColor(a.severity)} variant="outlined" />
                          </Stack>
                        }
                        secondary={
                          <>
                            <Typography component="span" variant="caption" color="text.secondary" display="block">
                              {a.date}
                            </Typography>
                            <Typography variant="body2">{a.message}</Typography>
                          </>
                        }
                      />
                    </ListItem>
                  </React.Fragment>
                ))}
                {(!rawData.announcements || rawData.announcements.length === 0) && <EmptyState text="No announcements" />}
              </List>
            </CardContent>
          </Card>
        </Grid>
      </Grid>
    </Box>
  );
};

export default DashboardPage;

// src/components/CustomMiniPie.jsx
import * as React from "react";
import PropTypes from "prop-types";
import { PieChart } from "@mui/x-charts/PieChart";
import { useDrawingArea } from "@mui/x-charts/hooks";
import { styled } from "@mui/material/styles";
import Typography from "@mui/material/Typography";
import Card from "@mui/material/Card";
import CardContent from "@mui/material/CardContent";
import Box from "@mui/material/Box";
import Stack from "@mui/material/Stack";
import LinearProgress, { linearProgressClasses } from "@mui/material/LinearProgress";
import Avatar from "@mui/material/Avatar";

const StyledText = styled("text", {
  shouldForwardProp: (prop) => prop !== "variant"
})(({ theme }) => ({
  textAnchor: "middle",
  dominantBaseline: "central",
  fill: (theme.vars || theme).palette.text.secondary,
  variants: [
    {
      props: { variant: "primary" },
      style: { fontSize: theme.typography.h6.fontSize, fontWeight: theme.typography.h6.fontWeight }
    },
    {
      props: ({ variant }) => variant !== "primary",
      style: { fontSize: theme.typography.body2.fontSize, fontWeight: theme.typography.body2.fontWeight }
    }
  ]
}));

function PieCenterLabel({ primaryText, secondaryText }) {
  const { width, height, left, top } = useDrawingArea();
  const primaryY = top + height / 2 - 8;
  const secondaryY = primaryY + 20;

  return (
    <React.Fragment>
      <StyledText variant="primary" x={left + width / 2} y={primaryY}>
        {primaryText}
      </StyledText>
      <StyledText variant="secondary" x={left + width / 2} y={secondaryY}>
        {secondaryText}
      </StyledText>
    </React.Fragment>
  );
}

PieCenterLabel.propTypes = {
  primaryText: PropTypes.string.isRequired,
  secondaryText: PropTypes.string.isRequired
};

const defaultColors = [
  "hsl(220, 25%, 65%)",
  "hsl(220, 25%, 45%)",
  "hsl(220, 25%, 30%)",
  "hsl(220, 25%, 20%)"
];

export default function CustomMiniPie({ title, seriesData = [], width = 220, height = 180 }) {
  // seriesData: [{ label: 'Branch', value: 3 }, ...]
  const total = seriesData.reduce((s, it) => s + (Number(it.value) || 0), 0);
  const chartData = seriesData.map((d) => ({ label: d.label, value: Number(d.value) || 0 }));

  // Build legend items (each gets a percent value). Keep order and colors stable.
  const legendItems = chartData.map((d, idx) => ({
    name: d.label,
    value: total > 0 ? Math.round((d.value / total) * 100) : 0,
    color: defaultColors[idx % defaultColors.length],
    icon: <Avatar sx={{ width: 18, height: 18, bgcolor: defaultColors[idx % defaultColors.length] }} />
  }));

  return (
    <Card
      variant="outlined"
      sx={{
        borderRadius: 3,
        height: "100%",
        transition: "transform .14s ease, box-shadow .14s ease",
        "&:hover": { transform: "translateY(-4px)", boxShadow: 4 }
      }}
    >
      <CardContent>
        <Typography component="h3" variant="subtitle2" sx={{ mb: 1 }}>
          {title}
        </Typography>

        <Box sx={{ display: "flex", gap: 2, alignItems: "center" }}>
          <Box sx={{ width, height }}>
            <PieChart
              colors={defaultColors}
              margin={{ left: 24, right: 24, top: 24, bottom: 24 }}
              series={[
                {
                  data: chartData,
                  innerRadius: Math.round(width * 0.28),
                  outerRadius: Math.round(width * 0.42),
                  paddingAngle: 0,
                  highlightScope: { fade: "global", highlight: "item" }
                }
              ]}
              height={height}
              width={width}
              hideLegend
            >
              <PieCenterLabel primaryText={`${total}`} secondaryText="Total" />
            </PieChart>
          </Box>

          <Box sx={{ flex: 1, minWidth: 140 }}>
            <Stack spacing={1}>
              {legendItems.length === 0 && (
                <Typography variant="caption" color="text.secondary">
                  No data
                </Typography>
              )}

              {legendItems.map((it, idx) => (
                <Stack key={it.name + idx} direction="row" alignItems="center" spacing={1}>
                  <Box sx={{ width: 28 }}>{it.icon}</Box>

                  <Box sx={{ flex: 1 }}>
                    <Stack direction="row" justifyContent="space-between" alignItems="center">
                      <Typography variant="body2" sx={{ fontWeight: 600 }}>
                        {it.name}
                      </Typography>
                      <Typography variant="body2" color="text.secondary">
                        {it.value}%
                      </Typography>
                    </Stack>

                    <LinearProgress
                      variant="determinate"
                      value={it.value}
                      sx={{
                        height: 8,
                        borderRadius: 2,
                        mt: 0.5,
                        [`& .${linearProgressClasses.bar}`]: {
                          backgroundColor: it.color
                        }
                      }}
                      aria-label={`${it.name} share`}
                    />
                  </Box>
                </Stack>
              ))}
            </Stack>
          </Box>
        </Box>
      </CardContent>
    </Card>
  );
}

CustomMiniPie.propTypes = {
  title: PropTypes.string,
  seriesData: PropTypes.arrayOf(
    PropTypes.shape({ label: PropTypes.string, value: PropTypes.oneOfType([PropTypes.number, PropTypes.string]) })
  ),
  width: PropTypes.number,
  height: PropTypes.number
};