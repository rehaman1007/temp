import React, { useEffect, useState } from "react";
import { BrowserRouter as Router } from "react-router-dom";
import { Box, CircularProgress } from "@mui/material";
import SideMenu from "./SideMenu";
import AppRouter from "./AppRouter";

export default function App() {
  const [userData, setUserData] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    // Check session storage first
    const savedData = sessionStorage.getItem("appData");
    if (savedData) {
      setUserData(JSON.parse(savedData));
      setLoading(false);
    } else {
      // Simulate API call
      setTimeout(() => {
        const response = {
          user: { id: 1, name: "John Doe", role: "admin" },
          menu: [
            { title: "Dashboard", path: "dashboard", component: "Dashboard" },
            { title: "Analytics", path: "dashboard/analytics", component: "Analytics" },
            { title: "Reports", path: "reports", component: "Reports" }
          ],
          extraRoutes: [
            { path: "settings", component: "Settings" } // Not in side menu
          ],
          defaultPage: "homepage"
        };
        sessionStorage.setItem("appData", JSON.stringify(response));
        setUserData(response);
        setLoading(false);
      }, 1000);
    }
  }, []);

  if (loading) return <CircularProgress />;

  return (
    <Router>
      <Box sx={{ display: "flex" }}>
        <SideMenu menuItems={userData.menu} role={userData.user.role} />
        <Box sx={{ flex: 1, p: 2 }}>
          <AppRouter userData={userData} />
        </Box>
      </Box>
    </Router>
  );
}
