/* NUMBER FILTERS */
if (Number.class.isAssignableFrom(path.getJavaType())) {

    Double numberValue =
            Double.valueOf(filter.getValue().toString());

    Expression<Number> numberPath =
            path.as(Number.class);

    switch (operator) {

        case "=", "equals", "is" ->
                predicates.add(
                        cb.equal(numberPath, numberValue));

        case "!=", "not" ->
                predicates.add(
                        cb.notEqual(numberPath, numberValue));

        case ">" ->
                predicates.add(
                        cb.gt(numberPath, numberValue));

        case ">=" ->
                predicates.add(
                        cb.ge(numberPath, numberValue));

        case "<" ->
                predicates.add(
                        cb.lt(numberPath, numberValue));

        case "<=" ->
                predicates.add(
                        cb.le(numberPath, numberValue));

        case "isEmpty" ->
                predicates.add(
                        cb.isNull(path));

        case "isNotEmpty" ->
                predicates.add(
                        cb.isNotNull(path));
    }

    continue;
}

/* STRING FILTERS */
Expression<String> expression =
        cb.lower(path.as(String.class));

String value =
        filter.getValue().toString().toLowerCase();

switch (operator) {

    case "contains" ->
            predicates.add(
                    cb.like(expression,
                            "%" + value + "%"));

    case "startsWith" ->
            predicates.add(
                    cb.like(expression,
                            value + "%"));

    case "endsWith" ->
            predicates.add(
                    cb.like(expression,
                            "%" + value));

    case "equals", "is", "=" ->
            predicates.add(
                    cb.equal(expression,
                            value));

    case "!=", "not" ->
            predicates.add(
                    cb.notEqual(expression,
                            value));

    case "isAnyOf" -> {

        if (filter.getValue() instanceof List<?> values) {

            List<String> lowerValues =
                    values.stream()
                            .map(Object::toString)
                            .map(String::toLowerCase)
                            .toList();

            predicates.add(
                    expression.in(lowerValues));
        } else {

            predicates.add(
                    cb.equal(
                            expression,
                            filter.getValue()
                                    .toString()
                                    .toLowerCase()));
        }
    }

    case "isEmpty" ->
            predicates.add(
                    cb.or(
                            cb.isNull(path),
                            cb.equal(expression, "")
                    ));

    case "isNotEmpty" ->
            predicates.add(
                    cb.and(
                            cb.isNotNull(path),
                            cb.notEqual(expression, "")
                    ));
}