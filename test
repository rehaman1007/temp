import { Box, Typography, Divider } from "@mui/material";

const ProcessStatusHeader = () => (
  <Box sx={{ mb: 3 }}>
    <Typography variant="h5" fontWeight={700}>
      End of Day – Process Status
    </Typography>

    <Typography color="text.secondary" sx={{ mt: 0.5 }}>
      Monitor stage-wise execution of ETL, reconciliation, and downstream
      processes in real time.
    </Typography>

    <Divider sx={{ mt: 2 }} />
  </Box>
);

export default ProcessStatusHeader;

import { Box, Typography, Stack, Chip } from "@mui/material";
import TimelineIcon from "@mui/icons-material/Timeline";
import SyncIcon from "@mui/icons-material/Sync";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";

const ProcessStatusHeader = ({ processes = [] }) => {
  const running = processes.some(p =>
    p.stageDetails?.some(s => s.status === 1)
  );
  const completed =
    processes.length > 0 &&
    processes.every(p =>
      p.stageDetails?.every(s => s.status === 2)
    );

  return (
    <Box
      sx={{
        mb: 3,
        p: 3,
        borderRadius: 3,
        background: "linear-gradient(135deg, #1e3c72 0%, #2a5298 100%)",
        color: "#fff",
        boxShadow: "0 10px 30px rgba(0,0,0,0.2)",
      }}
    >
      <Stack spacing={1}>
        <Stack direction="row" spacing={1} alignItems="center">
          <TimelineIcon />
          <Typography variant="h5" fontWeight={700}>
            Process Execution Monitor
          </Typography>
        </Stack>

        <Typography sx={{ opacity: 0.9 }}>
          Track real-time ETL and reconciliation jobs, stage-wise execution,
          and system progress for the selected business date.
        </Typography>

        <Stack direction="row" spacing={1} mt={1}>
          {running && (
            <Chip
              icon={<SyncIcon />}
              label="Processes Running"
              sx={{ bgcolor: "warning.main", color: "#fff" }}
            />
          )}
          {completed && (
            <Chip
              icon={<CheckCircleOutlineIcon />}
              label="All Processes Completed"
              sx={{ bgcolor: "success.main", color: "#fff" }}
            />
          )}
        </Stack>
      </Stack>
    </Box>
  );
};

export default ProcessStatusHeader;

