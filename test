import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  Grid,
  TextField,
  Typography,
} from "@mui/material";
import useApi from "../../hooks/useApi";

// ICONS
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import NoteIcon from "@mui/icons-material/Note";
import CustomChip from "../../utils/CustomChip";

// Classification lookup
const ACCOUNT_CLASSIFICATIONS = {
  A: {
    label: "Asset",
    icon: <DatasetIcon fontSize="small" />,
    color: "primary",
  },
  L: {
    label: "Liability",
    icon: <AccountBalanceWalletIcon fontSize="small" />,
    color: "warning",
  },
  I: {
    label: "Income",
    icon: <TrendingUpIcon fontSize="small" />,
    color: "success",
  },
  E: {
    label: "Expense",
    icon: <TrendingDownIcon fontSize="small" />,
    color: "error",
  },
  M: { label: "Memo A/c", icon: <NoteIcon fontSize="small" />, color: "info" },
};

export default function CglView() {
  const { callApi } = useApi();

  const [searchText, setSearchText] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search ----
  useEffect(() => {
    const text = searchText.trim();
    if (text.length < 3) {
      setOptions([]);
      return;
    }

    let cancel = false;

    const fetchData = async () => {
      try {
        setLoading(true);

        const res = await callApi(
          "/CM/cglWithSegment",
          { cglNumb: text, cglDesc: text },
          "GET"
        );

        if (!cancel) setOptions(res?.data?.data || []);
      } catch (e) {
        if (!cancel) {
          setOptions([]);
          setSelected(null);
        }
      } finally {
        if (!cancel) setLoading(false);
      }
    };

    fetchData();
    return () => {
      cancel = true;
    };
  }, [searchText, callApi]);

  const classification = selected
    ? ACCOUNT_CLASSIFICATIONS[selected.acClassification]
    : null;

  return (
    <Box
      sx={{
        p: 3,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
      }}
    >
      <Typography variant="h6" sx={{ mb: 2, fontWeight: 600 }}>
        CGL View
      </Typography>

      {/* SINGLE SEARCH FIELD */}
      <Box sx={{ width: "75%", maxWidth: 1000, mb: 3 }}>
        <Autocomplete
          fullWidth
          value={selected}
          loading={loading}
          options={options}
          onChange={(_, value) => setSelected(value)}
          inputValue={searchText}
          onInputChange={(_, value) => setSearchText(value)}
          getOptionLabel={(opt) =>
            opt ? `${opt.cglNumber} - ${opt.description}` : ""
          }
          noOptionsText={
            searchText.trim().length < 3
              ? "Type at least 3 characters..."
              : "No results found"
          }
          renderInput={(params) => (
            <TextField
              {...params}
              label="Search by CGL Number or Description"
              placeholder="Start typing..."
              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <>
                    {loading && <CircularProgress size={18} />}
                    {params.InputProps.endAdornment}
                  </>
                ),
              }}
            />
          )}
        />
      </Box>

      {/* DETAILS CARD */}
      <Card
        sx={{
          p: 3,
          width: "75%",
          maxWidth: 1000,
        }}
      >
        {!selected ? (
          <Typography sx={{ color: "gray" }}>No record selected</Typography>
        ) : (
          <Grid container spacing={3}>
            {/* ROW 1: CGL Number, Description, Classification */}
            <Grid item xs={12} sm={6} md={4}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 700,
                    color: "text.secondary",
                    whiteSpace: "nowrap",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                  }}
                >
                  CGL Number
                </Typography>
                <Typography
                  variant="h6"
                  fontWeight={600}
                  sx={{ color: "text.primary", wordBreak: "break-word" }}
                >
                  {selected.cglNumber || "N/A"}
                </Typography>
              </Box>
            </Grid>

            <Grid item xs={12} sm={6} md={5}>
              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <Typography
                  variant="subtitle2"
                  sx={{
                    fontWeight: 700,
                    color: "text.secondary",
                    whiteSpace: "nowrap",
                    overflow: "hidden",
                    textOverflow: "ellipsis",
                  }}
                >
                  CGL Description
                </Typography>
                <Typography
                  variant="h6"
                  fontWeight={600}
                  sx={{ color: "text.primary", wordBreak: "break-word" }}
                >
                  {selected.description || "N/A"}
                </Typography>
              </Box>
            </Grid>

            <Grid
              item
              xs={12}
              sm={12}
              md={3}
              sx={{ display: "flex", alignItems: "center" }}
            >
              {classification && (
                <CustomChip
                  variant="filled"
                  color={classification.color}
                  icon={classification.icon}
                  label={classification.label}
                />
              )}
            </Grid>

            {/* ROW 2: Comp1, Segment (code + desc), Comp2 */}
            <Grid item xs={12} sm={6} md={3}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Comp1
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.comp1 || "-"}
              </Typography>
            </Grid>

            <Grid item xs={12} sm={6} md={6}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Segment
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.segmentCode || "-"}
                {selected.segmentDescription
                  ? ` - ${selected.segmentDescription}`
                  : ""}
              </Typography>
            </Grid>

            <Grid item xs={12} sm={6} md={3}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Comp2
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.comp2 || "-"}
              </Typography>
            </Grid>

            {/* ROW 3: Flags */}
            <Grid item xs={12} sm={6} md={4}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Balance Compare
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.balcompare === 1 ? "Include" : "Exclude"}
              </Typography>
            </Grid>

            <Grid item xs={12} sm={6} md={4}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Manual Posting
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.manualPosting === 1 ? "Allowed" : "Not Allowed"}
              </Typography>
            </Grid>

            <Grid item xs={12} sm={6} md={4}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Balance Forward
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.balFwd === 1 ? "Yes" : "No"}
              </Typography>
            </Grid>

            {/* ROW 4: Dates */}
            <Grid item xs={12} sm={6} md={6}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Open Date
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.openDate || "-"}
              </Typography>
            </Grid>

            <Grid item xs={12} sm={6} md={6}>
              <Typography fontWeight={600} sx={{ color: "#555" }}>
                Close Date
              </Typography>
              <Typography sx={{ fontSize: "15px" }}>
                {selected.closeDate || "-"}
              </Typography>
            </Grid>
          </Grid>
        )}
      </Card>
    </Box>
  );
}