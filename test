-- =========================================================
-- FINCORE ADMIN SUPPORT LOGGING SETUP
-- =========================================================

-- =========================================================
-- DROP OLD OBJECTS
-- =========================================================

BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE ADMIN_SUPPORT_LOG CASCADE CONSTRAINTS';
EXCEPTION
    WHEN OTHERS THEN
        NULL;
END;
/

BEGIN
    EXECUTE IMMEDIATE 'DROP SEQUENCE ADMIN_SUPPORT_LOG_SEQ';
EXCEPTION
    WHEN OTHERS THEN
        NULL;
END;
/

BEGIN
    EXECUTE IMMEDIATE 'DROP TRIGGER TRG_ADMIN_SUPPORT_LOG_ID';
EXCEPTION
    WHEN OTHERS THEN
        NULL;
END;
/

-- =========================================================
-- CREATE SEQUENCE
-- =========================================================

CREATE SEQUENCE ADMIN_SUPPORT_LOG_SEQ
START WITH 1
INCREMENT BY 1
NOCACHE
NOCYCLE;

-- =========================================================
-- CREATE TABLE
-- =========================================================
CREATE TABLE admin_support_log (
    id                      NUMBER(20) PRIMARY KEY DEFAULT admin_support_log_seq.NEXTVAL,
    job_id                  VARCHAR2(200),
    user_id                 VARCHAR2(100),
    client_ip               VARCHAR2(200),
    file_name               VARCHAR2(1000),
    execution_type          VARCHAR2(100),
    status                  VARCHAR2(50),
    total_statements        NUMBER(20) DEFAULT 0,
    executed_count          NUMBER(20) DEFAULT 0,
    insert_count            NUMBER(20) DEFAULT 0,
    update_count            NUMBER(20) DEFAULT 0,
    delete_count            NUMBER(20) DEFAULT 0,
    other_count             NUMBER(20) DEFAULT 0,
    failed_statement_number NUMBER(20),
    failed_sql              CLOB,
    exception_type          VARCHAR2(1000),
    exception_message       CLOB,
    execution_speed         NUMBER(20, 2),
    elapsed_seconds         NUMBER(20),
    sql_text                CLOB,
    started_at              TIMESTAMP DEFAULT systimestamp,
    completed_at            TIMESTAMP,
    created_at              TIMESTAMP DEFAULT systimestamp
);

-- =========================================================
-- INDEXES
-- =========================================================

CREATE INDEX IDX_ADMIN_SUPPORT_LOG_JOB
ON ADMIN_SUPPORT_LOG(JOB_ID);

CREATE INDEX IDX_ADMIN_SUPPORT_LOG_USER
ON ADMIN_SUPPORT_LOG(USER_ID);

CREATE INDEX IDX_ADMIN_SUPPORT_LOG_STATUS
ON ADMIN_SUPPORT_LOG(STATUS);

CREATE INDEX IDX_ADMIN_SUPPORT_LOG_CREATED
ON ADMIN_SUPPORT_LOG(CREATED_AT);

CREATE INDEX IDX_ADMIN_SUPPORT_LOG_EXEC_TYPE
ON ADMIN_SUPPORT_LOG(EXECUTION_TYPE);

-- =========================================================
-- COMMENTS
-- =========================================================

COMMENT ON TABLE ADMIN_SUPPORT_LOG IS
'Stores all admin SQL execution logs including uploads, selects, updates, deletes and failures';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.JOB_ID IS
'Unique execution job id';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.USER_ID IS
'Logged in user id';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.CLIENT_IP IS
'Client machine IP address';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.FILE_NAME IS
'Uploaded SQL file name';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.EXECUTION_TYPE IS
'SELECT / INSERT / UPDATE / DELETE / SCRIPT / UPLOAD_SCRIPT';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.STATUS IS
'Execution status';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.EXECUTION_SPEED IS
'Statements executed per second';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.FAILED_SQL IS
'SQL statement which failed';

COMMENT ON COLUMN ADMIN_SUPPORT_LOG.EXCEPTION_MESSAGE IS
'Complete exception stack or message';

