import { useEffect, useState, useRef, useMemo } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ProcessStatusTable from "./components/ProcessStatusTable";
import ProcessDetailsDialog from "./components/ProcessDetailsDialog";
import ProcessSummaryDialog from "./components/ProcessSummaryDialog";
import ProcessStatusHeader from "./components/ProcessStatusHeader";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";

import {
  Grid,
  Box,
  Button,
  Paper,
  Stack,
  Tooltip,
  Typography,
  TextField,
} from "@mui/material";

import PlayArrowIcon from "@mui/icons-material/PlayArrow";
import TaskAltIcon from "@mui/icons-material/TaskAlt";
import EventOutlinedIcon from "@mui/icons-material/EventOutlined";

import { DatePicker } from "@mui/x-date-pickers/DatePicker";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";

/* ================= NORMALIZERS ================= */

const normalizeStageDetails = (stages = []) => {
  const map = new Map();

  stages.forEach((s) => {
    const prev = map.get(s.processStage);
    if (!prev || s.startTime > prev.startTime) {
      map.set(s.processStage, s);
    }
  });

  return Array.from(map.values())
    .sort((a, b) => a.processStage - b.processStage)
    .map((s) => ({
      ...s,
      _START_TIME_RAW: s.startTime,
      _END_TIME_RAW: s.endTime,
      startTime: s.startTime ? timeStampFormatter(s.startTime) : null,
      endTime: s.endTime ? timeStampFormatter(s.endTime) : null,
    }));
};

const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType,
    stageDetails: normalizeStageDetails(p.stageDetails || []),
  }));

const mergeProcesses = (prev = [], incoming = []) => {
  const map = new Map(prev.map((p) => [p.type, p]));
  incoming.forEach((p) => map.set(p.type, p));
  return Array.from(map.values());
};

/* ===================================================== */

const ProcessStatusPage = () => {
  const snackbar = useCustomSnackbar();
  const token = useSelector((s) => s.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const BASE_URL = "/PS/process/processes/data";
  const STREAM_URL = `${service}/process/processes`;

  const [currentEtlDate, setCurrentEtlDate] = useState(null);
  const [selectedDate, setSelectedDate] = useState(null);

  const [processes, setProcesses] = useState([]);
  const [loading, setLoading] = useState(true);

  const [selectedProcessType, setSelectedProcessType] = useState(null);
  const [summaryData, setSummaryData] = useState(null);

  const initialFetchDone = useRef(false);

  /* ================= INITIAL LOAD ================= */

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    loadByDate(null);
  }, []);

  /* ================= LOAD BY DATE ================= */

  const loadByDate = async (date) => {
    setLoading(true);
    try {
      const res = await callApi(BASE_URL, {
        etlDate: date ? date.format("YYYY-MM-DD") : null,
      });

      setCurrentEtlDate(res?.fincoreDate?.etlDate);
      setSelectedDate(
        dayjs(res?.fincoreDate?.etlDate || new Date())
      );

      setProcesses(normalizeProcesses(res?.initialData || []));
    } catch {
      snackbar("Failed to load processes");
    } finally {
      setLoading(false);
    }
  };

  /* ================= SSE (ONLY FOR CURRENT DATE) ================= */

  useEffect(() => {
    if (loading) return;

    if (
      selectedDate &&
      currentEtlDate &&
      selectedDate.format("YYYY-MM-DD") !== currentEtlDate
    ) {
      return; // past date → no streaming
    }

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },
      onmessage(e) {
        if (e.event === "connected") return;
        const raw = JSON.parse(e.data);
        setProcesses((prev) =>
          mergeProcesses(prev, normalizeProcesses(raw))
        );
      },
    });

    return () => controller.abort();
  }, [STREAM_URL, loading, token, selectedDate, currentEtlDate]);

  /* ================= LIVE SELECTED PROCESS ================= */

  const selectedProcess = useMemo(() => {
    if (!selectedProcessType) return null;
    return processes.find((p) => p.type === selectedProcessType);
  }, [processes, selectedProcessType]);

  /* ================= FLAGS ================= */

  const isCurrentDate =
    selectedDate &&
    currentEtlDate &&
    selectedDate.format("YYYY-MM-DD") === currentEtlDate;

  const allCompleted = useMemo(
    () =>
      processes.length &&
      processes.every((p) =>
        p.stageDetails.every((s) => s.status === 2)
      ),
    [processes]
  );

  /* ================= TABLE SUMMARY HANDLER ================= */

  const handleOpenSummary = (row) => {
    const stage6 = [...row.stageDetails]
      .sort((a, b) => b.id - a.id)
      .find((s) => s.processStage === 6);

    if (stage6?.status === 2 && stage6?.differenceSummary) {
      setSummaryData(stage6.differenceSummary);
    } else {
      snackbar("Summary not available");
    }
  };

  /* ===================================================== */

  return (
    <Paper sx={{ p: 3, minHeight: "75vh" }}>

      <ProcessStatusHeader processes={processes} />

      {/* ================= ETL DATE CARD ================= */}

      {currentEtlDate && (
        <Stack alignItems="center" mt={2}>
          <Paper sx={{ px: 3, py: 1.5, display: "flex", gap: 1.5 }}>
            <EventOutlinedIcon color="primary" />
            <Box>
              <Typography variant="caption">Current ETL Date</Typography>
              <Typography fontWeight={600}>{currentEtlDate}</Typography>
            </Box>
          </Paper>
        </Stack>
      )}

      {/* ================= DATE SELECTOR ================= */}

      <Stack alignItems="center" mt={3}>
        <LocalizationProvider dateAdapter={AdapterDayjs}>
          <DatePicker
            label="Select ETL Date"
            value={selectedDate}
            onChange={(d) => {
              setSelectedDate(d);
              loadByDate(d);
            }}
            renderInput={(p) => <TextField {...p} />}
          />
        </LocalizationProvider>
      </Stack>

      {/* ================= EOD BUTTONS (ONLY CURRENT DATE) ================= */}

      {isCurrentDate && (
        <Grid container justifyContent="center" spacing={2} my={3}>
          <Grid>
            <Button
              variant="contained"
              startIcon={<PlayArrowIcon />}
              disabled={processes.length > 0}
            >
              Start EOD
            </Button>
          </Grid>

          <Grid>
            <Button
              variant="contained"
              color="success"
              startIcon={<TaskAltIcon />}
              disabled={!allCompleted}
            >
              Finish EOD
            </Button>
          </Grid>
        </Grid>
      )}

      {/* ================= DIALOGS ================= */}

      <ProcessDetailsDialog
        process={selectedProcess}
        onClose={() => setSelectedProcessType(null)}
      />

      <ProcessSummaryDialog
        open={!!summaryData}
        data={summaryData}
        onClose={() => setSummaryData(null)}
      />

      {/* ================= TABLE ================= */}

      <Box mt={2}>
        <ProcessStatusTable
          loading={loading}
          processes={processes}
          actions={{
            onView: setSelectedProcessType,
            onSummary: handleOpenSummary, // 🔥 NEW
          }}
        />
      </Box>

    </Paper>
  );
};

export default ProcessStatusPage;