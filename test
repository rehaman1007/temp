                    fontSize: 17,

                    mr: 0.6,
                  }}
                />

                Decrypt Response
              </ToggleButton>

              <ToggleButton value="encrypt">
                <LockOutlinedIcon
                  sx={{
                    fontSize: 17,

                    mr: 0.6,
                  }}
                />

                Encrypt Request
              </ToggleButton>
            </ToggleButtonGroup>

            {/* =================================================
                PROCESSOR CONTENT
            ================================================= */}

            <Box
              sx={{
                flex: 1,

                minHeight: 0,

                display: "flex",

                flexDirection:
                  "column",

                gap: {
                  xs: 1,
                  sm: 1.2,
                  md: 1.4,
                },
              }}
            >
              {/* SESSION KEY */}

              <TextField
                fullWidth
                label="Session Key"
                placeholder="payloadEncryptionKey"
                type={
                  showKey
                    ? "text"
                    : "password"
                }
                value={sessionKey}
                onChange={(e) =>
                  setSessionKey(
                    e.target.value
                  )
                }
                autoComplete="off"
                sx={{
                  flexShrink: 0,
                }}
                slotProps={{
                  input: {
                    endAdornment: (
                      <InputAdornment position="end">
                        <Tooltip
                          title="Hold to view key"
                          arrow
                        >
                          <IconButton
                            size="small"
                            onPointerDown={() =>
                              setShowKey(true)
                            }
                            onPointerUp={() =>
                              setShowKey(false)
                            }
                            onPointerLeave={() =>
                              setShowKey(false)
                            }
                            onPointerCancel={() =>
                              setShowKey(false)
                            }
                          >
                            {showKey ? (
                              <VisibilityIcon fontSize="small" />
                            ) : (
                              <VisibilityOffIcon fontSize="small" />
                            )}
                          </IconButton>
                        </Tooltip>
                      </InputAdornment>
                    ),
                  },
                }}
              />

              {/* INPUT */}

              <TextField
                fullWidth
                multiline
                minRows={3}
                maxRows={5}
                label={
                  mode === "decrypt"
                    ? "Encrypted Response"
                    : "JSON Request Payload"
                }
                value={inputData}
                onChange={(e) =>
                  setInputData(
                    e.target.value
                  )
                }
                placeholder={
                  mode === "decrypt"
                    ? "Paste encrypted response here..."
                    : '{\n  "key": "value"\n}'
                }
                autoComplete="off"
                spellCheck={false}
                sx={{
                  flexShrink: 0,

                  "& .MuiInputBase-root": {
                    fontFamily:
                      '"Fira Code", "Roboto Mono", monospace',

                    fontSize: {
                      xs: "0.65rem",
                      sm: "0.7rem",
                      md: "0.74rem",
                    },
                  },
                }}
              />

              {/* ACTIONS */}

              <Box
                sx={{
                  display: "grid",

                  gridTemplateColumns:
                    "0.8fr 1.5fr",

                  gap: 1,

                  flexShrink: 0,
                }}
              >
                <Button
                  variant="outlined"
                  color="inherit"
                  onClick={
                    handleClearPayload
                  }
                  startIcon={
                    <DeleteOutlineIcon />
                  }
                  sx={{
                    py: {
                      xs: 0.8,
                      sm: 0.9,
                      md: 1,
                    },

                    color: "#5D596D",

                    borderColor:
                      "rgba(74,71,163,0.18)",

                    fontSize: {
                      xs: "0.65rem",
                      sm: "0.7rem",
                      md: "0.76rem",
                    },

                    "&:hover": {
                      borderColor:
                        "rgba(74,71,163,0.35)",

                      background:
                        "rgba(74,71,163,0.04)",
                    },
                  }}
                >
                  Clear
                </Button>

                <Button
                  variant="contained"
                  onClick={
                    handleProcess
                  }
                  endIcon={
                    <ArrowForwardIcon />
                  }
                  sx={{
                    py: {
                      xs: 0.8,
                      sm: 0.9,
                      md: 1,
                    },

                    background:
                      "linear-gradient(90deg, #4A47A3, #5D56B8)",

                    fontSize: {
                      xs: "0.65rem",
                      sm: "0.7rem",
                      md: "0.76rem",
                    },

                    "&:hover": {
                      background:
                        "linear-gradient(90deg, #39347F, #4F49A5)",
                    },
                  }}
                >
                  {mode === "decrypt"
                    ? "Decrypt Payload"
                    : "Encrypt Payload"}
                </Button>
              </Box>

              {/* =================================================
                  OUTPUT TERMINAL
              ================================================= */}

              <Box
                sx={{
                  flex: 1,

                  minHeight: 0,

                  display: "flex",

                  flexDirection:
                    "column",

                  borderRadius: 1.8,

                  overflow: "hidden",

                  background:
                    "rgba(40,36,67,0.97)",

                  border:
                    "1px solid rgba(74,71,163,0.20)",

                  boxShadow:
                    "0 8px 22px rgba(45,36,86,0.12)",
                }}
              >
                {/* TERMINAL HEADER */}

                <Box
                  sx={{
                    height: {
                      xs: 32,
                      sm: 35,
                    },

                    flexShrink: 0,

                    display: "flex",

                    alignItems: "center",

                    justifyContent:
                      "space-between",

                    px: {
                      xs: 1,
                      sm: 1.3,
                    },

                    background:
                      "rgba(25,22,43,0.38)",

                    borderBottom:
                      "1px solid rgba(255,255,255,0.07)",
                  }}
                >
                  <Box
                    sx={{
                      display: "flex",

                      alignItems: "center",
                    }}
                  >
                    {/* Terminal dots */}

                    <Box
                      sx={{
                        display: "flex",

                        gap: 0.5,

                        mr: 1,
                      }}
                    >
                      <Box
                        sx={{
                          width: 6,
                          height: 6,

                          borderRadius:
                            "50%",

                          background:
                            "#E58A8A",
                        }}
                      />

                      <Box
                        sx={{
                          width: 6,
                          height: 6,

                          borderRadius:
                            "50%",

                          background:
                            "#D9B96E",
                        }}
                      />

                      <Box
                        sx={{
                          width: 6,
                          height: 6,

                          borderRadius:
                            "50%",

                          background:
                            "#7CBF83",
                        }}
                      />
                    </Box>

                    <TerminalIcon
                      sx={{
                        fontSize: 14,

                        color:
                          "#C9C3E6",

                        mr: 0.6,
                      }}
                    />

                    <Typography
                      sx={{
                        color:
                          "#D6D1EB",

                        fontSize:
                          "0.58rem",

                        fontWeight: 700,

                        letterSpacing:
                          "0.4px",
                      }}
                    >
                      OUTPUT RESULT
                    </Typography>
                  </Box>

                  <Tooltip
                    title="Copy result"
                    arrow
                  >
                    <span>
                      <IconButton
                        size="small"
                        disabled={
                          !outputData
                        }
                        onClick={() =>
                          handleCopy(
                            outputData,
                            "Result copied to clipboard!"
                          )
                        }
                        sx={{
                          color:
                            "#C8C2DF",

                          "&:hover": {
                            color: "#FFFFFF",
                          },

                          "&.Mui-disabled": {
                            color:
                              "#5A566B",
                          },
                        }}
                      >
                        <ContentCopyIcon
                          sx={{
                            fontSize: 14,
                          }}
                        />
                      </IconButton>
                    </span>
                  </Tooltip>
                </Box>

                {/* =================================================
                    OUTPUT CONTENT
                ================================================= */}

                <Box
                  sx={{
                    flex: 1,

                    minHeight: 0,

                    overflowY: "auto",

                    overflowX: "auto",

                    p: {
                      xs: 1.2,
                      sm: 1.5,
                      md: 1.8,
                    },

                    "&::-webkit-scrollbar": {
                      width: 6,
                      height: 6,
                    },

                    "&::-webkit-scrollbar-track": {
                      background:
                        "rgba(255,255,255,0.03)",
                    },

                    "&::-webkit-scrollbar-thumb": {
                      background:
                        "rgba(196,188,231,0.35)",

                      borderRadius: 10,
                    },

                    "&::-webkit-scrollbar-thumb:hover": {
                      background:
                        "rgba(196,188,231,0.55)",
                    },
                  }}
                >
                  {outputData ? (
                    <pre
                      style={{
                        margin: 0,

                        color: "#BDE5C5",

                        fontFamily:
                          '"Fira Code", "Roboto Mono", monospace',

                        fontSize:
                          "clamp(9px, 0.68vw, 12px)",

                        lineHeight: 1.55,

                        whiteSpace:
                          "pre-wrap",

                        overflowWrap:
                          "anywhere",

                        wordBreak:
                          "break-word",

                        textAlign:
                          "left",
                      }}
                    >
                      {outputData}
                    </pre>
                  ) : (
                    <Box
                      sx={{
                        height: "100%",

                        minHeight: 90,

                        display: "flex",

                        alignItems:
                          "center",

                        justifyContent:
                          "center",

                        flexDirection:
                          "column",

                        gap: 0.7,
                      }}
                    >
                      <TerminalIcon
                        sx={{
                          fontSize: 28,

                          color:
                            "rgba(205,198,235,0.22)",
                        }}
                      />

                      <Typography
                        sx={{
                          color:
                            "rgba(215,209,235,0.42)",

                          fontSize: {
                            xs: "0.63rem",
                            sm: "0.68rem",
                          },

                          fontStyle:
                            "italic",
                        }}
                      >
                        Output will appear here
                      </Typography>
                    </Box>
                  )}
                </Box>
              </Box>
            </Box>
          </Paper>
        </Box>

        {/* ====================================================
            FOOTER
        ===================================================== */}

        <Box
          sx={{
            flexShrink: 0,

            height: {
              xs: 18,
              sm: 22,
            },

            display: "flex",

            alignItems: "center",

            justifyContent:
              "center",

            mt: {
              xs: 0.5,
              md: 1,
            },
          }}
        >
          <Typography
            sx={{
              color:
                "rgba(72,68,105,0.62)",

              fontSize: {
                xs: "0.5rem",
                sm: "0.56rem",
                md: "0.6rem",
              },
            }}
          >
            FinCore Application Utility
          </Typography>
        </Box>
      </Box>

      {/* ========================================================
          SNACKBAR
      ========================================================= */}

      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={
          handleCloseSnackbar
        }
        anchorOrigin={{
          vertical: "bottom",
          horizontal: "center",
        }}
      >
        <Alert
          onClose={
            handleCloseSnackbar
          }
          severity={
            snackbar.severity
          }
          variant="filled"
          sx={{
            width: "100%",

            borderRadius: 2,

            boxShadow:
              "0 8px 25px rgba(40,35,80,0.20)",
          }}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>
    </ThemeProvider>
  );
}