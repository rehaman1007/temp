const allowedYear = nextFYInfo?.expectedStart?.year();

const [selectedYear, setSelectedYear] = useState(null);
const [inputValue, setInputValue] = useState("");
const [yearError, setYearError] = useState("");

<LocalizationProvider dateAdapter={AdapterDayjs}>
  <DatePicker
    views={["year"]}
    label="Financial Year*"
    value={selectedYear ? dayjs(`${selectedYear}-01-01`) : null}
    disabled={!allowedYear}

    onChange={(val) => {
      // selection via picker UI
      if (!val || !val.isValid()) return;

      const year = val.year();
      setSelectedYear(year);
      setInputValue(String(year));
      setYearError("");
    }}

    onAccept={(val) => {
      if (!val) return;

      const year = val.year();
      if (year !== allowedYear) {
        setYearError(
          `Only Financial Year ${allowedYear}-${allowedYear + 1} is allowed`
        );
        setSelectedYear(null);
        setInputValue("");
      }
    }}

    slotProps={{
      textField: {
        size: "small",
        fullWidth: true,
        value: inputValue,
        error: Boolean(yearError),

        onChange: (e) => {
          const val = e.target.value;

          // allow only numbers
          if (!/^\d*$/.test(val)) return;

          setInputValue(val);
          setYearError("");
        },

        onBlur: () => {
          if (inputValue.length !== 4) {
            setYearError("Enter a valid 4-digit year");
            setInputValue("");
            setSelectedYear(null);
            return;
          }

          const typedYear = Number(inputValue);

          if (typedYear !== allowedYear) {
            setYearError(
              `Only Financial Year ${allowedYear}-${allowedYear + 1} is allowed`
            );
            setInputValue("");
            setSelectedYear(null);
            return;
          }

          setSelectedYear(typedYear);
          setYearError("");
        },

        helperText: yearError
          ? yearError
          : selectedYear
          ? `Selected Financial Year : ${selectedYear}–${
              selectedYear + 1
            } (April to March)`
          : allowedYear
          ? `Requests are permitted only for Financial Year ${allowedYear}-${
              allowedYear + 1
            }.`
          : "",

        inputProps: {
          maxLength: 4,
          inputMode: "numeric",
        },

        FormHelperTextProps: {
          sx: {
            mt: 1,
            fontSize: "0.9rem",
            fontWeight: 500,
            color: yearError ? "#d32f2f" : "#6500caff",
          },
        },
      },
    }}
  />
</LocalizationProvider>