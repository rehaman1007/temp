import React, { useState, useEffect, useMemo, useDeferredValue } from 'react';
import {
  Box,
  Paper,
  Typography,
  Grid,
  Card,
  CardContent,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Chip,
  Stack,
  InputAdornment,
  Tooltip,
  Skeleton,
  Avatar,
  LinearProgress,
  IconButton,
  Collapse,
} from '@mui/material';

import { PieChart } from '@mui/x-charts/PieChart';

// Icons
import HourglassEmptyIcon from '@mui/icons-material/HourglassEmpty';
import HowToRegIcon from '@mui/icons-material/HowToReg';
import PersonIcon from '@mui/icons-material/Person';
import SearchIcon from '@mui/icons-material/Search';
import AssessmentIcon from '@mui/icons-material/Assessment';
import LockIcon from '@mui/icons-material/Lock';
import ErrorOutlineIcon from '@mui/icons-material/ErrorOutline';
import PendingActionsIcon from '@mui/icons-material/PendingActions';
import PlayCircleOutlineIcon from '@mui/icons-material/PlayCircleOutline';
import InboxIcon from '@mui/icons-material/Inbox';
import ExpandMoreIcon from '@mui/icons-material/ExpandMore';

import useApi from '../../../../common/hooks/useApi';
import LoadingOverlay from '../../../../common/components/ui/loadingOverlay';
import FormInput from '../../../../common/components/ui/FormInput';

const formatDate = (timestamp) => {
  if (!timestamp) return '-';
  const d = new Date(Number(timestamp));
  if (isNaN(d.getTime())) return '-';
  return new Intl.DateTimeFormat('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  }).format(d);
};

const getStatusConfig = (status) => {
  const configs = {
    null: { label: 'Not Initiated', muiColor: 'default', icon: <ErrorOutlineIcon fontSize="small" /> },
    10: { label: 'Initiated', muiColor: 'info', icon: <PlayCircleOutlineIcon fontSize="small" /> },
    11: { label: 'In Progress', muiColor: 'primary', icon: <HourglassEmptyIcon fontSize="small" /> },
    20: { label: 'Pending Approval', muiColor: 'warning', icon: <PendingActionsIcon fontSize="small" /> },
    12: { label: 'Rejected', muiColor: 'error', icon: <ErrorOutlineIcon fontSize="small" /> },
    53: { label: 'Freezed', muiColor: 'success', icon: <LockIcon fontSize="small" /> },
  };
  return configs[String(status)] || configs['null'];
};

const DICGCDashboard = () => {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  const deferredSearch = useDeferredValue(searchTerm);
  const [expandedRow, setExpandedRow] = useState(null);

  const { callApi } = useApi();

  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        const response = await callApi('/bidData/get-dicgc-dashboard', { qed: '30/09/2025' });
        setData(response || []);
      } catch (error) {
        console.error(error);
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, [callApi]);

  // 🔥 Indexed Search Optimization
  const indexedData = useMemo(() => {
    return data.map((item) => ({
      ...item,
      __search: `${item.CIRCLE_NAME || ''} ${item.CIRCLE_CODE || ''}`.toLowerCase(),
    }));
  }, [data]);

  const filteredData = useMemo(() => {
    if (!deferredSearch) return indexedData;
    return indexedData.filter((item) =>
      item.__search.includes(deferredSearch.toLowerCase())
    );
  }, [indexedData, deferredSearch]);

  // 📊 Chart Data
  const chartData = useMemo(() => {
    const counts = data.reduce((acc, item) => {
      const status = String(item.MISC_STATUS);
      acc[status] = (acc[status] || 0) + 1;
      return acc;
    }, {});
    return [
      { id: 0, value: counts['null'] || 0, label: 'Not Initiated', color: '#9e9e9e' },
      { id: 1, value: counts['11'] || 0, label: 'In Progress', color: '#1976d2' },
      { id: 2, value: counts['20'] || 0, label: 'Pending Approval', color: '#ed6c02' },
      { id: 3, value: counts['53'] || 0, label: 'Freezed', color: '#2e7d32' },
      { id: 4, value: counts['12'] || 0, label: 'Rejected', color: '#d32f2f' },
    ].filter((i) => i.value > 0);
  }, [data]);

  return (
    <>
      <Box sx={{ p: 3 }}>
        <Typography variant="h4" fontWeight={800} align="center" gutterBottom>
          DICGC Compliance Hub
        </Typography>

        <Grid container spacing={3}>

          {/* Chart */}
          <Grid item xs={12} md={5}>
            <Paper sx={{ p: 3, borderRadius: 4 }}>
              <Typography fontWeight={700} mb={2}>
                Completion Overview
              </Typography>
              <PieChart
                series={[{ data: chartData, innerRadius: 60, outerRadius: 100 }]}
                width={400}
                height={250}
              />
            </Paper>
          </Grid>

          {/* Search */}
          <Grid item xs={12} md={7}>
            <Paper sx={{ p: 2, borderRadius: 3 }}>
              <FormInput
                fullWidth
                variant="standard"
                placeholder="Search by Circle Name or Code..."
                onChange={(e) => setSearchTerm(e.target.value)}
                InputProps={{
                  disableUnderline: true,
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchIcon />
                    </InputAdornment>
                  ),
                }}
              />
            </Paper>
          </Grid>

          {/* Table */}
          <Grid item xs={12}>
            <TableContainer component={Paper} sx={{ borderRadius: 4 }}>
              <Table stickyHeader>
                <TableHead>
                  <TableRow>
                    <TableCell>Circle</TableCell>
                    <TableCell>Maker</TableCell>
                    <TableCell>Checker</TableCell>
                    <TableCell>Status</TableCell>
                    <TableCell>View</TableCell>
                  </TableRow>
                </TableHead>

                <TableBody>
                  {loading &&
                    Array.from(new Array(5)).map((_, i) => (
                      <TableRow key={i}>
                        <TableCell colSpan={5}>
                          <Skeleton height={40} />
                        </TableCell>
                      </TableRow>
                    ))}

                  {!loading && filteredData.length === 0 && (
                    <TableRow>
                      <TableCell colSpan={5} align="center" sx={{ py: 5 }}>
                        <Stack spacing={1} alignItems="center">
                          <InboxIcon sx={{ fontSize: 50, color: 'grey.400' }} />
                          <Typography fontWeight={600}>No Circles Found</Typography>
                        </Stack>
                      </TableCell>
                    </TableRow>
                  )}

                  {!loading &&
                    filteredData.map((row) => {

                      // 🚫 DICGC Not Available
                      if (!row.BID_FLAG || row.BID_FLAG === 'X') {
                        return (
                          <TableRow key={row.CIRCLE_CODE}>
                            <TableCell colSpan={5} align="center">
                              <Stack alignItems="center" py={2}>
                                <ErrorOutlineIcon color="error" />
                                <Typography color="error" fontWeight={600}>
                                  DICGC Not Available for {row.CIRCLE_NAME}
                                </Typography>
                              </Stack>
                            </TableCell>
                          </TableRow>
                        );
                      }

                      const status = getStatusConfig(row.MISC_STATUS);

                      return (
                        <React.Fragment key={row.CIRCLE_CODE}>
                          <TableRow hover>
                            <TableCell>
                              <Typography fontWeight={700}>
                                {row.CIRCLE_NAME}
                              </Typography>
                              <Typography variant="caption">
                                Code: {row.CIRCLE_CODE}
                              </Typography>

                              <Stack direction="row" spacing={1} mt={1}>
                                {row.BID_FLAG === 'Y' && (
                                  <Chip size="small" label="Automated" color="success" />
                                )}
                                {row.BID_FLAG === 'N' && (
                                  <Chip size="small" label="Manual" color="warning" />
                                )}
                              </Stack>
                            </TableCell>

                            <TableCell>
                              {row.MISC_MAKERID || 'Not Assigned'}
                              <br />
                              <Typography variant="caption">
                                {formatDate(row.MISC_MAKER_UP_DT)}
                              </Typography>
                            </TableCell>

                            <TableCell>
                              {row.MISC_CHECKERID || 'Pending'}
                              <br />
                              <Typography variant="caption">
                                {formatDate(row.MISC_CHECKER_DT)}
                              </Typography>
                            </TableCell>

                            <TableCell>
                              <Stack spacing={1}>
                                <Chip
                                  icon={status.icon}
                                  label={status.label}
                                  color={status.muiColor}
                                />
                                {row.REQUEST_FLAG === 'Y' && (
                                  <Chip
                                    size="small"
                                    label="Requested for Revised BID Data"
                                    color="info"
                                    variant="outlined"
                                  />
                                )}
                              </Stack>
                            </TableCell>

                            <TableCell>
                              <IconButton
                                onClick={() =>
                                  setExpandedRow(
                                    expandedRow === row.CIRCLE_CODE
                                      ? null
                                      : row.CIRCLE_CODE
                                  )
                                }
                              >
                                <ExpandMoreIcon />
                              </IconButton>
                            </TableCell>
                          </TableRow>

                          {/* Expand Row */}
                          <TableRow>
                            <TableCell colSpan={5} sx={{ p: 0 }}>
                              <Collapse in={expandedRow === row.CIRCLE_CODE}>
                                <Box p={2} bgcolor="#f9fafc">
                                  <Typography variant="body2">
                                    <strong>Checker Remarks:</strong>{' '}
                                    {row.MISC_CHECKER_REMARKS || 'N/A'}
                                  </Typography>
                                  <Typography variant="body2">
                                    <strong>Request Remarks:</strong>{' '}
                                    {row.REQUEST_REMARKS || 'N/A'}
                                  </Typography>
                                  <Typography variant="body2">
                                    <strong>Batch ID:</strong>{' '}
                                    {row.DR_BATCH_ID_FK || 'N/A'}
                                  </Typography>
                                </Box>
                              </Collapse>
                            </TableCell>
                          </TableRow>
                        </React.Fragment>
                      );
                    })}
                </TableBody>
              </Table>
            </TableContainer>
          </Grid>
        </Grid>
      </Box>

      <LoadingOverlay loading={loading} />
    </>
  );
};

export default DICGCDashboard;