import React, { useState, useEffect } from "react";
import {
  Autocomplete,
  Box,
  Card,
  CircularProgress,
  TextField,
  Typography,
  Grid,
  Stack,
} from "@mui/material";
import useApi from "../../hooks/useApi";

// ICONS
import InfoIcon from "@mui/icons-material/Info";
import DatasetIcon from "@mui/icons-material/Dataset";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import NoteIcon from "@mui/icons-material/Note";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import CancelIcon from "@mui/icons-material/Cancel";
import BookmarkAddedIcon from "@mui/icons-material/BookmarkAdded";
import BookmarkRemoveIcon from "@mui/icons-material/BookmarkRemove";
import GppGoodIcon from "@mui/icons-material/GppGood";
import GppBadIcon from "@mui/icons-material/GppBad";
import CustomChip from "../../utils/CustomChip";

// Classification lookup
const ACCOUNT_CLASSIFICATIONS = {
  A: {
    label: "Asset",
    icon: <DatasetIcon fontSize="small" />,
  },
  L: {
    label: "Liability",
    icon: <AccountBalanceWalletIcon fontSize="small" />,
  },
  I: {
    label: "Income",
    icon: <TrendingUpIcon fontSize="small" />,
  },
  E: {
    label: "Expense",
    icon: <TrendingDownIcon fontSize="small" />,
  },
  M: { label: "Memo A/c", icon: <NoteIcon fontSize="small" /> },
};

export default function CglView() {
  const { callApi } = useApi();

  const [searchText, setSearchText] = useState("");
  const [options, setOptions] = useState([]);
  const [selected, setSelected] = useState(null);
  const [loading, setLoading] = useState(false);

  // ---- Trigger Search ----
  useEffect(() => {
    const text = searchText.trim();

    if (text.length < 3) {
      setOptions([]);
      return;
    }

    let cancelled = false;

    const fetch = async () => {
      try {
        setLoading(true);
        const res = await callApi(
          "/CM/cglWithSegment",
          { cglNumb: text, cglDesc: text },
          "GET"
        );
        if (!cancelled) setOptions(res?.data?.data || []);
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    fetch();
    return () => (cancelled = true);
  }, [searchText, callApi]);

  const classification = selected
    ? ACCOUNT_CLASSIFICATIONS[selected.acClassification]
    : null;

  return (
    <Box
      sx={{
        p: 3,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
      }}
    >
      {/* SEARCH */}
      <Box sx={{ width: "50%", minWidth: "50%", mb: 3 }}>
        <Autocomplete
          fullWidth
          value={selected}
          loading={loading}
          options={options}
          onChange={(_, v) => setSelected(v)}
          inputValue={searchText}
          onInputChange={(_, v) => setSearchText(v)}
          getOptionLabel={(o) => (o ? `${o.cglNumber} - ${o.description}` : "")}
          noOptionsText={
            searchText.length < 3
              ? "Type at least 3 characters..."
              : "No CGL's found"
          }
          renderInput={(params) => (
            <TextField
              {...params}
              label="Search CGL by Number or Description"
              placeholder="Eg: 1234567890 or abcd"
              InputProps={{
                ...params.InputProps,
                endAdornment: (
                  <>
                    {loading && <CircularProgress size={18} />}
                    {params.InputProps.endAdornment}
                  </>
                ),
              }}
            />
          )}
        />
      </Box>

      {/* DETAILS */}
      <Card sx={{ width: "75%", maxWidth: 1000, p: 3 }}>
        {!selected ? (
          <Box>
            <Stack height="100%" alignItems="center" justifyContent="center">
              <InfoIcon sx={{ fontSize: 40, color: "text.secondary", mb: 2 }} />
              <Typography>
                No CGL selected, Kindly select CGL for showing details
              </Typography>
            </Stack>
          </Box>
        ) : (
          <Box sx={{ m: 2, p: 2 }}>
            <Typography
              variant="h3"
              sx={{
                fontWeight: 700,
                color: "text.secondary",
                textAlign: "center",
                mb: 3,
                pb: 2,
              }}
            >
              CGL Details
            </Typography>
            <Grid container spacing={3}>
              {/* ROW 1 */}
              <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary" }}
                >
                  CGL Number
                </Typography>
                <Typography variant="h6" sx={{ fontWeight: 600 }}>
                  {selected.cglNumber}
                </Typography>
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 5 }}>
                <Box sx={{ width: "100%" }}>
                  <Typography
                    variant="subtitle2"
                    sx={{ fontWeight: 700, color: "text.secondary" }}
                  >
                    CGL Description
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 600 }}>
                    {selected.description}
                  </Typography>
                </Box>
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 3 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.5 }}
                >
                  Account Classification
                </Typography>
                {classification && (
                  <>
                    <CustomChip
                      label={classification.label}
                      icon={classification.icon}
                      variant="outlined"
                    />
                  </>
                )}
              </Grid>

              {/* ROW 2 */}
              <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Comp1
                </Typography>
                <Typography>{selected.comp1}</Typography>
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 5 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Segment
                </Typography>
                <Typography>
                  {selected.segmentCode}{" "}
                  {selected.segmentDescription
                    ? `- ${selected.segmentDescription}`
                    : ""}
                </Typography>
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Comp2
                </Typography>
                <Typography>{selected.comp2}</Typography>
              </Grid>

              {/* ROW 3 */}
              <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Balance Compare
                </Typography>
                <CustomChip
                  label={selected.balcompare === 1 ? "Include" : "Exclude"}
                  icon={
                    selected.balcompare === 1 ? (
                      <BookmarkAddedIcon />
                    ) : (
                      <BookmarkRemoveIcon />
                    )
                  }
                  color={"default"}
                  variant="outlined"
                />
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 5 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Manual Posting
                </Typography>
                <Typography></Typography>
                <CustomChip
                  label={
                    selected.manualPosting === 1 ? "Allowed" : "Not Allowed"
                  }
                  icon={
                    selected.manualPosting === 1 ? (
                      <GppGoodIcon />
                    ) : (
                      <GppBadIcon />
                    )
                  }
                  color={"default"}
                  variant="outlined"
                />
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 2 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Balance Forward
                </Typography>
                {/* <Typography>{selected.balFwd === 1 ? "Yes" : "No"}</Typography> */}
                <CustomChip
                  label={selected.balFwd === 1 ? "Yes" : "No"}
                  icon={
                    selected.balFwd === 1 ? <CheckCircleIcon /> : <CancelIcon />
                  }
                  color={"default"}
                  variant="outlined"
                />
              </Grid>

              {/* ROW 4 */}
              <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Open Date
                </Typography>
                <Typography>{selected.openDate || "NA"}</Typography>
              </Grid>

              <Grid size={{ xs: 12, sm: 6, md: 4 }}>
                <Typography
                  variant="subtitle2"
                  sx={{ fontWeight: 700, color: "text.secondary", mb: 0.4 }}
                >
                  Close Date
                </Typography>
                <Typography>{selected.closeDate || "NA"}</Typography>
              </Grid>
            </Grid>
          </Box>
        )}
      </Card>
    </Box>
  );
}
