import { useEffect, useState } from "react";
import {
  Box,
  Typography,
  Select,
  MenuItem,
  Stack,
  LinearProgress,
  Grow,
  Fade,
  LocalizationProvider,
  DatePicker,
} from "@mui/material";
import {
  Summarize,
  CloudDownloadTwoTone,
  LooksOne,
  LooksTwo,
  Looks3
} from "@mui/icons-material";

import dayjs from "dayjs";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { useSelector } from "react-redux";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import CustomChip from "../../utils/CustomChip";
import { useTheme } from "@mui/material/styles";

// Import styles
import {
  MainWrapper,
  StyledCard,
  HeaderWrapper,
  HeaderIconWrapper,
  HeaderTitle,
  SubText,
  InstructionText,
  InputSection,
  InputGroup,
  HalfWidthFormControl,
  SubmitSection,
  DownloadButton,
  ProgressContainer,
  StatusBox,
  StatusIconWrapper,
  ProgressStatusText,
  ProgressCaption,
} from "./GlifReports.styles";

export default function GlifReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);

  const [isLoading, setIsLoading] = useState(false);
  const [repTypes, setRepTypes] = useState([]);
  const [selectedReport, setReport] = useState(null);
  const [selectedDate, setDate] = useState(null);
  const [isDownloading, setIsDownloading] = useState(false);
  const [downloadedBytes, setDownloadedBytes] = useState(0);

  const theme = useTheme();
  const downloadedMB = downloadedBytes > 0 ? (downloadedBytes / (1024 * 1024)).toFixed(2) : null;

  const disableInputs = isLoading || isDownloading;
  const minDate = "2025-10-01";

  useEffect(() => {
    async function fetchData() {
      setIsLoading(true);
      try {
        const data = await callApi("RS/reports/types", { roleId: user.role }, "POST");
        setRepTypes(data.data || []);
      } catch (error) {
        console.error(error);
      }
      setIsLoading(false);
    }
    fetchData();
  }, []);

  const handleFetchReportData = async () => {};

  return (
    <Grow in timeout={500}>
      <Stack spacing={4}>
        <MainWrapper>
          <Stack alignItems="center">
            <StyledCard>
              <HeaderWrapper>
                <HeaderIconWrapper>
                  <Summarize sx={{ height: 60, width: 60 }} />
                </HeaderIconWrapper>

                <Box sx={{ flex: 1 }}>
                  <HeaderTitle variant="h5">GLIF Reports Generation</HeaderTitle>
                  <SubText variant="body2">
                    Choose a specific required report and date.
                  </SubText>
                </Box>
              </HeaderWrapper>

              <Box>
                <InstructionText variant="body2">
                  Note: Reports cannot be previewed and must be downloaded.
                </InstructionText>

                <Stack direction="row" spacing={2} sx={{ marginTop: 20 }}>
                  <CustomChip label="Step 1: Select report" icon={<LooksOne />} color="info" />
                  <CustomChip label="Step 2: Select date" icon={<LooksTwo />} color="info" />
                  <CustomChip label="Step 3: Download" icon={<Looks3 />} color="info" />
                </Stack>
              </Box>

              {/* ------- Inputs ------- */}
              <InputSection>
                <InputGroup>
                  <HalfWidthFormControl>
                    <Select
                      value={selectedReport}
                      onChange={(e) => setReport(e.target.value)}
                      disabled={disableInputs}
                    >
                      {repTypes.map((item) => (
                        <MenuItem key={item.fileName} value={item}>
                          {item.reportName}
                        </MenuItem>
                      ))}
                    </Select>
                  </HalfWidthFormControl>

                  <HalfWidthFormControl>
                    <LocalizationProvider dateAdapter={AdapterDayjs}>
                      <DatePicker
                        value={selectedDate}
                        maxDate={dayjs()}
                        minDate={dayjs(minDate)}
                        onChange={setDate}
                        disabled={disableInputs}
                      />
                    </LocalizationProvider>
                  </HalfWidthFormControl>
                </InputGroup>
              </InputSection>

              {/* ------- Submit Area ------- */}
              <SubmitSection>
                <DownloadButton variant="contained" endIcon={<CloudDownloadTwoTone />}>
                  {isDownloading ? "Downloading..." : "Fetch & Download"}
                </DownloadButton>

                {isDownloading && (
                  <Fade in>
                    <ProgressContainer>
                      <StatusBox>
                        <StatusIconWrapper>
                          <CloudDownloadTwoTone />
                        </StatusIconWrapper>

                        <Box>
                          <ProgressStatusText variant="body2">
                            Downloading {selectedReport?.reportName ?? "Report"}...
                          </ProgressStatusText>

                          <ProgressCaption variant="caption">
                            {downloadedMB
                              ? `${downloadedMB} MB received`
                              : "Starting download..."}
                          </ProgressCaption>
                        </Box>
                      </StatusBox>

                      <LinearProgress sx={{ height: 8, borderRadius: 50 }} />
                    </ProgressContainer>
                  </Fade>
                )}
              </SubmitSection>
            </StyledCard>
          </Stack>
        </MainWrapper>
      </Stack>
    </Grow>
  );
}