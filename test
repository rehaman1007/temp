import React from "react";
import { Typography, TextField, Button } from "@mui/material";
import { Lock } from "@mui/icons-material";
import { useState } from "react";
import axios from "axios";
import { parseJwt } from "../../../utils/EncryptionUtilities";
import { loginDialogMessages, loginDialogHeaders } from "./constants";
import { useNavigate } from "react-router-dom";

const LoginWithPassword = ({ userId, openLoginErrorDialog }) => {
  const [password, setPassword] = useState("");
  const [passwordInvalidMessage, setPasswordInvalidMessage] = useState("");
  const navigate = useNavigate();

  const validateUserCredentials = async () => {
    setPasswordInvalidMessage("");
    try {
      const respose = await axios.post("/LS/login", {
        userId: userId,
        password: password,
      });
      if (respose) {
        const result = respose.data.result;
        if (result.validCredentials === true) {
          navigate("/home");
          const user = parseJwt(result.accessToken);
          const tabId = crypto.randomUUID();

          sessionStorage.setItem("tabId", tabId);
          sessionStorage.setItem("token", result.accessToken);
          sessionStorage.setItem("user", JSON.stringify(user));
          const bc = new BroadcastChannel("auth");
          setTimeout(() => {
            bc.postMessage({
              type: "USER_LOGGED_IN",
              tabId,
              userId: user.userId,
            });
          }, 1000);
        } else {
          if (result.userStatus === "ACTIVE" && result.loginMethod === "P") {
            if (result.attemptsLeft > 0) {
              setPasswordInvalidMessage(
                `Invalid password you have ${result.attemptsLeft} attempts left.`
              );
            } else {
              openLoginErrorDialog(
                "Account locked",
                "You are out of attempts and your account has been locked"
              );
            }
          } else {
            openLoginErrorDialog(
              loginDialogHeaders[result.userStatus],
              loginDialogMessages[result.userStatus]
            );
          }
        }
      }
    } catch (e) {
      openLoginErrorDialog(
        "Login Failed",
        "Failed lo log into FinCore, please try again later"
      );
    }
  };

  return (
    <>
      <TextField
        fullWidth
        label="Password"
        type="password"
        placeholder="Enter your password"
        value={password}
        onChange={(e) => {
          setPassword(e.target.value);
        }}
        variant="outlined"
        error={passwordInvalidMessage !== ""}
        margin="normal"
        InputProps={{
          startAdornment: <Lock sx={{ mr: 1, opacity: 0.5 }} />,
          sx: {
            "& input:-webkit-autofill": {
              WebkitBoxShadow: "0 0 0 1000px rgba(255,255,255,0.05)",
              WebkitTextFillColor: "#fff",
              transition: "background-color 5000s ease-in-out 0s",
              caretColor: "#fff",
            },
          },
        }}
        InputLabelProps={{
          sx: {
            color: "#fff",
            "&.Mui-focused": {
              color: "#fff",
            },
          },
        }}
      />
      {passwordInvalidMessage && (
        <Typography color="error">{passwordInvalidMessage}</Typography>
      )}

      <Button
        fullWidth
        variant="contained"
        sx={{
          mt: 3,
          borderRadius: 2,
          background: "linear-gradient(to right,#0f172a,#1e3a8a,#1e293b)",
          color: "#fff",

          fontWeight: 600,
          transition: "all 0.3s",
          "&:hover": {
            transform: "scale(1.02)",
            boxShadow: "0 4px 20px rgba(0, 0, 0, 0.3)",
            background: "#fffff",
          },
        }}
        onClick={() => {
          validateUserCredentials();
        }}
      >
        Sign In
      </Button>
    </>
  );
};

export default LoginWithPassword;
