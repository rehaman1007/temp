import React, { useEffect, useState } from "react";
import {
  Box,
  Card,
  Stack,
  Typography,
  TextField,
  Button,
  Grow,
  CircularProgress,
  LinearProgress,
  Fade,
} from "@mui/material";
import { useTheme } from "@mui/material/styles";

import Autocomplete from "@mui/material/Autocomplete";
import { LocalizationProvider, DatePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { useSelector } from "react-redux";

import DescriptionIcon from "@mui/icons-material/Description";
import {
  CloudDownloadTwoTone,
  LooksOne,
  LooksTwo,
  Looks3,
  Looks4,
} from "@mui/icons-material";
import CustomChip from "../../utils/CustomChip";
import GlifReportsStyles from "./GlifReportsStyles"; 

const moduleType = "BRANCH_WISE";
const BRANCH_REGEX = /^[a-zA-Z0-9\s]*$/;
const INVALID_BRANCH_MSG = "Special characters are not allowed in branch search.";

// Helper to check if string contains only digits
const isNumeric = (str) => /^\d+$/.test(str);

export default function BranchWiseReports() {
  const user = useSelector((state) => state.auth.user);
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const theme = useTheme();
  const styles = GlifReportsStyles(theme);

  const [minDate, setMinDate] = useState(dayjs("2026-03-31"));

  /* ---------------- MASTER DATA ---------------- */
  const [branchList, setBranchList] = useState([]);
  const [reportList, setReportList] = useState([]);

  /* ---------------- SELECTED VALUES ---------------- */
  const [branch, setBranch] = useState(null);
  const [branchInput, setBranchInput] = useState("");
  const [selectedReport, setReport] = useState(null);
  const [selectedDate, setReportDate] = useState(null);

  const [isDownloading, setIsDownloading] = useState(false);
  const [branchLoading, setBranchLoading] = useState(false);
  const [branchOpen, setBranchOpen] = useState(false);

  const [dateError, setDateError] = useState(null);

  const [isLoading, setIsLoading] = useState(false);
  const [downloadedBytes, setDownloadedBytes] = useState(0);

  const downloadedMB =
    downloadedBytes > 0 ? (downloadedBytes / (1024 * 1024)).toFixed(2) : null;

  const disableInputs = isLoading || isDownloading;
  const isRoleB = user?.roleAccess === "B";

  /* ---------------- INITIAL LOAD & ROLE LOGIC ---------------- */
  useEffect(() => {
    if (isRoleB) {
      const assignedBranchCode = String(user?.branch ?? "").padStart(5, "0");
      const assignedBranchName = user?.branchName || "Unknown";
      const assignedBranch = {
        branchCode: assignedBranchCode,
        branchName: assignedBranchName,
      };
      
      setBranchList([assignedBranch]);
      setBranch(assignedBranch);
      setBranchInput(`${assignedBranchCode} - ${assignedBranchName}`);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [user]);

  /* ---------------- API CALLS ---------------- */
  const fetchBranches = async (term) => {
    try {
      setBranchLoading(true);

      let circleValue = "";
      switch (user?.roleAccess) {
        case "W":
          circleValue = "null";
          break;
        case "C":
        case "B":
          circleValue = user?.circleCode;
          break;
        default:
          circleValue = "";
      }

      const url = `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
        term
      )}&circleCode=${circleValue || ""}`;

      const res = await callApi(url, null, "GET");

      if (res?.data?.length > 0) {
        const mappedBranches = res.data.map((i) => ({
          branchCode: i.code,
          branchName: i.name,
        }));
        setBranchList(mappedBranches);
      } else {
        setBranchList([]);
      }
    } catch (e) {
      console.error(e);
      setBranchList([]);
    } finally {
      setBranchLoading(false);
    }
  };

  useEffect(() => {
    if (!branch?.branchCode) return;

    setReportList([]);
    setReport(null);
    setReportDate(null);
    fetchReports(branch);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [branch]);

  const fetchReports = async (branch) => {
    try {
      const payload = {
        moduleType: moduleType,
        branchCode: branch?.branchCode,
        roleId: user?.role,
      };

      const res = await callApi("/RS/reports/types", payload, "POST");
      const reports = res?.data || [];
      setReportList(reports);

      if (reports.length > 0 && reports[0].selectedDate) {
        setMinDate(dayjs(reports[0].selectedDate).startOf("day"));
      }
    } catch (error) {
      console.error(error);
      setReportList([]);
      showSnackBar("Unable to load reports. Please try again later.", "error");
    }
  };

  /* ---------------- DOWNLOAD LOGIC ---------------- */
  const handleFetchReportData = async () => {
    if (!selectedReport?.fileName || !selectedDate) return;

    if (dateError) {
      showSnackBar(getErrorMessage(dateError), "error");
      return;
    }

    setIsLoading(true);
    setIsDownloading(true);
    setDownloadedBytes(0);

    const payload = {
      moduleType: moduleType,
      fileName: selectedReport.fileName,
      branchCode: branch.branchCode,
      date: selectedDate.format("YYYY-MM-DD"),
      roleId: user.role,
    };

    try {
      const response = await callApi(
        "/RS/reports/download",
        payload,
        "POST",
        "blob",
        "application/json",
        {
          onDownloadProgress: (event) => {
            setIsDownloading(true);
            if (event && typeof event.loaded === "number") {
              setDownloadedBytes(event.loaded);
            }
          },
        },
        false
      );

      if (response.data && response.data.size > 22) {
        const contentDisposition =
          response.headers["content-disposition"] ||
          response.headers["Content-Disposition"];

        let filename = "report.zip";
        if (
          contentDisposition &&
          contentDisposition.indexOf("attachment") !== -1
        ) {
          const filenameMatch = contentDisposition.match(/filename="(.+?)"/);
          if (filenameMatch && filenameMatch.length > 1) {
            filename = filenameMatch[1];
          }
        }

        const downloadUrl = window.URL.createObjectURL(response.data);
        const a = document.createElement("a");
        a.href = downloadUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(downloadUrl);
        showSnackBar(`Reports "${filename}" downloaded successfully`, "success");
      } else {
        showSnackBar("No reports found", "warning");
      }
    } catch (error) {
      console.log("error", error);

      if (error && error instanceof Blob) {
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const errorJson = JSON.parse(reader.result);
            console.error(errorJson.message);
            showSnackBar(errorJson.message || "No reports found", "error");
          } catch (e) {
            console.error(e);
            showSnackBar("Something went wrong, kindly try again.", "error");
          }
        };
        reader.readAsText(error);
      } else {
        showSnackBar("Network Error: Could not connect to server", "error");
      }
    } finally {
      setIsLoading(false);
      setIsDownloading(false);
      setDownloadedBytes(0);
    }
  };

  const getErrorMessage = (error) => {
    const minDateStr = minDate?.isValid()
      ? minDate.format("DD/MM/YYYY")
      : "Allowed Min Date";

    switch (error) {
      case "maxDate":
        return "Date cannot be in the future (Today is max)";
      case "minDate":
        return `Date cannot be prior to ${minDateStr}`;
      case "invalidDate":
        return "Invalid date (Check day for this month)";
      default:
        return `Allowed Range: ${minDateStr} - Today`;
    }
  };

  /* ---------------- UI ---------------- */
  return (
    <Grow in timeout={500}>
      <Box sx={styles.rootBox} display="flex" justifyContent="center">
        <Stack spacing={4} sx={{ width: "100%", maxWidth: 1550 }}>
          <Card sx={styles.card}>
            {/* Header Section */}
            <Box sx={styles.headerContainer}>
              <Box sx={styles.headerIconWrapper}>
                <DescriptionIcon sx={styles.summaryIcon} />
              </Box>
              <Box sx={styles.headerTextBox}>
                <Typography variant="h5" fontWeight="bold" sx={styles.headerTitle}>
                  Branch Wise Reports Generation
                </Typography>
                <Typography variant="body2" sx={{ mt: 0.5, color: "rgba(255, 255, 255, 0.9)" }}>
                  Choose a specific required Branch, Report type and Date using the criteria below to download reports
                </Typography>
              </Box>
            </Box>

            {/* Note and Steps Section */}
            <Box sx={styles.noteContainer}>
              <Typography variant="body2" color="text.secondary" sx={{ fontStyle: "italic", mb: 1.5 }}>
                Note: The generated reports cannot be viewed on-screen it can only be downloaded.
              </Typography>
              <Stack
                direction="row"
                spacing={2}
                sx={{
                  ...styles.stepsStack,
                  flexWrap: "wrap",
                  gap: { xs: 1.5, sm: 2 },
                  "& > *": { margin: "0 !important", marginBottom: "8px !important" },
                }}
              >
                {isRoleB ? (
                  <>
                    <CustomChip label="Select a report" variant="outlined" icon={<LooksOne />} color="info" />
                    <CustomChip label="Select the report date" variant="outlined" icon={<LooksTwo />} color="info" />
                    <CustomChip label="Click Fetch & Download button" variant="outlined" icon={<Looks3 />} color="info" />
                  </>
                ) : (
                  <>
                    <CustomChip label="Select Branch" variant="outlined" icon={<LooksOne />} color="info" />
                    <CustomChip label="Select a report" variant="outlined" icon={<LooksTwo />} color="info" />
                    <CustomChip label="Select the report date" variant="outlined" icon={<Looks3 />} color="info" />
                    <CustomChip label="Click Fetch & Download button" variant="outlined" icon={<Looks4 />} color="info" />
                  </>
                )}
              </Stack>
            </Box>

            {/* 3 Inputs Section (Single Row on MD and larger, Stacked on smaller screens) */}
            <Box sx={styles.inputOuterBox}>
              <Box sx={{ ...styles.inputInnerBox, width: { xs: "100%", md: "95%", lg: "90%" } }}>
                
                {/* BRANCH SEARCH AUTOCOMPLETE */}
                <Autocomplete
                  sx={{ flex: 1, minWidth: { xs: "100%", md: 0 } }}
                  autoHighlight
                  disabled={isRoleB || branchLoading}
                  value={branch}
                  forcePopupIcon={false}
                  clearIcon={branchInput ? undefined : null}
                  options={Array.isArray(branchList) ? branchList : []}
                  noOptionsText={
                    branchInput.length < 3 ? "Please enter at least 3 characters" : "No Options"
                  }
                  inputValue={branchInput}
                  loading={branchInput.length >= 3 && branchLoading}
                  open={branchOpen}
                  onOpen={() => setBranchOpen(true)}
                  onClose={(e, reason) => {
                    if (reason === "blur") {
                      // If user clicks away without selecting, maintain the current input state
                      // Note: MUI Autocomplete automatically resets inputValue to match 'value' on blur 
                      // if freeSolo is false.
                      setBranchOpen(false);
                    } else {
                      setBranchOpen(false);
                    }
                  }}
                  onInputChange={(e, value, reason) => {
                    if (reason === "input" && !BRANCH_REGEX.test(value)) {
                      showSnackBar(INVALID_BRANCH_MSG, "warning");
                      return;
                    }

                    setBranchInput(value);

                    if (reason === "input") {
                      if (value.length >= 3) {
                        fetchBranches(value);
                      } else {
                        setBranchList([]);
                      }
                    } else if (reason === "clear") {
                      setBranchList([]);
                      setBranch(null);
                    }
                  }}
                  onChange={(e, v) => {
                    setBranch(v);
                    setBranchInput(v ? `${v.branchCode} - ${v.branchName}` : "");
                    setBranchOpen(false);
                  }}
                  getOptionLabel={(o) => o?.branchCode ? `${o.branchCode} - ${o.branchName}` : ""}
                  isOptionEqualToValue={(o, v) => o?.branchCode === v?.branchCode}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Branch Code or Name *"
                      fullWidth
                      InputLabelProps={{ shrink: true }}
                      placeholder="eg. 12345 or ABC"
                      InputProps={{
                        ...params.InputProps,
                        endAdornment: (
                          <>
                            {branchLoading ? <CircularProgress color="inherit" size={20} /> : null}
                            {params.InputProps.endAdornment}
                          </>
                        ),
                      }}
                      slotProps={{
                        htmlInput: {
                          ...params.inputProps,
                          maxLength: isNumeric(params.inputProps.value) ? 5 : 15,
                        },
                      }}
                    />
                  )}
                />

                <Autocomplete
                  sx={{ flex: 1, minWidth: { xs: "100%", md: 0 } }}
                  value={selectedReport}
                  options={reportList}
                  getOptionLabel={(o) => o?.reportName || ""}
                  isOptionEqualToValue={(o, v) => o.id === v.id}
                  onChange={(e, v) => setReport(v)}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      label="Select a report *"
                      InputProps={{
                        ...params.InputProps,
                      }}
                    />
                  )}
                />

                <LocalizationProvider dateAdapter={AdapterDayjs}>
                  <DatePicker
                    sx={{ flex: 1, minWidth: { xs: "100%", md: 0 } }}
                    label="Select report date *"
                    format="DD-MM-YYYY"
                    minDate={minDate}
                    maxDate={dayjs().endOf("day")}
                    value={selectedDate}
                    onChange={(v) => setReportDate(v)}
                    onError={(err) => setDateError(err)}
                    slotProps={{
                      textField: {
                        fullWidth: true,
                        error: !!dateError,
                        helperText: dateError ? getErrorMessage(dateError) : "",
                      },
                    }}
                  />
                </LocalizationProvider>
              </Box>
            </Box>

            {/* Fetch & Download Section */}
            <Box sx={styles.buttonContainer}>
              <Button
                sx={styles.downloadButton}
                endIcon={<CloudDownloadTwoTone />}
                variant="contained"
                onClick={handleFetchReportData}
                disabled={disableInputs || !selectedReport || !selectedDate || !!dateError}
              >
                {isDownloading ? "Downloading..." : "Fetch & Download"}
              </Button>

              <Fade in={isDownloading} unmountOnExit>
                <Box sx={styles.progressContainer}>
                  <Box sx={styles.progressHeader}>
                    <Box sx={styles.progressIconWrapper}>
                      <CloudDownloadTwoTone sx={styles.innerDownloadIcon} />
                    </Box>
                    <Box sx={styles.progressHeaderTextBox}>
                      <Typography variant="body2" fontWeight={600}>
                        Searching {selectedReport?.reportName ?? "the selected report"} for the period{" "}
                        {selectedDate?.isValid() ? selectedDate.format("YYYY-MM-DD") : "an unknown period"} is in progress.
                      </Typography>
                      <Typography variant="caption" color="text.secondary" sx={styles.progressCaption}>
                        {downloadedMB
                          ? `Streaming report data… ${downloadedMB} MB received`
                          : "Preparing your report stream…"}
                      </Typography>
                    </Box>

                    {downloadedMB && (
                      <CustomChip color="error" label={`${downloadedMB} MB downloaded`} variant="filled" />
                    )}
                  </Box>
                  <LinearProgress variant="indeterminate" sx={styles.progressBar} />
                </Box>
              </Fade>
            </Box>
          </Card>
        </Stack>
      </Box>
    </Grow>
  );
}
