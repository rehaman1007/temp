  const handleCurrencyChange = (val) => {
    // Safely check if "ALL" was clicked or if the array was cleared
    const currentCurrencies = Array.isArray(filters.currencies) ? filters.currencies : ["ALL"];
    const clickedAll = val.includes("ALL") && !currentCurrencies.includes("ALL");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("currencies", ["ALL"]);
      return;
    }

    const valWithoutAll = val.filter((v) => v !== "ALL");
    onFilterChange("currencies", valWithoutAll);
  };



                  <Grid size={{ xs: 12, sm: 5 }}>
                    <Autocomplete
                      multiple
                      size="small"
                      disableCloseOnSelect
                      options={["ALL", ...currencies]}
                      value={Array.isArray(filters.currencies) ? filters.currencies : ["ALL"]}
                      onChange={(_, val) => handleCurrencyChange(val)}
                      renderTags={(v) => (
                        <CustomChip
                          label={
                            v.includes("ALL")
                              ? "All Currencies"
                              : `${v.length} Selected`
                          }
                          color={v.includes("ALL") ? "default" : "primary"}
                          sx={{ mt: 1 }}
                        />
                      )}
                      renderOption={(props, option, { selected }) => (
                        <li {...props} key={option}>
                          <Checkbox
                            size="small"
                            style={{ marginRight: 8 }}
                            checked={selected}
                          />
                          <Typography variant="body2">
                            {option === "ALL" ? "All Currencies" : option}
                          </Typography>
                        </li>
                      )}
                      renderInput={(p) => (
                        <TextField
                          {...p}
                          label="Currencies"
                          required
                          variant="standard"
                          inputProps={{ ...p.inputProps, maxLength: 30 }}
                        />
                      )}
                    />
                  </Grid>
