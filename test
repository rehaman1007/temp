import {
  Dialog,
  DialogContent,
  Box,
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Button,
} from "@mui/material";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

/* -------------------------------------------------------
   STEP LABEL + CONTENT
------------------------------------------------------- */

const ProcessStepContent = ({ stage, active, onClick }) => {
  const notStarted =
    !stage.status || stage.status === StageStatus.NOT_STARTED;
  const started = stage.status === StageStatus.STARTED;
  const error = stage.status === StageStatus.ERROR;
  const completed = stage.status === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
    ? "Started"
    : error
    ? "Failed"
    : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                ? theme.palette.success.main
                : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">
          {stage.stage.title}
        </Typography>
      </StepLabel>

      <StepContent>
        {!notStarted && !active && (
          <Button
            size="small"
            variant="contained"
            onClick={onClick}
          >
            <VisibilityOutlinedIcon
              fontSize="small"
              sx={{ mr: 1 }}
            />
            View Details
          </Button>
        )}
      </StepContent>
    </>
  );
};

/* -------------------------------------------------------
   STEPPER (SCROLLABLE COLUMN)
------------------------------------------------------- */

const ProgressStepper = ({ stageDetails, activeStep, onStageClick }) => {
  return (
    <Stepper orientation="vertical" nonLinear>
      {stageDetails.map((stage, index) => (
        <Step key={index} active>
          <ProcessStepContent
            stage={stage}
            active={index === activeStep}
            onClick={() => onStageClick(index)}
          />
        </Step>
      ))}
    </Stepper>
  );
};

/* -------------------------------------------------------
   FULL HEIGHT DIALOG
------------------------------------------------------- */

const ProgressStepperDialog = ({
  open,
  stageDetails = [],
  activeStep = 0,
  onStageClick,
  onClose,
  children, // RIGHT SIDE STATIC CONTENT
}) => {
  return (
    <Dialog
      open={open}
      fullWidth
      maxWidth="lg"
      PaperProps={{
        sx: {
          height: "100vh",
          maxHeight: "100vh",
        },
      }}
      onClose={onClose}
    >
      <DialogContent
        sx={{
          height: "100%",
          p: 0,
          overflow: "hidden", // ❌ disable dialog scroll
        }}
      >
        <Box
          sx={{
            display: "flex",
            height: "100%",
          }}
        >
          {/* LEFT — SCROLLABLE STEPPER */}
          <Box
            sx={{
              width: 320,
              borderRight: 1,
              borderColor: "divider",
              overflowY: "auto", // ✅ ONLY THIS SCROLLS
              px: 2,
              py: 2,
            }}
          >
            <ProgressStepper
              stageDetails={stageDetails}
              activeStep={activeStep}
              onStageClick={onStageClick}
            />
          </Box>

          {/* RIGHT — STATIC STEP CONTENT */}
          <Box
            sx={{
              flex: 1,
              p: 3,
              overflow: "hidden", // ❌ NO SCROLL
            }}
          >
            {children}
          </Box>
        </Box>
      </DialogContent>
    </Dialog>
  );
};

export default ProgressStepperDialog;