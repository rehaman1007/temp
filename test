package com.fincore.transactions_service.controller;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import com.fincore.transactions_service.service.AdminSupportExecutor;
import com.fincore.transactions_service.service.AdminSupportService;

import jakarta.validation.Valid;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;

import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;

import java.util.Map;
import java.util.UUID;

@Slf4j
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/admin-support")
public class AdminSupportController {

    private final AdminSupportService adminSupportService;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * Execute query directly from command panel
     */
    @PostMapping("/admin-execute")
    public Map<String, Object> executeAdminSql(
            @RequestBody
            @Valid
            AdminSupportDTO adminSupportDTO
    ) {

        log.info("Admin SQL request received");

        return adminSupportService.executeAdminSql(
                adminSupportDTO
        );
    }

    /**
     * Upload huge SQL script
     */
    @PostMapping(
            value = "/upload-script",
            consumes = MediaType.MULTIPART_FORM_DATA_VALUE
    )
    public ResponseEntity<?> uploadScript(
            @RequestParam("file")
            MultipartFile file
    ) {

        try {

            if (file.isEmpty()) {

                return ResponseEntity.badRequest()
                        .body(
                                Map.of(
                                        "error",
                                        true,
                                        "message",
                                        "File is empty"
                                )
                        );
            }

            if (
                    !file.getOriginalFilename()
                            .toLowerCase()
                            .endsWith(".sql")
            ) {

                return ResponseEntity.badRequest()
                        .body(
                                Map.of(
                                        "error",
                                        true,
                                        "message",
                                        "Only .sql files allowed"
                                )
                        );
            }

            Path uploadDir =
                    Paths.get("sql-uploads");

            Files.createDirectories(uploadDir);

            String fileName =
                    UUID.randomUUID() + ".sql";

            Path uploadPath =
                    uploadDir.resolve(fileName);

            Files.copy(
                    file.getInputStream(),
                    uploadPath,
                    StandardCopyOption.REPLACE_EXISTING
            );

            String jobId =
                    UUID.randomUUID().toString();

            adminSupportExecutor.executeScriptAsync(
                    uploadPath,
                    jobId
            );

            return ResponseEntity.ok(
                    Map.of(
                            "error",
                            false,
                            "jobId",
                            jobId,
                            "message",
                            "SQL upload successful"
                    )
            );

        } catch (Exception e) {

            log.error(
                    "Upload failed",
                    e
            );

            return ResponseEntity.internalServerError()
                    .body(
                            Map.of(
                                    "error",
                                    true,
                                    "message",
                                    e.getMessage()
                            )
                    );
        }
    }

    /**
     * Track script execution
     */
    @GetMapping("/job-status/{jobId}")
    public ResponseEntity<?> getJobStatus(
            @PathVariable String jobId
    ) {

        return ResponseEntity.ok(
                adminSupportExecutor.getJobStatus(
                        jobId
                )
        );
    }
}



