import { useEffect, useState, useCallback, useRef } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ProcessStatusTable from "./components/ProcessStatusTable";
import ProcessDetailsDialog from "./components/ProcessDetailsDialog";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";

/* ======================================================
   NORMALIZE STAGE DETAILS (LATEST PER processStage)
====================================================== */
const normalizeStageDetails = (stageDetails = []) => {
  const stageMap = new Map();

  stageDetails.forEach((stage) => {
    const key = stage.processStage;
    const existing = stageMap.get(key);

    if (
      !existing ||
      stage.startTime > existing.startTime
    ) {
      stageMap.set(key, stage);
    }
  });

  return Array.from(stageMap.values())
    .sort((a, b) => a.processStage - b.processStage)
    .map((stage) => ({
      ...stage,

      /* RAW timestamps (logic) */
      _START_TIME_RAW: stage.startTime,
      _END_TIME_RAW: stage.endTime,

      /* DISPLAY timestamps */
      startTime: stage.startTime
        ? timeStampFormatter(stage.startTime)
        : null,
      endTime: stage.endTime
        ? timeStampFormatter(stage.endTime)
        : null,
    }));
};

/* ======================================================
   NORMALIZE PROCESS SHAPE (KEY FIX)
====================================================== */
const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType, // 🔥 critical fix
    stageDetails: normalizeStageDetails(p.stageDetails),
  }));

/* ======================================================
   DEEP MERGE PROCESSES + STAGES (SSE SAFE)
====================================================== */
const mergeProcesses = (prev = [], incoming = []) => {
  const processMap = new Map();

  /* Seed existing processes */
  prev.forEach((p) => {
    processMap.set(p.type, {
      ...p,
      stageDetails: [...p.stageDetails],
    });
  });

  /* Merge incoming updates */
  incoming.forEach((p) => {
    const existing = processMap.get(p.type);

    if (!existing) {
      processMap.set(p.type, p);
      return;
    }

    const stageMap = new Map(
      existing.stageDetails.map((s) => [s.processStage, s])
    );

    p.stageDetails.forEach((stage) => {
      const old = stageMap.get(stage.processStage);

      if (
        !old ||
        stage._START_TIME_RAW > old._START_TIME_RAW
      ) {
        stageMap.set(stage.processStage, stage);
      }
    });

    existing.stageDetails = Array.from(stageMap.values()).sort(
      (a, b) => a.processStage - b.processStage
    );
  });

  return Array.from(processMap.values());
};

const ProcessStatusPage = () => {
  const [processes, setProcesses] = useState([]);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [loading, setLoading] = useState(true);

  const snackbar = useCustomSnackbar();
  const token = useSelector((state) => state.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const INITIAL_URL = "/PS/process/processes/data";
  const STREAM_URL = `${service}/process/processes-testing`;

  /* ======================================================
     INITIAL LOAD (STRICTMODE SAFE)
  ====================================================== */
  const initialFetchDone = useRef(false);

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    let mounted = true;

    callApi(INITIAL_URL, null)
      .then((data) => {
        if (mounted && Array.isArray(data)) {
          setProcesses(normalizeProcesses(data));
        }
      })
      .catch(() => snackbar("Failed to load processes"))
      .finally(() => mounted && setLoading(false));

    return () => {
      mounted = false;
    };
  }, []);

  /* ======================================================
     SSE STREAM (REALTIME MERGE)
  ====================================================== */
  useEffect(() => {
    if (loading) return;

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },

      onopen(res) {
        if (!res.ok) {
          throw new Error("SSE connection failed");
        }
      },

      onmessage(event) {
        if (event.event === "connected") return;

        try {
          const raw = JSON.parse(event.data);
          if (!Array.isArray(raw)) return;

          const normalized = normalizeProcesses(raw);

          setProcesses((prev) =>
            mergeProcesses(prev, normalized)
          );
        } catch (e) {
          console.error("SSE parse error", e);
        }
      },

      retryDelay: (attempt) => Math.min(1000 * 2 ** attempt, 15000),
    });

    return () => controller.abort();
  }, [loading, STREAM_URL, token]);

  /* ======================================================
     RENDER
  ====================================================== */
  return (
    <>
      <ProcessDetailsDialog
        process={selectedProcess}
        onClose={() => setSelectedProcess(null)}
      />

      <ProcessStatusTable
        loading={loading}
        processes={processes}
        actions={{
          onView: setSelectedProcess,
          onStop: () => {},
          onRestart: () => {},
        }}
      />
    </>
  );
};

export default ProcessStatusPage;