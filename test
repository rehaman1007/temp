package com.fincore.transactions_service.service;

import com.fincore.transactions_service.dto.AdminSupportDTO;
import jakarta.servlet.http.HttpServletRequest;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.time.Duration;
import java.time.Instant;
import java.util.*;

@Service
@RequiredArgsConstructor
@Slf4j
public class AdminSupportServiceImpl implements AdminSupportService {

    private final JdbcTemplate jdbcTemplate;

    private final AdminSupportExecutor adminSupportExecutor;

    /**
     * =====================================================
     * EXECUTE ADMIN SQL
     * =====================================================
     */
    @Override
    public Map<String, Object> executeAdminSql(
            AdminSupportDTO dto,
            String userId,
            HttpServletRequest request
    ) {

        Instant start = Instant.now();

        Map<String, Object> response =
                new HashMap<>();

        String clientIp =
                getClientIp(request);

        String sql =
                dto.getSql();

        int page =
                dto.getPage();

        int size =
                dto.getSize();

        String normalizedSql =
                sql == null
                        ? ""
                        : sql.trim();

        String upperSql =
                normalizedSql.toUpperCase();

        try {

            log.info("""

                    =====================================================
                    ADMIN SQL EXECUTION STARTED
                    =====================================================
                    userId={}
                    clientIp={}
                    page={}
                    size={}
                    sql={}
                    =====================================================
                    """,
                    userId,
                    clientIp,
                    page,
                    size,
                    normalizedSql
            );

            /**
             * =====================================================
             * SELECT / WITH
             * =====================================================
             */
            if (
                    upperSql.startsWith("SELECT")
                            || upperSql.startsWith("WITH")
            ) {

                int offset =
                        page * size;

                String paginatedSql =
                        """
                        SELECT * FROM
                        (
                            SELECT A.*, ROWNUM RN
                            FROM
                            (
                        """
                                + normalizedSql
                                +
                                """
                            ) A
                            WHERE ROWNUM <= ?
                        )
                        WHERE RN > ?
                        """;

                List<Map<String, Object>> rows =
                        jdbcTemplate.queryForList(
                                paginatedSql,
                                offset + size,
                                offset
                        );

                String countSql =
                        """
                        SELECT COUNT(*) FROM
                        (
                        """
                                + normalizedSql +
                                """
                        )
                        """;

                Integer total =
                        jdbcTemplate.queryForObject(
                                countSql,
                                Integer.class
                        );

                List<Map<String, Object>> columns =
                        new ArrayList<>();

                if (!rows.isEmpty()) {

                    rows.get(0)
                            .keySet()
                            .forEach(key -> {

                                Map<String, Object> column =
                                        new HashMap<>();

                                column.put("name", key);

                                columns.add(column);
                            });
                }

                long executionTime =
                        Duration.between(
                                start,
                                Instant.now()
                        ).toMillis();

                response.put("error", false);
                response.put("rows", rows);
                response.put("columns", columns);
                response.put("total", total);

                /**
                 * LOG INSERT
                 */
                insertExecutionLog(
                        UUID.randomUUID().toString(),
                        userId,
                        clientIp,
                        null,
                        "SELECT",
                        "COMPLETED",
                        1,
                        1,
                        0,
                        0,
                        0,
                        1,
                        null,
                        null,
                        null,
                        executionTime,
                        executionTime / 1000,
                        normalizedSql
                );

                log.info("""

                        SELECT EXECUTED
                        | rows={}
                        | total={}
                        | executionTime={} ms
                        """,
                        rows.size(),
                        total,
                        executionTime
                );

                return response;
            }

            /**
             * =====================================================
             * DML / DDL
             * =====================================================
             */
            int affectedRows =
                    jdbcTemplate.update(
                            normalizedSql
                    );

            long executionTime =
                    Duration.between(
                            start,
                            Instant.now()
                    ).toMillis();

            int insertCount = 0;
            int updateCount = 0;
            int deleteCount = 0;
            int otherCount = 0;

            if (upperSql.startsWith("INSERT")) {

                insertCount = affectedRows;

            } else if (upperSql.startsWith("UPDATE")) {

                updateCount = affectedRows;

            } else if (upperSql.startsWith("DELETE")) {

                deleteCount = affectedRows;

            } else {

                otherCount = affectedRows;
            }

            response.put("error", false);
            response.put("message", "Execution completed");
            response.put("affectedRows", affectedRows);

            /**
             * LOG INSERT
             */
            insertExecutionLog(
                    UUID.randomUUID().toString(),
                    userId,
                    clientIp,
                    null,
                    "MANUAL_SQL",
                    "COMPLETED",
                    1,
                    1,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    null,
                    null,
                    null,
                    executionTime,
                    executionTime / 1000,
                    normalizedSql
            );

            log.info("""

                    SQL EXECUTED SUCCESSFULLY
                    | affectedRows={}
                    | insertCount={}
                    | updateCount={}
                    | deleteCount={}
                    | otherCount={}
                    | executionTime={} ms
                    """,
                    affectedRows,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    executionTime
            );

            return response;

        } catch (Exception e) {

            long executionTime =
                    Duration.between(
                            start,
                            Instant.now()
                    ).toMillis();

            log.error("""

                    =====================================================
                    ADMIN SQL EXECUTION FAILED
                    =====================================================
                    userId={}
                    clientIp={}
                    sql={}
                    =====================================================
                    """,
                    userId,
                    clientIp,
                    normalizedSql,
                    e
            );

            insertExecutionLog(
                    UUID.randomUUID().toString(),
                    userId,
                    clientIp,
                    null,
                    "FAILED_SQL",
                    "FAILED",
                    1,
                    0,
                    0,
                    0,
                    0,
                    0,
                    1,
                    normalizedSql,
                    e.getClass().getSimpleName(),
                    e.getMessage(),
                    executionTime,
                    executionTime / 1000,
                    normalizedSql
            );

            response.put("error", true);
            response.put("message", e.getMessage());

            return response;
        }
    }

    /**
     * =====================================================
     * UPLOAD SQL FILE
     * =====================================================
     */
    @Override
    public Map<String, Object> uploadSqlFile(
            MultipartFile file,
            String userId,
            HttpServletRequest request
    ) {

        try {

            String jobId =
                    UUID.randomUUID().toString();

            String clientIp =
                    getClientIp(request);

            log.info("""

                    =====================================================
                    SQL FILE RECEIVED
                    =====================================================
                    jobId={}
                    fileName={}
                    fileSize={} MB
                    userId={}
                    clientIp={}
                    =====================================================
                    """,
                    jobId,
                    file.getOriginalFilename(),
                    String.format(
                            "%.2f",
                            file.getSize() / 1024.0 / 1024.0
                    ),
                    userId,
                    clientIp
            );

            /**
             * IMPORTANT
             * COPY FILE INTO MEMORY
             */
            byte[] fileBytes =
                    file.getBytes();

            /**
             * EXECUTE ASYNC
             */
            adminSupportExecutor.executeScriptAsync(
                    fileBytes,
                    file.getOriginalFilename(),
                    jobId,
                    userId,
                    clientIp
            );

            Map<String, Object> response =
                    new HashMap<>();

            response.put("error", false);
            response.put("jobId", jobId);
            response.put(
                    "message",
                    "SQL execution started"
            );

            return response;

        } catch (Exception e) {

            log.error(
                    "UPLOAD FAILED",
                    e
            );

            Map<String, Object> response =
                    new HashMap<>();

            response.put("error", true);
            response.put(
                    "message",
                    e.getMessage()
            );

            return response;
        }
    }

    /**
     * =====================================================
     * GET JOB STATUS
     * =====================================================
     */
    @Override
    public Map<String, Object> getJobStatus(
            String jobId
    ) {

        return AdminSupportExecutor.JOB_STATUS_MAP
                .getOrDefault(
                        jobId,
                        Map.of(
                                "status",
                                "NOT_FOUND"
                        )
                );
    }

    /**
     * =====================================================
     * INSERT EXECUTION LOG
     * =====================================================
     */
    private void insertExecutionLog(
            String jobId,
            String userId,
            String clientIp,
            String fileName,
            String executionType,
            String status,
            int totalStatements,
            int executedCount,
            int insertCount,
            int updateCount,
            int deleteCount,
            int otherCount,
            Integer failedStatementNumber,
            String failedSql,
            String exceptionType,
            String exceptionMessage,
            long executionSpeed,
            long elapsedSeconds,
            String sqlText
    ) {

        try {

            jdbcTemplate.update(
                    """
                    INSERT INTO ADMIN_SUPPORT_LOG
                    (
                        ID,
                        JOB_ID,
                        USER_ID,
                        CLIENT_IP,
                        FILE_NAME,
                        EXECUTION_TYPE,
                        STATUS,
                        TOTAL_STATEMENTS,
                        EXECUTED_COUNT,
                        INSERT_COUNT,
                        UPDATE_COUNT,
                        DELETE_COUNT,
                        OTHER_COUNT,
                        FAILED_STATEMENT_NUMBER,
                        FAILED_SQL,
                        EXCEPTION_TYPE,
                        EXCEPTION_MESSAGE,
                        EXECUTION_SPEED,
                        ELAPSED_SECONDS,
                        STARTED_AT,
                        COMPLETED_AT,
                        SQL_TEXT,
                        CREATED_AT
                    )
                    VALUES
                    (
                        ADMIN_SUPPORT_LOG_SEQ.NEXTVAL,
                        ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
                        ?, ?, ?, ?, ?, ?,
                        SYSTIMESTAMP,
                        SYSTIMESTAMP,
                        ?,
                        SYSTIMESTAMP
                    )
                    """,
                    jobId,
                    userId,
                    clientIp,
                    fileName,
                    executionType,
                    status,
                    totalStatements,
                    executedCount,
                    insertCount,
                    updateCount,
                    deleteCount,
                    otherCount,
                    failedStatementNumber,
                    failedSql,
                    exceptionType,
                    exceptionMessage,
                    executionSpeed,
                    elapsedSeconds,
                    sqlText
            );

        } catch (Exception e) {

            log.error(
                    "FAILED TO INSERT LOG",
                    e
            );
        }
    }

    /**
     * =====================================================
     * GET CLIENT IP
     * =====================================================
     */
    private String getClientIp(
            HttpServletRequest request
    ) {

        try {

            String xfHeader =
                    request.getHeader(
                            "X-Forwarded-For"
                    );

            if (
                    xfHeader == null
                            || xfHeader.isBlank()
            ) {

                return request.getRemoteAddr();
            }

            return xfHeader.split(",")[0];

        } catch (Exception e) {

            return "UNKNOWN";
        }
    }
}