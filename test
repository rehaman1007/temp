import React, { useState } from "react";
import {
  Box,
  Grid,
  Typography,
  ToggleButtonGroup,
  ToggleButton,
  Stack
} from "@mui/material";
import {
  PieChart,
  Pie,
  Cell,
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ResponsiveContainer
} from "recharts";

const COLORS = [
  "#1976d2", // primary
  "#9c27b0", // secondary
  "#2e7d32", // success
  "#ed6c02", // warning
  "#d32f2f", // error
  "#0288d1"  // info
];

export default function CombinedCharts({ requestData }) {
  const total = requestData.length;

  // 1️⃣ Status counts
  const statusCounts = [
    { name: "Pending", value: requestData.filter(r => r.reqStatus === "PENDING").length },
    { name: "Approved", value: requestData.filter(r => r.reqStatus === "ACCEPT").length },
    { name: "Rejected", value: requestData.filter(r => r.reqStatus === "REJECT").length }
  ];

  // 2️⃣ Type counts
  const typeCounts = [
    { name: "Add", value: requestData.filter(r => r.changeType === "ADD").length },
    { name: "Modify", value: requestData.filter(r => r.changeType === "MODIFY").length },
    { name: "Delete", value: requestData.filter(r => r.changeType === "DELETE").length }
  ];

  // Merge status + type data into one donut dataset
  const mergedData = [...statusCounts, ...typeCounts];

  // 3️⃣ Trend data (group by date)
  const trendData = requestData.reduce((acc, curr) => {
    const date = curr.reqDate.split("T")[0];
    const existing = acc.find(item => item.date === date);
    if (existing) existing.requests++;
    else acc.push({ date, requests: 1 });
    return acc;
  }, []);

  // Period filter
  const [period, setPeriod] = useState("daily");
  const handlePeriodChange = (_, newPeriod) => {
    if (newPeriod) setPeriod(newPeriod);
  };

  return (
    <Box sx={{ p: 2 }}>
      <Grid container spacing={3}>
        {/* Donut Chart */}
        <Grid item xs={12} md={6} sx={{ display: "flex", justifyContent: "center", position: "relative" }}>
          <PieChart width={300} height={300}>
            <Pie
              data={mergedData}
              dataKey="value"
              nameKey="name"
              innerRadius={80}
              outerRadius={120}
              startAngle={90}
              endAngle={-270}
              paddingAngle={2}
            >
              {mergedData.map((_, index) => (
                <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
              ))}
            </Pie>
          </PieChart>

          {/* Center text */}
          <Box
            sx={{
              position: "absolute",
              top: "50%",
              left: "50%",
              transform: "translate(-50%, -50%)",
              textAlign: "center"
            }}
          >
            <Typography variant="h5" fontWeight="bold">{total}</Typography>
            <Typography variant="body2" color="textSecondary">Requests</Typography>
          </Box>

          {/* Legend on the right */}
          <Stack spacing={1} sx={{ ml: 3 }}>
            {mergedData.map((entry, index) => (
              <Box key={index} sx={{ display: "flex", alignItems: "center" }}>
                <Box
                  sx={{
                    width: 14,
                    height: 14,
                    backgroundColor: COLORS[index % COLORS.length],
                    mr: 1
                  }}
                />
                <Typography variant="body2">
                  {entry.name}: {entry.value}
                </Typography>
              </Box>
            ))}
          </Stack>
        </Grid>

        {/* Trend Chart */}
        <Grid item xs={12} md={6}>
          <ToggleButtonGroup
            value={period}
            exclusive
            onChange={handlePeriodChange}
            size="small"
            sx={{ mb: 2 }}
          >
            <ToggleButton value="daily">Daily</ToggleButton>
            <ToggleButton value="weekly">Weekly</ToggleButton>
            <ToggleButton value="monthly">Monthly</ToggleButton>
            <ToggleButton value="quarterly">Quarterly</ToggleButton>
            <ToggleButton value="yearly">Yearly</ToggleButton>
          </ToggleButtonGroup>

          <ResponsiveContainer width="100%" height={250}>
            <LineChart data={trendData}>
              <CartesianGrid strokeDasharray="3 3" />
              <XAxis dataKey="date" />
              <YAxis />
              <Tooltip />
              <Line type="monotone" dataKey="requests" stroke="#0288d1" strokeWidth={2} />
            </LineChart>
          </ResponsiveContainer>
        </Grid>
      </Grid>
    </Box>
  );
}