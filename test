@PostMapping("/export-insert")
public ResponseEntity<Resource> exportInsertStatements(
        @RequestHeader("Authorization") String token,
        @RequestBody AdminSupportDTO dto,
        HttpServletRequest request) {

    String userId = extractUserId(token);

    return adminSupportService.exportInsertStatements(
            dto,
            userId,
            request
    );
}


ResponseEntity<Resource> exportInsertStatements(
        AdminSupportDTO dto,
        String userId,
        HttpServletRequest request
);


@Override
public ResponseEntity<Resource> exportInsertStatements(
        AdminSupportDTO dto,
        String userId,
        HttpServletRequest request) {

    String sql = dto.getSql().trim();

    if (!sql.toUpperCase().startsWith("SELECT")) {
        throw new RuntimeException(
                "Only SELECT queries can be exported"
        );
    }

    List<Map<String,Object>> rows =
            jdbcTemplate.queryForList(sql);

    StringBuilder builder = new StringBuilder();

    for(Map<String,Object> row : rows){

        builder.append(
                adminSupportExecutor
                        .buildInsertStatement(row)
        ).append("\n");
    }

    byte[] bytes =
            builder.toString().getBytes(StandardCharsets.UTF_8);

    ByteArrayResource resource =
            new ByteArrayResource(bytes);

    return ResponseEntity.ok()
            .header(
                    HttpHeaders.CONTENT_DISPOSITION,
                    "attachment; filename=export.sql"
            )
            .contentType(MediaType.TEXT_PLAIN)
            .contentLength(bytes.length)
            .body(resource);
}


public String buildInsertStatement(
        String tableName,
        ResultSet rs
) throws Exception {

    ResultSetMetaData meta =
            rs.getMetaData();

    StringBuilder cols =
            new StringBuilder();

    StringBuilder vals =
            new StringBuilder();

    int count = meta.getColumnCount();

    for(int i=1;i<=count;i++){

        String col =
                meta.getColumnName(i);

        Object value =
                rs.getObject(i);

        cols.append(col);

        if(value == null){
            vals.append("NULL");
        }
        else if(value instanceof Number){
            vals.append(value);
        }
        else{
            vals.append("'")
                .append(
                   value.toString()
                        .replace("'","''")
                )
                .append("'");
        }

        if(i < count){
            cols.append(",");
            vals.append(",");
        }
    }

    return "INSERT INTO "
            + tableName
            + " ("
            + cols
            + ") VALUES ("
            + vals
            + ");";
}