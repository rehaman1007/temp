import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  IconButton,
  Box,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import StopIcon from "@mui/icons-material/Stop";
import { useEffect, useState, useMemo } from "react";
import ProgressStepper from "./ProgressStepper";
import StageDetails from "./StageDetails";
import { StageStatus } from "../util/StageStatus";

const resolveInitialActiveStep = (stages = []) => {
  if (!stages.length) return 0;

  const started = stages.findIndex(s => s.status === StageStatus.STARTED);
  if (started !== -1) return started;

  const error = stages.findIndex(s => s.status === StageStatus.ERROR);
  if (error !== -1) return error;

  const completed = stages
    .map((s, i) => (s.status === StageStatus.COMPLETED ? i : -1))
    .filter(i => i !== -1);

  return completed.length ? completed.at(-1) : 0;
};

const ProcessDetailsDialog = ({ process, onClose }) => {
  const stages = useMemo(() => process?.stageDetails || [], [process]);
  const [activeStep, setActiveStep] = useState(0);

  useEffect(() => {
    if (stages.length) {
      setActiveStep(resolveInitialActiveStep(stages));
    }
  }, [stages]);

  if (!process) return null;

  const lastStatus = stages.at(-1)?.status;

  return (
    <Dialog open fullWidth maxWidth="md" onClose={onClose}>
      <DialogTitle>
        {process.type} – Process Details
        <IconButton
          onClick={onClose}
          sx={{ position: "absolute", right: 12, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent dividers>
        {/* ONE unified container */}
        <Box
          sx={theme => ({
            display: "flex",
            height: 420,
            border: `1px solid ${theme.palette.divider}`,
            borderRadius: 2,
            overflow: "hidden",
          })}
        >
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
          />

          <StageDetails
            stages={stages}
            activeStep={activeStep}
          />
        </Box>
      </DialogContent>

      <DialogActions>
        <Button
          startIcon={<StopIcon />}
          disabled={lastStatus !== StageStatus.STARTED}
        >
          Stop
        </Button>
        <Button
          startIcon={<RestartAltIcon />}
          disabled={lastStatus !== StageStatus.ERROR}
        >
          Restart
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default ProcessDetailsDialog;

import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  IconButton,
} from "@mui/material";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";

const ProcessStepContent = ({ stage, active, onClick }) => {
  const statusText =
    stage.status === StageStatus.STARTED
      ? "Started"
      : stage.status === StageStatus.ERROR
      ? "Failed"
      : stage.status === StageStatus.COMPLETED
      ? "Completed"
      : "Not Started";

  return (
    <>
      <StepLabel
        icon={
          <Box
            component={getIconComponent(stage.stage.icon)}
            sx={theme => ({
              color:
                stage.status === StageStatus.ERROR
                  ? theme.palette.error.main
                  : stage.status === StageStatus.COMPLETED
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
        optional={
          <Typography variant="caption" color="text.secondary">
            {statusText}
          </Typography>
        }
      >
        <Typography fontWeight={active ? 600 : 400}>
          {stage.stage.title}
        </Typography>
      </StepLabel>

      <StepContent>
        {!active && (
          <IconButton size="small" onClick={onClick}>
            <VisibilityOutlinedIcon fontSize="small" />
          </IconButton>
        )}
      </StepContent>
    </>
  );
};

const ProgressStepper = ({ stageDetails, activeStep, onStageClick }) => {
  return (
    <Box
      sx={theme => ({
        width: 280,
        bgcolor: theme.palette.background.paper,
        borderRight: `1px solid ${theme.palette.divider}`,
        overflowY: "auto",
      })}
    >
      <Stepper orientation="vertical" nonLinear>
        {stageDetails.map((stage, index) => (
          <Step key={index} active={index === activeStep}>
            <ProcessStepContent
              stage={stage}
              active={index === activeStep}
              onClick={() => onStageClick(index)}
            />
          </Step>
        ))}
      </Stepper>
    </Box>
  );
};

export default ProgressStepper;

import {
  Stack,
  Grid,
  Typography,
  Box,
  Divider,
} from "@mui/material";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import PlayCircleOutlineIcon from "@mui/icons-material/PlayCircleOutline";
import StopCircleOutlinedIcon from "@mui/icons-material/StopCircleOutlined";
import PersonOutlineIcon from "@mui/icons-material/PersonOutline";
import TimerOutlinedIcon from "@mui/icons-material/TimerOutlined";
import NotesOutlinedIcon from "@mui/icons-material/NotesOutlined";
import { toPascalKebabCase } from "../../../utils/CommonUtilities";

const formatDuration = (start, end) => {
  if (!start || !end) return null;
  const diff = end - start;
  const s = Math.floor(diff / 1000) % 60;
  const m = Math.floor(diff / 60000) % 60;
  const h = Math.floor(diff / 3600000);
  return [h && `${h} hr`, m && `${m} min`, s && `${s} sec`]
    .filter(Boolean)
    .join(" ");
};

const InfoItem = ({ icon, label, value }) => (
  <Stack direction="row" spacing={1.5}>
    <Box color="text.secondary">{icon}</Box>
    <Stack>
      <Typography variant="caption">{label}</Typography>
      <Typography fontWeight={500}>{value || "—"}</Typography>
    </Stack>
  </Stack>
);

const StageDetails = ({ stages, activeStep }) => {
  const stage = stages[activeStep];
  if (!stage) return null;

  return (
    <Stack flex={1} p={3} spacing={3} bgcolor="action.hover">
      <Stack direction="row" spacing={2} alignItems="center">
        <Box
          sx={{
            p: 1.5,
            borderRadius: "50%",
            bgcolor: "primary.main",
            color: "primary.contrastText",
          }}
        >
          <AccessTimeIcon />
        </Box>
        <Stack>
          <Typography variant="caption">Stage</Typography>
          <Typography variant="h6">{stage.stage.title}</Typography>
        </Stack>
      </Stack>

      <Divider />

      <Grid container spacing={2}>
        <Grid xs={12} md={6}>
          <InfoItem icon={<PlayCircleOutlineIcon />} label="Start Time" value={stage.startTime} />
        </Grid>
        <Grid xs={12} md={6}>
          <InfoItem icon={<StopCircleOutlinedIcon />} label="End Time" value={stage.endTime} />
        </Grid>
        <Grid xs={12} md={6}>
          <InfoItem icon={<PersonOutlineIcon />} label="Triggered By" value={toPascalKebabCase(stage.triggeredBy)} />
        </Grid>
        <Grid xs={12} md={6}>
          <InfoItem
            icon={<TimerOutlinedIcon />}
            label="Time Taken"
            value={formatDuration(stage._START_TIME_RAW, stage._END_TIME_RAW)}
          />
        </Grid>
      </Grid>

      {stage.remarks && (
        <Stack spacing={1}>
          <Stack direction="row" spacing={1}>
            <NotesOutlinedIcon fontSize="small" />
            <Typography variant="subtitle2">Remarks</Typography>
          </Stack>
          <Typography>{stage.remarks}</Typography>
        </Stack>
      )}
    </Stack>
  );
};

export default StageDetails;