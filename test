import dayjs from "dayjs";

/**
 * Generates available date filter options based on a base date and minimum allowed date.
 */
export const getAvailableFilters = (baseDate, minLimit) => {
  const isValid = (calcDate) => !calcDate.isBefore(minLimit, "day");

  return [
    { value: "custom", label: "Custom Range", show: true },
    { value: "currentDay", label: "Current Day", show: isValid(baseDate) },
    {
      value: "previousDay",
      label: "Previous Day",
      show: isValid(baseDate.subtract(1, "day")),
    },
    {
      value: "currentWeek",
      label: "Current Week",
      show: isValid(baseDate.startOf("week")),
    },
    {
      value: "previousWeek",
      label: "Previous Week",
      show: isValid(baseDate.subtract(1, "week").startOf("week")),
    },
    {
      value: "currentMonth",
      label: "Current Month",
      show: isValid(baseDate.startOf("month")),
    },
    {
      value: "previousMonth",
      label: "Previous Month",
      show: isValid(baseDate.subtract(1, "month").startOf("month")),
    },
    {
      value: "last3Months",
      label: "Last 3 Months",
      show: isValid(baseDate.subtract(3, "month")),
    },
    {
      value: "last6Months",
      label: "Last 6 Months",
      show: isValid(baseDate.subtract(6, "month")),
    },
    {
      value: "currentYear",
      label: "Current Year",
      show: isValid(baseDate.startOf("year")),
    },
    {
      value: "previousYear",
      label: "Previous Year",
      show: isValid(baseDate.subtract(1, "year").startOf("year")),
    },
    // Added All Time option here. It is always shown because it represents the max possible range.
    {
      value: "allTime",
      label: "All Time",
      show: true,
    },
  ].filter((option) => option.show);
};

/**
 * Calculates start and end dates based on the selected quick filter option.
 */
export const calculateQuickFilterDates = (option, baseDate, minLimit) => {
  let newStart = baseDate;
  let newEnd = baseDate;

  switch (option) {
    case "allTime": // Sets the range from your absolute minimum date to the current base date
      newStart = minLimit;
      newEnd = baseDate;
      break;
    case "currentDay":
      break;
    case "previousDay":
      newStart = baseDate.subtract(1, "day");
      newEnd = baseDate.subtract(1, "day");
      break;
    case "currentWeek":
      newStart = baseDate.startOf("week");
      break;
    case "previousWeek":
      newStart = baseDate.subtract(1, "week").startOf("week");
      newEnd = baseDate.subtract(1, "week").endOf("week");
      break;
    case "currentMonth":
      newStart = baseDate.startOf("month");
      break;
    case "previousMonth":
      newStart = baseDate.subtract(1, "month").startOf("month");
      newEnd = baseDate.subtract(1, "month").endOf("month");
      break;
    case "last3Months":
      newStart = baseDate.subtract(3, "month");
      break;
    case "last6Months":
      newStart = baseDate.subtract(6, "month");
      break;
    case "currentYear":
      newStart = baseDate.startOf("year");
      break;
    case "previousYear":
      newStart = baseDate.subtract(1, "year").startOf("year");
      newEnd = baseDate.subtract(1, "year").endOf("year");
      break;
    default:
      break;
  }

  // Force strict bounds before returning
  if (newStart.isBefore(minLimit)) newStart = minLimit;
  if (newEnd.isBefore(minLimit)) newEnd = minLimit;
  if (newEnd.isAfter(baseDate)) newEnd = baseDate;

  return { newStart, newEnd };
};
