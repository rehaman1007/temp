				  AND (:maxAmount IS NULL OR GREATEST(NVL(DEBIT_AMOUNT,0), NVL(CREDIT_AMOUNT,0)) <= :maxAmount)
				  AND (:applySourceFlag = 0  OR SOURCE_FLAG IN (:sourceFlag))
