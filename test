const handleCircleChange = (value) => {

  /*
   * RESET BRANCHES
   */
  onFilterChange("branches", ["ALL"]);

  /*
   * RESET BRANCH TRAY
   */
  setViewBranchList(false);

  /*
   * UPDATE CIRCLE
   */
  onFilterChange(
    "circle",
    value?.value || CIRCLE_GROUPS.ALL,
  );
};


onChange={(_, value) =>
  handleCircleChange(value)
}