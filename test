
import React, { useState, useEffect, useRef } from "react";
import {
  Typography,
  Button,
  Box,
  InputBase,
  Stack,
  CircularProgress,
} from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import RefreshIcon from "@mui/icons-material/Refresh";
import EmailIcon from "@mui/icons-material/Email";
import PhoneAndroidIcon from "@mui/icons-material/PhoneAndroid";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import api from "../../../config/axiosConfig";
import { resolveConfig } from "../../../config/EnvironmentConfig";
import { PrimaryButton } from "./LoginStyles";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const LoginWithOTP = ({
  otpData,
  openLoginErrorDialog,
  onBackToHome,
  onSessionEstablished,
}) => {
  const showSnackbar = useCustomSnackbar();
  const inputRefs = useRef([]);

  // Backend configuration
  const config = otpData.otpConfig;
  const otpLength = config.otpLength;

  const [otpValues, setOtpValues] = useState(
    () => Array(otpLength).fill("")
  );
  const [expiresIn, setExpiresIn] = useState(otpData.expiresInSeconds);
  const [cooldown, setCooldown] = useState(
    otpData.resendCooldownSeconds
  );
  const [resendsLeft, setResendsLeft] = useState(
    otpData.resendsRemaining
  );

  const [transactionId, setTransactionId] = useState(
    otpData.transactionId
  );
  const [isLoading, setIsLoading] = useState(false);
  const [isLocked, setIsLocked] = useState(false);
  const [sessionExpired, setSessionExpired] = useState(false);
  const [errorMessage, setErrorMessage] = useState("");

  const otp = otpValues.join("");
  const codeExpired = expiresIn <= 0;
  const isExpired = codeExpired || sessionExpired;
  const isExhausted = resendsLeft <= 0;

  // Keep OTP inputs and timers synchronized with backend response
  useEffect(() => {
    setTransactionId(otpData.transactionId);
    setExpiresIn(otpData.expiresInSeconds);
    setCooldown(otpData.resendCooldownSeconds);
    setResendsLeft(otpData.resendsRemaining);
    setOtpValues(Array(otpLength).fill(""));
  }, [otpData, otpLength]);

  const focusFirstInput = () => {
    setTimeout(() => inputRefs.current[0]?.focus(), 0);
  };

  const clearOtp = () => {
    setOtpValues(Array(otpLength).fill(""));
    focusFirstInput();
  };

  // Countdown timers
  useEffect(() => {
    const timer = setInterval(() => {
      setExpiresIn((prev) => Math.max(0, prev - 1));
      setCooldown((prev) => Math.max(0, prev - 1));
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  const formatTime = (seconds) => {
    const minutes = Math.floor(seconds / 60)
      .toString()
      .padStart(2, "0");
    const remainingSeconds = (seconds % 60)
      .toString()
      .padStart(2, "0");

    return `${minutes}:${remainingSeconds}`;
  };

  const handleSessionTimeout = (message) => {
    setSessionExpired(true);
    openLoginErrorDialog(
      "Session Timed Out",
      message,
      "warning"
    );
    onBackToHome();
  };

  // Update values received from backend
  const updateOtpData = (data) => {
    if (data?.transactionId) {
      setTransactionId(data.transactionId);
    }

    if (data?.expiresInSeconds !== undefined) {
      setExpiresIn(data.expiresInSeconds);
    }

    if (data?.resendCooldownSeconds !== undefined) {
      setCooldown(data.resendCooldownSeconds);
    }

    if (data?.resendsRemaining !== undefined) {
      setResendsLeft(data.resendsRemaining);
    }
  };

  // Resend OTP
  const handleResendClick = async () => {
    if (isLoading || cooldown > 0 || isExhausted || sessionExpired) {
      return;
    }

    setIsLoading(true);
    setErrorMessage("");

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/resend-otp`,
        { transactionId }
      );

      const data = response?.data?.data || {};

      updateOtpData(data);
      setIsLocked(false);
      clearOtp();

      showSnackbar(
        response?.data?.message || data?.message,
        "success"
      );
    } catch (err) {
      const status = err.response?.status;
      const message = err.response?.data?.message || "";

      if (status === 401 && message.toLowerCase().includes("session")) {
        handleSessionTimeout(message);
      } else {
        setErrorMessage(message);
      }
    } finally {
      setIsLoading(false);
    }
  };

  // Verify OTP
  const handleVerifyOTP = async () => {
    if (
      isLoading ||
      otp.length !== otpLength ||
      isExpired ||
      isLocked
    ) {
      return;
    }

    setIsLoading(true);
    setErrorMessage("");

    try {
      const response = await api.post(
        `${resolveConfig("/LS") || ""}/auth/verify-otp`,
        {
          transactionId,
          otp,
        }
      );

      const result = response?.data?.data || {};

      if (response?.data?.success) {
        if (!result.payloadEncryptionKey) {
          result.payloadEncryptionKey =
            response.headers["x-payload-key"];
        }

        onSessionEstablished?.(result);
      } else {
        setErrorMessage(response?.data?.message || "");
        clearOtp();
      }
    } catch (err) {
      const status = err.response?.status;
      const message = err.response?.data?.message || "";

      if (status === 401) {
        if (message.toLowerCase().includes("session")) {
          handleSessionTimeout(message);
        } else if (
          message.toLowerCase().includes("too many incorrect attempts")
        ) {
          setIsLocked(true);
          setErrorMessage(message);
          clearOtp();
        } else {
          // Invalid or expired OTP
          setErrorMessage(message);
          clearOtp();
        }
      } else if (status === 400) {
        setErrorMessage(message);
        clearOtp();
      } else {
        setErrorMessage(
          message || "Verification request failed."
        );
      }
    } finally {
      setIsLoading(false);
    }
  };

  // OTP input handling
  const handleChange = (index, event) => {
    const digits = event.target.value.replace(/\D/g, "");

    if (!digits) {
      const updated = [...otpValues];
      updated[index] = "";
      setOtpValues(updated);
      return;
    }

    const updated = [...otpValues];

    digits.split("").forEach((digit, offset) => {
      if (index + offset < otpLength) {
        updated[index + offset] = digit;
      }
    });

    setOtpValues(updated);

    const nextIndex = Math.min(index + digits.length, otpLength - 1);
    inputRefs.current[nextIndex]?.focus();
  };

  const handlePaste = (event) => {
    event.preventDefault();

    const digits = event.clipboardData
      .getData("text")
      .replace(/\D/g, "")
      .slice(0, otpLength);

    if (!digits) return;

    const updated = Array(otpLength).fill("");

    digits.split("").forEach((digit, index) => {
      updated[index] = digit;
    });

    setOtpValues(updated);
    inputRefs.current[Math.min(digits.length, otpLength - 1)]?.focus();
  };

  const handleKeyDown = (index, event) => {
    if (event.key === "Backspace") {
      event.preventDefault();

      const updated = [...otpValues];

      if (updated[index]) {
        updated[index] = "";
      } else if (index > 0) {
        updated[index - 1] = "";
        inputRefs.current[index - 1]?.focus();
      }

      setOtpValues(updated);
    } else if (event.key === "ArrowLeft" && index > 0) {
      inputRefs.current[index - 1]?.focus();
    } else if (
      event.key === "ArrowRight" &&
      index < otpLength - 1
    ) {
      inputRefs.current[index + 1]?.focus();
    } else if (event.key === "Enter") {
      handleVerifyOTP();
    }
  };

  // Initial focus
  useEffect(() => {
    if (!sessionExpired) {
      focusFirstInput();
    }
  }, []);

  return (
    <Box sx={{ width: "100%", maxWidth: "420px", mx: "auto" }}>
      {/* OTP information */}
      <Box
        sx={{
          mb: 3,
          p: { xs: 1.5, sm: 2 },
          borderRadius: 2,
          bgcolor: "rgba(0,0,0,0.03)",
          border: "1px solid rgba(0,0,0,0.06)",
        }}
      >
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            mb: 1.5,
          }}
        >
          <Typography variant="body2" color="text.secondary">
            {isExpired ? "Status" : "Security Code Sent To"}
          </Typography>

          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              gap: 0.5,
              px: 1,
              py: 0.4,
              borderRadius: 1.5,
              bgcolor: isExpired ? "error.50" : "primary.50",
              color: isExpired ? "error.main" : "primary.main",
            }}
          >
            <AccessTimeIcon sx={{ fontSize: 14 }} />
            <Typography
              component="span"
              sx={{ fontFamily: "monospace", fontWeight: 700 }}
            >
              {formatTime(expiresIn)}
            </Typography>
          </Box>
        </Box>

        {!sessionExpired && (
          <Stack spacing={0.75}>
            {otpData.maskedMobile && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1.25 }}>
                <PhoneAndroidIcon sx={{ fontSize: 18 }} />
                <Typography variant="subtitle2">
                  {otpData.maskedMobile}
                </Typography>
              </Box>
            )}

            {otpData.maskedEmail && (
              <Box sx={{ display: "flex", alignItems: "center", gap: 1.25 }}>
                <EmailIcon sx={{ fontSize: 18 }} />
                <Typography
                  variant="subtitle2"
                  sx={{ wordBreak: "break-all" }}
                >
                  {otpData.maskedEmail}
                </Typography>
              </Box>
            )}
          </Stack>
        )}

        {sessionExpired && (
          <Typography color="error.main" variant="body2">
            Your session has timed out. Please log in again.
          </Typography>
        )}
      </Box>

      {sessionExpired ? (
        <Box sx={{ textAlign: "center", py: 2 }}>
          <WarningAmberIcon
            sx={{ fontSize: 48, color: "error.main", mb: 1 }}
          />

          <Typography variant="h6" fontWeight={700} gutterBottom>
            Session Expired
          </Typography>

          <PrimaryButton
            fullWidth
            variant="contained"
            startIcon={<ArrowBackIcon />}
            onClick={onBackToHome}
          >
            Back to Sign In
          </PrimaryButton>
        </Box>
      ) : (
        <>
          {/* OTP inputs */}
          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: `repeat(${otpLength}, 1fr)`,
              gap: { xs: 0.75, sm: 1.25 },
              mb: 2,
            }}
          >
            {otpValues.map((value, index) => (
              <Box
                key={index}
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  borderRadius: 2,
                  bgcolor: "background.paper",
                  border: "1.5px solid",
                  borderColor: value
                    ? "primary.main"
                    : "rgba(0,0,0,0.15)",
                  height: { xs: 48, sm: 54, md: 58 },
                  "&:focus-within": {
                    borderColor: "primary.main",
                    boxShadow: "0 0 0 3px rgba(25,118,210,0.15)",
                  },
                }}
              >
                <InputBase
                  inputRef={(element) => {
                    inputRefs.current[index] = element;
                  }}
                  value={value}
                  onChange={(event) => handleChange(index, event)}
                  onKeyDown={(event) => handleKeyDown(index, event)}
                  onPaste={handlePaste}
                  disabled={isLoading || isLocked || codeExpired}
                  inputProps={{
                    maxLength: otpLength,
                    inputMode: "numeric",
                    pattern: "[0-9]*",
                    style: {
                      textAlign: "center",
                      fontSize: "1.25rem",
                      fontWeight: 700,
                      padding: 0,
                      width: "100%",
                    },
                  }}
                />
              </Box>
            ))}
          </Box>

          {/* Backend error message */}
          {errorMessage && (
            <Typography
              color="error.main"
              variant="body2"
              sx={{ mb: 2, textAlign: "center" }}
            >
              {errorMessage}
            </Typography>
          )}

          {codeExpired && !errorMessage && (
            <Typography
              color="error.main"
              variant="body2"
              sx={{ mb: 2, textAlign: "center" }}
            >
              OTP expired. Please request a new code.
            </Typography>
          )}

          <PrimaryButton
            fullWidth
            variant="contained"
            onClick={handleVerifyOTP}
            disabled={
              isLoading ||
              otp.length !== otpLength ||
              isLocked ||
              codeExpired
            }
            sx={{ py: 1.25, fontSize: "0.95rem" }}
          >
            {isLoading ? (
              <CircularProgress size={22} color="inherit" />
            ) : (
              "Verify OTP & Sign In"
            )}
          </PrimaryButton>

          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              mt: 2.5,
            }}
          >
            <Button
              startIcon={<ArrowBackIcon />}
              onClick={onBackToHome}
              size="small"
              sx={{
                textTransform: "none",
                color: "text.secondary",
              }}
            >
              Back To Sign In
            </Button>

            {!isExhausted && (
              <Button
                onClick={handleResendClick}
                disabled={cooldown > 0 || isLoading}
                startIcon={<RefreshIcon />}
                size="small"
                sx={{ fontWeight: 600 }}
              >
                {cooldown > 0
                  ? `Resend in ${cooldown}s`
                  : "Resend Code"}
              </Button>
            )}
          </Box>

          <Typography
            variant="caption"
            color="text.secondary"
            sx={{ display: "block", textAlign: "right", mt: 1 }}
          >
            {resendsLeft} resend(s) remaining
          </Typography>
        </>
      )}
    </Box>
  );
};

export default LoginWithOTP;
