import React, { useMemo } from "react";
import {
  Box,
  Card,
  CardContent,
  Typography,
  Stack,
  List,
  ListItem,
  ListItemText,
  Divider,
  Chip,
  Avatar,
} from "@mui/material";

import HistoryIcon from "@mui/icons-material/History";
import DoneIcon from "@mui/icons-material/Done";
import CloseIcon from "@mui/icons-material/Close";
import HourglassBottomIcon from "@mui/icons-material/HourglassBottom";
import MoreHorizIcon from "@mui/icons-material/MoreHoriz";
import * as MUIIcons from "@mui/icons-material";

import { useSelector } from "react-redux";
import CustomChip from "../../../utils/CustomChip";

/* ---------------------------------------------------------
   Empty State
--------------------------------------------------------- */
function EmptyState({ text = "No activity" }) {
  return (
    <Box sx={{ py: 3, textAlign: "center", opacity: 0.7 }}>
      <Typography variant="body2" color="text.secondary">
        {text}
      </Typography>
    </Box>
  );
}

/* ---------------------------------------------------------
   Status Chip Logic
--------------------------------------------------------- */
const getStatusConfig = (status) => {
  const key = (status || "").toUpperCase();
  switch (key) {
    case "PENDING":
      return { icon: <HourglassBottomIcon fontSize="small" />, color: "warning", label: "Pending" };
    case "APPROVED":
      return { icon: <DoneIcon fontSize="small" />, color: "success", label: "Approved" };
    case "REJECTED":
      return { icon: <CloseIcon fontSize="small" />, color: "error", label: "Rejected" };
    default:
      return { icon: <MoreHorizIcon fontSize="small" />, color: "default", label: key || "Unknown" };
  }
};

const RenderChip = ({ status }) => {
  const cfg = getStatusConfig(status);
  try {
    return (
      <CustomChip
        label={cfg.label}
        size="small"
        color={cfg.color}
        variant="outlined"
        icon={cfg.icon}
        sx={{ fontWeight: 700 }}
      />
    );
  } catch {
    return (
      <Chip
        label={cfg.label}
        size="small"
        color={cfg.color}
        variant="outlined"
        icon={cfg.icon}
        sx={{ fontWeight: 700 }}
      />
    );
  }
};

/* ---------------------------------------------------------
   useMenuIcon – Dynamically pick icon from Redux menu list
--------------------------------------------------------- */
function useMenuIcon(title) {
  const menuItems = useSelector((state) => state.menu?.items || []);

  return useMemo(() => {
    if (!title) return <MoreHorizIcon fontSize="small" />;

    const normalize = (str) => (str || "").trim().toLowerCase();

    const t = normalize(title);

    // Try direct match
    let found =
      menuItems.find((m) => normalize(m.title) === t) ||
      menuItems.find((m) => normalize(m.label) === t);

    // Fallback: contains
    if (!found) {
      found =
        menuItems.find((m) => normalize(m.title).includes(t)) ||
        menuItems.find((m) => t.includes(normalize(m.title)));
    }

    // Absolute fallback: keyword match
    if (!found) {
      const parts = t.split(/\s+/);
      found = menuItems.find((m) =>
        parts.some((p) => normalize(m.title || "").includes(p))
      );
    }

    if (!found) return <MoreHorizIcon fontSize="small" />;

    const iconName = found.iconName || found.icon || found.iconKey;

    if (!iconName) return <MoreHorizIcon fontSize="small" />;

    const IconComp =
      MUIIcons[iconName] ||
      MUIIcons[`${iconName}Outlined`] ||
      MUIIcons[`${iconName}Rounded`];

    return IconComp ? <IconComp fontSize="small" /> : <MoreHorizIcon fontSize="small" />;
  }, [title, menuItems]);
}

/* ---------------------------------------------------------
   Relative Time Helper
--------------------------------------------------------- */
function relativeTime(tsOrDisplay) {
  try {
    const d =
      typeof tsOrDisplay === "number"
        ? new Date(tsOrDisplay)
        : new Date(tsOrDisplay);

    if (isNaN(d.getTime())) return "";

    const diff = Date.now() - d.getTime();
    const sec = Math.floor(diff / 1000);
    if (sec < 60) return `${sec}s ago`;
    const min = Math.floor(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const days = Math.floor(hr / 24);
    if (days < 7) return `${days}d ago`;

    return d.toLocaleDateString();
  } catch {
    return "";
  }
}

/* ---------------------------------------------------------
   MAIN COMPONENT
--------------------------------------------------------- */
export const DashboardRecentActivity = ({ recentActivity = [] }) => {
  const items = (recentActivity || []).slice(0, 20);

  return (
    <Card variant="outlined" sx={{ borderRadius: 3 }}>
      <CardContent>
        {/* Header */}
        <Stack direction="row" spacing={1} alignItems="center" mb={1}>
          <Box
            sx={{
              width: 44,
              height: 44,
              borderRadius: 2,
              bgcolor: "rgba(0,0,0,0.06)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            <HistoryIcon />
          </Box>

          <Typography variant="subtitle1" fontWeight={700}>
            Recent Activity
          </Typography>
        </Stack>

        {/* LIST */}
        <List
          dense
          sx={{
            minHeight: 320,
            maxHeight: 320,
            overflow: "auto",
          }}
        >
          {items.length === 0 && <EmptyState text="No activity" />}

          {items.map((r, idx) => {
            const icon = useMenuIcon(r.action);
            const relTime = relativeTime(r.timestamp || r.displayTime);

            return (
              <Box key={r.timestamp + idx}>
                {idx > 0 && <Divider component="li" />}

                <ListItem
                  alignItems="flex-start"
                  sx={{
                    py: 1.4,
                    "&:hover": { bgcolor: "rgba(0,0,0,0.03)" },
                  }}
                >
                  <Box sx={{ display: "flex", width: "100%" }}>
                    {/* LEFT: Icon + Title */}
                    <Stack direction="row" spacing={1.5} alignItems="flex-start">
                      <Avatar
                        sx={{
                          bgcolor: "rgba(0,0,0,0.06)",
                          width: 36,
                          height: 36,
                        }}
                      >
                        {icon}
                      </Avatar>

                      <Box sx={{ minWidth: 0 }}>
                        <Typography
                          variant="body2"
                          fontWeight={700}
                          sx={{
                            overflow: "hidden",
                            whiteSpace: "nowrap",
                            textOverflow: "ellipsis",
                            maxWidth: "200px",
                          }}
                        >
                          {r.action}
                        </Typography>

                        <Typography variant="caption" color="text.secondary">
                          {relTime}
                          {r.user ? ` • ${r.user}` : ""}
                        </Typography>
                      </Box>
                    </Stack>

                    {/* RIGHT: CHIP */}
                    <Box sx={{ marginLeft: "auto", pt: 0.7 }}>
                      <RenderChip status={r.status} />
                    </Box>
                  </Box>
                </ListItem>

                {/* DETAILS */}
                <Box sx={{ pl: 7, pb: 1 }}>
                  <Typography variant="body2">{r.details}</Typography>
                  {r.source && (
                    <Typography
                      variant="caption"
                      color="text.secondary"
                      sx={{ mt: 0.5, display: "block" }}
                    >
                      Source: {r.source}
                    </Typography>
                  )}
                </Box>
              </Box>
            );
          })}
        </List>
      </CardContent>
    </Card>
  );
};

export default DashboardRecentActivity;