mutationFn: async ({ sql, exportType, tableName }) => {
  const blob = await callApi(
    "/TS/admin-support/export-data",
    {
      sql,
      exportType,
      tableName,
    },
    "POST",
    "blob"
  );

  return {
    blob,
    fileName:
      exportType === "CSV"
        ? "export.csv"
        : exportType === "EXCEL"
        ? "export.xlsx"
        : exportType === "JSON"
        ? "export.json"
        : "export.sql",
  };
};