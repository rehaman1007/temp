import { useEffect } from "react";
import { useSelector, useDispatch } from "react-redux";
import { useNavigate } from "react-router-dom";
import { Box, Typography } from "@mui/material";
import ComponentLoadingOverlay from "../components/ComponentLoadingOverlay"; // Path to your new custom inline loader

const Home = () => {
  const navigate = useNavigate();
  const menus = useSelector((state) => state.menus.menus);

  useEffect(() => {
    // 1. Ensure menus are loaded and contain at least one main menu item
    if (menus && menus.length > 0) {
      const firstMenu = menus[0];

      // 2. Safely verify if a submenu array structure exists
      if (firstMenu.subMenus && firstMenu.subMenus.length > 0) {
        const firstSubMenu = firstMenu.subMenus[0];

        // 3. Fallback tracking logic to detect your dynamic route configuration keys
        // (Adjust 'path', 'route', or 'url' depending on your backend schema object keys)
        const targetPath = firstSubMenu.path || firstSubMenu.route || firstSubMenu.url;

        if (targetPath) {
          // Replace execution prevents the user from clicking 'Back' into an infinite loop redirect
          navigate(targetPath, { replace: true });
        } else {
          // If no path config key is found, fall back to option selection view
          navigate(`/choose-option/${encodeURIComponent(firstMenu.title || "")}`, { replace: true });
        }
      } else {
        // Fallback if the first menu item has absolutely zero submenus
        navigate("/help", { replace: true });
      }
    }
  }, [menus, navigate]);

  return (
    <Box
      sx={{
        position: "relative",
        minHeight: "60vh",
        display: "flex",
        flexDirection: "column",
        justifyContent: "center",
        alignItems: "center",
        p: 4
      }}
    >
      {/* Show your nice brand component loader while processing the menu lookup redirection */}
      <ComponentLoadingOverlay loading={!menus || menus.length === 0} />
      
      {!menus || menus.length === 0 ? (
        <Typography variant="body2" sx={{ color: "text.secondary", mt: 8 }}>
          Initializing your authorized workspace...
        </Typography>
      ) : null}
    </Box>
  );
};

export default Home;
