            <Box sx={{ display: "flex", flexDirection: "column", gap: 2.5, flex: 1 }}>
              {/* SESSION KEY */}
              <TextField
                fullWidth
                label="Session Key"
                placeholder="payloadEncryptionKey"
                type={showKey ? "text" : "password"}
