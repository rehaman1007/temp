          >
            {report.reportDescription || "No detailed description provided for this report."}
          </Typography>
        </Box>

        <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", pt: 1.5, borderTop: "1px solid", borderColor: "divider" }}>
          <Chip label={report.category || "Report"} size="small" sx={{ height: 24, fontSize: "0.7rem", fontWeight: 600, bgcolor: "grey.50", color: "text.secondary" }} />
          <ArrowForwardRounded className="action-arrow" fontSize="small" sx={{ color: "primary.main", opacity: 0, transform: "translateX(0)", transition: "all 0.25s ease" }} />
