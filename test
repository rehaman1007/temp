import "./App.css";
import AppRouter from "./routes/AppRouter";
import {
  Box,
  CssBaseline,
  StyledEngineProvider,
  useColorScheme,
} from "@mui/material";
import { useEffect } from "react";
import { SnackbarProviderComponent } from "./utils/SnackbarContext";
import GlobalBackground from "./theme/GlobalBackground";
import AppTheme from "./theme/AppTheme";
import { NotificationProvider } from "./context/NotificationContext";
import NotificationPopup from "./components/notification/NotificationPopup";

const ColorSchemeInitializer = () => {
  const { mode, setMode } = useColorScheme();

  useEffect(() => {
    if (mode === "system" || mode === undefined) {
      setMode("light");
    }
    console.log("Current color scheme :: ", mode);
  }, [mode, setMode]);

  return null;
};

function App() {
  useEffect(() => {
    if (window.performance) {
      const perfData = window.performance.timing;
      const pageLoadTime = perfData.loadEventEnd - perfData.navigationStart;
      console.log("Page Load Time:", pageLoadTime, "ms");
    }
  }, []);

  return (
    <AppTheme>
      <StyledEngineProvider injectFirst>
        <ColorSchemeInitializer />
        <CssBaseline enableColorScheme />
        <GlobalBackground />
        <Box
          sx={{
            transition:
              "background-color 0.6s ease, color 0.6s ease, filter 0.6s ease",
          }}
        >
          {/* ✅ Move NotificationProvider INSIDE Router context */}
          <SnackbarProviderComponent>
            <AppRouter>
              <NotificationProvider>
                <NotificationPopup />
              </NotificationProvider>
            </AppRouter>
          </SnackbarProviderComponent>
        </Box>
      </StyledEngineProvider>
    </AppTheme>
  );
}

export default App;