	@Override
	public GlccValidationResponse validateGlcc(GlccValidationRequest dto) {

		String glcc = dto.getGlcc();
		String circleCode = dto.getCircleCode();

		List<String> errors = new ArrayList<>();

		// 1. Strict Input Validation (Breaks Fortify Taint Chain)
		// Ensures glcc is exactly 18 alphanumeric characters, preventing malicious payloads.
		if (glcc == null || !glcc.matches("^[a-zA-Z0-9]{18}$")) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(List.of("GLCC must be exactly 18 alphanumeric characters"))
					.build();
		}

		// Also validate circleCode to ensure it only contains safe characters
		if (circleCode == null || !circleCode.matches("^[a-zA-Z0-9]{1,20}$")) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(List.of("Invalid Circle Code format"))
					.build();
		}

		// 2. Safe Extraction (Variables are now sanitized)
		String branchCode = glcc.substring(0, 5);
		String currencyCode = glcc.substring(5, 8);
		String cglNumber = glcc.substring(8, 18);

		// 3. Database Execution
		BranchMaster branch = branchMasterRepository.findByCode(circleCode, branchCode);
		CurrencyMasterModel currency = currencyMasterRepo.findByCurrencyCode(currencyCode);
		CGLMaster cgl = cglMasterRepository.findByCglNumber(cglNumber);

		if (branch == null) {
			errors.add("Invalid Branch");
		}

		if (currency == null) {
			errors.add("Invalid Currency");
		}

		if (cgl == null) {
			errors.add("Invalid CGL");
		}

		if (!errors.isEmpty()) {
			return GlccValidationResponse.builder()
					.valid(false)
					.errors(errors)
					.build();
		}

		return GlccValidationResponse.builder()
				.valid(true)
				.branchCode(branch.getCode())
				.branchName(branch.getName())
				.currencyCode(currency.getCurrencyCode())
				.currencyName(currency.getCurrencyName())
				.cglNumber(cgl.getCglNumber())
				.cglDescription(cgl.getDescription())
				.message("Valid GLCC")
				.build();
	}
