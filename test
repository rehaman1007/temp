import React, { useState, useEffect } from "react";
import {
  Box,
  Typography,
  Container,
  Grid,
  Paper,
  IconButton,
  Tooltip,
  Chip,
  CircularProgress,
  Divider,
} from "@mui/material";
import { motion, AnimatePresence } from "framer-motion";
import dayjs from "dayjs";

// MUI Icons
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import PictureAsPdfIcon from "@mui/icons-material/PictureAsPdf";
import TableChartIcon from "@mui/icons-material/TableChart";
import ArticleIcon from "@mui/icons-material/Article";
import ViewListIcon from "@mui/icons-material/ViewList";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import WarningIcon from "@mui/icons-material/Warning";
import EventBusyIcon from "@mui/icons-material/EventBusy";
import StorageIcon from "@mui/icons-material/Storage";

// Custom Hooks
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// --- Date Utility ---
const isLastDayOfMonth = (dateString) => {
  if (!dateString) return false;
  const [year, month, day] = dateString.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return date.getDate() === lastDayOfMonth;
};

// --- Constants ---
const REPORT_DATA = [
  {
    id: "YSA",
    title: "YSA Report",
    description: "Yield Settlement Analysis",
  },
  {
    id: "PNL",
    title: "PNL Report",
    description: "Profit & Loss Statement",
  },
];

// --- Sub-Components ---
const DownloadActions = ({ disabled }) => {
  const formats = [
    { label: "PDF", icon: <PictureAsPdfIcon />, color: "#d32f2f" },
    { label: "Excel", icon: <TableChartIcon />, color: "#1b5e20" },
    { label: "Text", icon: <ArticleIcon />, color: "#424242" },
    { label: "PSV", icon: <ViewListIcon />, color: "#0277bd" },
  ];

  return (
    <Box sx={{ display: "flex", gap: 2, mt: 3, justifyContent: "center" }}>
      {formats.map((format, index) => (
        <Tooltip
          title={
            disabled ? "Unavailable for failed run" : `Download ${format.label}`
          }
          key={format.label}
          arrow
        >
          <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: index * 0.1 }}
            whileHover={!disabled ? { scale: 1.15, y: -3 } : {}}
            whileTap={!disabled ? { scale: 0.95 } : {}}
          >
            <IconButton
              disabled={disabled}
              sx={{
                bgcolor: disabled
                  ? "action.disabledBackground"
                  : `${format.color}15`,
                color: disabled ? "action.disabled" : format.color,
                "&:hover": {
                  bgcolor: disabled
                    ? "action.disabledBackground"
                    : `${format.color}25`,
                },
              }}
            >
              {format.icon}
            </IconButton>
          </motion.div>
        </Tooltip>
      ))}
    </Box>
  );
};

const ReportCard = ({ report, isRunSuccessful }) => {
  return (
    <Paper
      elevation={0}
      sx={{
        p: 4,
        borderRadius: 3,
        border: "1px solid",
        borderColor: "divider",
        background: "linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%)",
        height: "100%",
        display: "flex",
        flexDirection: "column",
        justifyContent: "space-between",
      }}
    >
      <Box sx={{ textAlign: "center", mb: 2 }}>
        <Typography
          variant="h5"
          fontWeight="700"
          color="primary.main"
          gutterBottom
        >
          {report.title}
        </Typography>
        <Typography variant="body2" color="text.secondary">
          {report.description}
        </Typography>
      </Box>

      <Divider sx={{ my: 2 }} />

      <Box sx={{ textAlign: "center" }}>
        <Typography variant="subtitle2" color="text.secondary">
          Available Formats
        </Typography>
        <DownloadActions disabled={!isRunSuccessful} />
      </Box>
    </Paper>
  );
};

// --- Main Screen ---

export default function AdhocReports() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  
  const [etlDate, setEtlDate] = useState("");
  const [runs, setRuns] = useState([]);
  const [selectedRun, setSelectedRun] = useState(null);
  const [loading, setLoading] = useState(true);

  const fetchData = async () => {
    setLoading(true);
    try {
      // NOTE: Replace "/PS/process/adhoc-metadata" with your actual single API endpoint
      const response = await callApi("/PS/process/adhoc-metadata", {}, "GET");
      
      const responseData = response?.data || response;
      const etlRaw = responseData?.etlDate;
      const fetchedRuns = responseData?.runs || [];

      // Format date to strictly string "YYYY-MM-DD" for rendering and utility checks
      const formattedEtlDate = etlRaw 
        ? dayjs(etlRaw.split("T")[0]).format("YYYY-MM-DD") 
        : dayjs().format("YYYY-MM-DD");
        
      setEtlDate(formattedEtlDate);
      setRuns(fetchedRuns);

      // Auto-select latest run if runs exist
      if (fetchedRuns.length > 0) {
        setSelectedRun(fetchedRuns[fetchedRuns.length - 1]);
      }
      
    } catch (e) {
      console.error("Metadata fetch error:", e);
      showSnackBar(
        "Failed to load ETL metadata. Kindly try again after sometime.",
        "error"
      );
      setEtlDate(dayjs().format("YYYY-MM-DD"));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  if (loading) {
    return (
      <Box
        sx={{
          display: "flex",
          height: "100vh",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        <CircularProgress />
      </Box>
    );
  }

  // Intercept if ETL date is NOT the last day of the month
  if (etlDate && !isLastDayOfMonth(etlDate)) {
    return (
      <Container maxWidth="sm" sx={{ py: 12 }}>
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.5 }}
        >
          <Paper
            elevation={0}
            sx={{
              p: 6,
              borderRadius: 4,
              textAlign: "center",
              border: "1px solid",
              borderColor: "divider",
              bgcolor: "#fafafa",
            }}
          >
            <motion.div
              initial={{ scale: 0 }}
              animate={{ scale: 1 }}
              transition={{ delay: 0.2, type: "spring", stiffness: 150 }}
            >
              <EventBusyIcon
                sx={{
                  fontSize: 80,
                  color: "text.secondary",
                  mb: 3,
                  opacity: 0.5,
                }}
              />
            </motion.div>
            <Typography
              variant="h5"
              fontWeight="bold"
              gutterBottom
              color="text.primary"
            >
              Not a Month-End Cycle
            </Typography>
            <Typography variant="body1" color="text.secondary">
              Adhoc Reports (YSA and PNL) are strictly generated as part of the
              month-end activity. The current ETL Date processed is{" "}
              <strong>{etlDate}</strong>. Please check back during the month-end
              processing cycle.
            </Typography>
          </Paper>
        </motion.div>
      </Container>
    );
  }

  const hasMultipleRuns = runs.length > 1;
  const isRunSuccessful = selectedRun?.status === "SUCCESS";

  return (
    <Container maxWidth="lg" sx={{ py: 6 }}>
      {/* Page Header */}
      <motion.div
        initial={{ opacity: 0, x: -20 }}
        animate={{ opacity: 1, x: 0 }}
        transition={{ duration: 0.5 }}
      >
        <Box sx={{ mb: 4 }}>
          <Typography
            variant="h4"
            fontWeight="800"
            color="text.primary"
            gutterBottom
          >
            Adhoc Reports
          </Typography>
          <Typography
            variant="body1"
            color="text.secondary"
            sx={{ maxWidth: "800px" }}
          >
            View and download your monthly Yield Settlement Analysis (YSA) and
            Profit & Loss (PNL) statements. These reports are exclusively
            generated based on the successful runs of the month-end ETL
            processing.
          </Typography>
        </Box>
      </motion.div>

      {/* Global Control Panel (Date & Runs) */}
      <motion.div
        initial={{ y: 20, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        transition={{ duration: 0.5, delay: 0.1 }}
      >
        <Paper
          elevation={0}
          sx={{
            p: 3,
            mb: 5,
            borderRadius: 3,
            bgcolor: "background.paper",
            border: "1px solid",
            borderColor: "divider",
            boxShadow: "0 4px 20px rgba(0, 0, 0, 0.03)",
          }}
        >
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              flexWrap: "wrap",
              gap: 2,
            }}
          >
            <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
              <Box
                sx={{
                  p: 1.5,
                  bgcolor: "primary.50",
                  color: "primary.main",
                  borderRadius: 2,
                  display: "flex",
                }}
              >
                <CalendarMonthIcon fontSize="medium" />
              </Box>
              <Box>
                <Typography
                  variant="caption"
                  color="text.secondary"
                  fontWeight="bold"
                  sx={{ display: "block" }}
                >
                  ACTIVE ETL DATE
                </Typography>
                <Typography variant="h6" fontWeight="600">
                  {etlDate}
                </Typography>
              </Box>
            </Box>

            {/* Global Run Status Indicator */}
            {selectedRun && (
              <Chip
                icon={isRunSuccessful ? <CheckCircleIcon /> : <WarningIcon />}
                label={`Global Status: ${selectedRun.status}`}
                color={isRunSuccessful ? "success" : "error"}
                variant="outlined"
                sx={{ fontWeight: "bold" }}
              />
            )}
          </Box>

          {/* Global Interactive Run Selector */}
          <AnimatePresence mode="wait">
            {hasMultipleRuns && (
              <motion.div
                initial={{ height: 0, opacity: 0 }}
                animate={{ height: "auto", opacity: 1 }}
                exit={{ height: 0, opacity: 0 }}
                style={{ overflow: "hidden" }}
              >
                <Divider sx={{ my: 3 }} />
                <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                  <StorageIcon color="action" />
                  <Typography
                    variant="subtitle2"
                    fontWeight="bold"
                    color="text.secondary"
                  >
                    SELECT PROCESSING RUN:
                  </Typography>
                  <Box sx={{ display: "flex", gap: 1.5, flexWrap: "wrap" }}>
                    {runs.map((run) => {
                      const isSelected = selectedRun.runId === run.runId;
                      return (
                        <motion.div
                          key={run.runId}
                          whileHover={{ scale: 1.05 }}
                          whileTap={{ scale: 0.95 }}
                          onClick={() => setSelectedRun(run)}
                          style={{ cursor: "pointer" }}
                        >
                          <Box
                            sx={{
                              px: 2,
                              py: 0.75,
                              borderRadius: "24px",
                              border: "2px solid",
                              borderColor: isSelected
                                ? "primary.main"
                                : "divider",
                              bgcolor: isSelected
                                ? "primary.main"
                                : "transparent",
                              color: isSelected ? "white" : "text.primary",
                              transition: "all 0.2s",
                              display: "flex",
                              alignItems: "center",
                              gap: 1,
                            }}
                          >
                            <Typography
                              variant="body2"
                              fontWeight={isSelected ? 700 : 500}
                            >
                              Run {run.runId}
                            </Typography>
                            <Typography
                              variant="caption"
                              sx={{ opacity: isSelected ? 0.9 : 0.6 }}
                            >
                              ({run.timestamp})
                            </Typography>
                          </Box>
                        </motion.div>
                      );
                    })}
                  </Box>
                </Box>
              </motion.div>
            )}
          </AnimatePresence>
        </Paper>
      </motion.div>

      {/* Reports Grid (Driven by constant REPORT_DATA) */}
      <Grid container spacing={4}>
        {REPORT_DATA.map((report, index) => (
          <Grid item xs={12} md={6} key={report.id}>
            <motion.div
              initial={{ opacity: 0, y: 30 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, delay: 0.2 + index * 0.1 }}
              style={{ height: "100%" }}
            >
              <ReportCard report={report} isRunSuccessful={isRunSuccessful} />
            </motion.div>
          </Grid>
        ))}
      </Grid>
    </Container>
  );
}
