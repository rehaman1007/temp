import {
  AccountTree,
  Business,
  Close,
  Email,
  Help,
  Logout,
  Phone,
  SmartScreen,
  Link as LinkIcon,
  AccountBalance,
  Security,
  InfoOutlined,
} from "@mui/icons-material";
import {
  Avatar,
  Box,
  Button,
  Chip,
  Drawer,
  IconButton,
  Typography,
  useTheme,
  useMediaQuery,
} from "@mui/material";
import { useSelector } from "react-redux";
import { useNavigate } from "react-router-dom";
import { userAvatarCreator } from "../utils/userUtilities";
import { useContext, useEffect } from "react";
import { AuthContext } from "../context/AuthContext";

// Reusable micro-component for grid items to keep JSX clean
const InfoItem = ({ icon, label, value, fullWidth = false }) => (
  <Box
    sx={{
      display: "flex",
      alignItems: "flex-start",
      gap: 1.5,
      p: 1.25,
      bgcolor: (theme) =>
        theme.palette.mode === "dark" ? "grey.900" : "grey.50",
      borderRadius: 2,
      gridColumn: fullWidth ? "1 / -1" : "auto",
      border: "1px solid",
      borderColor: "divider",
      overflow: "hidden",
    }}
  >
    <Box sx={{ color: "primary.main", mt: 0.25, display: "flex" }}>{icon}</Box>
    <Box sx={{ minWidth: 0, flex: 1 }}>
      <Typography
        variant="caption"
        color="text.secondary"
        sx={{ display: "block", mb: 0.25, lineHeight: 1 }}
      >
        {label}
      </Typography>
      <Typography
        variant="body2"
        title={value}
        sx={{
          fontWeight: 600,
          display: "-webkit-box",
          WebkitLineClamp: 2,
          WebkitBoxOrient: "vertical",
          overflow: "hidden",
          wordBreak: "break-word",
          lineHeight: 1.2,
        }}
      >
        {value || "N/A"}
      </Typography>
    </Box>
  </Box>
);

const ProfileDrawer = ({ profileDrawerOpen, setProfileDrawerOpen }) => {
  const user = useSelector((state) => state.auth.user);
  const navigate = useNavigate();
  const { logout } = useContext(AuthContext);

  const theme = useTheme();
  const isMobileOrTablet = useMediaQuery(theme.breakpoints.down("md"));

  const formatCode = (code, length) => {
    if (code === undefined || code === null || code === "") return "N/A";
    return String(code).padStart(length, "0");
  };

  // Pre-formatting strings
  const branchDisplay = user?.branchName
    ? `${user.branchName.trim()} (${formatCode(user.branch, 5)})`
    : "N/A";

  const circleDisplay = user?.circleName
    ? `${user.circleName.trim()} (${formatCode(user.circleCode, 3)})`
    : "N/A";

  const fullName = `${user?.firstName || ""} ${
    user?.middleName ? user.middleName + " " : ""
  }${user?.lastName || ""}`.trim();

  useEffect(() => {
    const handleKeyDown = (event) => {
      if (
        !isMobileOrTablet &&
        event.altKey &&
        event.key.toLowerCase() === "l"
      ) {
        event.preventDefault();
        logout();
      }

      if (event.key === "Escape" && profileDrawerOpen) {
        setProfileDrawerOpen(false);
      }
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [logout, profileDrawerOpen, setProfileDrawerOpen, isMobileOrTablet]);

  return (
    <Drawer
      anchor="right"
      open={profileDrawerOpen}
      onClose={() => setProfileDrawerOpen(false)}
      sx={{
        "& .MuiDrawer-paper": {
          width: { xs: "95vw", sm: 500 }, // Slightly wider to support side-by-side grid
          maxWidth: "100vw",
          boxSizing: "border-box",
          p: 0,
          display: "flex",
          flexDirection: "column",
          overflow: "hidden", // Prevent full-page scroll
        },
      }}
    >
      {/* Header */}
      <Box sx={{ p: 2, borderBottom: "1px solid", borderColor: "divider" }}>
        <Box
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="h6" sx={{ fontWeight: 600 }}>
            Profile Overview
          </Typography>
          <IconButton onClick={() => setProfileDrawerOpen(false)} size="small">
            <Close />
          </IconButton>
        </Box>
      </Box>

      {/* Main Content Area - Designed to fit without scrolling */}
      <Box
        sx={{
          p: 2,
          display: "flex",
          flexDirection: "column",
          flex: 1,
          gap: 2,
          overflowY: "auto", // Fallback safety only for extremely small landscape devices
        }}
      >
        {/* User Identity Section (Horizontal Layout) */}
        <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
          <Avatar
            sx={{
              width: 72,
              height: 72,
              color: "primary.contrastText",
              backgroundColor: "primary.main",
              fontSize: "1.75rem",
              fontWeight: 600,
            }}
          >
            {userAvatarCreator(user)}
          </Avatar>
          <Box sx={{ flex: 1, minWidth: 0 }}>
            <Typography
              variant="h6"
              sx={{ fontWeight: 700, lineHeight: 1.2, mb: 0.5 }}
              noWrap
            >
              {fullName}
            </Typography>
            <Typography
              variant="body2"
              color="text.secondary"
              sx={{ mb: 0.75, fontWeight: 500 }}
              noWrap
            >
              User ID: {user?.userId} | Role ID: {user?.role}
            </Typography>
            <Chip
              label={user?.roleName?.trim()}
              size="small"
              sx={{
                backgroundColor: "#10B981",
                color: "white",
                fontWeight: 600,
                height: 22,
                fontSize: "0.7rem",
              }}
            />
          </Box>
        </Box>

        {/* Highly Compact Grid Layout for all Details */}
        <Box
          sx={{
            display: "grid",
            gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)" },
            gap: 1.5,
            flex: 1,
          }}
        >
          <InfoItem
            icon={<Business fontSize="small" />}
            label="Branch Details"
            value={branchDisplay}
          />
          <InfoItem
            icon={<AccountTree fontSize="small" />}
            label="Circle Details"
            value={circleDisplay}
          />
          <InfoItem
            icon={<AccountBalance fontSize="small" />}
            label="Circle Branch"
            value={formatCode(user?.circleBranch, 5)}
          />
          <InfoItem
            icon={<SmartScreen fontSize="small" />}
            label="System Access Level"
            value={user?.isCircle ? "Circle Level" : "Branch Level"}
          />
          <InfoItem
            icon={<Security fontSize="small" />}
            label="Role Access"
            value={
              user?.accessName
                ? `${user.accessName} (${user.roleAccess})`
                : "N/A"
            }
          />
          <InfoItem
            icon={<Phone fontSize="small" />}
            label="Contact No"
            value={user?.phoneNumber}
          />
          <InfoItem
            icon={<Email fontSize="small" />}
            label="Email Address"
            value={user?.email}
            fullWidth={true}
          />
          <InfoItem
            icon={<InfoOutlined fontSize="small" />}
            label="Access Description"
            value={user?.accessDescription}
            fullWidth={true}
          />
        </Box>

        {/* Footer Actions (Horizontal Layout to save vertical space) */}
        <Box
          sx={{
            display: "flex",
            gap: 1.5,
            pt: 2,
            mt: "auto",
            borderTop: "1px solid",
            borderColor: "divider",
          }}
        >
          <Button
            variant="outlined"
            startIcon={<Help />}
            onClick={() => {
              navigate("/help");
              setProfileDrawerOpen(false);
            }}
            sx={{ flex: 1, textTransform: "none", borderRadius: 2 }}
          >
            Help
          </Button>
          <Button
            variant="outlined"
            component="a"
            href="https://score.sbi/"
            target="_blank"
            rel="noopener noreferrer"
            startIcon={<LinkIcon />}
            sx={{ flex: 1, textTransform: "none", borderRadius: 2 }}
          >
            SCORE
          </Button>
          <Button
            variant="contained"
            color="error"
            startIcon={<Logout />}
            onClick={logout}
            sx={{
              flex: 1,
              textTransform: "none",
              borderRadius: 2,
              whiteSpace: "nowrap",
            }}
          >
            Sign Out
            {!isMobileOrTablet && (
              <Box
                component="span"
                sx={{
                  ml: 1,
                  fontSize: "0.6rem",
                  px: 0.5,
                  py: 0.1,
                  border: "1px solid rgba(255,255,255,0.5)",
                  borderRadius: 1,
                }}
              >
                Alt+L
              </Box>
            )}
          </Button>
        </Box>
      </Box>
    </Drawer>
  );
};

export default ProfileDrawer;
