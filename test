WITH circle AS (
    SELECT *
    FROM BE_PARAM
    WHERE PARAM_TYPE = 'CIRCLE'
),
misc AS (
    SELECT *
    FROM BA_SISCESP
    WHERE MISC_REPORT_ID_TR = '9001'
      AND MISC_QDATE = TO_DATE('31/12/2025', 'DD/MM/YYYY')
)
SELECT
    c.PARAM_CODE    AS CIRCLE_CODE,
    c.PARAM_NAME    AS CIRCLE_NAME,
    m.MISC_REPORT_ID_TR,
    m.MISC_QDATE
FROM
    circle c
LEFT JOIN
    misc m
ON
    c.PARAM_CODE = m.MISC_HIS_CIRCLE;