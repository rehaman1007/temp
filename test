import React, { useState, useMemo } from "react";
import {
  Autocomplete,
  Box,
  MenuItem,
  TextField,
  Typography,
  Stack,
} from "@mui/material";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { StyledButton } from "./BalanceStyles";
import dayjs from "dayjs";
import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";

export default function BalanceFilters({
  branch,
  setBranch,
  currency,
  setCurrency,
  cgl,
  setCgl,
  start,
  setStart,
  end,
  setEnd,
  currencies,
  branches,
  cgls,
  loading,
  handleSearchChange,
  fetchCurrencies,
  handleSubmit,
  resetState,
  isNumeric,
  req,
  user,
  permissions,
  etlDate,
  glcc,
  setGlcc,
  glccValidated,
  setGlccValidated,
  validateGlcc,
}) {
  const [branchInput, setBranchInput] = useState("");
  const [cglInput, setCglInput] = useState("");

  const [fromDateError, setFromDateError] = useState(null);
  const [toDateError, setToDateError] = useState(null);
  const [quickFilter, setQuickFilter] = useState("custom");

  const MIN_ALLOWED_DATE = dayjs("2026-03-31");
  const baseDate = etlDate?.isValid?.() ? etlDate : dayjs();

  // Dynamically calculate available filter options based on MIN_ALLOWED_DATE
  const availableFilters = useMemo(() => {
    // Helper to check if a date is valid to show
    const isValid = (calcDate) => !calcDate.isBefore(MIN_ALLOWED_DATE, "day");

    return [
      { value: "custom", label: "Custom Range", show: true },
      { value: "currentDay", label: "Current Day", show: isValid(baseDate) },
      {
        value: "previousDay",
        label: "Previous Day",
        show: isValid(baseDate.subtract(1, "day")),
      },
      {
        value: "currentWeek",
        label: "Current Week",
        show: isValid(baseDate.startOf("week")),
      },
      {
        value: "previousWeek",
        label: "Previous Week",
        show: isValid(baseDate.subtract(1, "week").startOf("week")),
      },
      {
        value: "currentMonth",
        label: "Current Month",
        show: isValid(baseDate.startOf("month")),
      },
      {
        value: "previousMonth",
        label: "Previous Month",
        show: isValid(baseDate.subtract(1, "month").startOf("month")),
      },
      {
        value: "last3Months",
        label: "Last 3 Months",
        show: isValid(baseDate.subtract(3, "month")),
      },
      {
        value: "last6Months",
        label: "Last 6 Months",
        show: isValid(baseDate.subtract(6, "month")),
      },
      {
        value: "currentYear",
        label: "Current Year",
        show: isValid(baseDate.startOf("year")),
      },
      {
        value: "previousYear",
        label: "Previous Year",
        show: isValid(baseDate.subtract(1, "year").startOf("year")),
      },
    ].filter((option) => option.show);
  }, [baseDate]);

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "invalidDate":
        return `Please enter a valid ${field}`;
      case "minDate":
        return `${field} cannot be earlier than ${MIN_ALLOWED_DATE.format("DD-MM-YYYY")}`;
      case "maxDate":
        return `${field} cannot exceed ${etlDate?.format("DD-MM-YYYY")}`;
      case "fromGreaterThanTo":
        return "From Date cannot be greater than To Date";
      case "toLessThanFrom":
        return "To Date cannot be less than From Date";
      case "rangeExceeds12Months":
        return "Date range cannot exceed 12 months";
      case "afterEtlDate":
        return `To Date cannot exceed ETL Date ${etlDate?.format("DD-MM-YYYY")}`;
      default:
        return "";
    }
  };

  const validateDateRange = (fromDate, toDate) => {
    setFromDateError(null);
    setToDateError(null);

    if (!fromDate?.isValid?.() || !toDate?.isValid?.()) return;

    if (fromDate.isAfter(toDate, "day")) {
      setFromDateError("fromGreaterThanTo");
      setToDateError("toLessThanFrom");
      return;
    }
    if (toDate.isAfter(fromDate.add(1, "year"), "day")) {
      setToDateError("rangeExceeds12Months");
      return;
    }
    if (etlDate?.isValid?.() && toDate.isAfter(etlDate, "day")) {
      setToDateError("afterEtlDate");
    }
  };

  const handleQuickFilter = (e) => {
    const option = e.target.value;
    setQuickFilter(option);

    if (option === "custom") return;

    let newStart = baseDate;
    let newEnd = baseDate;

    switch (option) {
      case "currentDay":
        break;
      case "previousDay":
        newStart = baseDate.subtract(1, "day");
        newEnd = baseDate.subtract(1, "day");
        break;
      case "currentWeek":
        newStart = baseDate.startOf("week");
        break;
      case "previousWeek":
        newStart = baseDate.subtract(1, "week").startOf("week");
        newEnd = baseDate.subtract(1, "week").endOf("week");
        break;
      case "currentMonth":
        newStart = baseDate.startOf("month");
        break;
      case "previousMonth":
        newStart = baseDate.subtract(1, "month").startOf("month");
        newEnd = baseDate.subtract(1, "month").endOf("month");
        break;
      case "last3Months":
        newStart = baseDate.subtract(3, "month");
        break;
      case "last6Months":
        newStart = baseDate.subtract(6, "month");
        break;
      case "currentYear":
        newStart = baseDate.startOf("year");
        break;
      case "previousYear":
        newStart = baseDate.subtract(1, "year").startOf("year");
        newEnd = baseDate.subtract(1, "year").endOf("year");
        break;
      default:
        break;
    }

    // Force strict bounds before setting
    if (newStart.isBefore(MIN_ALLOWED_DATE)) newStart = MIN_ALLOWED_DATE;
    if (newEnd.isBefore(MIN_ALLOWED_DATE)) newEnd = MIN_ALLOWED_DATE;
    if (newEnd.isAfter(baseDate)) newEnd = baseDate;

    setStart(newStart);
    setEnd(newEnd);
    validateDateRange(newStart, newEnd);
  };

  const handleReset = () => {
    setFromDateError(null);
    setToDateError(null);
    setQuickFilter("custom");
    resetState();
  };

  const validationMessages = [
    fromDateError && getDateErrorMessage("From Date", fromDateError),
    toDateError && getDateErrorMessage("To Date", toDateError),
  ].filter(Boolean);

  return (
    <Box sx={{ width: "100%", mt: 3 }}>
      {/* GLOBAL GRID LAYOUT: Enforces uniform columns across both rows */}
      <Box
        sx={{
          display: "grid",
          gridTemplateColumns: {
            xs: "1fr", // Mobile: 1 Column
            sm: "repeat(2, 1fr)", // Tablet: 2 Columns
            md: permissions?.wholebank ? "repeat(4, 1fr)" : "repeat(3, 1fr)", // Desktop
          },
          gap: 2,
          mb: 2,
        }}
      >
        {/* === ROW 1: General Ledger Inputs === */}
        {permissions?.wholebank && (
          <Box>
            <TextField
              label="GLCC (Optional)"
              fullWidth
              value={glcc}
              placeholder="Enter 18 Characters GLCC"
              InputLabelProps={{ shrink: true }}
              inputProps={{ maxLength: 18 }}
              onChange={(e) => {
                const value = e.target.value.toUpperCase();
                setGlcc(value);
                setGlccValidated(false);
                setBranch("");
                setCurrency("");
                setCgl("");
                if (value.length === 18) validateGlcc(value);
              }}
            />
          </Box>
        )}

        <Autocomplete
          disabled={
            glccValidated ||
            (!permissions?.wholebank &&
              (user?.isCircle === false || permissions?.branch))
          }
          value={branch}
          forcePopupIcon={false}
          clearIcon={branchInput ? undefined : null}
          options={branches || []}
          noOptionsText={
            req.branch ? "Please enter at least 3 characters" : "No Options"
          }
          inputValue={branchInput}
          loading={!req.branch && loading.branch}
          onInputChange={(e, value, reason) => {
            setBranchInput(value);
            handleSearchChange(value, reason, "branch");
          }}
          onChange={(e, value) => setBranch(value)}
          renderInput={(params) => (
            <TextField
              {...params}
              label="Branch Code or Name*"
              fullWidth
              InputLabelProps={{ shrink: true }}
              placeholder="eg. 12345 or ABC"
              slotProps={{
                htmlInput: {
                  ...params.inputProps,
                  maxLength: isNumeric(params.inputProps.value) ? 5 : 15,
                },
              }}
            />
          )}
        />

        <Autocomplete
          disabled={glccValidated}
          options={currencies || []}
          value={currencies?.find((c) => c.currencyCode === currency) || null}
          getOptionLabel={(option) =>
            option ? `${option.currencyCode} - ${option.currencyName}` : ""
          }
          onChange={(event, newValue) =>
            setCurrency(newValue ? newValue.currencyCode : "")
          }
          onOpen={fetchCurrencies}
          renderInput={(params) => (
            <TextField
              {...params}
              label="Currency*"
              fullWidth
              InputLabelProps={{ shrink: true }}
              placeholder={!currency ? "Please select Currency" : ""}
            />
          )}
        />

        <Autocomplete
          disabled={glccValidated}
          forcePopupIcon={false}
          autoHighlight
          value={cgl}
          options={cgls}
          inputValue={cglInput}
          clearIcon={cglInput || cgl ? undefined : null}
          noOptionsText={
            cglInput.length < 3
              ? "Please enter at least 3 characters"
              : "No Options"
          }
          loading={!req.cgl && loading.cgl}
          onInputChange={(e, value, reason) => {
            setCglInput(value);
            handleSearchChange(value, reason, "cgl");
          }}
          onChange={(e, value) => setCgl(value)}
          renderInput={(params) => (
            <TextField
              {...params}
              label="CGL*"
              fullWidth
              InputLabelProps={{ shrink: true }}
              placeholder="eg. 9999999999"
              slotProps={{
                htmlInput: {
                  ...params.inputProps,
                  maxLength: isNumeric(params.inputProps.value) ? 10 : 30,
                },
              }}
            />
          )}
        />
      </Box>

      {/* === ROW 2: Date Filters & Actions === */}
      <LocalizationProvider dateAdapter={AdapterDayjs}>
        <Box
          sx={{
            display: "grid",
            mt: 3,
            mb: 0.5,
            gridTemplateColumns: {
              xs: "1fr",
              sm: "repeat(2, 1fr)",
              md: "repeat(4, 1fr)",
            },
            gap: 2,
            alignItems: "start",
          }}
        >
          <TextField
            select
            label="Date Range"
            value={quickFilter}
            onChange={handleQuickFilter}
            InputLabelProps={{ shrink: true }}
            fullWidth
          >
            {availableFilters.map((opt) => (
              <MenuItem key={opt.value} value={opt.value}>
                {opt.label}
              </MenuItem>
            ))}
          </TextField>

          <DatePicker
            value={start}
            format="DD-MM-YYYY"
            minDate={MIN_ALLOWED_DATE}
            maxDate={etlDate}
            disableHighlightToday
            onChange={(value) => {
              setStart(value);
              setQuickFilter("custom"); // Revert on manual change
              if (end) validateDateRange(value, end);
            }}
            onError={(error) => setFromDateError(error)}
            slotProps={{
              textField: {
                label: "From Date*",
                InputLabelProps: { shrink: true },
                placeholder: "DD-MM-YYYY",
                error: !!fromDateError,
                fullWidth: true,
              },
            }}
          />

          <DatePicker
            value={end}
            format="DD-MM-YYYY"
            minDate={start || MIN_ALLOWED_DATE}
            maxDate={etlDate}
            disableHighlightToday
            disabled={!start}
            onChange={(value) => {
              setEnd(value);
              setQuickFilter("custom"); // Revert on manual change
              if (start) validateDateRange(start, value);
            }}
            onError={(error) => setToDateError(error)}
            slotProps={{
              textField: {
                label: "To Date*",
                InputLabelProps: { shrink: true },
                placeholder: "DD-MM-YYYY",
                error: !!toDateError,
                fullWidth: true,
              },
            }}
          />

          {/* Action Buttons Container */}
          <Box
            sx={{
              display: "flex",
              justifyContent: { xs: "stretch", sm: "flex-end" },
              gap: 1.5,
              height: "100%",
              alignItems: "center",
            }}
          >
            <StyledButton
              variant="contained"
              startIcon={<RestartAltIcon />}
              onClick={handleReset}
              sx={{ flex: { xs: 1, sm: "unset" } }}
            >
              Reset
            </StyledButton>
            <StyledButton
              variant="contained"
              startIcon={<SearchIcon />}
              disabled={
                !(cgl && currency && branch && start && end) ||
                fromDateError ||
                toDateError
              }
              onClick={handleSubmit}
              sx={{ flex: { xs: 1, sm: "unset" } }}
            >
              Search
            </StyledButton>
          </Box>
        </Box>
      </LocalizationProvider>

      {/* Validation Message Render */}
      {validationMessages.length > 0 && (
        <Box
          sx={{
            mt: 2,
            p: 1.5,
            borderRadius: 2,
            border: "1px solid #ff4d4f",
            bgcolor: "#fff1f0",
          }}
        >
          <Stack spacing={0.5}>
            {validationMessages.map((msg, index) => (
              <Typography
                key={index}
                variant="body2"
                sx={{ color: "#d32f2f", fontWeight: 600 }}
              >
                • {msg}
              </Typography>
            ))}
          </Stack>
        </Box>
      )}
    </Box>
  );
}


import React, { useState, useCallback, useMemo, useEffect } from "react";
import {
  Card,
  CardContent,
  TextField,
  Button,
  Autocomplete,
  Checkbox,
  Typography,
  Stack,
  Box,
  IconButton,
  Grid,
  InputAdornment,
  Paper,
  Collapse,
  Chip,
  ToggleButton,
  ToggleButtonGroup,
} from "@mui/material";
import { DatePicker } from "@mui/x-date-pickers";

// Icons
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SearchIcon from "@mui/icons-material/Search";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import DeleteSweepIcon from "@mui/icons-material/DeleteSweep";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import DateRangeIcon from "@mui/icons-material/DateRange";
import SummarizeIcon from "@mui/icons-material/Summarize";

// Utilities & Hooks
import { debounce } from "lodash";
import useApi from "../../../hooks/useApi";
import CustomChip from "../../../utils/CustomChip";

const BalanceLedgerForm = ({
  filters,
  onFilterChange,
  onReset,
  onFetch,
  permissions,
  user,
  circles,
  currencies,
  FOREIGN_CIRCLE_CODE,
  CIRCLE_GROUPS,
  minLimit,
  maxLimit,
  fetchLoading,
}) => {
  const { callApi } = useApi();
  const { hasWholeBank, hasCircle } = permissions;
  const [branchSearch, setBranchSearch] = useState(null);
  const [branches, setBranches] = useState([]);
  const [cgls, setCgls] = useState(["All CGLs"]);
  const [loading, setLoading] = useState({
    branch: false,
    cgl: false,
    currency: false,
  });
  const [viewList, setViewList] = useState(null);
  const [balanceDateError, setBalanceDateError] = useState(null);
  const [currencyOptions, setCurrencyOptions] = useState([
    "All Currencies",
    ...(currencies || []),
  ]);

  useEffect(() => {
    setCurrencyOptions(["All Currencies", ...(currencies || [])]);
  }, [currencies]);

  const isCircleVisible = !!hasWholeBank;
  const isBranchVisible =
    !permissions.hasWholeBank || filters.enquiryType === "COLLATION";

  const branch = filters.branches || [];
  const hasSelectedBranches = !branch.includes("ALL") && branch.length > 0;

  const cgl = filters.cgl || [];
  const hasSelectedCgls = !cgl.includes("All CGLs") && cgl.length > 0;

  const currency = filters.currencies || [];
  const hasSelectedCurrencies =
    !currency.includes("All Currencies") && currency.length > 0;

  const searchLogic = useCallback(
    async (type, term) => {
      if (!term || term.length < 3) return;
      try {
        setLoading((p) => ({ ...p, [type]: true }));
        let cp = "";

        if (hasWholeBank) {
          if (
            filters.circle !== CIRCLE_GROUPS.ALL &&
            filters.circle !== CIRCLE_GROUPS.DOMESTIC &&
            filters.circle !== CIRCLE_GROUPS.FOREIGN
          ) {
            cp = `&circleCode=${filters.circle}`;
          } else if (filters.circle === CIRCLE_GROUPS.FOREIGN) {
            cp = `&circleCode=${FOREIGN_CIRCLE_CODE}`;
          } else if (filters.circle === CIRCLE_GROUPS.DOMESTIC) {
            cp = `&circleCode=${CIRCLE_GROUPS.DOMESTIC}`;
          } else {
            cp = `&circleCode=${CIRCLE_GROUPS.ALL}`;
          }
        } else if (!hasWholeBank) {
          cp = `&circleCode=${user.circleCode}`;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(term)}${cp}`
            : type === "cgl"
              ? `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`
              : `/CM/common-master/currency-code-name-only?q=${encodeURIComponent(term)}`;

        const res = await callApi(url, null, "GET");

        if (res?.data) {
          let opts = [];
          if (type === "branch") {
            opts = res.data.map((i) => `${i.code}-${i.name}`);
            setBranches(opts);
          } else if (type === "cgl") {
            opts = res.data.map((i) => `${i.cglNumber} - ${i.description}`);
            setCgls(opts);
          } else if (type === "currency") {
            opts = res.data.map((i) => `${i.currencyCode} (${i.currencyName})`);
            setCurrencyOptions(opts);
          }
        }
      } catch (e) {
        console.error(e);
      } finally {
        setLoading((p) => ({ ...p, [type]: false }));
      }
    },
    [
      hasWholeBank,
      callApi,
      filters.circle,
      CIRCLE_GROUPS.ALL,
      CIRCLE_GROUPS.DOMESTIC,
      CIRCLE_GROUPS.FOREIGN,
      FOREIGN_CIRCLE_CODE,
      user.circleCode,
    ],
  );

  const fetchSearchData = useMemo(
    () => debounce((t, v) => searchLogic(t, v), 300),
    [searchLogic],
  );

  useEffect(() => () => fetchSearchData.cancel(), [fetchSearchData]);

  const handleBranchChange = (val) => {
    const clickedAll = val.includes("ALL") && !filters.branches.includes("ALL");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("branches", ["ALL"]);
      setViewList(null);
      return;
    }

    const valWithoutAll = val.filter((v) => v !== "ALL");
    onFilterChange("branches", valWithoutAll);
  };

  const removeBranch = (branchToRemove) => {
    const updated = filters.branches.filter((b) => b !== branchToRemove);

    if (updated.length === 0) {
      onFilterChange("branches", ["ALL"]);
      setViewList(null);
    } else {
      onFilterChange("branches", updated);
    }
  };

  const handleCglChange = (val) => {
    const clickedAll =
      val.includes("All CGLs") && !filters.cgl.includes("All CGLs");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
      return;
    }

    onFilterChange(
      "cgl",
      val.filter((v) => v !== "All CGLs"),
    );
  };

  const removeCgl = (item) => {
    const updated = filters.cgl.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
    } else {
      onFilterChange("cgl", updated);
    }
  };

  const handleCurrencyChange = (val) => {
    const clickedAll =
      val.includes("All Currencies") &&
      !filters.currencies.includes("All Currencies");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("currencies", ["All Currencies"]);
      setViewList(null);
      return;
    }

    onFilterChange(
      "currencies",
      val.filter((v) => v !== "All Currencies"),
    );
  };

  const removeCurrency = (item) => {
    const updated = filters.currencies.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("currencies", ["All Currencies"]);
      setViewList(null);
    } else {
      onFilterChange("currencies", updated);
    }
  };

  const handleCircleChange = (value) => {
    onFilterChange("branches", ["ALL"]);
    setBranches([]);
    setViewList(null);
    onFilterChange("circle", value?.value || CIRCLE_GROUPS.ALL);
  };

  const SectionHeader = ({ icon, title }) => (
    <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 2 }}>
      <Box
        sx={{
          p: 0.5,
          bgcolor: "primary.main",
          borderRadius: 1,
          color: "white",
          display: "flex",
        }}
      >
        {icon}
      </Box>
      <Typography
        variant="subtitle2"
        sx={{ fontWeight: 800, color: "text.primary", letterSpacing: 1 }}
      >
        {title}
      </Typography>
    </Stack>
  );

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "maxDate":
        return `${field} cannot be in future`;
      case "minDate":
        return `${field} cannot be before ${minLimit.format("DD/MM/YYYY")}`;
      case "invalidDate":
        return `Please enter a valid ${field}`;
      default:
        return "";
    }
  };

  const validationMessages = [
    balanceDateError && getDateErrorMessage("Balance Date", balanceDateError),
  ].filter(Boolean);

  return (
    <Box sx={{ position: "relative", mb: 2 }}>
      <Card
        sx={{
          borderRadius: "24px",
          boxShadow: "0 20px 50px rgba(0,0,0,0.1)",
          border: "1px solid rgba(255,255,255,0.3)",
        }}
      >
        <CardContent sx={{ p: { xs: 2, sm: 3, md: 4 } }}>
          {/* UPDATED HEADER: Responsive stacking to prevent overlap on mobile */}
          <Stack
            direction={{ xs: "column", lg: "row" }}
            justifyContent="space-between"
            alignItems={{ xs: "flex-start", lg: "center" }}
            spacing={{ xs: 3, lg: 0 }}
            sx={{ mb: 2 }}
          >
            <Box>
              <Typography
                variant="h4"
                sx={{
                  fontWeight: 900,
                  // fontSize: { xs: "1.75rem", md: "2.125rem" },
                }}
              >
                Ledger Balance Insights
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Ledger Balance search and analysis
              </Typography>
            </Box>

            {permissions.hasWholeBank && (
              <Paper
                elevation={3}
                sx={{
                  px: { xs: 2, sm: 4 },
                  py: 1,
                  borderRadius: "50px",
                  display: "flex",
                  flexDirection: { xs: "column", sm: "row" },
                  alignItems: "center",
                  gap: { xs: 1.5, sm: 3 },
                  border: "1px solid #ffffff77",
                  bgcolor: "#bba7da4f",
                  boxShadow: "0 6px 18px rgba(0, 0, 0, 0.23)",
                  width: { xs: "100%", sm: "auto" },
                  boxSizing: "border-box",
                }}
              >
                <Stack direction="row" spacing={1} alignItems="center">
                  <SummarizeIcon sx={{ color: "#58469f" }} />
                  <Typography
                    variant="subtitle1"
                    sx={{ fontWeight: 900, color: "#333" }}
                  >
                    Switch Enquiry Type
                  </Typography>
                </Stack>

                <ToggleButtonGroup
                  exclusive
                  size="small"
                  value={filters.enquiryType}
                  onChange={(_, value) => {
                    if (value) {
