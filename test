/**
 * ViewRequestDialog
 *
 * This dialog displays the details of a request dynamically.
 * Rendering is optimized using useMemo to avoid repeated computations.
 */

import React, { useMemo } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Typography,
  Grid,
  Box,
  Divider,
  IconButton,
  Stack,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";

import {
  timeStampFormatter,
  toPascalKebabCase,
  formatKeyForDisplay,
} from "../../utils/CommonUtilities";

import { ViewCommonDynamicTable } from "./ViewCommonDynamicTable";

const ViewRequestDialog = ({
  open,
  handleClose,
  data,
  screenConfig,
  handleDownload,
}) => {
  // If no data or payload exists, do not render dialog.
  if (!data || !data.payload) return null;

  const { payload = {} } = data;
  const tableColumns = screenConfig?.columns || [];

  /**
   * ==========================================================
   * Request Metadata (Memoized)
   * ==========================================================
   * Static fields displayed at the top of the dialog.
   * Sizes adjusted to whole numbers to fit MUI's 12-column grid.
   */
  const mainDetails = useMemo(() => [
    {
      label: "Creator ID",
      value: data.creatorId,
      size: 3, 
    },
    {
      label: "Request Type",
      value: data.changeType === "ADD" ? "Added" : "Modified",
      size: 3,
    },
    {
      label: "Request Status",
      value: data.reqStatus === "QUEUE" ? "In Queue" : toPascalKebabCase(data.reqStatus),
      size: 3,
    },
    {
      label: "Requested Date",
      value: timeStampFormatter(data.reqDate),
      size: 3,
    },
  ], [data]);

  /**
   * ==========================================================
   * Dynamic Payload Fields (Memoized)
   * ==========================================================
   * Filter out system keys that should not be displayed
   */
  const dynamicFields = useMemo(() => {
    return Object.entries(payload).filter(
      ([key]) => !["ShowCustomTable", "summaryData", "ShowDownload"].includes(key)
    );
  }, [payload]);

  /**
   * ==========================================================
   * Conditional Rendering Flags
   * ==========================================================
   */
  const showTable = payload?.ShowCustomTable && (tableColumns.length > 0 || payload?.summaryData?.data?.length > 0);
  const showDownload = payload?.ShowDownload;
  const showActions = showDownload;

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="md" fullWidth>
      {/* --- Dialog Header --- */}
      <DialogTitle
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          pr: 1,
        }}
      >
        <Typography variant="h6" fontWeight={700}>
          Request Details — <b>ID: {data.id}</b>
        </Typography>
        <IconButton onClick={handleClose} size="small">
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      <Divider />

      {/* --- Dialog Content --- */}
      <DialogContent sx={{ pt: 3 }}>
        
        {/* Request Metadata Section */}
        <Grid container spacing={2}>
          {mainDetails.map((item) => (
            <Grid item xs={12} sm={6} md={item.size} key={item.label}>
              <Stack spacing={0.5}>
                <Typography variant="subtitle2" sx={{ fontWeight: 700, color: "text.secondary" }}>
                  {item.label}
                </Typography>
                <Typography variant="body1">{item.value ?? "N/A"}</Typography>
              </Stack>
            </Grid>
          ))}
        </Grid>

        {dynamicFields.length > 0 && <Divider sx={{ my: 2 }} />}

        {/* Dynamic Payload Fields Section */}
        {dynamicFields.length > 0 && (
          <Grid container spacing={2}>
            {dynamicFields.map(([key, value]) => (
              <Grid item xs={12} sm={6} md={4} key={key}>
                <Box>
                  <Typography
                    variant="subtitle2"
                    sx={{
                      fontWeight: 700,
                      color: "text.secondary",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                    }}
                  >
                    {formatKeyForDisplay(key)}
                  </Typography>
                  <Typography variant="body1" sx={{ wordBreak: "break-word" }}>
                    {String(value ?? "N/A")}
                  </Typography>
                </Box>
              </Grid>
            ))}
          </Grid>
        )}

        {/* Dynamic Table Section */}
        {showTable && (
          <>
            <Divider sx={{ my: 2 }} />
            <ViewCommonDynamicTable data={payload} />
          </>
        )}
      </DialogContent>

      {/* --- Dialog Actions --- */}
      {showActions && (
        <>
          <Divider />
          <DialogActions sx={{ justifyContent: "center", p: 2 }}>
            {showDownload && (
              <Button
                onClick={handleDownload}
                variant="contained"
                sx={{ textTransform: "none", borderRadius: 2, px: 3 }}
              >
                Download
              </Button>
            )}
          </DialogActions>
        </>
      )}
    </Dialog>
  );
};

export default ViewRequestDialog;
