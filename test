// import styled from "@emotion/styled";
import { useEffect, useState, useCallback } from "react";
import {
  Box,
  Button,
  Stack,
  FormControl,
  Typography,
  Paper,
  Autocomplete,
  TextField,
  Grid,
} from "@mui/material";
import useApi from "../../hooks/useApi";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import { getPermissions } from "../../utils/CommonUtilities";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import SearchIcon from "@mui/icons-material/Search";
import dayjs from "dayjs";

const AsciiReport = (req, isNumeric) => {
  const { callApi } = useApi();
  const [reportDate, setReportDate] = useState(dayjs("30-0-2026"));
  const [asciiId, setAsciiId] = useState("");
  const [searchBy, setSearchBy] = useState("bank");
  const [branchInput, setBranchInput] = useState("");
  const [selectedBranchCode, setSelectedBranchCode] = useState("");

  const [asciiOptions, setAsciiOptions] = useState([]);
  const [branchOptions, setBranchOptions] = useState([]);

  const [plainTextData, setPlainTextData] = useState("");
  const [loading, setLoading] = useState(false);
  const [fieldloading, setFieldLoading] = useState({
    ascii: false,
    branch: false,
  });
  const [error, setError] = useState("");
  const user = useSelector((state) => state.auth.user);
  console.log(user);
  console.log(user.branch);
  const selectedMenu = useSelector((state) => state.menus.selectedMenuItem);
  console.log(selectedMenu);
  const permissions = getPermissions(selectedMenu);
  const showSnackBar = useCustomSnackbar();
  useEffect(() => {
    const fetchInitialData = async () => {
      try {
        const fileTypesRes = await callApi("/RS/ascii/file-types", null, "GET");
        if (fileTypesRes && Array.isArray(fileTypesRes.data)) {
          setAsciiOptions(fileTypesRes.data);
        } else {
          setAsciiOptions;
        }

        if (error) {
          Object.keys(error);
        }
      } catch (err) {
        console.log("Error loading data", err);
      }
    };
    fetchInitialData();
    // fileTypesRes();
  }, [callApi]);

  const fetchSearchData = useCallback(
    async (type, term) => {
      try {
        // setLoading((prev) => ({ ...prev, [type]: true }));
        setFieldLoading((prev) => ({ ...prev, [type]: true }));

        // Permissions logic for Circle/WholeBank
        let circleValue = "";
        if (permissions?.wholebank === true) {
          // circleValue = "null";
        } else if (user?.isCircle === "Y" || permissions?.circle) {
          circleValue = user?.circleCode;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
                term,
              )}&circleCode=${circleValue || ""}`
            : "";

        const result = await callApi(url, null, "GET");

        if (result && result.data && result.data.length > 0) {
          if (type === "branch") {
            const normlized = result.data.map((b) => ({
              branchCode: b.code,
              branchName: b.name,
            }));

            setBranchOptions(normlized);
            console.log(
              "setBranchOptions(result.data)",
              setBranchOptions(normlized),
            );
          }
          // else {
          //   setAsciiOptions(result.data);
          // }
        } else {
          if (type === "branch") {
            setBranchOptions([]);
          }
          showSnackBar("Data is not available");
        }
      } catch (e) {
        console.error(e);
      } finally {
        // setLoading((prev) => ({ ...prev, [type]: false }));
        setFieldLoading((prev) => ({ ...prev, [type]: false }));
      }
    },
    [callApi],
  );

  const handleSearchChange = (value, reason, type) => {
    setFieldLoading((prev) => ({ ...prev, [type]: true }));
    if (reason === "input") {
      // Fires instantly as soon as the 3rd character is typed
      if (value && value?.length >= 3) {
        fetchSearchData(type, value);
      }
    } else if (reason === "clear") {
      // Optional: Clear the options when the user clears the input
      if (type === "branch") {
        setBranchOptions([]);
        setSelectedBranchCode("");
      } else {
        // setAsciiOptions([]);
        setAsciiId("");
      }
      showSnackBar("Data is not available");
    }
    setFieldLoading((prev) => ({ ...prev, [type]: false }));
  };

  const buildPayload = () => {
    const basePayload = {
      id: Number(asciiId),
      reportDate: reportDate ? reportDate.format("DD-MM-YYYY") : "",
      searchBy: searchBy,
    };
    if (searchBy === "branch") {
      basePayload.branchCode = selectedBranchCode || branchInput;
    }

    return basePayload;
  };

  const handleSearchFetch = async (e) => {
    e.preventDefault();
    if (searchBy === "branch" && !branchInput) {
      setError("please select or enter a branch code.");
      return;
    }
    if (!reportDate || !asciiId) {
      setError("Please select both Date and ASCII report type.");
      return;
    }
    if (searchBy === "branch" && !branchInput) {
      setError("Please select or enter branch code.");
      return;
    }

    try {
      setLoading(true);
      setError("");
      setPlainTextData("");

      const payload = buildPayload();
      console.log("payload", payload);
      const response = await callApi("/RS/ascii/view", payload, "POST");
      if (response && response.data && response.data.content) {
        setPlainTextData(response.data.content);
        showSnackBar("Report Fetched Succssefully", "success");
      } else if (response && response.content) {
        setPlainTextData(response.content);
        showSnackBar("Report Fetched Succssefully", "success");
      } else {
        setError("Report content is empty or invalid.");
      }
      showSnackBar("Report Fetched Succssefully.", "success");
    } catch (err) {
      setError("ASCII file not found");
      showSnackBar("ASCII file not found", "error");
    } finally {
      setLoading(false);
    }
  };

  const handleDownload = async () => {
    try {
      setLoading(true);
      const payload = buildPayload();
      console.log("payload", JSON.stringify(payload, null, 2));
      const response = await callApi(
        "/RS/ascii/download",
        payload,
        "POST",
        "text",
        "application/json",
        {
          responseType: "text",
        },
        false,
      );
      console.log("FUll RESPONSE", response);
      console.log("RESPONSE TYPE", typeof response);
      console.log(
        "RESPONSE KEYS",
        response ? Object.keys(response) : "null/undefined",
      );
      const contentDisposition = response?.headers?.["content-disposition"];
      console.log("contentDisposition", contentDisposition);
      const actualData = response.data;
      console.log("actualData", actualData);
      let fileName = "";

      if (contentDisposition) {
        const match = contentDisposition.match(
          /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/,
        );
        if (match) {
          fileName = match[1].replace(/['"\\]/g, "").trim();
        }
      }

      console.log("fileName", fileName);
      if (!fileName) {
        const formatedDate =
          reportDate && typeof reportDate === "string"
            ? reportDate.split("-").reverse().join("")
            : "";

        fileName = `${asciiId || "data"}.${formatedDate || "data"}.${
          formatedDate || "data"
        }.txt`;
      }

      const blob = new Blob([actualData], {
        type: "text/plain;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
      showSnackBar("File Download Successfully", "success");
    } catch (err) {
      // alert("Error downloading the file:" + err.message);
      showSnackBar("ASCII file not found", "error");
    } finally {
      setLoading(false);
    }
  };

  const handleBranchChange = (e) => {
    const val = e.target.value;
    setBranchInput(val);

    const matchedBranch = branchOptions.find(
      (b) =>
        b.branchCode === val || `${b.branchCode} - ${b.branchName}` === val,
    );
    if (matchedBranch) {
      setSelectedBranchCode(matchedBranch.branchCode);
    }
  };
  const handleReset = () => {
    setPlainTextData("");
    setError("");
    setAsciiId("");
    setReportDate(null);
    setBranchInput("");
    setSelectedBranchCode("");
    setSearchBy("bank");
  };
  return (
    <Box>
      <Box>
        <Paper
          sx={{
            padding: "2%",
            mb: 3,
            bgcolor: "rgba(255, 255, 255, 0.4)",
            backdropFilter: "blur(4px)",
            border: "1px solid",
            borderColor: "divider",
            borderRadius: 1,
          }}
        >
          <Box
            sx={{
              mb: 3,
              p: 2,
              borderRadius: 2,
              bgcolor: "background.paper",
              boxShadow: 2,
              borderLeft: "6px solid",
              borderColor: "primary.main",
            }}
          >
            <Stack
              direction="row"
              alignItems="center"
              justifyContent="space-between"
            >
              <Stack direction="row" spacing={2} alignItems="center">
                {/* <AccountSuspensionIcon color="primary" fontSize="large" /> */}

                <Box>
                  <Typography variant="h6" fontWeight={700} lineHeight={1.2}>
                    Search ASCII Report
                  </Typography>
                  <Typography
                    variant="body2"
                    color="text.secondary"
                    sx={{ mt: 0.5 }}
                  >
                    Enter the required details below to retrieve and view ASCII
                    report records.
                  </Typography>
                </Box>
              </Stack>
            </Stack>
          </Box>
          <form onSubmit={handleSearchFetch}>
            <Box sx={{ display: "flex" }}>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <Grid xs={12} md={2} size={2}>
                  <label>Date</label>
                  {/* <br></br> */}
                  {/* <input
              type="date"
              value={reportDate}
              onChange={(e) => setReportDate(e.target.value)}
              required
            /> */}

                  <DatePicker
                    value={reportDate || dayjs()}
                    onChange={(newValue) => setReportDate(newValue)}
                    format={"DD-MM-YYYY"}
                    // disabled={!!plainTextData}
                    slotProps={{
                      textField: {
                        readOnly: false,
                        sx: {
                          width: "395px",
                          flexGrow: 1,
                          "& .MuiInputBase-input": {
                            caretColor: "transparent",
                          },
                        },
                      },
                    }}
                  />
                </Grid>
              </LocalizationProvider>{" "}
              &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;
              <Grid xs={12} md={2} lg={4} size={2} width={"30%"}>
                <label>Name of ASCII</label>
                <Autocomplete
                  options={asciiOptions || []}
                  getOptionLabel={(option) =>
                    option
                      ? `${option.setAsciiId || ""} ${option.asciiName || ""}`
                      : ""
                  }
                  value={
                    asciiOptions.find(
                      (o) => String(o.id) === String(asciiId),
                    ) || null
                  }
                  onChange={(event, newValue) => {
                    // setAsciiId(newValue ? String(newValue.id) : "");
                    if (!newValue) {
                      setAsciiId("");
                    } else {
                      setAsciiId(String(newValue.id));
                    }
                  }}
                  onInputChange={(event, newInputValue, reason) => {
                    handleSearchChange(newInputValue, reason, "ascii");
                  }}
                  // disabled={!!plainTextData}
                  renderInput={(params) => (
                    <TextField
                      {...params}
                      placeholder="Please select ASCII"
                      aria-errormessage=". 1232 or ABC"
                    />
                  )}
                />
              </Grid>
              &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;
              <Grid xs={12} md={2} lg={4} width={"50%"}>
                <Typography>Search By</Typography>
                {/* <Stack direction="column"> */}
                <Box sx={{ display: "flex" }}>
                  <Box>
                    <label>
                      <input
                        type="radio"
                        name="searchBy"
                        value="bank"
                        checked={searchBy === "bank"}
                        onChange={() => setSearchBy("bank")}
                      />
                      &nbsp;&nbsp;&nbsp; Bank
                    </label>
                    <br></br>
                    <label>
                      <input
                        type="radio"
                        name="searchBy"
                        value="branch"
                        checked={searchBy === "branch"}
                        onChange={() => setSearchBy("branch")}
                        disabled={!!plainTextData}
                      />
                      &nbsp;&nbsp;&nbsp; Branch
                    </label>
                    &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;
                  </Box>
                  <Box>
                    {/* </Stack> */}
                    {searchBy === "branch" && (
                      <Box sx={{}}>
                        {/* <Typography component="label" variant="body2">
                    Branch
                  </Typography> */}
                        <Autocomplete
                          sx={{ width: "20vw" }}
                          options={branchOptions || []}
                          getOptionLabel={(option) =>
                            option
                              ? `${option.branchName || ""} -${
                                  option.branchCode || ""
                                }`
                              : ""
                          }
                          value={
                            branchOptions.find(
                              (b) => b.branchCode === selectedBranchCode,
                            ) || null
                          }
                          disabled={
                            !permissions?.wholebank &&
                            (user?.isCircle === "N" || permissions?.branch)
                          }
                          onInputChange={(e, newInputValue, reason) => {
                            setBranchInput(newInputValue);
                            handleSearchChange(newInputValue, reason, "branch");
                          }}
                          onChange={(e, selectedOption) => {
                            if (selectedOption) {
                              setSelectedBranchCode(selectedOption.branchCode);
                              setBranchInput(selectedOption.branchName);
                            } else {
                              setSelectedBranchCode("");
                              setBranchInput("");
                            }
                          }}
                          renderInput={(params) => (
                            <TextField
                              {...params}
                              placeholder="Type to search branch..."
                              required
                              onChange={handleBranchChange}
                              slotProps={{
                                htmlInput: {
                                  ...params.inputProps,
                                  maxLength: isNumeric ? 5 : 15,
                                },
                              }}
                            />
                          )}
                        />
                      </Box>
                    )}
                  </Box>
                </Box>
              </Grid>
              <Grid xs={12} md={2} lg={2} size={1}>
                <Box
                  sx={{
                    display: "flex",
                    justifyContent: "end",
                    marginTop: 2.5,
                  }}
                >
                  <Button
                    style={styles.btn}
                    type="submit"
                    variant="contained"
                    disabled={loading}
                    // disabled={
                    //   !(
                    //     (reportDate &&
                    //       asciiId &&
                    //       setBranchInput &&
                    //       branchOptions) ||
                    //     branchInput
                    //   )
                    // }
                  >
                    {loading ? "fetching..." : "Search"}
                  </Button>
                  &nbsp; &nbsp;&nbsp;&nbsp;
                  <Button
                    style={styles.btn}
                    variant="contained"
                    onClick={handleReset}
                    disabled={loading}
                  >
                    Reset
                  </Button>
                </Box>
              </Grid>
            </Box>
          </form>
          {/* {error && <p>{error}</p>}? */}
        </Paper>
      </Box>
      <Box>
        <Paper
          sx={{
            p: "1% 2%",
            mb: 2,
            bgcolor: "rgba(255, 255, 255, 0.4)",
            backdropFilter: "blur(4px)",
            border: "1px solid",
            borderColor: "divider",
            borderRadius: 1,
          }}
        >
          <Box
            sx={{
              display: "flex",
              justifyContent: "space-between",
              height: "7vh",
              borderBottom: "1px solid #fff",
            }}
          >
            <Typography
              variant="h6"
              fontWeight={700}
              lineHeight={1.2}
              sx={{ p: "1% 0%" }}
            >
              View ASCII Report data
            </Typography>
            {plainTextData && (
              <Button
                style={styles.download}
                onClick={handleDownload}
                variant="contained"
                sx={{ marginTop: 1 }}
              >
                Download ASCII Report
              </Button>
            )}
          </Box>

          <Box style={styles.pText}>
            {plainTextData ? (
              <pre>{plainTextData}</pre>
            ) : (
              <Box sx={{ display: "flex", justifyContent: "center" }}>
                <p>
                  <SearchIcon sx={{ fontSize: "3rem", marginLeft: "50%" }} />

                  <br></br>
                  {loading
                    ? "Retrieving report content..."
                    : "No data fetched yet. Fill the form parameter and click search."}
                </p>
              </Box>
            )}
          </Box>
        </Paper>
      </Box>
    </Box>
  );
};

const styles = {
  container: {
    backgroundColor: "rgba(255, 255, 255, 0.15)",
    backdropFilter: "blur(20px)",
    padding: "2%",
    borderRadius: "15px",
    marginBottom: "2%",
    // border: `0.5px solid ${theme.palette.primary.light}`,
  },
  btn: {
    marginTop: 5,
    padding: "8px 40px",
    borderRadius: "10px",
    fontSize: "1rem",
    height: "auto",
    // fontSize: "1rem",
  },
  pText: {
    height: "40vh",
    overflow: "auto",
    marginTop: "10px",
    // display: "flex",
    // justifyContent: "center",
    flexWrap: "wrap",
    // animation-iteration-count: ce;
    alignContent: "center",
  },
  download: {
    marginTop: 2,
    padding: "20px 20px",
    borderRadius: "10px",
    // fontSize: "1rem",
    height: "5vh",
    width: "12vw",
  },
};
export default AsciiReport;
