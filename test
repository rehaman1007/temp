  StyledTableHeaderCell,
  StyledTableBody,
  StyledTableCell,
  StyledTablePagination,
  StyledTypographyBox,
  StyledTypography,
  StyledCloseButton,
  StyledEmptyCell,
} from "./CurrencyRateChangeStyles";
