import { useEffect, useState, useRef, useMemo } from "react";
import { fetchEventSource } from "@microsoft/fetch-event-source";
import { useSelector } from "react-redux";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import ProcessStatusTable from "./components/ProcessStatusTable";
import ProcessDetailsDialog from "./components/ProcessDetailsDialog";
import { resolveConfig } from "../../config/EnvironmentConfig";
import { timeStampFormatter } from "../../utils/CommonUtilities";
import useApi from "../../hooks/useApi";
import {
  Grid,
  Box,
  Button,
  Paper,
  Stack,
  Tooltip,
} from "@mui/material";
import PlayArrowIcon from "@mui/icons-material/PlayArrow";
import TaskAltIcon from "@mui/icons-material/TaskAlt";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import dayjs from "dayjs";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { DatePicker } from "@mui/x-date-pickers/DatePicker";

/* ================= NORMALIZERS ================= */
const normalizeStageDetails = (stageDetails = []) => {
  const map = new Map();

  stageDetails.forEach((s) => {
    const key = s.processStage;
    const existing = map.get(key);
    if (!existing || s.startTime > existing.startTime) {
      map.set(key, s);
    }
  });

  return Array.from(map.values())
    .sort((a, b) => a.processStage - b.processStage)
    .map((s) => ({
      ...s,
      _START_TIME_RAW: s.startTime,
      _END_TIME_RAW: s.endTime,
      startTime: s.startTime ? timeStampFormatter(s.startTime) : null,
      endTime: s.endTime ? timeStampFormatter(s.endTime) : null,
    }));
};

const normalizeProcesses = (data = []) =>
  data.map((p) => ({
    ...p,
    type: p.type ?? p.processType,
    stageDetails: normalizeStageDetails(p.stageDetails),
  }));

const mergeProcesses = (prev = [], incoming = []) => {
  const map = new Map(prev.map((p) => [p.type, p]));
  incoming.forEach((p) => map.set(p.type, p));
  return Array.from(map.values());
};

const ProcessStatusPage = () => {
  const [processes, setProcesses] = useState([]);
  const [selectedProcess, setSelectedProcess] = useState(null);
  const [loading, setLoading] = useState(true);
  const [selectedDate, setSelectedDate] = useState(dayjs());

  const snackbar = useCustomSnackbar();
  const token = useSelector((state) => state.auth.token);
  const { callApi } = useApi();

  const service = resolveConfig("/PS");
  const INITIAL_URL = "/PS/process/processes/data";
  const STREAM_URL = `${service}/process/processes-testing`;

  /* ================= INITIAL LOAD ================= */
  const initialFetchDone = useRef(false);

  useEffect(() => {
    if (initialFetchDone.current) return;
    initialFetchDone.current = true;

    callApi(INITIAL_URL)
      .then((data) => setProcesses(normalizeProcesses(data || [])))
      .catch(() => snackbar("Failed to load processes"))
      .finally(() => setLoading(false));
  }, []);

  /* ================= SSE ================= */
  useEffect(() => {
    if (loading) return;

    const controller = new AbortController();

    fetchEventSource(STREAM_URL, {
      signal: controller.signal,
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: "text/event-stream",
      },
      onmessage(e) {
        if (e.event === "connected") return;
        const raw = JSON.parse(e.data);
        setProcesses((prev) =>
          mergeProcesses(prev, normalizeProcesses(raw))
        );
      },
    });

    return () => controller.abort();
  }, [loading, token]);

  /* ================= DERIVED UI STATES ================= */
  const hasProcesses = processes.length > 0;

  const allCompleted = useMemo(
    () =>
      processes.length > 0 &&
      processes.every((p) =>
        p.stageDetails.every((s) => s.status === 2)
      ),
    [processes]
  );

  const differenceSummary = useMemo(() => {
    const diff = processes.find((p) => p.type === "DIFFERENCE");
    if (!diff) return null;

    const stage7 = diff.stageDetails[6];
    if (stage7?.status === 2 && stage7?.differenceSummary) {
      return stage7.differenceSummary;
    }
    return null;
  }, [processes]);

  return (
    <Paper sx={{ p: 3, minHeight: "75vh" }}>
      {/* ================= TOP CONTROLS ================= */}
      <Stack spacing={3} alignItems="center">
        <LocalizationProvider dateAdapter={AdapterDayjs}>
          <DatePicker
            label="ETL Date"
            value={selectedDate}
            onChange={setSelectedDate}
          />
        </LocalizationProvider>

        <Grid container spacing={2} justifyContent="center">
          <Grid>
            <Tooltip title={hasProcesses ? "EOD already started" : ""}>
              <span>
                <Button
                  variant="contained"
                  size="large"
                  startIcon={<PlayArrowIcon />}
                  disabled={hasProcesses}
                >
                  Start EOD
                </Button>
              </span>
            </Tooltip>
          </Grid>

          <Grid>
            <Tooltip
              title={!allCompleted ? "Processes still running" : ""}
            >
              <span>
                <Button
                  variant="contained"
                  size="large"
                  startIcon={<TaskAltIcon />}
                  disabled={!allCompleted}
                  color="success"
                >
                  Finish EOD
                </Button>
              </span>
            </Tooltip>
          </Grid>

          {differenceSummary && (
            <Grid>
              <Button
                variant="outlined"
                startIcon={<VisibilityOutlinedIcon />}
                onClick={() => {
                  snackbar("Showing difference summary");
                  // open dialog / drawer later
                }}
              >
                View Summary
              </Button>
            </Grid>
          )}
        </Grid>
      </Stack>

      {/* ================= CONTENT ================= */}
      <ProcessDetailsDialog
        process={selectedProcess}
        onClose={() => setSelectedProcess(null)}
      />

      <Box mt={4}>
        <ProcessStatusTable
          loading={loading}
          processes={processes}
          actions={{
            onView: setSelectedProcess,
            onStop: () => {},
            onRestart: () => {},
          }}
        />
      </Box>
    </Paper>
  );
};

export default ProcessStatusPage;