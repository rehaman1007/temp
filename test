    return (
      <Box>
        <Box
          onDragOver={onDragOver}
          onDrop={onDragEnd}
          sx={{
            height: isDropTarget && !isDragging ? 24 : 4,
            bgcolor:
              isDropTarget && !isDragging ? "primary.light" : "transparent",
            borderRadius: 1,
            transition: "all 0.2s",
            display: "flex",
