import { useCallback, useEffect, useState } from "react";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";
import dayjs from "dayjs";
import ReceiptIcon from "@mui/icons-material/Receipt";
import ManageSearchIcon from "@mui/icons-material/ManageSearch";
import LinearProgress from "@mui/material/LinearProgress";

import { Box, Paper, Typography, Stack, Button } from "@mui/material";

import { StyledBox, StyledFormHeader } from "./components/TransactionStyles";

import TransactionFilters from "./components/TransactionFilters";
import TransactionTable from "./components/TransactionTable";
import { areUserInputsValid } from "./utils/InputValidations";
import { useSelector } from "react-redux";

const TransactionEnquiryScreen = () => {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const user = useSelector((state) => state.auth.user);

  const [currencies, setCurrencies] = useState([]);
  const [data, setData] = useState(null);
  const [sourceOptions, setSourceOptions] = useState([]);
  const [etlDate, setEtlDate] = useState(null);
  const [loading, setLoading] = useState(false);
  const [exportLoading, setExportLoading] = useState(false);
  const [searchLoading, setSearchLoading] = useState(false);

  const [filtersExpanded, setFiltersExpanded] = useState(true);
  const [glcc, setGlcc] = useState("");
  const [glccValidated, setGlccValidated] = useState(false);
  const [glccLoading, setGlccLoading] = useState(false);
  const selectedMenu = useSelector((state) => state.menus.selectedMenuItem);

  const [userInputs, setUserInputs] = useState({
    branch:
      user?.isCircle === false
        ? `${String(user?.branch).padStart(5, "0")}-${user.branchName}`
        : "",
    currency: null,
    cgl: "",
    fromDate: null,
    toDate: null,
    minAmount: "",
    maxAmount: "",
    sourceFlags: [],
  });

  const fetchCurrencies = useCallback(async () => {
    const res = await callApi(
      "/CM/common-master/currency-code-name-only",
      null,
      "GET",
    );

    const formattedCurrencies =
      res?.data?.map((c) => `${c.currencyCode} (${c.currencyName})`) || [];

    const sortedCurrencies = formattedCurrencies.sort((a, b) => {
      if (a.startsWith("INR")) return -1;
      if (b.startsWith("INR")) return 1;
      return a.localeCompare(b);
    });

    setCurrencies(sortedCurrencies);
  }, [callApi]);

  const [rowCount, setRowCount] = useState(0);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 25,
    sortIn: "DESC",
  });

  const [sortModel, setSortModel] = useState([]);

  const [filterModel, setFilterModel] = useState({
    items: [],
  });
  const [debouncedFilterModel, setDebouncedFilterModel] = useState({
    items: [],
  });
  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedFilterModel(filterModel);
    }, 500);
    return () => clearTimeout(timer);
  }, [filterModel]);

  const fetchTransactions = useCallback(async () => {
    try {
      if (!areUserInputsValid(userInputs)) return;

      setLoading(true);

      const payload = {
        branch: userInputs?.branch?.split(" (")[0],
        currency: userInputs?.currency?.split(" (")[0],
        cgl: userInputs?.cgl?.split(" - ")[0],
        fromDate: dayjs(userInputs?.fromDate).format("DD/MM/YYYY"),
        toDate: dayjs(userInputs?.toDate).format("DD/MM/YYYY"),
        minAmount: userInputs.minAmount ? Number(userInputs.minAmount) : null,
        maxAmount: userInputs.maxAmount ? Number(userInputs.maxAmount) : null,
        sourceFlags: (userInputs.sourceFlags || []).map((item) => item.flagId),
        page: paginationModel.page,
        size: paginationModel.pageSize,

        sortField: sortModel?.[0]?.field || null,

        sortOrder: sortModel?.[0]?.sort || null,

        gridFilters: debouncedFilterModel.items
          .filter(
            (item) =>
              item.field &&
              item.operator &&
              item.value !== undefined &&
              item.value !== null &&
              item.value !== "",
          )
          .map((item) => ({
            field: item.field,
            operator: item.operator,
            value: item.value,
          })),
      };

      setSearchLoading(true);

      const res = await callApi(
        "/ES/transaction-con/transactions",
        payload,
        "POST",
      );

      if (res?.data?.length > 0) {
        setData(res);
        setFiltersExpanded(false);
        setRowCount(res.totalElements || 0);
      } else {
        setData({
          data: [],
          extraData: null,
        });
        setRowCount(0);
      }
    } catch {
      snackbar(
        "Failed to fetch transactions, Something went wrong Kindly try again after sometime",
        "error",
      );
    } finally {
      setLoading(false);
      setSearchLoading(false);
    }
  }, [
    userInputs,
    callApi,
    paginationModel,
    sortModel,
    debouncedFilterModel,
    snackbar,
  ]);

  const validateGlcc = async (value) => {
    try {
      setGlccLoading(true);

      const res = await callApi(
        "/CM/common-master/validate-glcc",
        { glcc: value },
        "POST",
      );

      const data = res?.data;

      if (data?.valid) {
        setUserInputs((prev) => ({
          ...prev,
          branch: `${data.branchCode}-${data.branchName.trim()}`,
          currency: `${data.currencyCode} (${data.currencyName.trim()})`,
          cgl: `${data.cglNumber} - ${data.cglDescription}`,
        }));

        setGlccValidated(true);
      } else {
        setGlccValidated(false);

        setUserInputs((prev) => ({
          ...prev,
          branch: "",
          currency: null,
          cgl: "",
        }));

        snackbar(data?.errors?.join(", ") || "Invalid GLCC", "error");
      }
    } catch (e) {
      setGlccValidated(false);

      setUserInputs((prev) => ({
        ...prev,
        branch: "",
        currency: null,
        cgl: "",
      }));

      snackbar(
        e?.response?.data?.data?.errors?.join(", ") || "Invalid GLCC",
        "error",
      );
    } finally {
      setGlccLoading(false);
    }
  };

  const handleDownload = async () => {
    try {
      setExportLoading(true);
      const payload = {
        menuId: selectedMenu?.id,
        branch: userInputs?.branch?.split("-")[0].trim(),
        currency: userInputs?.currency?.split(" (")[0],
        cgl: userInputs?.cgl?.split(" -")[0],
        fromDate: dayjs(userInputs?.fromDate).format("DD/MM/YYYY"),
        toDate: dayjs(userInputs?.toDate).format("DD/MM/YYYY"),
        minAmount: userInputs.minAmount ? Number(userInputs.minAmount) : null,
        maxAmount: userInputs.maxAmount ? Number(userInputs.maxAmount) : null,
        sourceFlags: (userInputs.sourceFlags || []).map((item) => item.flagId),
      };

      const downloadResponse = await callApi(
        "/ES/transaction-con/transactions-download",
        payload,
        "POST",
        "arraybuffer",
      );

      const fileName = `GL_Transactions_${payload.cgl}`;
      if (downloadResponse && downloadResponse?.byteLength > 0) {
        downloadFile(downloadResponse, "excel", fileName);
      }
    } finally {
      setExportLoading(false);
    }
  };

  useEffect(() => {
    // if (rowCount > 0) fetchTransactions();
    if (data) {
      fetchTransactions();
    }
  }, [
    paginationModel.page,
    paginationModel.pageSize,
    sortModel,
    debouncedFilterModel,
    // fetchTransactions,
    // rowCount,
  ]);

  const resetState = () => {
    setData(null);
    setRowCount(0);
    setLoading(false);

    // NEW
    setFiltersExpanded(true);
    setGlcc("");
    setGlccValidated(false);

    setUserInputs({
      branch: "",
      currency: null,
      cgl: "",
      fromDate: null,
      toDate: null,
      minAmount: "",
      maxAmount: "",
      sourceFlags: sourceOptions,
    });

    setPaginationModel({
      page: 0,
      pageSize: 25,
      sortIn: "DESC",
    });
  };

  // Date Requirement
  useEffect(() => {
    const fetchSystemDate = async () => {
      try {
        const dateRes = await callApi("/PS/file/fincore-date", {}, "GET");

        const etlRaw = dateRes?.data?.userDate;
        const etl = etlRaw ? dayjs(etlRaw.split("T")[0]) : dayjs();
        // const startDate = dayjs("2026-03-31");

        setEtlDate(etl);
        // setUserInputs((prev) => ({
        //   ...prev,
        //   fromDate: startDate,
        //   toDate: etl,
        // }));
      } catch (e) {
        console.error("System Date Fetch Error:", e);
      }
    };
    fetchSystemDate();
  }, [callApi]);

  useEffect(() => {
    const fetchFlags = async () => {
      try {
        const res = await callApi("/CM/common-master/source-flag", null, "GET");

        const flags = res?.data || [];

        setSourceOptions(flags);

        if (flags.length > 0) {
          setUserInputs((prev) => ({
            ...prev,
            sourceFlags: flags,
          }));
        }
      } catch (e) {
        console.error("Flags error:", e);
      }
    };

    fetchFlags();
  }, [callApi]);

  return (
    <>
      <Box sx={{ p: 1 }}>
        <Paper
          elevation={0}
          sx={{
            p: {
              xs: 1.5,
              sm: 2,
              md: 2.5,
            },
            mt: {
              xs: -1,
              sm: -2,
            },
            mb: 3,
            bgcolor: "rgba(255, 255, 255, 0.4)",
            backdropFilter: "blur(4px)",
            border: "1px solid",
            borderColor: "divider",
            borderRadius: {
              xs: 2,
              sm: 3,
            },
            overflow: "hidden",
          }}
        >
          <Box
            sx={{
              mb: 3,
              p: 1.2,
              borderRadius: 2,
              bgcolor: "background.paper",
              boxShadow: 2,
              borderLeft: "6px solid",
              borderColor: "primary.main",
            }}
          >
            <Stack
              direction={{ xs: "column", sm: "row" }}
              alignItems={{ xs: "flex-start", sm: "center" }}
              justifyContent="space-between"
              spacing={2}
            >
              {/* LEFT */}
              <Stack
                direction="row"
                spacing={{ xs: 1.5, sm: 2 }}
                alignItems="center"
                sx={{ width: "100%" }}
              >
                <ReceiptIcon color="primary" fontSize="medium" />

                <Box sx={{ minWidth: 0 }}>
                  <Typography
                    variant="subtitle1"
                    fontWeight={700}
                    lineHeight={1.2}
                    sx={{
                      fontSize: {
                        xs: "0.95rem",
                        sm: "1rem",
                        md: "1.05rem",
                      },
                    }}
                  >
                    Transaction Search & Records Enquiry
                  </Typography>

                  <Typography
                    variant="body2"
                    color="text.secondary"
                    sx={{ mt: 0.2 }}
                  >
                    Enter the required details below to retrieve and view
                    historical transaction records.
                  </Typography>
                </Box>
              </Stack>

              {/* BUTTON */}
              {data && (
                <Button
                  startIcon={<ManageSearchIcon />}
                  variant="contained"
                  size="small"
                  onClick={() => setFiltersExpanded((prev) => !prev)}
                  sx={{
                    textTransform: "none",
                    borderRadius: "8px",
                    fontWeight: 600,
                    minWidth: {
                      xs: "100%",
                      sm: "140px",
                    },
                    width: {
                      xs: "100%",
                      sm: "auto",
                    },
                    height: {
                      xs: 38,
                      sm: 32,
                    },
                    px: 1.5,
                    fontSize: {
                      xs: "0.8rem",
                      sm: "0.82rem",
                    },
                  }}
                >
                  {filtersExpanded ? "Hide Filters" : "Edit Search"}
                </Button>
              )}
            </Stack>
          </Box>

          {/* SUMMARY CHIPS */}
          {data && !filtersExpanded && (
            <Stack
              direction="row"
              spacing={1}
              sx={{
                mt: 2,
                mb: 1,
                flexWrap: "wrap",
                rowGap: 1,
              }}
            >
              {[
                `Branch: ${userInputs?.branch}`,
                `Currency: ${userInputs?.currency}`,
                `CGL: ${userInputs?.cgl}`,
                `Date: ${dayjs(userInputs?.fromDate).format(
                  "DD MMM YYYY",
                )} - ${dayjs(userInputs?.toDate).format("DD MMM YYYY")}`,
                ...(userInputs?.minAmount || userInputs?.maxAmount
                  ? [
                      `Amount: ${userInputs?.minAmount || 0} - ${
                        userInputs?.maxAmount || "∞"
                      }`,
                    ]
                  : []),
              ].map((item, index) => (
                <Box
                  key={index}
                  sx={{
                    px: { xs: 1.2, sm: 1.5 },
                    py: 0.45,
                    borderRadius: "20px",
                    bgcolor: "rgba(88, 70, 159, 0.08)",
                    border: "1px solid rgba(88, 70, 159, 0.36)",
                    maxWidth: "100%",
                  }}
                >
                  <Typography
                    sx={{
                      fontSize: {
                        xs: "0.68rem",
                        sm: "0.72rem",
                      },
                      fontWeight: 500,
                      color: "#58469f",
                      wordBreak: "break-word",
                    }}
                  >
                    {item}
                  </Typography>
                </Box>
              ))}
            </Stack>
          )}

          {/* FILTERS */}
          {filtersExpanded && (
            <>
              {searchLoading && !data?.data?.length && (
                <LinearProgress
                  sx={{
                    height: 3,
                    borderRadius: 999,
                    mb: 2,
                    bgcolor: "rgba(88,70,159,0.08)",
                    "& .MuiLinearProgress-bar": {
                      bgcolor: "#58469f",
                    },
                  }}
                />
              )}
              <TransactionFilters
                userInputs={userInputs}
                setUserInputs={setUserInputs}
                currencies={currencies}
                fetchCurrencies={fetchCurrencies}
                glcc={glcc}
                setGlcc={setGlcc}
                glccValidated={glccValidated}
                setGlccValidated={setGlccValidated}
                validateGlcc={validateGlcc}
                glccLoading={glccLoading}
                onSubmit={() => {
                  // setFiltersExpanded(false);
                  if (paginationModel.page === 0) {
                    fetchTransactions();
                  } else {
                    setPaginationModel((prev) => ({
                      ...prev,
                      page: 0,
                    }));
                  }
                }}
                resetState={resetState}
                user={user}
                sourceOptions={sourceOptions}
                etlDate={etlDate}
              />
            </>
          )}
        </Paper>

        {data && (
          <TransactionTable
            data={data}
            loading={loading}
            userInputs={userInputs}
            sourceOptions={sourceOptions}
            onDownload={handleDownload}
            rowCount={rowCount}
            paginationModel={paginationModel}
            setPaginationModel={setPaginationModel}
            sortModel={sortModel}
            setSortModel={setSortModel}
            filterModel={filterModel}
            setFilterModel={setFilterModel}
            exportLoading={exportLoading}
          />
        )}
      </Box>
    </>
  );
};

export default TransactionEnquiryScreen;


import React from "react";
import { DataGrid } from "@mui/x-data-grid";
import { Button, Typography, Stack, Box, styled, Grid } from "@mui/material";
import FileDownloadIcon from "@mui/icons-material/FileDownload";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import EventIcon from "@mui/icons-material/Event";
import TrendingUpIcon from "@mui/icons-material/TrendingUp";
import TrendingDownIcon from "@mui/icons-material/TrendingDown";
import { StyledDataBox } from "./TransactionStyles";
import CircularProgress from "@mui/material/CircularProgress";
import CustomChip from "../../../utils/CustomChip";

const OverlayBox = styled(Box)(() => ({
  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" color="action" />
    <Typography variant="h5" fontSize="1.2rem" color="text.secondary">
      No transactions available for the selected criteria
    </Typography>
  </OverlayBox>
);

const TransactionTable = ({
  data,
  loading,
  onDownload,
  rowCount,
  paginationModel,
  setPaginationModel,
  sortModel,
  setSortModel,
  filterModel,
  setFilterModel,
  userInputs,
  sourceOptions,
  exportLoading,
}) => {
  const rows = data?.data || [];
  const balances = data?.extraData || {};

  // =========================================================
  // FRONTEND GUARDRAIL: Check if sort is chronological
  // =========================================================
  // If sortModel is empty, the backend defaults to Date ASC.
  const isChronologicalSort =
    !sortModel ||
    sortModel.length === 0 ||
    sortModel[0]?.field === "date" ||
    sortModel[0]?.field === "postDate";

  // Hide the top summary cards if not sorted chronologically
  const showBalances =
    userInputs?.sourceFlags?.length === sourceOptions?.length &&
    !userInputs?.minAmount &&
    !userInputs?.maxAmount &&
    rows.length > 0 &&
    isChronologicalSort; // <-- Appended check here

  const transactionColumns = [
    {
      field: "date",
      headerName: "Date",
      flex: 0.5,
      minWidth: 120,
      filterable: false,
    },
    {
      field: "batchId",
      headerName: "Batch Id",
      flex: 0.5,
      minWidth: 100,
      filterable: true,
      valueFormatter: (value) => (value == null ? "-" : value),
    },
    {
      field: "journalNumber",
      headerName: "Journal No.",
      flex: 0.8,
      minWidth: 150,
      filterable: true,
      valueFormatter: (value) => (value == null ? "-" : value),
    },
    {
      field: "particulars",
      headerName: "Narration",
      flex: 1.5,
      minWidth: 180,
      filterable: true,
    },
    {
      field: "debitAmount",
      headerName: "Debit",
      flex: 1,
      minWidth: 150,
      headerAlign: "left",
      align: "right",
      filterable: false,
      renderCell: (params) => {
        const val = Number(params.value);

        const formattedAmount = new Intl.NumberFormat("en-IN", {
          minimumFractionDigits: 4,
          maximumFractionDigits: 4,
        }).format(Math.abs(val));

        return (
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              justifyContent: "flex-end",
              height: "100%",
              width: "100%",
            }}
          >
            {/* Amount with dynamic color */}
            <Typography variant="body2">{formattedAmount}</Typography>
          </Box>
        );
      },
    },
    {
      field: "creditAmount",
      headerName: "Credit",
      flex: 1,
      minWidth: 150,
      headerAlign: "left",
      align: "right",
      filterable: false,
      renderCell: (params) => {
        const val = Number(params.value);

        const formattedAmount = new Intl.NumberFormat("en-IN", {
          minimumFractionDigits: 4,
          maximumFractionDigits: 4,
        }).format(Math.abs(val));

        return (
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              justifyContent: "flex-end",
              height: "100%",
              width: "100%",
            }}
          >
            {/* Amount with dynamic color */}
            <Typography variant="body2">{formattedAmount}</Typography>
          </Box>
        );
      },
    },
    {
      field: "runningBalance",
      headerName: "Balance",
      flex: 1,
      minWidth: 170,
      headerAlign: "left",
      align: "right",
      sortable: false,
      renderCell: (params) => {
        const val = Number(params.value);

        const formattedAmount = new Intl.NumberFormat("en-IN", {
          minimumFractionDigits: 4,
          maximumFractionDigits: 4,
        }).format(Math.abs(val));

        return (
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              justifyContent: "flex-end",
              height: "100%",
              width: "100%",
            }}
          >
            {/* Amount with dynamic color */}
            <Typography variant="body2" fontWeight="500">
              {formattedAmount}
            </Typography>
          </Box>
        );
      },
    },
    {
      field: "sourceFlag",
      headerName: "Transaction Type",
      flex: 1.2,
      minWidth: 150,
      filterable: false,
      renderCell: (params) => {
        if (!params.value) return "";
        const source = sourceOptions.find(
          (item) => item.flagId === params.value,
        );
        return source ? source.flagName : params.value;
      },
    },
  ];

  // =========================================================
  // DYNAMIC COLUMNS: Remove "Balance" column if not chronological
  // =========================================================
  const activeColumns = isChronologicalSort
    ? transactionColumns
    : transactionColumns.filter((col) => col.field !== "runningBalance");

  return (
    <StyledDataBox
      sx={{
        mt: 2,
        height: "100%",
        display: "flex",
        flexDirection: "column",
        overflow: "hidden",
      }}
    >
      <Box
        sx={{
          p: { xs: 1, sm: 1.2 },
          mb: 3,
          mt: { xs: 0, sm: -2 },
          borderRadius: "16px",
          background: "rgba(255,255,255,0.1)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255,255,255,0.3)",
          boxShadow: "0 4px 20px rgba(0,0,0,0.03)",
          display: "flex",
          flexDirection: "column",
          gap: 1,
        }}
      >
        <Stack
          direction={{ xs: "column", sm: "row" }}
          justifyContent="space-between"
          alignItems={{ xs: "stretch", sm: "center" }}
          spacing={2}
        >
          <Box
            sx={{
              display: "flex",
              flexWrap: "wrap",
              alignItems: "center",
              gap: 1,
            }}
          >
            <Typography
              sx={{
                fontWeight: 800,
                color: "#1a1a1a",
                letterSpacing: "-0.5px",
                fontSize: {
                  xs: "0.95rem",
                  sm: "1rem",
                  md: "1.05rem",
                },
              }}
            >
              Transaction Ledger
            </Typography>

            <Typography
              variant="caption"
              fontWeight={700}
              sx={{
                color: "#58469f",
                textTransform: "uppercase",
                bgcolor: "rgba(88,70,159,0.1)",
                px: 1.2,
                py: 0.3,
                borderRadius: 1.5,
                fontSize: {
                  xs: "0.6rem",
                  sm: "0.65rem",
                },
              }}
            >
              {rowCount > 0
                ? `${rowCount.toLocaleString()} Records Found`
                : "No Records"}
            </Typography>
          </Box>

          <Button
            variant="contained"
            startIcon={
              exportLoading ? (
                <CircularProgress size={16} color="inherit" />
              ) : (
                <FileDownloadIcon />
              )
            }
            onClick={onDownload}
            disabled={!rowCount || loading || exportLoading}
            sx={{
              width: {
                xs: "100%",
                sm: "auto",
              },
              textTransform: "none",
              bgcolor: "#58469f",
              fontWeight: 700,
              borderRadius: "8px",
              px: 3,
              minHeight: 38,
              boxShadow: "0 4px 12px rgba(88,70,159,0.3)",
              "&:hover": {
                bgcolor: "#45357a",
              },
            }}
          >
            {exportLoading ? "Exporting..." : "Export"}
          </Button>
        </Stack>

        {showBalances && balances && (
          <Grid container spacing={2}>
            {[
              {
                label: "Opening Balance",
                date: balances.openingDate || balances.OpeningDate,
                amt: balances.openingBalance,
                icon: <AccountBalanceWalletIcon />,
              },
              {
                label: "Closing Balance",
                date: balances.closingDate || balances.ClosingDate,
                amt: balances.closingBalance,
                icon: <AccountBalanceWalletIcon />,
              },
            ].map((item, index) => {
              const isNeg = item.amt < 0;
              const indicator = isNeg ? "DR" : "CR";
              const absVal = Math.abs(item.amt || 0).toFixed(4);

              const activeColor = isNeg ? "#b84646f3" : "#427a44";
              const activeBg = isNeg
                ? "linear-gradient(135deg, #fff5f5 0%, #fed7d759 100%)"
                : "linear-gradient(135deg, #f6fdf9 0%, #c6f6d556 100%)";

              return (
                <Grid
                  key={index}
                  size={{
                    xs: 12,
                    sm: 6,
                  }}
                >
                  <Box
                    sx={{
                      p: { xs: 1, sm: 0.8 },
                      borderRadius: "12px",
                      background: activeBg,
                      border: "1px solid rgba(255,255,255,0.3)",
                      borderBottom: `4px solid ${activeColor}`,
                      display: "flex",
                      flexDirection: {
                        xs: "column",
                        sm: "row",
                      },
                      alignItems: {
                        xs: "flex-start",
                        sm: "center",
                      },
                      justifyContent: "space-between",
                      gap: 1.5,
                      position: "relative",
                      overflow: "hidden",
                    }}
                  >
                    <Stack
                      direction="row"
                      spacing={2}
                      justifyContent="space-between"
                      alignItems={{ xs: "stretch", sm: "center" }}
                      sx={{ zIndex: 1 }}
                    >
                      <Box
                        sx={{
                          p: 0.6,
                          borderRadius: "10px",
                          bgcolor: "#fff",
                          display: "flex",
                          mr: 1.5,
                          boxShadow: "0 2px 6px rgba(0,0,0,0.05)",
                          color: activeColor,
                        }}
                      >
                        {item.icon}
                      </Box>
                      <Box>
                        <Typography
                          variant="caption"
                          color="text.secondary"
                          fontWeight={700}
                          sx={{
                            textTransform: "uppercase",
                            fontSize: "0.72rem",
                          }}
                        >
                          {item.label}
                        </Typography>
                        <Typography
                          variant="body2"
                          fontWeight={800}
                          sx={{ color: "#2c3e50", lineHeight: 1 }}
                        >
                          {absVal}
                          <Box
                            component="span"
                            sx={{
                              fontSize: "0.7rem",
                              ml: 0.5,
                              color: activeColor,
                              fontWeight: 900,
                            }}
                          >
                            {indicator}
                          </Box>
                        </Typography>
                      </Box>
                    </Stack>

                    {isNeg ? (
                      <TrendingDownIcon
                        sx={{
                          position: "absolute",
                          left: "50%",
                          top: "50%",
                          transform: "translate(-50%, -50%)",
                          fontSize: "2.8rem",
                          opacity: 0.25,
                          color: activeColor,
                          zIndex: 0,
                        }}
                      />
                    ) : (
                      <TrendingUpIcon
                        sx={{
                          position: "absolute",
                          left: "50%",
                          top: "50%",
                          transform: "translate(-50%, -50%)",
                          fontSize: "2.8rem",
                          opacity: 0.25,
                          color: activeColor,
                          zIndex: 0,
                        }}
                      />
                    )}

                    <Box sx={{ textAlign: "right", zIndex: 1 }}>
                      <Stack
                        direction="row"
                        alignItems="center"
                        spacing={0.5}
                        justifyContent="flex-end"
                      >
                        <EventIcon
                          sx={{ fontSize: "0.8rem", color: "text.secondary" }}
                        />
                        <Typography
                          variant="caption"
                          sx={{
                            color: "text.secondary",
                            fontWeight: 700,
                            fontSize: "0.72rem",
                          }}
                        >
                          AS OF
                        </Typography>
                      </Stack>
                      <Typography
                        variant="caption"
                        sx={{
                          color: "#2c3e50",
                          fontWeight: 700,
                          display: "block",
                        }}
                      >
                        {item.date || "N/A"}
                      </Typography>
                    </Box>
                  </Box>
                </Grid>
              );
            })}
          </Grid>
        )}
      </Box>

      <Box sx={{ flex: 1 }}>
        <DataGrid
          density="compact"
          rows={rows}
          columns={activeColumns} // <-- Pass the dynamic columns here
          loading={loading}
          disableRowSelectionOnClick
          getRowId={(row) => row.transactionId}
          paginationMode="server"
          sortingMode="server"
          filterMode="server"
          rowCount={rowCount}
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[25, 50, 75, 100]}
          sortModel={sortModel}
          onSortModelChange={setSortModel}
          filterModel={filterModel}
          onFilterModelChange={setFilterModel}
          slots={{
            noRowsOverlay: CustomNoRowsOverlay,
          }}
          sx={{
            mt: -2,
            backgroundColor: "#ffffff6b",
            border: "none",
            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#f5f5f5 !important",
              fontWeight: 700,
              borderBottom: "2px solid rgba(88, 70, 159, 0.2)",
              position: "sticky",
              top: 0,
              zIndex: 1,
            },
            "& .MuiDataGrid-virtualScroller": {
              overflowY: "auto",
            },
            "& .MuiDataGrid-main": {
              border: "none",
            },
          }}
        />
      </Box>
    </StyledDataBox>
  );
};

export default TransactionTable;
