package com.example;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.Statement;
import javax.naming.InitialContext;
import javax.naming.Context;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.sql.DataSource;

@WebServlet("/report")
public class ReportDownload extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request,
                         HttpServletResponse response)
            throws ServletException, IOException {

        response.setContentType("text/plain");
        PrintWriter out = response.getWriter();

        try {
            Context ctx = new InitialContext();
            DataSource ds = (DataSource) ctx.lookup("jdbc/DigiGOVNonXAPooledDS");

            try (Connection con = ds.getConnection();
                 Statement stmt = con.createStatement();
                 // Updated query to match the table in the reference image
                 ResultSet rs = stmt.executeQuery(
                         "SELECT * FROM [dbo].[RSK_PAYMENT_REPORT]")) {

                // Retrieve all 11 columns defined in the table schema
                while (rs.next()) {
                    out.println(
                            rs.getString(1) + ", " +  // Date
                            rs.getString(2) + ", " +  // Total_no_of_file_generated_in_Digigov
                            rs.getString(3) + ", " +  // Total_Transaction_Amount
                            rs.getString(4) + ", " +  // Transaction_Generation_for_SBI_Account
                            rs.getString(5) + ", " +  // Transaction_Generation_for_non_SBI_Account
                            rs.getString(6) + ", " +  // Extract_Received_for_SBI_Account
                            rs.getString(7) + ", " +  // Extract_not_Received_for_SBI_Account
                            rs.getString(8) + ", " +  // Extract_Received_for_non_SBI_Account
                            rs.getString(9) + ", " +  // Extract_not_Received_for_non_SBI_Account
                            rs.getString(10) + ", " + // Total_Amount_for_SBI_Account
                            rs.getString(11)          // Total_Amount_for_SBI_non_Account
                    );
                }
            }
        } catch (Exception e) {
            e.printStackTrace(out);
        }
    }
}
